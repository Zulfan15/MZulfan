<script>
  import { gameStore } from '../game/store';
  // Dev Center Client Script matching si-dan.com
  const DIALOGS: Record<string, string> = {
    timeline: 'timeline',
    radar: 'radar',
    telemetry: 'telemetry'
  };

  let pendingOpen: string | null = null;

  function openMcDialog(name: string) {
    const dialog = document.querySelector<HTMLDialogElement>(`[data-mc-dialog="${name}"]`);
    if (!dialog) {
      pendingOpen = name;
      return;
    }
    if (dialog.open) return;

    dialog.showModal();

    if (name === 'timeline') {
      const activeTick = dialog.querySelector<HTMLElement>('[aria-pressed="true"]');
      activeTick?.scrollIntoView({ block: 'nearest', inline: 'center' });
    }
  }

  // Listen for town events from 2D Interior Engine
  for (const name of Object.keys(DIALOGS)) {
    document.addEventListener(`town:${name}`, () => openMcDialog(name));
  }

  document.addEventListener('town:dev-clock', () => {
    const now = new Date();
    const timeStr = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: false });
    const text = `Mission time: ${timeStr} (WIB), where Zulfan is.`;
    document.dispatchEvent(new CustomEvent('town:note', { detail: { title: 'Mission clock', text } }));
  });

  function toggleButtons(buttons: HTMLElement[], panels: HTMLElement[], keyFn: (el: HTMLElement) => string | undefined, activeBtn: HTMLElement) {
    for (const b of buttons) {
      b.setAttribute('aria-pressed', String(b === activeBtn));
    }
    for (const p of panels) {
      p.hidden = keyFn(p) !== keyFn(activeBtn);
    }
  }

  function setupDevCenter() {
    const mcCard = document.querySelector<HTMLElement>('[data-mc]');
    if (!mcCard) return;

    // Send feed data to 2D Interior scene if available
    try {
      const feedStr = mcCard.getAttribute('data-feed');
      if (feedStr) {
        const feed = JSON.parse(feedStr);
        document.dispatchEvent(new CustomEvent('dev:feed', { detail: feed }));
      }
    } catch {
      // feed parsing ignored
    }

    // Bind Close Buttons & Backdrop Clicks for all Dialogs
    for (const dialog of document.querySelectorAll<HTMLDialogElement>('[data-mc-dialog]')) {
      const closeBtn = dialog.querySelector<HTMLButtonElement>('[data-mc-close]');
      closeBtn?.addEventListener('click', () => dialog.close());

      dialog.addEventListener('close', () => {
        document.dispatchEvent(new CustomEvent('town:focus'));
      });

      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
      });
    }

    // Bind Open Fastlane Buttons
    for (const btn of document.querySelectorAll<HTMLElement>('[data-open]')) {
      btn.addEventListener('click', () => {
        const target = btn.dataset.open;
        if (target) openMcDialog(target);
      });
    }

    // Timeline Modal: Track Ticks and Brief Switcher
    const ticks = Array.from(document.querySelectorAll<HTMLElement>('[data-brief-for]'));
    const briefs = Array.from(document.querySelectorAll<HTMLElement>('[data-brief]'));
    for (const tick of ticks) {
      tick.addEventListener('click', () => {
        toggleButtons(ticks, briefs, (el) => el.dataset.brief || el.dataset.briefFor, tick);
      });
    }

    // Radar Modal: Blip Selection & Technology Flight Record Readout
    const blips = Array.from(document.querySelectorAll<HTMLElement>('[data-tech]'));
    const techDetails = Array.from(document.querySelectorAll<HTMLElement>('[data-tech-detail]'));
    const techHint = document.querySelector<HTMLElement>('[data-tech-hint]');
    for (const blip of blips) {
      blip.addEventListener('click', () => {
        if (techHint) techHint.hidden = true;
        toggleButtons(blips, techDetails, (el) => el.dataset.tech || el.dataset.techDetail, blip);
      });
    }

    // ───────────────────────── Phase 1: Interactive SubNav, Filters, & Honors ─────────────────────────
    // 1. Sub-Nav Smooth Scroll
    const subnavLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.mcp-subnav__link'));
    for (const link of subnavLinks) {
      link.addEventListener('click', (e) => {
        const targetId = link.getAttribute('data-nav-target');
        if (!targetId) return;
        const targetEl = document.getElementById(targetId);
        if (targetEl) {
          e.preventDefault();
          targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
          for (const l of subnavLinks) l.classList.remove('is-active');
          link.classList.add('is-active');
          if (targetId === 'sec-terminal') {
            const input = document.getElementById('terminal-input') as HTMLInputElement | null;
            setTimeout(() => input?.focus(), 350);
          }
        }
      });
    }

    // Quick Actions Bar (1-Click Test Points)
    const quickActionBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-quick-action]'));
    for (const btn of quickActionBtns) {
      btn.addEventListener('click', () => {
        const action = btn.dataset.quickAction;
        if (action === 'eternatus') {
          window.dispatchEvent(new CustomEvent('town:locate', { detail: { propId: 'eternatus' } }));
        } else if (action === 'coffee') {
          window.dispatchEvent(new CustomEvent('town:coffee-boost'));
        } else if (action === 'snorlax') {
          window.dispatchEvent(new CustomEvent('town:locate', { detail: { propId: 'snorlax' } }));
        } else if (action === 'terminal') {
          const terminalSec = document.getElementById('sec-terminal');
          if (terminalSec) {
            terminalSec.scrollIntoView({ behavior: 'smooth', block: 'center' });
            const input = document.getElementById('terminal-input') as HTMLInputElement | null;
            setTimeout(() => input?.focus(), 350);
          }
        }
      });
    }

    // ScrollSpy within panel body
    const panelBody = document.querySelector<HTMLElement>('.panel__body');
    const sections = ['sec-tldr', 'sec-launches', 'sec-stack', 'sec-honors', 'sec-comms', 'sec-terminal']
      .map(id => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    if (panelBody && sections.length > 0) {
      const onScroll = () => {
        const panelTop = panelBody.getBoundingClientRect().top;
        let currentId = sections[0].id;
        for (const sec of sections) {
          const rect = sec.getBoundingClientRect();
          if (rect.top - panelTop <= 90) {
            currentId = sec.id;
          }
        }
        for (const l of subnavLinks) {
          if (l.getAttribute('data-nav-target') === currentId) {
            l.classList.add('is-active');
          } else {
            l.classList.remove('is-active');
          }
        }
      };
      panelBody.addEventListener('scroll', onScroll, { passive: true });
    }

    // 2. Launch Filters (Category & Interactive Tech Chips)
    const filterBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-launch-filter]'));
    const launchCards = Array.from(document.querySelectorAll<HTMLElement>('.launch'));
    const activeFilterBanner = document.getElementById('launch-active-filter');
    const activeFilterText = document.getElementById('launch-active-filter-text');
    const resetFilterBtn = document.getElementById('btn-reset-launch-filter');
    const counterBadge = document.getElementById('launches-showing-count');
    const techChips = Array.from(document.querySelectorAll<HTMLElement>('[data-tech-filter]'));

    let activeCategory = 'all';
    let activeTech: string | null = null;

    function updateLaunchFilter() {
      let visibleCount = 0;

      for (const card of launchCards) {
        const cat = card.dataset.category || '';
        const techs = (card.dataset.techs || '').split(',');

        const matchesCategory = (activeCategory === 'all' || cat === activeCategory);
        let matchesTech = true;
        if (activeTech) {
          matchesTech = techs.some(t => t.trim().toLowerCase().includes(activeTech!.toLowerCase()));
        }

        const show = matchesCategory && matchesTech;
        card.hidden = !show;
        if (show) {
          visibleCount++;
          if (activeTech) {
            card.classList.add('launch--highlighted');
          } else {
            card.classList.remove('launch--highlighted');
          }
        }
      }

      if (counterBadge) {
        counterBadge.textContent = `${visibleCount} Proyek`;
      }

      if (activeFilterBanner && activeFilterText) {
        if (activeTech) {
          activeFilterBanner.hidden = false;
          activeFilterText.textContent = `⚡ Teknologi: "${activeTech.toUpperCase()}" (${visibleCount} proyek ditemukan)`;
        } else if (activeCategory !== 'all') {
          const catName = activeCategory === 'ai' ? 'AI & Vision' : activeCategory === 'cloud' ? 'Cloud & Backend' : activeCategory === 'nlp' ? 'NLP & Data' : 'IoT & Embedded';
          activeFilterBanner.hidden = false;
          activeFilterText.textContent = `📂 Kategori: ${catName} (${visibleCount} proyek)`;
        } else {
          activeFilterBanner.hidden = true;
        }
      }

      for (const chip of techChips) {
        const chipTech = chip.dataset.techFilter || '';
        if (activeTech && chipTech.toLowerCase() === activeTech.toLowerCase()) {
          chip.classList.add('is-selected');
          chip.setAttribute('aria-pressed', 'true');
        } else {
          chip.classList.remove('is-selected');
          chip.setAttribute('aria-pressed', 'false');
        }
      }
    }

    for (const btn of filterBtns) {
      btn.addEventListener('click', () => {
        for (const b of filterBtns) {
          b.classList.remove('is-active');
          b.setAttribute('aria-selected', 'false');
        }
        btn.classList.add('is-active');
        btn.setAttribute('aria-selected', 'true');
        activeCategory = btn.dataset.launchFilter || 'all';
        activeTech = null;
        updateLaunchFilter();
      });
    }

    for (const chip of techChips) {
      chip.addEventListener('click', () => {
        const tech = chip.dataset.techFilter;
        if (!tech) return;

        if (activeTech && activeTech.toLowerCase() === tech.toLowerCase()) {
          activeTech = null;
        } else {
          activeTech = tech;
          activeCategory = 'all';
          for (const b of filterBtns) {
            b.classList.toggle('is-active', b.dataset.launchFilter === 'all');
            b.setAttribute('aria-selected', String(b.dataset.launchFilter === 'all'));
          }
          const launchesSection = document.getElementById('sec-launches');
          launchesSection?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        updateLaunchFilter();
      });

      chip.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          chip.click();
        }
      });
    }

    resetFilterBtn?.addEventListener('click', () => {
      activeTech = null;
      activeCategory = 'all';
      for (const b of filterBtns) {
        b.classList.toggle('is-active', b.dataset.launchFilter === 'all');
        b.setAttribute('aria-selected', String(b.dataset.launchFilter === 'all'));
      }
      updateLaunchFilter();
    });

    
    // 5. Bi-Directional Sync: 2D Room <-> Reading Panel
    // A. Highlight project card from 2D canvas interaction
    document.addEventListener('town:highlight-project', (e: any) => {
      const id = e.detail?.id;
      if (!id) return;
      const card = document.querySelector<HTMLElement>(`[data-launch-id="${id}"]`);
      if (card) {
        card.hidden = false;
        card.scrollIntoView({ behavior: 'smooth', block: 'center' });
        card.classList.add('launch--highlighted');
        setTimeout(() => {
          card.classList.remove('launch--highlighted');
        }, 4000);
      }
    });

    // B. Locate Console in 2D Room button handler
    for (const btn of document.querySelectorAll<HTMLElement>('[data-locate-prop]')) {
      btn.addEventListener('click', () => {
        const propId = btn.dataset.locateProp;
        if (!propId) return;

        // Close debrief dialog if open
        if (debriefDialog && debriefDialog.open) {
          debriefDialog.close();
        }

        // On narrow screens (mobile/tablet), collapse panel or focus canvas so character walking is visible
        if (window.innerWidth <= 900) {
          const panelTab = document.querySelector<HTMLButtonElement>('[data-panel-tab]');
          const panel = document.querySelector<HTMLElement>('#content');
          if (panel && !panel.hasAttribute('data-closed') && panelTab) {
            panelTab.click();
          }
        }

        // Dispatch locate event to 2D TownEngine
        window.dispatchEvent(new CustomEvent('town:locate', { detail: { propId } }));
      });
    }

    // 4. Mission Debrief Modal Handler
    const debriefDialog = document.querySelector<HTMLDialogElement>('[data-mc-dialog="debrief"]');
    const debriefTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-debrief-tab]'));
    const debriefPanels = Array.from(document.querySelectorAll<HTMLElement>('[data-debrief-panel]'));
    const prevMissionBtn = document.getElementById('btn-prev-mission');
    const nextMissionBtn = document.getElementById('btn-next-mission');
    const missionStepIndicator = document.getElementById('mission-step-indicator');

    const MISSION_IDS = ['aeroscan', 'foodlink', 'thesis', 'omr-grader', 'foodrescue', 'inception', 'rc-tank'];
    let currentMissionIdx = 0;

    function showMission(id: string) {
      const idx = MISSION_IDS.indexOf(id);
      if (idx !== -1) currentMissionIdx = idx;

      for (const tab of debriefTabs) {
        tab.classList.toggle('is-active', tab.dataset.debriefTab === id);
      }
      for (const panel of debriefPanels) {
        panel.hidden = panel.dataset.debriefPanel !== id;
        if (panel.dataset.debriefPanel === id) {
          panel.classList.add('is-active');
        } else {
          panel.classList.remove('is-active');
        }
      }

      if (missionStepIndicator) {
        missionStepIndicator.textContent = `${currentMissionIdx + 1} / ${MISSION_IDS.length}`;
      }

      const activeTab = debriefTabs.find(t => t.dataset.debriefTab === id);
      activeTab?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    }

    function openDebrief(id: string) {
      showMission(id);
      debriefDialog?.showModal();
    }

    for (const btn of document.querySelectorAll<HTMLElement>('[data-open-debrief]')) {
      btn.addEventListener('click', () => {
        const id = btn.dataset.openDebrief;
        if (id) openDebrief(id);
      });
    }

    for (const tab of debriefTabs) {
      tab.addEventListener('click', () => {
        const id = tab.dataset.debriefTab;
        if (id) showMission(id);
      });
    }

    prevMissionBtn?.addEventListener('click', () => {
      currentMissionIdx = (currentMissionIdx - 1 + MISSION_IDS.length) % MISSION_IDS.length;
      showMission(MISSION_IDS[currentMissionIdx]);
    });

    nextMissionBtn?.addEventListener('click', () => {
      currentMissionIdx = (currentMissionIdx + 1) % MISSION_IDS.length;
      showMission(MISSION_IDS[currentMissionIdx]);
    });

    debriefDialog?.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        prevMissionBtn?.click();
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        nextMissionBtn?.click();
      }
    });

    // Listen for custom event from 2D room (e.g. from props)
    document.addEventListener('town:debrief', (e: any) => {
      const id = e.detail?.id || 'aeroscan';
      openDebrief(id);
    });

    // 3. Honors Collapsible Toggle
    const toggleHonorsBtn = document.getElementById('btn-toggle-honors');
    const honorsMore = document.getElementById('honors-more');
    if (toggleHonorsBtn && honorsMore) {
      toggleHonorsBtn.addEventListener('click', () => {
        const isHidden = honorsMore.hidden;
        honorsMore.hidden = !isHidden;
        toggleHonorsBtn.setAttribute('aria-expanded', String(isHidden));
        toggleHonorsBtn.innerHTML = isHidden
          ? '🔼 Sembunyikan Pengalaman Asisten Lab &amp; Magang'
          : '🔽 Tampilkan 6 Pengalaman Asisten Lab &amp; Magang Lainnya';
      });
    }

    // 6. Interactive ZulfanOS Developer Terminal (CLI)
    const terminalForm = document.getElementById('terminal-form') as HTMLFormElement | null;
    const terminalInput = document.getElementById('terminal-input') as HTMLInputElement | null;
    const terminalOutput = document.getElementById('terminal-output');
    const terminalChips = Array.from(document.querySelectorAll<HTMLButtonElement>('.term-chip'));

    function appendTermLine(text: string, type: 'input' | 'output' | 'system' | 'error' | 'success' = 'output') {
      if (!terminalOutput) return;
      const line = document.createElement('div');
      line.className = `term-line term-line--${type}`;
      line.innerHTML = text;
      terminalOutput.appendChild(line);
      terminalOutput.scrollTop = terminalOutput.scrollHeight;
    }

    function executeCommand(rawCmd: string) {
      const trimmed = rawCmd.trim();
      if (!trimmed) return;

      appendTermLine(`<span class="term-prompt-echo">guest@mission-control:~$</span> ${trimmed}`, 'input');
      const parts = trimmed.split(' ');
      const cmd = parts[0].toLowerCase();
      const arg = parts.slice(1).join(' ').toLowerCase();

      switch (cmd) {
        case 'help':
          appendTermLine(
            `Daftar Perintah ZulfanOS CLI:
<span class="term-hl">help</span>         : Tampilkan panduan ini
<span class="term-hl">aeroscan</span>     : Spesifikasi Tactical Edge AI AeroScan
<span class="term-hl">foodlink</span>     : Arsitektur Cloud-Native Distributed FoodLink
<span class="term-hl">thesis</span>       : Info penelitian klasifikasi spam email
<span class="term-hl">skills</span> / <span class="term-hl">stack</span>: Daftar teknologi utama
<span class="term-hl">eternatus</span>    : Status Server Assistant & Dynamo Core
<span class="term-hl">coffee</span> / <span class="term-hl">turbo</span> : Aktifkan Robusta Overclock (+50% Speed)
<span class="term-hl">snorlax</span>      : Sapa Snorlax di meja komando
<span class="term-hl">status</span>       : Metrik operasional Mission Control
<span class="term-hl">locate &lt;id&gt;</span>  : Cari &amp; arahkan karakter ke prop (rack, snorlax, coffee, eternatus)
<span class="term-hl">clear</span>        : Bersihkan log terminal`,
            'system'
          );
          break;

        case 'aeroscan':
          appendTermLine(
            `🚀 <span class="term-hl">AeroScan Tactical Edge AI</span>:
• YOLOv11s model trained for military aircraft & tactical object classification.
• TensorRT 10 FP16 quantization: ~1.8 ms/frame (&gt;500 FPS) on RTX 4060.
• FastAPI backend with WebRTC low-latency streaming.
[<a href="#" class="term-link" data-open-debrief="aeroscan">Buka Debrief AeroScan ↗</a>]`,
            'output'
          );
          openDebrief('aeroscan');
          break;

        case 'foodlink':
          appendTermLine(
            `🌐 <span class="term-hl">FoodLink Distributed Cloud Platform</span>:
• High-concurrency surplus food redistribution API.
• Laravel 12 API Gateway, PostgreSQL 16 row-level locks, PostGIS spatial queries.
• Apache Kafka transactional outbox + Redis 7 distributed mutexes.
[<a href="#" class="term-link" data-open-debrief="foodlink">Buka Debrief FoodLink ↗</a>]`,
            'output'
          );
          openDebrief('foodlink');
          break;

        case 'thesis':
          appendTermLine(
            `📚 <span class="term-hl">Skripsi / Thesis Machine Learning</span>:
• Indonesian Email Spam Classifier using SVM (Support Vector Machine) &amp; TF-IDF.
• Evaluated across linear, RBF, and polynomial kernels; achieved 98.4% F1-score.
[<a href="#" class="term-link" data-open-debrief="thesis">Buka Debrief Skripsi ↗</a>]`,
            'output'
          );
          openDebrief('thesis');
          break;

        case 'skills':
        case 'stack':
          appendTermLine(
            `🛠️ <span class="term-hl">Core Tech Stack</span>:
• Languages  : Python, TypeScript, PHP, SQL, Bash
• AI / ML    : PyTorch, TensorRT 10, YOLOv11s, OpenCV, Scikit-learn
• Backend    : FastAPI, Laravel 12, PostgreSQL 16, PostGIS, Redis 7
• Infra / Ops: Docker, Kubernetes, Apache Kafka, Linux, Cloudflare Pages
• Frontend   : Astro 5, Responsive Canvas 2D Engine, Tailwind`,
            'output'
          );
          break;

        case 'eternatus':
          appendTermLine(
            `⚡ <span class="term-hl">Server Assistant: ETERNATUS</span>:
• Status     : DYNAMO CORE 100% ONLINE
• Role       : Compute Cluster High-Voltage Power &amp; Inference Pipeline
• Temp       : 38.4°C | Frequency: 4.8 GHz
• Overclock  : READY
Mengalirkan daya ke cluster komputasi AI! Mengarahkan karakter ke Eternatus...`,
            'success'
          );
          window.dispatchEvent(new CustomEvent('town:locate', { detail: { propId: 'eternatus' } }));
          break;

        case 'coffee':
        case 'turbo':
        case 'overclock':
          appendTermLine(
            `☕ <span class="term-hl">ROBUSTA OVERCLOCK ACTIVATED!</span>
Kafein robusta murni disuntikkan ke sistem!
Kecepatan karakter meningkat <span class="term-hl">+50%</span> selama 30 detik. Lari cepat aktif!`,
            'success'
          );
          window.dispatchEvent(new CustomEvent('town:coffee-boost'));
          break;

        case 'snorlax':
          appendTermLine(
            `💤 <span class="term-hl">Snorlax (Head of Comfort)</span>:
Zzz... Snorlax tertidur pulas di meja depan menjaga log sistem. Tekan tombol bicara atau gunakan Poké Flute untuk menyapa.`,
            'output'
          );
          window.dispatchEvent(new CustomEvent('town:locate', { detail: { propId: 'snorlax' } }));
          break;

        case 'status':
          appendTermLine(
            `📊 <span class="term-hl">Mission Control Operational Status</span>:
• System Uptime : 99.98%
• Active Nodes  : Edge-RTX4060 [ONLINE], Cloud-Postgres [HEALTHY], Kafka-Broker [READY]
• 2D Engine FPS : 60 FPS (V-Sync)
• Server Core   : Eternatus Dynamo [PEAK 100%]
• Coffee Supply : Fresh Robusta [READY]`,
            'output'
          );
          break;

        case 'locate':
          if (!arg) {
            appendTermLine('Penggunaan: locate &lt;id&gt; (contoh: locate rack, locate snorlax, locate coffee, locate eternatus)', 'error');
          } else {
            appendTermLine(`Mengarahkan karakter menuju prop "${arg}"...`, 'system');
            window.dispatchEvent(new CustomEvent('town:locate', { detail: { propId: arg } }));
          }
          break;

        case 'clear':
          if (terminalOutput) {
            terminalOutput.innerHTML = '';
          }
          break;

        default:
          appendTermLine(`Perintah tidak dikenal: "${cmd}". Ketik <span class="term-hl">help</span> untuk daftar perintah.`, 'error');
          break;
      }
    }

    terminalForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!terminalInput) return;
      const val = terminalInput.value;
      terminalInput.value = '';
      executeCommand(val);
    });

    for (const chip of terminalChips) {
      chip.addEventListener('click', () => {
        const cmd = chip.dataset.cmd;
        if (cmd) executeCommand(cmd);
      });
    }

    // Delegate clicks on dynamically printed term links
    terminalOutput?.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest('[data-open-debrief]');
      if (target) {
        e.preventDefault();
        const id = target.getAttribute('data-open-debrief');
        if (id) openDebrief(id);
      }
    });

    // Open any pending dialog if navigated
    if (pendingOpen) {
      const name = pendingOpen;
      pendingOpen = null;
      openMcDialog(name);
    }

    // Unlock Dev Center stamp
    gameStore.addStamp('dev');
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupDevCenter);
  } else {
    setupDevCenter();
  }
  document.addEventListener('astro:page-load', setupDevCenter);
</script>