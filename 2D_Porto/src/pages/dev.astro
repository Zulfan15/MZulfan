</TownLayout>

<script>
  import { setDevFeed } from '../engine/devScene';

  function initDevCenter() {
    const root = document.querySelector('[data-mc]') as HTMLElement | null;
    if (!root) return;

    // 1. Pass feed to engine animator
    const feedJson = root.getAttribute('data-feed');
    if (feedJson) {
      try {
        const feed = JSON.parse(feedJson);
        setDevFeed(feed);
      } catch (e) {
        console.error('Failed to parse dev feed', e);
      }
    }

    // 2. Open dialog helper
    const openDialog = (name: string, targetId?: string) => {
      const dlg = document.querySelector(`[data-mc-dialog="${name}"]`) as HTMLDialogElement | null;
      if (!dlg) return;
      if (!dlg.open) {
        dlg.showModal();
      }

      if (name === 'timeline') {
        if (targetId) {
          const tick = dlg.querySelector(`[data-brief-for="${targetId}"]`) as HTMLButtonElement | null;
          if (tick) {
            tick.click();
            tick.scrollIntoView({ block: 'nearest', inline: 'center' });
            return;
          }
        }
        dlg.querySelector('[aria-pressed="true"]')?.scrollIntoView({ block: 'nearest', inline: 'center' });
      }
    };

    // Fastlane [data-open] buttons
    document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-open');
        const targetBrief = btn.getAttribute('data-target-brief');
        if (target) openDialog(target, targetBrief || undefined);
      });
    });

    // Close buttons & backdrop click
    document.querySelectorAll<HTMLDialogElement>('[data-mc-dialog]').forEach((dlg) => {
      dlg.querySelector('[data-mc-close]')?.addEventListener('click', () => dlg.close());
      dlg.addEventListener('click', (e) => {
        if (e.target === dlg) dlg.close();
      });
    });

    // Custom events dispatched by 2D canvas engine
    document.addEventListener('town:timeline', () => openDialog('timeline'));
    document.addEventListener('town:radar', () => openDialog('radar'));
    document.addEventListener('town:telemetry', () => openDialog('telemetry'));

    // Timeline Track Brief Switcher
    const ticks = document.querySelectorAll<HTMLButtonElement>('[data-brief-for]');
    const briefs = document.querySelectorAll<HTMLElement>('[data-brief]');
    ticks.forEach((tick) => {
      tick.addEventListener('click', () => {
        ticks.forEach((t) => t.setAttribute('aria-pressed', String(t === tick)));
        const targetId = tick.getAttribute('data-brief-for');
        briefs.forEach((b) => {
          b.hidden = b.getAttribute('data-brief') !== targetId;
        });
      });
    });

    // Radar Tech Blip Switcher
    const blips = document.querySelectorAll<HTMLButtonElement>('[data-tech]');
    const techDetails = document.querySelectorAll<HTMLElement>('[data-tech-detail]');
    const techHint = document.querySelector<HTMLElement>('[data-tech-hint]');
    blips.forEach((blip) => {
      blip.addEventListener('click', () => {
        if (techHint) techHint.hidden = true;
        blips.forEach((b) => b.setAttribute('aria-pressed', String(b === blip)));
        const techId = blip.getAttribute('data-tech');
        techDetails.forEach((td) => {
          td.hidden = td.getAttribute('data-tech-detail') !== techId;
        });
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initDevCenter);
  document.addEventListener('astro:page-load', initDevCenter);
</script>
