              class="vip-chat-topic rounded-xl border border-emerald-500/25 bg-black/30 p-2.5 text-left hover:border-emerald-400/60 transition"
              data-subject="Fellow Developer Virtual Espresso Chat ☕"
              data-body="Hey Zulfan! Loved the interactive 2D Poké-Café & Developer Roastery Bar. Would be awesome to connect and chat about game engines, Astro, and software engineering!"
            >
              <div class="font-pixel text-[10px] text-emerald-200">☕ Casual Dev Networking</div>
              <div class="font-mono text-[10px] text-emerald-300/75 mt-0.5">2D Web Engines, Open Source & Tech</div>
            </button>
          </div>

          <!-- Preview Box -->
          <div class="rounded-xl border border-emerald-500/30 bg-black/40 p-3 font-mono text-xs text-emerald-100/90">
            <div class="text-[10px] uppercase tracking-wider text-emerald-400 mb-1">
              ✉️ Prepared Invitation Note:
            </div>
            <p id="vip-message-preview" class="italic text-emerald-100/90">
              "Hi Zulfan, I just visited your Poké-Café & Bar portfolio! I'd love to schedule a quick 15-minute coffee chat to discuss a Full-Stack / Software Engineering opportunity with our team."
            </p>
          </div>
        </div>

        <!-- Right 5 Cols: Direct Contact & Credentials Card -->
        <div class="lg:col-span-5 flex flex-col justify-between rounded-xl border border-emerald-400/35 bg-black/45 p-4">
          <div class="space-y-2.5">
            <div class="flex items-center gap-3">
              <div class="flex h-11 w-11 items-center justify-center rounded-xl border border-emerald-400/40 bg-emerald-500/20 text-xl">
                👨‍💻
              </div>
              <div>
                <h3 class="font-pixel text-xs text-emerald-100">{profile.person.name}</h3>
                <p class="font-mono text-[11px] text-emerald-300/80">
                  Software & AI Engineer · Bandung, Indonesia
                </p>
              </div>
            </div>

            <ul class="space-y-1.5 pt-2 border-t border-emerald-500/20 font-mono text-[11px] text-emerald-100/85">
              <li>🎓 <strong>Education:</strong> B.Comp.Sc. ITENAS (GPA 3.49 / 4.00)</li>
              <li>🏅 <strong>Track Record:</strong> 6x Lab Assistant & IDEA FEST 3 Medalist</li>
              <li>🛡️ <strong>Certification:</strong> Huawei HCIA-Security V4.0</li>
              <li>📬 <strong>Direct Email:</strong> {profile.person.email}</li>
