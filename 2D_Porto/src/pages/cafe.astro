---
import TownLayout from '../layouts/TownLayout.astro';
import { profile } from '../lib/profile';

const githubUrl = profile.socials.find((s) => s.label === 'GitHub')?.url || 'https://github.com/Zulfan15';
const linkedinUrl =
  profile.socials.find((s) => s.label === 'LinkedIn')?.url ||
  'https://www.linkedin.com/in/muhammad-zulfan-anggadhiputra';

interface CafeMenuItem {
  id: string;
  name: string;
  category: 'espresso' | 'pastry' | 'elixir';
  categoryLabel: string;
  price: string;
  calories: string;
  buff: string;
  icon: string;
  accent: string;
  tastingNotes: string[];
  description: string;
  devPairing: string;
  propTarget: string;
}

const cafeMenu: CafeMenuItem[] = [
  {
    id: 'dark-ts-roast',
    name: 'Dark Roasted TypeScript Espresso',
    category: 'espresso',
    categoryLabel: 'Specialty Roast',
    price: '₽ 450',
    calories: 'Strict-Mode · 9 Bar',
    buff: '+100% Type-Safety & Focus',
    icon: '☕',
    accent: 'amber',
    tastingNotes: ['Dark Cacao', 'Zero Runtime Bugs', 'Crisp Finish'],
    description:
      'Double-shot West Java Arabica pulled at 9 bars of pressure. Strictly typed from bean to cup so you never encounter an undefined reference at 2 AM.',
    devPairing: 'Paired with this 60 FPS Astro + TypeScript 2D Canvas Engine',
    propTarget: 'roast-board',
  },
  {
    id: 'tensorrt-cortado',
    name: 'YOLOv11 TensorRT Cortado',
    category: 'espresso',
    categoryLabel: 'Specialty Roast',
    price: '₽ 550',
    calories: '1.8 ms Extraction · 75 FPS',
    buff: '+50% Turbo Inference Speed',
    icon: '⚡',
    accent: 'orange',
    tastingNotes: ['Caramelized Hazelnut', 'FP16 Precision', 'Velvet Microfoam'],
    description:
      'Quantized espresso cut with warm steamed oat milk. Extracted in sub-2 milliseconds to mirror Zulfan’s real-time drone object detection pipeline.',
    devPairing: 'Paired with AeroScan AI (YOLOv11 + TensorRT 10)',
    propTarget: 'roast-board',
  },
  {
    id: 'laravel-v60',
    name: 'Artisan V60 Clean-Arch Pour-Over',
    category: 'espresso',
    categoryLabel: 'Specialty Roast',
    price: '₽ 480',
    calories: 'Single-Origin · Hand Drip',
    buff: '+100% Modular Clarity',
    icon: '🫖',
    accent: 'amber',
    tastingNotes: ['Floral Jasmine', 'Bergamot', 'Clean Service Layer'],
    description:
      'Slow-bloomed through a conical V60 filter in three decoupled stages: Controller bloom, Service infusion, and Repository drawdown.',
    devPairing: 'Paired with FoodLink Laravel 12 + PostGIS Platform',
    propTarget: 'roast-board',
  },
  {
    id: 'castelia-cone',
    name: 'Unova Artisan Castelia Cone',
    category: 'pastry',
    categoryLabel: 'Castelia Sweet',
    price: '₽ 500',
    calories: 'Chilled Swirl · Classic',
    buff: '+25s Movement Speed & Cure Status',
    icon: '🍦',
    accent: 'pink',
    tastingNotes: ['Madagascar Vanilla', 'Waffle Crunch', 'Alcremie Charm'],
    description:
      'The legendary soft-serve spiral from Castelia City, topped by Alcremie with a ruby strawberry and zero-bug sugar crystals. Heals all burnout status conditions.',
    devPairing: 'Paired with 6x ITENAS Laboratory Assistant Mentorship',
    propTarget: 'pastry-case',
  },
  {
    id: 'kalos-poke-puff',
    name: 'Supreme Mocha Poké Puff',
    category: 'pastry',
    categoryLabel: 'Castelia Sweet',
    price: '₽ 420',
    calories: 'Baked Fresh · Choux Pastry',
    buff: '+100% Team Morale & Friendship',
    icon: '🧁',
    accent: 'rose',
    tastingNotes: ['Espresso Ganache', 'Whipped Mascarpone', 'Cocoa Dust'],
    description:
      'Delicate Kalos-style choux pastry filled with whipped espresso cream and topped with a caramelized coffee bean. A favorite among pair-programming partners.',
    devPairing: 'Paired with IDEA FEST 3 Bronze Medal Innovation',
    propTarget: 'pastry-case',
  },
  {
    id: 'lumiose-galette',
    name: 'Lumiose Almond Butter Galette',
    category: 'pastry',
    categoryLabel: 'Castelia Sweet',
    price: '₽ 390',
    calories: 'Flaky Crust · Golden',
    buff: '+80% Algorithmic Stamina',
    icon: '🥐',
    accent: 'amber',
    tastingNotes: ['Toasted Almond', 'Salted Honey Butter', 'Caramel Crust'],
    description:
      'Crisp French-style laminated pastry baked until golden-brown. Ideal brain fuel before challenging Deoxys at the Retro Arcade.',
    devPairing: 'Paired with Kalah Alpha-Beta Pruning AI Engine',
    propTarget: 'pastry-case',
  },
  {
    id: 'kafka-nitro-tonic',
    name: 'Kafka Event-Stream Nitro Tonic',
    category: 'elixir',
    categoryLabel: 'Night Bar Elixir',
    price: '₽ 600',
    calories: 'Nitrogen Infused · Zero Lag',
    buff: '+100% High-Throughput Focus',
    icon: '🍹',
    accent: 'cyan',
    tastingNotes: ['Yuzu Botanical', 'Cascading Nitro Foam', 'Cold-Extracted'],
    description:
      '20-hour cold brew charged with nitrogen gas and layered over sparkling yuzu tonic. Built to sustain high-throughput distributed architecture sessions.',
    devPairing: 'Paired with Distributed Kafka + Redis Lua Microservices',
    propTarget: 'craft-tap',
  },
  {
    id: 'berry-matcha-cloud',
    name: 'Oran Berry & Uji Matcha Cloud',
    category: 'elixir',
    categoryLabel: 'Night Bar Elixir',
    price: '₽ 520',
    calories: 'Ceremonial Grade · Iced',
    buff: '+100 HP & Calm Debugging Aura',
    icon: '🍵',
    accent: 'emerald',
    tastingNotes: ['Uji First-Harvest Matcha', 'Sweet Oran Berry', 'Velvet Cloud'],
    description:
      'Whisked ceremonial Uji matcha poured over crushed Town Square Oran berries and cold sweet cream. Keeps your heartbeat steady during production deployments.',
    devPairing: 'Paired with Huawei HCIA-Security V4.0 Network Engineering',
    propTarget: 'craft-tap',
  },
];
---

<TownLayout
  title={`Poké-Café & Developer Roastery Bar — ${profile.person.name}`}
  description="Step inside Zulfan's Poké-Café & Bar: brew custom developer coffee blends, taste Unova Castelia Cones with Alcremie, spin lo-fi vinyl records, and book a VIP Coffee Chat."
  place="cafe"
>
  <article class="cafe-page space-y-6 pb-10">
    <!-- 1. HERO BANNER & BARISTA RIO + ALCREMIE CONCIERGE -->
    <header class="cafe-hero relative overflow-hidden rounded-2xl border-2 border-amber-500/40 bg-gradient-to-br from-[#23140d] via-[#1b110c] to-[#120b08] p-5 shadow-2xl">
      <div class="pointer-events-none absolute -right-12 -top-12 h-44 w-44 rounded-full bg-amber-500/10 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-12 -left-12 h-44 w-44 rounded-full bg-rose-500/10 blur-3xl"></div>

      <!-- Top Status Ribbon -->
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-amber-500/20 pb-3">
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-amber-400/40 bg-amber-500/15 px-2.5 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-wider text-amber-300">
            <span class="h-2 w-2 rounded-full bg-amber-400 animate-pulse"></span>
            OPEN · ROASTERY & LO-FI BAR
          </span>
          <span class="rounded-full border border-pink-400/30 bg-pink-500/10 px-2.5 py-0.5 font-mono text-[10px] text-pink-300">
            🍓 Alcremie Pastry Stand
          </span>
        </div>

        <div class="flex items-center gap-2">
          <div class="flex items-center gap-1.5 rounded-lg border border-emerald-500/30 bg-emerald-950/50 px-2.5 py-1 font-mono text-[11px] text-emerald-300" title="Your Developer Focus & Caffeine Level">
            <span>⚡ Focus:</span>
            <strong id="cafe-focus-pct" class="text-emerald-400">100%</strong>
          </div>
          <div class="flex items-center gap-1.5 rounded-lg border border-amber-500/30 bg-amber-950/60 px-2.5 py-1 font-mono text-[11px] text-amber-200" title="Earn 5 stamps by ordering or brewing drinks to unlock VIP Golden Cup">
            <span>🎟️ Stamps:</span>
            <strong id="cafe-stamp-counter" class="text-amber-400">1 / 5</strong>
          </div>
        </div>
      </div>

      <!-- Main Title & Subtitle -->
      <div class="mt-4 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div class="space-y-1.5">
          <p class="font-mono text-[11px] uppercase tracking-widest text-amber-400/90">
            TOWN SQUARE SOUTH-EAST PLAZA · ARTISAN ESPRESSO & NIGHT LOUNGE
          </p>
          <h1 id="panel-title" class="font-pixel text-xl sm:text-2xl tracking-tight text-amber-100 flex items-center gap-2.5">
            <span>☕</span>
            <span>POKÉ-CAFÉ & DEV ROASTERY BAR</span>
          </h1>
          <p class="text-xs sm:text-sm text-amber-100/80 leading-relaxed max-w-2xl">
            Welcome inside! Pull up a stool at Master Barista Rio’s mahogany counter, sample <strong class="text-pink-300">Alcremie’s Castelia Cones</strong>, spin warm analog synthwaves on the <strong class="text-amber-300">Vinyl Jukebox</strong>, or reserve the <strong class="text-emerald-300">VIP Booth</strong> for a 1-on-1 engineering coffee chat with <strong class="text-white">{profile.person.name}</strong>.
          </p>
        </div>

        <!-- Loyalty Stamp Visual Pill -->
        <div class="shrink-0 rounded-xl border border-amber-400/30 bg-black/35 p-3 backdrop-blur-sm">
          <div class="flex items-center justify-between gap-3 mb-1.5">
            <span class="font-pixel text-[9px] uppercase tracking-wider text-amber-300">☕ Barista Loyalty Card</span>
            <span id="cafe-vip-badge" class="hidden rounded bg-amber-400/20 border border-amber-300/50 px-1.5 py-0.5 font-mono text-[9px] font-bold text-amber-200">
              👑 VIP GOLDEN CUP
            </span>
          </div>
          <div id="cafe-stamp-slots" class="flex items-center gap-1.5">
            <span class="cafe-stamp-slot is-filled" data-slot="0" title="Stamp 1">☕</span>
            <span class="cafe-stamp-slot" data-slot="1" title="Stamp 2">○</span>
            <span class="cafe-stamp-slot" data-slot="2" title="Stamp 3">○</span>
            <span class="cafe-stamp-slot" data-slot="3" title="Stamp 4">○</span>
            <span class="cafe-stamp-slot" data-slot="4" title="Stamp 5 (VIP Reward)">👑</span>
          </div>
          <p id="cafe-stamp-hint" class="mt-1.5 font-mono text-[10px] text-amber-200/70">
            Sip or brew 4 more creations for the Golden Roaster Badge!
          </p>
        </div>
      </div>

      <!-- Interactive Barista Rio & Alcremie Dialogue Box -->
      <div class="mt-4 rounded-xl border border-amber-500/30 bg-black/40 p-3.5">
        <div class="flex flex-col sm:flex-row sm:items-start gap-3">
          <div class="flex items-center gap-2 shrink-0">
            <button
              type="button"
              id="btn-walk-barista"
              class="flex h-11 w-11 items-center justify-center rounded-xl border border-amber-400/40 bg-amber-500/20 text-xl shadow-inner hover:scale-105 transition-transform"
              title="Walk to Master Barista Rio in 2D Canvas"
            >
              ☕
            </button>
            <button
              type="button"
              id="btn-walk-alcremie"
              class="flex h-11 w-11 items-center justify-center rounded-xl border border-pink-400/40 bg-pink-500/20 text-xl shadow-inner hover:scale-105 transition-transform"
              title="Walk to Alcremie in 2D Canvas"
            >
              🍓
            </button>
          </div>

          <div class="flex-1 min-w-0">
            <div class="flex flex-wrap items-center gap-2">
              <span id="cafe-dialogue-speaker" class="font-pixel text-[10px] uppercase tracking-wider text-amber-300">
                Master Barista Rio & Alcremie
              </span>
              <span class="font-mono text-[10px] text-amber-200/60">· Behind the Espresso Counter</span>
            </div>
            <p id="cafe-dialogue-text" class="mt-1 text-xs sm:text-sm text-amber-50/95 italic leading-relaxed">
              "Today's signature pour is Dark Roasted TypeScript with notes of React, Laravel 12, and zero runtime bugs! Click any station below to walk your character around the café, or craft your own custom developer blend!"
            </p>

            <!-- Interactive Dialogue Topic Chips -->
            <div class="mt-2.5 flex flex-wrap items-center gap-1.5">
              <button
                type="button"
                class="cafe-topic-btn is-active rounded-lg border border-amber-400/40 bg-amber-500/20 px-2.5 py-1 font-mono text-[10px] text-amber-200 hover:bg-amber-500/30 transition"
                data-speaker="Master Barista Rio · Head Roaster ☕"
                data-quote="Today's signature pour is Dark Roasted TypeScript with notes of React, Laravel 12, and zero runtime bugs! Every cup is dialed in at 9 bars of pressure—just like Zulfan's production code."
                data-prop="barista"
              >
                ☕ Today's Dev Blend
              </button>
              <button
                type="button"
                class="cafe-topic-btn rounded-lg border border-pink-400/30 bg-pink-500/10 px-2.5 py-1 font-mono text-[10px] text-pink-200 hover:bg-pink-500/25 transition"
                data-speaker="Alcremie · Pastry Mascot 🍓✨"
                data-quote="Alcre-cremie~! 🍓 Our Unova Castelia Cones and Kalos Poké Puffs are whipped fresh every morning! Take a bite to trigger a +25s Turbo Speed Boost on the 2D Town map!"
                data-prop="alcremie"
              >
                🍦 Castelia Cone Secret
              </button>
              <button
                type="button"
                class="cafe-topic-btn rounded-lg border border-cyan-400/30 bg-cyan-500/10 px-2.5 py-1 font-mono text-[10px] text-cyan-200 hover:bg-cyan-500/25 transition"
                data-speaker="Master Barista Rio · Architecture Sommelier 🫘"
                data-quote="Curious how Zulfan pairs coffee with code? High-concurrency systems get our Nitro Kafka Tonic, while real-time YOLOv11 TensorRT vision pipelines pair best with a 1.8ms Cortado shot!"
                data-prop="roast-board"
              >
                ⚡ Code & Roast Pairing
              </button>
              <button
                type="button"
                class="cafe-topic-btn rounded-lg border border-emerald-400/30 bg-emerald-500/10 px-2.5 py-1 font-mono text-[10px] text-emerald-200 hover:bg-emerald-500/25 transition"
                data-speaker="Master Barista Rio · VIP Host 💬"
                data-quote="Hiring or looking to collaborate? Zulfan graduated from ITENAS Bandung (Informatics, GPA 3.49/4.00) with 6x Lab Assistantship experience. Head over to the VIP Booth at the bottom-right to schedule a chat!"
                data-prop="vip-booth"
              >
                💼 Recruiter Intel
              </button>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- 2. 2D CAFÉ FLOOR STATION NAVIGATOR & HOTKEYS -->
    <section aria-label="2D Café Interactive Stations" class="rounded-xl border border-amber-500/25 bg-[#19110c]/90 p-3.5 shadow-lg">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-2.5">
        <div class="flex items-center gap-2">
          <span class="font-pixel text-[10px] uppercase tracking-wider text-amber-300">
            🗺️ Walk to Café Station (2D Sync)
          </span>
          <span class="text-[11px] text-amber-200/60 hidden sm:inline">
            — Click any prop to walk your character there in the 2D room
          </span>
        </div>
        <div class="hidden md:flex items-center gap-1.5 font-mono text-[10px] text-amber-200/70">
          <span>Hotkeys:</span>
          <kbd class="rounded border border-amber-500/40 bg-black/50 px-1.5 py-0.5 text-amber-300">B</kbd><span>Brew</span>
          <kbd class="rounded border border-amber-500/40 bg-black/50 px-1.5 py-0.5 text-amber-300">M</kbd><span>Menu</span>
          <kbd class="rounded border border-amber-500/40 bg-black/50 px-1.5 py-0.5 text-amber-300">J</kbd><span>Jukebox</span>
          <kbd class="rounded border border-amber-500/40 bg-black/50 px-1.5 py-0.5 text-amber-300">C</kbd><span>VIP Chat</span>
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-2">
        <button
          type="button"
          class="cafe-station-btn flex items-center gap-2 rounded-lg border border-amber-500/30 bg-amber-500/10 px-2.5 py-2 text-left hover:border-amber-400 hover:bg-amber-500/20 transition"
          data-locate="barista"
        >
          <span class="text-base">☕</span>
          <div class="min-w-0">
            <div class="font-pixel text-[9px] text-amber-200 truncate">Barista Rio</div>
            <div class="font-mono text-[9px] text-amber-300/70 truncate">Espresso Bar</div>
          </div>
        </button>

        <button
          type="button"
          class="cafe-station-btn flex items-center gap-2 rounded-lg border border-pink-500/30 bg-pink-500/10 px-2.5 py-2 text-left hover:border-pink-400 hover:bg-pink-500/20 transition"
          data-locate="alcremie"
        >
          <span class="text-base">🍓</span>
          <div class="min-w-0">
            <div class="font-pixel text-[9px] text-pink-200 truncate">Alcremie</div>
            <div class="font-mono text-[9px] text-pink-300/70 truncate">Sweet Mascot</div>
          </div>
        </button>

        <button
          type="button"
          class="cafe-station-btn flex items-center gap-2 rounded-lg border border-orange-500/30 bg-orange-500/10 px-2.5 py-2 text-left hover:border-orange-400 hover:bg-orange-500/20 transition"
          data-locate="roast-board"
        >
          <span class="text-base">🫘</span>
          <div class="min-w-0">
            <div class="font-pixel text-[9px] text-orange-200 truncate">Roast Lab</div>
            <div class="font-mono text-[9px] text-orange-300/70 truncate">V60 & Copper</div>
          </div>
        </button>

        <button
          type="button"
          class="cafe-station-btn flex items-center gap-2 rounded-lg border border-rose-500/30 bg-rose-500/10 px-2.5 py-2 text-left hover:border-rose-400 hover:bg-rose-500/20 transition"
          data-locate="pastry-case"
        >
          <span class="text-base">🍦</span>
          <div class="min-w-0">
            <div class="font-pixel text-[9px] text-rose-200 truncate">Pastry Case</div>
            <div class="font-mono text-[9px] text-rose-300/70 truncate">Castelia Cones</div>
          </div>
        </button>

        <button
          type="button"
          class="cafe-station-btn flex items-center gap-2 rounded-lg border border-cyan-500/30 bg-cyan-500/10 px-2.5 py-2 text-left hover:border-cyan-400 hover:bg-cyan-500/20 transition"
          data-locate="craft-tap"
        >
          <span class="text-base">🍹</span>
          <div class="min-w-0">
            <div class="font-pixel text-[9px] text-cyan-200 truncate">Craft Tap</div>
            <div class="font-mono text-[9px] text-cyan-300/70 truncate">Nitro & Tonic</div>
          </div>
        </button>

        <button
          type="button"
          class="cafe-station-btn flex items-center gap-2 rounded-lg border border-purple-500/30 bg-purple-500/10 px-2.5 py-2 text-left hover:border-purple-400 hover:bg-purple-500/20 transition"
          data-locate="vinyl-jukebox"
        >
          <span class="text-base">🎵</span>
          <div class="min-w-0">
            <div class="font-pixel text-[9px] text-purple-200 truncate">Jukebox</div>
            <div class="font-mono text-[9px] text-purple-300/70 truncate">Lo-Fi Vinyl</div>
          </div>
        </button>

        <button
          type="button"
          class="cafe-station-btn flex items-center gap-2 rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-2 text-left hover:border-emerald-400 hover:bg-emerald-500/20 transition"
          data-locate="vip-booth"
        >
          <span class="text-base">💬</span>
          <div class="min-w-0">
            <div class="font-pixel text-[9px] text-emerald-200 truncate">VIP Booth</div>
            <div class="font-mono text-[9px] text-emerald-300/70 truncate">Coffee Chat</div>
          </div>
        </button>
      </div>
    </section>

    <!-- 3. INTERACTIVE "BUILD YOUR DEV BLEND" CUSTOM ESPRESSO & CONE BREWER -->
    <section
      id="cafe-custom-brewer"
      aria-labelledby="brewer-heading"
      class="rounded-2xl border-2 border-amber-500/35 bg-gradient-to-b from-[#1e130d] to-[#140d09] p-5 shadow-xl"
    >
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-amber-500/20 pb-3">
        <div>
          <span class="font-mono text-[10px] uppercase tracking-widest text-amber-400">
            INTERACTIVE BARISTA SYNTHESIZER · 64 COMBINATIONS
          </span>
          <h2 id="brewer-heading" class="font-pixel text-base sm:text-lg text-amber-100 flex items-center gap-2 mt-0.5">
            <span>⚗️</span>
            <span>BUILD YOUR CUSTOM DEV BLEND</span>
          </h2>
        </div>
        <span class="rounded-lg border border-amber-400/30 bg-amber-500/10 px-2.5 py-1 font-mono text-[11px] text-amber-200">
          Triggers 2D Espresso Steam & +100% Stamina
        </span>
      </div>

      <div class="mt-4 grid grid-cols-1 lg:grid-cols-12 gap-5">
        <!-- Left 7 Cols: 3-Step Selector -->
        <div class="lg:col-span-7 space-y-4">
          <!-- Step 1: Base Bean -->
          <div>
            <label class="block font-pixel text-[10px] uppercase tracking-wider text-amber-300 mb-2">
              1. Select Base Bean / Stack Origin
            </label>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2" id="brew-step-base">
              <button
                type="button"
                class="brew-opt-btn is-selected flex items-center gap-2.5 rounded-xl border border-amber-400 bg-amber-500/20 p-2.5 text-left transition"
                data-group="base"
                data-val="Dark TypeScript Arabica"
                data-icon="☕"
                data-focus="98"
                data-speed="90"
                data-sweet="65"
                data-note="Strict-typed dark cacao & zero runtime bugs"
              >
                <span class="text-xl">☕</span>
                <div>
                  <div class="font-mono text-xs font-bold text-amber-100">Dark TypeScript Arabica</div>
                  <div class="font-mono text-[10px] text-amber-200/75">Strict-mode · Full-bodied</div>
                </div>
              </button>

              <button
                type="button"
                class="brew-opt-btn flex items-center gap-2.5 rounded-xl border border-amber-500/25 bg-black/30 p-2.5 text-left hover:border-amber-400/60 transition"
                data-group="base"
                data-val="YOLOv11 TensorRT Roast"
                data-icon="⚡"
                data-focus="96"
                data-speed="100"
                data-sweet="70"
                data-note="1.8ms quantized extraction at 75+ FPS"
              >
                <span class="text-xl">⚡</span>
                <div>
                  <div class="font-mono text-xs font-bold text-amber-100">YOLOv11 TensorRT Roast</div>
                  <div class="font-mono text-[10px] text-amber-200/75">Sub-2ms latency · High voltage</div>
                </div>
              </button>

              <button
                type="button"
                class="brew-opt-btn flex items-center gap-2.5 rounded-xl border border-amber-500/25 bg-black/30 p-2.5 text-left hover:border-amber-400/60 transition"
                data-group="base"
                data-val="Laravel 12 Velvet Blend"
                data-icon="🫖"
                data-focus="94"
                data-speed="88"
                data-sweet="82"
                data-note="Clean-architecture floral & PostGIS spice"
