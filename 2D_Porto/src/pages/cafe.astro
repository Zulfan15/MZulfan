          <div class="mt-4 pt-3 border-t border-emerald-500/20 space-y-2">
            <a
              id="vip-mailto-link"
              href={`mailto:${profile.person.email}?subject=${encodeURIComponent('Coffee Chat: Full-Stack / Backend Engineering Role')}&body=${encodeURIComponent("Hi Zulfan, I just visited your Poké-Café & Bar portfolio! I'd love to schedule a quick 15-minute coffee chat to discuss a Full-Stack / Software Engineering opportunity with our team.")}`}
              class="w-full rounded-xl border border-emerald-300 bg-emerald-500 px-4 py-2.5 font-pixel text-xs uppercase tracking-wider text-slate-950 font-bold shadow-lg hover:brightness-110 transition flex items-center justify-center gap-2"
