              <a
                href="/"
                onclick="sessionStorage.setItem('town:respawn', '29,32')"
                class="rounded-lg border border-slate-600/50 bg-slate-800/50 px-3 py-1.5 font-mono text-[10px] text-slate-200 hover:border-amber-400/50 text-center transition"
