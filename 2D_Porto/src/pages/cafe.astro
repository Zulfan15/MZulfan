<style>
  .cafe-stamp-slot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.65rem;
    height: 1.65rem;
    border-radius: 0.5rem;
    border: 1px dashed rgba(251, 191, 36, 0.45);
    background: rgba(0, 0, 0, 0.35);
    font-size: 0.8rem;
    color: rgba(251, 191, 36, 0.55);
    transition: all 0.25s ease;
  }
  .cafe-stamp-slot.is-filled {
    border-style: solid;
    border-color: rgba(251, 191, 36, 0.9);
    background: rgba(245, 158, 11, 0.25);
    color: #fde68a;
    transform: scale(1.05);
    box-shadow: 0 0 10px rgba(245, 158, 11, 0.3);
  }
  @keyframes vinylSpin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
  .cafe-vinyl-disc.is-spinning {
    animation: vinylSpin 7s linear infinite;
  }
</style>

<script>
  import { sfx } from '../game/sfx';

  function initCafePage() {
    const STORAGE_KEY = 'town:cafe-loyalty-stamps';
    let stamps = 1;
    try {
      const saved = Number(localStorage.getItem(STORAGE_KEY));
      if (!Number.isNaN(saved) && saved >= 1 && saved <= 5) {
        stamps = saved;
      }
    } catch {
      stamps = 1;
    }

    const stampCounterEl = document.getElementById('cafe-stamp-counter');
    const stampHintEl = document.getElementById('cafe-stamp-hint');
    const vipBadgeEl = document.getElementById('cafe-vip-badge');
    const stampSlots = document.querySelectorAll<HTMLElement>('#cafe-stamp-slots .cafe-stamp-slot');
    const focusPctEl = document.getElementById('cafe-focus-pct');

    function renderStamps() {
      if (stampCounterEl) stampCounterEl.textContent = `${stamps} / 5`;
      stampSlots.forEach((slot, idx) => {
        if (idx < stamps) {
          slot.classList.add('is-filled');
          slot.textContent = idx === 4 ? '👑' : '☕';
        } else {
          slot.classList.remove('is-filled');
          slot.textContent = idx === 4 ? '👑' : '○';
        }
      });
      if (stamps >= 5) {
        vipBadgeEl?.classList.remove('hidden');
        if (stampHintEl) {
          stampHintEl.textContent = '🎉 VIP Golden Roaster unlocked! Unlimited espresso refills active!';
        }
      } else if (stampHintEl) {
        const rem = 5 - stamps;
        stampHintEl.textContent = `Sip or brew ${rem} more creation${rem === 1 ? '' : 's'} for the VIP Golden Cup!`;
      }
    }

    function addLoyaltyStamp(toastMessage?: string) {
      if (stamps < 5) {
        stamps += 1;
        try {
          localStorage.setItem(STORAGE_KEY, String(stamps));
        } catch {
          // ignore storage quota errors
        }
      }
      renderStamps();
      if (focusPctEl) {
        focusPctEl.textContent = '100% MAX';
      }
      if (toastMessage) {
        const toast = document.getElementById('cafe-brew-toast');
        if (toast) {
          toast.textContent = toastMessage;
          toast.classList.remove('hidden');
          setTimeout(() => {
            toast.classList.add('hidden');
          }, 4200);
        }
      }
    }

    renderStamps();

    // 1. Barista Rio & Alcremie Dialogue Switcher
    const speakerEl = document.getElementById('cafe-dialogue-speaker');
    const quoteEl = document.getElementById('cafe-dialogue-text');
    const topicBtns = document.querySelectorAll<HTMLButtonElement>('.cafe-topic-btn');

    topicBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        sfx.select();
        topicBtns.forEach((b) => {
          b.classList.remove('is-active', 'border-amber-400/40', 'bg-amber-500/20');
        });
        btn.classList.add('is-active', 'border-amber-400/40', 'bg-amber-500/20');
        if (speakerEl && btn.dataset.speaker) speakerEl.textContent = btn.dataset.speaker;
        if (quoteEl && btn.dataset.quote) quoteEl.textContent = `"${btn.dataset.quote}"`;
        if (btn.dataset.prop) {
          window.dispatchEvent(new CustomEvent('town:locate', { detail: { id: btn.dataset.prop } }));
        }
      });
    });

    document.getElementById('btn-walk-barista')?.addEventListener('click', () => {
      sfx.espressoBrew();
      window.dispatchEvent(new CustomEvent('town:locate', { detail: { id: 'barista' } }));
    });

    document.getElementById('btn-walk-alcremie')?.addEventListener('click', () => {
      sfx.heal();
      window.dispatchEvent(new CustomEvent('town:locate', { detail: { id: 'alcremie' } }));
    });

    // 2. 2D Station Walk Buttons
    const stationBtns = document.querySelectorAll<HTMLButtonElement>('.cafe-station-btn');
    stationBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.locate;
        if (!id) return;
        sfx.select();
        window.dispatchEvent(new CustomEvent('town:locate', { detail: { id } }));
      });
    });

    // 3. Custom Dev Blend Synthesizer
    let selectedBase = {
      val: 'Dark TypeScript Arabica',
      icon: '☕',
      focus: 98,
      speed: 90,
      sweet: 65,
      note: 'Strict-typed dark cacao & zero runtime bugs',
    };
    let selectedMethod = {
      val: '9-Bar Double Ristretto',
      temp: 'HOT · 93°C',
    };
    let selectedTopping = 'Alcremie Strawberry Whip 🍓';

    const titleEl = document.getElementById('brew-preview-title');
    const iconEl = document.getElementById('brew-preview-icon');
    const methodEl = document.getElementById('brew-preview-method');
    const toppingEl = document.getElementById('brew-preview-topping');
    const tempEl = document.getElementById('brew-preview-temp');
    const noteEl = document.getElementById('brew-preview-note');
    const barFocus = document.getElementById('brew-bar-focus');
    const barFocusVal = document.getElementById('brew-bar-focus-val');
    const barSpeed = document.getElementById('brew-bar-speed');
    const barSpeedVal = document.getElementById('brew-bar-speed-val');
    const barSweet = document.getElementById('brew-bar-sweet');
    const barSweetVal = document.getElementById('brew-bar-sweet-val');

    function updateBlendPreview() {
      if (titleEl) titleEl.textContent = selectedBase.val;
      if (iconEl) iconEl.textContent = selectedBase.icon;
      if (methodEl) methodEl.textContent = selectedMethod.val;
      if (toppingEl) toppingEl.textContent = selectedTopping;
      if (tempEl) tempEl.textContent = selectedMethod.temp;
      if (noteEl) noteEl.textContent = `"${selectedBase.note}"`;

      if (barFocus) barFocus.style.width = `${selectedBase.focus}%`;
      if (barFocusVal) barFocusVal.textContent = `${selectedBase.focus}%`;
      if (barSpeed) barSpeed.style.width = `${selectedBase.speed}%`;
      if (barSpeedVal) barSpeedVal.textContent = `${selectedBase.speed}%`;
      if (barSweet) barSweet.style.width = `${selectedBase.sweet}%`;
      if (barSweetVal) barSweetVal.textContent = `${selectedBase.sweet}%`;
    }

    const optBtns = document.querySelectorAll<HTMLButtonElement>('.brew-opt-btn');
    optBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        sfx.select();
        const grp = btn.dataset.group;
        if (!grp) return;
        document.querySelectorAll<HTMLButtonElement>(`.brew-opt-btn[data-group="${grp}"]`).forEach((b) => {
          b.classList.remove('is-selected', 'border-amber-400', 'bg-amber-500/20');
          b.classList.add('border-amber-500/25', 'bg-black/30');
        });
        btn.classList.remove('border-amber-500/25', 'bg-black/30');
        btn.classList.add('is-selected', 'border-amber-400', 'bg-amber-500/20');

        if (grp === 'base') {
          selectedBase = {
            val: btn.dataset.val || 'Dark TypeScript Arabica',
            icon: btn.dataset.icon || '☕',
            focus: Number(btn.dataset.focus || 95),
            speed: Number(btn.dataset.speed || 90),
            sweet: Number(btn.dataset.sweet || 75),
            note: btn.dataset.note || 'Freshly roasted developer blend',
          };
        } else if (grp === 'method') {
          selectedMethod = {
            val: btn.dataset.val || '9-Bar Double Ristretto',
            temp: btn.dataset.temp || 'HOT · 93°C',
          };
        } else if (grp === 'topping') {
          selectedTopping = btn.dataset.val || 'Alcremie Strawberry Whip 🍓';
        }
        updateBlendPreview();
      });
    });

    document.getElementById('btn-brew-custom')?.addEventListener('click', () => {
      sfx.espressoBrew();
      const shortLabel = `${selectedBase.icon} ${selectedBase.val.toUpperCase()}! +100%`;
      window.dispatchEvent(new CustomEvent('town:cafe-brew-anim', { detail: { text: shortLabel } }));
      window.dispatchEvent(new CustomEvent('town:coffee-boost'));
      document.dispatchEvent(new CustomEvent('town:refill-balls'));
      addLoyaltyStamp(
        `☕ Freshly brewed "${selectedBase.val}" (${selectedMethod.val}) topped with ${selectedTopping}! +100% Focus & Speed Boost active!`
      );
    });

    document.getElementById('btn-surprise-blend')?.addEventListener('click', () => {
      const bases = Array.from(document.querySelectorAll<HTMLButtonElement>('.brew-opt-btn[data-group="base"]'));
      const methods = Array.from(document.querySelectorAll<HTMLButtonElement>('.brew-opt-btn[data-group="method"]'));
      const toppings = Array.from(document.querySelectorAll<HTMLButtonElement>('.brew-opt-btn[data-group="topping"]'));
      bases[Math.floor(Math.random() * bases.length)]?.click();
      methods[Math.floor(Math.random() * methods.length)]?.click();
      toppings[Math.floor(Math.random() * toppings.length)]?.click();
      sfx.martChime();
    });

    document.getElementById('btn-copy-receipt')?.addEventListener('click', async () => {
      sfx.cashRegister();
      const receipt = [
        '╔══════════════════════════════════════════╗',
        "║   ☕ ZULFAN'S POKÉ-CAFÉ & ROASTERY BAR   ║",
        '╠══════════════════════════════════════════╣',
        `║ Blend   : ${selectedBase.val}`,
        `║ Method  : ${selectedMethod.val} (${selectedMethod.temp})`,
        `║ Garnish : ${selectedTopping}`,
        `║ Focus   : ${selectedBase.focus}% | Throughput: ${selectedBase.speed}%`,
        '║ Buff    : +100% Coding Stamina & Zero Bugs',
        '╚══════════════════════════════════════════╝',
      ].join('\n');
      try {
        await navigator.clipboard.writeText(receipt);
        addLoyaltyStamp('🧾 Custom Cup Receipt copied to clipboard!');
      } catch {
        addLoyaltyStamp('🧾 Receipt ready! Enjoy your custom blend!');
      }
    });

    // 4. Menu Filtering & Ordering
    const filterTabs = document.querySelectorAll<HTMLButtonElement>('.cafe-filter-tab');
    const menuCards = document.querySelectorAll<HTMLElement>('.cafe-menu-card');

    function applyMenuFilter(category: string) {
      filterTabs.forEach((tab) => {
        const active = tab.dataset.filter === category;
        tab.classList.toggle('is-active', active);
        tab.classList.toggle('border-amber-400', active);
        tab.classList.toggle('bg-amber-500/25', active);
      });
      menuCards.forEach((card) => {
        const match = category === 'all' || card.dataset.category === category;
        card.style.display = match ? '' : 'none';
      });
    }

    filterTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        sfx.select();
        applyMenuFilter(tab.dataset.filter || 'all');
      });
    });

    window.addEventListener('town:cafe-filter', (e: Event) => {
      const ce = e as CustomEvent<{ category?: string }>;
      if (ce.detail?.category) {
        applyMenuFilter(ce.detail.category);
      }
    });

    document.querySelectorAll<HTMLButtonElement>('.cafe-order-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const name = btn.dataset.orderName || 'Dev Roast';
        const icon = btn.dataset.orderIcon || '☕';
        const prop = btn.dataset.orderProp || 'barista';
        sfx.espressoBrew();
        window.dispatchEvent(new CustomEvent('town:locate', { detail: { id: prop } }));
        window.dispatchEvent(
          new CustomEvent('town:cafe-brew-anim', {
            detail: { text: `${icon} ${name.toUpperCase().slice(0, 22)}!` },
          })
        );
        window.dispatchEvent(new CustomEvent('town:coffee-boost'));
        document.dispatchEvent(new CustomEvent('town:refill-balls'));
        const originalText = btn.textContent;
        btn.textContent = '✨ Served (+100%)';
        addLoyaltyStamp(`${icon} Served fresh: ${name}! Stamina & Poké Balls restored to 100%!`);
        setTimeout(() => {
          btn.textContent = originalText;
        }, 2000);
      });
    });

    // 5. Lo-Fi Vinyl Jukebox Controller
    const trackBtns = document.querySelectorAll<HTMLButtonElement>('.cafe-track-btn');
    const nowPlayingEl = document.getElementById('jukebox-now-playing');
    const nowSubEl = document.getElementById('jukebox-now-sub');
    const vinylLabelEl = document.getElementById('cafe-vinyl-label');

    function selectJukeboxTrack(btn: HTMLButtonElement) {
      sfx.discSpin();
      trackBtns.forEach((b) => {
        b.classList.remove('is-active', 'border-purple-400', 'bg-purple-500/20');
        b.classList.add('border-purple-500/25', 'bg-black/30');
        const badge = b.querySelector('span:last-child');
        if (badge) badge.textContent = 'PLAY ▶';
      });
      btn.classList.remove('border-purple-500/25', 'bg-black/30');
      btn.classList.add('is-active', 'border-purple-400', 'bg-purple-500/20');
      const activeBadge = btn.querySelector('span:last-child');
      if (activeBadge) activeBadge.textContent = 'SPINNING';

      if (nowPlayingEl && btn.dataset.trackTitle) nowPlayingEl.textContent = btn.dataset.trackTitle;
      if (nowSubEl && btn.dataset.trackSub) nowSubEl.textContent = btn.dataset.trackSub;
      if (vinylLabelEl && btn.dataset.trackIcon) vinylLabelEl.textContent = btn.dataset.trackIcon;

      const mood = (btn.dataset.trackMood || 'day') as 'day' | 'sunset' | 'night';
      sfx.setBgmTheme(mood);
      window.dispatchEvent(new CustomEvent('town:set-atmosphere', { detail: { atmosphere: mood } }));
      window.dispatchEvent(
        new CustomEvent('town:cafe-brew-anim', {
          detail: { text: `🎵 ${btn.dataset.trackTitle?.toUpperCase().slice(0, 24) || 'LO-FI VINYL'}` },
        })
      );
    }

    trackBtns.forEach((btn) => {
      btn.addEventListener('click', () => selectJukeboxTrack(btn));
    });

    window.addEventListener('town:cafe-jukebox-track', (e: Event) => {
      const ce = e as CustomEvent<{ mood?: string }>;
      const targetBtn = document.querySelector<HTMLButtonElement>(
        `.cafe-track-btn[data-track-mood="${ce.detail?.mood || 'night'}"]`
      );
      if (targetBtn) selectJukeboxTrack(targetBtn);
    });

    document.getElementById('btn-locate-jukebox')?.addEventListener('click', () => {
      sfx.discSpin();
      window.dispatchEvent(new CustomEvent('town:locate', { detail: { id: 'vinyl-jukebox' } }));
    });

    // 6. VIP Coffee Chat Topic Switcher
    const vipTopics = document.querySelectorAll<HTMLButtonElement>('.vip-chat-topic');
    const vipPreview = document.getElementById('vip-message-preview');
    const vipMailto = document.getElementById('vip-mailto-link') as HTMLAnchorElement | null;

    vipTopics.forEach((btn) => {
      btn.addEventListener('click', () => {
        sfx.select();
        vipTopics.forEach((b) => {
          b.classList.remove('is-selected', 'border-emerald-400', 'bg-emerald-500/20');
          b.classList.add('border-emerald-500/25', 'bg-black/30');
        });
        btn.classList.remove('border-emerald-500/25', 'bg-black/30');
        btn.classList.add('is-selected', 'border-emerald-400', 'bg-emerald-500/20');

        const subj = btn.dataset.subject || 'Coffee Chat with Zulfan';
        const body = btn.dataset.body || '';
        if (vipPreview) vipPreview.textContent = `"${body}"`;
        if (vipMailto) {
          const baseEmail = vipMailto.href.split('?')[0];
          vipMailto.href = `${baseEmail}?subject=${encodeURIComponent(subj)}&body=${encodeURIComponent(body)}`;
        }
        window.dispatchEvent(new CustomEvent('town:locate', { detail: { id: 'vip-booth' } }));
      });
    });

    // 7. Global Keyboard Shortcuts on /cafe
    window.addEventListener('keydown', (e) => {
      const tag = (e.target as HTMLElement | null)?.tagName;
      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || e.metaKey || e.ctrlKey || e.altKey) return;
      const key = e.key.toLowerCase();
      if (key === 'b') {
        document.getElementById('cafe-custom-brewer')?.scrollIntoView({ behavior: 'smooth' });
      } else if (key === 'm') {
        document.getElementById('cafe-menu-grid')?.scrollIntoView({ behavior: 'smooth' });
      } else if (key === 'j') {
        document.getElementById('cafe-jukebox-section')?.scrollIntoView({ behavior: 'smooth' });
      } else if (key === 'c') {
        document.getElementById('cafe-vip-lounge')?.scrollIntoView({ behavior: 'smooth' });
      }
    });
  }

  initCafePage();
</script>
