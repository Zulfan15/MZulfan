  <script>
    import { awardAbyssalSeal, countAbyssalSeals, getAbyssalSeals } from '../../engine/darkInteriorShared';

    function emitCathedralWave(text: string, color: string) {
      window.dispatchEvent(new CustomEvent('town:cathedral-fx', { detail: { text, color } }));
    }

    function initCathedralPage() {
      // 1. Canvas Quick-Walk & Tri-Cantor Dialogue
      const speakerEl = document.getElementById('cathedral-speaker');
      const dialogueEl = document.getElementById('cathedral-dialogue');

      let audioCtx: AudioContext | null = null;
      const FREQS = [261.63, 329.63, 392.0, 523.25]; // C4, E4, G4, C5
      const NOTE_COLORS = ['#c084fc', '#fb7185', '#fbbf24', '#38bdf8'];
      const NOTE_LABELS = ['AMETHYST C4', 'CRIMSON E4', 'GOLD G4', 'CYAN C5'];

      function playOrganTone(freq: number, durationMs = 340, type: OscillatorType = 'sine') {
        try {
          if (!audioCtx) {
            audioCtx = new (window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext)();
          }
          if (audioCtx.state === 'suspended') {
            audioCtx.resume();
          }
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = type;
          osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
          gain.gain.setValueAtTime(0.01, audioCtx.currentTime);
          gain.gain.linearRampToValueAtTime(0.18, audioCtx.currentTime + 0.04);
          gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + durationMs / 1000);
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start();
          osc.stop(audioCtx.currentTime + durationMs / 1000);
        } catch {
          // Ignore autoplay restrictions
        }
      }

      const activateCathStation = (btn: HTMLButtonElement) => {
        const id = btn.dataset.cathWalk || btn.dataset.walk;
        const scrollTo = btn.dataset.scrollTo;
        if (btn.dataset.speaker && speakerEl) speakerEl.textContent = btn.dataset.speaker;
        if (btn.dataset.quote && dialogueEl) dialogueEl.textContent = `“${btn.dataset.quote}”`;
        if (id) {
          playOrganTone(440, 140, 'triangle');
          window.dispatchEvent(new CustomEvent('town:locate', { detail: { id } }));
          if (btn.dataset.fxText) {
            emitCathedralWave(btn.dataset.fxText, btn.dataset.fxColor || '#c084fc');
          }
        }
        if (scrollTo) {
          document.getElementById(scrollTo)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      };

      document.querySelectorAll<HTMLButtonElement>('[data-cath-walk], .cath-station-btn').forEach((btn) => {
        btn.addEventListener('click', () => activateCathStation(btn));
      });

      document.getElementById('btn-scroll-organ')?.addEventListener('click', () => {
        document.getElementById('cathedral-echo-puzzle')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });

      // 2. Seal Synchronization & Sovereign Tracker
      const sealBadge = document.getElementById('cathedral-seal-badge');
      const masterBadge = document.getElementById('cathedral-master-badge');
      const liveDot = document.getElementById('cathedral-live-dot');
      const stageReadout = document.getElementById('cathedral-stage-readout');
      const cofferLocked = document.getElementById('cathedral-coffer-locked');
      const cofferUnlocked = document.getElementById('cathedral-coffer-unlocked');
      const cofferPill = document.getElementById('cathedral-coffer-pill');
      const cofferSub = document.getElementById('cathedral-coffer-subtext');

      function refreshCathedralSeals() {
        const seals = getAbyssalSeals();
        const total = countAbyssalSeals(seals);
        const abyssalCountEl = document.getElementById('cathedral-abyssal-count');
        const obeliskPill = document.getElementById('cathedral-obelisk-pill');
        if (abyssalCountEl) abyssalCountEl.textContent = `${total} / 4`;
        if (obeliskPill) {
          obeliskPill.textContent = total === 4 ? '🌌 Obelisk Awakened (4/4)' : `${total} / 4 Seals`;
          obeliskPill.className =
            total === 4
              ? 'rounded-full border border-emerald-400/70 bg-emerald-950/80 px-2.5 py-0.5 font-mono text-[10px] font-bold text-emerald-200'
              : 'rounded-full border border-slate-700 bg-slate-900 px-2.5 py-0.5 font-mono text-[10px] font-bold text-slate-300';
        }
        (['echoes', 'ember', 'valor', 'eternity'] as const).forEach((k) => {
          const unlocked = Boolean(seals[k]);
          const badge = document.getElementById(`cathedral-seal-status-${k}`);
          const card = document.querySelector<HTMLElement>(`[data-cath-seal-card="${k}"]`);
          if (badge) {
            badge.textContent = unlocked ? 'UNLOCKED' : 'LOCKED';
            badge.className = unlocked
              ? 'shrink-0 rounded-full border border-emerald-400/60 bg-emerald-950/75 px-2 py-0.5 font-mono text-[9px] font-bold text-emerald-300'
              : 'shrink-0 rounded-full border border-slate-700 bg-slate-900 px-2 py-0.5 font-mono text-[9px] font-bold text-slate-400';
          }
          if (card) card.classList.toggle('border-emerald-500/60', unlocked);
        });
      }

      function markOrganStagesCleared(clearedCount: number) {
        if (stageReadout) {
          stageReadout.textContent = clearedCount >= 3 ? 'AWAKENED' : `${clearedCount} / 3`;
          stageReadout.className =
            clearedCount >= 3
              ? "font-['Press_Start_2P',monospace] text-xs sm:text-sm text-emerald-300"
              : "font-['Press_Start_2P',monospace] text-sm sm:text-base text-[#c084fc]";
        }
        [1, 2, 3].forEach((idx) => {
          const box = document.getElementById(`organ-stage-${idx}`);
          const icon = document.getElementById(`organ-stage-icon-${idx}`);
          const cleared = idx <= clearedCount;
          if (box && icon) {
            box.className = cleared
              ? 'flex items-center justify-between gap-1.5 rounded-lg border border-emerald-400/60 bg-emerald-950/60 px-2.5 py-1.5 shadow-[0_0_10px_rgba(52,211,153,0.18)] transition-all'
              : 'flex items-center justify-between gap-1.5 rounded-lg border border-purple-900/60 bg-[#130724] px-2.5 py-1.5 transition-all';
            icon.textContent = cleared ? '✨' : '🔒';
          }
        });
      }

      function applyEchoesUnlockedUI() {
        if (sealBadge) {
          sealBadge.textContent = '🟣 SEAL OF ECHOES: AWAKENED';
          sealBadge.className =
            'inline-flex items-center gap-1.5 rounded-full border border-emerald-400/60 bg-emerald-950/75 px-2.5 py-0.5 font-mono text-[10px] font-bold uppercase tracking-wider text-emerald-200';
        }
        if (masterBadge) {
          masterBadge.classList.remove('hidden');
          masterBadge.classList.add('inline-flex');
        }
        if (liveDot) liveDot.className = 'h-2 w-2 rounded-full bg-emerald-400';
        markOrganStagesCleared(3);
        cofferLocked?.classList.add('hidden');
        cofferUnlocked?.classList.remove('hidden');
        if (cofferPill) {
          cofferPill.textContent = '🔓 Unsealed';
          cofferPill.className =
            'rounded-full border border-emerald-500/50 bg-emerald-950/70 px-2.5 py-0.5 font-mono text-[10px] font-bold text-emerald-300';
        }
        if (cofferSub) {
          cofferSub.textContent = 'Seal of Echoes awakened! Zero-Asset WebAudio Synth Blueprint ready.';
        }
        refreshCathedralSeals();
      }

      refreshCathedralSeals();
      if (getAbyssalSeals().echoes) {
        applyEchoesUnlockedUI();
      }

      // 3. Echoes of the Cathedral 2.0 (Memory Puzzle + Free-Play Jam Mode)
      let round = 1;
      const MAX_ROUNDS = 3;
      let sequence: number[] = [];
      let playerStep = 0;
      let isPlayingSequence = false;
      let trialActive = false;
      let cancelled = false;

      const roundTracker = document.getElementById('organ-round-tracker');
      const statusMsg = document.getElementById('organ-status-msg');
      const stepProgress = document.getElementById('organ-step-progress');
      const modePill = document.getElementById('organ-mode-pill');
      const startBtn = document.getElementById('btn-start-organ-game');
      const replayBtn = document.getElementById('btn-replay-organ');
      const organKeys = document.querySelectorAll<HTMLButtonElement>('[data-organ-note]');

      function flashKey(noteIdx: number, withWave = false) {
        const btn = document.querySelector<HTMLButtonElement>(`[data-organ-note="${noteIdx}"]`);
        if (!btn) return;
        btn.classList.add('ring-4', 'ring-amber-300', 'brightness-125', 'scale-[1.03]');
        playOrganTone(FREQS[noteIdx], 380);
        if (withWave) {
          emitCathedralWave(NOTE_LABELS[noteIdx], NOTE_COLORS[noteIdx]);
        }
        setTimeout(() => {
          btn.classList.remove('ring-4', 'ring-amber-300', 'brightness-125', 'scale-[1.03]');
        }, 280);
      }

      async function playSequence() {
        isPlayingSequence = true;
        organKeys.forEach((k) => (k.disabled = true));
        if (statusMsg) statusMsg.textContent = `Listen closely to Round ${round} melody (${sequence.length} notes)...`;
        if (stepProgress) stepProgress.textContent = `Playing ${sequence.length} notes...`;

        await new Promise((r) => setTimeout(r, 450));
        for (let i = 0; i < sequence.length; i++) {
          if (cancelled) return;
          flashKey(sequence[i], true);
          await new Promise((r) => setTimeout(r, 560));
        }

        if (cancelled) return;
        isPlayingSequence = false;
        playerStep = 0;
        organKeys.forEach((k) => (k.disabled = false));
        if (statusMsg) statusMsg.textContent = `Your turn! Repeat the ${sequence.length}-note sequence using pipes or keys 1–4.`;
        if (stepProgress) stepProgress.textContent = `Step 0 / ${sequence.length}`;
      }

      function startRound(r: number) {
        trialActive = true;
        round = r;
        if (roundTracker) roundTracker.textContent = `Round ${round} / ${MAX_ROUNDS}`;
        if (modePill) {
          modePill.textContent = `🎵 Trial Stage ${round}/3`;
          modePill.className =
            'rounded-full border border-amber-400/70 bg-amber-950/75 px-2 py-0.5 font-mono text-[10px] font-bold text-amber-200';
        }
        sequence = [];
        const length = round + 2; // 3, 4, 5 notes
        for (let i = 0; i < length; i++) {
          sequence.push(Math.floor(Math.random() * 4));
        }
        playSequence();
      }

      startBtn?.addEventListener('click', () => {
        markOrganStagesCleared(getAbyssalSeals().echoes ? 3 : 0);
        startRound(1);
      });

      replayBtn?.addEventListener('click', () => {
        if (!trialActive || sequence.length === 0 || isPlayingSequence) {
          if (statusMsg) statusMsg.textContent = 'Start the Echo Trial first to hear a melody sequence.';
          return;
        }
        playSequence();
      });

      function handleNotePress(note: number) {
        if (isPlayingSequence) return;
        flashKey(note, true);

        if (!trialActive || sequence.length === 0) {
          if (stepProgress) stepProgress.textContent = `Free Jam · ${NOTE_LABELS[note]}`;
          return;
        }

        if (note === sequence[playerStep]) {
          playerStep++;
          if (stepProgress) stepProgress.textContent = `Step ${playerStep} / ${sequence.length}`;
          if (playerStep === sequence.length) {
            markOrganStagesCleared(round);
            if (round < MAX_ROUNDS) {
              if (statusMsg) {
                statusMsg.textContent = `✨ Harmonic match! Advancing to Round ${round + 1}...`;
              }
              setTimeout(() => {
                if (!cancelled) startRound(round + 1);
              }, 850);
            } else {
              trialActive = false;
              awardAbyssalSeal('echoes');
              applyEchoesUnlockedUI();
              FREQS.forEach((f, i) => setTimeout(() => playOrganTone(f, 450), i * 95));
              emitCathedralWave('SEAL OF ECHOES!', '#c084fc');
              if (modePill) {
                modePill.textContent = '👑 Awakening Complete';
                modePill.className =
                  'rounded-full border border-emerald-400/70 bg-emerald-950/80 px-2 py-0.5 font-mono text-[10px] font-bold text-emerald-200';
              }
              if (statusMsg) {
                statusMsg.innerHTML =
                  '<span class="text-emerald-300 font-bold">🎉 SEAL OF ECHOES AWAKENED! Rose Window Blueprint unlocked below!</span>';
              }
              if (stepProgress) stepProgress.textContent = 'All 3 Stages Cleared!';
            }
          }
        } else {
          playerStep = 0;
          playOrganTone(165, 220, 'sawtooth');
          emitCathedralWave('DISCORDANT NOTE!', '#ef4444');
          if (statusMsg) {
            statusMsg.textContent = `❌ Discordant chime on Round ${round}! Replaying melody — listen again!`;
          }
          setTimeout(() => {
            if (!cancelled && trialActive) playSequence();
          }, 750);
        }
      }

      organKeys.forEach((btn) => {
        btn.addEventListener('click', () => {
          const note = parseInt(btn.getAttribute('data-organ-note') || '0', 10);
          handleNotePress(note);
        });
      });

      const onCathHotkey = (e: KeyboardEvent) => {
        const target = e.target as HTMLElement | null;
        if (target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable)) return;
        if (e.key >= '1' && e.key <= '4') {
          e.preventDefault();
          handleNotePress(parseInt(e.key, 10) - 1);
          return;
        }
        const k = e.key.toLowerCase();
        const matched = document.querySelector<HTMLButtonElement>(`.cath-station-btn[data-key="${k}"]`);
        if (matched) {
          e.preventDefault();
          activateCathStation(matched);
        }
      };
      window.addEventListener('keydown', onCathHotkey);

      // 4. The Obsidian Grimoire 2.0 Interactive Stepper
      interface WarTale {
        id: string;
        chapter: string;
        icon: string;
        title: string;
        severity: string;
        metric: string;
        rootCause: string;
        solution: string;
        pattern: string;
        waveText: string;
        waveColor: string;
      }
      const tales = (window as unknown as { __CATHEDRAL_WAR_STORIES__: WarTale[] }).__CATHEDRAL_WAR_STORIES__ || [];
      let activeTale = 0;
      const grimoireTabs = document.querySelectorAll<HTMLButtonElement>('[data-grimoire-tab]');

      function renderTale(idx: number, withWave = false) {
        const t = tales[idx];
        if (!t) return;
        activeTale = idx;

        grimoireTabs.forEach((tab, i) => {
          tab.className =
            i === idx
              ? 'grimoire-tab flex flex-col items-start rounded-xl border-2 border-[#fbbf24] bg-gradient-to-b from-[#3b0764] to-[#21043b] p-2.5 text-left text-[#fef3c7] shadow-[0_3px_0_#78350f] transition cursor-pointer'
              : 'grimoire-tab flex flex-col items-start rounded-xl border-2 border-purple-900/60 bg-[#120624] p-2.5 text-left text-slate-300 hover:border-purple-500/70 transition cursor-pointer';
        });

        const ch = document.getElementById('grimoire-chapter');
        const mt = document.getElementById('grimoire-metric');
        const sv = document.getElementById('grimoire-severity');
        const ti = document.getElementById('grimoire-title');
        const rc = document.getElementById('grimoire-root');
        const so = document.getElementById('grimoire-solution');
        const pt = document.getElementById('grimoire-pattern');

        if (ch) ch.textContent = t.chapter;
        if (mt) mt.textContent = t.metric;
        if (sv) sv.textContent = t.severity;
        if (ti) ti.textContent = `${t.icon} ${t.title}`;
        if (rc) rc.textContent = t.rootCause;
        if (so) so.textContent = t.solution;
        if (pt) pt.textContent = `Pattern: ${t.pattern}`;

        if (withWave) {
          emitCathedralWave(t.waveText, t.waveColor);
        }
      }

      grimoireTabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const idx = parseInt(tab.getAttribute('data-grimoire-tab') || '0', 10);
          playOrganTone(FREQS[idx % 4], 180);
          renderTale(idx, true);
        });
      });

      document.getElementById('btn-next-grimoire')?.addEventListener('click', () => {
        const nxt = (activeTale + 1) % Math.max(1, tales.length);
        playOrganTone(FREQS[nxt % 4], 180);
        renderTale(nxt, true);
      });

      document.getElementById('btn-walk-grimoire')?.addEventListener('click', () => {
        const t = tales[activeTale];
        playOrganTone(523.25, 160);
        window.dispatchEvent(new CustomEvent('town:locate', { detail: { id: 'war-stories-grimoire' } }));
        if (t) emitCathedralWave(t.waveText, t.waveColor);
      });

      // 5. Confession Shrine Spirit Cleanse (+50% Speed Overclock Buff)
      const shrineBtn = document.getElementById('btn-shrine-cleanse');
      const shrineStatus = document.getElementById('shrine-buff-status');
      let shrineTimer: number | null = null;

      shrineBtn?.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('town:claim-lucky-egg'));
        window.dispatchEvent(new CustomEvent('town:locate', { detail: { id: 'confession-shrine' } }));
        emitCathedralWave('SPIRIT CLEANSED +50% SPD', '#38bdf8');
        [523.25, 659.25, 783.99].forEach((f, idx) => setTimeout(() => playOrganTone(f, 220), idx * 75));

        if (speakerEl) speakerEl.textContent = '🕯️ Spirit Cleanse Shrine (NE)';
        if (dialogueEl) {
          dialogueEl.textContent =
            '“Spirit purified! You glide +50% faster across Shadow Cathedral and every Dark Castle realm for 25 seconds.”';
        }

        if (shrineTimer !== null) clearInterval(shrineTimer);
        let rem = 25;
        const updateBuff = () => {
          if (!shrineStatus) return;
          if (rem > 0) {
            shrineStatus.textContent = `✨ ACTIVE +50% (${rem}s)`;
            shrineStatus.className =
              'rounded-full border border-sky-400/80 bg-sky-500/20 px-2 py-0.5 font-mono text-[9px] font-black text-sky-200 animate-pulse';
          } else {
            shrineStatus.textContent = 'READY';
            shrineStatus.className =
              'rounded-full border border-sky-400/40 bg-sky-950/70 px-2 py-0.5 font-mono text-[9px] font-bold text-sky-200';
            if (shrineTimer !== null) {
              clearInterval(shrineTimer);
              shrineTimer = null;
            }
          }
        };
        updateBuff();
        shrineTimer = window.setInterval(() => {
          rem--;
          updateBuff();
        }, 1000);
      });

      document.addEventListener(
        'astro:before-swap',
        () => {
          cancelled = true;
          if (shrineTimer !== null) clearInterval(shrineTimer);
          window.removeEventListener('keydown', onCathHotkey);
        },
        { once: true }
      );
    }

    initCathedralPage();
    document.addEventListener('astro:page-load', initCathedralPage);
  </script>
</TownLayout>
