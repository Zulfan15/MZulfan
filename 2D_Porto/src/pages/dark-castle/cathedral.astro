---
import TownLayout from '../../layouts/TownLayout.astro';
import WhereTo from '../../components/WhereTo.astro';
import { profile } from '../../lib/profile';
import { ABYSSAL_SEALS_META, type AbyssalSealKey } from '../../engine/darkInteriorShared';

const githubUrl = profile.socials.find((s) => s.label === 'GitHub')?.url || 'https://github.com/Zulfan15';

const sanctumCards: Array<{ key: AbyssalSealKey; href: string; label: string }> = [
  { key: 'echoes', href: '/dark-castle/cathedral', label: 'Shadow Cathedral' },
  { key: 'ember', href: '/dark-castle/forge', label: 'Crimson Reactor Forge' },
  { key: 'valor', href: '/dark-castle/manor', label: 'Blood Manor' },
  { key: 'eternity', href: '/dark-castle/vault', label: 'Chained Chrono Vault' },
];

const warStories = [
  {
    id: 'redis-herd',
    chapter: 'CHAPTER I · DISTRIBUTED SYSTEMS',
    icon: '⚡',
    title: 'The 3 AM Redis Thundering Herd',
    severity: 'SEV-1 CACHE STAMPEDE',
    metric: '25,000 RPS → Protected',
    rootCause:
      'Synchronized TTL expiry on high-demand donation feeds caused 25,000 concurrent edge requests to bypass Redis simultaneously and saturate primary PostgreSQL connections.',
    solution:
      'Engineered probabilistic early recomputation (XFetch jitter), Redis Lua singleflight mutex locks, and FOR UPDATE transactional fallbacks so only one worker refreshes cold keys.',
    pattern: 'Redis Lua Mutex · XFetch Early Refresh',
    waveText: 'TALE I: CACHE GUARDED!',
    waveColor: '#fb7185',
  },
  {
    id: 'opencv-leak',
    chapter: 'CHAPTER II · COMPUTER VISION',
    icon: '👁️',
    title: 'The Ghost in the Frame Buffer',
    severity: 'NATIVE C++ HEAP LEAK',
    metric: '1.8 GB → 42 MB Stable RAM',
    rootCause:
      'Continuous 60 FPS video ingestion in edge Python pipelines retained native C-allocated OpenCV frame buffers inside exception retry scopes, leading to OOM kills after 4 hours.',
    solution:
      'Isolated frame processing inside deterministic context managers, eliminated redundant host-to-device tensor copies via TensorRT FP16 pre-allocated buffers, and verified zero drift over 72h.',
    pattern: 'TensorRT Pinned Buffers · Deterministic RAII',
    waveText: 'TALE II: MEMORY PURIFIED!',
    waveColor: '#38bdf8',
  },
  {
    id: 'canvas-loop',
    chapter: 'CHAPTER III · 2D CANVAS ENGINE',
    icon: '🎮',
    title: 'Taming the 60 FPS Render Loop',
    severity: 'GPU FRAME BUDGET EXCEEDED',
    metric: '54,000 Lines → 1 Static Blit',
    rootCause:
      'Procedural rendering of thousands of stone bevels, fences, and shadows every 16ms overheated mobile devices even when the player stood motionless exploring panels.',
    solution:
      'Split terrain onto offscreen backing canvases drawn once per map load, layered lightweight animated overlays on top, and introduced a Wake-on-Demand sleep governor.',
    pattern: 'Offscreen Terrain Cache · Sleep-on-Idle',
    waveText: 'TALE III: 60 FPS LOCKED!',
    waveColor: '#fbbf24',
  },
  {
    id: 'agent-spiral',
    chapter: 'CHAPTER IV · AI AGENTS & WORKFLOWS',
    icon: '🧠',
    title: 'The Infinite Tool Reflection Spiral',
    severity: 'AGENT LOOP DIVERGENCE',
    metric: 'Zero Runaway Recursion',
    rootCause:
      'Autonomous verification agents evaluating recursive AST tool schemas occasionally entered circular self-critique loops when schemas returned ambiguous null states.',
    solution:
      'Designed strict bounded execution budgets, deterministic state-machine transitions, Zod-validated structured outputs, and retrieval-grounded YAML knowledge boundaries.',
    pattern: 'Bounded State Machine · Zod Schemas',
    waveText: 'TALE IV: AGENTS ALIGNED!',
    waveColor: '#34d399',
  },
];
---

<TownLayout
  title="Shadow Cathedral — Obsidian Scriptorium | Muhammad Zulfan"
  description="Enter the Shadow Cathedral: solve the 3-round Echo Pipe Organ WebAudio puzzle with Lunala, Necrozma & Gardevoir, and explore The Obsidian Grimoire of Production War Stories."
  place="dark-cathedral"
>
  <article class="cathedral-page space-y-6 pb-10 text-[#f3e8ff]">
    <!-- 1. IMPERIAL SCRIPTORIUM MARQUEE BANNER (AMETHYST VELVET & CATHEDRAL GOLD) -->
    <header class="relative overflow-hidden rounded-2xl border-[3px] border-[#b45309] bg-gradient-to-b from-[#190930] via-[#240e44] to-[#0c0519] p-5 text-[#f3e8ff] shadow-[0_10px_0_#2e1065,0_18px_36px_rgba(0,0,0,0.65)]">
      <!-- Top & Bottom Repeating Amethyst-Gold Fretwork Trim -->
      <div
        class="pointer-events-none absolute inset-x-0 top-0 h-2 bg-[repeating-linear-gradient(90deg,#fbbf24_0px,#fbbf24_12px,#6b21a8_12px,#6b21a8_24px)] opacity-90"
      >
      </div>
      <div
        class="pointer-events-none absolute inset-x-0 bottom-0 h-1.5 bg-gradient-to-r from-[#581c87] via-[#fbbf24] to-[#581c87]"
      >
      </div>

      <!-- Radial Cathedral Stained-Glass Glows -->
      <div class="pointer-events-none absolute -right-12 -top-12 h-48 w-48 rounded-full bg-purple-500/20 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-12 -left-12 h-48 w-48 rounded-full bg-pink-500/15 blur-3xl"></div>

      <!-- Top Telemetry Ribbon -->
      <div class="relative z-10 flex flex-wrap items-center justify-between gap-2 border-b border-purple-400/25 pb-3 pt-1">
        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center gap-1.5 rounded-full border-2 border-[#fbbf24]/80 bg-[#1e0a3b]/95 px-3 py-0.5 font-mono text-[10px] font-extrabold uppercase tracking-[0.16em] text-[#fde68a] shadow-sm">
            <span id="cathedral-live-dot" class="h-2 w-2 rounded-full bg-purple-400 animate-pulse"></span>
            NW WARD · OBSIDIAN SCRIPTORIUM
          </span>
          <span
            id="cathedral-seal-badge"
            class="inline-flex items-center gap-1.5 rounded-full border border-purple-400/60 bg-purple-950/80 px-2.5 py-0.5 font-mono text-[10px] font-bold uppercase tracking-wider text-purple-200"
          >
            🔒 SEAL OF ECHOES: LOCKED
          </span>
          <span
            id="cathedral-master-badge"
            class="hidden items-center gap-1 rounded-full border-2 border-[#fde047] bg-gradient-to-r from-[#7e22ce] to-[#d97706] px-2.5 py-0.5 font-mono text-[10px] font-black uppercase tracking-wider text-[#fffbeb] shadow"
          >
            👑 GRAND CANTOR
          </span>
        </div>

        <div class="flex items-center gap-2">
          <a
            href="/dark-castle?from=cathedral"
            onclick="sessionStorage.setItem('dark-castle:respawn', '9,21,down')"
            class="inline-flex items-center gap-1 rounded-lg border-2 border-[#7e22ce] bg-[#1e0c3a] px-2.5 py-1 font-mono text-[10px] font-bold text-[#fde68a] transition hover:border-[#fbbf24] hover:bg-[#3b0764]"
          >
            ← Dark Castle
          </a>
        </div>
      </div>

      <!-- Title & Cathedral Harmonic Telemetry Tablet -->
      <div class="relative z-10 mt-4 flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
        <div class="space-y-2">
          <p class="font-mono text-[10px] font-bold uppercase tracking-[0.18em] text-[#c084fc]">
            DARK CASTLE · AMETHYST ECHO BASILICA &amp; ARCHIVE
          </p>
          <h1 id="panel-title" class="font-pixel text-base sm:text-lg leading-snug text-[#fef3c7] drop-shadow-[0_2px_0_#3b0764] flex items-center gap-2.5">
            <span>⛪</span>
            <span>SHADOW CATHEDRAL</span>
          </h1>
          <p class="max-w-xl text-xs sm:text-sm leading-relaxed text-[#e9d5ff]/90">
            Bathed in amethyst stained-glass light. Echo <strong class="text-[#fde047]">3 WebAudio Pipe Melodies</strong> on the Grand Organ to claim the
            <strong class="text-emerald-300">Seal of Echoes</strong>, or open <strong class="text-white">The Obsidian Grimoire</strong>.
          </p>
        </div>

        <!-- Cathedral Harmonic Telemetry Tablet -->
        <div class="flex shrink-0 flex-col items-end rounded-xl border-2 border-[#fbbf24]/80 bg-[#0d051a]/95 px-4 py-2.5 shadow-inner">
          <span class="font-mono text-[10px] font-bold uppercase tracking-widest text-[#fcd34d]">
            🎵 HARMONIC TELEMETRY
          </span>
          <div class="mt-1 flex items-baseline gap-2">
            <span id="cathedral-stage-readout" class="font-['Press_Start_2P',monospace] text-sm sm:text-base text-[#c084fc] drop-shadow-[0_2px_0_#2e1065]">
              0 / 3
            </span>
            <span id="cathedral-tune-pill" class="rounded border border-purple-400/50 bg-[#2e1065]/90 px-1.5 py-0.5 font-mono text-[9px] font-extrabold text-[#e9d5ff]">
              432Hz
            </span>
          </div>
          <div class="mt-1.5 flex items-center gap-2 font-mono text-[10px] text-[#e2e8f0]">
            <span>Abyssal Seals: <strong id="cathedral-abyssal-count" class="text-[#fde047]">0 / 4</strong></span>
            <span>·</span>
            <span class="text-purple-300">{warStories.length} War Tales</span>
          </div>
        </div>
      </div>

      <!-- Tri-Cantor Interactive Dialogue Strip (Lunala, Necrozma & Gardevoir) -->
      <div class="relative z-10 mt-4 rounded-xl border-2 border-[#b45309]/60 bg-[#0e051d]/90 p-3.5 backdrop-blur-sm shadow-inner">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-start">
          <div class="flex shrink-0 items-center gap-1.5">
            <button
              type="button"
              data-cath-walk="lunala"
              data-speaker="🌙 Lunala · Choir Matriarch"
              data-quote="Through moonlight harmonics, chaotic production incidents settle into calm systems. Complete all 3 melodies on the Grand Pipe Organ!"
              data-fx-text="MOONGEIST ECHO!"
              data-fx-color="#fde047"
              class="flex h-11 w-11 items-center justify-center rounded-xl border-2 border-purple-400/70 bg-purple-500/20 text-xl shadow-[0_2px_0_#3b0764] transition hover:-translate-y-0.5 hover:bg-purple-500/30 cursor-pointer"
              title="Walk to Lunala in 2D Canvas"
            >
              🌙
            </button>
            <button
              type="button"
              data-cath-walk="necrozma"
              data-speaker="💠 Prism Necrozma · Nocturne Keeper"
              data-quote="Listen through the prism! Memorize each sequence on Amethyst, Crimson, Gold, and Abyss Cyan pipes—or test Free-Play Jam mode!"
              data-fx-text="PRISM NOCTURNE!"
              data-fx-color="#c084fc"
              class="flex h-11 w-11 items-center justify-center rounded-xl border-2 border-fuchsia-400/70 bg-fuchsia-500/20 text-xl shadow-[0_2px_0_#4a044e] transition hover:-translate-y-0.5 hover:bg-fuchsia-500/30 cursor-pointer"
              title="Walk to Prism Necrozma in 2D Canvas"
            >
              💠
            </button>
            <button
              type="button"
              data-cath-walk="gardevoir"
              data-speaker="✨ Cantor Gardevoir · Keeper of Lore"
              data-quote="Inside The Obsidian Grimoire rest four war stories of real SEV-1 production outages, native memory leaks, and 60fps rescues."
              data-fx-text="GRIMOIRE LORE!"
              data-fx-color="#f59e0b"
              class="flex h-11 w-11 items-center justify-center rounded-xl border-2 border-amber-400/70 bg-amber-500/20 text-xl shadow-[0_2px_0_#78350f] transition hover:-translate-y-0.5 hover:bg-amber-500/30 cursor-pointer"
              title="Walk to Cantor Gardevoir in 2D Canvas"
            >
              ✨
            </button>
          </div>

          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span id="cathedral-speaker" class="font-mono text-[11px] font-black uppercase tracking-wider text-[#c084fc]">
                🌙 Lunala · Choir Matriarch
              </span>
              <span class="font-mono text-[9px] uppercase tracking-wider text-amber-300/80">
                Click Cantor or Station Card to Walk in 2D
              </span>
            </div>
            <p id="cathedral-dialogue" class="mt-1 text-xs leading-relaxed text-[#e9d5ff] italic">
              “Through moonlight harmonics, chaotic production logs sing in order. Synchronize all 3 rounds on the Grand Pipe Organ or study Zulfan’s battlefield chronicles!”
            </p>
          </div>
        </div>
      </div>

      <!-- 6 Tactile Quick-Walk Medal Cards (4+2 Grid) -->
      <div class="relative z-10 mt-4 grid grid-cols-2 gap-2 sm:grid-cols-3">
        <button
          type="button"
          class="cath-station-btn group flex items-center gap-2 rounded-xl border-2 border-[#d97706] bg-gradient-to-b from-[#fef3c7] to-[#fde68a] px-3 py-2 text-left text-[#451a03] shadow-[0_3px_0_#78350f] transition hover:-translate-y-0.5 hover:from-[#fffbeb] hover:to-[#fef08a] active:translate-y-0.5 cursor-pointer"
          data-walk="pipe-organ"
          data-scroll-to="cathedral-echo-puzzle"
          data-key="o"
          data-speaker="🎹 Grand Echo Pipe Organ"
          data-quote="Strike the 4 tuned cathedral chimes in order across 3 rounds to awaken the Seal of Echoes!"
          data-fx-text="PIPE ORGAN RESONANCE!"
          data-fx-color="#c084fc"
        >
          <span class="text-base">🎹</span>
          <div class="min-w-0">
            <div class="truncate font-mono text-[11px] font-black uppercase">Echo Organ</div>
            <div class="truncate text-[10px] font-semibold text-[#78350f]">Audio Puzzle [O]</div>
          </div>
        </button>

        <button
          type="button"
          class="cath-station-btn group flex items-center gap-2 rounded-xl border-2 border-[#9333ea] bg-gradient-to-b from-[#f3e8ff] to-[#e9d5ff] px-3 py-2 text-left text-[#3b0764] shadow-[0_3px_0_#581c87] transition hover:-translate-y-0.5 hover:from-[#faf5ff] hover:to-[#f3e8ff] active:translate-y-0.5 cursor-pointer"
          data-walk="necrozma"
          data-scroll-to="cathedral-echo-puzzle"
          data-key="n"
          data-speaker="💠 Prism Necrozma · West Plinth"
          data-quote="Refract each note cleanly! Ready to test your auditory recall against the 4 crystal pipes?"
          data-fx-text="PRISM NECROZMA!"
          data-fx-color="#a855f7"
        >
          <span class="text-base">💠</span>
          <div class="min-w-0">
            <div class="truncate font-mono text-[11px] font-black uppercase">Prism Necrozma</div>
            <div class="truncate text-[10px] font-semibold text-[#6b21a8]">West Plinth [N]</div>
          </div>
        </button>

        <button
          type="button"
          class="cath-station-btn group flex items-center gap-2 rounded-xl border-2 border-[#d97706] bg-gradient-to-b from-[#fef3c7] to-[#fde68a] px-3 py-2 text-left text-[#451a03] shadow-[0_3px_0_#78350f] transition hover:-translate-y-0.5 hover:from-[#fffbeb] hover:to-[#fef08a] active:translate-y-0.5 cursor-pointer"
          data-walk="gardevoir"
          data-scroll-to="cathedral-grimoire"
          data-key="g"
          data-speaker="✨ Cantor Gardevoir · East Plinth"
          data-quote="Turn the pages of The Obsidian Grimoire to inspect real outages and their architectural fixes."
          data-fx-text="CANTOR GARDEVOIR!"
          data-fx-color="#fbbf24"
        >
          <span class="text-base">✨</span>
          <div class="min-w-0">
            <div class="truncate font-mono text-[11px] font-black uppercase">Gardevoir Lore</div>
            <div class="truncate text-[10px] font-semibold text-[#78350f]">East Plinth [G]</div>
          </div>
        </button>

        <button
          type="button"
          class="cath-station-btn group flex items-center gap-2 rounded-xl border-2 border-[#d97706] bg-gradient-to-b from-[#fef3c7] to-[#fde68a] px-3 py-2 text-left text-[#451a03] shadow-[0_3px_0_#78350f] transition hover:-translate-y-0.5 hover:from-[#fffbeb] hover:to-[#fef08a] active:translate-y-0.5 cursor-pointer"
          data-walk="war-stories-grimoire"
          data-scroll-to="cathedral-grimoire"
          data-key="w"
          data-speaker="📖 The Obsidian Grimoire (NW)"
          data-quote="Illuminated post-mortem chronicles: Redis herds, OpenCV leaks, Canvas loops & AI state machines."
          data-fx-text="GRIMOIRE OPENED!"
          data-fx-color="#38bdf8"
        >
          <span class="text-base">📖</span>
          <div class="min-w-0">
            <div class="truncate font-mono text-[11px] font-black uppercase">War Grimoire</div>
            <div class="truncate text-[10px] font-semibold text-[#78350f]">NW Scriptorium [W]</div>
          </div>
        </button>

        <button
          type="button"
          class="cath-station-btn group flex items-center gap-2 rounded-xl border-2 border-[#0284c7] bg-gradient-to-b from-[#e0f2fe] to-[#bae6fd] px-3 py-2 text-left text-[#0c4a6e] shadow-[0_3px_0_#075985] transition hover:-translate-y-0.5 hover:from-[#f0f9ff] hover:to-[#e0f2fe] active:translate-y-0.5 cursor-pointer"
          data-walk="confession-shrine"
          data-scroll-to="cathedral-relic-section"
          data-key="s"
          data-speaker="🕯️ Spirit Cleanse Shrine (NE)"
          data-quote="Receive Spirit Cleanse at the NE Shrine to run +50% faster across every realm!"
          data-fx-text="SPIRIT CLEANSED!"
          data-fx-color="#38bdf8"
        >
          <span class="text-base">✨</span>
          <div class="min-w-0">
            <div class="truncate font-mono text-[11px] font-black uppercase">Spirit Shrine</div>
            <div class="truncate text-[10px] font-semibold text-[#0369a1]">NE Blessing [S]</div>
          </div>
        </button>

        <button
          type="button"
          class="cath-station-btn group flex items-center gap-2 rounded-xl border-2 border-[#d97706] bg-gradient-to-b from-[#fef3c7] to-[#fde68a] px-3 py-2 text-left text-[#451a03] shadow-[0_3px_0_#78350f] transition hover:-translate-y-0.5 hover:from-[#fffbeb] hover:to-[#fef08a] active:translate-y-0.5 cursor-pointer"
          data-walk="stained-rose"
          data-scroll-to="cathedral-relic-section"
          data-key="r"
          data-speaker="🔮 Harmonic Rose Altar"
          data-quote="Inspect the Zero-Asset WebAudio Synth Blueprint & Abyssal Seal Tracker below!"
          data-fx-text="ROSE ALTAR!"
          data-fx-color="#f43f5e"
        >
          <span class="text-base">🔮</span>
          <div class="min-w-0">
            <div class="truncate font-mono text-[11px] font-black uppercase">Echo Relics</div>
            <div class="truncate text-[10px] font-semibold text-[#78350f]">Rose Coffer [R]</div>
          </div>
        </button>
      </div>
    </header>

    <!-- 2. ECHOES OF THE CATHEDRAL 2.0 (WEBAUDIO HARMONIC ORGAN PUZZLE) -->
    <section
      id="cathedral-echo-puzzle"
      class="scroll-mt-6 overflow-hidden rounded-2xl border-[3px] border-[#b45309] bg-gradient-to-b from-[#150826] via-[#10061e] to-[#080312] shadow-[0_8px_0_#2e1065,0_14px_28px_rgba(0,0,0,0.55)]"
    >
      <div class="flex flex-wrap items-center justify-between gap-3 border-b-[3px] border-[#6b21a8] bg-gradient-to-r from-[#2e1065] via-[#4c1d95] to-[#2e1065] px-5 py-3.5 text-[#fef3c7]">
        <div class="flex items-center gap-2.5">
          <span class="flex h-9 w-9 items-center justify-center rounded-xl border-2 border-[#fbbf24] bg-[#2e1065] text-lg shadow">
            🎹
          </span>
          <div>
            <div class="flex flex-wrap items-center gap-2">
              <h2 class="font-pixel text-[11px] sm:text-xs uppercase tracking-wider text-[#fef08a]">
                Echoes of the Cathedral 2.0
              </h2>
              <span
                id="organ-mode-pill"
                class="rounded-full border border-purple-300/50 bg-[#1e0a3b]/80 px-2 py-0.5 font-mono text-[10px] font-bold text-purple-200"
              >
                🎹 Free-Play / Trial Ready
              </span>
            </div>
            <p class="mt-0.5 text-[11px] text-[#e9d5ff]/85">
              Listen to each nocturnal organ melody and repeat it (keys <code class="rounded bg-black/40 px-1 font-mono text-amber-200">1–4</code> supported). Clear 3 stages!
            </p>
          </div>
        </div>

        <span
          id="organ-round-tracker"
          class="rounded-lg border-2 border-[#fbbf24]/70 bg-[#1e0a3b] px-3 py-1 font-mono text-[11px] font-bold text-[#fde68a]"
        >
          Round 1 / 3
        </span>
      </div>

      <div class="p-5 space-y-4">
        <!-- 3-Stage Rose Window Resonance Strip -->
        <div class="rounded-xl border border-purple-500/25 bg-[#090314]/90 px-4 py-3 shadow-inner">
          <div class="mb-2 flex items-center justify-between font-mono text-[10px] uppercase tracking-wider text-purple-300">
            <span>🟣 Rose Window Harmonic Resonance</span>
            <span id="organ-step-progress" class="text-amber-300">Ready to listen</span>
          </div>
          <div class="grid grid-cols-3 gap-2">
            {[
              { idx: 1, title: 'STAGE I', sub: '3 Chime Notes' },
              { idx: 2, title: 'STAGE II', sub: '4 Chime Notes' },
              { idx: 3, title: 'STAGE III', sub: '5 Chime Notes' },
            ].map((st) => (
              <div
                id={`organ-stage-${st.idx}`}
                class="flex items-center justify-between gap-1.5 rounded-lg border border-purple-900/60 bg-[#130724] px-2.5 py-1.5 transition-all"
              >
                <div class="min-w-0">
                  <div class="font-mono text-[9px] font-bold text-purple-300">{st.title}</div>
                  <div class="truncate text-[10px] font-semibold text-slate-200">{st.sub}</div>
                </div>
                <span id={`organ-stage-icon-${st.idx}`} class="text-xs">🔒</span>
              </div>
            ))}
          </div>
        </div>

        <!-- 4 Tactile Pipe Organ Keys -->
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
          <button
            type="button"
            data-organ-note="0"
            class="organ-key group rounded-xl border-2 border-[#c084fc] bg-gradient-to-b from-[#3b0764] to-[#240440] p-4 text-center shadow-[0_4px_0_#1e0436] transition-all hover:-translate-y-0.5 active:translate-y-0.5 disabled:opacity-50 cursor-pointer"
          >
            <div class="flex items-center justify-between font-mono text-[9px] text-purple-300">
              <span>PIPE I</span>
              <span class="rounded bg-black/35 px-1">[1]</span>
            </div>
            <div class="mt-1 text-2xl">🟣</div>
            <div class="mt-1 font-pixel text-[11px] font-bold text-[#f5d0fe]">Amethyst</div>
            <div class="font-mono text-[9px] text-[#c084fc]">261.6 Hz (C4)</div>
          </button>

          <button
            type="button"
            data-organ-note="1"
            class="organ-key group rounded-xl border-2 border-[#f43f5e] bg-gradient-to-b from-[#6b122b] to-[#420718] p-4 text-center shadow-[0_4px_0_#2b030e] transition-all hover:-translate-y-0.5 active:translate-y-0.5 disabled:opacity-50 cursor-pointer"
          >
