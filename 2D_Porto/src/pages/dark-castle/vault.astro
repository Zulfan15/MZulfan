                <span id={`chain-icon-${ring.idx}`} class="text-xs">🔒</span>
              </div>
            ))}
          </div>
        </div>

        <!-- 4 Interactive Animated SVG Gears -->
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-4" id="gear-cards-grid">
          {[
            { idx: 0, name: 'I. Outer Ring', coupling: 'Drives I & II', init: '3:00' },
            { idx: 1, name: 'II. Inner Core', coupling: 'Drives II & III', init: '9:00' },
            { idx: 2, name: 'III. Escapement', coupling: 'Drives III & IV', init: '3:00' },
            { idx: 3, name: 'IV. Chrono Pin', coupling: 'Drives IV, I & II', init: '3:00' },
          ].map((g) => (
            <button
              type="button"
              data-gear-turn={g.idx}
              id={`gear-card-${g.idx}`}
              class="group relative flex flex-col items-center rounded-xl border-2 border-slate-700/90 bg-gradient-to-b from-[#17213b] to-[#0d1324] p-3.5 text-center shadow-[0_4px_0_#060913] transition-all hover:border-amber-400/80 hover:-translate-y-0.5 active:translate-y-0.5 cursor-pointer focus:outline-none focus:ring-2 focus:ring-amber-400/60"
            >
              <!-- Dynamic Coupling Indicator Pill (Shown on hover/focus of any gear) -->
              <span
                id={`gear-couple-pill-${g.idx}`}
                class="pointer-events-none invisible mb-1 rounded-full border border-sky-400/50 bg-sky-950/90 px-2 py-0.5 font-mono text-[8px] font-extrabold uppercase tracking-wider text-sky-200"
