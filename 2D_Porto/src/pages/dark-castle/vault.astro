                🔗 COUPLED +3H
              </span>

              <div class="font-mono text-[10px] font-bold uppercase tracking-wider text-slate-200 group-hover:text-amber-200">
                {g.name}
              </div>

              <!-- Interactive Rotating SVG Cog + Analog Dial -->
              <div class="relative my-2 flex h-20 w-20 items-center justify-center">
                <!-- Target 12 o'clock Golden Notch -->
                <div class="absolute -top-1 left-1/2 h-2.5 w-1.5 -translate-x-1/2 rounded-full bg-amber-400 shadow-[0_0_8px_#fbbf24]"></div>

                <svg
                  id={`gear-svg-${g.idx}`}
                  viewBox="0 0 100 100"
                  class="h-20 w-20 transition-transform duration-300 ease-out"
                  style="transform: rotate(90deg);"
                  aria-hidden="true"
                >
                  <!-- 8 Brass Gear Teeth -->
                  <g fill="#b45309" stroke="#f59e0b" stroke-width="1.5">
                    <rect x="44" y="4" width="12" height="12" rx="2" />
                    <rect x="44" y="84" width="12" height="12" rx="2" />
                    <rect x="4" y="44" width="12" height="12" rx="2" />
                    <rect x="84" y="44" width="12" height="12" rx="2" />
                    <rect x="44" y="4" width="12" height="12" rx="2" transform="rotate(45 50 50)" />
                    <rect x="44" y="4" width="12" height="12" rx="2" transform="rotate(135 50 50)" />
                    <rect x="44" y="4" width="12" height="12" rx="2" transform="rotate(225 50 50)" />
                    <rect x="44" y="4" width="12" height="12" rx="2" transform="rotate(315 50 50)" />
                  </g>
                  <!-- Outer Ring -->
                  <circle cx="50" cy="50" r="36" fill="#0f172a" stroke="#fbbf24" stroke-width="3" />
                  <circle cx="50" cy="50" r="28" fill="#090e1a" stroke="#475569" stroke-width="1.2" stroke-dasharray="3 3" />
                  <!-- Spokes -->
                  <line x1="50" y1="22" x2="50" y2="78" stroke="#334155" stroke-width="2" />
                  <line x1="22" y1="50" x2="78" y2="50" stroke="#334155" stroke-width="2" />
                  <!-- Clock Pointer Hand pointing to 12 on SVG (0deg) -->
                  <line x1="50" y1="50" x2="50" y2="17" stroke="#38bdf8" stroke-width="4" stroke-linecap="round" />
                  <polygon points="50,12 45,22 55,22" fill="#fde047" />
                  <!-- Center Pin -->
                  <circle cx="50" cy="50" r="6" fill="#f59e0b" stroke="#0f172a" stroke-width="2" />
                </svg>
              </div>

              <div id={`gear-val-${g.idx}`} class="font-mono text-base font-bold text-amber-300">
                {g.init}
              </div>
              <span class="mt-1 rounded border border-slate-700/70 bg-slate-900/90 px-2 py-0.5 font-mono text-[9px] text-slate-300">
                {g.coupling}
              </span>
            </button>
          ))}
