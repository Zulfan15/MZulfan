        </div>

        <!-- Then vs. Now Engineering Evolution Matrix -->
        <div class="rounded-xl border border-slate-700/80 bg-[#070b16] p-4">
          <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
            <h3 class="font-mono text-[11px] font-extrabold uppercase tracking-wider text-amber-300">
              ⚖️ Then vs. Now · Engineering Evolution Matrix
            </h3>
            <span class="font-mono text-[10px] text-slate-400">How craftsmanship scaled across 4 years</span>
          </div>
          <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
            {evolutionMatrix.map((row) => (
              <div class="rounded-lg border border-slate-800 bg-[#0c1222] p-3 text-[11px]">
