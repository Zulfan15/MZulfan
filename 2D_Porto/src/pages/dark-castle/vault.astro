      class="scroll-mt-6 overflow-hidden rounded-2xl border-[3px] border-[#b45309] bg-gradient-to-b from-[#0d152e] via-[#0b1124] to-[#080c19] shadow-[0_8px_0_#2b1806,0_14px_28px_rgba(0,0,0,0.5)]"
