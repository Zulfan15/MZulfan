---
import TownLayout from '../../layouts/TownLayout.astro';
import WhereTo from '../../components/WhereTo.astro';
import { profile, timeline, launches } from '../../lib/profile';
import { ABYSSAL_SEALS_META, type AbyssalSealKey } from '../../engine/darkInteriorShared';

const sanctumCards: Array<{ key: AbyssalSealKey; href: string; label: string }> = [
  { key: 'echoes', href: '/dark-castle/cathedral', label: 'Shadow Cathedral' },
  { key: 'ember', href: '/dark-castle/forge', label: 'Crimson Reactor Forge' },
  { key: 'valor', href: '/dark-castle/manor', label: 'Blood Manor' },
  { key: 'eternity', href: '/dark-castle/vault', label: 'Chained Chrono Vault' },
];

const githubUrl = profile.socials.find((s) => s.label === 'GitHub')?.url || 'https://github.com/Zulfan15';

// Pull verified milestones directly from profile.yaml via profile.ts
const aeroscan = launches.find((m) => m.id === 'aeroscan') || launches[0];
const foodlink = launches.find((m) => m.id === 'foodlink') || launches[1];
const thesis = launches.find((m) => m.id === 'thesis-gambling-spam');
const omr = launches.find((m) => m.id === 'omr-grading');
const foodrescue = launches.find((m) => m.id === 'foodrescue');
const rcTank = launches.find((m) => m.id === 'rc-tank');
const bronzeHonor = profile.honors[0];
const huaweiHonor = profile.honors[1];
const crewCount = profile.missions.filter((m) => m.type === 'crew_assignment').length || 6;
const edu = profile.education[0];

const epochData = [
  {
    id: 'era-1',
    badge: 'ERA I · 2022 – 2024',
    range: 'Foundations & Embedded IoT',
    title: 'Informatics Roots, Database Labs & Robotics',
    subtitle:
      edu
        ? `${edu.degree} at ${edu.school} (GPA ${edu.gpa}) — building relational systems, OOP mastery, and hardware prototypes.`
        : 'Mastering foundational computer science, relational database systems, and embedded hardware.',
    wardenNote:
      'Celebi remembers 2022–2024: late nights wiring ESP32 motor controllers, teaching Delphi 7 SQL queries, and laying rock-solid CS foundations.',
    waveText: 'ERA I: 2022-2024',
    waveColor: '#fbbf24',
    metricLabel: 'Academic GPA',
    metricValue: edu?.gpa || '3.49 / 4.00',
    highlights: [
      'Completed core Informatics training at ITENAS Bandung with strong emphasis on OOP, SQL, and Computer Networks.',
      rcTank
        ? `${rcTank.title}: ${rcTank.summary}`
        : 'Built ESP32 robotic hardware integrated with Flutter mobile control and browser telemetry.',
      `Started ${crewCount}× campus laboratory assistantships mentoring students across Database & Programming labs.`,
    ],
    artifacts: [
      {
        icon: '🤖',
        name: rcTank?.title || 'Remote Control Tank (IoT)',
        org: '2024 · Embedded & Mobile',
        metric: 'ESP32 + Flutter',
        desc: rcTank?.summary || 'Hardware tank with onboard sensors driven via custom Flutter app & telemetry dashboard.',
        stack: ['ESP32', 'C', 'Flutter', 'Arduino'],
        route: '/tower',
        routeLabel: 'Hardware Tower →',
      },
      {
        icon: '🗄️',
        name: 'Database & OOP Lab Mentorship',
        org: '2024–2025 · ITENAS Labs',
        metric: `${crewCount}× Lab Roles`,
        desc: 'Taught SQL relational design, Delphi 7 data apps, and Java OOP architecture to undergraduate cohorts.',
        stack: ['Java', 'SQL', 'MySQL', 'Delphi 7'],
        route: '/reception',
        routeLabel: 'Campus Concierge →',
      },
      {
        icon: '🎓',
        name: edu?.degree || 'Bachelor of Informatics',
        org: edu?.school || 'ITENAS Bandung',
        metric: `GPA ${edu?.gpa || '3.49 / 4.00'}`,
        desc: 'Core computer science curriculum culminating in robotics lab coordination and applied AI thesis work.',
        stack: ['Algorithms', 'TCP/IP', 'SDLC', 'Linux'],
        route: '/about',
        routeLabel: 'Origin Studio →',
      },
    ],
    stack: ['Python', 'Java', 'ESP32', 'MySQL', 'Flutter', 'Linux'],
  },
  {
    id: 'era-2',
    badge: 'ERA II · 2025',
    range: 'National Awards, Security & Vision',
    title: 'IDEA FEST 3 Bronze, Huawei Security & Applied CV',
    subtitle:
      'Transitioning classroom mastery into national competitions, certified network security, and bulk computer vision systems.',
    wardenNote:
      'Chronomon highlights 2025: shipping FoodRescue to a National Bronze Medal, earning Huawei HCIA-Security, and automating teacher grading with OpenCV.',
    waveText: 'ERA II: 2025 SHIFT',
    waveColor: '#34d399',
    metricLabel: 'National Honor',
    metricValue: 'Bronze Medal + HCIA',
    highlights: [
      bronzeHonor
        ? `${bronzeHonor.title} (${bronzeHonor.issuer}): ${bronzeHonor.note}`
        : 'Earned National Bronze Medal with FoodRescue full-stack food-waste redistribution web app.',
      huaweiHonor
        ? `${huaweiHonor.title}: ${huaweiHonor.note}`
        : 'Certified in firewall policies, NAT, VPNs, and intrusion prevention fundamentals.',
      omr
        ? `${omr.title}: ${omr.summary}`
        : 'Engineered automated OMR sheet scanning pipelines using FastAPI, OpenCV, and Next.js.',
    ],
    artifacts: [
      {
        icon: '🥉',
        name: foodrescue?.title || 'FoodRescue — IDEA FEST 3',
        org: '2025 · National Finalist',
        metric: 'Bronze Medal',
        desc: foodrescue?.summary || 'Role-based Laravel + Leaflet platform connecting surplus food donors and recipients.',
        stack: ['Laravel', 'PHP', 'Leaflet', 'MySQL'],
        route: '/arena',
        routeLabel: 'Hall of Victors →',
      },
      {
        icon: '🛡️',
        name: huaweiHonor?.title || 'Huawei HCIA-Security V4.0',
        org: '2025 · Huawei Certification',
        metric: 'Security Certified',
        desc: huaweiHonor?.note || 'Firewall policies, NAT, VPNs, intrusion prevention, and MikroTik routing security.',
        stack: ['HCIA-Security', 'MikroTik', 'VPN / NAT', 'IDS'],
        route: '/tower',
        routeLabel: 'Security Wing →',
      },
      {
        icon: '📄',
        name: omr?.title || 'Automated OMR Exam Grader',
        org: '2025–2026 · Community Service',
        metric: 'Bulk PDF/Scan CV',
        desc: omr?.summary || 'OpenCV bubble-extraction engine with FastAPI backend and Next.js analytics dashboard.',
        stack: ['FastAPI', 'OpenCV', 'Next.js', 'TypeScript'],
        route: '/lab',
        routeLabel: 'Research Lab →',
      },
    ],
    stack: ['Laravel', 'FastAPI', 'OpenCV', 'Next.js', 'MikroTik', 'HCIA-Security'],
  },
  {
    id: 'era-3',
    badge: 'ERA III · 2025 – 2026',
    range: 'Edge TensorRT & Cloud-Native Scale',
    title: 'AeroScan 500+ FPS, FoodLink Kafka & 99.56% Thesis',
    subtitle:
      'Production-grade edge inference compiled to TensorRT FP16 alongside distributed, concurrency-safe cloud platforms.',
    wardenNote:
      'Dialga resonates with 2026: 1.8 ms/frame aircraft inference on TensorRT 10, Redis Lua mutexes on FoodLink, and 99.56% F1 NLP thesis accuracy!',
    waveText: 'ERA III: 1.8MS EDGE',
    waveColor: '#38bdf8',
    metricLabel: 'Edge Inference',
    metricValue: '~1.8 ms/frame (>500 FPS)',
    highlights: [
      aeroscan
        ? `${aeroscan.title}: ${aeroscan.results[2] || aeroscan.summary}`
        : 'Compiled custom YOLOv11s to TensorRT 10 FP16 engine delivering >500 FPS on RTX 4060.',
      foodlink
        ? `${foodlink.title}: ${foodlink.results[1] || foodlink.summary}`
        : 'Concurrency-safe Laravel 12 + PostgreSQL FOR UPDATE + Redis Lua + Kafka outbox platform.',
      thesis
        ? `${thesis.title}: 1,000 TF-IDF char trigrams + Random Forest achieving 99.56% accuracy & F1.`
        : 'Achieved 99.56% F1-score classifying obfuscated gambling spam comments.',
    ],
    artifacts: [
      {
        icon: '✈️',
        name: aeroscan?.title || 'AeroScan AI',
        org: '2026 · Edge Computer Vision',
        metric: '~1.8 ms · 87.9% mAP',
        desc: aeroscan?.summary || 'Real-time detection of 15 military aircraft compiled to TensorRT 10 FP16 via ONNX.',
        stack: ['YOLOv11s', 'TensorRT 10', 'ONNX', 'PyTorch'],
        route: '/lab',
        routeLabel: 'Inspect R&D Lab →',
      },
      {
        icon: '🍲',
        name: foodlink?.title || 'FoodLink Platform',
        org: '2026 · Cloud-Native Backend',
        metric: '32/32 Tests · Kafka',
        desc: foodlink?.summary || 'PostGIS geospatial rescue engine with Redis 7 Lua mutexes and Kubernetes HPA.',
        stack: ['Laravel 12', 'PostGIS', 'Redis Lua', 'Kafka', 'K8s'],
        route: '/dev',
        routeLabel: 'Open Dev Center →',
      },
      {
        icon: '🧠',
        name: 'Thesis: Anti-Obfuscation NLP',
        org: '2026 · ITENAS Research',
        metric: '99.56% F1-Score',
        desc: thesis?.summary || 'Hybrid TF-IDF character trigrams + statistical signals validated via 10-fold CV.',
        stack: ['scikit-learn', 'Random Forest', 'TF-IDF', 'NLP'],
        route: '/lab',
        routeLabel: 'View Research →',
      },
    ],
    stack: ['YOLOv11', 'TensorRT 10', 'Laravel 12', 'PostGIS', 'Kafka', 'Kubernetes'],
  },
  {
    id: 'era-4',
    badge: 'ERA IV · 2026 – HORIZON',
    range: '6-Realm Spatial Web & Digital Twins',
    title: 'Custom 2D Game Engine, Town Editor 5.0 & Edge AI R&D',
    subtitle:
      'Unifying tactile zero-framework 60 FPS pixel worlds with retrieval-grounded AI twins and aerial multi-object tracking.',
    wardenNote:
      'All temporal timelines converge here! Explore 6 interconnected 2D realms, converse with my Cloudflare Digital Twin, and trace what ships next.',
    waveText: 'ERA IV: CHRONO HORIZON',
    waveColor: '#a78bfa',
    metricLabel: 'Render Budget',
    metricValue: '60 FPS · Wake-on-Demand',
    highlights: [
      'Built custom TypeScript 2D Canvas Engine + A* Pathfinding connecting 6 distinct worlds (Town, Digimon, Kingdom, Harbour, Sky & Dark Castle).',
      'Deployed Digital Twin AI assistant grounded strictly in single-source-of-truth profile.yaml telemetry via Cloudflare Workers.',
      `Next R&D Frontier: ${profile.research.next.join(' · ')}`,
    ],
    artifacts: [
      {
        icon: '🎮',
        name: 'Zulfan Town 6-Realm Engine',
        org: 'Live Portfolio Architecture',
        metric: '60 FPS · Zero Framework',
        desc: 'Offscreen-cached pixel canvases, PMD animated companions, interactive puzzles, and live Town Editor 5.0.',
        stack: ['TypeScript', 'Astro 5', 'HTML5 Canvas', 'WebAudio'],
        route: '/town',
        routeLabel: 'Explore Town Map →',
      },
      {
        icon: '🤖',
        name: 'Retrieval-Grounded Digital Twin',
        org: 'Cloudflare Workers AI',
        metric: 'Zero Hallucination',
        desc: 'Interactive twin answering recruiter & technical inquiries directly from validated YAML knowledge.',
        stack: ['Cloudflare Workers', 'Astro', 'Zod Schema', 'RAG'],
        route: '/twin',
        routeLabel: 'Chat with Twin →',
      },
      {
        icon: '🔭',
        name: 'Horizon: Aerial MOT & Adversarial NLP',
        org: '2026+ Active R&D',
        metric: 'Next Milestone',
        desc: profile.research.next[0] + ' & ' + profile.research.next[1],
        stack: ['Multi-Object Tracking', 'WASM / Rust', 'Edge AI', 'WebGPU'],
        route: '/lab',
        routeLabel: 'Lab Roadmap →',
      },
    ],
    stack: ['TypeScript', 'Astro 5', 'Cloudflare Workers', 'WASM', 'HTML5 Canvas'],
  },
];

const evolutionMatrix = [
  {
    axis: 'Runtime Architecture',
    then: 'Single-page static & monolithic server scripts',
    now: 'Offscreen-cached 60 FPS Canvas + Cloudflare Workers Edge',
  },
  {
    axis: 'AI & Computer Vision',
    then: 'Offline InceptionV3 training notebooks on small splits',
    now: 'YOLOv11s compiled to TensorRT 10 FP16 (~1.8 ms / >500 FPS)',
  },
  {
    axis: 'Backend & Concurrency',
    then: 'Basic CRUD queries without lock contention guards',
    now: 'PostgreSQL FOR UPDATE + Redis Lua Mutexes + Kafka Outbox',
  },
  {
    axis: 'UI & Storytelling',
    then: 'Standard scroll resume cards with flat lists',
    now: '6 Explorable 2D RPG Realms + Interactive Puzzles & Digital Twin',
  },
];

const totalMilestones = timeline.length;
---

<TownLayout
  title="Chained Chrono Vault — Clockwork Sanctum | Muhammad Zulfan"
  description="Explore the Chained Chrono Vault: synchronize the 4-Gear Clockwork Lock to shatter the temporal chains, consult Dialga, and inspect Zulfan's Engineering Time-Capsule."
  place="dark-vault"
>
  <article class="vault-page space-y-6 pb-10 text-slate-200">
    <!-- 1. IMPERIAL HOROLOGY MARQUEE BANNER (SAPPHIRE VELVET & GILDED BRASS) -->
    <header class="relative overflow-hidden rounded-2xl border-[3px] border-[#b45309] bg-gradient-to-b from-[#0b132b] via-[#101c3d] to-[#080d1a] p-5 text-[#fef3c7] shadow-[0_10px_0_#2b1806,0_18px_36px_rgba(0,0,0,0.65)]">
      <!-- Top & Bottom Repeating Gold Fretwork Trim -->
      <div
        class="pointer-events-none absolute inset-x-0 top-0 h-2 bg-[repeating-linear-gradient(90deg,#fbbf24_0px,#fbbf24_12px,#92400e_12px,#92400e_24px)] opacity-90"
      >
      </div>
      <div
        class="pointer-events-none absolute inset-x-0 bottom-0 h-1.5 bg-gradient-to-r from-[#78350f] via-[#fbbf24] to-[#78350f]"
      >
      </div>

      <!-- Radial Sapphire & Warm Brass Ambient Glows -->
      <div class="pointer-events-none absolute -right-12 -top-12 h-48 w-48 rounded-full bg-sky-500/15 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-12 -left-12 h-48 w-48 rounded-full bg-amber-500/15 blur-3xl"></div>

      <!-- Top Telemetry Ribbon -->
      <div class="relative z-10 flex flex-wrap items-center justify-between gap-2 border-b border-amber-500/25 pb-3 pt-1">
        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center gap-1.5 rounded-full border-2 border-[#fbbf24]/80 bg-[#091128]/90 px-3 py-0.5 font-mono text-[10px] font-extrabold uppercase tracking-[0.16em] text-[#fde68a] shadow-sm">
            <span id="vault-live-dot" class="h-2 w-2 rounded-full bg-amber-400 animate-pulse"></span>
            SE WARD · GRAND HOROLOGIUM
          </span>
          <span
            id="vault-seal-badge"
            class="inline-flex items-center gap-1.5 rounded-full border border-amber-500/50 bg-amber-950/70 px-2.5 py-0.5 font-mono text-[10px] font-bold uppercase tracking-wider text-amber-200"
          >
            🔒 SEAL OF ETERNITY: LOCKED
          </span>
          <span
            id="vault-master-badge"
            class="hidden items-center gap-1 rounded-full border-2 border-[#fde047] bg-gradient-to-r from-[#d97706] to-[#b45309] px-2.5 py-0.5 font-mono text-[10px] font-black uppercase tracking-wider text-[#fffbeb] shadow"
          >
            👑 GRAND HOROLOGIST
          </span>
        </div>

        <div class="flex items-center gap-2">
          <a
            href="/dark-castle?from=vault"
            onclick="sessionStorage.setItem('dark-castle:respawn', '34,50,down')"
            class="inline-flex items-center gap-1 rounded-lg border-2 border-[#92400e] bg-[#16203d] px-2.5 py-1 font-mono text-[10px] font-bold text-[#fde68a] transition hover:border-[#fbbf24] hover:bg-[#1e2d56]"
          >
            ← Dark Castle
          </a>
        </div>
      </div>

      <!-- Main Title + Chrono Telemetry Tablet -->
      <div class="relative z-10 mt-4 flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
        <div class="space-y-2">
          <p class="font-mono text-[10px] font-bold uppercase tracking-[0.18em] text-[#38bdf8]">
            DARK CASTLE · ASTRAL TIMELINE ARCHIVE ({totalMilestones} VERIFIED MILESTONES)
          </p>
          <h1 id="panel-title" class="font-pixel text-base sm:text-lg leading-snug text-[#fef3c7] drop-shadow-[0_2px_0_#451a03] flex items-center gap-2.5">
            <span>⏳</span>
            <span>CHAINED CHRONO VAULT</span>
          </h1>
          <p class="max-w-xl text-xs sm:text-sm leading-relaxed text-[#e2e8f0]">
            Colossal chains anchor this sapphire sanctum across engineering epochs. Synchronize the
            <strong class="text-[#fde047]">4 Interlocking Brass Gears</strong> to <code class="rounded border border-sky-400/30 bg-[#091128] px-1.5 py-0.5 font-mono text-[11px] text-sky-300">12:00</code> to earn the
            <strong class="text-emerald-300">Seal of Eternity</strong> and unlock <strong class="text-white">{profile.person.name}</strong>’s Time-Machine.
          </p>
        </div>

        <!-- Imperial Chrono-Telemetry Tablet -->
        <div class="flex shrink-0 flex-col items-end rounded-xl border-2 border-[#fbbf24]/80 bg-[#070d1f]/95 px-4 py-2.5 shadow-inner">
          <span class="font-mono text-[10px] font-bold uppercase tracking-widest text-[#fcd34d]">
            🕰️ ASTRAL CHRONO-TELEMETRY
          </span>
          <div class="mt-1 flex items-baseline gap-2">
            <span id="vault-clock-live" class="font-['Press_Start_2P',monospace] text-sm sm:text-base text-[#7dd3fc] drop-shadow-[0_2px_0_#0f172a]">
              00:00:00
            </span>
            <span class="rounded border border-amber-500/50 bg-[#451a03]/80 px-1.5 py-0.5 font-mono text-[9px] font-extrabold text-[#fde68a]">
              SYNC
            </span>
          </div>
          <div class="mt-1.5 flex items-center gap-2 font-mono text-[10px] text-[#cbd5e1]">
            <span>Abyssal Seals: <strong id="vault-abyssal-count" class="text-[#fde047]">0 / 4</strong></span>
            <span>·</span>
            <span id="vault-par-status" class="text-sky-300">Par: 6 Moves</span>
          </div>
        </div>
      </div>

      <!-- Tri-Warden Interactive Dialogue Strip (Dialga, Celebi & Chronomon DM) -->
      <div class="relative z-10 mt-4 rounded-xl border-2 border-[#b45309]/60 bg-[#070c1b]/85 p-3.5 backdrop-blur-sm shadow-inner">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-start">
          <!-- 3 Avatar Quick-Talk Chips -->
          <div class="flex shrink-0 items-center gap-1.5">
            <button
              type="button"
              data-vault-walk="dialga"
              data-speaker="💎 Dialga · Sovereign of Time"
              data-quote="Temporal threads weave past launches into future architectures. Align all four brass gears to 12:00 to shatter these chains!"
              data-fx-text="ROAR OF TIME!"
              data-fx-color="#38bdf8"
              class="flex h-11 w-11 items-center justify-center rounded-xl border-2 border-sky-400/70 bg-sky-500/20 text-xl shadow-[0_2px_0_#0c4a6e] transition hover:-translate-y-0.5 hover:bg-sky-500/30 cursor-pointer"
              title="Walk to Dialga in 2D Canvas"
            >
              💎
            </button>
            <button
              type="button"
              data-vault-walk="celebi"
              data-speaker="🌿 Celebi · Time-Travel Envoy"
              data-quote="Bii! Touch the Time-Machine Scrubber below to warp across Zulfan's 4 engineering eras, from CLI scripts to 60 FPS AI worlds!"
              data-fx-text="TIME TRAVEL RIPPLE!"
              data-fx-color="#34d399"
              class="flex h-11 w-11 items-center justify-center rounded-xl border-2 border-emerald-400/70 bg-emerald-500/20 text-xl shadow-[0_2px_0_#064e3b] transition hover:-translate-y-0.5 hover:bg-emerald-500/30 cursor-pointer"
              title="Walk to Celebi in 2D Canvas"
            >
              🌿
            </button>
            <button
              type="button"
              data-vault-walk="chronomon"
              data-speaker="🕰️ Chronomon DM · Sovereign Time-Keeper"
              data-quote="Every epoch inside this sanctum records real production systems: YOLOv11 TensorRT pipelines, Huawei security audits, and custom engines."
              data-fx-text="CHRONOS SEAL VERIFIED!"
              data-fx-color="#fbbf24"
              class="flex h-11 w-11 items-center justify-center rounded-xl border-2 border-amber-400/70 bg-amber-500/20 text-xl shadow-[0_2px_0_#78350f] transition hover:-translate-y-0.5 hover:bg-amber-500/30 cursor-pointer"
              title="Walk to Chronomon DM in 2D Canvas"
            >
              🕰️
            </button>
          </div>

          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span id="vault-speaker" class="font-mono text-[11px] font-black uppercase tracking-wider text-[#7dd3fc]">
                💎 Dialga · Sovereign of Time
              </span>
              <span class="font-mono text-[9px] uppercase tracking-wider text-amber-300/80">
                Click Avatar or Station Card to Walk in 2D
              </span>
            </div>
            <p id="vault-dialogue" class="mt-1 text-xs leading-relaxed text-slate-200 italic">
              “Temporal threads weave past launches into future architectures. Choose a station below to walk your character through the sanctum, or align the four brass gears to shatter these chains!”
            </p>
          </div>
        </div>
      </div>

      <!-- 6 Tactile Gilded Horology Quick-Walk Medal Cards (4+2 Grid) -->
      <div class="relative z-10 mt-4 grid grid-cols-2 gap-2 sm:grid-cols-3">
        <button
          type="button"
          class="vault-station-btn group flex items-center gap-2 rounded-xl border-2 border-[#d97706] bg-gradient-to-b from-[#fef3c7] to-[#fde68a] px-3 py-2 text-left text-[#451a03] shadow-[0_3px_0_#78350f] transition hover:-translate-y-0.5 hover:from-[#fffbeb] hover:to-[#fef08a] active:translate-y-0.5 cursor-pointer"
          data-walk="clockwork-face"
          data-scroll-to="vault-clockwork-section"
          data-key="n"
          data-speaker="⏳ Grand Astronomical Chronometer"
          data-quote="The four clockwork mechanisms are mechanically coupled. Turning one gear advances its paired wheels by +90° (+3h). Align all four to 12:00!"
          data-fx-text="CHRONOMETER ATTUNED!"
          data-fx-color="#38bdf8"
        >
          <span class="text-base">⏳</span>
          <div class="min-w-0">
            <div class="truncate font-mono text-[11px] font-black uppercase">Chronometer</div>
            <div class="truncate text-[10px] font-semibold text-[#78350f]">Gear Lock [N]</div>
          </div>
        </button>

        <button
          type="button"
          class="vault-station-btn group flex items-center gap-2 rounded-xl border-2 border-[#d97706] bg-gradient-to-b from-[#fef3c7] to-[#fde68a] px-3 py-2 text-left text-[#451a03] shadow-[0_3px_0_#78350f] transition hover:-translate-y-0.5 hover:from-[#fffbeb] hover:to-[#fef08a] active:translate-y-0.5 cursor-pointer"
          data-walk="gear-pedestal-1"
          data-scroll-to="vault-clockwork-section"
          data-key="w"
          data-speaker="⚙️ NW Sun-Gear Brass Foundry"
          data-quote="Steam-driven bronze gears drive both Outer Ring (I) and Inner Core (II) in unison."
          data-fx-text="SUN FOUNDRY ENGAGED!"
          data-fx-color="#fbbf24"
        >
          <span class="text-base">⚙️</span>
          <div class="min-w-0">
            <div class="truncate font-mono text-[11px] font-black uppercase">Sun Foundry</div>
            <div class="truncate text-[10px] font-semibold text-[#78350f]">NW Gears [W]</div>
          </div>
        </button>

        <button
          type="button"
          class="vault-station-btn group flex items-center gap-2 rounded-xl border-2 border-[#059669] bg-gradient-to-b from-[#d1fae5] to-[#a7f3d0] px-3 py-2 text-left text-[#064e3b] shadow-[0_3px_0_#065f46] transition hover:-translate-y-0.5 hover:from-[#ecfdf5] hover:to-[#d1fae5] active:translate-y-0.5 cursor-pointer"
          data-walk="celebi"
          data-scroll-to="vault-chronology-section"
          data-key="c"
