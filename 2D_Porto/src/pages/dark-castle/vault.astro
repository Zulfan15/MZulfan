  <script define:vars={{ epochData }}>
    window.__VAULT_EPOCHS__ = epochData;
  </script>

  <script>
    import { awardAbyssalSeal, countAbyssalSeals, getAbyssalSeals } from '../../engine/darkInteriorShared';

    function playGearSound(freq: number, type: OscillatorType = 'triangle', dur = 0.08) {
      try {
        const AudioCtx = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
        if (!AudioCtx) return;
        const ctx = new AudioCtx();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, ctx.currentTime);
        gain.gain.setValueAtTime(0.08, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + dur);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + dur);
      } catch {
        // Ignore autoplay limits
      }
    }

    function playUnlockChord() {
      [523.25, 659.25, 783.99, 1046.5].forEach((freq, i) => {
        setTimeout(() => playGearSound(freq, 'sine', 0.25), i * 85);
      });
    }

    function emitVaultWave(text: string, color: string) {
      window.dispatchEvent(new CustomEvent('town:vault-fx', { detail: { text, color } }));
    }

    function initVaultPage() {
      // 1. Live Chrono Clock
      const clockEl = document.getElementById('vault-clock-live');
      const updateClock = () => {
        if (!clockEl) return;
        const now = new Date();
        clockEl.textContent = now.toTimeString().slice(0, 8);
      };
      updateClock();
      const clockTimer = window.setInterval(updateClock, 1000);
      document.addEventListener('astro:before-swap', () => clearInterval(clockTimer), { once: true });

      // 2. Canvas Walk, Chrono Wave FX & Dialogue Buttons (Tri-Warden Avatars + 6 Tactile Cards)
      const speakerEl = document.getElementById('vault-speaker');
      const dialogueEl = document.getElementById('vault-dialogue');
      const activateStationButton = (btn: HTMLButtonElement) => {
        const id = btn.dataset.vaultWalk || btn.dataset.walk;
        const scrollTo = btn.dataset.scrollTo;
        if (btn.dataset.speaker && speakerEl) speakerEl.textContent = btn.dataset.speaker;
        if (btn.dataset.quote && dialogueEl) dialogueEl.textContent = `“${btn.dataset.quote}”`;
        if (id) {
          playGearSound(440, 'sine', 0.05);
          window.dispatchEvent(new CustomEvent('town:locate', { detail: { id } }));
          if (btn.dataset.fxText) {
            emitVaultWave(btn.dataset.fxText, btn.dataset.fxColor || '#fbbf24');
          }
        }
        if (scrollTo) {
          document.getElementById(scrollTo)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      };

      document.querySelectorAll<HTMLButtonElement>('[data-vault-walk], .vault-station-btn').forEach((btn) => {
        btn.addEventListener('click', () => activateStationButton(btn));
      });

      const onVaultHotkey = (e: KeyboardEvent) => {
        const target = e.target as HTMLElement | null;
        if (target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable)) return;
        const k = e.key.toLowerCase();
        const matched = document.querySelector<HTMLButtonElement>(`.vault-station-btn[data-key="${k}"]`);
        if (matched) {
          e.preventDefault();
          activateStationButton(matched);
        }
      };
      window.addEventListener('keydown', onVaultHotkey);
      document.addEventListener('astro:before-swap', () => window.removeEventListener('keydown', onVaultHotkey), {
        once: true,
      });

      document.getElementById('btn-focus-puzzle')?.addEventListener('click', () => {
        document.getElementById('vault-clockwork-section')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });

      // 3. Synchronize Seal, Telemetry Tablet & Coffer UI
      const sealBadge = document.getElementById('vault-seal-badge');
      const masterBadge = document.getElementById('vault-master-badge');
      const abyssalCountEl = document.getElementById('vault-abyssal-count');
      const parStatusEl = document.getElementById('vault-par-status');
      const liveDot = document.getElementById('vault-live-dot');
      const cofferLocked = document.getElementById('coffer-locked-view');
      const cofferUnlocked = document.getElementById('coffer-unlocked-view');
      const cofferPill = document.getElementById('coffer-lock-pill');
      const cofferSub = document.getElementById('coffer-subtext');

      function refreshSealCounter() {
        const seals = getAbyssalSeals();
        const total = countAbyssalSeals(seals);
        if (abyssalCountEl) {
          abyssalCountEl.textContent = `${total} / 4`;
        }
        const obeliskPill = document.getElementById('sovereign-obelisk-pill');
        if (obeliskPill) {
          obeliskPill.textContent =
            total === 4 ? '🌌 Obelisk Awakened (4/4)' : `${total} / 4 Seals`;
          obeliskPill.className =
            total === 4
              ? 'rounded-full border border-emerald-400/70 bg-emerald-950/80 px-2.5 py-0.5 font-mono text-[10px] font-bold text-emerald-200'
              : 'rounded-full border border-slate-700 bg-slate-900 px-2.5 py-0.5 font-mono text-[10px] font-bold text-slate-300';
        }
        (['echoes', 'ember', 'valor', 'eternity'] as const).forEach((k) => {
          const unlocked = Boolean(seals[k]);
          const badge = document.getElementById(`sovereign-seal-status-${k}`);
          const card = document.querySelector<HTMLElement>(`[data-seal-card="${k}"]`);
          if (badge) {
            badge.textContent = unlocked ? 'UNLOCKED' : 'LOCKED';
            badge.className = unlocked
              ? 'shrink-0 rounded-full border border-emerald-400/60 bg-emerald-950/75 px-2 py-0.5 font-mono text-[9px] font-bold text-emerald-300'
              : 'shrink-0 rounded-full border border-slate-700 bg-slate-900 px-2 py-0.5 font-mono text-[9px] font-bold text-slate-400';
          }
          if (card) {
            card.classList.toggle('border-emerald-500/60', unlocked);
          }
        });
      }
      refreshSealCounter();

      function applyUnlockedVisuals() {
        if (sealBadge) {
          sealBadge.textContent = '⏳ SEAL OF ETERNITY: SYNCHRONIZED';
          sealBadge.className =
            'inline-flex items-center gap-1.5 rounded-full border border-emerald-400/50 bg-emerald-950/70 px-2.5 py-0.5 font-mono text-[10px] font-bold uppercase tracking-wider text-emerald-200';
        }
        if (masterBadge) {
          masterBadge.classList.remove('hidden');
          masterBadge.classList.add('inline-flex');
        }
        if (liveDot) {
          liveDot.className = 'h-2 w-2 rounded-full bg-emerald-400';
        }
        refreshSealCounter();
        cofferLocked?.classList.add('hidden');
        cofferUnlocked?.classList.remove('hidden');
        if (cofferPill) {
          cofferPill.textContent = '🔓 Unsealed';
          cofferPill.className =
            'rounded-full border border-emerald-500/40 bg-emerald-950/60 px-2.5 py-0.5 font-mono text-[10px] font-bold text-emerald-300';
        }
        if (cofferSub) {
          cofferSub.textContent = 'Temporal lock released! Architecture blueprint ready for inspection.';
        }
      }

      const initialSeals = getAbyssalSeals();
      if (initialSeals.eternity) {
        applyUnlockedVisuals();
      }

      // 4. 4-Gear Clockwork Puzzle (clean 90° steps, 100% mathematically solvable via BFS!)
      // States represented in hours {0, 3, 6, 9} where 0 = 12:00 target
      const TRANSITIONS: number[][] = [
        [3, 3, 0, 0], // Gear 0 turns 0 & 1
        [0, 3, 3, 0], // Gear 1 turns 1 & 2
        [0, 0, 3, 3], // Gear 2 turns 2 & 3
        [3, 3, 0, 3], // Gear 3 turns 3, 0, & 1
      ];

      // Initial state [3, 9, 3, 3] solved cleanly via: G0 x1, G1 x2, G2 x1, G3 x2 (6 moves)
      let gearHours = initialSeals.eternity ? [0, 0, 0, 0] : [3, 9, 3, 3];
      let visualAngles = gearHours.map((h) => (h / 3) * 90);
      let movesCount = 0;
      let autoSolveTimer: number | null = null;

      const movesEl = document.getElementById('gear-moves-count');
      const alignBadge = document.getElementById('gear-alignment-status');
      const statusMsg = document.getElementById('vault-status-msg');
      const parPillEl = document.getElementById('gear-par-pill');
      const chainLabelEl = document.getElementById('master-chain-label');
      const autoSolveBtn = document.getElementById('btn-auto-solve') as HTMLButtonElement | null;

      function stopAutoSolve() {
        if (autoSolveTimer !== null) {
          clearInterval(autoSolveTimer);
          autoSolveTimer = null;
        }
        if (autoSolveBtn) {
          autoSolveBtn.textContent = '⚡ Auto-Align Demo';
          autoSolveBtn.disabled = false;
        }
      }
      document.addEventListener('astro:before-swap', stopAutoSolve, { once: true });

      function formatHour(h: number) {
        const mod = ((h % 12) + 12) % 12;
        return (mod === 0 ? 12 : mod) + ':00';
      }

      function computeOptimalHint(state: number[]): number | null {
        const key = (arr: number[]) => arr.join(',');
        if (key(state) === '0,0,0,0') return null;
        const queue: Array<{ st: number[]; firstMove: number }> = [];
        const visited = new Set<string>([key(state)]);
        for (let m = 0; m < 4; m++) {
          const nxt = state.map((v, i) => (v + TRANSITIONS[m][i]) % 12);
          const k = key(nxt);
          if (k === '0,0,0,0') return m;
          if (!visited.has(k)) {
            visited.add(k);
            queue.push({ st: nxt, firstMove: m });
          }
        }
        while (queue.length > 0) {
          const cur = queue.shift()!;
          for (let m = 0; m < 4; m++) {
            const nxt = cur.st.map((v, i) => (v + TRANSITIONS[m][i]) % 12);
            const k = key(nxt);
            if (k === '0,0,0,0') return cur.firstMove;
            if (!visited.has(k)) {
              visited.add(k);
              queue.push({ st: nxt, firstMove: cur.firstMove });
            }
          }
        }
        return null;
      }

      function showCouplingPreview(sourceIdx: number | null) {
        for (let j = 0; j < 4; j++) {
          const cardEl = document.getElementById(`gear-card-${j}`);
          const pillEl = document.getElementById(`gear-couple-pill-${j}`);
          if (!cardEl || !pillEl) continue;

          if (sourceIdx === null) {
            cardEl.classList.remove('ring-2', 'ring-amber-400/80');
            pillEl.classList.add('invisible');
            continue;
          }

          const delta = TRANSITIONS[sourceIdx][j];
          if (delta > 0) {
            cardEl.classList.add('ring-2', 'ring-amber-400/80');
            pillEl.textContent = j === sourceIdx ? '⚙️ PRIMARY +3H' : '🔗 COUPLED +3H';
            pillEl.className =
              j === sourceIdx
                ? 'pointer-events-none mb-1 rounded-full border border-amber-400/70 bg-amber-950/90 px-2 py-0.5 font-mono text-[8px] font-extrabold uppercase tracking-wider text-amber-200'
                : 'pointer-events-none mb-1 rounded-full border border-sky-400/70 bg-sky-950/90 px-2 py-0.5 font-mono text-[8px] font-extrabold uppercase tracking-wider text-sky-200';
          } else {
            cardEl.classList.remove('ring-2', 'ring-amber-400/80');
            pillEl.classList.add('invisible');
          }
        }
      }

      function renderGears(justSolved = false) {
        let aligned = 0;
        for (let i = 0; i < 4; i++) {
          const isLocked12 = gearHours[i] % 12 === 0;
          if (isLocked12) aligned++;

          const valEl = document.getElementById(`gear-val-${i}`);
          const svgEl = document.getElementById(`gear-svg-${i}`);
          const cardEl = document.getElementById(`gear-card-${i}`);
          const chainRing = document.getElementById(`chain-ring-${i}`);
          const chainIcon = document.getElementById(`chain-icon-${i}`);

          if (valEl) {
            valEl.textContent = formatHour(gearHours[i]);
            valEl.className = isLocked12
              ? 'font-mono text-base font-bold text-emerald-300'
              : 'font-mono text-base font-bold text-amber-300';
          }
          if (svgEl) {
            svgEl.style.transform = `rotate(${visualAngles[i]}deg)`;
          }
          if (cardEl) {
            cardEl.classList.toggle('border-emerald-400/80', isLocked12);
            cardEl.classList.toggle('border-slate-700/90', !isLocked12);
            cardEl.classList.toggle('shadow-[0_0_20px_rgba(52,211,153,0.22)]', isLocked12);
            cardEl.classList.remove('ring-2', 'ring-sky-400');
          }
          if (chainRing && chainIcon) {
            chainRing.className = isLocked12
              ? 'flex items-center justify-between gap-1.5 rounded-lg border border-emerald-400/60 bg-emerald-950/60 px-2.5 py-1.5 shadow-[0_0_10px_rgba(52,211,153,0.18)] transition-all duration-300'
              : 'flex items-center justify-between gap-1.5 rounded-lg border border-slate-700 bg-slate-900/90 px-2.5 py-1.5 transition-all duration-300';
            chainIcon.textContent = isLocked12 ? '✨' : '🔒';
          }
        }

        if (movesEl) movesEl.textContent = String(movesCount);
        if (parStatusEl) {
          parStatusEl.textContent = movesCount === 0 ? 'Par: 6 Moves' : `Moves: ${movesCount} (Par 6)`;
        }
        if (alignBadge) {
          alignBadge.textContent = `${aligned} / 4 Aligned`;
          alignBadge.className =
            aligned === 4
              ? 'rounded-lg border-2 border-emerald-400/70 bg-emerald-950/80 px-2.5 py-1 font-mono text-[11px] font-bold text-emerald-200 shadow-inner'
              : 'rounded-lg border-2 border-amber-500/60 bg-amber-950/75 px-2.5 py-1 font-mono text-[11px] font-bold text-amber-200 shadow-inner';
        }

        if (chainLabelEl) {
          chainLabelEl.textContent =
            aligned === 4 ? 'All 4 Temporal Chains Shattered!' : `${aligned} of 4 Chain Locks Unsealed`;
          chainLabelEl.className = aligned === 4 ? 'font-bold text-emerald-300' : 'text-slate-400';
        }

        if (parPillEl) {
          if (aligned === 4) {
            if (movesCount === 0) {
              parPillEl.textContent = '👑 Synchronized';
            } else if (movesCount <= 6) {
              parPillEl.textContent = `⭐⭐⭐ Grand Horologist (${movesCount}m)`;
            } else if (movesCount <= 10) {
              parPillEl.textContent = `⭐⭐ Master Clocksmith (${movesCount}m)`;
            } else {
              parPillEl.textContent = `⭐ Chrono Apprentice (${movesCount}m)`;
            }
            parPillEl.className =
              'rounded-full border border-emerald-400/70 bg-emerald-950/80 px-2 py-0.5 font-mono text-[10px] font-bold text-emerald-200';
          } else {
            parPillEl.textContent = '🎯 Par: 6 Moves';
            parPillEl.className =
              'rounded-full border border-sky-400/50 bg-[#0c4a6e]/70 px-2 py-0.5 font-mono text-[10px] font-bold text-sky-200';
          }
        }

        if (aligned === 4) {
          stopAutoSolve();
          const newlyAwarded = !getAbyssalSeals().eternity;
          awardAbyssalSeal('eternity');
          applyUnlockedVisuals();
          if (justSolved && newlyAwarded) {
            playUnlockChord();
            emitVaultWave('SEAL OF ETERNITY!', '#38bdf8');
          }
          if (statusMsg) {
            statusMsg.innerHTML =
              '<span class="text-emerald-300 font-semibold">✨ All 4 Chronometer Gears synchronized! Seal of Eternity &amp; Vault Coffer unlocked!</span>';
          }
        }
      }

      function turnGear(idx: number) {
        movesCount++;
        for (let i = 0; i < 4; i++) {
          const delta = TRANSITIONS[idx][i];
          if (delta > 0) {
            gearHours[i] = (gearHours[i] + delta) % 12;
            visualAngles[i] += 90;
          }
        }
        playGearSound(320 + idx * 55, 'triangle', 0.06);
        emitVaultWave(`GEAR ${idx + 1} +90`, '#fbbf24');
        renderGears(true);
      }

      document.querySelectorAll<HTMLButtonElement>('[data-gear-turn]').forEach((btn) => {
        const idx = parseInt(btn.getAttribute('data-gear-turn') || '0', 10);
        btn.addEventListener('click', () => turnGear(idx));
        btn.addEventListener('mouseenter', () => showCouplingPreview(idx));
        btn.addEventListener('mouseleave', () => showCouplingPreview(null));
        btn.addEventListener('focus', () => showCouplingPreview(idx));
        btn.addEventListener('blur', () => showCouplingPreview(null));
      });

      document.getElementById('btn-hint-gear')?.addEventListener('click', () => {
        const nextGear = computeOptimalHint(gearHours);
        if (nextGear === null) {
          if (statusMsg) statusMsg.textContent = '✨ Chronometer is already synchronized at 12:00!';
          return;
        }
        const names = ['I. Outer Ring', 'II. Inner Core', 'III. Escapement', 'IV. Chrono Pin'];
        document.querySelectorAll('[id^="gear-card-"]').forEach((c) => c.classList.remove('ring-2', 'ring-sky-400'));
        document.getElementById(`gear-card-${nextGear}`)?.classList.add('ring-2', 'ring-sky-400');
        playGearSound(660, 'sine', 0.07);
        if (statusMsg) {
          statusMsg.innerHTML = `🧭 Optimal next rotation: Click <strong class="text-sky-300">${names[nextGear]}</strong>.`;
        }
      });

      autoSolveBtn?.addEventListener('click', () => {
        if (autoSolveTimer !== null) {
          stopAutoSolve();
          return;
        }
        if (gearHours.every((h) => h % 12 === 0)) {
          if (statusMsg) statusMsg.textContent = '✨ Chronometer is already synchronized! Click Reset to replay.';
          return;
        }
        autoSolveBtn.textContent = '⏳ Aligning...';
        autoSolveBtn.disabled = true;
        autoSolveTimer = window.setInterval(() => {
          const next = computeOptimalHint(gearHours);
          if (next === null) {
            stopAutoSolve();
            return;
          }
          turnGear(next);
        }, 420);
      });

      document.getElementById('btn-reset-gears')?.addEventListener('click', () => {
        stopAutoSolve();
        gearHours = [3, 9, 3, 3];
        visualAngles = gearHours.map((h) => (h / 3) * 90);
        movesCount = 0;
        if (statusMsg) {
          statusMsg.innerHTML =
            'Align all 4 brass dials upward to the golden <strong class="text-amber-300">12:00</strong> notch.';
        }
        playGearSound(240, 'triangle', 0.06);
        renderGears(false);
      });

      renderGears(false);

      // 5. Interactive Time-Machine Scrubber & Verified Artifact Gallery
      interface ArtifactItem {
        icon: string;
        name: string;
        org: string;
        metric: string;
        desc: string;
        stack: string[];
        route: string;
        routeLabel: string;
      }
      interface EpochItem {
        id: string;
        badge: string;
        range: string;
        title: string;
        subtitle: string;
        wardenNote: string;
        waveText: string;
        waveColor: string;
        highlights: string[];
        artifacts: ArtifactItem[];
        stack: string[];
        metricLabel: string;
        metricValue: string;
      }
      const epochs = (window as unknown as { __VAULT_EPOCHS__: EpochItem[] }).__VAULT_EPOCHS__ || [];
      let activeEpoch = 0;
      const tabBtns = document.querySelectorAll<HTMLButtonElement>('[data-epoch-btn]');
      const scrubberEl = document.getElementById('epoch-range-scrubber') as HTMLInputElement | null;
      const scrubberReadout = document.getElementById('ep-scrubber-readout');

      function buildArtifactCard(art: ArtifactItem): HTMLDivElement {
        const card = document.createElement('div');
        card.className =
          'flex flex-col justify-between rounded-xl border border-amber-500/30 bg-gradient-to-b from-[#131b33] to-[#0a0f1f] p-3.5 transition hover:border-amber-400/70';

        const top = document.createElement('div');
        const head = document.createElement('div');
        head.className = 'flex items-center justify-between gap-2';
        const iconSpan = document.createElement('span');
        iconSpan.className = 'text-lg';
        iconSpan.textContent = art.icon;
        const metricSpan = document.createElement('span');
        metricSpan.className =
          'rounded-full border border-emerald-400/40 bg-emerald-950/70 px-2 py-0.5 font-mono text-[9px] font-bold text-emerald-300';
        metricSpan.textContent = art.metric;
        head.append(iconSpan, metricSpan);

        const orgDiv = document.createElement('div');
        orgDiv.className = 'mt-2 font-mono text-[9px] uppercase tracking-wider text-amber-300/80';
        orgDiv.textContent = art.org;

        const nameH4 = document.createElement('h4');
        nameH4.className = 'mt-0.5 text-xs font-bold text-white leading-snug';
        nameH4.textContent = art.name;

        const descP = document.createElement('p');
        descP.className = 'mt-1.5 text-[11px] leading-relaxed text-slate-300';
        descP.textContent = art.desc;

        top.append(head, orgDiv, nameH4, descP);

        const bottom = document.createElement('div');
        bottom.className = 'mt-3 pt-2.5 border-t border-slate-800/90 space-y-2';
        const stackWrap = document.createElement('div');
        stackWrap.className = 'flex flex-wrap gap-1';
        art.stack.forEach((st) => {
          const pill = document.createElement('span');
          pill.className =
            'rounded bg-slate-900 border border-slate-700/80 px-1.5 py-0.5 font-mono text-[9px] text-sky-200';
          pill.textContent = st;
          stackWrap.appendChild(pill);
        });

        const link = document.createElement('a');
        link.href = art.route;
        link.className =
          'inline-flex items-center font-mono text-[10px] font-bold text-amber-300 hover:text-amber-200 underline decoration-amber-500/40';
        link.textContent = art.routeLabel;

        bottom.append(stackWrap, link);
        card.append(top, bottom);
        return card;
      }

      function renderEpoch(idx: number, triggerCanvasFx = true) {
        const ep = epochs[idx];
        if (!ep) return;
        activeEpoch = idx;

        tabBtns.forEach((t, i) => {
          t.className =
            i === idx
              ? 'epoch-tab flex flex-col items-start rounded-xl border-2 border-[#fbbf24] bg-gradient-to-b from-[#1e2d56] to-[#131d3a] p-2.5 text-left text-[#fef3c7] shadow-[0_3px_0_#78350f] transition cursor-pointer'
              : 'epoch-tab flex flex-col items-start rounded-xl border-2 border-slate-700/80 bg-slate-900/80 p-2.5 text-left text-slate-400 hover:border-slate-500 hover:text-slate-200 transition cursor-pointer';
        });

        if (scrubberEl) scrubberEl.value = String(idx);
        if (scrubberReadout) {
          scrubberReadout.textContent = `Epoch ${idx + 1} of ${epochs.length} · ${ep.badge.split('·')[1]?.trim() || ep.range}`;
        }

        const badge = document.getElementById('ep-badge');
        const mLabel = document.getElementById('ep-metric-label');
        const mVal = document.getElementById('ep-metric-val');
        const title = document.getElementById('ep-title');
        const sub = document.getElementById('ep-subtitle');
        const artGrid = document.getElementById('ep-artifacts-grid');
        const list = document.getElementById('ep-highlights');
        const stack = document.getElementById('ep-stack');

        if (badge) badge.textContent = ep.badge;
        if (mLabel) mLabel.textContent = `${ep.metricLabel}:`;
        if (mVal) mVal.textContent = ep.metricValue;
        if (title) title.textContent = ep.title;
        if (sub) sub.textContent = ep.subtitle;

        if (artGrid) {
          artGrid.replaceChildren(...(ep.artifacts || []).map((a) => buildArtifactCard(a)));
        }
        if (list) {
          const items = ep.highlights.map((h: string) => {
            const li = document.createElement('li');
            li.className = 'flex items-start gap-2';
            const arrow = document.createElement('span');
            arrow.className = 'mt-0.5 text-amber-400';
            arrow.textContent = '▸';
            const txt = document.createElement('span');
            txt.textContent = h;
            li.append(arrow, txt);
            return li;
          });
          list.replaceChildren(...items);
        }
        if (stack) {
          const pills = ep.stack.map((s: string) => {
            const pill = document.createElement('span');
            pill.className =
              'rounded-md border border-slate-700 bg-slate-900 px-2 py-0.5 font-mono text-[10px] text-slate-200';
            pill.textContent = s;
            return pill;
          });
          stack.replaceChildren(...pills);
        }

        if (triggerCanvasFx) {
          emitVaultWave(ep.waveText, ep.waveColor);
          if (speakerEl) speakerEl.textContent = `🕰️ ${ep.badge} · Time-Machine Sync`;
          if (dialogueEl) dialogueEl.textContent = `“${ep.wardenNote}”`;
        }
      }

      tabBtns.forEach((tab) => {
        tab.addEventListener('click', () => {
          const idx = parseInt(tab.getAttribute('data-epoch-btn') || '0', 10);
          playGearSound(500 + idx * 45, 'sine', 0.06);
          renderEpoch(idx, true);
        });
      });

      scrubberEl?.addEventListener('input', () => {
        const idx = parseInt(scrubberEl.value || '0', 10);
        playGearSound(480 + idx * 45, 'sine', 0.05);
        renderEpoch(idx, true);
      });

      document.getElementById('btn-next-epoch')?.addEventListener('click', () => {
        const nxt = (activeEpoch + 1) % Math.max(1, epochs.length);
        playGearSound(540, 'sine', 0.06);
        renderEpoch(nxt, true);
      });

      document.getElementById('btn-time-warp-fx')?.addEventListener('click', () => {
        const ep = epochs[activeEpoch];
        playGearSound(620, 'triangle', 0.09);
        if (ep) {
          emitVaultWave(ep.waveText, ep.waveColor);
          window.dispatchEvent(new CustomEvent('town:locate', { detail: { id: 'time-capsule' } }));
        }
      });

      // 6. Celebi's Time Flute Overclock Buff & Live 60 FPS Telemetry Monitor
      const celebiBtn = document.getElementById('btn-celebi-overclock') as HTMLButtonElement | null;
      const celebiStatus = document.getElementById('celebi-buff-status');
      let celebiCountdownTimer: number | null = null;

      celebiBtn?.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('town:claim-lucky-egg'));
        window.dispatchEvent(new CustomEvent('town:locate', { detail: { id: 'celebi' } }));
        emitVaultWave('CHRONO OVERCLOCK +50%', '#34d399');
        [523.25, 659.25, 783.99].forEach((f, idx) => setTimeout(() => playGearSound(f, 'sine', 0.14), idx * 70));

        if (speakerEl) speakerEl.textContent = '🌿 Celebi · Time-Travel Envoy';
        if (dialogueEl) {
          dialogueEl.textContent =
            '“Bii! Time Flute blessing bestowed—your character speed is overclocked +50% across all Town & Dark Castle maps for 25 seconds!”';
        }

        if (celebiCountdownTimer !== null) clearInterval(celebiCountdownTimer);
        let remaining = 25;
        const updateBuffLabel = () => {
          if (!celebiStatus) return;
          if (remaining > 0) {
            celebiStatus.textContent = `⚡ ACTIVE +50% (${remaining}s)`;
            celebiStatus.className =
              'rounded-full border border-emerald-400/80 bg-emerald-500/20 px-2 py-0.5 font-mono text-[9px] font-black text-emerald-200 animate-pulse';
          } else {
            celebiStatus.textContent = 'READY';
            celebiStatus.className =
              'rounded-full border border-emerald-500/40 bg-emerald-950/70 px-2 py-0.5 font-mono text-[9px] font-bold text-emerald-200';
            if (celebiCountdownTimer !== null) {
              clearInterval(celebiCountdownTimer);
              celebiCountdownTimer = null;
            }
          }
        };
        updateBuffLabel();
        celebiCountdownTimer = window.setInterval(() => {
          remaining--;
          updateBuffLabel();
        }, 1000);
      });

      // Live FPS & Canvas Buffer Telemetry Probe
      const fpsEl = document.getElementById('telemetry-fps');
      const resEl = document.getElementById('telemetry-res');
      const dprEl = document.getElementById('telemetry-dpr');
      let telemetryRaf: number | null = null;
      let frameCount = 0;
      let lastSample = performance.now();

      const sampleTelemetry = (now: number) => {
        frameCount++;
        if (now - lastSample >= 500) {
          const fps = Math.min(120, Math.round((frameCount * 1000) / (now - lastSample)));
          if (fpsEl) fpsEl.textContent = `${fps} FPS`;
          const canvas = document.querySelector('canvas');
          if (resEl && canvas) {
            resEl.textContent = `${canvas.width}×${canvas.height}`;
          }
          if (dprEl) {
            dprEl.textContent = `${(window.devicePixelRatio || 1).toFixed(1)}x`;
          }
          frameCount = 0;
          lastSample = now;
        }
        telemetryRaf = requestAnimationFrame(sampleTelemetry);
      };
      telemetryRaf = requestAnimationFrame(sampleTelemetry);

      document.addEventListener(
        'astro:before-swap',
        () => {
          if (celebiCountdownTimer !== null) clearInterval(celebiCountdownTimer);
          if (telemetryRaf !== null) cancelAnimationFrame(telemetryRaf);
        },
        { once: true }
      );
    }

    initVaultPage();
    document.addEventListener('astro:page-load', initVaultPage);
  </script>
</TownLayout>
