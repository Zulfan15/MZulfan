            <span class="font-bold uppercase tracking-wider text-amber-300">🎛️ Chronology Scrubber</span>
            <span id="ep-scrubber-readout" class="text-sky-300 font-semibold">Epoch 1 of 4 · 2022–2024</span>
          </div>

          <input
            id="epoch-range-scrubber"
            type="range"
            min="0"
