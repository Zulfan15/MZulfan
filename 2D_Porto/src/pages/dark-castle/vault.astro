                <div class="mt-1.5 flex items-start gap-1.5 text-slate-400">
                  <span class="shrink-0 rounded bg-slate-800 px-1 py-0.5 font-mono text-[8px] font-bold text-slate-400">THEN</span>
                  <span>{row.then}</span>
                </div>
                <div class="mt-1 flex items-start gap-1.5 text-emerald-200">
                  <span class="shrink-0 rounded bg-emerald-950 border border-emerald-500/40 px-1 py-0.5 font-mono text-[8px] font-bold text-emerald-300">NOW</span>
                  <span>{row.now}</span>
