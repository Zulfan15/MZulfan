  <script>
    import { awardAbyssalSeal, countAbyssalSeals, getAbyssalSeals } from '../../engine/darkInteriorShared';

    function playManorTone(freq: number, type: OscillatorType = 'triangle', dur = 0.09) {
      try {
        const AudioCtx = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
        if (!AudioCtx) return;
        const ctx = new AudioCtx();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, ctx.currentTime);
        gain.gain.setValueAtTime(0.08, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + dur);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + dur);
      } catch {
        // Ignore audio autoplay blocks
      }
    }

    function playVictoryFanfare() {
      [523.25, 659.25, 783.99, 1046.5].forEach((f, i) => {
        setTimeout(() => playManorTone(f, 'sine', 0.24), i * 85);
      });
    }

    function emitManorWave(text: string, color: string) {
      window.dispatchEvent(new CustomEvent('town:manor-fx', { detail: { text, color } }));
    }

    function initManorPage() {
      // 1. Canvas Quick-Walk & Tri-Sentinel Dialogue
      const speakerEl = document.getElementById('manor-speaker');
      const dialogueEl = document.getElementById('manor-dialogue');

      const activateManorStation = (btn: HTMLButtonElement) => {
        const id = btn.dataset.manorWalk || btn.dataset.walk;
        const scrollTo = btn.dataset.scrollTo;
        if (btn.dataset.speaker && speakerEl) speakerEl.textContent = btn.dataset.speaker;
        if (btn.dataset.quote && dialogueEl) dialogueEl.textContent = `“${btn.dataset.quote}”`;
        if (id) {
          playManorTone(390, 'sine', 0.06);
          window.dispatchEvent(new CustomEvent('town:locate', { detail: { id } }));
          if (btn.dataset.fxText) {
            emitManorWave(btn.dataset.fxText, btn.dataset.fxColor || '#ef4444');
          }
        }
        if (scrollTo) {
          document.getElementById(scrollTo)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      };

      document.querySelectorAll<HTMLButtonElement>('[data-manor-walk], .manor-station-btn').forEach((btn) => {
        btn.addEventListener('click', () => activateManorStation(btn));
      });

      const onManorHotkey = (e: KeyboardEvent) => {
        const target = e.target as HTMLElement | null;
        if (target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable)) return;
        const k = e.key.toLowerCase();
        const matched = document.querySelector<HTMLButtonElement>(`.manor-station-btn[data-key="${k}"]`);
        if (matched) {
          e.preventDefault();
          activateManorStation(matched);
        }
      };
      window.addEventListener('keydown', onManorHotkey);
      document.addEventListener('astro:before-swap', () => window.removeEventListener('keydown', onManorHotkey), {
        once: true,
      });

      document.getElementById('btn-scroll-duel')?.addEventListener('click', () => {
        document.getElementById('manor-shadow-duel')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });

      // 2. Seal Synchronization & Sovereign Tracker
      const sealBadge = document.getElementById('manor-seal-badge');
      const masterBadge = document.getElementById('manor-master-badge');
      const liveDot = document.getElementById('manor-live-dot');
      const shieldReadout = document.getElementById('manor-shield-readout');
      const rankPill = document.getElementById('manor-rank-pill');
      const cofferLocked = document.getElementById('manor-coffer-locked');
      const cofferUnlocked = document.getElementById('manor-coffer-unlocked');
      const cofferPill = document.getElementById('manor-coffer-pill');
      const cofferSub = document.getElementById('manor-coffer-subtext');

      function refreshManorSeals() {
        const seals = getAbyssalSeals();
        const total = countAbyssalSeals(seals);
        const abyssalCountEl = document.getElementById('manor-abyssal-count');
        const obeliskPill = document.getElementById('manor-obelisk-pill');
        if (abyssalCountEl) abyssalCountEl.textContent = `${total} / 4`;
        if (obeliskPill) {
          obeliskPill.textContent = total === 4 ? '🌌 Obelisk Awakened (4/4)' : `${total} / 4 Seals`;
          obeliskPill.className =
            total === 4
              ? 'rounded-full border border-emerald-400/70 bg-emerald-950/80 px-2.5 py-0.5 font-mono text-[10px] font-bold text-emerald-200'
              : 'rounded-full border border-slate-700 bg-slate-900 px-2.5 py-0.5 font-mono text-[10px] font-bold text-slate-300';
        }
        (['echoes', 'ember', 'valor', 'eternity'] as const).forEach((k) => {
          const unlocked = Boolean(seals[k]);
          const badge = document.getElementById(`manor-seal-status-${k}`);
          const card = document.querySelector<HTMLElement>(`[data-manor-seal-card="${k}"]`);
          if (badge) {
            badge.textContent = unlocked ? 'UNLOCKED' : 'LOCKED';
            badge.className = unlocked
              ? 'shrink-0 rounded-full border border-emerald-400/60 bg-emerald-950/75 px-2 py-0.5 font-mono text-[9px] font-bold text-emerald-300'
              : 'shrink-0 rounded-full border border-slate-700 bg-slate-900 px-2 py-0.5 font-mono text-[9px] font-bold text-slate-400';
          }
          if (card) card.classList.toggle('border-emerald-500/60', unlocked);
        });
      }

      function applyValorUnlockedUI() {
        if (sealBadge) {
          sealBadge.textContent = '🩸 SEAL OF VALOR: CONFERRED';
          sealBadge.className =
            'inline-flex items-center gap-1.5 rounded-full border border-emerald-400/60 bg-emerald-950/75 px-2.5 py-0.5 font-mono text-[10px] font-bold uppercase tracking-wider text-emerald-200';
        }
        if (masterBadge) {
          masterBadge.classList.remove('hidden');
          masterBadge.classList.add('inline-flex');
        }
        if (liveDot) liveDot.className = 'h-2 w-2 rounded-full bg-emerald-400';
        cofferLocked?.classList.add('hidden');
        cofferUnlocked?.classList.remove('hidden');
        if (cofferPill) {
          cofferPill.textContent = '🔓 Unsealed';
          cofferPill.className =
            'rounded-full border border-emerald-500/50 bg-emerald-950/70 px-2.5 py-0.5 font-mono text-[10px] font-bold text-emerald-300';
        }
        if (cofferSub) {
          cofferSub.textContent = 'Seal of Valor conferred! Sovereign Production Incident Playbook ready.';
        }
        refreshManorSeals();
      }

      refreshManorSeals();
      if (getAbyssalSeals().valor) {
        applyValorUnlockedUI();
      }

      // 3. Shadow Logic Trial 2.0 vs Darkrai (4 Tactical Scenarios)
      interface DuelScenario {
        domain: string;
        title: string;
        desc: string;
        options: string[];
        correct: number;
        hint: string;
        winNote: string;
      }

      const SCENARIOS: DuelScenario[] = [
        {
          domain: 'DISTRIBUTED SYSTEMS · ROUND 1',
          title: 'Distributed Lock Race Condition',
          desc: 'Two workers concurrently claim the exact same food-surplus order due to heartbeat network jitter during lock renewal, causing duplicate handovers.',
          options: [
            'Increase the sleep retry loop from 100ms to 2000ms.',
            'Enforce Redis distributed mutex with monotonically increasing fencing tokens & DB row FOR UPDATE.',
            'Suppress duplicate key exceptions inside an empty try-catch block.',
          ],
          correct: 1,
          hint: 'Giratina whispers: Delays only mask timing windows—you need atomic mutual exclusion at both cache & storage.',
          winNote: 'Fencing tokens + PostgreSQL FOR UPDATE eliminate split-brain writes cleanly!',
        },
        {
          domain: 'MEMORY ARCHITECTURE · ROUND 2',
          title: 'WebSocket & Canvas Listener Leak',
          desc: 'Long-lived browser & lobby clients grow by +4 GB RAM over 12 hours as rooms transition, eventually triggering OOM crashes.',
          options: [
            'Dangling event listener closures retaining detached DOM canvases & client sockets in memory.',
            'Users need to enable hardware acceleration in Chrome flags.',
            'Switch from JSON messages to Base64 encoded plain text.',
          ],
          correct: 0,
          hint: 'Giratina whispers: Inspect ViewTransition swaps and teardown lifecycles where handlers are bound.',
          winNote: 'Deterministic unbind registries reclaim detached heap graphs immediately!',
        },
        {
          domain: 'EDGE AI INFERENCE · ROUND 3',
          title: 'Real-Time Vision Frame Pipeline Stall',
          desc: 'An aerial detector runs smoothly offline in PyTorch FP32, yet drops below 12 FPS on live video feeds due to PCIe host-device copy latency.',
          options: [
            'Reduce camera resolution down to 64×64 grayscale thumbnails.',
            'Export weights via ONNX into a quantized TensorRT FP16 engine with pinned GPU buffers.',
            'Run two separate Python subprocesses per incoming frame.',
          ],
          correct: 1,
          hint: 'Giratina whispers: Remember AeroScan AI—how did Zulfan push YOLOv11s to ~1.8 ms/frame?',
          winNote: 'TensorRT 10 FP16 optimization slashes latency past >500 FPS on edge GPUs!',
        },
        {
          domain: 'EDGE SECURITY · ROUND 4',
          title: 'Stale CDN Authorization Cache Purge',
          desc: 'After revoking an attacker’s compromised admin role in the origin DB, 40 global edge nodes still honor cached RBAC tokens for 10 minutes.',
          options: [
            'Ask affected enterprise admins to clear cookies and press Ctrl+Shift+R.',
            'Publish surrogate cache-tag purges paired with short-TTL cryptographic revocation checks.',
            'Restart every edge node manually via SSH cron jobs.',
          ],
          correct: 1,
          hint: 'Giratina whispers: Client-side cache clearing never prevents unauthorized edge replays.',
          winNote: 'Surrogate-key purges + cryptographic revocation enforce instant global containment!',
        },
      ];

      let round = 0;
      let darkraiShields = 4;
      let playerResolve = 3;
      let mistakes = 0;
      let roundLocked = false;
      let duelTimer: number | null = null;

      const titleEl = document.getElementById('scenario-title');
      const domainEl = document.getElementById('scenario-domain');
      const descEl = document.getElementById('scenario-desc');
      const optionsBox = document.getElementById('duel-options');
      const feedbackEl = document.getElementById('duel-feedback');
      const darkraiHpEl = document.getElementById('darkrai-hp');
      const playerHpEl = document.getElementById('player-hp-text');
      const roundEl = document.getElementById('duel-round');
      const accPill = document.getElementById('duel-accuracy-pill');

      function updateCombatBars() {
        if (darkraiHpEl) darkraiHpEl.textContent = `${darkraiShields} / 4 Shields`;
        if (playerHpEl) playerHpEl.textContent = `${playerResolve} / 3 Resolve`;

        if (shieldReadout) {
          shieldReadout.textContent = darkraiShields === 0 ? 'BROKEN' : `${darkraiShields} / 4`;
          shieldReadout.className =
            darkraiShields === 0
              ? "font-['Press_Start_2P',monospace] text-sm sm:text-base text-emerald-300"
              : "font-['Press_Start_2P',monospace] text-sm sm:text-base text-[#f87171]";
        }
        if (rankPill) {
          if (darkraiShields === 0) {
            rankPill.textContent = mistakes === 0 ? '⭐⭐⭐ FLAWLESS' : '🩸 VICTOR';
            rankPill.className =
              'rounded border border-emerald-400/70 bg-emerald-950/85 px-1.5 py-0.5 font-mono text-[9px] font-extrabold text-emerald-200';
          } else {
            rankPill.textContent = 'SHIELDED';
            rankPill.className =
              'rounded border border-red-500/50 bg-[#450a0a]/90 px-1.5 py-0.5 font-mono text-[9px] font-extrabold text-[#fecaca]';
          }
        }

        const pSegs = document.querySelectorAll('#player-hp-bars > div');
        pSegs.forEach((seg, idx) => {
          seg.className =
            idx < playerResolve
              ? 'h-2.5 rounded-full bg-emerald-400 shadow-[0_0_8px_#34d399] transition-all'
              : 'h-2.5 rounded-full bg-slate-800 transition-all';
        });

        const dSegs = document.querySelectorAll('#darkrai-hp-bars > div');
        dSegs.forEach((seg, idx) => {
          seg.className =
            idx < darkraiShields
              ? 'h-2.5 rounded-full bg-red-500 shadow-[0_0_8px_#ef4444] transition-all'
              : 'h-2.5 rounded-full bg-slate-800 transition-all';
        });

        if (accPill && darkraiShields === 0) {
          accPill.textContent = mistakes === 0 ? '⭐⭐⭐ Flawless Architect' : `⚔️ Won (${mistakes} Errors)`;
          accPill.className =
            'rounded-full border border-emerald-400/70 bg-emerald-950/80 px-2 py-0.5 font-mono text-[10px] font-bold text-emerald-200';
        }
      }

      function loadRound(rIdx: number) {
        round = rIdx;
        roundLocked = false;
        const s = SCENARIOS[round];
        if (!s) return;
        if (domainEl) domainEl.textContent = s.domain;
        if (titleEl) titleEl.textContent = s.title;
        if (descEl) descEl.textContent = s.desc;
        if (roundEl) roundEl.textContent = `Round ${round + 1} / ${SCENARIOS.length}`;

        if (optionsBox) {
          const buttons = s.options.map((opt, idx) => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className =
              'duel-btn text-left rounded-xl border-2 border-red-900/70 bg-gradient-to-b from-[#240911] to-[#130409] p-3 text-xs text-[#fecaca] shadow-[0_3px_0_#2e070c] transition-all hover:border-amber-400/80 hover:-translate-y-0.5 cursor-pointer';
            btn.textContent = `${String.fromCharCode(65 + idx)}. ${opt}`;
            btn.addEventListener('click', () => handleOptionClick(idx, btn));
            return btn;
          });
          optionsBox.replaceChildren(...buttons);
        }
        updateCombatBars();
      }

      function resetDuel() {
        if (duelTimer !== null) {
          clearTimeout(duelTimer);
          duelTimer = null;
        }
        round = 0;
        darkraiShields = 4;
        playerResolve = 3;
        mistakes = 0;
        if (accPill) {
          accPill.textContent = '🎯 4-Round Trial';
          accPill.className =
            'rounded-full border border-amber-400/50 bg-[#2a070f]/80 px-2 py-0.5 font-mono text-[10px] font-bold text-amber-200';
        }
        if (feedbackEl) {
          feedbackEl.textContent = 'New duel started! Select the optimal architecture to strike Darkrai!';
          feedbackEl.className = 'min-w-0 flex-1 font-mono text-xs text-[#fecaca]';
        }
        loadRound(0);
      }

      function handleOptionClick(chosenIdx: number, clickedBtn: HTMLButtonElement) {
        if (roundLocked || darkraiShields === 0) return;
        const s = SCENARIOS[round];

        if (chosenIdx === s.correct) {
          roundLocked = true;
          darkraiShields = Math.max(0, darkraiShields - 1);
          clickedBtn.classList.add('border-emerald-400', 'bg-emerald-950/60', 'text-emerald-200');
          playManorTone(620, 'triangle', 0.12);
          emitManorWave(`SHIELD SHATTERED! (${4 - darkraiShields}/4)`, '#4ade80');
          updateCombatBars();

          if (round + 1 < SCENARIOS.length) {
            if (feedbackEl) {
              feedbackEl.textContent = `💥 Direct Hit! ${s.winNote}`;
              feedbackEl.className = 'min-w-0 flex-1 font-mono text-xs text-emerald-300 font-semibold';
            }
            duelTimer = window.setTimeout(() => {
              loadRound(round + 1);
              if (feedbackEl) {
                feedbackEl.textContent = `Next crisis incoming (Round ${round + 1}/4)! Choose your counter.`;
                feedbackEl.className = 'min-w-0 flex-1 font-mono text-xs text-[#fecaca]';
              }
            }, 1250);
          } else {
            awardAbyssalSeal('valor');
            applyValorUnlockedUI();
            playVictoryFanfare();
            emitManorWave('SEAL OF VALOR!', '#fbbf24');
            if (feedbackEl) {
              feedbackEl.textContent = `🏆 VICTORY! ${s.winNote} Darkrai confers the Seal of Valor!`;
              feedbackEl.className = 'min-w-0 flex-1 font-mono text-xs text-amber-300 font-bold';
            }
          }
        } else {
          mistakes++;
          playerResolve = Math.max(0, playerResolve - 1);
          clickedBtn.classList.add('border-red-500', 'opacity-65');
          playManorTone(190, 'sawtooth', 0.14);
          emitManorWave('NIGHTMARE COUNTER!', '#ef4444');
          updateCombatBars();

          if (playerResolve === 0) {
            roundLocked = true;
            if (feedbackEl) {
              feedbackEl.textContent = '💀 Architect Resolve depleted! Darkrai’s Void overwhelmed you — click Rematch to retry!';
              feedbackEl.className = 'min-w-0 flex-1 font-mono text-xs text-red-400 font-bold';
            }
          } else if (feedbackEl) {
            feedbackEl.textContent = '❌ Darkrai deflects! That approach triggers cascade failure (-1 Resolve). Try another counter!';
            feedbackEl.className = 'min-w-0 flex-1 font-mono text-xs text-red-400';
          }
        }
      }

      document.getElementById('btn-duel-hint')?.addEventListener('click', () => {
        const s = SCENARIOS[round];
        if (!s || darkraiShields === 0) return;
        playManorTone(520, 'sine', 0.08);
        emitManorWave('GIRATINA RIFT HINT', '#a855f7');
        if (feedbackEl) {
          feedbackEl.textContent = `🐉 ${s.hint}`;
          feedbackEl.className = 'min-w-0 flex-1 font-mono text-xs text-purple-300';
        }
      });

      document.getElementById('btn-challenge-darkrai')?.addEventListener('click', () => {
        playManorTone(440, 'triangle', 0.08);
        emitManorWave('DUEL RESET!', '#fbbf24');
        resetDuel();
      });

      loadRound(0);

      // 4. Museum of Cursed Bugs Inspector (Cursed vs Pure Fix Toggle)
      interface BugExhibit {
        id: string;
        icon: string;
        name: string;
        severity: string;
        symptom: string;
        summary: string;
        cursedCode: string;
        pureCode: string;
        walkId: string;
        waveText: string;
        waveColor: string;
      }
      const bugs = (window as unknown as { __MANOR_CURSED_BUGS__: BugExhibit[] }).__MANOR_CURSED_BUGS__ || [];
      let activeBugIdx = 0;
      let codeMode: 'cursed' | 'pure' = 'cursed';

      const bugTabs = document.querySelectorAll<HTMLButtonElement>('[data-bug-tab]');
      const severityEl = document.getElementById('bug-severity');
      const bugNameEl = document.getElementById('bug-name');
      const bugSummaryEl = document.getElementById('bug-summary');
      const bugPreEl = document.getElementById('bug-code-pre');
      const bugCaptionEl = document.getElementById('bug-code-caption');
      const btnCursed = document.getElementById('btn-mode-cursed');
      const btnPure = document.getElementById('btn-mode-pure');

      function renderBugExhibit(idx: number, mode: 'cursed' | 'pure', withWave = false) {
        const b = bugs[idx];
        if (!b) return;
        activeBugIdx = idx;
        codeMode = mode;

        bugTabs.forEach((t, i) => {
          t.className =
            i === idx
              ? 'bug-tab flex flex-col items-start rounded-xl border-2 border-[#fbbf24] bg-gradient-to-b from-[#450a0a] to-[#24060c] p-2.5 text-left text-[#fef3c7] shadow-[0_3px_0_#78350f] transition cursor-pointer'
              : 'bug-tab flex flex-col items-start rounded-xl border-2 border-red-900/60 bg-[#140509] p-2.5 text-left text-slate-300 hover:border-red-500/70 transition cursor-pointer';
        });

        if (btnCursed && btnPure) {
          btnCursed.className =
            mode === 'cursed'
              ? 'rounded-lg bg-red-600/80 px-2.5 py-1 font-bold text-white transition cursor-pointer'
              : 'rounded-lg px-2.5 py-1 font-bold text-slate-300 hover:text-red-300 transition cursor-pointer';
          btnPure.className =
            mode === 'pure'
              ? 'rounded-lg bg-emerald-600/80 px-2.5 py-1 font-bold text-white transition cursor-pointer'
              : 'rounded-lg px-2.5 py-1 font-bold text-slate-300 hover:text-emerald-300 transition cursor-pointer';
        }

        if (severityEl) severityEl.textContent = b.severity;
        if (bugNameEl) bugNameEl.textContent = `${b.icon} ${b.name}`;
        if (bugSummaryEl) bugSummaryEl.textContent = b.summary;
        if (bugCaptionEl) {
          bugCaptionEl.textContent =
            mode === 'cursed' ? `SYMPTOM: ${b.symptom}` : `PURE PRODUCTION FIX · ${b.name.toUpperCase()}`;
          bugCaptionEl.className = mode === 'cursed' ? 'font-bold text-red-300' : 'font-bold text-emerald-300';
        }
        if (bugPreEl) {
          bugPreEl.textContent = mode === 'cursed' ? b.cursedCode : b.pureCode;
          bugPreEl.className =
            mode === 'cursed'
              ? 'overflow-x-auto p-3.5 font-mono text-[11px] leading-relaxed text-red-200'
              : 'overflow-x-auto p-3.5 font-mono text-[11px] leading-relaxed text-emerald-200';
        }

        if (withWave) {
          emitManorWave(mode === 'pure' ? b.waveText : `EXHIBIT ${idx + 1}: CURSED!`, mode === 'pure' ? b.waveColor : '#ef4444');
        }
      }

      bugTabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const idx = parseInt(tab.getAttribute('data-bug-tab') || '0', 10);
          playManorTone(480 + idx * 40, 'sine', 0.06);
          renderBugExhibit(idx, codeMode, true);
        });
      });
      btnCursed?.addEventListener('click', () => {
        playManorTone(320, 'triangle', 0.06);
        renderBugExhibit(activeBugIdx, 'cursed', true);
      });
      btnPure?.addEventListener('click', () => {
        playManorTone(640, 'sine', 0.08);
        renderBugExhibit(activeBugIdx, 'pure', true);
      });
      document.getElementById('btn-walk-exhibit')?.addEventListener('click', () => {
        const b = bugs[activeBugIdx];
        if (!b) return;
        playManorTone(500, 'sine', 0.06);
        window.dispatchEvent(new CustomEvent('town:locate', { detail: { id: b.walkId } }));
        emitManorWave(b.waveText, b.waveColor);
      });

      // 5. Urshifu's Valor Ward (+50% Speed Overclock Buff)
      const wardBtn = document.getElementById('btn-urshifu-ward');
      const wardStatus = document.getElementById('urshifu-buff-status');
      let wardTimer: number | null = null;

      wardBtn?.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('town:claim-lucky-egg'));
        window.dispatchEvent(new CustomEvent('town:locate', { detail: { id: 'urshifu' } }));
        emitManorWave('VALOR WARD +50% SPD', '#fde047');
        [523.25, 659.25, 783.99].forEach((f, idx) => setTimeout(() => playManorTone(f, 'sine', 0.14), idx * 70));

        if (speakerEl) speakerEl.textContent = '🥋 Urshifu · Manor Sentinel of Valor';
        if (dialogueEl) {
          dialogueEl.textContent =
            '“Hmph! Valor Ward active — your character dashes +50% faster across Blood Manor and all Town maps for 25 seconds!”';
        }

        if (wardTimer !== null) clearInterval(wardTimer);
        let rem = 25;
        const updateWard = () => {
          if (!wardStatus) return;
          if (rem > 0) {
            wardStatus.textContent = `🌙 ACTIVE +50% (${rem}s)`;
            wardStatus.className =
              'rounded-full border border-amber-400/80 bg-amber-500/20 px-2 py-0.5 font-mono text-[9px] font-black text-amber-200 animate-pulse';
          } else {
            wardStatus.textContent = 'READY';
            wardStatus.className =
              'rounded-full border border-amber-400/40 bg-amber-950/70 px-2 py-0.5 font-mono text-[9px] font-bold text-amber-200';
            if (wardTimer !== null) {
              clearInterval(wardTimer);
              wardTimer = null;
            }
          }
        };
        updateWard();
        wardTimer = window.setInterval(() => {
          rem--;
          updateWard();
        }, 1000);
      });

      document.addEventListener(
        'astro:before-swap',
        () => {
          if (duelTimer !== null) clearTimeout(duelTimer);
          if (wardTimer !== null) clearInterval(wardTimer);
        },
        { once: true }
      );
    }

    initManorPage();
    document.addEventListener('astro:page-load', initManorPage);
  </script>
</TownLayout>
