---
import TownLayout from '../../layouts/TownLayout.astro';
import WhereTo from '../../components/WhereTo.astro';
import { profile } from '../../lib/profile';
import { ABYSSAL_SEALS_META, type AbyssalSealKey } from '../../engine/darkInteriorShared';

const githubUrl = profile.socials.find((s) => s.label === 'GitHub')?.url || 'https://github.com/Zulfan15';

const sanctumCards: Array<{ key: AbyssalSealKey; href: string; label: string }> = [
  { key: 'echoes', href: '/dark-castle/cathedral', label: 'Shadow Cathedral' },
  { key: 'ember', href: '/dark-castle/forge', label: 'Crimson Reactor Forge' },
  { key: 'valor', href: '/dark-castle/manor', label: 'Blood Manor' },
  { key: 'eternity', href: '/dark-castle/vault', label: 'Chained Chrono Vault' },
];

const cursedBugs = [
  {
    id: 'phantom-float',
    icon: '👻',
    name: 'The Floating-Point Phantom',
    severity: 'CRITICAL · CANVAS PHYSICS',
    symptom: '0.1 + 0.2 !== 0.3',
    summary:
      'IEEE 754 binary rounding drift caused entity coordinates to accumulate epsilon errors (e.g. x = 6.999999994), making tile collision checks clip through solid dungeon walls.',
    cursedCode: `// CURSED: Raw float drift breaks strict grid equality
if (player.x === wallTile.x && player.y === wallTile.y) {
  blockMovement(); // Skipped when x = 6.999999994!
}`,
    pureCode: `// PURE FIX: Integer tile coordinates + quantized progress
const tileX = Math.round(pos.x);
const isSolid = COLLISION[tileY * COLS + tileX] === 1;
const drawX = (pos.x + (target.x - pos.x) * progress) * TILE_SIZE;`,
    walkId: 'bug-gallery-1',
    waveText: 'PHANTOM QUANTIZED!',
    waveColor: '#4ade80',
  },
  {
    id: 'render-ouroboros',
    icon: '♾️',
    name: 'The Render Loop Ouroboros',
    severity: 'HIGH · GPU / BATTERY',
    symptom: '60 FPS on Idle Static Screen',
    summary:
      'An unconditional requestAnimationFrame loop re-painted full static backgrounds every 16ms even when nothing moved, burning mobile CPU & GPU batteries unnecessarily.',
    cursedCode: `// CURSED: Burns 60 frames/sec forever even while AFK
function frame() {
  redrawAllTerrainTiles();
  requestAnimationFrame(frame);
}`,
    pureCode: `// PURE FIX: Offscreen Cache + Wake-on-Demand Governor
if (!this.isMoving && this.path.length === 0 && !activeFX) {
  this.sleep(); // Zero CPU until input/timer wakes engine
  return;
}`,
    walkId: 'bug-gallery-2',
    waveText: 'LOOP GOVERNED!',
    waveColor: '#38bdf8',
  },
  {
    id: 'cache-hydra',
    icon: '⚡',
    name: 'The Cache Stampede Hydra',
    severity: 'SEV-1 · DISTRIBUTED DB',
    symptom: '1,200 Concurrent Oversells',
    summary:
      'When hot donation inventory expired simultaneously under burst traffic, hundreds of workers bypassed cache and fought over the same unguarded database rows.',
    cursedCode: `// CURSED: Check-then-act race condition oversells stock
$item = Donation::find($id);
if ($item->qty > 0) {
  $item->decrement('qty'); // Negative stock under concurrency!
}`,
    pureCode: `// PURE FIX: Redis Lua Distributed Mutex + Row Locking
$lock = Redis::set("lock:don:$id", $token, 'EX', 5, 'NX');
DB::transaction(fn () =>
  Donation::whereKey($id)->lockForUpdate()->firstOrFail()
);`,
    walkId: 'bug-gallery-1',
    waveText: 'STAMPEDE SEALED!',
    waveColor: '#fbbf24',
  },
  {
    id: 'zombie-listeners',
    icon: '🕳️',
    name: 'The Ghost Listener Leak',
    severity: 'HIGH · MEMORY LEAK',
    symptom: '+4 GB Heap Growth / 12h',
    summary:
      'Client-side page transitions attached new window keydown & ResizeObserver closures without detaching prior scene handles, retaining detached DOM canvases in RAM.',
    cursedCode: `// CURSED: Stacked duplicate listeners across ViewTransitions
document.addEventListener('astro:page-load', () => {
  window.addEventListener('keydown', handleControls); // Leaks!
});`,
    pureCode: `// PURE FIX: Deterministic unbind registry on swap
this.unbindEvents.push(() => window.removeEventListener('keydown', onKey));
document.addEventListener('astro:before-swap', () => this.destroy(), { once: true });`,
    walkId: 'bug-gallery-2',
    waveText: 'MEMORY PURGED!',
    waveColor: '#c084fc',
  },
];
---

<TownLayout
  title="Demon Keep & Blood Manor — Gargoyle Citadel | Muhammad Zulfan"
  description="Enter Demon Keep & Blood Manor: battle Sovereign Darkrai in a 4-round Tactical System Design Duel, consult Giratina & Sentinel Urshifu, and inspect the Museum of Cursed Bugs."
  place="dark-manor"
>
  <article class="manor-page space-y-6 pb-10 text-[#fee2e2]">
    <!-- 1. IMPERIAL GARGOYLE CITADEL MARQUEE BANNER (CRIMSON VELVET & GILDED BRASS) -->
    <header class="relative overflow-hidden rounded-2xl border-[3px] border-[#b45309] bg-gradient-to-b from-[#1d060b] via-[#2b0912] to-[#0f0306] p-5 text-[#fee2e2] shadow-[0_10px_0_#3b070e,0_18px_36px_rgba(0,0,0,0.65)]">
      <!-- Top & Bottom Crimson-Gold Fretwork Trim -->
      <div
        class="pointer-events-none absolute inset-x-0 top-0 h-2 bg-[repeating-linear-gradient(90deg,#fbbf24_0px,#fbbf24_12px,#991b1b_12px,#991b1b_24px)] opacity-90"
      >
      </div>
      <div
        class="pointer-events-none absolute inset-x-0 bottom-0 h-1.5 bg-gradient-to-r from-[#7f1d1d] via-[#fbbf24] to-[#7f1d1d]"
      >
      </div>

      <!-- Radial Nightmare Flame Glows -->
      <div class="pointer-events-none absolute -right-12 -top-12 h-48 w-48 rounded-full bg-red-600/15 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-12 -left-12 h-48 w-48 rounded-full bg-purple-600/15 blur-3xl"></div>

      <!-- Top Telemetry Ribbon -->
      <div class="relative z-10 flex flex-wrap items-center justify-between gap-2 border-b border-red-500/25 pb-3 pt-1">
        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center gap-1.5 rounded-full border-2 border-[#fbbf24]/80 bg-[#2a070f]/95 px-3 py-0.5 font-mono text-[10px] font-extrabold uppercase tracking-[0.16em] text-[#fde68a] shadow-sm">
            <span id="manor-live-dot" class="h-2 w-2 rounded-full bg-red-400 animate-pulse"></span>
            SW WARD · GARGOYLE CITADEL
          </span>
          <span
            id="manor-seal-badge"
            class="inline-flex items-center gap-1.5 rounded-full border border-red-500/60 bg-red-950/75 px-2.5 py-0.5 font-mono text-[10px] font-bold uppercase tracking-wider text-red-200"
          >
            🔒 SEAL OF VALOR: LOCKED
          </span>
          <span
            id="manor-master-badge"
            class="hidden items-center gap-1 rounded-full border-2 border-[#fde047] bg-gradient-to-r from-[#b91c1c] to-[#d97706] px-2.5 py-0.5 font-mono text-[10px] font-black uppercase tracking-wider text-[#fffbeb] shadow"
          >
            👑 NIGHTMARE VANQUISHED
          </span>
        </div>

        <div class="flex items-center gap-2">
          <a
            href="/dark-castle?from=manor"
            onclick="sessionStorage.setItem('dark-castle:respawn', '11,52,down')"
            class="inline-flex items-center gap-1 rounded-lg border-2 border-[#991b1b] bg-[#2a0912] px-2.5 py-1 font-mono text-[10px] font-bold text-[#fde68a] transition hover:border-[#fbbf24] hover:bg-[#450a0a]"
          >
            ← Dark Castle
          </a>
        </div>
      </div>

      <!-- Title & Valor Telemetry Tablet -->
      <div class="relative z-10 mt-4 flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
        <div class="space-y-2">
          <p class="font-mono text-[10px] font-bold uppercase tracking-[0.18em] text-[#f87171]">
            DARK CASTLE · NIGHTMARE TRIBUNAL &amp; BUG POST-MORTEM HALL
          </p>
          <h1 id="panel-title" class="font-pixel text-base sm:text-lg leading-snug text-[#fef3c7] drop-shadow-[0_2px_0_#450a0a] flex items-center gap-2.5">
            <span>🏰</span>
            <span>DEMON KEEP &amp; BLOOD MANOR</span>
          </h1>
          <p class="max-w-xl text-xs sm:text-sm leading-relaxed text-[#fecaca]/90">
            Guarded by perched stone gargoyles and rift sentinels. Outmaneuver
            <strong class="text-[#fde047]">Darkrai · Sovereign of Nightmares</strong> across <strong class="text-white">4 System Crisis Rounds</strong> to claim the
            <strong class="text-emerald-300">Seal of Valor</strong>, or inspect cursed code in the museum.
          </p>
        </div>

        <!-- Imperial Valor Shield Telemetry Tablet -->
        <div class="flex shrink-0 flex-col items-end rounded-xl border-2 border-[#fbbf24]/80 bg-[#140409]/95 px-4 py-2.5 shadow-inner">
          <span class="font-mono text-[10px] font-bold uppercase tracking-widest text-[#fcd34d]">
            ⚔️ TRIAL OF VALOR TELEMETRY
          </span>
          <div class="mt-1 flex items-baseline gap-2">
            <span id="manor-shield-readout" class="font-['Press_Start_2P',monospace] text-sm sm:text-base text-[#f87171] drop-shadow-[0_2px_0_#450a0a]">
              4 / 4
            </span>
            <span id="manor-rank-pill" class="rounded border border-red-500/50 bg-[#450a0a]/90 px-1.5 py-0.5 font-mono text-[9px] font-extrabold text-[#fecaca]">
              SHIELDED
            </span>
          </div>
          <div class="mt-1.5 flex items-center gap-2 font-mono text-[10px] text-[#e2e8f0]">
            <span>Abyssal Seals: <strong id="manor-abyssal-count" class="text-[#fde047]">0 / 4</strong></span>
            <span>·</span>
            <span id="manor-exhibits-readout" class="text-amber-300">{cursedBugs.length} Exhibits</span>
          </div>
        </div>
      </div>

      <!-- Tri-Sentinel Interactive Dialogue Strip (Darkrai, Giratina & Urshifu) -->
      <div class="relative z-10 mt-4 rounded-xl border-2 border-[#b45309]/60 bg-[#120408]/90 p-3.5 backdrop-blur-sm shadow-inner">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-start">
          <div class="flex shrink-0 items-center gap-1.5">
            <button
              type="button"
              data-manor-walk="darkrai"
              data-speaker="🌑 Darkrai · Sovereign of Nightmares"
              data-quote="My nightmare bugs feast on unguarded concurrency and stale caches. Step onto the sunken arena and survive all 4 architectural trials!"
              data-fx-text="DARK VOID CHALLENGE!"
              data-fx-color="#ef4444"
              class="flex h-11 w-11 items-center justify-center rounded-xl border-2 border-red-400/70 bg-red-500/20 text-xl shadow-[0_2px_0_#450a0a] transition hover:-translate-y-0.5 hover:bg-red-500/30 cursor-pointer"
              title="Walk to Darkrai in 2D Canvas"
            >
              🌑
            </button>
            <button
              type="button"
              data-manor-walk="giratina"
              data-speaker="🐉 Giratina · Distortion Rift Arbiter"
              data-quote="From the Distortion World I recorded four cursed production bugs. Inspect both Cursed vs. Pure Code below before facing Darkrai!"
              data-fx-text="SHADOW FORCE RIFT!"
              data-fx-color="#a855f7"
              class="flex h-11 w-11 items-center justify-center rounded-xl border-2 border-purple-400/70 bg-purple-500/20 text-xl shadow-[0_2px_0_#3b0764] transition hover:-translate-y-0.5 hover:bg-purple-500/30 cursor-pointer"
              title="Walk to Giratina in 2D Canvas"
            >
              🐉
            </button>
            <button
              type="button"
              data-manor-walk="urshifu"
              data-speaker="🥋 Urshifu · Manor Sentinel of Valor"
              data-quote="Hmph! Visit my Valor Ward shrine below to infuse +50% movement speed across every map in Dark Castle and Town Square!"
              data-fx-text="WICKED VALOR WARD!"
              data-fx-color="#fde047"
              class="flex h-11 w-11 items-center justify-center rounded-xl border-2 border-amber-400/70 bg-amber-500/20 text-xl shadow-[0_2px_0_#78350f] transition hover:-translate-y-0.5 hover:bg-amber-500/30 cursor-pointer"
              title="Walk to Urshifu in 2D Canvas"
            >
              🥋
            </button>
          </div>

          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span id="manor-speaker" class="font-mono text-[11px] font-black uppercase tracking-wider text-[#f87171]">
                🌑 Darkrai · Sovereign of Nightmares
              </span>
              <span class="font-mono text-[9px] uppercase tracking-wider text-amber-300/80">
                Click Sentinel or Card to Walk in 2D
              </span>
            </div>
            <p id="manor-dialogue" class="mt-1 text-xs leading-relaxed text-[#fecaca] italic">
              “My nightmare bugs feast on unguarded concurrency and stale caches. Step onto the sunken arena below or inspect the Cursed Bug Gallery to prepare for battle!”
            </p>
          </div>
        </div>
      </div>

      <!-- 6 Tactile Quick-Walk Medal Cards (4+2 Grid) -->
      <div class="relative z-10 mt-4 grid grid-cols-2 gap-2 sm:grid-cols-3">
        <button
          type="button"
          class="manor-station-btn group flex items-center gap-2 rounded-xl border-2 border-[#d97706] bg-gradient-to-b from-[#fef3c7] to-[#fde68a] px-3 py-2 text-left text-[#451a03] shadow-[0_3px_0_#78350f] transition hover:-translate-y-0.5 hover:from-[#fffbeb] hover:to-[#fef08a] active:translate-y-0.5 cursor-pointer"
          data-walk="darkrai"
          data-scroll-to="manor-shadow-duel"
          data-key="d"
          data-speaker="🌑 Darkrai · Nightmare Tribune"
          data-quote="Draw your architectural counter! Solve all 4 crisis rounds to break my Nightmare Shield."
          data-fx-text="DUEL INITIATED!"
          data-fx-color="#ef4444"
        >
          <span class="text-base">⚔️</span>
          <div class="min-w-0">
            <div class="truncate font-mono text-[11px] font-black uppercase">Duel Darkrai</div>
            <div class="truncate text-[10px] font-semibold text-[#78350f]">Shadow Trial [D]</div>
          </div>
        </button>

        <button
          type="button"
          class="manor-station-btn group flex items-center gap-2 rounded-xl border-2 border-[#9333ea] bg-gradient-to-b from-[#f3e8ff] to-[#e9d5ff] px-3 py-2 text-left text-[#3b0764] shadow-[0_3px_0_#581c87] transition hover:-translate-y-0.5 hover:from-[#faf5ff] hover:to-[#f3e8ff] active:translate-y-0.5 cursor-pointer"
          data-walk="giratina"
          data-scroll-to="manor-bug-gallery"
          data-key="g"
          data-speaker="🐉 Giratina · Distortion Rift Arbiter"
          data-quote="Behold the 4 production post-mortems sealed inside our Rift Museum!"
          data-fx-text="RIFT MUSEUM OPEN!"
          data-fx-color="#a855f7"
        >
          <span class="text-base">🐉</span>
          <div class="min-w-0">
            <div class="truncate font-mono text-[11px] font-black uppercase">Giratina Rift</div>
            <div class="truncate text-[10px] font-semibold text-[#6b21a8]">West Plinth [G]</div>
          </div>
        </button>

        <button
          type="button"
          class="manor-station-btn group flex items-center gap-2 rounded-xl border-2 border-[#d97706] bg-gradient-to-b from-[#fef3c7] to-[#fde68a] px-3 py-2 text-left text-[#451a03] shadow-[0_3px_0_#78350f] transition hover:-translate-y-0.5 hover:from-[#fffbeb] hover:to-[#fef08a] active:translate-y-0.5 cursor-pointer"
          data-walk="urshifu"
          data-scroll-to="manor-relic-section"
          data-key="u"
          data-speaker="🥋 Urshifu · Manor Sentinel of Valor"
          data-quote="Focus your stance! Activate the +50% Speed Valor Ward anytime in the Relic Coffer."
          data-fx-text="URSHIFU VALOR WARD!"
          data-fx-color="#fde047"
        >
          <span class="text-base">🥋</span>
          <div class="min-w-0">
            <div class="truncate font-mono text-[11px] font-black uppercase">Urshifu Ward</div>
            <div class="truncate text-[10px] font-semibold text-[#78350f]">East Plinth [U]</div>
          </div>
        </button>

        <button
          type="button"
          class="manor-station-btn group flex items-center gap-2 rounded-xl border-2 border-[#d97706] bg-gradient-to-b from-[#fef3c7] to-[#fde68a] px-3 py-2 text-left text-[#451a03] shadow-[0_3px_0_#78350f] transition hover:-translate-y-0.5 hover:from-[#fffbeb] hover:to-[#fef08a] active:translate-y-0.5 cursor-pointer"
          data-walk="bug-gallery-1"
          data-scroll-to="manor-bug-gallery"
          data-key="b"
          data-speaker="🖼️ Cursed Bug Gallery (NW/NE)"
          data-quote="Toggle between Cursed Code and Pure Production Fixes across 4 real incident studies."
          data-fx-text="CURSED EXHIBITS!"
          data-fx-color="#f87171"
        >
          <span class="text-base">🖼️</span>
          <div class="min-w-0">
            <div class="truncate font-mono text-[11px] font-black uppercase">Bug Museum</div>
            <div class="truncate text-[10px] font-semibold text-[#78350f]">4 Code Exhibits [B]</div>
          </div>
        </button>

        <button
          type="button"
          class="manor-station-btn group flex items-center gap-2 rounded-xl border-2 border-[#dc2626] bg-gradient-to-b from-[#fee2e2] to-[#fecaca] px-3 py-2 text-left text-[#7f1d1d] shadow-[0_3px_0_#7f1d1d] transition hover:-translate-y-0.5 hover:from-[#fef2f2] hover:to-[#fee2e2] active:translate-y-0.5 cursor-pointer"
          data-walk="blood-fireplace"
          data-scroll-to="manor-shadow-duel"
          data-key="f"
          data-speaker="🔥 Crimson Abyssal Hearth"
          data-quote="Blue-crimson flames warm the keep. Gather your resolve and return to the sunken duel arena!"
          data-fx-text="ABYSSAL HEARTH FIRE!"
          data-fx-color="#f97316"
        >
          <span class="text-base">🔥</span>
          <div class="min-w-0">
            <div class="truncate font-mono text-[11px] font-black uppercase">Crimson Hearth</div>
            <div class="truncate text-[10px] font-semibold text-[#991b1b]">SW Hearth [F]</div>
          </div>
        </button>

        <button
          type="button"
          class="manor-station-btn group flex items-center gap-2 rounded-xl border-2 border-[#d97706] bg-gradient-to-b from-[#fef3c7] to-[#fde68a] px-3 py-2 text-left text-[#451a03] shadow-[0_3px_0_#78350f] transition hover:-translate-y-0.5 hover:from-[#fffbeb] hover:to-[#fef08a] active:translate-y-0.5 cursor-pointer"
          data-walk="demon-crenellations"
          data-scroll-to="manor-relic-section"
          data-key="v"
          data-speaker="🦇 Gargoyle Perch & Valor Vault"
          data-quote="Inspect the sealed Incident Playbook & all 4 Dark Castle Abyssal Seals inside this coffer!"
          data-fx-text="GARGOYLE PERCH!"
          data-fx-color="#fbbf24"
        >
          <span class="text-base">🦇</span>
          <div class="min-w-0">
            <div class="truncate font-mono text-[11px] font-black uppercase">Valor Vault</div>
            <div class="truncate text-[10px] font-semibold text-[#78350f]">SE Coffer [V]</div>
          </div>
        </button>
      </div>
    </header>

    <!-- 2. SHADOW LOGIC TRIAL 2.0 VS DARKRAI (TACTICAL BOSS BATTLE) -->
    <section
      id="manor-shadow-duel"
      class="scroll-mt-6 overflow-hidden rounded-2xl border-[3px] border-[#b45309] bg-gradient-to-b from-[#1a070d] via-[#130509] to-[#0a0205] shadow-[0_8px_0_#3b070e,0_14px_28px_rgba(0,0,0,0.55)]"
    >
      <!-- Carved Crimson Header Arch -->
      <div class="flex flex-wrap items-center justify-between gap-3 border-b-[3px] border-[#991b1b] bg-gradient-to-r from-[#450a0a] via-[#6b121b] to-[#450a0a] px-5 py-3.5 text-[#fef3c7]">
        <div class="flex items-center gap-2.5">
          <span class="flex h-9 w-9 items-center justify-center rounded-xl border-2 border-[#fbbf24] bg-[#2a060b] text-lg shadow">
            ⚔️
          </span>
          <div>
            <div class="flex flex-wrap items-center gap-2">
              <h2 class="font-pixel text-[11px] sm:text-xs uppercase tracking-wider text-[#fef08a]">
                Shadow Logic Trial 2.0 vs. Darkrai
              </h2>
              <span
                id="duel-accuracy-pill"
                class="rounded-full border border-amber-400/50 bg-[#2a070f]/80 px-2 py-0.5 font-mono text-[10px] font-bold text-amber-200"
              >
                🎯 4-Round Trial
              </span>
            </div>
            <p class="mt-0.5 text-[11px] text-[#fecaca]/85">
              Counter 4 production crises without draining your Architect Resolve to claim the <strong class="text-emerald-300">Seal of Valor</strong>.
            </p>
          </div>
        </div>

        <span
          id="duel-round"
          class="rounded-lg border-2 border-[#fbbf24]/70 bg-[#2a070f] px-3 py-1 font-mono text-[11px] font-bold text-[#fde68a]"
        >
          Round 1 / 4
        </span>
      </div>

      <div class="p-5 space-y-4">
        <!-- Dual Combatant Health & Shield Arena HUD -->
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <!-- Player Resolve Bar -->
          <div class="rounded-xl border-2 border-sky-500/40 bg-[#080f1f]/90 p-3 shadow-inner">
            <div class="flex items-center justify-between font-mono text-[10px]">
              <span class="font-extrabold uppercase tracking-wider text-sky-300">🛡️ Challenger Architect</span>
              <span id="player-hp-text" class="font-bold text-emerald-300">3 / 3 Resolve</span>
            </div>
            <div class="mt-2 grid grid-cols-3 gap-1.5" id="player-hp-bars">
              <div class="h-2.5 rounded-full bg-emerald-400 shadow-[0_0_8px_#34d399] transition-all"></div>
              <div class="h-2.5 rounded-full bg-emerald-400 shadow-[0_0_8px_#34d399] transition-all"></div>
              <div class="h-2.5 rounded-full bg-emerald-400 shadow-[0_0_8px_#34d399] transition-all"></div>
            </div>
          </div>

          <!-- Boss Darkrai Nightmare Shield -->
          <div class="rounded-xl border-2 border-red-500/50 bg-[#1a050b]/90 p-3 shadow-inner">
            <div class="flex items-center justify-between font-mono text-[10px]">
              <span class="font-extrabold uppercase tracking-wider text-red-300">🌑 Sovereign Darkrai</span>
              <span id="darkrai-hp" class="font-bold text-red-400">4 / 4 Shields</span>
            </div>
            <div class="mt-2 grid grid-cols-4 gap-1.5" id="darkrai-hp-bars">
              <div class="h-2.5 rounded-full bg-red-500 shadow-[0_0_8px_#ef4444] transition-all"></div>
              <div class="h-2.5 rounded-full bg-red-500 shadow-[0_0_8px_#ef4444] transition-all"></div>
