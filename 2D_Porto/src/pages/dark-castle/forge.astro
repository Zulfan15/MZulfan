<script>
  import { awardAbyssalSeal, countAbyssalSeals, getAbyssalSeals } from '../../engine/darkInteriorShared';

  // --- Shared Synth WebAudio FX ---
  let forgeAudioEnabled = true;
  let audioCtx: AudioContext | null = null;

  function playForgeTone(freq: number, duration = 0.14, type: OscillatorType = 'triangle', gainPeak = 0.12) {
    if (!forgeAudioEnabled || typeof window === 'undefined') return;
    try {
      const Ctx = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
      if (!Ctx) return;
      if (!audioCtx) audioCtx = new Ctx();
      if (audioCtx.state === 'suspended') void audioCtx.resume();

      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = type;
      osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
      gain.gain.setValueAtTime(gainPeak, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start();
      osc.stop(audioCtx.currentTime + duration);
    } catch {
      // ignore autoplay block
    }
  }

  function playAnvilStrike() {
    playForgeTone(196, 0.12, 'sawtooth', 0.11);
    setTimeout(() => playForgeTone(587.33, 0.22, 'triangle', 0.14), 45);
    setTimeout(() => playForgeTone(880, 0.26, 'sine', 0.08), 110);
  }

  function emitForgeWave(text: string, color = '#fb923c') {
    window.dispatchEvent(new CustomEvent('town:forge-fx', { detail: { text, color } }));
  }

  function initForgePage() {
    const pageRoot = document.querySelector('.forge-page');
    if (!pageRoot) return;

    let greenTimer: number | null = null;
    let overdriveTimer: number | null = null;

    // --- Exit Respawn Persistence ---
    const exitBtn = document.getElementById('forge-exit-btn');
    exitBtn?.addEventListener('click', () => {
      try {
        sessionStorage.setItem('dark-castle:respawn', '33,25,down');
      } catch {
        // ignore storage errors
      }
    });

    // --- Audio Toggle ---
    const audioToggle = document.getElementById('forge-audio-toggle');
    audioToggle?.addEventListener('click', () => {
      forgeAudioEnabled = !forgeAudioEnabled;
      audioToggle.textContent = forgeAudioEnabled ? '🔊 Synth FX: ON' : '🔇 Synth FX: MUTED';
      if (forgeAudioEnabled) playForgeTone(523.25, 0.12, 'triangle', 0.1);
    });

    // --- Quick-Walk Medals & Keyboard Hotkeys ---
    const walkTo = (id: string) => {
      window.dispatchEvent(new CustomEvent('town:walk-to', { detail: { id } }));
      playForgeTone(392, 0.08, 'sine', 0.07);
    };

    document.querySelectorAll<HTMLElement>('[data-walk-to]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.walkTo;
        if (id) walkTo(id);
      });
    });

    const hotkeyMap: Record<string, string> = {
      r: 'magma-core',
      a: 'tech-anvil',
      t: 'telemetry-terminal',
      c: 'charizard',
      v: 'coolant-valves',
      l: 'plasma-batteries',
    };

    const onForgeHotkey = (e: KeyboardEvent) => {
      const tag = (e.target as HTMLElement | null)?.tagName;
      if (tag === 'INPUT' || tag === 'SELECT' || tag === 'TEXTAREA') return;
      if (e.ctrlKey || e.metaKey || e.altKey) return;
      const targetId = hotkeyMap[e.key.toLowerCase()];
      if (targetId) {
        walkTo(targetId);
      }
    };
    window.addEventListener('keydown', onForgeHotkey);

    // --- Seal UI Hydration ---
    function refreshSealUI() {
      const seals = getAbyssalSeals();
      const count = countAbyssalSeals();
      const emberClaimed = Boolean(seals.ember);

      const emberPill = document.getElementById('forge-ember-pill');
      const heroSeals = document.getElementById('hero-seals-count');
      const summaryEl = document.getElementById('forge-seals-summary');
      const lockedBox = document.getElementById('relic-blueprint-locked');
      const unlockedBox = document.getElementById('relic-blueprint-unlocked');
      const lockIcon = document.getElementById('relic-blueprint-icon');

      if (heroSeals) heroSeals.textContent = `${count}/4`;
      if (summaryEl) summaryEl.textContent = `${count} / 4 Abyssal Seals Claimed`;

      if (emberPill) {
        emberPill.textContent = emberClaimed ? '🔥 Seal of Ember Claimed' : '⏳ Seal of Ember Unclaimed';
        emberPill.className = emberClaimed
          ? 'rounded-full border border-[#4ade80]/60 bg-[#064e3b] px-2.5 py-1 font-mono text-[10px] font-bold uppercase tracking-wider text-[#a7f3d0]'
          : 'rounded-full border border-[#fb923c]/40 bg-[#450a0a]/80 px-2.5 py-1 font-mono text-[10px] font-bold uppercase tracking-wider text-[#fed7aa]';
      }

      if (emberClaimed) {
        lockedBox?.classList.add('hidden');
        unlockedBox?.classList.remove('hidden');
        if (lockIcon) lockIcon.textContent = '🔓';
        const sealStatusEl = document.getElementById('forge-seal-status');
        if (sealStatusEl) {
          sealStatusEl.textContent = '🔥 SEAL OF EMBER LOCKED IN! Reaktor stabil — Cetak Biru & Vault Registry diperbarui.';
          sealStatusEl.className = 'mt-4 font-mono text-xs font-bold text-[#4ade80]';
        }
      }

      (['echoes', 'ember', 'valor', 'eternity'] as const).forEach((key) => {
        const badge = document.querySelector<HTMLElement>(`[data-seal-badge="${key}"]`);
        const card = document.querySelector<HTMLElement>(`[data-seal-card="${key}"]`);
        const has = Boolean(seals[key]);
        if (badge) {
          badge.textContent = has ? '✅ CLAIMED' : '🔒';
          badge.className = has
            ? 'shrink-0 font-mono text-[10px] font-bold text-[#4ade80]'
            : 'shrink-0 font-mono text-[10px] font-bold text-[#fca5a5]';
        }
        if (card && has) {
          card.classList.add('border-[#4ade80]/50', 'bg-[#071f14]');
        }
      });
    }

    // --- TRIAL I: Magma Core Stabilizer 2.0 ---
    const sliderP = document.getElementById('slider-p') as HTMLInputElement | null;
    const sliderT = document.getElementById('slider-t') as HTMLInputElement | null;
    const sliderC = document.getElementById('slider-c') as HTMLInputElement | null;
    const valP = document.getElementById('val-p');
    const valT = document.getElementById('val-t');
    const valC = document.getElementById('val-c');
    const reactorReadout = document.getElementById('reactor-readout');
    const heroLoadReadout = document.getElementById('hero-load-readout');
    const reactorBar = document.getElementById('reactor-bar');
    const reactorLockText = document.getElementById('reactor-lock-text');
    const reactorLockBar = document.getElementById('reactor-lock-bar');
    const sealStatus = document.getElementById('forge-seal-status');
    const guardianQuote = document.getElementById('forge-guardian-quote');

    let greenElapsed = 0;

    function evaluateReactor() {
      if (!sliderP || !sliderT || !sliderC || !reactorReadout || !reactorBar || !sealStatus) return;
      const p = Number(sliderP.value);
      const t = Number(sliderT.value);
      const c = Number(sliderC.value);
      if (valP) valP.textContent = `${p}%`;
      if (valT) valT.textContent = `${t}%`;
      if (valC) valC.textContent = `${c}%`;

      const totalLoad = Math.min(120, Math.round(p * 1.1 + t * 0.95 + c * 0.8));
      const widthPct = Math.min(100, Math.round((totalLoad / 120) * 100));
      reactorBar.style.width = `${widthPct}%`;
      if (heroLoadReadout) heroLoadReadout.textContent = `${totalLoad}%`;

      if (totalLoad >= 95 && totalLoad <= 100) {
        reactorReadout.textContent = `${totalLoad}% · OPTIMAL RESONANCE`;
        reactorReadout.className = 'text-sm font-black text-[#4ade80]';
        reactorBar.className = 'relative z-20 h-full bg-gradient-to-r from-[#22c55e] to-[#4ade80] transition-all duration-100';
        if (guardianQuote) {
          guardianQuote.textContent = '"SEMPURNA! Pertahankan resin panas di zona hijau selama 5 detik penuh!"';
        }

        if (greenTimer === null) {
          playForgeTone(523.25, 0.14, 'sine', 0.1);
          greenTimer = window.setInterval(() => {
            greenElapsed += 0.25;
            const pct = Math.min(100, (greenElapsed / 5) * 100);
            if (reactorLockBar) reactorLockBar.style.width = `${pct}%`;
            if (reactorLockText) {
              reactorLockText.textContent = `Locking: ${Math.min(5, greenElapsed).toFixed(1)}s / 5.0s`;
            }

            if (greenElapsed >= 5) {
              if (greenTimer !== null) clearInterval(greenTimer);
              greenTimer = null;
              awardAbyssalSeal('ember');
              emitForgeWave('SEAL OF EMBER CLAIMED!', '#4ade80');
              playForgeTone(659.25, 0.16, 'triangle', 0.14);
              setTimeout(() => playForgeTone(880, 0.25, 'triangle', 0.14), 120);
              refreshSealUI();
            } else if (!getAbyssalSeals().ember) {
              sealStatus.textContent = `Menahan Zona Optimal (${greenElapsed.toFixed(1)}s / 5.0s)...`;
              sealStatus.className = 'mt-4 font-mono text-xs font-bold text-[#fde047]';
            }
          }, 250);
        }
      } else {
        if (greenTimer !== null) {
          clearInterval(greenTimer);
          greenTimer = null;
        }
        greenElapsed = 0;
        if (reactorLockBar) reactorLockBar.style.width = '0%';
        if (reactorLockText) reactorLockText.textContent = 'Hold 5.0s in Green Zone (95% – 100%)';

        if (totalLoad > 100) {
          reactorReadout.textContent = `${totalLoad}% · OVERLOAD WARNING!`;
          reactorReadout.className = 'text-sm font-black text-[#f87171]';
          reactorBar.className = 'relative z-20 h-full bg-gradient-to-r from-[#ef4444] to-[#b91c1c] transition-all duration-100';
          if (guardianQuote) {
            guardianQuote.textContent = '"TERLALU PANAS! Kurangi katup sebelum wadah Magma Core mengalami meltdown!"';
          }
        } else {
          reactorReadout.textContent = `${totalLoad}% · UNDERLOAD`;
          reactorReadout.className = 'text-sm font-black text-[#fdba74]';
          reactorBar.className = 'relative z-20 h-full bg-gradient-to-r from-[#f59e0b] to-[#ea580c] transition-all duration-100';
        }
      }
    }

    [sliderP, sliderT, sliderC].forEach((s) => s?.addEventListener('input', evaluateReactor));

    document.querySelectorAll<HTMLElement>('.forge-preset-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!sliderP || !sliderT || !sliderC) return;
        sliderP.value = btn.dataset.presetP || '25';
        sliderT.value = btn.dataset.presetT || '25';
        sliderC.value = btn.dataset.presetC || '18';
        playForgeTone(440, 0.1, 'sine', 0.08);
        evaluateReactor();
      });
    });

    document.getElementById('forge-reset-valves')?.addEventListener('click', () => {
      if (!sliderP || !sliderT || !sliderC) return;
      sliderP.value = '25';
      sliderT.value = '25';
      sliderC.value = '18';
      emitForgeWave('CRYO PURGE TRIGGERED!', '#38bdf8');
      playForgeTone(293.66, 0.16, 'sawtooth', 0.09);
      evaluateReactor();
    });

    // --- TRIAL II: Tech Stack Anvil 2.0 ---
    interface BlueprintSpec {
      title: string;
      badge: string;
      latency: string;
      throughput: string;
      memory: string;
      desc: string;
      tradeoff: string;
      routeHref: string;
      routeLabel: string;
      waveColor: string;
    }

    const blueprints: Record<string, BlueprintSpec> = {
      'rust-wasm::edge-worker': {
        title: 'Edge-Native Zero-Cold-Start Compute',
        badge: 'CLOUDFLARE WORKER · WASM',
        latency: '4.2 ms p99',
        throughput: '18,500 RPS',
        memory: '2.8 MB RSS',
        desc: 'Menjalankan modul Rust terkompilasi ke WASM tepat di PoP terdekat dengan pengguna untuk validasi kriptografis, parser binary, dan rate-limiting instan.',
        tradeoff: 'Batas memori ketat (128 MB) & tanpa OS multithreading — offload transaksi berat ke PostgreSQL worker terpisah.',
        routeHref: '/dev',
        routeLabel: 'Inspect Systems in /dev →',
        waveColor: '#fb923c',
      },
      'python-tensorrt::jetson-edge': {
        title: 'AeroScan Real-Time Vision Telemetry Pipeline',
        badge: 'EDGE AI · YOLOv11 + TENSORRT',
        latency: '14.8 ms / frame',
        throughput: '45+ FPS Stream',
        memory: '42 MB Pinned',
        desc: 'Pipeline Computer Vision YOLOv11 dikompilasi ke FP16 TensorRT Engine dengan pinned buffers RAII agar bebas memory leak meski berjalan 72+ jam nonstop.',
        tradeoff: 'Engine plan terikat dengan arsitektur GPU target — wajib build image terpisah per seri Jetson/GPU.',
        routeHref: '/lab',
        routeLabel: 'Test Live in /lab →',
        waveColor: '#38bdf8',
      },
      'go-postgres::high-concurrency': {
        title: 'FoodLink Atomic Ledger & Transactional Outbox',
        badge: 'CONCURRENT BACKEND · ACID',
        latency: '9.4 ms p99',
        throughput: '14,200 RPS',
        memory: '64 MB Heap',
        desc: 'Menghubungkan goroutine worker pool dengan PostgreSQL SELECT FOR UPDATE & outbox relay agar klaim donasi paralel bebas race condition & double-spend.',
        tradeoff: 'Row locking ketat menurunkan throughput tulis pada satu record panas; pecah antrean memakai Redis Lua singleflight.',
        routeHref: '/tower',
        routeLabel: 'Open Command Tower →',
        waveColor: '#fde047',
      },
      'ts-astro::canvas-engine': {
        title: '60 FPS Multi-Map Offscreen Canvas World',
        badge: 'FRONTEND ARCHITECTURE · ZERO BLOAT',
        latency: '< 1.8 ms / frame',
        throughput: '60 FPS Locked',
        memory: '18 MB GPU Cache',
        desc: 'Merender lapisan terrain statis ke offscreen backing canvas sekali saat map dimuat, lalu hanya menganimasikan karakter & partikel ringan dengan Sleep-on-Idle.',
        tradeoff: 'Membutuhkan sinkronisasi koordinat DOM button overlays saat viewport di-zoom agar aksesibilitas tetap terjaga.',
        routeHref: '/dev',
        routeLabel: 'View Portfolio Architecture →',
        waveColor: '#c084fc',
      },
    };

    let forgeCount = 0;

    function renderAnvilBlueprint(triggerFx: boolean) {
      const coreEl = document.getElementById('anvil-core') as HTMLSelectElement | null;
      const targetEl = document.getElementById('anvil-target') as HTMLSelectElement | null;
      if (!coreEl || !targetEl) return;

      const core = coreEl.value;
      const target = targetEl.value;
      const exactKey = `${core}::${target}`;
      const spec: BlueprintSpec = blueprints[exactKey] ?? {
        title: `Hybrid Forged Stack (${core.toUpperCase()} × ${target.toUpperCase()})`,
        badge: 'CUSTOM HYBRID ARCHITECTURE',
        latency: '11.5 ms p99',
        throughput: '11,000 RPS',
        memory: '48 MB Steady',
        desc: `Menggabungkan ketangguhan ${coreEl.options[coreEl.selectedIndex]?.text || core} ke realm ${targetEl.options[targetEl.selectedIndex]?.text || target} lewat antarmuka kontrak eksplisit, telemetry metric guard, dan graceful circuit breaker.`,
        tradeoff: 'Kombinasi lintas-domain menuntut observability tracing ketat (OpenTelemetry) untuk melacak bottleneck serialisasi.',
        routeHref: '/dev',
        routeLabel: 'Explore Benchmarks in /dev →',
        waveColor: '#fbbf24',
      };

      const setEl = (id: string, val: string) => {
        const el = document.getElementById(id);
        if (el) el.textContent = val;
      };
      setEl('anvil-title', spec.title);
      setEl('anvil-badge', spec.badge);
      setEl('anvil-latency', spec.latency);
      setEl('anvil-throughput', spec.throughput);
      setEl('anvil-memory', spec.memory);
      setEl('anvil-desc', spec.desc);
      setEl('anvil-tradeoff', spec.tradeoff);

      const routeLink = document.getElementById('anvil-route-link') as HTMLAnchorElement | null;
      if (routeLink) {
        routeLink.href = spec.routeHref;
        routeLink.textContent = spec.routeLabel;
      }

      if (triggerFx) {
        forgeCount += 1;
        const countEl = document.getElementById('hero-forges-count');
        if (countEl) countEl.textContent = String(forgeCount);
        const toast = document.getElementById('anvil-feedback-toast');
        if (toast) toast.textContent = `🔥 Blueprint "${spec.title}" ditempa!`;
        playAnvilStrike();
        emitForgeWave('STACK FORGED!', spec.waveColor);
      }
    }

    document.getElementById('anvil-forge-btn')?.addEventListener('click', () => renderAnvilBlueprint(true));

    document.querySelectorAll<HTMLElement>('.anvil-preset-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const coreEl = document.getElementById('anvil-core') as HTMLSelectElement | null;
        const targetEl = document.getElementById('anvil-target') as HTMLSelectElement | null;
        if (coreEl && btn.dataset.core) coreEl.value = btn.dataset.core;
        if (targetEl && btn.dataset.target) targetEl.value = btn.dataset.target;
        renderAnvilBlueprint(true);
      });
    });

    // --- RELIC I: Geothermal Overdrive (+50% Speed Buff) ---
    let overdriveLeft = 0;

    document.getElementById('forge-overdrive-btn')?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('town:claim-lucky-egg'));
      emitForgeWave('GEOTHERMAL OVERDRIVE +50%!', '#fbbf24');
      playForgeTone(659.25, 0.14, 'triangle', 0.12);
      setTimeout(() => playForgeTone(987.77, 0.2, 'sine', 0.1), 90);

      overdriveLeft = 25;
      const timerLabel = document.getElementById('forge-overdrive-timer');
      if (timerLabel) timerLabel.textContent = `⚡ Active: ${overdriveLeft}s`;
      if (overdriveTimer !== null) clearInterval(overdriveTimer);
      overdriveTimer = window.setInterval(() => {
        overdriveLeft -= 1;
        if (timerLabel) {
          timerLabel.textContent = overdriveLeft > 0 ? `⚡ Active: ${overdriveLeft}s` : 'Status: Ready';
        }
        if (overdriveLeft <= 0 && overdriveTimer !== null) {
          clearInterval(overdriveTimer);
          overdriveTimer = null;
        }
      }, 1000);
    });

    refreshSealUI();
    evaluateReactor();
    renderAnvilBlueprint(false);

    document.addEventListener(
      'astro:before-swap',
      () => {
        if (greenTimer !== null) clearInterval(greenTimer);
        if (overdriveTimer !== null) clearInterval(overdriveTimer);
        window.removeEventListener('keydown', onForgeHotkey);
      },
      { once: true }
    );
  }

  initForgePage();
  document.addEventListener('astro:page-load', initForgePage);
</script>
