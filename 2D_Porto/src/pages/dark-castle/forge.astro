---
import TownLayout from '../../layouts/TownLayout.astro';
import WhereTo from '../../components/WhereTo.astro';
import { profile } from '../../lib/profile';
import { ABYSSAL_SEALS_META, type AbyssalSealKey } from '../../engine/darkInteriorShared';

const githubUrl = profile.socials.find((s) => s.label === 'GitHub')?.url || 'https://github.com/Zulfan15';

const sanctumCards: Array<{ key: AbyssalSealKey; href: string; label: string }> = [
  { key: 'echoes', href: '/dark-castle/cathedral', label: 'Shadow Cathedral' },
  { key: 'ember', href: '/dark-castle/forge', label: 'Crimson Reactor Forge' },
  { key: 'valor', href: '/dark-castle/manor', label: 'Blood Manor' },
  { key: 'eternity', href: '/dark-castle/vault', label: 'Chained Chrono Vault' },
];

const anvilPresets = [
  { id: 'aeroscan', core: 'python-tensorrt', target: 'jetson-edge', label: '👁️ AeroScan Vision' },
  { id: 'foodlink', core: 'go-postgres', target: 'high-concurrency', label: '🍲 FoodLink Outbox' },
  { id: 'cloudflare', core: 'rust-wasm', target: 'edge-worker', label: '⚡ Edge WASM Worker' },
  { id: 'portfolio-2d', core: 'ts-astro', target: 'canvas-engine', label: '🎮 60 FPS Pixel World' },
];
---

<TownLayout
  title="Crimson Reactor Forge — Magitech Foundry & Chaos Bench | Muhammad Zulfan"
  description="Enter the Crimson Reactor Forge inside Dark Castle: stabilize the Geothermal Magma Core for the Seal of Ember and forge production systems on the Tech Stack Anvil."
  place="dark-forge"
>
  <article class="forge-page space-y-6 pb-10 text-[#fff1f2]">
    <!-- 1. IMPERIAL FOUNDRY MARQUEE BANNER (CRIMSON STEEL & GILDED BRASS) -->
    <header class="relative overflow-hidden rounded-2xl border-[3px] border-[#b45309] bg-gradient-to-b from-[#27090e] via-[#360d14] to-[#110407] p-5 text-[#fff1f2] shadow-[0_10px_0_#450a0a,0_18px_36px_rgba(0,0,0,0.68)]">
      <!-- Top & Bottom Repeating Brass-Crimson Fretwork Trim -->
      <div
        class="pointer-events-none absolute inset-x-0 top-0 h-2 bg-[repeating-linear-gradient(90deg,#fbbf24_0px,#fbbf24_12px,#dc2626_12px,#dc2626_24px)] opacity-90"
        aria-hidden="true"
      ></div>
      <div
        class="pointer-events-none absolute inset-x-0 bottom-0 h-2 bg-[repeating-linear-gradient(90deg,#dc2626_0px,#dc2626_12px,#fbbf24_12px,#fbbf24_24px)] opacity-90"
        aria-hidden="true"
      ></div>

      <div class="relative z-10 mt-1 flex flex-wrap items-start justify-between gap-4">
        <div class="space-y-2">
          <div class="flex flex-wrap items-center gap-2">
            <span class="rounded-full border border-[#fbbf24]/50 bg-[#7c2d12]/80 px-3 py-1 font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-[#fde68a]">
              🌋 DARK CASTLE EAST SANCTUM · GEOTHERMAL FOUNDRY
            </span>
            <span
              id="forge-ember-pill"
              class="rounded-full border border-[#fb923c]/40 bg-[#450a0a]/80 px-2.5 py-1 font-mono text-[10px] font-bold uppercase tracking-wider text-[#fed7aa]"
            >
              ⏳ Seal of Ember Unclaimed
            </span>
          </div>
          <h1 class="font-display text-2xl font-black tracking-tight text-[#fef3c7] drop-shadow-[0_2px_0_#450a0a] sm:text-3xl">
            Crimson Reactor Forge
          </h1>
          <p class="max-w-2xl text-sm leading-relaxed text-[#fecdd3]">
            Selamat datang di pusat rekayasa termal kastil. Kendalikan katup inti bersama <strong class="text-[#fde047]">Machinedramon</strong>,
            <strong class="text-[#fdba74]">Charizard</strong>, &amp; <strong class="text-[#fca5a5]">Groudon</strong> untuk menambang
            <strong class="text-[#fef08a]">Seal of Ember</strong> dan menempakan kombinasi arsitektur produksi di Tech Anvil.
          </p>
        </div>

        <!-- Live Reactor Telemetry Tablet & Citadel Exit -->
        <div class="flex flex-col items-end gap-2">
          <div class="grid grid-cols-3 gap-2 rounded-xl border-2 border-[#b45309]/80 bg-[#1a0609]/95 px-3 py-2 text-center font-mono shadow-inner">
            <div>
              <div class="text-[9px] font-bold uppercase tracking-wider text-[#fdba74]">CORE LOAD</div>
              <div id="hero-load-readout" class="text-sm font-black text-[#fef08a]">64%</div>
            </div>
            <div>
              <div class="text-[9px] font-bold uppercase tracking-wider text-[#fdba74]">FORGES</div>
              <div id="hero-forges-count" class="text-sm font-black text-[#fed7aa]">0</div>
            </div>
            <div>
              <div class="text-[9px] font-bold uppercase tracking-wider text-[#fdba74]">SEALS</div>
              <div id="hero-seals-count" class="text-sm font-black text-[#fde047]">0/4</div>
            </div>
          </div>

          <div class="flex flex-wrap items-center justify-end gap-2">
            <button
              id="forge-audio-toggle"
              type="button"
              class="cursor-pointer rounded-lg border-2 border-[#b45309] bg-[#450a0a] px-2.5 py-1.5 font-mono text-[11px] font-bold text-[#fde68a] transition hover:bg-[#7c2d12]"
            >
              🔊 Synth FX: ON
            </button>
            <a
              id="forge-exit-btn"
              href="/dark-castle?from=forge"
              class="inline-flex items-center gap-1.5 rounded-lg border-2 border-[#fbbf24] bg-gradient-to-b from-[#d97706] to-[#92400e] px-3 py-1.5 font-mono text-xs font-extrabold text-[#fffbeb] shadow-[0_3px_0_#451a03] transition hover:-translate-y-0.5 hover:brightness-110 active:translate-y-0"
            >
              🚪 Exit to Citadel
            </a>
          </div>
        </div>
      </div>

      <!-- Tri-Guardian Dialogue Strip -->
      <div class="relative z-10 mt-4 flex items-center gap-3 rounded-xl border border-[#fb923c]/35 bg-[#190508]/85 px-3.5 py-2.5 text-xs">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#f59e0b]/60 bg-[#450a0a] text-base">
          🤖
        </span>
        <div class="min-w-0 flex-1">
          <div class="font-mono text-[10px] font-bold uppercase tracking-wider text-[#fbbf24]">
            Machinedramon · Thermal Foundry AI
          </div>
          <p id="forge-guardian-quote" class="truncate text-[#fed7aa]">
            "PERINGATAN REAKTOR: Turunkan &amp; seimbangkan 3 katup antara 95%–100% selama 5 detik untuk mengklaim Seal of Ember!"
          </p>
        </div>
      </div>

      <!-- 6 Tactile Quick-Walk Station Medal Cards + Keyboard Hotkeys -->
      <nav aria-label="Quick walk forge stations" class="relative z-10 mt-4 grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-6">
        <button
          type="button"
          data-walk-to="magma-core"
          class="group flex cursor-pointer items-center justify-between gap-2 rounded-xl border-2 border-[#b45309]/70 bg-[#2d0b11]/90 px-2.5 py-2 text-left transition hover:-translate-y-0.5 hover:border-[#fbbf24] hover:bg-[#45111a]"
        >
          <span class="flex items-center gap-2 text-xs font-bold text-[#fef3c7]">
            <span>🌋</span>
            <span>Magma Core</span>
          </span>
          <kbd class="rounded border border-[#fbbf24]/40 bg-[#1a0609] px-1.5 py-0.5 font-mono text-[9px] font-bold text-[#fde047]">R</kbd>
        </button>

        <button
          type="button"
          data-walk-to="tech-anvil"
          class="group flex cursor-pointer items-center justify-between gap-2 rounded-xl border-2 border-[#b45309]/70 bg-[#2d0b11]/90 px-2.5 py-2 text-left transition hover:-translate-y-0.5 hover:border-[#fbbf24] hover:bg-[#45111a]"
        >
          <span class="flex items-center gap-2 text-xs font-bold text-[#fef3c7]">
            <span>🔨</span>
            <span>Tech Anvil</span>
          </span>
          <kbd class="rounded border border-[#fbbf24]/40 bg-[#1a0609] px-1.5 py-0.5 font-mono text-[9px] font-bold text-[#fde047]">A</kbd>
        </button>

        <button
          type="button"
          data-walk-to="telemetry-terminal"
          class="group flex cursor-pointer items-center justify-between gap-2 rounded-xl border-2 border-[#b45309]/70 bg-[#2d0b11]/90 px-2.5 py-2 text-left transition hover:-translate-y-0.5 hover:border-[#fbbf24] hover:bg-[#45111a]"
        >
          <span class="flex items-center gap-2 text-xs font-bold text-[#fef3c7]">
            <span>📊</span>
            <span>Telemetry</span>
          </span>
          <kbd class="rounded border border-[#fbbf24]/40 bg-[#1a0609] px-1.5 py-0.5 font-mono text-[9px] font-bold text-[#fde047]">T</kbd>
        </button>

        <button
          type="button"
          data-walk-to="charizard"
          class="group flex cursor-pointer items-center justify-between gap-2 rounded-xl border-2 border-[#b45309]/70 bg-[#2d0b11]/90 px-2.5 py-2 text-left transition hover:-translate-y-0.5 hover:border-[#fbbf24] hover:bg-[#45111a]"
        >
          <span class="flex items-center gap-2 text-xs font-bold text-[#fef3c7]">
            <span>🔥</span>
            <span>Charizard</span>
          </span>
          <kbd class="rounded border border-[#fbbf24]/40 bg-[#1a0609] px-1.5 py-0.5 font-mono text-[9px] font-bold text-[#fde047]">C</kbd>
        </button>

        <button
          type="button"
          data-walk-to="coolant-valves"
          class="group flex cursor-pointer items-center justify-between gap-2 rounded-xl border-2 border-[#b45309]/70 bg-[#2d0b11]/90 px-2.5 py-2 text-left transition hover:-translate-y-0.5 hover:border-[#fbbf24] hover:bg-[#45111a]"
        >
          <span class="flex items-center gap-2 text-xs font-bold text-[#fef3c7]">
            <span>❄️</span>
            <span>Cryo Valves</span>
          </span>
          <kbd class="rounded border border-[#fbbf24]/40 bg-[#1a0609] px-1.5 py-0.5 font-mono text-[9px] font-bold text-[#fde047]">V</kbd>
        </button>

        <button
          type="button"
          data-walk-to="plasma-batteries"
          class="group flex cursor-pointer items-center justify-between gap-2 rounded-xl border-2 border-[#b45309]/70 bg-[#2d0b11]/90 px-2.5 py-2 text-left transition hover:-translate-y-0.5 hover:border-[#fbbf24] hover:bg-[#45111a]"
        >
          <span class="flex items-center gap-2 text-xs font-bold text-[#fef3c7]">
            <span>🔋</span>
            <span>Relic Coffer</span>
          </span>
          <kbd class="rounded border border-[#fbbf24]/40 bg-[#1a0609] px-1.5 py-0.5 font-mono text-[9px] font-bold text-[#fde047]">L</kbd>
        </button>
      </nav>
    </header>

    <!-- 2. MAGMA CORE LOAD-BALANCER 2.0 MINI-GAME -->
    <section
      id="forge-reactor-game"
      class="rounded-2xl border-[3px] border-[#b45309] bg-gradient-to-b from-[#23080d] to-[#120407] p-5 shadow-[0_8px_0_#450a0a,0_16px_28px_rgba(0,0,0,0.55)]"
    >
      <div class="flex flex-wrap items-start justify-between gap-4 border-b border-[#fbbf24]/25 pb-4">
        <div>
          <span class="font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-[#fdba74]">
            TRIAL I · GEOTHERMAL LOAD-BALANCER 2.0
          </span>
          <h2 class="mt-1 font-display text-xl font-black text-[#fef3c7]">
            🔥 Magma Core Stabilizer Challenge
          </h2>
          <p class="mt-1 text-xs leading-relaxed text-[#fecdd3]">
            Kalibrasikan ketiga katup nonlinear untuk mempertahankan daya output pada
            <strong class="text-[#86efac]">Zona Optimal 95% – 100%</strong> selama
            <strong class="text-[#fde047]">5.0 detik</strong> berturut-turut guna menambang
            <strong class="text-[#fb923c]">🔥 Seal of Ember</strong>.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <button
            type="button"
            data-preset-p="20"
            data-preset-t="25"
            data-preset-c="20"
            class="forge-preset-btn cursor-pointer rounded-lg border border-[#38bdf8]/50 bg-[#0c4a6e]/40 px-2.5 py-1 font-mono text-[10px] font-bold text-[#bae6fd] transition hover:bg-[#0c4a6e]/75"
          >
            ❄️ Cryo Idle
          </button>
          <button
            type="button"
            data-preset-p="34"
            data-preset-t="35"
            data-preset-c="30"
            class="forge-preset-btn cursor-pointer rounded-lg border border-[#fbbf24]/50 bg-[#78350f]/50 px-2.5 py-1 font-mono text-[10px] font-bold text-[#fde68a] transition hover:bg-[#78350f]"
          >
            ⚖️ Tune Near-Opt
          </button>
          <button
            type="button"
            id="forge-reset-valves"
            class="cursor-pointer rounded-lg border border-[#ef4444]/60 bg-[#7f1d1d]/60 px-2.5 py-1 font-mono text-[10px] font-bold text-[#fecaca] transition hover:bg-[#991b1b]"
          >
            🧯 Purge Core
          </button>
        </div>
      </div>

      <!-- Visual Thermal Threshold Bar + Hold Timer HUD -->
      <div class="mt-4 rounded-xl border-2 border-[#b45309]/60 bg-[#0d0306] p-4 shadow-inner">
        <div class="flex flex-wrap items-center justify-between gap-2 font-mono text-xs">
          <span class="font-bold text-[#fed7aa]">THERMAL FLUX OUTPUT</span>
          <span id="reactor-readout" class="text-sm font-black text-[#fdba74]">64% · UNDERLOAD</span>
        </div>

        <!-- Bar with Green Sweet Spot Overlay (95%..100% mapped onto 0..120%) -->
        <div class="relative mt-2.5 h-6 overflow-hidden rounded-full border-2 border-[#451a03] bg-[#1c090e]">
          <!-- Optimal Zone Marker: 95/120 = 79.16%, width = 5/120 = 4.17% (widened visually slightly with bracket guides) -->
          <div
            class="pointer-events-none absolute inset-y-0 z-10 border-x-2 border-[#4ade80] bg-[#22c55e]/25"
            style="left: 79.16%; width: 4.5%;"
            title="Optimal Band: 95% - 100%"
          ></div>
          <!-- Overload Danger Marker: >100% -->
          <div
            class="pointer-events-none absolute inset-y-0 right-0 z-0 bg-[#ef4444]/15"
            style="width: 16.6%;"
          ></div>
          <div
            id="reactor-bar"
            class="relative z-20 h-full bg-gradient-to-r from-[#f59e0b] to-[#ea580c] transition-all duration-100"
            style="width: 53%"
          ></div>
        </div>

        <div class="mt-2 flex items-center justify-between font-mono text-[10px] text-[#fca5a5]/80">
          <span>0% Cryo Idle</span>
          <span class="font-bold text-[#4ade80]">▲ Target Window: 95% – 100%</span>
          <span class="font-bold text-[#f87171]">120% Meltdown!</span>
        </div>

        <!-- 5.0s Hold Lock Progress -->
        <div class="mt-3 rounded-lg border border-[#b45309]/40 bg-[#1b080d] p-2.5">
          <div class="flex items-center justify-between font-mono text-[11px]">
            <span class="font-bold text-[#fde68a]">CONTAINMENT LOCK TIMER</span>
            <span id="reactor-lock-text" class="font-bold text-[#fed7aa]">Hold 5.0s in Green Zone</span>
          </div>
          <div class="mt-1.5 h-2 overflow-hidden rounded-full bg-[#2e1017]">
            <div
              id="reactor-lock-bar"
              class="h-full w-0 bg-gradient-to-r from-[#22c55e] to-[#fde047] transition-all duration-100"
            ></div>
          </div>
        </div>
      </div>

      <!-- 3 Sliders -->
      <div class="mt-4 grid gap-3 sm:grid-cols-3">
        <label class="block rounded-xl border border-[#fb923c]/30 bg-[#1b070c] p-3 transition hover:border-[#fbbf24]/60">
          <div class="flex justify-between font-mono text-[11px] font-bold text-[#fed7aa]">
            <span>❄️ Coolant Flush</span>
            <span id="val-p" class="text-[#fde047]">25%</span>
          </div>
          <input
            id="slider-p"
            type="range"
            min="0"
            max="100"
            value="25"
            class="mt-2 w-full cursor-pointer accent-[#38bdf8]"
          />
          <p class="mt-1 font-mono text-[10px] text-[#fca5a5]/70">Weight: 1.10× flux gain</p>
        </label>

        <label class="block rounded-xl border border-[#fb923c]/30 bg-[#1b070c] p-3 transition hover:border-[#fbbf24]/60">
          <div class="flex justify-between font-mono text-[11px] font-bold text-[#fed7aa]">
            <span>🧲 Magnetic Confinement</span>
            <span id="val-t" class="text-[#fde047]">25%</span>
          </div>
          <input
            id="slider-t"
            type="range"
            min="0"
            max="100"
            value="25"
            class="mt-2 w-full cursor-pointer accent-[#fb923c]"
          />
          <p class="mt-1 font-mono text-[10px] text-[#fca5a5]/70">Weight: 0.95× flux gain</p>
        </label>

        <label class="block rounded-xl border border-[#fb923c]/30 bg-[#1b070c] p-3 transition hover:border-[#fbbf24]/60">
          <div class="flex justify-between font-mono text-[11px] font-bold text-[#fed7aa]">
            <span>⚙️ Dampening Rods</span>
            <span id="val-c" class="text-[#fde047]">18%</span>
          </div>
          <input
            id="slider-c"
            type="range"
            min="0"
            max="100"
            value="18"
            class="mt-2 w-full cursor-pointer accent-[#fbbf24]"
          />
          <p class="mt-1 font-mono text-[10px] text-[#fca5a5]/70">Weight: 0.80× flux gain</p>
        </label>
      </div>

      <p id="forge-seal-status" class="mt-4 font-mono text-xs font-bold text-[#fed7aa]">
        Status: Menunggu stabilisasi 5 detik di zona Optimal (95% – 100%)...
      </p>
    </section>

    <!-- 3. THE TECH STACK ANVIL 2.0 (ARCHITECTURE & TELEMETRY MATRIX) -->
    <section
      id="forge-tech-anvil"
      class="rounded-2xl border-[3px] border-[#b45309] bg-gradient-to-b from-[#23080d] to-[#120407] p-5 shadow-[0_8px_0_#450a0a,0_16px_28px_rgba(0,0,0,0.55)]"
    >
      <div class="flex flex-wrap items-start justify-between gap-3 border-b border-[#fbbf24]/25 pb-4">
        <div>
          <span class="font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-[#fdba74]">
            TRIAL II · ARCHITECTURE FORGE &amp; TELEMETRY BENCH
          </span>
          <h2 class="mt-1 font-display text-xl font-black text-[#fef3c7]">
            🔨 The Tech Stack Anvil 2.0
          </h2>
          <p class="mt-1 text-xs leading-relaxed text-[#fecdd3]">
            Pilih kombinasi <strong class="text-[#fde047]">Core Engine</strong> dan <strong class="text-[#fde047]">Target Realm</strong> untuk menempa cetak biru sistem lengkap beserta estimasi latensi p99 dan trade-off arsitektur.
          </p>
        </div>

        <!-- Preset Production Chips -->
        <div class="flex flex-wrap gap-1.5">
          {anvilPresets.map((preset) => (
            <button
              type="button"
              class="anvil-preset-btn cursor-pointer rounded-lg border border-[#fbbf24]/40 bg-[#450a0a]/80 px-2.5 py-1 font-mono text-[10px] font-bold text-[#fde68a] transition hover:border-[#fbbf24] hover:bg-[#7c2d12]"
              data-core={preset.core}
              data-target={preset.target}
            >
              {preset.label}
            </button>
          ))}
        </div>
      </div>

      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        <label class="block rounded-xl border border-[#fb923c]/30 bg-[#1b070c] p-3">
          <span class="block font-mono text-[10px] font-bold uppercase tracking-wider text-[#fdba74]">
            ⚙️ Core Runtime / Engine
          </span>
          <select
            id="anvil-core"
            class="mt-1.5 w-full cursor-pointer rounded-lg border border-[#b45309] bg-[#0e0306] px-3 py-2 font-mono text-xs font-bold text-[#fef3c7]"
          >
            <option value="rust-wasm">🦀 Rust / WebAssembly Core</option>
            <option value="go-postgres">🐹 Go Concurrency + PostgreSQL</option>
            <option value="python-tensorrt">🐍 Python + YOLOv11 / TensorRT</option>
            <option value="ts-astro">⚡ TypeScript + Astro Islands</option>
          </select>
        </label>

        <label class="block rounded-xl border border-[#fb923c]/30 bg-[#1b070c] p-3">
          <span class="block font-mono text-[10px] font-bold uppercase tracking-wider text-[#fdba74]">
            🌐 Target Execution Realm
          </span>
          <select
            id="anvil-target"
            class="mt-1.5 w-full cursor-pointer rounded-lg border border-[#b45309] bg-[#0e0306] px-3 py-2 font-mono text-xs font-bold text-[#fef3c7]"
          >
            <option value="edge-worker">☁️ Cloudflare Global Edge Worker</option>
            <option value="jetson-edge">🤖 NVIDIA Edge GPU / Drone Unit</option>
            <option value="high-concurrency">🚀 High-Concurrency Donation Burst</option>
            <option value="canvas-engine">🎮 60 FPS Browser Canvas World</option>
          </select>
        </label>
      </div>

      <div class="mt-4 flex flex-wrap items-center gap-3">
        <button
          id="anvil-forge-btn"
          type="button"
          class="cursor-pointer rounded-xl border-2 border-[#fbbf24] bg-gradient-to-b from-[#ea580c] to-[#9a3412] px-5 py-2.5 font-mono text-xs font-black uppercase tracking-wider text-[#fffbeb] shadow-[0_4px_0_#450a0a] transition hover:-translate-y-0.5 hover:brightness-110 active:translate-y-0.5"
        >
          🔨 Strike Anvil &amp; Forge Blueprint
        </button>
        <span id="anvil-feedback-toast" class="font-mono text-[11px] font-bold text-[#fde68a]">
          Siap ditempa — pilih preset atau kombinasi di atas.
        </span>
      </div>

      <!-- Forged Telemetry & Trade-off Output Card -->
      <div id="anvil-output" class="mt-4 rounded-xl border-2 border-[#fbbf24]/50 bg-[#0d0306] p-4 shadow-inner">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[#fbbf24]/20 pb-2.5">
          <div>
            <span id="anvil-badge" class="rounded bg-[#7c2d12] px-2 py-0.5 font-mono text-[10px] font-bold uppercase text-[#fde68a]">
              FORGED TELEMETRY SPEC
            </span>
            <h3 id="anvil-title" class="mt-1 font-display text-base font-black text-[#fef3c7]">
              Edge-Native Zero-Cold-Start Compute
            </h3>
          </div>
          <a
            id="anvil-route-link"
            href="/dev"
