      diff: `- $students = Student::all(); // Triggers 180+ separate queries in view loop\n+ $students = Student::with(['labGroup', 'submissions'])->paginate(35);`,
      prompt: 'Eager loads relational lab groups and submissions in 2 queries instead of 180 queries.',
      correct: 'approve',
      explain: '✅ Merged! Database round-trips reduced by 98% with clean eager loading.',
    },
    {
      branch: 'feat/cors-wildcard-auth',
      author: '@contractor-dev',
      diffLevel: 'Web Sec & CORS',
      title: 'PR #107: Set Access-Control-Allow-Origin: * With Credentials Allowed',
      diff: `+ header('Access-Control-Allow-Origin: *');\n+ header('Access-Control-Allow-Credentials: true');`,
      prompt: 'Wildcard origin combined with allow-credentials breaks browser specs and invites CSRF attacks!',
      correct: 'block',
      explain: '🛡️ Blocked! Modern browsers reject wildcard origin when credentials are true, preventing cross-site leaks.',
    },
    {
      branch: 'ci/dockerfile-multistage',
      author: '@maya-dev',
      diffLevel: 'DevOps & Containers',
      title: 'PR #108: Multi-Stage Dockerfile Prunes Image from 1.2GB to 85MB',
      diff: `+ FROM node:22-alpine AS builder\n+ RUN npm run build\n+ FROM caddy:2-alpine\n+ COPY --from=builder /app/dist /usr/share/caddy`,
      prompt: 'Discards heavy devDependencies and compilers from final production image.',
      correct: 'approve',
      explain: '✅ Merged! Production image shrank by 92% with faster CI deployment times.',
    },
  ];

  function showNeighbourToast(message: string, tone = '#fbbf24') {
    const region = document.getElementById('neighbour-toast-region');
    if (!region) return;
    const toast = document.createElement('div');
    toast.className = 'neighbour-toast';
    toast.style.borderColor = tone;
    toast.textContent = message;
    region.appendChild(toast);

    setTimeout(() => {
      toast.classList.add('is-hiding');
      setTimeout(() => toast.remove(), 250);
    }, 2800);
  }

  function initNeighbourPage() {
    let friendship = 88;
    let prIndex = 0;
    let prStreak = 0;
    let prScore = 0;
    let activeGbFilter = 'all';

    const friendshipVal = document.getElementById('hud-friendship-val');
    const friendshipBar = document.getElementById('hud-friendship-bar');
    const friendshipRank = document.getElementById('hud-friendship-rank');
    const friendshipSub = document.getElementById('hud-friendship-sub');
    const vibeVal = document.getElementById('hud-vibe-val');
    const vibeSub = document.getElementById('hud-vibe-sub');
    const hudPrScore = document.getElementById('hud-pr-score');
    const hudNotesCount = document.getElementById('hud-notes-count');

    function updateFriendshipTier() {
      let rankText = '🎖️ RANK: PEER CONTRIBUTOR';
      let subText = 'Tier 1 · Welcome Neighbour';
      if (friendship >= 100) {
        rankText = '👑 RANK: GUILD CO-FOUNDER (MAX)';
        subText = 'Tier 5 · Legendary Pair-Programming Duo';
      } else if (friendship >= 80) {
        rankText = '🤝 RANK: PAIR-PROGRAMMING DUO';
        subText = 'Tier 4 · Collaborative Ally';
      } else if (friendship >= 60) {
        rankText = '🎮 RANK: SENIOR PR REVIEWER';
        subText = 'Tier 3 · Sharp Code Auditor';
      } else if (friendship >= 40) {
        rankText = '🦊 RANK: EEVEE BEST FRIEND';
        subText = 'Tier 2 · Cottage Companion';
      }

      if (friendshipRank) friendshipRank.textContent = rankText;
      if (friendshipSub) friendshipSub.textContent = subText;
    }

    function addFriendship(delta: number, bannerText?: string, color = '#fbbf24') {
      friendship = Math.min(100, friendship + delta);
      if (friendshipVal) friendshipVal.textContent = `${friendship} / 100`;
      if (friendshipBar) friendshipBar.style.width = `${friendship}%`;
      updateFriendshipTier();

      if (bannerText) {
        window.dispatchEvent(
          new CustomEvent('town:neighbour-fx', {
            detail: { text: bannerText, color },
          })
        );
        showNeighbourToast(bannerText, color);
      }
    }

    // 1. Walk-to-Prop buttons (syncs with 2D canvas)
    document.querySelectorAll<HTMLElement>('[data-walk-prop]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const propId = btn.getAttribute('data-walk-prop');
        if (propId) {
          sfx.select();
          window.dispatchEvent(new CustomEvent('town:locate', { detail: { propId } }));
          const townCanvas = document.querySelector('.town');
          if (townCanvas && window.innerWidth < 768) {
            townCanvas.scrollIntoView({ behavior: 'smooth' });
          }
        }
      });
    });

    // 2. Interactive Tea Brewing Ceremony
    document.querySelectorAll<HTMLButtonElement>('.tea-brew-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const teaName = btn.getAttribute('data-brew-name') || 'Hearthside Tea';
        const teaColor = btn.getAttribute('data-brew-color') || '#f97316';
        const teaSparkle = btn.getAttribute('data-brew-sparkle') || '🍵 TEA BUFF!';

        sfx.espressoBrew();
        setTimeout(() => sfx.heal(), 220);

        window.dispatchEvent(new CustomEvent('town:locate', { detail: { propId: 'fireplace-hearth' } }));
        window.dispatchEvent(new CustomEvent('town:coffee-boost'));
        addFriendship(10, `${teaSparkle} ${teaName}`, teaColor);

        const origText = btn.textContent;
        btn.textContent = '✨ Seduhan Segar Siap!';
        btn.classList.add('is-brewed');
        setTimeout(() => {
          btn.textContent = origText;
          btn.classList.remove('is-brewed');
        }, 1800);
      });
    });

    // 3. Interactive Eevee Care buttons
    const eeveeTitle = document.getElementById('eevee-status-title');
    const eeveeDialogue = document.getElementById('eevee-status-dialogue');
    const eeveeMood = document.getElementById('eevee-mood-pill');
    const eeveeHeartPop = document.getElementById('eevee-heart-pop');

    function pulseEeveeHeart(emoji = '💖') {
      if (!eeveeHeartPop) return;
      eeveeHeartPop.textContent = emoji;
      eeveeHeartPop.classList.remove('is-popping');
      void eeveeHeartPop.offsetWidth;
      eeveeHeartPop.classList.add('is-popping');
    }

    document.getElementById('btn-pet-eevee')?.addEventListener('click', () => {
      sfx.heal();
      pulseEeveeHeart('💖');
      if (eeveeTitle) eeveeTitle.textContent = 'Eevee purrs and leans affectionately into your hand!';
      if (eeveeDialogue) eeveeDialogue.textContent = '"Eev-vee~ 💕" Eevee is radiating Cozy Pair-Programming Aura! Your friendship bond grew stronger.';
      if (eeveeMood) eeveeMood.textContent = 'Mood: Affectionate 💖';
      addFriendship(15, 'EEVEE CUDDLE! +15 FRIENDSHIP 🦊💖', '#f472b6');
    });

    document.getElementById('btn-feed-pokepuff')?.addEventListener('click', () => {
      sfx.confirm();
      pulseEeveeHeart('🧁');
      if (eeveeTitle) eeveeTitle.textContent = 'Eevee happily munches a Sweet Berry Poké Puff!';
      if (eeveeDialogue) eeveeDialogue.textContent = '"Vee-vee! 🧁✨" Berry vitamins boosted Eevee\'s energy to 100%! Ready for a full-stack coding sprint.';
      if (eeveeMood) eeveeMood.textContent = 'Mood: Energized ⚡';
      addFriendship(20, 'SWEET POKÉ PUFF! +20 FRIENDSHIP 🧁', '#fbbf24');
    });

    document.getElementById('btn-play-eevee')?.addEventListener('click', () => {
      sfx.select();
      pulseEeveeHeart('🧶');
      if (eeveeTitle) eeveeTitle.textContent = 'Eevee pounces on the yarn ball across the hearth rug!';
      if (eeveeDialogue) eeveeDialogue.textContent = '"Eev! 🧶🐾" Agile reflexes! Just like catching edge-case bugs before production deployment.';
      if (eeveeMood) eeveeMood.textContent = 'Mood: Playful 🌟';
      addFriendship(15, 'PLAYFUL FETCH! +15 FRIENDSHIP 🧶', '#38bdf8');
    });

    // 4. Eeveelution Tech Vibe Matcher & Evolution Stone Ceremony
    const evoCards = document.querySelectorAll<HTMLButtonElement>('.eeveelution-card');
    const spotIcon = document.getElementById('spotlight-icon');
    const spotType = document.getElementById('spotlight-type');
    const spotTitle = document.getElementById('spotlight-title');
    const spotQuote = document.getElementById('spotlight-quote');
    const spotStack = document.getElementById('spotlight-stack');
    const spotProject = document.getElementById('spotlight-project');
    const spotStatA = document.getElementById('spotlight-stata');
    const spotStatB = document.getElementById('spotlight-statb');
    const stageEmoji = document.getElementById('eevee-stage-emoji');

    function activateEeveelution(card: HTMLElement) {
      sfx.select();
      evoCards.forEach((c) => c.classList.remove('is-active'));
      card.classList.add('is-active');

      const name = card.getAttribute('data-evo-name') || 'Vaporeon';
      const title = card.getAttribute('data-evo-title') || '';
      const type = card.getAttribute('data-evo-type') || '';
      const icon = card.getAttribute('data-evo-icon') || '💧';
      const accent = card.getAttribute('data-evo-accent') || '#38bdf8';
      const quote = card.getAttribute('data-evo-quote') || '';
      const project = card.getAttribute('data-evo-project') || '';
      const stata = card.getAttribute('data-evo-stata') || '';
      const statb = card.getAttribute('data-evo-statb') || '';
      const stack = (card.getAttribute('data-evo-stack') || '').split(',').filter(Boolean);

      if (spotIcon) spotIcon.textContent = icon;
      if (spotType) {
        spotType.textContent = type;
        spotType.style.color = accent;
      }
      if (spotTitle) spotTitle.textContent = `${name} — ${title}`;
      if (spotQuote) spotQuote.textContent = quote;
      if (spotProject) spotProject.textContent = project;
      if (spotStatA) spotStatA.textContent = stata;
      if (spotStatB) spotStatB.textContent = statb;
      if (spotStack) {
        spotStack.innerHTML = stack
          .map((s) => `<span class="spotlight-pill" style="border-color:${accent}55">${s}</span>`)
          .join('');
      }
      if (stageEmoji) stageEmoji.textContent = icon;
      if (vibeVal) vibeVal.textContent = `${name} ${icon}`;
      if (vibeSub) vibeSub.textContent = title.split('&')[0].trim();

      addFriendship(5, `${name.toUpperCase()} RESONANCE ACTIVATED! ${icon}`, accent);
    }

    evoCards.forEach((card) => {
      card.addEventListener('click', () => activateEeveelution(card));
    });

    // Evolution Stone Bag Clicks
    document.querySelectorAll<HTMLButtonElement>('.evolution-stone-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const evoId = btn.getAttribute('data-stone-evo');
        const stoneName = btn.getAttribute('data-stone-name');
        const stoneColor = btn.getAttribute('data-stone-color') || '#fbbf24';

        const matchingCard = document.querySelector<HTMLButtonElement>(`.eeveelution-card[data-evo-id="${evoId}"]`);
        if (matchingCard) {
          sfx.heal();
          activateEeveelution(matchingCard);
          addFriendship(15, `EVOLUTION STONE CEREMONY: ${stoneName?.toUpperCase()}! ✨`, stoneColor);
        }
      });
    });

    // 5. Co-Op Pair-Programming Sandbox
    const pairTabs = document.querySelectorAll<HTMLButtonElement>('.pair-tab-btn');
    const pairTech = document.getElementById('pair-active-tech');
    const pairDesc = document.getElementById('pair-active-desc');
    const pairPre = document.getElementById('pair-terminal-pre');
    const pairStatus = document.getElementById('pair-status-msg');
    const btnRunPair = document.getElementById('btn-run-pair-sprint');

    pairTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        sfx.select();
        pairTabs.forEach((t) => t.classList.remove('is-active'));
        tab.classList.add('is-active');

        if (pairTech) pairTech.textContent = tab.getAttribute('data-pair-tech') || '';
        if (pairDesc) pairDesc.textContent = tab.getAttribute('data-pair-desc') || '';
        if (pairPre) {
          const codeEl = pairPre.querySelector('code');
          if (codeEl) codeEl.textContent = tab.getAttribute('data-pair-output') || '';
        }
        if (pairStatus) pairStatus.textContent = 'Sprint target selected. Ready to pair-program with Maya.';
      });
    });

    btnRunPair?.addEventListener('click', () => {
      sfx.confirm();
      if (pairPre && pairStatus) {
        pairStatus.textContent = '⚡ Maya & Zulfan are pair-programming live in the terminal...';
        const activeTab = document.querySelector<HTMLButtonElement>('.pair-tab-btn.is-active');
        const finalOutput = activeTab?.getAttribute('data-pair-output') || 'Compile success.';

        let tick = 0;
        const codeEl = pairPre.querySelector('code');
        if (codeEl) codeEl.textContent = 'Compiling collaborative module...\nRunning deterministic unit assertions...';

        const timer = setInterval(() => {
          tick++;
          if (tick >= 3) {
            clearInterval(timer);
            sfx.heal();
            if (codeEl) codeEl.textContent = finalOutput;
            pairStatus.textContent = '✅ All assertions passed! Zero runtime regressions. +25 Friendship.';
            addFriendship(25, 'PAIR SPRINT DEPLOYED! 🤝⚡', '#38bdf8');
          }
        }, 350);
      }
    });

    // 6. PR Review Ping-Pong Mini-Game (8 Scenarios)
    const roundEl = document.getElementById('pr-round-num');
    const streakEl = document.getElementById('pr-streak-num');
    const scoreEl = document.getElementById('pr-score-num');
    const tierBadge = document.getElementById('pr-tier-badge');
    const branchEl = document.getElementById('pr-card-branch');
    const authorEl = document.getElementById('pr-card-author');
    const diffLevelEl = document.getElementById('pr-card-diff-level');
    const titleEl = document.getElementById('pr-card-title');
    const diffEl = document.getElementById('pr-card-diff');
    const promptEl = document.getElementById('pr-card-prompt');
    const feedbackEl = document.getElementById('pr-game-feedback');

    function updateReviewerTier() {
      if (!tierBadge) return;
      if (prStreak >= 6) {
        tierBadge.textContent = 'Lead Architect 👑';
        tierBadge.className = 'pr-tier-badge pr-tier-badge--gold';
      } else if (prStreak >= 3) {
        tierBadge.textContent = 'Senior Reviewer 🛡️';
        tierBadge.className = 'pr-tier-badge pr-tier-badge--blue';
      } else {
        tierBadge.textContent = 'Junior Reviewer 🏅';
        tierBadge.className = 'pr-tier-badge';
      }
    }

    function renderPrCard() {
      const item = PR_CHALLENGES[prIndex % PR_CHALLENGES.length];
      if (roundEl) roundEl.textContent = `${(prIndex % PR_CHALLENGES.length) + 1} / ${PR_CHALLENGES.length}`;
      if (streakEl) streakEl.textContent = `${prStreak} 🔥`;
      if (scoreEl) scoreEl.textContent = `${prScore} PTS`;
      if (branchEl) branchEl.textContent = item.branch;
      if (diffLevelEl) diffLevelEl.textContent = `Level: ${item.diffLevel}`;
      if (authorEl) {
        authorEl.innerHTML = `<img src="/assets/maya.png" alt="Maya" class="pr-author-avatar-img" width="17" height="24" /> Author: ${escapeHtml(item.author)}`;
      }
      if (titleEl) titleEl.textContent = item.title;
      if (diffEl) {
        const codeEl = diffEl.querySelector('code') || diffEl;
        codeEl.textContent = item.diff;
      }
      if (promptEl) promptEl.textContent = item.prompt;
      updateReviewerTier();
    }

    document.querySelectorAll<HTMLButtonElement>('[data-pr-action]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const chosen = btn.getAttribute('data-pr-action');
        const current = PR_CHALLENGES[prIndex % PR_CHALLENGES.length];
        if (!chosen || !current) return;

        if (chosen === current.correct) {
          sfx.confirm();
          prStreak += 1;
          prScore += 100 + prStreak * 25;
          if (hudPrScore) hudPrScore.textContent = `${prStreak} Streak (${prScore} pts)`;
          if (feedbackEl) {
            feedbackEl.className = 'pr-game-feedback is-success';
            feedbackEl.textContent = `${current.explain} (+${100 + prStreak * 25} PTS)`;
          }
          addFriendship(10, `PR #${101 + (prIndex % PR_CHALLENGES.length)} REVIEWED! 🎯`, '#4ade80');
        } else {
          sfx.bump();
          prStreak = 0;
          if (feedbackEl) {
            feedbackEl.className = 'pr-game-feedback is-error';
            feedbackEl.textContent = `⚠️ Not quite! ${current.explain}`;
          }
        }

        prIndex = (prIndex + 1) % PR_CHALLENGES.length;
        renderPrCard();
      });
    });

    document.getElementById('btn-pr-restart')?.addEventListener('click', () => {
      sfx.select();
      prIndex = 0;
      prStreak = 0;
      prScore = 0;
      renderPrCard();
      if (feedbackEl) {
        feedbackEl.className = 'pr-game-feedback';
        feedbackEl.textContent = '🔄 New Sprint initialized! Review PR #101 above.';
      }
    });

    // 7. 6x Mentorship Guild Shelf Category Filter
    const mentorshipFilters = document.querySelectorAll<HTMLButtonElement>('.mentorship-filter-btn');
    const mentorshipCards = document.querySelectorAll<HTMLElement>('.mentorship-card');

    mentorshipFilters.forEach((btn) => {
      btn.addEventListener('click', () => {
        sfx.select();
        mentorshipFilters.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');

        const filter = btn.getAttribute('data-filter') || 'all';
        mentorshipCards.forEach((card) => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // 8. Neighbour Guestbook Corkboard (localStorage persisted with Likes & Filters)
    const STORAGE_KEY = 'town:neighbour-guestbook:v3';
    const corkboardWall = document.getElementById('corkboard-wall');
    const guestbookForm = document.getElementById('guestbook-form') as HTMLFormElement | null;

    function loadNotes(): GuestbookNote[] {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return [...DEFAULT_NOTES];
        const parsed = JSON.parse(raw);
        if (Array.isArray(parsed) && parsed.length > 0) return parsed;
      } catch {
        // ignore storage errors
      }
      return [...DEFAULT_NOTES];
    }

    function saveNotes(notes: GuestbookNote[]) {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(notes));
      } catch {
        // ignore storage errors
      }
    }

    function escapeHtml(str: string): string {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function renderNotes() {
      const allNotes = loadNotes();
      const filtered = activeGbFilter === 'all'
        ? allNotes
        : allNotes.filter((n) => n.badge === activeGbFilter);

      if (hudNotesCount) hudNotesCount.textContent = `${allNotes.length} Pinned`;
      if (!corkboardWall) return;

      corkboardWall.innerHTML = filtered
        .map((n) => {
          const isMaya = n.id === 'maya-1' || n.name.includes('Maya');
          let devEmoji = '🧑‍💻';
          if (n.badge.includes('Lab') || n.badge.includes('Mentor')) devEmoji = '🎓';
          else if (n.badge.includes('Architecture')) devEmoji = '⚡';
          else if (n.badge.includes('AI') || n.badge.includes('Wizard')) devEmoji = '🧠';
          else if (n.badge.includes('Coffee')) devEmoji = '☕';

          const avatarHtml = isMaya
            ? `<div class="sticky-note__avatar-frame" title="Neighbour Maya"><img src="/assets/maya.png" alt="Maya" class="sticky-note__avatar-img" width="22" height="28" /></div>`
            : `<div class="sticky-note__avatar-frame sticky-note__avatar-frame--generic" title="Guild Dev">${devEmoji}</div>`;

          // Clean up author title and role if separated by '·'
          const nameParts = n.name.split('·');
          const authorName = nameParts[0].trim();
          const authorSubtitle = nameParts.length > 1
            ? `${nameParts.slice(1).join('·').trim()}`
            : n.date;

          const stickerHtml = n.sticker ? `<span class="sticky-note__sticker" title="Reaction Sticker">${escapeHtml(n.sticker)}</span>` : '';
          const likesCount = n.likes ?? 0;

          return `
            <article class="sticky-note sticky-note--${escapeHtml(n.color)}">
              <div class="sticky-note__pin" aria-hidden="true">📌</div>
              <header class="sticky-note__header">
                <span class="sticky-note__badge-pill">${escapeHtml(n.badge)}</span>
                ${stickerHtml}
              </header>
              <p class="sticky-note__msg">"${escapeHtml(n.message)}"</p>
              <footer class="sticky-note__footer">
                <div class="sticky-note__author-group">
                  ${avatarHtml}
                  <div class="sticky-note__author-info">
                    <strong class="sticky-note__author">${escapeHtml(authorName)}</strong>
                    <span class="sticky-note__date">${escapeHtml(authorSubtitle)}</span>
                  </div>
                </div>
                <button type="button" class="sticky-note__like-btn" data-like-id="${n.id}" title="Give Kudos Heart">
                  <span class="sticky-note__heart" aria-hidden="true">❤️</span>
                  <span class="sticky-note__like-count">${likesCount}</span>
                </button>
              </footer>
            </article>
          `;
        })
        .join('');

      // Wire like buttons
      corkboardWall.querySelectorAll<HTMLButtonElement>('.sticky-note__like-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const noteId = btn.getAttribute('data-like-id');
          if (!noteId) return;
          sfx.heal();
          const notes = loadNotes();
          const target = notes.find((item) => item.id === noteId);
          if (target) {
            target.likes = (target.likes ?? 0) + 1;
            saveNotes(notes);
            renderNotes();
            addFriendship(2, 'KUDOS HEART PINNED! ❤️', '#f43f5e');
          }
        });
      });
    }

    // Guestbook category filter buttons
    document.querySelectorAll<HTMLButtonElement>('.gb-filter-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        sfx.select();
        document.querySelectorAll('.gb-filter-btn').forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        activeGbFilter = btn.getAttribute('data-gb-filter') || 'all';
        renderNotes();
      });
    });

    guestbookForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const nameInput = document.getElementById('gb-name') as HTMLInputElement | null;
      const badgeSelect = document.getElementById('gb-badge') as HTMLSelectElement | null;
      const colorSelect = document.getElementById('gb-color') as HTMLSelectElement | null;
      const msgInput = document.getElementById('gb-message') as HTMLTextAreaElement | null;
      const stickerInput = document.querySelector<HTMLInputElement>('input[name="gb-sticker"]:checked');

      const name = nameInput?.value.trim() || 'Fellow Neighbour';
      const badge = badgeSelect?.value || '🤝 Great Co-Op Partner';
      const color = (colorSelect?.value as GuestbookNote['color']) || 'amber';
      const sticker = stickerInput?.value || '⭐';
      const message = msgInput?.value.trim() || '';
      if (!message) return;

      const notes = loadNotes();
      notes.unshift({
        id: `note-${Date.now()}`,
        name,
        badge,
        color,
        sticker,
        likes: 1,
        message,
        date: 'Just pinned',
      });
      saveNotes(notes.slice(0, 16));
      renderNotes();
      if (msgInput) msgInput.value = '';
      sfx.heal();
      addFriendship(20, `NEW GUESTBOOK NOTE BY ${name.toUpperCase()}! 📌`, '#a855f7');
    });

    // 9. Hotkeys for Quick Exploration
    window.addEventListener('keydown', (e: KeyboardEvent) => {
      const tag = (e.target as HTMLElement)?.tagName?.toLowerCase();
      if (tag === 'input' || tag === 'textarea' || (e.target as HTMLElement)?.isContentEditable) {
        return;
      }

      if (e.key >= '1' && e.key <= '6') {
        const idx = parseInt(e.key, 10) - 1;
        const allEvos = document.querySelectorAll<HTMLButtonElement>('.eeveelution-card');
        if (allEvos[idx]) {
          e.preventDefault();
          activateEeveelution(allEvos[idx]);
        }
      } else if (e.code === 'Space') {
        e.preventDefault();
        document.getElementById('btn-pet-eevee')?.click();
      } else if (e.key === 't' || e.key === 'T') {
        e.preventDefault();
        const teaBtn = document.querySelector<HTMLButtonElement>('.tea-brew-btn');
        teaBtn?.click();
      } else if (e.key === 'p' || e.key === 'P') {
        e.preventDefault();
        const prSec = document.getElementById('ping-pong-game-section');
        prSec?.scrollIntoView({ behavior: 'smooth' });
      } else if (e.key === 'g' || e.key === 'G') {
        e.preventDefault();
        const gbSec = document.getElementById('guestbook-section');
        gbSec?.scrollIntoView({ behavior: 'smooth' });
      }
    });

    // Initialize state
    updateFriendshipTier();
    renderPrCard();
    renderNotes();
  }

  initNeighbourPage();
  document.addEventListener('astro:page-load', initNeighbourPage);
</script>

