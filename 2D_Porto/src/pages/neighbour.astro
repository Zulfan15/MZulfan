  /* 8. Live Guestbook Corkboard */
  .guestbook-filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1rem;
    padding: 0.5rem 0.75rem;
    background: rgba(0, 0, 0, 0.3);
    border-radius: 0.5rem;
  }

  .guestbook-filter-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    color: #fbbf24;
    font-weight: 700;
  }

  .guestbook-filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .gb-filter-btn {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fef08a;
    font-size: 0.7rem;
    padding: 0.2rem 0.5rem;
    border-radius: 0.35rem;
    cursor: pointer;
  }

  .gb-filter-btn.is-active {
    background: #fbbf24;
    color: #1c1917;
    border-color: #f59e0b;
    font-weight: 700;
  }

  .guestbook-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 900px) {
    .guestbook-layout {
      grid-template-columns: 320px 1fr;
    }
  }

  .guestbook-form {
    background: rgba(15, 8, 5, 0.8);
    border: 2px solid #b45309;
    border-radius: 0.85rem;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .guestbook-form__title {
    font-size: 0.95rem;
    color: #fffbeb;
    margin: 0;
  }

  .guestbook-form__sub {
    font-size: 0.75rem;
    color: #fde68a;
    line-height: 1.4;
    margin: 0;
  }

  .guestbook-label {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.74rem;
    color: #fbbf24;
    font-family: 'JetBrains Mono', monospace;
    width: 100%;
    box-sizing: border-box;
    min-width: 0;
  }

  .guestbook-input,
  .guestbook-select,
  .guestbook-textarea {
    display: block;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
    background: #020617;
    border: 1px solid rgba(251, 191, 36, 0.45);
    border-radius: 0.5rem;
    padding: 0.55rem 0.8rem;
    color: #fffbeb;
    font-size: 0.82rem;
    font-family: inherit;
    line-height: 1.45;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .guestbook-input:focus,
  .guestbook-select:focus,
  .guestbook-textarea:focus {
    outline: none;
    border-color: #f59e0b;
    box-shadow: 0 0 0 2px rgba(245, 158, 11, 0.3);
  }

  .guestbook-select {
    cursor: pointer;
    background-color: #0b1120;
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23fbbf24' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 0.85rem center;
    background-size: 1rem;
    padding-right: 2.5rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .guestbook-select option {
    background-color: #0f172a;
    color: #f8fafc;
    padding: 0.55rem 0.75rem;
    font-size: 0.82rem;
  }

  .guestbook-row {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    width: 100%;
    box-sizing: border-box;
  }

  .guestbook-stickers-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    width: 100%;
    box-sizing: border-box;
  }

  .sticker-radio {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.28rem 0.55rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(251, 191, 36, 0.25);
    border-radius: 0.4rem;
    font-size: 0.75rem;
    color: #fffbeb;
    cursor: pointer;
    user-select: none;
    transition: all 0.15s ease;
  }

  .sticker-radio:hover {
    background: rgba(251, 191, 36, 0.18);
    border-color: #fbbf24;
  }

  .sticker-radio input[type="radio"] {
    accent-color: #f59e0b;
    margin: 0;
  }

  .guestbook-submit-btn {
    background: linear-gradient(135deg, #f59e0b, #d97706);
    border: 1px solid #fbbf24;
    color: #1c1917;
    font-size: 0.8rem;
    font-weight: 800;
    padding: 0.55rem 0.85rem;
    border-radius: 0.5rem;
    cursor: pointer;
    margin-top: 0.35rem;
    transition: all 0.15s ease;
  }

  .guestbook-submit-btn:hover {
    background: #fde047;
    transform: translateY(-1px);
  }

  .corkboard-wall {
    background: #5c2807 url('data:image/svg+xml;utf8,<svg width="24" height="24" xmlns="http://www.w3.org/2000/svg"><rect width="24" height="24" fill="%235c2807"/><circle cx="3" cy="3" r="1.5" fill="%23431c05" opacity="0.45"/><circle cx="15" cy="15" r="1.5" fill="%2378350f" opacity="0.3"/></svg>');
    border: 3px solid #3b1804;
    border-radius: 0.85rem;
    padding: 1.4rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
    gap: 1.25rem;
    align-content: flex-start;
    box-shadow: inset 0 0 28px rgba(0, 0, 0, 0.7);
  }

  .sticky-note {
    position: relative;
    padding: 1.15rem 1.1rem 0.95rem;
    border-radius: 6px;
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.35), 0 2px 4px rgba(0, 0, 0, 0.15);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 175px;
    transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.22s ease;
    box-sizing: border-box;
    word-break: break-word;
    border: 1px solid rgba(0, 0, 0, 0.08);
  }

  /* Playful subtle post-it note tilts */
  .sticky-note:nth-child(4n + 1) {
    transform: rotate(-1deg);
  }
  .sticky-note:nth-child(4n + 2) {
    transform: rotate(1.2deg);
  }
  .sticky-note:nth-child(4n + 3) {
    transform: rotate(-0.8deg);
  }
  .sticky-note:nth-child(4n + 4) {
    transform: rotate(0.8deg);
  }

  .sticky-note:hover {
    transform: rotate(0deg) translateY(-4px) scale(1.02);
    box-shadow: 0 16px 28px rgba(0, 0, 0, 0.4), 0 4px 8px rgba(0, 0, 0, 0.2);
    z-index: 5;
  }

  /* Dog-ear fold on bottom right */
  .sticky-note::after {
    content: '';
    position: absolute;
    bottom: 0;
    right: 0;
    width: 14px;
    height: 14px;
    background: linear-gradient(135deg, transparent 50%, rgba(0, 0, 0, 0.14) 50%);
    pointer-events: none;
    border-bottom-right-radius: 6px;
  }

  .sticky-note--amber {
    background: linear-gradient(175deg, #fef08a 0%, #fde047 100%);
    color: #3f1d0b;
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.35), inset 0 4px 6px -4px rgba(234, 179, 8, 0.8);
  }

  .sticky-note--sakura {
    background: linear-gradient(175deg, #fce7f3 0%, #fbcfe8 100%);
    color: #4a0429;
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.35), inset 0 4px 6px -4px rgba(244, 114, 182, 0.8);
  }

  .sticky-note--mint {
    background: linear-gradient(175deg, #dcfce7 0%, #bbf7d0 100%);
    color: #06371c;
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.35), inset 0 4px 6px -4px rgba(74, 222, 128, 0.8);
  }

  .sticky-note--sky {
    background: linear-gradient(175deg, #e0f2fe 0%, #bae6fd 100%);
    color: #082f49;
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.35), inset 0 4px 6px -4px rgba(56, 189, 248, 0.8);
  }

  .sticky-note__pin {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 1.25rem;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.45));
    pointer-events: none;
    z-index: 2;
  }

  .sticky-note__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.55rem;
    min-width: 0;
  }

  .sticky-note__badge-pill {
