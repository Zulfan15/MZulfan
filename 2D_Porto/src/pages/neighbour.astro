---

<TownLayout
  title={`Neighbour's House — Fellow Dev Cottage & Guild | ${profile.person.name}`}
  description="Step inside Neighbour Maya's cozy developer cottage! Greet Eevee, match your Eeveelution tech vibe, play PR Review Ping-Pong, explore Zulfan's 6x Lab Mentorship chronicles, and sign the Neighbour Guestbook."
  place="neighbour"
>
  <div class="neighbour-page">
    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- 1. COZY COTTAGE HERO & LIVE FRIENDSHIP LEVEL HUD            -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <section class="cottage-hero">
      <div class="cottage-hero__glow" aria-hidden="true"></div>
      <div class="cottage-hero__top">
        <div class="cottage-hero__badge-row">
          <span class="cottage-pill cottage-pill--warm">🏡 NEIGHBOUR'S COTTAGE · PLOT #25</span>
          <span class="cottage-pill cottage-pill--eevee">🦊 EEVEE &amp; MAYA'S DEV GUILD</span>
          <span class="cottage-pill cottage-pill--rank" id="hud-friendship-rank">🎖️ RANK: PAIR-PROGRAMMING DUO</span>
        </div>
        <div class="cottage-hero__profile-row">
          <div class="cottage-hero__avatar-frame" title="Neighbour Maya (Dawn) · Fellow Developer">
            <img
              src="/assets/maya.png"
              alt="Neighbour Maya (Dawn)"
              class="cottage-hero__avatar-sprite"
              width="68"
              height="96"
            />
          </div>
          <div class="cottage-hero__text-col">
            <h1 id="panel-title" class="cottage-hero__title">
              Neighbour's House &amp; Fellow Dev Guild
            </h1>
            <p class="cottage-hero__subtitle">
              Selamat datang di pondok hangat tetangga sebelah! Di sini <strong>Neighbour Maya</strong> dan <strong>Eevee</strong> berkumpul bersama <strong>{profile.person.name}</strong> untuk <em>pair-programming</em>, menyeduh teh herbal di depan perapian, melatih ketangkasan <em>code review</em>, dan merayakan kolaborasi komunitas developer.
            </p>
          </div>
        </div>
      </div>

      <!-- Live Cottage Telemetry & Friendship Bar -->
      <div class="cottage-stats-grid">
        <div class="cottage-stat-card" id="card-stat-friendship">
          <div class="cottage-stat-card__head">
            <span class="cottage-stat-card__icon">❤️</span>
            <span class="cottage-stat-card__label">FRIENDSHIP BOND</span>
          </div>
          <div class="cottage-stat-card__val" id="hud-friendship-val">88 / 100</div>
          <div class="cottage-progress">
            <div class="cottage-progress__fill" id="hud-friendship-bar" style="width: 88%"></div>
          </div>
          <span class="cottage-stat-card__sub" id="hud-friendship-sub">Tier 4 · Collaborative Ally</span>
        </div>

        <div class="cottage-stat-card" id="card-stat-vibe">
          <div class="cottage-stat-card__head">
            <span class="cottage-stat-card__icon">🦊</span>
            <span class="cottage-stat-card__label">ACTIVE VIBE</span>
          </div>
          <div class="cottage-stat-card__val" id="hud-vibe-val">Vaporeon 💧</div>
          <span class="cottage-stat-card__sub" id="hud-vibe-sub">Full-Stack &amp; Cloud</span>
        </div>

        <div class="cottage-stat-card" id="card-stat-pr">
          <div class="cottage-stat-card__head">
            <span class="cottage-stat-card__icon">🎮</span>
            <span class="cottage-stat-card__label">PR RALLY SCORE</span>
          </div>
          <div class="cottage-stat-card__val" id="hud-pr-score">0 Merged</div>
          <span class="cottage-stat-card__sub" id="hud-pr-sub">Zero Runtime Bugs</span>
        </div>

        <div class="cottage-stat-card" id="card-stat-notes">
          <div class="cottage-stat-card__head">
            <span class="cottage-stat-card__icon">📌</span>
            <span class="cottage-stat-card__label">CORKBOARD NOTES</span>
          </div>
          <div class="cottage-stat-card__val" id="hud-notes-count">4 Pinned</div>
          <span class="cottage-stat-card__sub">Peer Endorsements</span>
        </div>
      </div>

      <!-- Quick 2D Room Navigation & Tea Action -->
      <div class="cottage-nav-strip">
        <span class="cottage-nav-strip__label">🚶 WALK IN 2D COTTAGE:</span>
        <div class="cottage-nav-strip__btns">
          <button type="button" class="cottage-chip-btn" data-walk-prop="neighbour-maya">
            👋 Maya
          </button>
          <button type="button" class="cottage-chip-btn" data-walk-prop="eevee-companion">
            🦊 Eevee
          </button>
          <button type="button" class="cottage-chip-btn" data-walk-prop="fireplace-hearth">
            🍵 Hearth Tea
          </button>
          <button type="button" class="cottage-chip-btn" data-walk-prop="coop-table">
            🤝 Co-Op Desk
          </button>
          <button type="button" class="cottage-chip-btn" data-walk-prop="retro-console">
            🎮 PR Ping-Pong
          </button>
          <button type="button" class="cottage-chip-btn" data-walk-prop="mentorship-shelf">
            📚 6× Lab Shelf
          </button>
          <button type="button" class="cottage-chip-btn" data-walk-prop="guestbook-board">
            📌 Corkboard
          </button>
        </div>
      </div>

      <!-- Mart-Style Hotkeys Reference Strip -->
      <div class="cottage-hotkeys-strip">
        <span class="cottage-hotkeys-label">⌨️ COTTAGE HOTKEYS:</span>
        <div class="cottage-hotkeys-keys">
          <span><kbd class="kbd">1–6</kbd> Eeveelutions</span>
          <span>•</span>
          <span><kbd class="kbd">Space</kbd> Pet Eevee</span>
          <span>•</span>
          <span><kbd class="kbd">T</kbd> Brew Tea</span>
          <span>•</span>
          <span><kbd class="kbd">P</kbd> PR Review</span>
          <span>•</span>
          <span><kbd class="kbd">G</kbd> Guestbook</span>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- 2. FIRESIDE TEA CEREMONY & PRODUCTIVITY HERBAL BREWS        -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <section id="tea-ceremony-section" class="cottage-section">
      <div class="cottage-section__header">
        <div>
          <span class="cottage-eyebrow">🍵 FIRESIDE OOLONG &amp; HERBAL BREW</span>
          <h2 class="cottage-section__title">Hearthside Tea Ceremony &amp; Stamina Buffs</h2>
        </div>
        <button type="button" class="cottage-locate-btn" data-walk-prop="fireplace-hearth">
          📍 Walk to Fireplace Hearth
        </button>
      </div>

      <p class="cottage-section__lead">
        Di samping perapian bata yang hangat, Maya dan Zulfan selalu menyeduh teh segar untuk mengisi ulang energi para developer dan trainer. Pilih seduhan favorit Anda untuk mendapatkan <em>speed boost</em> di kanvas 2D kota:
      </p>

      <div class="tea-cards-grid">
        {teaBlends.map((tea) => (
          <article class="tea-card" data-tea-id={tea.id} style={`--tea-accent: ${tea.color};`}>
            <div class="tea-card__top">
              <span class="tea-card__icon">{tea.icon}</span>
              <span class="tea-card__badge">FRESH BREW</span>
            </div>
            <h3 class="tea-card__name">{tea.name}</h3>
            <p class="tea-card__flavor">{tea.flavor}</p>
            <div class="tea-card__buff">
              <strong>✨ Buff Effect:</strong> {tea.buff}
            </div>
            <button
              type="button"
              class="tea-brew-btn"
              data-brew-id={tea.id}
              data-brew-name={tea.name}
              data-brew-color={tea.color}
              data-brew-sparkle={tea.sparkle}
            >
              🍵 Seduh Secangkir (+10 ❤️)
            </button>
          </article>
        ))}
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- 3. EEVEE MASCOT & EVOLUTION STONE TECH VIBE CEREMONY        -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <section id="eevee-vibe-section" class="cottage-section">
      <div class="cottage-section__header">
        <div>
          <span class="cottage-eyebrow">🦊 COTTAGE MASCOT &amp; ADAPTIVE STACK</span>
          <h2 class="cottage-section__title">Eevee Companion &amp; Evolution Stone Matcher</h2>
        </div>
        <button type="button" class="cottage-locate-btn" data-walk-prop="eevee-companion">
          📍 Walk to Eevee
        </button>
      </div>

      <!-- Interactive Eevee Petting & Care Bar -->
      <div class="eevee-care-banner">
        <div class="eevee-care-banner__avatar">
          <span class="eevee-avatar-emoji" id="eevee-stage-emoji">🦊</span>
          <span class="eevee-heart-badge" id="eevee-heart-pop">💖</span>
        </div>
        <div class="eevee-care-banner__info">
          <div class="eevee-care-banner__title-row">
            <h3 id="eevee-status-title">Eevee is wagging its fluffy tail by the hearth!</h3>
            <span class="eevee-mood-pill" id="eevee-mood-pill">Mood: Super Happy ✨</span>
          </div>
          <p id="eevee-status-dialogue" class="eevee-care-banner__desc">
            "Eev-vee! 🦊✨" Seperti Eevee yang memiliki DNA adaptif untuk berevolusi sesuai kebutuhan tim, Zulfan mengadaptasi keahlian Full-Stack, Edge AI, CyberSec, hingga IoT sesuai kebutuhan proyek Anda.
          </p>
          <div class="eevee-care-actions">
            <button type="button" class="eevee-action-btn" id="btn-pet-eevee">
              🤚 Pet Eevee (+15 ❤️)
            </button>
            <button type="button" class="eevee-action-btn" id="btn-feed-pokepuff">
              🧁 Give Berry Puff (+20 ❤️)
            </button>
            <button type="button" class="eevee-action-btn" id="btn-play-eevee">
              🧶 Toss Yarn Ball (+15 ❤️)
            </button>
          </div>
        </div>
      </div>

      <!-- Evolution Stone Bag (Interactive Evolution Ceremony) -->
      <div class="evolution-stone-shelf">
        <div class="evolution-stone-shelf__head">
          <span class="evolution-stone-shelf__icon">💎</span>
          <div>
            <h4 class="evolution-stone-shelf__title">Evolution Stone Bag — Resonance Ceremony</h4>
            <p class="evolution-stone-shelf__sub">Klik salah satu batu evolusi untuk menyelaraskan gaya rekayasa perangkat lunak Zulfan!</p>
          </div>
        </div>
        <div class="evolution-stones-row">
          {eeveelutions.map((evo) => (
