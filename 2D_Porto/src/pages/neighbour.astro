  .cottage-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(135px, 1fr));
    gap: 0.65rem;
    margin-bottom: 1rem;
  }

  .cottage-stat-card {
    background: rgba(24, 13, 8, 0.72);
    border: 1px solid rgba(217, 119, 6, 0.45);
