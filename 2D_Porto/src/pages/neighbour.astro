  }

  .cottage-stat-card__val {
    font-family: 'Pixelify Sans', sans-serif;
    font-size: 1.05rem;
    font-weight: 700;
    color: #ffffff;
  }

  .cottage-stat-card__sub {
    display: block;
    font-size: 0.68rem;
    color: #d6d3d1;
    margin-top: 0.15rem;
  }

  .cottage-progress {
    height: 6px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    overflow: hidden;
    margin-top: 0.35rem;
  }

  .cottage-progress__fill {
    height: 100%;
    background: linear-gradient(90deg, #f59e0b, #ec4899);
    transition: width 0.35s ease;
  }

  .cottage-nav-strip {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding-top: 0.75rem;
    border-top: 1px dashed rgba(251, 191, 36, 0.3);
  }

  .cottage-nav-strip__label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    color: #fcd34d;
    font-weight: 600;
  }

