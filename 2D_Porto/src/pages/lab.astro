<script>
  let pendingOpen: string | null = null;

  function selectPoster(posterId: string) {
    const tabs = Array.from(document.querySelectorAll<HTMLElement>('[data-poster-for]'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-poster-panel]'));
    for (const t of tabs) {
      t.setAttribute('aria-pressed', String(t.dataset.posterFor === posterId));
    }
    for (const p of panels) {
      p.hidden = p.dataset.posterPanel !== posterId;
    }
  }

  function openLabDialog(name: string) {
    const dialog = document.querySelector<HTMLDialogElement>(`[data-lab-dialog="${name}"]`);
    if (!dialog) {
      pendingOpen = name;
      return;
    }
    if (dialog.open) return;
    dialog.showModal();
    if (name === 'posters') {
      const activeTab = dialog.querySelector<HTMLElement>('[aria-pressed="true"]');
      activeTab?.scrollIntoView({ block: 'nearest', inline: 'center' });
    }
  }

  // Listen for town events from 2D Interior Engine
  document.addEventListener('town:lab-posters', () => openLabDialog('posters'));
  document.addEventListener('town:lab-whiteboard', () => openLabDialog('whiteboard'));
  document.addEventListener('town:lab-bench', () => openLabDialog('bench'));

  function setupLab() {
    // Bind Close Buttons & Backdrop Clicks for all Dialogs
    for (const dialog of document.querySelectorAll<HTMLDialogElement>('[data-lab-dialog]')) {
      const closeBtn = dialog.querySelector<HTMLButtonElement>('[data-mc-close]');
      closeBtn?.addEventListener('click', () => dialog.close());

      dialog.addEventListener('close', () => {
        document.dispatchEvent(new CustomEvent('town:focus'));
      });

      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
      });
    }

    // Bind Open Fastlane & Read Poster Buttons
    for (const btn of document.querySelectorAll<HTMLElement>('[data-open]')) {
      btn.addEventListener('click', () => {
        if (btn.dataset.poster) selectPoster(btn.dataset.poster);
        const target = btn.dataset.open;
        if (target) openLabDialog(target);
      });
    }

    // Poster Tab Switcher
    for (const tab of document.querySelectorAll<HTMLElement>('[data-poster-for]')) {
      tab.addEventListener('click', () => {
        if (tab.dataset.posterFor) selectPoster(tab.dataset.posterFor);
      });
    }

    // Bench Links to Posters
    for (const link of document.querySelectorAll<HTMLElement>('[data-poster-link]')) {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const benchDialog = document.querySelector<HTMLDialogElement>('[data-lab-dialog="bench"]');
        benchDialog?.close();
        const posterId = link.dataset.posterLink;
        if (posterId) {
          selectPoster(posterId);
          openLabDialog('posters');
        }
      });
    }

    // URL Hash deep-linking (e.g. #p-aeroscan)
    const hash = decodeURIComponent(window.location.hash.slice(1));
    if (hash && document.querySelector(`[data-poster-panel="${CSS.escape(hash)}"]`)) {
      selectPoster(hash);
      pendingOpen = 'posters';
    }

    if (pendingOpen) {
      const name = pendingOpen;
      pendingOpen = null;
      openLabDialog(name);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupLab);
  } else {
    setupLab();
  }
  document.addEventListener('astro:page-load', setupLab);
</script>
