            </div>
            <button type="button" class="btn btn-sm btn-paper font-pixel text-[10px] pm-bundle-btn" data-bundle-id={b.id}>
              🎁 Pack This Bundle
            </button>
          </article>
        ))}
      </div>
    </section>

    <!-- ═══════════════ Project Inquiry Bag ═══════════════ -->
