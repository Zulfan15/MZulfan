              </span>

              <div class="flex items-center gap-1.5 flex-wrap justify-end">
                {item.category === 'services' && (
                  <button type="button" class="btn btn-sm btn-ball pm-bag-toggle text-[10px] font-pixel" data-item-id={item.id} aria-pressed="false">
                    ➕ Add to Brief
