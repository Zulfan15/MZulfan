---
import TownLayout from '../layouts/TownLayout.astro';
import WhereTo from '../components/WhereTo.astro';
import TmReaderModal from '../components/TmReaderModal.astro';
import { profile } from '../lib/profile';

const githubUrl = profile.socials.find((s) => s.label === 'GitHub')?.url || 'https://github.com/Zulfan15';
const linkedinUrl = profile.socials.find((s) => s.label === 'LinkedIn')?.url || 'https://www.linkedin.com/in/muhammad-zulfan-anggadhiputra';
const emailUrl = `mailto:${profile.person.email}`;
const cvUrl = profile.person.cv || '/cv/CV_Zulfan.pdf';

type Category = 'services' | 'tms' | 'potions' | 'key';

interface MartItem {
  id: string;
  category: Category;
  icon: string;
  badge: string;
  title: string;
  subtitle: string;
  desc: string;
  tags: string[];
  /** Playful in-game scope indicator (₽). null = not purchasable. */
  price: number | null;
  unit?: 'sprint' | 'project' | 'session';
  featured: number;
  iconBox: string;
  badgeClass: string;
  subtitleClass: string;
  tmId?: string;
  potion?: 'coffee' | 'ether';
  link?: { href: string; label: string; external?: boolean };
  cv?: boolean;
}

const items: MartItem[] = [
  {
    id: 'srv-ai',
    category: 'services',
    icon: '🦅',
    badge: 'AI / ML SERVICE',
    title: 'Edge AI & Computer Vision',
    subtitle: 'AeroScan YOLOv11 + TensorRT',
    desc: 'Ultra-fast object detection and tracking optimized for edge computing (~1.8 ms/frame). Custom dataset annotation, model pruning, and FP16/INT8 TensorRT engine build.',
    tags: ['YOLOv11', 'TensorRT', 'PyTorch', 'OpenCV', 'CUDA'],
    price: 1500,
    unit: 'sprint',
    featured: 1,
    iconBox: 'bg-blue-100 border-blue-300',
    badgeClass: 'bg-blue-600 border-blue-800',
    subtitleClass: 'text-blue-700',
  },
  {
    id: 'srv-web',
    category: 'services',
    icon: '🌐',
    badge: 'FULL-STACK WEB',
    title: 'Cloud-Native Web Systems',
    subtitle: 'FoodLink & Modern Web Apps',
    desc: 'Scalable web architectures with clean domain design, spatial PostGIS queries, real-time event streaming via Kafka & Redis, and automated containerized CI/CD.',
    tags: ['Laravel 12', 'TypeScript', 'Astro', 'PostGIS', 'Redis', 'Kafka'],
    price: 1200,
    unit: 'sprint',
    featured: 2,
    iconBox: 'bg-emerald-100 border-emerald-300',
    badgeClass: 'bg-emerald-600 border-emerald-800',
    subtitleClass: 'text-emerald-700',
  },
  {
    id: 'srv-iot',
    category: 'services',
    icon: '🤖',
    badge: 'EMBEDDED / IOT',
    title: 'IoT & Robotics Integration',
    subtitle: 'ITENAS Robotics Coordinator',
    desc: 'Hardware microcontroller prototyping, sensor fusion, MQTT telemetry, ROS robotics control, and end-to-end device-to-dashboard communication pipelines.',
    tags: ['ESP32', 'STM32', 'ROS', 'MQTT', 'C++ / MicroPython'],
    price: 1000,
    unit: 'project',
    featured: 3,
    iconBox: 'bg-purple-100 border-purple-300',
    badgeClass: 'bg-purple-600 border-purple-800',
    subtitleClass: 'text-purple-700',
  },
  {
    id: 'srv-advisory',
    category: 'services',
    icon: '🧠',
    badge: 'ADVISORY & AUDIT',
    title: 'System Architecture Advisory',
    subtitle: 'Code Review & Security Audit',
    desc: 'Comprehensive architectural audits, database indexing optimization, HCIA-certified network security review, Docker orchestration, and performance tuning.',
    tags: ['Docker', 'HCIA-Security', 'MySQL', 'PostgreSQL', 'Linux'],
    price: 800,
    unit: 'session',
    featured: 4,
    iconBox: 'bg-amber-100 border-amber-300',
    badgeClass: 'bg-amber-600 border-amber-800',
    subtitleClass: 'text-amber-800',
  },
  {
    id: 'tm-01',
    category: 'tms',
    icon: '💿',
    badge: 'TM 01 · ML',
    title: 'TM 01: PyTorch & Deep Learning',
    subtitle: 'Model Architecture & Training',
    desc: 'Deep convolutional neural networks, vision transformers, transfer learning workflows, and data augmentation pipelines.',
    tags: ['PyTorch', 'Torchvision', 'Weights & Biases'],
    price: 0,
    featured: 5,
    iconBox: 'bg-orange-100 border-orange-300',
    badgeClass: 'bg-orange-600 border-orange-800',
    subtitleClass: 'text-orange-700',
    tmId: 'tm-01',
    link: { href: '/lab', label: '🔬 Lab R&D' },
  },
  {
    id: 'tm-02',
    category: 'tms',
    icon: '💿',
    badge: 'TM 02 · FRONTEND',
    title: 'TM 02: TypeScript & Astro Islands',
    subtitle: 'Zero-JS Runtime & Canvas 2D',
    desc: 'Type-safe full-stack web development with component islands, HTML5 Canvas game engines, and pixel-perfect responsive layouts.',
    tags: ['TypeScript 5', 'Astro 7', 'HTML5 Canvas'],
    price: 0,
    featured: 6,
    iconBox: 'bg-cyan-100 border-cyan-300',
    badgeClass: 'bg-cyan-600 border-cyan-800',
    subtitleClass: 'text-cyan-700',
    tmId: 'tm-02',
    link: { href: githubUrl, label: '💻 GitHub', external: true },
  },
  {
    id: 'tm-03',
    category: 'tms',
    icon: '💿',
    badge: 'TM 03 · BACKEND',
    title: 'TM 03: Laravel 12 & Microservices',
    subtitle: 'Event-Driven Architecture',
    desc: 'Enterprise PHP/Laravel with PostGIS spatial data, Kafka streaming, Redis cache invalidation, and automated Pest unit tests.',
    tags: ['Laravel 12', 'Kafka', 'PostGIS', 'Pest PHP'],
    price: 0,
    featured: 7,
    iconBox: 'bg-red-100 border-red-300',
    badgeClass: 'bg-red-600 border-red-800',
    subtitleClass: 'text-red-700',
    tmId: 'tm-03',
    link: { href: '/dev', label: '🚀 Dev Center' },
  },
  {
    id: 'tm-04',
    category: 'tms',
    icon: '💿',
    badge: 'TM 04 · GPU / HPC',
    title: 'TM 04: TensorRT & CUDA Engines',
    subtitle: 'High-Throughput Inference',
    desc: 'Low-level GPU acceleration, FP16 quantization calibration, multi-stream parallel inference, and memory bandwidth optimization.',
    tags: ['NVIDIA TensorRT', 'CUDA 12', 'ONNX Runtime'],
    price: 0,
    featured: 8,
    iconBox: 'bg-emerald-100 border-emerald-300',
    badgeClass: 'bg-emerald-600 border-emerald-800',
    subtitleClass: 'text-emerald-700',
    tmId: 'tm-04',
    link: { href: '/lab', label: '🔬 Model Specs' },
  },
  {
    id: 'potion-espresso',
    category: 'potions',
    icon: '☕',
    badge: 'POTION · FOCUS',
    title: 'Bandung Specialty Espresso',
    subtitle: 'Developer Caffeine Fuel',
    desc: 'Single-origin West Java Arabica roast. Cures developer fatigue and grants a real +50% walking-speed boost to your trainer in the 2D mart for a short while.',
    tags: ['+50% Speed', '+100% Focus', '0 Syntax Errors'],
    price: 50,
    featured: 9,
    iconBox: 'bg-amber-100 border-amber-300',
    badgeClass: 'bg-amber-800 border-amber-950',
    subtitleClass: 'text-amber-900',
    potion: 'coffee',
  },
  {
    id: 'potion-ether',
    category: 'potions',
    icon: '🧪',
    badge: 'POTION · REFACTOR',
    title: 'Clean Architecture Max Ether',
    subtitle: 'Technical Debt Cleanser',
    desc: 'Purges spaghetti code, restores SOLID design principles, and increases automated test coverage metrics above 95%.',
    tags: ['SOLID Principles', '95% Test Coverage'],
    price: 100,
    featured: 10,
    iconBox: 'bg-teal-100 border-teal-300',
    badgeClass: 'bg-teal-700 border-teal-900',
    subtitleClass: 'text-teal-800',
    potion: 'ether',
  },
  {
    id: 'key-cv',
    category: 'key',
    icon: '📄',
    badge: 'KEY ITEM · RESUME',
    title: "Zulfan's Official CV (PDF)",
    subtitle: 'Curriculum Vitae Document',
    desc: 'Complete professional curriculum vitae featuring technical projects, ITENAS lab assistant coordinator experience, honors, and verified contact links.',
    tags: ['PDF Format', 'Verified 2026', 'Full Experience'],
    price: null,
    featured: 11,
    iconBox: 'bg-blue-200 border-blue-400',
    badgeClass: 'bg-blue-700 border-blue-900',
    subtitleClass: 'text-blue-800',
    cv: true,
  },
  {
    id: 'key-degree',
    category: 'key',
    icon: '🎓',
    badge: 'KEY ITEM · DEGREE',
    title: 'Bachelor of Informatics',
    subtitle: 'ITENAS Bandung (GPA 3.49)',
    desc: 'Informatics Degree (S.Kom.), HCIA-Security Certified, IDEA FEST 3 Bronze Medalist, and 6-time computer science lab assistant.',
    tags: ['GPA 3.49', 'HCIA-Security', 'Idea Fest Bronze'],
    price: null,
    featured: 12,
    iconBox: 'bg-blue-200 border-blue-400',
    badgeClass: 'bg-blue-700 border-blue-900',
    subtitleClass: 'text-blue-800',
    link: { href: '/dev', label: '🎖️ Track Record' },
  },
];

const bundles = [
  {
    id: 'pack-vision',
    icon: '🦅',
    name: 'Edge Vision Starter Pack',
    blurb: 'Detection model + training know-how + GPU inference tuning, end to end.',
    items: ['srv-ai', 'tm-01', 'tm-04'],
    accent: 'border-blue-400 bg-blue-50',
  },
  {
    id: 'pack-fullstack',
    icon: '🌐',
    name: 'Full-Stack Launch Pack',
    blurb: 'Cloud-native platform with a typed Astro frontend and event-driven Laravel backend.',
    items: ['srv-web', 'tm-02', 'tm-03'],
    accent: 'border-emerald-400 bg-emerald-50',
  },
  {
    id: 'pack-secure',
    icon: '🛡️',
    name: 'Secure & Ship Pack',
    blurb: 'Build the product, then harden it with an HCIA-certified architecture audit.',
    items: ['srv-web', 'srv-advisory'],
    accent: 'border-amber-400 bg-amber-50',
  },
  {
    id: 'pack-robotics',
    icon: '🤖',
    name: 'Robotics Field Kit',
    blurb: 'Embedded telemetry pipelines paired with on-device computer vision.',
    items: ['srv-iot', 'srv-ai'],
    accent: 'border-purple-400 bg-purple-50',
  },
];

const stamps = [
  { id: 'bag', icon: '🎒', label: 'Pack a brief' },
  { id: 'tm', icon: '💿', label: 'Inspect a TM' },
  { id: 'potion', icon: '☕', label: 'Drink a potion' },
  { id: 'meowth', icon: '🪙', label: 'Chat with Meowth ×3' },
  { id: 'cv', icon: '📄', label: 'Grab the CV' },
  { id: 'brief', icon: '🧾', label: 'Checkout a brief' },
];

const categories: { id: 'all' | Category; label: string }[] = [
  { id: 'all', label: '🌟 All' },
  { id: 'services', label: '🎒 Services & Solutions' },
  { id: 'tms', label: '💿 Technical TMs' },
  { id: 'potions', label: '🧪 Dev Potions' },
  { id: 'key', label: '🔑 Key Items & CV' },
];
const countFor = (id: 'all' | Category) => (id === 'all' ? items.length : items.filter((i) => i.category === id).length);

const itemName = (id: string) => items.find((i) => i.id === id)?.title ?? id;

const formatPrice = (item: MartItem) => {
  if (item.price === null) return 'KEY ITEM';
  if (item.price === 0) return 'FREE · OPEN';
  return `₽ ${item.price.toLocaleString('en-US')}`;
};

const clientData = {
  email: profile.person.email,
  cvUrl,
  items: items.map(({ id, category, title, price, unit }) => ({ id, category, title, price, unit: unit ?? null })),
  bundles: bundles.map(({ id, name, items: ids }) => ({ id, name, items: ids })),
  stamps: stamps.map(({ id, label }) => ({ id, label })),
};
---

<TownLayout place="mart" title="Poké Mart · Tech Services & Inventory — Muhammad Zulfan">
  <script type="application/json" id="mart-data" set:html={JSON.stringify(clientData)} />

  <div class="space-y-8" id="mart-root">
    <!-- ═══════════════ Header Hero Banner ═══════════════ -->
    <header class="window p-4 md:p-5 bg-gradient-to-br from-cream via-paper to-cream border-2">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b-2 border-ink/15 pb-4 mb-4">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-xl bg-blue-500/10 border-2 border-blue-600 flex items-center justify-center text-2xl shadow-sm" aria-hidden="true">
            🏪
          </div>
          <div>
            <div class="eyebrow text-blue-600 flex items-center gap-1.5 font-bold">
              <span>TOWN COMMERCIAL DISTRICT</span>
              <span aria-hidden="true">•</span>
              <span>POKÉ MART STORE #01</span>
            </div>
            <h1 class="font-pixel text-base md:text-lg text-ink mt-0.5">
              Poké Mart · Tech Services &amp; Inventory
            </h1>
          </div>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <span id="pm-vip-badge" class="hidden chip bg-amber-300 text-amber-950 border-amber-600 font-mono text-[10px] font-bold">
            ⭐ VIP TRAINER
          </span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-blue-100 border border-blue-400 text-blue-900 font-mono text-[10px] font-bold">
            <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse" aria-hidden="true"></span>
            CLERK KEVIN ON DUTY
          </span>
          <button
            type="button"
            id="wallet-badge-btn"
            class="chip bg-amber-100 hover:bg-amber-200 text-amber-900 border-amber-400 font-mono text-xs px-2.5 py-1 font-bold cursor-pointer transition-colors"
            title="Open wallet ledger (G)"
            aria-haspopup="dialog"
          >
            💰 ₽ 9,999
          </button>
        </div>
      </div>

      <!-- Live store stats strip -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-2 mb-4" aria-label="Your Poké Mart session">
        <button type="button" class="pm-stat" data-jump="inquiry-bag-section" title="Jump to Project Inquiry Bag (Q)">
          <span class="pm-stat__label">🎒 Inquiry Bag</span>
          <span class="pm-stat__value" id="stat-bag-count">0 items</span>
          <span class="pm-stat__sub" id="stat-bag-total">Open discussion</span>
        </button>
        <button type="button" class="pm-stat" data-open-wallet title="Open wallet ledger (G)">
          <span class="pm-stat__label">💰 Wallet</span>
          <span class="pm-stat__value" id="stat-wallet">₽ 9,999</span>
          <span class="pm-stat__sub">Spend on potions</span>
        </button>
        <button type="button" class="pm-stat" data-jump="pm-stamp-card" title="Jump to Mart Stamp Card">
          <span class="pm-stat__label">🎫 Stamp Card</span>
          <span class="pm-stat__value" id="stat-stamps">0 / 6</span>
          <span class="pm-stat__sub" id="stat-stamps-sub">Collect all for VIP</span>
        </button>
        <div class="pm-stat" role="status">
          <span class="pm-stat__label">⚡ Active Buff</span>
          <span class="pm-stat__value" id="stat-buff">None</span>
          <span class="pm-stat__sub" id="stat-buff-sub">Drink a potion</span>
        </div>
      </div>

      <!-- Daily deal banner (filled client-side so the date is always current) -->
      <div id="pm-deal-banner" class="hidden mb-4 p-3 rounded-xl border-2 border-dashed border-ball/70 bg-red-50 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
        <div class="flex items-start gap-2.5">
          <span class="text-2xl" aria-hidden="true">🏷️</span>
          <div>
            <div class="font-pixel text-[10px] text-ball uppercase tracking-wide">Meowth's Daily Deal · <span id="pm-deal-date"></span></div>
            <p class="text-xs text-ink mt-0.5">
              <strong id="pm-deal-name">—</strong> is <strong class="text-ball">15% off</strong> today. Discount is applied automatically in your Inquiry Bag.
            </p>
          </div>
        </div>
        <button type="button" id="pm-deal-claim" class="btn btn-sm btn-primary text-[10px] font-pixel shrink-0">
          🏷️ Claim Deal
        </button>
      </div>

      <!-- Clerk Kevin & Meowth Dialogue Box -->
      <div class="p-3.5 rounded-lg bg-paper border border-ink/20 text-xs leading-relaxed text-ink-soft space-y-2.5">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-ink/10 pb-2">
          <p class="font-medium text-ink flex items-center gap-1.5">
            <span aria-hidden="true">👨‍💼</span>
            <strong>Clerk Kevin:</strong>
            <span class="text-[11px] font-mono text-blue-600 font-semibold">"Welcome to Zulfan's Poké Mart!"</span>
          </p>
          <div class="flex items-center gap-1.5">
            <button type="button" class="btn btn-sm btn-paper text-[10px] font-pixel btn-inspect-2d" data-prop="clerk" title="Walk to Clerk Kevin on the 2D canvas">
              📍 Kevin
            </button>
            <button type="button" class="btn btn-sm btn-paper text-[10px] font-pixel text-amber-700 font-bold border-amber-400 btn-inspect-2d" data-prop="meowth" title="Walk to Meowth on the 2D canvas">
              🪙 Meowth
            </button>
          </div>
        </div>
        <p>
          Looking to commission a high-speed Edge AI system? Need full-stack web engineering, custom IoT integrations, or want to pick up Zulfan's official credentials? Browse the catalog, pack services into your <strong>Project Inquiry Bag</strong>, then <strong>check out</strong> at the counter to get a ready-to-send project brief.
        </p>

        <!-- Meowth Mascot Voice Box -->
        <div class="p-3 rounded-xl bg-gradient-to-r from-amber-50 via-cream to-amber-100/90 border-2 border-amber-400/80 text-amber-950 text-xs shadow-xs">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
            <div class="flex items-start gap-2.5">
              <span class="text-2xl p-1 bg-amber-200 rounded-lg border border-amber-400 shadow-inner shrink-0" aria-hidden="true">🪙</span>
              <div>
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="chip bg-amber-800 text-paper border-amber-950 font-mono text-[9px] px-1.5 font-bold uppercase">CASHIER MASCOT</span>
                  <strong class="font-pixel text-[11px] text-amber-900">Meowth's Recruiter Intel</strong>
                  <span id="meowth-pat-counter" class="chip bg-amber-200 text-amber-900 font-mono text-[9px] px-1.5 border border-amber-400 font-bold hidden">
                    🪙 Luck x1
                  </span>
                </div>
                <p id="meowth-speech-bubble" class="font-sans text-xs italic text-amber-900 mt-1 transition-opacity" aria-live="polite">
                  "That's right! Zulfan's edge AI vision pipelines run at 120 FPS on Jetson hardware without breaking a sweat!"
                </p>
              </div>
            </div>
            <div class="flex items-center gap-1.5 shrink-0">
              <button type="button" id="btn-meowth-quote" class="btn btn-sm btn-paper text-[10px] font-pixel text-amber-900 border-amber-400 shadow-sm" title="Ask Meowth for another tip">
                💬 Another Quote
              </button>
              <button type="button" id="btn-toss-coin-2d" class="btn btn-sm btn-gold text-[10px] font-pixel shrink-0 shadow-sm" title="Play the cash-register animation on the 2D canvas">
                Pay Day FX ✨
              </button>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- ═══════════════ Quick Action Bar ═══════════════ -->
    <nav class="window p-2.5 md:p-3 bg-slate-900/90 border-2 border-blue-500/50 flex flex-wrap items-center justify-between gap-2.5 shadow-md text-white" aria-label="Walk to a spot in the 2D mart">
      <div class="flex items-center gap-2 text-xs font-mono text-blue-300 font-bold">
        <span class="text-base" aria-hidden="true">🚶</span>
        <span>WALK IN 2D MART:</span>
      </div>
      <div class="flex flex-wrap items-center gap-1.5" id="mart-quick-bar">
        <button type="button" class="mart-quick-btn btn btn-sm btn-paper font-pixel text-[10px]" data-quick="clerk">👨‍💼 Clerk Kevin</button>
        <button type="button" class="mart-quick-btn btn btn-sm btn-paper font-pixel text-[10px] text-amber-700 font-bold border-amber-400" data-quick="meowth">🪙 Meowth</button>
        <button type="button" class="mart-quick-btn btn btn-sm btn-paper font-pixel text-[10px]" data-quick="services-shelf" data-tab="services">🎒 Services</button>
        <button type="button" class="mart-quick-btn btn btn-sm btn-paper font-pixel text-[10px]" data-quick="tech-tms" data-tab="tms">💿 Tech TMs</button>
        <button type="button" class="mart-quick-btn btn btn-sm btn-paper font-pixel text-[10px]" data-quick="potions-shelf" data-tab="potions">🧪 Potions</button>
        <button type="button" class="mart-quick-btn btn btn-sm btn-paper font-pixel text-[10px]" data-quick="key-showcase" data-tab="key">🔑 Key Items</button>
        <button type="button" class="mart-quick-btn btn btn-sm btn-paper font-pixel text-[10px]" data-quick="drink-cooler">🥤 Drink Cooler</button>
      </div>
    </nav>

    <!-- Hotkeys reference (chosen to avoid global town hotkeys B / M / P / X …) -->
    <div class="flex flex-wrap items-center justify-between gap-2 px-3.5 py-2 rounded-xl bg-paper border-2 border-ink/15 text-[10px] font-mono text-ink-soft shadow-xs">
      <div class="flex items-center gap-2">
        <span class="text-sm" aria-hidden="true">⌨️</span>
        <span class="font-bold uppercase tracking-wider text-ink font-pixel text-[10px]">Mart Hotkeys:</span>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <span><kbd class="kbd">/</kbd> Search</span>
        <span class="text-ink/30" aria-hidden="true">•</span>
        <span><kbd class="kbd">G</kbd> Wallet</span>
        <span class="text-ink/30" aria-hidden="true">•</span>
        <span><kbd class="kbd">T</kbd> TM Reader</span>
        <span class="text-ink/30" aria-hidden="true">•</span>
        <span><kbd class="kbd">Q</kbd> Inquiry Bag</span>
        <span class="text-ink/30" aria-hidden="true">•</span>
        <span><kbd class="kbd">R</kbd> Checkout</span>
        <span class="text-ink/30" aria-hidden="true">•</span>
        <span><kbd class="kbd">Esc</kbd> Close</span>
      </div>
    </div>

    <!-- ═══════════════ Catalog ═══════════════ -->
    <section class="window p-4 md:p-5 bg-paper border-2 space-y-4" id="mart-catalog" aria-labelledby="mart-catalog-title">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3 border-b-2 border-ink/15 pb-4">
        <div>
          <h2 id="mart-catalog-title" class="font-pixel text-xs text-ink uppercase tracking-wide flex items-center gap-2">
            <span aria-hidden="true">📦</span>
            <span>Store Shelves &amp; Technical Inventory</span>
          </h2>
          <p class="font-sans text-[11px] text-ink-soft mt-0.5">
            Filter by department, search any tech, or sort by price. Click a tag to search for it.
          </p>
        </div>

        <div class="flex flex-wrap gap-1.5" role="tablist" aria-label="Department categories">
          {categories.map((c, i) => (
            <button
              type="button"
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls="mart-grid"
              class={`mart-tab-btn btn btn-sm font-pixel text-[10px] ${i === 0 ? 'btn-ball active' : 'btn-paper'}`}
