          <label class="block">
            <span class="text-[10px] text-blue-200 font-mono">Company / team</span>
            <input name="company" type="text" maxlength="80" autocomplete="organization" class="pm-input" placeholder="e.g. Silph Co. Engineering" />
          </label>
          <label class="block">
            <span class="text-[10px] text-blue-200 font-mono">Preferred start</span>
            <select name="timeline" class="pm-input">
              <option value="Flexible">Flexible</option>
              <option value="ASAP (within 2 weeks)">ASAP (within 2 weeks)</option>
              <option value="Within 1 month">Within 1 month</option>
              <option value="1–3 months">1–3 months</option>
            </select>
          </label>
          <label class="block">
            <span class="text-[10px] text-blue-200 font-mono">Short message</span>
