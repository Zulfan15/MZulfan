                      💿 Inspect
                    </button>
                    <button type="button" class="btn btn-sm btn-paper pm-bag-toggle text-[10px] font-pixel" data-item-id={item.id} aria-pressed="false" title="Add this TM to your brief">
                      ➕ Brief
                    </button>
                    {item.link && (
                      <a
                        href={item.link.href}
                        class="btn btn-sm btn-paper text-[10px] font-pixel"
                        {...(item.link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                      >
                        {item.link.label}
                      </a>
                    )}
                  </>
                )}

                {item.potion && (
                  <button
                    type="button"
                    id={item.potion === 'coffee' ? 'drink-coffee-btn' : 'drink-ether-btn'}
