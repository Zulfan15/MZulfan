            <span aria-hidden="true">🪙</span><span>Meowth's Pay Day (+₽ 1,000)</span>
          </button>
          <button type="button" id="btn-reset-wallet" class="btn btn-sm bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-600 font-mono text-xs px-3 py-2 w-full sm:w-auto">
            Reset to ₽ 9,999
          </button>
        </div>
      </div>
    </div>
  </dialog>

  <!-- ═══════════════ Checkout Receipt Modal ═══════════════ -->
  <dialog id="receipt-modal" aria-labelledby="pm-receipt-title" class="backdrop:bg-slate-950/70 backdrop:backdrop-blur-sm">
    <div class="pm-receipt-wrap max-w-md w-[92vw]">
      <div class="pm-receipt">
        <div class="text-center">
          <div class="text-2xl" aria-hidden="true">🏪</div>
          <h3 id="pm-receipt-title" class="font-pixel text-xs text-ink mt-1">POKÉ MART · STORE #01</h3>
          <p class="font-mono text-[10px] text-ink-soft">Project Brief Receipt</p>
        </div>
        <pre id="receipt-body" class="pm-receipt__body"></pre>
        <div class="pm-receipt__barcode" aria-hidden="true"></div>
        <p class="text-center font-mono text-[10px] text-ink-soft">Thank you for shopping! — Kevin &amp; Meowth 🪙</p>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-2 mt-3">
        <button type="button" id="receipt-copy" class="btn btn-sm btn-paper font-pixel text-[10px]">📋 Copy</button>
        <button type="button" id="receipt-download" class="btn btn-sm btn-paper font-pixel text-[10px]">💾 Download .md</button>
        <a id="receipt-email" href={emailUrl} class="btn btn-sm btn-gold font-pixel text-[10px]">📨 Send by Email</a>
        <button type="button" id="receipt-close" class="btn btn-sm btn-paper font-pixel text-[10px]">✕ Close</button>
      </div>
    </div>
  </dialog>

  <!-- Toast region -->
  <div id="pm-toast-region" class="pm-toast-region" aria-live="polite" aria-atomic="false"></div>

  <TmReaderModal />
</TownLayout>

<script>
  import { sfx } from '../game/sfx';

  type Category = 'services' | 'tms' | 'potions' | 'key';
  type Unit = 'sprint' | 'project' | 'session' | null;
  type CollabTrack = 'fulltime' | 'sprint' | 'advisory';

  interface CatalogItem {
    id: string;
    category: Category;
    title: string;
    price: number | null;
    unit: Unit;
  }
  interface Bundle {
    id: string;
    name: string;
    items: string[];
  }
  interface MartData {
    email: string;
    cvUrl: string;
    items: CatalogItem[];
    bundles: Bundle[];
    stamps: { id: string; label: string }[];
  }
  interface BagItem {
    id: string;
    name: string;
    price: number | null;
    unit: Unit;
    qty: number;
  }
  interface LedgerEntry {
    t: number;
    label: string;
    delta: number;
  }

  // ── Storage keys ──────────────────────────────────────────────
  const BAG_KEY = 'mart_inquiry_bag_v2';
  const LEGACY_BAG_KEY = 'mart_inquiry_bag';
  const TRACK_KEY = 'mart_collab_track';
  const DETAILS_KEY = 'mart_brief_details';
  const WALLET_KEY = 'pokemart_wallet_balance';
  const LEDGER_KEY = 'pokemart_wallet_ledger';
  const STAMPS_KEY = 'pokemart_stamps';
  const VIP_KEY = 'pokemart_vip_claimed';
  const DEFAULT_BALANCE = 9999;
  const MAX_QTY = 6;
  const DEAL_RATE = 0.15;
  const BUNDLE_RATE = 0.1;

  const TRACK_LABELS: Record<CollabTrack, string> = {
    fulltime: 'Full-Time Role',
    sprint: 'Fixed MVP Sprint',
    advisory: 'Security & Architecture Audit',
  };
  const TRACK_DESCRIPTIONS: Record<CollabTrack, string> = {
    fulltime: 'Track: Full-Time / Hybrid Role (Software & AI Engineer)',
    sprint: 'Track: Fixed MVP Sprint (2–4 Week Scoped Build)',
    advisory: 'Track: Security & Architecture Audit (HCIA Security)',
  };
  /** Rough calendar weeks per unit — [min, max]. */
  const UNIT_WEEKS: Record<Exclude<Unit, null>, [number, number]> = {
    sprint: [2, 4],
    project: [4, 8],
    session: [0.5, 1],
  };

  const MEOWTH_QUOTES = [
    "That's right! Zulfan's edge AI vision pipelines run at 120 FPS on Jetson hardware without breaking a sweat!",
    'Recruiters who hire Zulfan get double sprint velocity and 100% clean git commits!',
    'Looking for a verified full-stack engineer? Zulfan graduated from ITENAS with a 3.49 GPA and served as a lab assistant 6 times!',
    'Psst! All Technical TMs and the official CV here are 100% free! Keep your Poké-Dollars for coffee!',
    'IDEA FEST 3 Bronze Medalist and HCIA-Security Certified... this engineer is ready for high-impact production roles!',
    'Complete a Starter Pack in your bag and I knock 10% off. Meowth is generous today… nya!',
    "Kevin says: fill in your project details before checkout — Zulfan loves a clear brief!",
  ];

  // ── Small utilities ───────────────────────────────────────────
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const fmt = (n: number) => `₽ ${Math.round(n).toLocaleString('en-US')}`;
  const escapeHtml = (s: string) =>
    s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  const readJson = <T,>(storage: Storage, key: string, fallback: T): T => {
    try {
      const raw = storage.getItem(key);
      return raw ? (JSON.parse(raw) as T) : fallback;
    } catch {
      return fallback;
    }
  };
  const writeJson = (storage: Storage, key: string, value: unknown) => {
    try {
      storage.setItem(key, JSON.stringify(value));
    } catch {
      /* storage unavailable */
    }
  };
  const cashFx = (text: string) => window.dispatchEvent(new CustomEvent('town:mart-cash-anim', { detail: { text } }));
  const reduceMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const scrollToId = (id: string) =>
    $(id)?.scrollIntoView({ behavior: reduceMotion() ? 'auto' : 'smooth', block: 'start' });

  function toast(message: string, tone: 'info' | 'success' | 'warn' = 'info', action?: { label: string; onClick: () => void }) {
    const region = $('pm-toast-region');
    if (!region) return;
    const el = document.createElement('div');
    el.className = `pm-toast pm-toast--${tone}`;
    el.setAttribute('role', tone === 'warn' ? 'alert' : 'status');
    const text = document.createElement('span');
    text.textContent = message;
    el.appendChild(text);
    if (action) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'pm-toast__action';
      btn.textContent = action.label;
      btn.addEventListener('click', () => {
        action.onClick();
        el.remove();
      });
      el.appendChild(btn);
    }
    region.appendChild(el);
    while (region.children.length > 3) region.firstElementChild?.remove();
    window.setTimeout(() => {
      el.classList.add('is-leaving');
      window.setTimeout(() => el.remove(), 250);
    }, 3200);
  }

  // Window-level listeners must only be registered once, even if init runs again.
  let windowListenersBound = false;

  function initMartPage() {
    const root = $('mart-root');
    const dataEl = $('mart-data');
    if (!root || !dataEl || root.dataset.pmInit === '1') return;
    root.dataset.pmInit = '1';

    let data: MartData;
    try {
      data = JSON.parse(dataEl.textContent || '{}') as MartData;
    } catch {
      return;
    }
    const catalog = new Map(data.items.map((i) => [i.id, i]));

    // ═════════ Daily deal (date-seeded, priced services only) ═════════
    const dealPool = data.items.filter((i) => i.category === 'services' && (i.price ?? 0) > 0);
    const dayIndex = Math.floor(Date.now() / 86_400_000);
    const dealItem = dealPool.length ? dealPool[dayIndex % dealPool.length] : null;

    if (dealItem) {
      const banner = $('pm-deal-banner');
      const nameEl = $('pm-deal-name');
      const dateEl = $('pm-deal-date');
      if (nameEl) nameEl.textContent = dealItem.title;
      if (dateEl) dateEl.textContent = new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
      banner?.classList.remove('hidden');
      document.querySelector(`.mart-card[data-id="${dealItem.id}"] .pm-deal-ribbon`)?.classList.remove('hidden');
    }

    // ═════════ Bag state ═════════
    let bag: BagItem[] = readJson<BagItem[]>(sessionStorage, BAG_KEY, []);
    // Migrate the legacy bag format (duplicate rows + string prices) once.
    if (!bag.length) {
      const legacy = readJson<{ id: string; name: string; price: string }[]>(sessionStorage, LEGACY_BAG_KEY, []);
      for (const old of legacy) addToBag(old.id, old.name, false);
      try {
        sessionStorage.removeItem(LEGACY_BAG_KEY);
      } catch {
        /* ignore */
      }
    }
    bag = bag.filter((b) => b && typeof b.id === 'string');

    let currentTrack: CollabTrack = (() => {
      try {
        const t = sessionStorage.getItem(TRACK_KEY);
        return t === 'sprint' || t === 'advisory' || t === 'fulltime' ? t : 'fulltime';
      } catch {
        return 'fulltime';
      }
    })();

    function addToBag(id: string, fallbackName?: string, announce = true): boolean {
      if (bag.some((b) => b.id === id)) return false;
      const meta = catalog.get(id);
      bag.push({
        id,
        name: meta?.title ?? fallbackName ?? id,
        price: meta ? meta.price : 0,
        unit: meta ? meta.unit : null,
        qty: 1,
      });
      if (announce) {
        sfx.select();
        cashFx('CHA-CHING! +1 BRIEF');
        stamp('bag');
      }
      return true;
    }

    function removeFromBag(id: string) {
      bag = bag.filter((b) => b.id !== id);
    }

    function lineBase(b: BagItem) {
      return (b.price ?? 0) * b.qty;
    }

    function computeTotals() {
      const subtotal = bag.reduce((s, b) => s + lineBase(b), 0);
      const dealLine = dealItem ? bag.find((b) => b.id === dealItem.id) : undefined;
      const dealDiscount = dealLine ? lineBase(dealLine) * DEAL_RATE : 0;

      const bagIds = new Set(bag.map((b) => b.id));
      const completed = data.bundles.filter((bd) => bd.items.every((id) => bagIds.has(id)));
      const discountedIds = new Set(completed.flatMap((bd) => bd.items));
      let bundleDiscount = 0;
      for (const b of bag) {
        if (!discountedIds.has(b.id)) continue;
        const afterDeal = lineBase(b) * (dealItem && b.id === dealItem.id ? 1 - DEAL_RATE : 1);
        bundleDiscount += afterDeal * BUNDLE_RATE;
      }

      let minW = 0;
      let maxW = 0;
      for (const b of bag) {
        if (!b.unit) continue;
        const [lo, hi] = UNIT_WEEKS[b.unit];
        minW += lo * b.qty;
        maxW += hi * b.qty;
      }

      return {
        subtotal,
        dealDiscount,
        bundleDiscount,
        total: Math.max(0, subtotal - dealDiscount - bundleDiscount),
        completed,
        minW,
        maxW,
      };
    }

    function durationText(minW: number, maxW: number) {
      if (maxW <= 0) return '—';
      if (maxW < 1.5) return '≈ 1 week';
      return `≈ ${Math.max(1, Math.round(minW))}–${Math.round(maxW)} weeks`;
    }

    // ═════════ Project details form ═════════
    const form = $<HTMLFormElement>('pm-details-form');
    const details: Record<string, string> = readJson(sessionStorage, DETAILS_KEY, {});
    if (form) {
      for (const [k, v] of Object.entries(details)) {
        const field = form.elements.namedItem(k) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null;
        if (field && typeof v === 'string') field.value = v;
      }
      form.addEventListener('input', () => {
        const fd = new FormData(form);
        for (const [k, v] of fd.entries()) details[k] = String(v).trim();
        writeJson(sessionStorage, DETAILS_KEY, details);
        updateEmailLink();
      });
      form.addEventListener('submit', (e) => e.preventDefault());
    }

    // ═════════ Brief generation ═════════
    function briefLines(): { md: string; plain: string; subject: string } {
      const t = computeTotals();
      const track = TRACK_LABELS[currentTrack];
      const budget = t.total > 0 ? `${fmt(t.total)} (estimated)` : 'Free / Open Discussion';
      const who = [details.name, details.company].filter(Boolean).join(' · ');

      const itemLines = bag.length
        ? bag.map((b, i) => {
            const price = b.price === null ? 'Key item' : b.price === 0 ? 'Free' : `${fmt(b.price)}${b.unit ? ` / ${b.unit}` : ''}`;
            const qty = b.unit && b.qty > 1 ? ` × ${b.qty}` : '';
            return `${i + 1}. ${b.name}${qty} — ${price}`;
          })
        : [`No specific items — general inquiry for a ${track}.`];

      const md = [
        '# Muhammad Zulfan — Project Inquiry & Engineering Brief',
        '',
        `**Collaboration track:** ${TRACK_DESCRIPTIONS[currentTrack].replace('Track: ', '')}`,
        who ? `**From:** ${who}` : '',
        `**Preferred start:** ${details.timeline || 'Flexible'}`,
        `**Estimated scope budget:** ${budget}`,
        `**Estimated timeline:** ${durationText(t.minW, t.maxW)}`,
        t.completed.length ? `**Starter packs:** ${t.completed.map((c) => c.name).join(', ')}` : '',
        '',
        '## Selected services & items',
        ...itemLines,
        details.message ? `\n## Message\n${details.message}` : '',
        '',
        '---',
        `_Generated at Poké Mart — Muhammad Zulfan's 2D portfolio · CV: ${location.origin}${data.cvUrl}_`,
        '_₽ values are playful scope indicators; real rates are agreed per project._',
      ]
        .filter((l) => l !== '')
        .join('\n');

      const plain = [
        'Hi Muhammad Zulfan,',
        '',
        `I visited your Poké Mart and assembled this brief for a ${track}:`,
        '',
        who ? `• From: ${who}` : '',
        `• Preferred start: ${details.timeline || 'Flexible'}`,
        `• Estimated scope budget: ${budget}`,
        `• Estimated timeline: ${durationText(t.minW, t.maxW)}`,
        '• Selected services & items:',
        ...itemLines.map((l) => `   ${l}`),
        details.message ? `\nMessage:\n${details.message}` : '',
        '',
        'Could we schedule a call to discuss scope and timeline?',
        '',
        'Best regards,',
        details.name || '',
      ]
        .filter((l, i, arr) => !(l === '' && arr[i - 1] === ''))
        .join('\n');

      const subject = `[${track}] Portfolio Inquiry — Muhammad Zulfan${bag.length ? ` (${bag.length} item${bag.length > 1 ? 's' : ''})` : ''}`;
      return { md, plain, subject };
    }

    function mailtoHref() {
      const { plain, subject } = briefLines();
      return `mailto:${data.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(plain)}`;
    }

    function updateEmailLink() {
      const href = mailtoHref();
      const a = $<HTMLAnchorElement>('send-inquiry-email-btn');
      const b = $<HTMLAnchorElement>('receipt-email');
      if (a) a.href = href;
      if (b) b.href = href;
    }

    async function copyText(text: string): Promise<boolean> {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        // Fallback for insecure contexts / denied permissions
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        let ok = false;
        try {
          ok = document.execCommand('copy');
        } catch {
          ok = false;
        }
        ta.remove();
        return ok;
      }
    }

    function downloadBrief() {
      const { md } = briefLines();
      const blob = new Blob([md], { type: 'text/markdown;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `Zulfan_Project_Brief_${new Date().toISOString().slice(0, 10)}.md`;
      document.body.appendChild(a);
      a.click();
      a.remove();
      window.setTimeout(() => URL.revokeObjectURL(url), 1000);
      sfx.confirm();
      stamp('brief');
      toast('💾 Brief downloaded as Markdown.', 'success');
    }

    // ═════════ Rendering ═════════
    function renderBag() {
      const list = $('bag-items-list');
      const empty = $('empty-bag-message');
      const t = computeTotals();
      const count = bag.length;

      const badge = $('bag-count-badge');
      if (badge) badge.textContent = `${count} ${count === 1 ? 'Item' : 'Items'} Selected`;
      $('clear-bag-btn')?.classList.toggle('hidden', count === 0);
      empty?.classList.toggle('hidden', count > 0);

      if (list) {
        list.innerHTML = bag
          .map((b, i) => {
            const isDeal = dealItem?.id === b.id;
            const unitPrice = b.price === null ? 'KEY' : b.price === 0 ? 'FREE' : fmt(b.price);
            const stepper = b.unit
              ? `<div class="flex items-center gap-1" role="group" aria-label="Quantity for ${escapeHtml(b.name)}">
                   <button type="button" class="pm-qty" data-qty="-1" data-id="${escapeHtml(b.id)}" aria-label="Decrease" ${b.qty <= 1 ? 'disabled' : ''}>−</button>
                   <span class="font-mono text-[11px] w-12 text-center text-white">${b.qty} ${escapeHtml(b.unit)}${b.qty > 1 ? 's' : ''}</span>
                   <button type="button" class="pm-qty" data-qty="1" data-id="${escapeHtml(b.id)}" aria-label="Increase" ${b.qty >= MAX_QTY ? 'disabled' : ''}>+</button>
                 </div>`
              : '';
            return `
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 p-2.5 rounded-lg bg-white/10 border border-white/15 text-white hover:bg-white/15 transition-colors">
                <div class="flex items-center gap-2.5 min-w-0">
                  <span class="text-blue-300 font-mono font-bold text-xs">#${i + 1}</span>
                  <span class="font-medium text-xs text-white truncate">${escapeHtml(b.name)}</span>
                  <span class="text-amber-300 font-mono text-[11px] font-bold shrink-0">${unitPrice}</span>
                  ${isDeal ? '<span class="chip bg-rose-500 text-white border-rose-300 font-mono text-[9px] font-bold shrink-0">−15%</span>' : ''}
                </div>
                <div class="flex items-center gap-2 justify-end">
                  ${stepper}
                  <button type="button" class="text-red-300 hover:text-red-200 px-2 py-0.5 rounded font-mono font-bold text-xs pm-remove" data-id="${escapeHtml(b.id)}" aria-label="Remove ${escapeHtml(b.name)}">✕</button>
                </div>
              </div>`;
          })
          .join('');
      }

      const set = (id: string, text: string) => {
        const el = $(id);
        if (el) el.textContent = text;
      };
      set('bag-subtotal', fmt(t.subtotal));
      $('bag-deal-row')?.classList.toggle('hidden', t.dealDiscount <= 0);
      set('bag-deal-amount', `−${fmt(t.dealDiscount)}`);
      $('bag-bundle-row')?.classList.toggle('hidden', t.bundleDiscount <= 0);
      set('bag-bundle-amount', `−${fmt(t.bundleDiscount)}`);
      set('bag-bundle-label', `🎁 Bundle savings (−10% · ${t.completed.length} pack${t.completed.length === 1 ? '' : 's'})`);
      set('bag-estimated-total', t.total > 0 ? `${fmt(t.total)} (est.)` : 'Free / Open Discussion');
      set('bag-duration', durationText(t.minW, t.maxW));

      // Hero stats
      set('stat-bag-count', `${count} item${count === 1 ? '' : 's'}`);
      set('stat-bag-total', t.total > 0 ? fmt(t.total) : 'Open discussion');

      // Card states
      const bagIds = new Set(bag.map((b) => b.id));
      document.querySelectorAll<HTMLElement>('.mart-card').forEach((card) => {
        const inBag = bagIds.has(card.dataset.id || '');
        card.classList.toggle('pm-card--inbag', inBag);
        card.querySelector('.pm-inbag-chip')?.classList.toggle('hidden', !inBag);
      });
      document.querySelectorAll<HTMLButtonElement>('.pm-bag-toggle').forEach((btn) => {
        const id = btn.dataset.itemId || '';
        const inBag = bagIds.has(id);
        const isTm = catalog.get(id)?.category === 'tms';
        btn.setAttribute('aria-pressed', String(inBag));
        btn.textContent = inBag ? (isTm ? '✓ In Brief' : '✓ In Brief — Remove') : isTm ? '➕ Brief' : '➕ Add to Brief';
        btn.classList.toggle('pm-btn-inbag', inBag);
      });

      // Bundles progress
      document.querySelectorAll<HTMLElement>('.pm-bundle').forEach((el) => {
        const bd = data.bundles.find((b) => b.id === el.dataset.bundleId);
        if (!bd) return;
        const have = bd.items.filter((id) => bagIds.has(id)).length;
        const done = have === bd.items.length;
        const status = el.querySelector('.pm-bundle-status');
        if (status) status.textContent = done ? '✓ COMPLETE −10%' : `${have} / ${bd.items.length}`;
        el.classList.toggle('pm-bundle--done', done);
        el.querySelectorAll<HTMLElement>('[data-bundle-item]').forEach((li) => {
          const check = li.querySelector('.pm-bundle-check');
          if (check) check.textContent = bagIds.has(li.dataset.bundleItem || '') ? '●' : '○';
        });
        const btn = el.querySelector<HTMLButtonElement>('.pm-bundle-btn');
        if (btn) {
          btn.textContent = done ? '✓ Packed' : '🎁 Pack This Bundle';
          btn.disabled = done;
        }
      });

      updateEmailLink();
    }

    function saveAndRender() {
      writeJson(sessionStorage, BAG_KEY, bag);
      try {
        sessionStorage.setItem(TRACK_KEY, currentTrack);
      } catch {
        /* ignore */
      }
      renderBag();
    }

    // Bag list (event delegation)
    $('bag-items-list')?.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
      if (!target) return;
      const id = target.dataset.id || '';
      if (target.classList.contains('pm-remove')) {
        removeFromBag(id);
        sfx.select();
        saveAndRender();
      } else if (target.classList.contains('pm-qty')) {
        const line = bag.find((b) => b.id === id);
        if (!line) return;
        line.qty = Math.min(MAX_QTY, Math.max(1, line.qty + Number(target.dataset.qty || 0)));
        sfx.blip();
        saveAndRender();
      }
    });

    $('clear-bag-btn')?.addEventListener('click', () => {
      if (!bag.length) return;
      const snapshot = bag.slice();
      bag = [];
      sfx.select();
      saveAndRender();
      toast('🎒 Bag cleared.', 'info', {
        label: 'Undo',
        onClick: () => {
          bag = snapshot;
          saveAndRender();
        },
      });
    });

    // Add / remove toggles on cards
    document.querySelectorAll<HTMLButtonElement>('.pm-bag-toggle').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.itemId || '';
        if (bag.some((b) => b.id === id)) {
          removeFromBag(id);
          sfx.select();
          toast(`Removed ${catalog.get(id)?.title ?? 'item'} from your brief.`);
        } else {
          addToBag(id);
          toast(`🎒 ${catalog.get(id)?.title ?? 'Item'} added to your brief.`, 'success', {
            label: 'View bag',
            onClick: () => scrollToId('inquiry-bag-section'),
          });
        }
        saveAndRender();
      });
    });

    // Bundles
    document.querySelectorAll<HTMLButtonElement>('.pm-bundle-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const bd = data.bundles.find((b) => b.id === btn.dataset.bundleId);
        if (!bd) return;
        let added = 0;
        for (const id of bd.items) if (addToBag(id, undefined, false)) added++;
        sfx.cashRegister();
        cashFx('STARTER PACK! −10%');
        stamp('bag');
        saveAndRender();
        toast(`🎁 ${bd.name} packed (${added} new item${added === 1 ? '' : 's'}). Bundle savings unlocked!`, 'success', {
          label: 'View bag',
          onClick: () => scrollToId('inquiry-bag-section'),
        });
      });
    });

    // Daily deal claim
    $('pm-deal-claim')?.addEventListener('click', () => {
      if (!dealItem) return;
      const added = addToBag(dealItem.id);
      saveAndRender();
      toast(added ? `🏷️ ${dealItem.title} added with today's 15% deal!` : `🏷️ ${dealItem.title} is already in your bag — deal applied.`, 'success');
    });

    // Collaboration track
    const trackButtons = document.querySelectorAll<HTMLButtonElement>('.collab-track-btn');
    function setTrack(track: CollabTrack) {
      currentTrack = track;
      const ind = $('track-indicator');
      if (ind) ind.textContent = TRACK_DESCRIPTIONS[track];
      trackButtons.forEach((btn) => {
        const active = btn.dataset.track === track;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-checked', String(active));
      });
      saveAndRender();
    }
    trackButtons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const t = btn.dataset.track as CollabTrack;
        if (t && t !== currentTrack) {
          sfx.select();
          setTrack(t);
        }
      })
    );

    // Copy / download / checkout
    $('copy-brief-btn')?.addEventListener('click', async () => {
      const ok = await copyText(briefLines().md);
      if (ok) {
        sfx.confirm();
        cashFx('BRIEF COPIED! 📋');
        stamp('brief');
        const label = $('copy-brief-label');
        if (label) {
          label.textContent = '✨ Copied!';
          window.setTimeout(() => (label.textContent = 'Copy Brief'), 1800);
        }
        toast('📋 Brief copied as Markdown.', 'success');
      } else {
        sfx.bump();
        toast('Clipboard blocked — use “Download .md” instead.', 'warn');
      }
    });
    $('download-brief-btn')?.addEventListener('click', downloadBrief);
    $('send-inquiry-email-btn')?.addEventListener('click', () => stamp('brief'));

    // ═════════ Receipt modal ═════════
    const receiptModal = $<HTMLDialogElement>('receipt-modal');

    function openReceipt() {
      if (!receiptModal) return;
      const t = computeTotals();
      const now = new Date();
      const ymd = now.toISOString().slice(0, 10).replace(/-/g, '');
      const order = `PM-${ymd}-${Math.random().toString(16).slice(2, 6).toUpperCase()}`;
      const W = 34;
      const row = (l: string, r: string) => {
        const left = l.length + r.length + 1 > W ? `${l.slice(0, W - r.length - 2)}…` : l;
        return `${left}${' '.repeat(Math.max(1, W - left.length - r.length))}${r}`;
      };
      const rule = '-'.repeat(W);
      const who = [details.name, details.company].filter(Boolean).join(' · ');

      const lines = [
        row('ORDER', order),
        row('DATE', now.toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' })),
        row('TRACK', TRACK_LABELS[currentTrack]),
        who ? row('FOR', who) : '',
        rule,
        ...(bag.length
          ? bag.map((b) => {
              const qty = b.unit && b.qty > 1 ? ` x${b.qty}` : '';
              const price = b.price === null ? 'KEY' : b.price === 0 ? 'FREE' : fmt(lineBase(b));
              return row(`${b.name}${qty}`, price);
            })
          : ['(general inquiry — no items)']),
        rule,
        row('SUBTOTAL', fmt(t.subtotal)),
        t.dealDiscount > 0 ? row('DAILY DEAL -15%', `-${fmt(t.dealDiscount)}`) : '',
        t.bundleDiscount > 0 ? row('BUNDLE -10%', `-${fmt(t.bundleDiscount)}`) : '',
        row('EST. SCOPE', t.total > 0 ? fmt(t.total) : 'OPEN'),
        row('EST. TIMELINE', durationText(t.minW, t.maxW)),
        row('START', details.timeline || 'Flexible'),
        rule,
        `SEND TO: ${data.email}`,
      ].filter(Boolean);

      const body = $('receipt-body');
      if (body) body.textContent = lines.join('\n');
      updateEmailLink();
      sfx.cashRegister();
      cashFx('CHECKOUT! 🧾');
      stamp('brief');
      receiptModal.showModal();
    }

    $('checkout-btn')?.addEventListener('click', openReceipt);
    $('receipt-close')?.addEventListener('click', () => receiptModal?.close());
    $('receipt-download')?.addEventListener('click', downloadBrief);
    $('receipt-copy')?.addEventListener('click', async () => {
      const ok = await copyText(briefLines().md);
      toast(ok ? '📋 Brief copied as Markdown.' : 'Clipboard blocked — try Download.', ok ? 'success' : 'warn');
      if (ok) sfx.confirm();
    });

    // ═════════ Wallet + ledger ═════════
    const walletModal = $<HTMLDialogElement>('wallet-modal');

    function getBalance(): number {
      try {
        const v = parseInt(localStorage.getItem(WALLET_KEY) ?? '', 10);
        return Number.isFinite(v) ? v : DEFAULT_BALANCE;
      } catch {
        return DEFAULT_BALANCE;
      }
    }

    function renderLedger() {
      const ul = $('wallet-ledger');
      if (!ul) return;
      const entries = readJson<LedgerEntry[]>(localStorage, LEDGER_KEY, []);
      ul.innerHTML = entries.length
        ? entries
            .map(
              (e) => `<li class="flex justify-between gap-2 px-2 py-1 rounded bg-slate-950/60 border border-slate-800">
                <span class="truncate text-slate-300">${escapeHtml(e.label)}</span>
                <span class="${e.delta >= 0 ? 'text-emerald-400' : 'text-rose-400'} font-bold shrink-0">${e.delta >= 0 ? '+' : '−'}${fmt(Math.abs(e.delta))}</span>
              </li>`
            )
            .join('')
        : '<li class="text-slate-500 italic px-2">No transactions yet.</li>';
    }

    function renderWallet() {
      const bal = getBalance();
      const badge = $('wallet-badge-btn');
      if (badge) badge.textContent = `💰 ${fmt(bal)}`;
      const modalBal = $('wallet-modal-balance');
      if (modalBal) modalBal.textContent = bal.toLocaleString('en-US');
      const stat = $('stat-wallet');
      if (stat) stat.textContent = fmt(bal);
      renderLedger();
    }

    function transact(delta: number, label: string) {
      const next = Math.max(0, getBalance() + delta);
      try {
        localStorage.setItem(WALLET_KEY, String(next));
      } catch {
        /* ignore */
      }
      const entries = readJson<LedgerEntry[]>(localStorage, LEDGER_KEY, []);
      entries.unshift({ t: Date.now(), label, delta });
      writeJson(localStorage, LEDGER_KEY, entries.slice(0, 12));
      renderWallet();
    }

    function openWallet() {
      if (!walletModal || walletModal.open) return;
      sfx.select();
      renderWallet();
      walletModal.showModal();
    }

    $('wallet-badge-btn')?.addEventListener('click', openWallet);
    document.querySelectorAll('[data-open-wallet]').forEach((el) => el.addEventListener('click', openWallet));
    $('btn-close-wallet-modal')?.addEventListener('click', () => walletModal?.close());

    $('btn-meowth-payday')?.addEventListener('click', () => {
      transact(1000, "Meowth's Pay Day");
      sfx.confirm();
      cashFx('PAY DAY! +₽1,000');
      toast('🪙 Pay Day! Meowth showered the register with ₽ 1,000.', 'success');
    });
    $('btn-reset-wallet')?.addEventListener('click', () => {
      try {
        localStorage.setItem(WALLET_KEY, String(DEFAULT_BALANCE));
        localStorage.removeItem(LEDGER_KEY);
      } catch {
        /* ignore */
      }
      sfx.select();
      renderWallet();
    });

    // Close any dialog on backdrop click
    [walletModal, receiptModal].forEach((dlg) =>
      dlg?.addEventListener('click', (e) => {
        if (e.target === dlg) dlg.close();
      })
    );

    // ═════════ Potions + buffs ═════════
    let buffTimer: number | undefined;
    let buffEnds = 0;

    function setBuff(name: string, sub: string, seconds: number) {
      buffEnds = Date.now() + seconds * 1000;
      const nameEl = $('stat-buff');
      const subEl = $('stat-buff-sub');
      if (nameEl) nameEl.textContent = name;
      window.clearInterval(buffTimer);
      const tick = () => {
        const left = Math.max(0, Math.ceil((buffEnds - Date.now()) / 1000));
        if (subEl) subEl.textContent = left > 0 ? `${sub} · ${left}s` : 'Drink a potion';
        if (left <= 0) {
          if (nameEl) nameEl.textContent = 'None';
          window.clearInterval(buffTimer);
        }
      };
      tick();
      buffTimer = window.setInterval(tick, 1000);
    }

    const POTIONS = {
      coffee: { cost: 50, label: 'Bandung Specialty Espresso', fx: 'SIP! -₽50 (+50% SPEED)', busy: '✨ Max Stamina!' },
      ether: { cost: 100, label: 'Clean Architecture Max Ether', fx: 'ETHER! -₽100 (CLEAN ARCH)', busy: '⚡ Refactored!' },
    } as const;

    document.querySelectorAll<HTMLButtonElement>('.pm-potion-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const kind = btn.dataset.potion as keyof typeof POTIONS;
        const p = POTIONS[kind];
        if (!p) return;
        if (getBalance() < p.cost) {
          sfx.bump();
          toast(`Not enough Poké-Dollars for ${p.label}.`, 'warn', { label: 'Open wallet', onClick: openWallet });
          return;
        }
        transact(-p.cost, p.label);
        if (kind === 'coffee') {
          sfx.espressoBrew();
          window.setTimeout(() => sfx.heal(), 180);
          window.dispatchEvent(new CustomEvent('town:coffee-boost'));
          setBuff('☕ Caffeinated', '+50% walk speed', 30);
        } else {
          sfx.confirm();
          window.setTimeout(() => sfx.heal(), 140);
          setBuff('🧪 Clean Arch', 'SOLID +95% coverage', 30);
        }
        cashFx(p.fx);
        stamp('potion');
        const orig = btn.textContent;
        btn.textContent = p.busy;
        btn.disabled = true;
        window.setTimeout(() => {
          btn.textContent = orig;
          btn.disabled = false;
        }, 1500);
      });
    });

    // ═════════ Stamp card ═════════
    function getStamps(): string[] {
      return readJson<string[]>(localStorage, STAMPS_KEY, []);
    }

    function renderStamps() {
      const owned = new Set(getStamps());
      const total = data.stamps.length;
      const have = data.stamps.filter((s) => owned.has(s.id)).length;
      document.querySelectorAll<HTMLElement>('.pm-stamp').forEach((el) => {
        el.classList.toggle('is-stamped', owned.has(el.dataset.stamp || ''));
      });
      const text = `${have} / ${total}`;
      const c1 = $('pm-stamp-count');
      const c2 = $('stat-stamps');
      if (c1) c1.textContent = text;
      if (c2) c2.textContent = text;
      const vip = have >= total;
      const sub = $('stat-stamps-sub');
      if (sub) sub.textContent = vip ? '⭐ VIP Trainer' : 'Collect all for VIP';
      $('pm-vip-badge')?.classList.toggle('hidden', !vip);
    }

    function stamp(id: string) {
      const owned = getStamps();
      if (owned.includes(id) || !data.stamps.some((s) => s.id === id)) return;
      owned.push(id);
      writeJson(localStorage, STAMPS_KEY, owned);
      renderStamps();
      const label = data.stamps.find((s) => s.id === id)?.label ?? id;
      toast(`🎫 Stamp collected: ${label}`, 'success');

      if (owned.length >= data.stamps.length) {
        let claimed = false;
        try {
          claimed = localStorage.getItem(VIP_KEY) === '1';
          localStorage.setItem(VIP_KEY, '1');
        } catch {
          /* ignore */
        }
        if (!claimed) {
          transact(2000, 'VIP Trainer bonus');
          sfx.catchSuccess();
          cashFx('VIP TRAINER! +₽2,000');
          toast('⭐ Stamp card complete! You are now a VIP Trainer (+₽ 2,000).', 'success');
        }
      }
    }

    $('pm-stamp-reset')?.addEventListener('click', () => {
      try {
        localStorage.removeItem(STAMPS_KEY);
      } catch {
        /* ignore */
      }
      sfx.select();
      renderStamps();
    });

    document.querySelectorAll('.pm-cv-link').forEach((a) => a.addEventListener('click', () => stamp('cv')));

    // ═════════ Catalog: tabs, search, sort ═════════
    const tabs = document.querySelectorAll<HTMLButtonElement>('.mart-tab-btn');
    const grid = $('mart-grid');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.mart-card'));
    const search = $<HTMLInputElement>('mart-search');
    const sortSel = $<HTMLSelectElement>('mart-sort');
    let activeCat = 'all';

    function applyFilters() {
      const q = (search?.value || '').trim().toLowerCase();
      const terms = q.split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const card of cards) {
        const catOk = activeCat === 'all' || card.dataset.category === activeCat;
        const hay = card.dataset.search || '';
        const qOk = terms.every((t) => hay.includes(t));
        const visible = catOk && qOk;
        card.hidden = !visible;
        if (visible) shown++;
      }
      const countEl = $('mart-result-count');
      if (countEl) countEl.textContent = `Showing ${shown} of ${cards.length} items${q ? ` for “${q}”` : ''}`;
      $('mart-empty')?.classList.toggle('hidden', shown > 0);
    }

    function applySort() {
      if (!grid) return;
      const mode = sortSel?.value || 'featured';
      const price = (c: HTMLElement, dir: 1 | -1) => {
        const raw = c.dataset.price;
        return raw === '' || raw === undefined ? (dir === 1 ? Infinity : -Infinity) : Number(raw);
      };
      const sorted = cards.slice().sort((a, b) => {
        switch (mode) {
          case 'price-asc':
            return price(a, 1) - price(b, 1);
          case 'price-desc':
            return price(b, -1) - price(a, -1);
          case 'az':
            return (a.dataset.title || '').localeCompare(b.dataset.title || '');
          default:
            return Number(a.dataset.featured) - Number(b.dataset.featured);
        }
      });
      sorted.forEach((c) => grid.appendChild(c));
    }

    function setTab(cat: string) {
      activeCat = cat;
      tabs.forEach((t) => {
        const active = t.dataset.martTab === cat;
        t.classList.toggle('active', active);
        t.classList.toggle('btn-ball', active);
        t.classList.toggle('btn-paper', !active);
        t.setAttribute('aria-selected', String(active));
      });
      applyFilters();
    }

    tabs.forEach((tab) =>
      tab.addEventListener('click', () => {
        sfx.select();
        setTab(tab.dataset.martTab || 'all');
      })
    );

    let searchDebounce: number | undefined;
    search?.addEventListener('input', () => {
      window.clearTimeout(searchDebounce);
      searchDebounce = window.setTimeout(applyFilters, 90);
    });
    sortSel?.addEventListener('change', () => {
      sfx.select();
      applySort();
    });

    document.querySelectorAll<HTMLButtonElement>('.pm-tag').forEach((tag) =>
      tag.addEventListener('click', () => {
        if (!search) return;
        search.value = tag.dataset.tag || '';
        sfx.blip();
        setTab('all');
        search.focus({ preventScroll: true });
      })
    );

    $('mart-reset-filters')?.addEventListener('click', () => {
      if (search) search.value = '';
      if (sortSel) sortSel.value = 'featured';
      applySort();
      setTab('all');
    });

    // ═════════ 2D canvas hooks ═════════
    const scrollCanvas = (mobileOnly: boolean) => {
      const town = document.querySelector('.town');
      if (town && (!mobileOnly || window.innerWidth < 768)) {
        town.scrollIntoView({ behavior: reduceMotion() ? 'auto' : 'smooth', block: 'nearest' });
      }
    };

    document.querySelectorAll<HTMLButtonElement>('.mart-quick-btn').forEach((btn) =>
      btn.addEventListener('click', () => {
        const propId = btn.dataset.quick;
        if (!propId) return;
        window.dispatchEvent(new CustomEvent('town:locate', { detail: { propId } }));
        if (btn.dataset.tab) setTab(btn.dataset.tab);
        scrollCanvas(true);
      })
    );

    document.querySelectorAll<HTMLButtonElement>('.btn-inspect-2d').forEach((btn) =>
      btn.addEventListener('click', () => {
        const propId = btn.dataset.prop;
        if (!propId) return;
        window.dispatchEvent(new CustomEvent('town:locate', { detail: { propId } }));
        scrollCanvas(false);
      })
    );

    $('btn-toss-coin-2d')?.addEventListener('click', () => {
      sfx.cashRegister();
      cashFx('PAY DAY! +₽999');
      scrollCanvas(true);
    });

    document.querySelectorAll<HTMLButtonElement>('.inspect-tm-btn').forEach((btn) =>
      btn.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('town:open-tm-reader', { detail: { tmId: btn.dataset.tmId || 'tm-01' } }));
        stamp('tm');
      })
    );

    // Jump buttons in the stats strip
    document.querySelectorAll<HTMLElement>('[data-jump]').forEach((el) =>
      el.addEventListener('click', () => {
        sfx.select();
        scrollToId(el.dataset.jump || '');
      })
    );

    // ═════════ Meowth quotes ═════════
    let quoteIndex = 0;
    let pats = 0;
    $('btn-meowth-quote')?.addEventListener('click', () => {
      quoteIndex = (quoteIndex + 1) % MEOWTH_QUOTES.length;
      pats++;
      sfx.cashRegister();
      cashFx(`LUCK +${pats}! 🪙`);
      const bubble = $('meowth-speech-bubble');
      if (bubble) {
        bubble.style.opacity = '0';
        window.setTimeout(() => {
          bubble.textContent = `"${MEOWTH_QUOTES[quoteIndex]}"`;
          bubble.style.opacity = '1';
        }, 150);
      }
      const counter = $('meowth-pat-counter');
      if (counter) {
        counter.classList.remove('hidden');
        counter.textContent = pats >= 3 ? `✨ AMULET VIP (${pats}x Luck)` : `🪙 Luck x${pats}`;
        if (pats >= 3) counter.classList.add('animate-pulse');
      }
      if (pats >= 3) stamp('meowth');
    });

    // ═════════ Ambient hover sounds (throttled, mouse only) ═════════
    let lastHover = 0;
    cards.forEach((card) =>
      card.addEventListener('pointerenter', (e) => {
        if ((e as PointerEvent).pointerType !== 'mouse') return;
        const now = Date.now();
        if (now - lastHover < 600) return;
        lastHover = now;
        if (card.dataset.category === 'potions') sfx.espressoBrew();
        else if (card.dataset.category === 'tms') sfx.discSpin();
      })
    );

    // ═════════ Window-level listeners (bound once) ═════════
    if (!windowListenersBound) {
      windowListenersBound = true;

      // TM taught from the optical reader → add (deduped) to the bag
      window.addEventListener('town:add-tm-to-bag', (e: Event) => {
        const detail = (e as CustomEvent<{ id: string; name: string }>).detail;
        if (!detail || !document.getElementById('mart-root')) return;
        window.dispatchEvent(new CustomEvent('pm:add-to-bag', { detail }));
      });

      // Hotkeys — G / T / Q / R / "/" (B, M, P, X… are reserved by the town engine)
      window.addEventListener('keydown', (e: KeyboardEvent) => {
        if (!document.getElementById('mart-root')) return;
        if (e.ctrlKey || e.metaKey || e.altKey) return;
        const el = e.target as HTMLElement | null;
        const tag = el?.tagName;
        if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || el?.isContentEditable) return;
        if (document.querySelector('dialog[open]')) return;

        const key = e.key.toLowerCase();
        if (key === '/') {
          e.preventDefault();
          const s = document.getElementById('mart-search') as HTMLInputElement | null;
          s?.focus();
          s?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } else if (key === 'g') {
          e.preventDefault();
          window.dispatchEvent(new CustomEvent('pm:hotkey', { detail: 'wallet' }));
        } else if (key === 't') {
          e.preventDefault();
          window.dispatchEvent(new CustomEvent('town:open-tm-reader', { detail: { tmId: 'tm-01' } }));
        } else if (key === 'q') {
          e.preventDefault();
          window.dispatchEvent(new CustomEvent('pm:hotkey', { detail: 'bag' }));
        } else if (key === 'r') {
          e.preventDefault();
          window.dispatchEvent(new CustomEvent('pm:hotkey', { detail: 'checkout' }));
        }
      });
    }

    window.addEventListener('pm:add-to-bag', (e: Event) => {
      const d = (e as CustomEvent<{ id: string; name: string }>).detail;
      const added = addToBag(d.id, d.name, false);
      stamp('bag');
      saveAndRender();
      toast(added ? `💿 ${catalog.get(d.id)?.title ?? d.name} taught to your project brief.` : 'That TM is already in your brief.', added ? 'success' : 'info', {
        label: 'View bag',
        onClick: () => scrollToId('inquiry-bag-section'),
      });
    });

    window.addEventListener('pm:hotkey', (e: Event) => {
      const action = (e as CustomEvent<string>).detail;
      if (action === 'wallet') openWallet();
      else if (action === 'bag') {
        sfx.select();
        scrollToId('inquiry-bag-section');
      } else if (action === 'checkout') openReceipt();
    });

    // ═════════ Initial render ═════════
    applySort();
    setTab('all');
    renderWallet();
    renderStamps();
    setTrack(currentTrack);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMartPage, { once: true });
  } else {
    initMartPage();
  }
  document.addEventListener('astro:page-load', initMartPage);
</script>

<style is:global>
  /* ── Stats strip ── */
  .pm-stat {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.1rem;
    padding: 0.55rem 0.7rem;
    border-radius: 0.75rem;
    border: 2px solid rgb(28 23 38 / 0.15);
    background: rgb(255 250 240 / 0.85);
    text-align: left;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  button.pm-stat:hover {
    transform: translateY(-1px);
    border-color: #3b82f6;
  }
  .pm-stat__label {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }
  .pm-stat__value {
    font-family: var(--font-pixel, inherit);
    font-size: 12px;
    color: var(--color-ink);
  }
  .pm-stat__sub {
    font-size: 10px;
    color: var(--color-ink-soft);
  }

  /* ── Cards ── */
  .pm-card:hover {
    border-color: #3b82f6;
    transform: translateY(-2px);
  }
  .pm-card--inbag {
    border-color: #10b981 !important;
    box-shadow: 0 0 0 3px rgb(16 185 129 / 0.18), 0 4px 0 rgb(28 23 38 / 0.2);
  }
  .pm-card[hidden] {
    display: none !important;
  }
  .pm-deal-ribbon {
    position: absolute;
    top: -0.55rem;
    left: 0.75rem;
    padding: 0.1rem 0.45rem;
    border-radius: 0.35rem;
    border: 1.5px solid var(--color-ink);
    background: var(--color-ball);
    color: #fff;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.05em;
    box-shadow: 0 2px 0 var(--color-ink);
