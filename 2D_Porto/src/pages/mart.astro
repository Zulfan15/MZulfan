<script>
  import { sfx } from '../game/sfx';

  function initMartPage() {
    // 1. Category Filtering
    const tabs = document.querySelectorAll<HTMLButtonElement>('.mart-tab-btn');
    const cards = document.querySelectorAll<HTMLElement>('.mart-card');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => t.classList.remove('active', 'btn-ball'));
        tab.classList.add('active', 'btn-ball');

        const cat = tab.getAttribute('data-mart-tab');
        sfx.select();

        cards.forEach((card) => {
          if (cat === 'all' || card.getAttribute('data-category') === cat) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // 2. Interactive Project Inquiry Bag & Collaboration Tracks
    interface BagItem {
      id: string;
      name: string;
      price: string;
    }

    type CollabTrack = 'fulltime' | 'sprint' | 'advisory';
    let currentTrack: CollabTrack = 'fulltime';

    const trackDescriptions: Record<CollabTrack, string> = {
      fulltime: 'Track: Full-Time / Hybrid Role (Software & AI Engineer)',
      sprint: 'Track: Fixed MVP Sprint (2–4 Week Scoped Build)',
      advisory: 'Track: Security & Architecture Audit (HCIA Security)',
    };

    const trackLabels: Record<CollabTrack, string> = {
      fulltime: 'Full-Time Role',
      sprint: 'Fixed MVP Sprint',
      advisory: 'Security & Architecture Audit',
    };

    let bag: BagItem[] = [];

    // Load from session storage if any
    try {
      const stored = sessionStorage.getItem('mart_inquiry_bag');
      if (stored) bag = JSON.parse(stored);
      const savedTrack = sessionStorage.getItem('mart_collab_track') as CollabTrack | null;
      if (savedTrack && (savedTrack === 'fulltime' || savedTrack === 'sprint' || savedTrack === 'advisory')) {
        currentTrack = savedTrack;
      }
    } catch {}

    const bagSection = document.getElementById('inquiry-bag-section');
    const contactEmail = bagSection?.getAttribute('data-contact-email') || 'zulfanangga2908@gmail.com';
    const bagCountBadge = document.getElementById('bag-count-badge');
    const bagList = document.getElementById('bag-items-list');
    const clearBtn = document.getElementById('clear-bag-btn');
    const emailBtn = document.getElementById('send-inquiry-email-btn') as HTMLAnchorElement | null;
    const emptyMsg = document.getElementById('empty-bag-message');
    const trackIndicator = document.getElementById('track-indicator');
    const trackButtons = document.querySelectorAll<HTMLButtonElement>('.collab-track-btn');
    const totalDisplay = document.getElementById('bag-estimated-total');
    const copyBriefBtn = document.getElementById('copy-brief-btn');
    const copyBriefLabel = document.getElementById('copy-brief-label');

    function computeBagTotal(): number {
      return bag.reduce((sum, item) => {
        const num = parseInt(item.price.replace(/[^0-9]/g, ''), 10);
        return isNaN(num) ? sum : sum + num;
      }, 0);
    }

    function renderBag() {
      if (!bagCountBadge || !bagList) return;

      bagCountBadge.textContent = `${bag.length} ${bag.length === 1 ? 'Item' : 'Items'} Selected`;

      const totalBudget = computeBagTotal();
      if (totalDisplay) {
        if (totalBudget > 0) {
          totalDisplay.textContent = `₽ ${totalBudget.toLocaleString()} (Estimated)`;
        } else {
          totalDisplay.textContent = 'Free / Open Discussion';
        }
      }

      if (bag.length === 0) {
        if (emptyMsg) emptyMsg.style.display = '';
        if (clearBtn) clearBtn.classList.add('hidden');
        bagList.innerHTML = '';
        if (emptyMsg) bagList.appendChild(emptyMsg);
        if (emailBtn) {
          const trackTitle = trackLabels[currentTrack];
          const subject = `[${trackTitle}] Collaboration Inquiry — Muhammad Zulfan`;
          const body = `Hi Muhammad Zulfan,%0D%0A%0D%0AI visited your Poké Mart catalog and would like to connect regarding a ${trackTitle}.%0D%0A%0D%0APlease let me know your availability for an introductory discussion.%0D%0A%0D%0ABest regards,`;
          emailBtn.href = `mailto:${contactEmail}?subject=${encodeURIComponent(subject)}&body=${body}`;
        }
        return;
      }

      if (clearBtn) clearBtn.classList.remove('hidden');
      if (emptyMsg) emptyMsg.style.display = 'none';
      bagList.innerHTML = '';

      bag.forEach((item, index) => {
        const row = document.createElement('div');
        row.className = 'flex items-center justify-between p-2.5 rounded-lg bg-white/10 border border-white/15 text-white transition-colors hover:bg-white/15';
        row.innerHTML = `
          <div class="flex items-center gap-2.5">
            <span class="text-blue-300 font-mono font-bold text-xs">#${index + 1}</span>
            <span class="font-medium text-xs text-white">${item.name}</span>
            <span class="text-amber-300 font-mono text-[11px] font-bold">(${item.price})</span>
          </div>
          <button type="button" class="text-red-400 hover:text-red-300 px-2 py-0.5 rounded font-mono font-bold text-xs remove-item-btn transition-colors" data-index="${index}" title="Remove this item">
            ✕ Remove
          </button>
        `;
        bagList.appendChild(row);
      });

      // Bind remove buttons
      bagList.querySelectorAll<HTMLButtonElement>('.remove-item-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const idx = parseInt((e.currentTarget as HTMLElement).getAttribute('data-index') || '0', 10);
          bag.splice(idx, 1);
          saveAndRenderBag();
          sfx.select();
        });
      });

      // Update mailto link based on track & items
      if (emailBtn) {
        const trackTitle = trackLabels[currentTrack];
        const subject = `[${trackTitle}] Muhammad Zulfan Portfolio Inquiry (${bag.length} items)`;
        const itemsListText = bag.map((it, idx) => `  ${idx + 1}. ${it.name} (${it.price})`).join('%0D%0A');
        const budgetText = totalBudget > 0 ? `₽ ${totalBudget.toLocaleString()}` : 'Free / Open Discussion';

        const body = `Hi Muhammad Zulfan,%0D%0A%0D%0AI visited your Poké Mart catalog and assembled the following technical brief:%0D%0A%0D%0A• Collaboration Track: ${trackTitle}%0D%0A• Estimated Budget: ${budgetText}%0D%0A• Selected Technical Services & Items:%0D%0A${itemsListText}%0D%0A%0D%0ACould we schedule a call or discussion regarding timeline and scope?%0D%0A%0D%0ABest regards,`;

        emailBtn.href = `mailto:${contactEmail}?subject=${encodeURIComponent(subject)}&body=${body}`;
      }
    }

    function saveAndRenderBag() {
      try {
        sessionStorage.setItem('mart_inquiry_bag', JSON.stringify(bag));
        sessionStorage.setItem('mart_collab_track', currentTrack);
      } catch {}
      renderBag();
    }

    // Collaboration Track Switcher
    function setTrack(track: CollabTrack) {
      currentTrack = track;
      if (trackIndicator) {
        trackIndicator.textContent = trackDescriptions[track];
      }

      trackButtons.forEach((btn) => {
        const t = btn.getAttribute('data-track');
        const headingDiv = btn.querySelector('.font-pixel');
        if (t === track) {
          btn.className = 'collab-track-btn p-2.5 rounded-lg border-2 text-left transition-all cursor-pointer border-amber-400 bg-amber-500/20 text-white shadow-sm';
          if (headingDiv) headingDiv.className = 'font-pixel text-[11px] flex items-center gap-1.5 text-amber-300 font-bold';
        } else {
          btn.className = 'collab-track-btn p-2.5 rounded-lg border text-left transition-all cursor-pointer border-white/15 bg-white/5 text-slate-300 hover:border-white/40';
          if (headingDiv) headingDiv.className = 'font-pixel text-[11px] flex items-center gap-1.5 text-white';
        }
      });

      saveAndRenderBag();
    }

    trackButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const track = btn.getAttribute('data-track') as CollabTrack;
        if (track && track !== currentTrack) {
          sfx.select();
          setTrack(track);
        }
      });
    });

    // Copy Project Brief Button
    copyBriefBtn?.addEventListener('click', async () => {
      const trackTitle = trackDescriptions[currentTrack];
      const totalBudget = computeBagTotal();
      const budgetText = totalBudget > 0 ? `₽ ${totalBudget.toLocaleString()} (Estimated)` : 'Free / Open Discussion';

      let briefText = `# Muhammad Zulfan — Project Inquiry & Engineering Brief\n\n`;
      briefText += `**Collaboration Track:** ${trackTitle}\n`;
      briefText += `**Recipient:** ${contactEmail}\n`;
      briefText += `**Estimated Sprint Budget:** ${budgetText}\n\n`;
      briefText += `### Selected Technical Services & Items:\n`;

      if (bag.length === 0) {
        briefText += `_No specific items selected — general collaboration inquiry for ${trackTitle}._\n`;
      } else {
        bag.forEach((it, idx) => {
          briefText += `${idx + 1}. **${it.name}** — ${it.price}\n`;
        });
      }

      briefText += `\n---\n*Generated from Poké Mart at Muhammad Zulfan's 2D Portfolio*\n*Profile & Official CV: /cv/CV_Zulfan.pdf | GPA 3.49 ITENAS*`;

      try {
        await navigator.clipboard.writeText(briefText);
        sfx.confirm();
        window.dispatchEvent(
          new CustomEvent('town:mart-cash-anim', {
            detail: { text: 'BRIEF COPIED! 📋' },
          })
        );
        if (copyBriefLabel) {
          const orig = copyBriefLabel.textContent;
          copyBriefLabel.textContent = '✨ Brief Copied!';
          copyBriefBtn.classList.add('bg-emerald-600', 'text-white');
          setTimeout(() => {
            copyBriefLabel.textContent = orig;
            copyBriefBtn.classList.remove('bg-emerald-600', 'text-white');
          }, 2000);
        }
      } catch (err) {
        console.error('Clipboard copy failed:', err);
      }
    });

    // Add buttons
    document.querySelectorAll<HTMLButtonElement>('.add-to-bag-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-item-id') || '';
        const name = btn.getAttribute('data-item-name') || '';
        const price = btn.getAttribute('data-item-price') || '';

        bag.push({ id, name, price });
        saveAndRenderBag();
        sfx.select();

        // Trigger 2D Cash Register FX
        window.dispatchEvent(
          new CustomEvent('town:mart-cash-anim', {
            detail: { text: `CHA-CHING! +1 BRIEF` },
          })
        );

        // Button feedback
        const orig = btn.textContent;
        btn.textContent = '✓ Added to Brief!';
        btn.classList.add('bg-emerald-600', 'border-emerald-700');
        setTimeout(() => {
          btn.textContent = orig;
          btn.classList.remove('bg-emerald-600', 'border-emerald-700');
        }, 1200);

        // Scroll to bag section smoothly
        const bagSec = document.getElementById('inquiry-bag-section');
        if (bagSec) {
          bagSec.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      });
    });

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        bag = [];
        saveAndRenderBag();
        sfx.select();
      });
    }

    // 3. Live Poké-Dollar Wallet Ledger & Potions
    const WALLET_KEY = 'pokemart_wallet_balance';
    const DEFAULT_BALANCE = 9999;

    function getWalletBalance(): number {
      try {
        const raw = localStorage.getItem(WALLET_KEY);
        if (raw !== null) {
          const val = parseInt(raw, 10);
          if (!isNaN(val)) return val;
        }
      } catch {}
      return DEFAULT_BALANCE;
    }

    function setWalletBalance(balance: number): void {
      try {
        localStorage.setItem(WALLET_KEY, balance.toString());
      } catch {}
      updateWalletUI(balance);
    }

    function updateWalletUI(balance: number) {
      const badgeBtn = document.getElementById('wallet-badge-btn');
      const modalBalance = document.getElementById('wallet-modal-balance');
      const formatted = balance.toLocaleString();

      if (badgeBtn) {
        badgeBtn.textContent = `💰 ₽ ${formatted}`;
      }
      if (modalBalance) {
        modalBalance.textContent = formatted;
      }
    }

    // Wallet Modal Controls
    const walletModal = document.getElementById('wallet-modal') as HTMLDialogElement | null;
    const walletBadgeBtn = document.getElementById('wallet-badge-btn');
    const closeWalletBtn = document.getElementById('btn-close-wallet-modal');
    const meowthPaydayBtn = document.getElementById('btn-meowth-payday');
    const resetWalletBtn = document.getElementById('btn-reset-wallet');
    const walletFeedbackToast = document.getElementById('wallet-feedback-toast');

    walletBadgeBtn?.addEventListener('click', () => {
      sfx.select();
      walletModal?.showModal();
    });

    closeWalletBtn?.addEventListener('click', () => {
      sfx.select();
      walletModal?.close();
    });

    // Close on backdrop click
    walletModal?.addEventListener('click', (e) => {
      const rect = walletModal.getBoundingClientRect();
      const isInDialog = (
        rect.top <= e.clientY &&
        e.clientY <= rect.top + rect.height &&
        rect.left <= e.clientX &&
        e.clientX <= rect.left + rect.width
      );
      if (!isInDialog) {
        walletModal.close();
      }
    });

    meowthPaydayBtn?.addEventListener('click', () => {
      const current = getWalletBalance();
      const newBal = current + 1000;
      setWalletBalance(newBal);
      sfx.confirm();

      window.dispatchEvent(
        new CustomEvent('town:mart-cash-anim', {
          detail: { text: 'PAY DAY! +₽1,000' },
        })
      );

      if (walletFeedbackToast) {
        walletFeedbackToast.classList.remove('hidden');
        setTimeout(() => {
          walletFeedbackToast.classList.add('hidden');
        }, 2800);
      }
    });

    resetWalletBtn?.addEventListener('click', () => {
      setWalletBalance(DEFAULT_BALANCE);
      sfx.select();
    });

    // Potion interactions with Wallet deductions
    const coffeeBtn = document.getElementById('drink-coffee-btn');
    if (coffeeBtn) {
      coffeeBtn.addEventListener('click', () => {
        const bal = getWalletBalance();
        if (bal < 50) {
          sfx.buzzer();
          alert('⚠️ Not enough Poké-Dollars! Click Meowth\'s Pay Day in the wallet modal to refill funds! 🪙');
          return;
        }
        setWalletBalance(bal - 50);
        sfx.heal();
        window.dispatchEvent(
          new CustomEvent('town:mart-cash-anim', {
            detail: { text: 'SIP! -₽50 (+100% FOCUS)' },
          })
        );
        const orig = coffeeBtn.textContent;
        coffeeBtn.textContent = '✨ Max Stamina!';
        coffeeBtn.classList.add('bg-emerald-500', 'text-white');
        setTimeout(() => {
          coffeeBtn.textContent = orig;
          coffeeBtn.classList.remove('bg-emerald-500', 'text-white');
        }, 2000);
      });
    }

    const etherBtn = document.getElementById('drink-ether-btn');
    if (etherBtn) {
      etherBtn.addEventListener('click', () => {
        const bal = getWalletBalance();
        if (bal < 100) {
          sfx.buzzer();
          alert('⚠️ Not enough Poké-Dollars! Click Meowth\'s Pay Day in the wallet modal to refill funds! 🪙');
          return;
        }
        setWalletBalance(bal - 100);
        sfx.heal();
        window.dispatchEvent(
          new CustomEvent('town:mart-cash-anim', {
            detail: { text: 'ETHER! -₽100 (CLEAN ARCH)' },
          })
        );
        const orig = etherBtn.textContent;
        etherBtn.textContent = '⚡ Code Refactored!';
        etherBtn.classList.add('bg-teal-500', 'text-white');
        setTimeout(() => {
          etherBtn.textContent = orig;
          etherBtn.classList.remove('bg-teal-500', 'text-white');
        }, 2000);
      });
    }

    // Quick Action Bar click listeners
    const quickButtons = document.querySelectorAll<HTMLButtonElement>('.mart-quick-btn');
    quickButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const action = btn.getAttribute('data-quick');
        if (!action) return;

        window.dispatchEvent(new CustomEvent('town:locate', { detail: { propId: action } }));
        const townCanvas = document.querySelector('.town');
        if (townCanvas && window.innerWidth < 768) {
          townCanvas.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });

    // 📍 Inspect in 2D buttons
    const inspectButtons = document.querySelectorAll<HTMLButtonElement>('.btn-inspect-2d');
    inspectButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const propId = btn.getAttribute('data-prop');
        if (!propId) return;

        window.dispatchEvent(new CustomEvent('town:locate', { detail: { propId } }));
        const townCanvas = document.querySelector('.town');
        if (townCanvas) {
          townCanvas.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      });
    });

    // 🪙 Toss coin test button
    const btnTossCoin = document.getElementById('btn-toss-coin-2d');
    btnTossCoin?.addEventListener('click', () => {
      sfx.confirm();
      window.dispatchEvent(
        new CustomEvent('town:mart-cash-anim', {
          detail: { text: 'PAY DAY! +₽999' },
        })
      );
      const townCanvas = document.querySelector('.town');
      if (townCanvas && window.innerWidth < 768) {
        townCanvas.scrollIntoView({ behavior: 'smooth' });
      }
    });

    // 💿 Inspect TM Disc buttons (Opens Silph-9000 Optical Reader)
    document.querySelectorAll<HTMLButtonElement>('.inspect-tm-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const tmId = btn.getAttribute('data-tm-id') || 'tm-01';
        window.dispatchEvent(
          new CustomEvent('town:open-tm-reader', {
            detail: { tmId },
          })
        );
      });
    });

    // 💿 Listen for TM taught/added from reader modal into Project Inquiry Bag
    window.addEventListener('town:add-tm-to-bag', (e: Event) => {
      const customEvt = e as CustomEvent<{ id: string; name: string; price: string }>;
      if (customEvt.detail) {
        bag.push({
          id: customEvt.detail.id,
          name: customEvt.detail.name,
          price: customEvt.detail.price,
        });
        saveAndRenderBag();

        // Scroll to inquiry bag smoothly
        const bagSec = document.getElementById('inquiry-bag-section');
        if (bagSec) {
          bagSec.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      }
    });

    // Initialize state
    updateWalletUI(getWalletBalance());
    setTrack(currentTrack);
    renderBag();
  }

  document.addEventListener('astro:page-load', initMartPage);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMartPage);
  } else {
    initMartPage();
  }
</script>

