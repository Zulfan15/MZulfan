            <div class="font-sans text-[10px] text-blue-200 mt-0.5">Software / AI Engineer hire</div>
          </button>
          <button type="button" role="radio" aria-checked="false" class="collab-track-btn pm-track" data-track="sprint">
            <div class="font-pixel text-[11px] flex items-center gap-1.5"><span aria-hidden="true">🚀</span><span>Fixed MVP Sprint</span></div>
            <div class="font-sans text-[10px] text-blue-200 mt-0.5">2–4 week scoped build</div>
          </button>
          <button type="button" role="radio" aria-checked="false" class="collab-track-btn pm-track" data-track="advisory">
            <div class="font-pixel text-[11px] flex items-center gap-1.5"><span aria-hidden="true">🛡️</span><span>Security &amp; Audit</span></div>
            <div class="font-sans text-[10px] text-blue-200 mt-0.5">HCIA Security &amp; code review</div>
          </button>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-5 gap-4">
        <!-- Bag Items List -->
        <div class="lg:col-span-3 space-y-2">
          <div class="font-mono text-[10px] text-blue-300 uppercase font-bold">🧾 Selected items</div>
          <div id="bag-items-list" class="space-y-2 text-xs"></div>
          <p class="text-blue-300 italic py-4 text-center text-xs rounded-lg border border-dashed border-white/15" id="empty-bag-message">
            No services added yet. Click <strong>"➕ Add to Brief"</strong> on any item or pack a Starter Pack.
          </p>

          <!-- Totals -->
          <dl class="mt-3 p-3 rounded-lg bg-black/25 border border-white/10 font-mono text-[11px] space-y-1">
            <div class="flex justify-between text-blue-200"><dt>Subtotal</dt><dd id="bag-subtotal">₽ 0</dd></div>
            <div class="flex justify-between text-rose-300 hidden" id="bag-deal-row"><dt>🏷️ Daily deal (−15%)</dt><dd id="bag-deal-amount">−₽ 0</dd></div>
            <div class="flex justify-between text-emerald-300 hidden" id="bag-bundle-row"><dt id="bag-bundle-label">🎁 Bundle savings (−10%)</dt><dd id="bag-bundle-amount">−₽ 0</dd></div>
            <div class="flex justify-between text-white font-bold border-t border-white/15 pt-1.5 mt-1.5">
              <dt>Estimated scope budget</dt><dd id="bag-estimated-total" class="text-amber-300">Free / Open Discussion</dd>
            </div>
            <div class="flex justify-between text-blue-200"><dt>Estimated timeline</dt><dd id="bag-duration">—</dd></div>
          </dl>
          <p class="text-[10px] text-blue-300/80 font-sans">
            ₽ values are playful in-game scope indicators — real rates and timelines are agreed per project.
          </p>
        </div>

        <!-- Project details form -->
        <form id="pm-details-form" class="lg:col-span-2 p-3.5 rounded-xl bg-white/5 border border-white/10 space-y-2.5" autocomplete="on">
          <div class="font-mono text-[10px] text-blue-300 uppercase font-bold">📝 Your project details (optional)</div>
          <label class="block">
            <span class="text-[10px] text-blue-200 font-mono">Your name</span>
            <input name="name" type="text" maxlength="80" autocomplete="name" class="pm-input" placeholder="e.g. Ayu Lestari" />
