        </div>
      </div>
      <p class="font-mono text-[10px] text-ink-soft" id="mart-result-count" aria-live="polite">Showing 12 of 12 items</p>

      <!-- Item Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="mart-grid">
        {items.map((item) => (
          <article
            class={`mart-card pm-card relative p-4 rounded-xl border-2 flex flex-col justify-between transition-all ${item.category === 'key' ? 'bg-blue-50/80 border-blue-400 shadow-md' : 'bg-cream/50 border-ink/20 shadow-sm'}`}
            data-category={item.category}
            data-id={item.id}
            data-title={item.title}
            data-price={item.price === null ? '' : String(item.price)}
            data-featured={String(item.featured)}
            data-search={[item.title, item.subtitle, item.desc, item.badge, ...item.tags].join(' ').toLowerCase()}
          >
            <span class="pm-deal-ribbon hidden" aria-hidden="true">🏷️ −15% TODAY</span>
            <div>
              <div class="flex items-start justify-between gap-2 mb-2">
                <span class={`text-2xl p-1.5 rounded-lg border ${item.iconBox}`} aria-hidden="true">{item.icon}</span>
                <div class="flex flex-col items-end gap-1">
                  <span class={`chip text-paper font-mono font-bold text-[10px] px-2 py-0.5 uppercase ${item.badgeClass}`}>{item.badge}</span>
                  <span class="pm-inbag-chip hidden chip bg-emerald-100 text-emerald-800 border-emerald-500 font-mono text-[9px] font-bold">🎒 IN BRIEF</span>
                </div>
              </div>
              <h3 class="font-pixel text-xs text-ink">{item.title}</h3>
              <p class={`font-mono text-[11px] font-bold mb-2 ${item.subtitleClass}`}>{item.subtitle}</p>
              <p class="text-xs text-ink-soft leading-relaxed mb-3">{item.desc}</p>
              <div class="flex flex-wrap gap-1 mb-4">
                {item.tags.map((tag) => (
                  <button type="button" class="chip text-[10px] pm-tag hover:bg-gold/60 cursor-pointer" data-tag={tag} title={`Search for ${tag}`}>
                    {tag}
                  </button>
                ))}
              </div>
            </div>

            <div class={`pt-3 border-t flex items-center justify-between gap-2 ${item.category === 'key' ? 'border-blue-200' : 'border-ink/10'}`}>
              <span class={`font-pixel text-xs font-bold ${item.price === 0 ? 'text-emerald-700' : item.price === null ? 'text-blue-900' : 'text-amber-700'}`}>
