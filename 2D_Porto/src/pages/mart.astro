      <div class="flex flex-col sm:flex-row sm:items-center gap-2">
        <label class="relative flex-1">
          <span class="sr-only">Search the catalog</span>
          <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-sm" aria-hidden="true">🔍</span>
          <input
            id="mart-search"
            type="search"
            autocomplete="off"
            placeholder="Search services, TMs, tech (e.g. TensorRT, Laravel, MQTT)…  press /"
