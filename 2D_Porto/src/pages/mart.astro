          </button>
          <a href={emailUrl} id="send-inquiry-email-btn" class="btn btn-sm btn-primary font-pixel text-xs flex items-center gap-1.5 shadow-md">
            <span aria-hidden="true">📨</span><span>Draft Email</span>
          </a>
        </div>
      </div>
