                    data-potion={item.potion}
                  >
                    {item.potion === 'coffee' ? '☕ Drink Now' : '🧪 Use Ether'}
                  </button>
                )}

                {item.cv && (
                  <a
                    href={cvUrl}
                    download="CV_Muhammad_Zulfan.pdf"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-sm btn-gold font-pixel text-[10px] flex items-center gap-1.5 shadow-sm pm-cv-link"
                  >
                    📥 Download CV
                  </a>
                )}

                {item.category === 'key' && item.link && (
                  <a href={item.link.href} class="btn btn-sm btn-paper font-pixel text-[10px]">{item.link.label}</a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>

      <div id="mart-empty" class="hidden text-center py-8 px-4 rounded-xl border-2 border-dashed border-ink/20 bg-cream/40">
        <div class="text-3xl mb-2" aria-hidden="true">🪙</div>
        <p class="font-pixel text-[11px] text-ink">Meowth searched every shelf… nothing matched.</p>
        <p class="text-xs text-ink-soft mt-1">Try another keyword or reset the filters.</p>
        <button type="button" id="mart-reset-filters" class="btn btn-sm btn-paper font-pixel text-[10px] mt-3">↺ Reset filters</button>
      </div>
    </section>

    <!-- ═══════════════ Bundles ═══════════════ -->
    <section class="window p-4 md:p-5 bg-paper border-2 space-y-4" aria-labelledby="pm-bundles-title">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 border-b-2 border-ink/15 pb-3">
        <div>
          <h2 id="pm-bundles-title" class="font-pixel text-xs text-ink uppercase tracking-wide flex items-center gap-2">
            <span aria-hidden="true">🎁</span>
            <span>Trainer Starter Packs</span>
          </h2>
          <p class="font-sans text-[11px] text-ink-soft mt-0.5">
            One click packs a curated combo. Complete any pack in your bag to unlock <strong class="text-ball">10% bundle savings</strong> on its priced services.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-3">
        {bundles.map((b) => (
          <article class={`pm-bundle p-3.5 rounded-xl border-2 flex flex-col justify-between gap-3 ${b.accent}`} data-bundle-id={b.id}>
            <div>
              <div class="flex items-center justify-between gap-2">
                <span class="text-2xl" aria-hidden="true">{b.icon}</span>
                <span class="pm-bundle-status chip font-mono text-[9px] font-bold bg-paper">0 / {b.items.length}</span>
              </div>
              <h3 class="font-pixel text-[11px] text-ink mt-1.5">{b.name}</h3>
              <p class="text-[11px] text-ink-soft leading-relaxed mt-1">{b.blurb}</p>
              <ul class="mt-2 space-y-0.5">
                {b.items.map((id) => (
                  <li class="text-[10px] font-mono text-ink flex items-center gap-1.5" data-bundle-item={id}>
                    <span class="pm-bundle-check" aria-hidden="true">○</span>
                    <span>{itemName(id)}</span>
                  </li>
                ))}
