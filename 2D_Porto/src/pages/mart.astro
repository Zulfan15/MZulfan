---
import TownLayout from '../layouts/TownLayout.astro';
import WhereTo from '../components/WhereTo.astro';
import TmReaderModal from '../components/TmReaderModal.astro';
import { profile } from '../lib/profile';

const githubUrl = profile.socials.find((s) => s.label === 'GitHub')?.url || 'https://github.com/Zulfan15';
const linkedinUrl = profile.socials.find((s) => s.label === 'LinkedIn')?.url || 'https://www.linkedin.com/in/muhammad-zulfan-anggadhiputra';
const emailUrl = `mailto:${profile.person.email}`;
const cvUrl = profile.person.cv || '/cv/CV_Zulfan.pdf';
---

<TownLayout place="mart" title="Poké Mart · Tech Services & Inventory — Muhammad Zulfan">
  <div class="space-y-8">
    <!-- Header Hero Banner -->
    <header class="window p-4 md:p-5 bg-gradient-to-br from-cream via-paper to-cream border-2">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b-2 border-ink/15 pb-4 mb-4">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-xl bg-blue-500/10 border-2 border-blue-600 flex items-center justify-center text-2xl shadow-sm">
            🏪
          </div>
          <div>
            <div class="eyebrow text-blue-600 flex items-center gap-1.5 font-bold">
              <span>TOWN COMMERCIAL DISTRICT</span>
              <span>•</span>
              <span>POKÉ MART STORE #01</span>
            </div>
            <h1 class="font-pixel text-base md:text-lg text-ink mt-0.5">
              Poké Mart · Tech Services & Inventory
            </h1>
          </div>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-blue-100 border border-blue-400 text-blue-900 font-mono text-[10px] font-bold">
            <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
            CLERK KEVIN ON DUTY
          </span>
          <button
            type="button"
            id="wallet-badge-btn"
            class="chip bg-amber-100 hover:bg-amber-200 text-amber-900 border-amber-400 font-mono text-xs px-2.5 py-1 font-bold cursor-pointer transition-colors"
            title="Click to check wallet balance"
          >
            💰 ₽ 9,999
          </button>
        </div>
      </div>

      <!-- Clerk Kevin & Meowth Dialogue Box -->
      <div class="flex flex-col md:flex-row gap-4 items-start">
        <div class="p-3.5 rounded-lg bg-paper border border-ink/20 flex-1 text-xs leading-relaxed text-ink-soft space-y-2.5">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-ink/10 pb-2">
            <p class="font-medium text-ink flex items-center gap-1.5">
              <span>👨‍💼</span>
              <strong>Clerk Kevin:</strong>
              <span class="text-[11px] font-mono text-blue-600 font-semibold">"Welcome to Zulfan's Poké Mart!"</span>
            </p>
            <div class="flex items-center gap-1.5">
              <button
                type="button"
                class="btn btn-sm btn-paper text-[10px] font-pixel btn-inspect-2d"
                data-prop="clerk"
                title="Navigate character to Clerk Kevin on 2D canvas"
              >
                📍 Kevin
              </button>
              <button
                type="button"
                class="btn btn-sm btn-paper text-[10px] font-pixel text-amber-700 font-bold border-amber-400 btn-inspect-2d"
                data-prop="meowth"
                title="Navigate character to Meowth on 2D canvas"
              >
                🪙 Meowth
              </button>
            </div>
          </div>
          <p>
            Looking to commission a high-speed Edge AI system? Need full-stack web engineering, custom IoT integrations, or want to pick up Zulfan's official credentials? Browse the catalog below, add items to your <strong>Project Inquiry Bag</strong>, or download Zulfan's official CV right from the Key Items shelf!
          </p>
          <div class="p-2 rounded bg-amber-50/90 border border-amber-300 text-amber-900 text-[11px] flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div class="flex items-center gap-2">
              <span class="text-base">🪙</span>
              <span><strong>Meowth's Amulet Coin:</strong> Adding services or sipping dev potions triggers the cashier register!</span>
            </div>
            <button
              type="button"
              id="btn-toss-coin-2d"
              class="btn btn-sm btn-gold text-[10px] font-pixel shrink-0 shadow-sm"
              title="Trigger Cash Register Cha-Ching Animation on 2D Canvas"
            >
              Cha-Ching FX ✨
            </button>
          </div>
        </div>
      </div>
    </header>

    <!-- Interactive Mart Quick Action Bar -->
    <nav class="window p-2.5 md:p-3 bg-slate-900/90 border-2 border-blue-500/50 flex flex-wrap items-center justify-between gap-2.5 shadow-md text-white" aria-label="Poké Mart Quick Actions">
      <div class="flex items-center gap-2 text-xs font-mono text-blue-300 font-bold">
        <span class="text-base">🏪</span>
        <span>QUICK ACTIONS:</span>
      </div>
      <div class="flex flex-wrap items-center gap-1.5" id="mart-quick-bar">
        <button type="button" class="mart-quick-btn btn btn-sm btn-paper font-pixel text-[10px]" data-quick="clerk" title="Talk to Clerk Kevin at Cashier Counter">
          👨‍💼 1. Clerk Kevin
        </button>
        <button type="button" class="mart-quick-btn btn btn-sm btn-paper font-pixel text-[10px] text-amber-700 font-bold border-amber-400" data-quick="meowth" title="Say hello to Meowth &amp; Amulet Coin">
          🪙 2. Meowth
        </button>
        <button type="button" class="mart-quick-btn btn btn-sm btn-paper font-pixel text-[10px]" data-quick="services-shelf" title="Inspect Engineering Services Shelf">
          🎒 3. Services
        </button>
        <button type="button" class="mart-quick-btn btn btn-sm btn-paper font-pixel text-[10px]" data-quick="tech-tms" title="Browse Technical TMs Shelf">
          💿 4. Tech TMs
        </button>
        <button type="button" class="mart-quick-btn btn btn-sm btn-paper font-pixel text-[10px]" data-quick="potions-shelf" title="Check Dev Potions &amp; Caffeine Fuel">
          🧪 5. Dev Potions
        </button>
        <button type="button" class="mart-quick-btn btn btn-sm btn-paper font-pixel text-[10px]" data-quick="key-showcase" title="Inspect Key Items &amp; Verified CV">
          🔑 6. Key Items &amp; CV
        </button>
        <button type="button" class="mart-quick-btn btn btn-sm btn-paper font-pixel text-[10px]" data-quick="drink-cooler" title="Inspect Drink Cooler">
          🥤 7. Drink Cooler
        </button>
      </div>
    </nav>

    <!-- Catalog Section with Category Filter Tabs -->
    <section class="window p-4 md:p-5 bg-paper border-2 space-y-5" id="mart-catalog">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 border-b-2 border-ink/15 pb-4">
        <div>
          <h2 class="font-pixel text-xs text-ink uppercase tracking-wide flex items-center gap-2">
            <span>📦</span>
            <span>Store Shelves & Technical Inventory</span>
          </h2>
          <p class="font-sans text-[11px] text-ink-soft mt-0.5">
            Select a department to view available technical services, skill TMs, developer perks, and credentials.
          </p>
        </div>

        <!-- Category Tabs -->
        <div class="flex flex-wrap gap-1.5" role="tablist" aria-label="Department categories">
          <button
            type="button"
            class="mart-tab-btn btn btn-sm btn-paper font-pixel text-[10px] active"
            data-mart-tab="all"
          >
            🌟 All (12)
          </button>
          <button
            type="button"
            class="mart-tab-btn btn btn-sm btn-paper font-pixel text-[10px]"
            data-mart-tab="services"
          >
            🎒 Services & Solutions (4)
          </button>
          <button
            type="button"
            class="mart-tab-btn btn btn-sm btn-paper font-pixel text-[10px]"
            data-mart-tab="tms"
          >
            💿 Technical TMs (4)
          </button>
          <button
            type="button"
            class="mart-tab-btn btn btn-sm btn-paper font-pixel text-[10px]"
            data-mart-tab="potions"
          >
            🧪 Dev Potions (2)
          </button>
          <button
            type="button"
            class="mart-tab-btn btn btn-sm btn-paper font-pixel text-[10px]"
            data-mart-tab="key"
          >
            🔑 Key Items & CV (2)
          </button>
        </div>
      </div>

      <!-- Item Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="mart-grid">
        <!-- 1. Edge AI & Computer Vision -->
        <article class="mart-card p-4 rounded-xl bg-cream/50 border-2 border-ink/20 flex flex-col justify-between hover:border-blue-500 transition-all shadow-sm" data-category="services">
          <div>
            <div class="flex items-start justify-between gap-2 mb-2">
              <span class="text-2xl p-1.5 rounded-lg bg-blue-100 border border-blue-300">🦅</span>
              <span class="chip bg-blue-600 text-paper border-blue-800 font-mono font-bold text-[10px] px-2 py-0.5 uppercase">
                AI / ML SERVICE
              </span>
            </div>
            <h3 class="font-pixel text-xs text-ink">Edge AI & Computer Vision</h3>
            <p class="font-mono text-[11px] text-blue-700 font-bold mb-2">AeroScan YOLOv11 + TensorRT</p>
            <p class="text-xs text-ink-soft leading-relaxed mb-3">
              Ultra-fast object detection and tracking optimized for edge computing (~1.8 ms/frame). Custom dataset annotation, model pruning, and FP16/INT8 TensorRT engine build.
            </p>
            <div class="flex flex-wrap gap-1 mb-4">
              <span class="chip text-[10px]">YOLOv11</span>
              <span class="chip text-[10px]">TensorRT</span>
              <span class="chip text-[10px]">PyTorch</span>
              <span class="chip text-[10px]">OpenCV</span>
              <span class="chip text-[10px]">CUDA</span>
            </div>
          </div>
          <div class="pt-3 border-t border-ink/10 flex items-center justify-between gap-2">
            <span class="font-pixel text-xs text-amber-700 font-bold">₽ 1,500 <span class="font-sans text-[10px] text-ink-soft font-normal">/ sprint</span></span>
            <button
              type="button"
              class="btn btn-sm btn-ball add-to-bag-btn text-[10px] font-pixel"
              data-item-id="srv-ai"
              data-item-name="Edge AI & Computer Vision Service"
              data-item-price="₽ 1,500"
            >
              ➕ Add to Brief
            </button>
          </div>
        </article>

        <!-- 2. Full-Stack Cloud Platform -->
        <article class="mart-card p-4 rounded-xl bg-cream/50 border-2 border-ink/20 flex flex-col justify-between hover:border-blue-500 transition-all shadow-sm" data-category="services">
          <div>
            <div class="flex items-start justify-between gap-2 mb-2">
              <span class="text-2xl p-1.5 rounded-lg bg-emerald-100 border border-emerald-300">🌐</span>
              <span class="chip bg-emerald-600 text-paper border-emerald-800 font-mono font-bold text-[10px] px-2 py-0.5 uppercase">
                FULL-STACK WEB
              </span>
            </div>
            <h3 class="font-pixel text-xs text-ink">Cloud-Native Web Systems</h3>
            <p class="font-mono text-[11px] text-emerald-700 font-bold mb-2">FoodLink & Modern Web Apps</p>
            <p class="text-xs text-ink-soft leading-relaxed mb-3">
              Scalable web architectures with clean domain design, spatial PostGIS queries, real-time event streaming via Kafka & Redis, and automated containerized CI/CD.
            </p>
            <div class="flex flex-wrap gap-1 mb-4">
              <span class="chip text-[10px]">Laravel 12</span>
              <span class="chip text-[10px]">TypeScript</span>
              <span class="chip text-[10px]">Astro</span>
              <span class="chip text-[10px]">PostGIS</span>
              <span class="chip text-[10px]">Redis</span>
              <span class="chip text-[10px]">Kafka</span>
            </div>
          </div>
          <div class="pt-3 border-t border-ink/10 flex items-center justify-between gap-2">
            <span class="font-pixel text-xs text-amber-700 font-bold">₽ 1,200 <span class="font-sans text-[10px] text-ink-soft font-normal">/ sprint</span></span>
            <button
              type="button"
              class="btn btn-sm btn-ball add-to-bag-btn text-[10px] font-pixel"
              data-item-id="srv-web"
              data-item-name="Cloud-Native Web Platform Service"
              data-item-price="₽ 1,200"
            >
              ➕ Add to Brief
            </button>
          </div>
        </article>

        <!-- 3. IoT & Embedded Systems -->
        <article class="mart-card p-4 rounded-xl bg-cream/50 border-2 border-ink/20 flex flex-col justify-between hover:border-blue-500 transition-all shadow-sm" data-category="services">
          <div>
            <div class="flex items-start justify-between gap-2 mb-2">
              <span class="text-2xl p-1.5 rounded-lg bg-purple-100 border border-purple-300">🤖</span>
              <span class="chip bg-purple-600 text-paper border-purple-800 font-mono font-bold text-[10px] px-2 py-0.5 uppercase">
                EMBEDDED / IOT
              </span>
            </div>
            <h3 class="font-pixel text-xs text-ink">IoT & Robotics Integration</h3>
            <p class="font-mono text-[11px] text-purple-700 font-bold mb-2">ITENAS Robotics Coordinator</p>
            <p class="text-xs text-ink-soft leading-relaxed mb-3">
              Hardware microcontroller prototyping, sensor fusion, MQTT telemetry, ROS robotics control, and end-to-end device-to-dashboard communication pipelines.
            </p>
            <div class="flex flex-wrap gap-1 mb-4">
              <span class="chip text-[10px]">ESP32</span>
              <span class="chip text-[10px]">STM32</span>
              <span class="chip text-[10px]">ROS</span>
              <span class="chip text-[10px]">MQTT</span>
              <span class="chip text-[10px]">C++ / MicroPython</span>
            </div>
          </div>
          <div class="pt-3 border-t border-ink/10 flex items-center justify-between gap-2">
            <span class="font-pixel text-xs text-amber-700 font-bold">₽ 1,000 <span class="font-sans text-[10px] text-ink-soft font-normal">/ project</span></span>
            <button
              type="button"
              class="btn btn-sm btn-ball add-to-bag-btn text-[10px] font-pixel"
              data-item-id="srv-iot"
              data-item-name="IoT & Robotics Integration Service"
              data-item-price="₽ 1,000"
            >
              ➕ Add to Brief
            </button>
          </div>
        </article>

        <!-- 4. Architecture Advisory & Code Review -->
        <article class="mart-card p-4 rounded-xl bg-cream/50 border-2 border-ink/20 flex flex-col justify-between hover:border-blue-500 transition-all shadow-sm" data-category="services">
          <div>
            <div class="flex items-start justify-between gap-2 mb-2">
              <span class="text-2xl p-1.5 rounded-lg bg-amber-100 border border-amber-300">🧠</span>
              <span class="chip bg-amber-600 text-paper border-amber-800 font-mono font-bold text-[10px] px-2 py-0.5 uppercase">
                ADVISORY & AUDIT
              </span>
            </div>
            <h3 class="font-pixel text-xs text-ink">System Architecture Advisory</h3>
            <p class="font-mono text-[11px] text-amber-800 font-bold mb-2">Code Review & Security Audit</p>
            <p class="text-xs text-ink-soft leading-relaxed mb-3">
              Comprehensive architectural audits, database indexing optimization, HCIA-certified network security review, Docker orchestration, and performance tuning.
            </p>
            <div class="flex flex-wrap gap-1 mb-4">
              <span class="chip text-[10px]">Docker</span>
              <span class="chip text-[10px]">HCIA-Security</span>
              <span class="chip text-[10px]">MySQL</span>
              <span class="chip text-[10px]">PostgreSQL</span>
              <span class="chip text-[10px]">Linux</span>
            </div>
          </div>
          <div class="pt-3 border-t border-ink/10 flex items-center justify-between gap-2">
            <span class="font-pixel text-xs text-amber-700 font-bold">₽ 800 <span class="font-sans text-[10px] text-ink-soft font-normal">/ session</span></span>
            <button
              type="button"
              class="btn btn-sm btn-ball add-to-bag-btn text-[10px] font-pixel"
              data-item-id="srv-advisory"
              data-item-name="System Architecture & Security Audit"
              data-item-price="₽ 800"
            >
              ➕ Add to Brief
            </button>
          </div>
        </article>

        <!-- 5. TM 01: PyTorch & Deep Learning -->
        <article class="mart-card p-4 rounded-xl bg-cream/50 border-2 border-ink/20 flex flex-col justify-between hover:border-blue-500 transition-all shadow-sm" data-category="tms">
          <div>
            <div class="flex items-start justify-between gap-2 mb-2">
              <span class="text-2xl p-1.5 rounded-lg bg-orange-100 border border-orange-300">💿</span>
              <span class="chip bg-orange-600 text-paper border-orange-800 font-mono font-bold text-[10px] px-2 py-0.5 uppercase">
                TM 01 · ML
              </span>
            </div>
            <h3 class="font-pixel text-xs text-ink">TM 01: PyTorch & Deep Learning</h3>
            <p class="font-mono text-[11px] text-orange-700 font-bold mb-2">Model Architecture & Training</p>
            <p class="text-xs text-ink-soft leading-relaxed mb-3">
              Deep convolutional neural networks, vision transformers, transfer learning workflows, and data augmentation pipelines.
            </p>
            <div class="flex flex-wrap gap-1 mb-4">
              <span class="chip text-[10px]">PyTorch</span>
              <span class="chip text-[10px]">Torchvision</span>
              <span class="chip text-[10px]">Weights & Biases</span>
            </div>
          </div>
          <div class="pt-3 border-t border-ink/10 flex items-center justify-between gap-2">
            <span class="font-pixel text-xs text-emerald-700 font-bold">FREE · OPEN</span>
            <div class="flex items-center gap-1.5">
              <button
                type="button"
                class="btn btn-sm btn-paper text-[10px] font-pixel text-blue-700 border-blue-400 inspect-tm-btn flex items-center gap-1 shadow-sm active:scale-95 transition-all"
                data-tm-id="tm-01"
                title="Inspect TM 01 Disc in Optical Reader"
              >
                <span>💿</span>
                <span>Inspect Disc</span>
              </button>
              <a href="/lab" class="btn btn-sm btn-paper text-[10px] font-pixel">
                🔬 Lab R&D
              </a>
            </div>
          </div>
        </article>

        <!-- 6. TM 02: TypeScript & Modern Astro -->
        <article class="mart-card p-4 rounded-xl bg-cream/50 border-2 border-ink/20 flex flex-col justify-between hover:border-blue-500 transition-all shadow-sm" data-category="tms">
          <div>
            <div class="flex items-start justify-between gap-2 mb-2">
              <span class="text-2xl p-1.5 rounded-lg bg-cyan-100 border border-cyan-300">💿</span>
              <span class="chip bg-cyan-600 text-paper border-cyan-800 font-mono font-bold text-[10px] px-2 py-0.5 uppercase">
                TM 02 · FRONTEND
              </span>
            </div>
            <h3 class="font-pixel text-xs text-ink">TM 02: TypeScript & Astro Islands</h3>
            <p class="font-mono text-[11px] text-cyan-700 font-bold mb-2">Zero-JS Runtime & Canvas 2D</p>
            <p class="text-xs text-ink-soft leading-relaxed mb-3">
              Type-safe full-stack web development with component islands, HTML5 Canvas game engines, and pixel-perfect responsive layouts.
            </p>
            <div class="flex flex-wrap gap-1 mb-4">
              <span class="chip text-[10px]">TypeScript 5</span>
              <span class="chip text-[10px]">Astro 5</span>
              <span class="chip text-[10px]">HTML5 Canvas</span>
            </div>
          </div>
          <div class="pt-3 border-t border-ink/10 flex items-center justify-between gap-2">
            <span class="font-pixel text-xs text-emerald-700 font-bold">FREE · OPEN</span>
            <div class="flex items-center gap-1.5">
              <button
                type="button"
                class="btn btn-sm btn-paper text-[10px] font-pixel text-blue-700 border-blue-400 inspect-tm-btn flex items-center gap-1 shadow-sm active:scale-95 transition-all"
                data-tm-id="tm-02"
                title="Inspect TM 02 Disc in Optical Reader"
              >
                <span>💿</span>
                <span>Inspect Disc</span>
              </button>
              <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-paper text-[10px] font-pixel">
                💻 GitHub
              </a>
            </div>
          </div>
        </article>

        <!-- 7. TM 03: Laravel 12 & Event Streaming -->
        <article class="mart-card p-4 rounded-xl bg-cream/50 border-2 border-ink/20 flex flex-col justify-between hover:border-blue-500 transition-all shadow-sm" data-category="tms">
          <div>
            <div class="flex items-start justify-between gap-2 mb-2">
              <span class="text-2xl p-1.5 rounded-lg bg-red-100 border border-red-300">💿</span>
              <span class="chip bg-red-600 text-paper border-red-800 font-mono font-bold text-[10px] px-2 py-0.5 uppercase">
                TM 03 · BACKEND
              </span>
            </div>
            <h3 class="font-pixel text-xs text-ink">TM 03: Laravel 12 & Microservices</h3>
            <p class="font-mono text-[11px] text-red-700 font-bold mb-2">Event-Driven Architecture</p>
            <p class="text-xs text-ink-soft leading-relaxed mb-3">
              Enterprise PHP/Laravel with PostGIS spatial data, Kafka streaming, Redis cache invalidation, and automated Pest unit tests.
            </p>
            <div class="flex flex-wrap gap-1 mb-4">
              <span class="chip text-[10px]">Laravel 12</span>
              <span class="chip text-[10px]">Kafka</span>
              <span class="chip text-[10px]">PostGIS</span>
              <span class="chip text-[10px]">Pest PHP</span>
            </div>
          </div>
          <div class="pt-3 border-t border-ink/10 flex items-center justify-between gap-2">
            <span class="font-pixel text-xs text-emerald-700 font-bold">FREE · OPEN</span>
            <div class="flex items-center gap-1.5">
              <button
                type="button"
                class="btn btn-sm btn-paper text-[10px] font-pixel text-blue-700 border-blue-400 inspect-tm-btn flex items-center gap-1 shadow-sm active:scale-95 transition-all"
                data-tm-id="tm-03"
                title="Inspect TM 03 Disc in Optical Reader"
              >
                <span>💿</span>
                <span>Inspect Disc</span>
              </button>
              <a href="/dev" class="btn btn-sm btn-paper text-[10px] font-pixel">
                🚀 Dev Center
              </a>
            </div>
          </div>
        </article>

        <!-- 8. TM 04: TensorRT & CUDA High-Performance -->
        <article class="mart-card p-4 rounded-xl bg-cream/50 border-2 border-ink/20 flex flex-col justify-between hover:border-blue-500 transition-all shadow-sm" data-category="tms">
          <div>
            <div class="flex items-start justify-between gap-2 mb-2">
              <span class="text-2xl p-1.5 rounded-lg bg-emerald-100 border border-emerald-300">💿</span>
              <span class="chip bg-emerald-600 text-paper border-emerald-800 font-mono font-bold text-[10px] px-2 py-0.5 uppercase">
                TM 04 · GPU / HPC
              </span>
            </div>
            <h3 class="font-pixel text-xs text-ink">TM 04: TensorRT & CUDA Engines</h3>
            <p class="font-mono text-[11px] text-emerald-700 font-bold mb-2">High-Throughput Inference</p>
            <p class="text-xs text-ink-soft leading-relaxed mb-3">
              Low-level GPU acceleration, FP16 quantization calibration, multi-stream parallel inference, and memory bandwidth optimization.
            </p>
            <div class="flex flex-wrap gap-1 mb-4">
              <span class="chip text-[10px]">NVIDIA TensorRT</span>
              <span class="chip text-[10px]">CUDA 12</span>
              <span class="chip text-[10px]">ONNX Runtime</span>
            </div>
          </div>
          <div class="pt-3 border-t border-ink/10 flex items-center justify-between gap-2">
            <span class="font-pixel text-xs text-emerald-700 font-bold">FREE · OPEN</span>
            <div class="flex items-center gap-1.5">
              <button
                type="button"
