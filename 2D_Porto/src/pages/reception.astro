<script>
  import { sfx } from '../game/sfx';

  // Interactive Healing Station Logic
  function initHealingStation() {
    const btnHeal = document.getElementById('btn-trigger-heal');
    const badge = document.getElementById('ball-count-badge');
    const feedback = document.getElementById('heal-feedback');
    const feedbackText = document.getElementById('heal-feedback-text');
    const slotElements = document.querySelectorAll<HTMLElement>('.healing-slot');

    function getBallCount(): number {
      try {
        const raw = localStorage.getItem('critters_inventory');
        if (raw) {
          const inv = JSON.parse(raw);
          return typeof inv.balls === 'number' ? inv.balls : 10;
        }
      } catch {}
      return 10;
    }

    function updateBadge() {
      if (badge) {
        const count = getBallCount();
        badge.textContent = `${count} / 10 Balls`;
        if (count <= 2) {
          badge.className = 'chip bg-amber-500 text-paper border-ink font-mono font-bold text-xs px-2 py-0.5';
        } else {
          badge.className = 'chip bg-ball text-paper border-ink font-mono font-bold text-xs px-2 py-0.5';
        }
      }
    }

    updateBadge();

    // Listen for refill events from engine or other components
    window.addEventListener('town:refill-balls', () => {
      executeHealingEffect(false);
    });

    function executeHealingEffect(triggerSound = true) {
      if (triggerSound) {
        sfx.heal();
      }

      // Sequentially animate the 6 slots
      slotElements.forEach((el, index) => {
        setTimeout(() => {
          el.style.backgroundColor = '#fecdd3';
          el.style.borderColor = '#e11d48';
          el.style.transform = 'scale(1.25)';
          setTimeout(() => {
            el.style.backgroundColor = '';
            el.style.borderColor = '';
            el.style.transform = '';
          }, 350);
        }, index * 90);
      });

      // Update localStorage inventory to 10 balls
      try {
        const raw = localStorage.getItem('critters_inventory');
        const inv = raw ? JSON.parse(raw) : {};
        inv.balls = 10;
        localStorage.setItem('critters_inventory', JSON.stringify(inv));
      } catch {}

      updateBadge();

      // Show feedback
      if (feedback && feedbackText) {
        feedback.classList.remove('hidden');
        feedbackText.textContent = '✨ All team members fully rested and 10 Poké Balls refilled!';
        setTimeout(() => {
          feedback.classList.add('hidden');
        }, 5000);
      }
    }

    if (btnHeal) {
      btnHeal.addEventListener('click', () => {
        executeHealingEffect(true);
        window.dispatchEvent(new CustomEvent('town:reception-heal-anim'));
      });
    }

    // Quick Action Bar click listeners
    const quickButtons = document.querySelectorAll<HTMLButtonElement>('.reception-quick-btn');
    quickButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const action = btn.getAttribute('data-quick');
        if (!action) return;

        if (action === 'healing-machine') {
          window.dispatchEvent(new CustomEvent('town:locate', { detail: { propId: 'healing-machine' } }));
          executeHealingEffect(true);
          window.dispatchEvent(new CustomEvent('town:reception-heal-anim'));
          return;
        }

        if (action === 'pc-terminal') {
          window.dispatchEvent(new CustomEvent('town:locate', { detail: { propId: 'pc-terminal' } }));
          window.dispatchEvent(new CustomEvent('reception:open-pc'));
          return;
        }

        window.dispatchEvent(new CustomEvent('town:locate', { detail: { propId: action } }));
        const townCanvas = document.querySelector('.town');
        if (townCanvas && window.innerWidth < 768) {
          townCanvas.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });

    // 💻 Launch Network PC button
    const btnOpenPc = document.getElementById('btn-trigger-open-pc');
    btnOpenPc?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('reception:open-pc'));
    });

    // 📍 Inspect in 2D buttons
    const inspectButtons = document.querySelectorAll<HTMLButtonElement>('.btn-inspect-2d');
    inspectButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const propId = btn.getAttribute('data-prop');
        if (!propId) return;

        window.dispatchEvent(new CustomEvent('town:locate', { detail: { propId } }));
        const townCanvas = document.querySelector('.town');
        if (townCanvas) {
          townCanvas.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      });
    });

    // 🎯 Recruiter Concierge Role-Fit Matcher Tabs
    const roleTabs = document.querySelectorAll<HTMLButtonElement>('.role-tab');
    const rolePanels = document.querySelectorAll<HTMLElement>('.role-panel');
    roleTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const role = tab.getAttribute('data-role');
        if (!role) return;

        sfx.select();

        // Reset all tabs
        roleTabs.forEach((t) => {
          t.className = 'role-tab card p-3 text-left transition-all cursor-pointer border-2 border-ink/20 hover:border-ink/50 bg-paper';
        });
        // Activate current tab
        tab.className = 'role-tab card p-3 text-left transition-all cursor-pointer border-2 border-ball bg-ball/5 ring-1 ring-ball shadow-sm';

        // Toggle role panels
        rolePanels.forEach((panel) => {
          panel.classList.add('hidden');
        });
        const targetPanel = document.getElementById(`role-panel-${role}`);
        if (targetPanel) {
          targetPanel.classList.remove('hidden');
        }
      });
    });

    // 📋 Campus Directory Category Filtering
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.directory-filter-btn');
    const directoryCards = document.querySelectorAll<HTMLElement>('.directory-card');
    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter') || 'all';
        sfx.select();

        // Update active filter styling
        filterButtons.forEach((b) => {
          b.className = 'directory-filter-btn chip bg-paper text-ink border-ink/20 hover:border-ink/50 font-mono text-[10px] px-2 py-0.5 cursor-pointer';
        });
        btn.className = 'directory-filter-btn chip bg-ball text-paper border-ink font-mono text-[10px] font-bold px-2 py-0.5 cursor-pointer';

        // Filter cards
        directoryCards.forEach((card) => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });

    // 📬 1-Click Copy Recruiter Email
    const btnCopyEmail = document.getElementById('btn-copy-recruiter-email') as HTMLButtonElement | null;
    const copyEmailLabel = document.getElementById('btn-copy-email-label');
    if (btnCopyEmail && copyEmailLabel) {
      btnCopyEmail.addEventListener('click', async () => {
        const email = btnCopyEmail.getAttribute('data-email') || 'zulfan.work@example.com';
        try {
          await navigator.clipboard.writeText(email);
          sfx.confirm();
          const originalText = copyEmailLabel.textContent || 'Copy Email';
          copyEmailLabel.textContent = '✨ Copied!';
          btnCopyEmail.classList.add('bg-emerald-100', 'text-emerald-800', 'border-emerald-400');

          setTimeout(() => {
            copyEmailLabel.textContent = originalText;
            btnCopyEmail.classList.remove('bg-emerald-100', 'text-emerald-800', 'border-emerald-400');
          }, 2500);
        } catch {
          // Fallback if clipboard API is blocked
          window.location.href = `mailto:${email}`;
        }
      });
    }
  }

  document.addEventListener('astro:page-load', initHealingStation);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHealingStation);
  } else {
    initHealingStation();
  }
</script>
