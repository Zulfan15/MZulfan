---

<TownLayout place="reception" title="Poké Center · Front Desk & Visitor Services — Muhammad Zulfan">
  <div class="space-y-8">
    <!-- Header Hero Banner -->
    <header class="window p-4 md:p-5 bg-gradient-to-br from-cream via-paper to-cream border-2">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b-2 border-ink/15 pb-4 mb-4">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-xl bg-ball/10 border-2 border-ball flex items-center justify-center text-2xl shadow-sm">
            🏥
          </div>
          <div>
            <div class="eyebrow text-ball flex items-center gap-1.5 font-bold">
              <span>DEV CENTER CAMPUS</span>
              <span>•</span>
              <span>POKÉ CENTER FRONT DESK</span>
            </div>
            <h1 class="font-pixel text-base md:text-lg text-ink mt-0.5">
              Visitor Services & Reception Desk
            </h1>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-100 border border-emerald-400 text-emerald-800 font-mono text-[10px] font-bold">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            MIRA ONLINE
          </span>
        </div>
      </div>

      <div class="flex flex-col md:flex-row gap-4 items-start">
        <div class="p-3 rounded-lg bg-paper border border-ink/20 flex-1 text-xs leading-relaxed text-ink-soft">
          <p class="font-medium text-ink mb-1.5">
            👋 <strong>Welcome to Muhammad Zulfan's Portfolio Town!</strong>
          </p>
          <p>
            I'm <strong>Nurse Mira</strong> at the Front Desk, together with medical assistant <strong>Chansey 🥚</strong>. Whether you need directions to the <a href="/dev" class="font-semibold text-ball underline">Dev Center</a>, want to inspect Zulfan's <a href="/lab" class="font-semibold text-ball underline">Research Lab</a>, challenge the bot in the <a href="/arcade" class="font-semibold text-ball underline">Arcade</a>, explore <a href="/tower" class="font-semibold text-ball underline">Tech Tower</a>, or refill your Poké Balls before catching critters in the tall grass, we're here to assist you!
          </p>
        </div>
      </div>
    </header>

    <!-- Interactive Quick Action Bar -->
    <nav class="window p-2.5 md:p-3 bg-slate-900/90 border-2 border-emerald-500/50 flex flex-wrap items-center justify-between gap-2.5 shadow-md text-white" aria-label="Poké Center Quick Actions">
      <div class="flex items-center gap-2 text-xs font-mono text-emerald-300 font-bold">
        <span class="text-base">🏥</span>
        <span>LOBBY STATIONS:</span>
      </div>
      <div class="flex flex-wrap items-center gap-1.5" id="reception-quick-bar">
        <button type="button" class="reception-quick-btn btn btn-sm btn-paper font-pixel text-[10px]" data-quick="mira" title="Talk to Nurse Mira at the Front Desk">
          👩‍⚕️ Mira
        </button>
        <button type="button" class="reception-quick-btn btn btn-sm btn-paper font-pixel text-[10px]" data-quick="chansey" title="Say hello to Chansey &amp; Lucky Egg">
          🥚 Chansey
        </button>
        <button type="button" class="reception-quick-btn btn btn-sm btn-paper font-pixel text-[10px]" data-quick="healing-machine" title="Refill Poké Balls &amp; Rest Party">
          💖 Heal
        </button>
        <button type="button" class="reception-quick-btn btn btn-sm btn-paper font-pixel text-[10px]" data-quick="partner-pod" title="Check Active Companion at Partner Care Pod">
          🐾 Partner Pod
        </button>
        <button type="button" class="reception-quick-btn btn btn-sm btn-paper font-pixel text-[10px]" data-quick="warp-globe" title="Inspect Holographic 13-Zone Town Globe">
          🌐 Holo Globe
        </button>
        <button type="button" class="reception-quick-btn btn btn-sm btn-paper font-pixel text-[10px]" data-quick="pc-terminal" title="Access Bill &amp; Lanette's Cloud PC V5.0">
          💻 Cloud PC
        </button>
        <button type="button" class="reception-quick-btn btn btn-sm btn-paper font-pixel text-[10px]" data-quick="triage-scanner" title="Inspect Live System Health &amp; Telemetry Scanner">
          🩺 Telemetry
        </button>
        <button type="button" class="reception-quick-btn btn btn-sm btn-paper font-pixel text-[10px]" data-quick="waiting-couch" title="Relax in the Visitor Lounge">
          🛋️ Lounge
        </button>
      </div>
    </nav>

    <!-- VIP Visitor Check-In & Concierge Route Recommender -->
    <section class="window p-4 md:p-5 bg-gradient-to-br from-slate-900 via-slate-900 to-indigo-950 border-2 border-sky-500/60 text-white space-y-3.5 shadow-lg" id="vip-checkin-section">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 border-b border-slate-700/80 pb-3">
        <div class="flex items-center gap-2.5">
          <span class="text-2xl p-1.5 rounded-lg bg-sky-950 border border-sky-500/50">🎫</span>
          <div>
            <div class="flex items-center gap-2">
              <h2 class="font-pixel text-xs text-sky-300 uppercase tracking-wide">
                VIP Visitor Check-In &amp; Route Concierge
              </h2>
              <span class="chip bg-emerald-500/20 text-emerald-300 border border-emerald-400/50 font-mono text-[9px] font-bold px-1.5 py-0.5">
                INSTANT ITINERARY
              </span>
            </div>
            <p class="font-sans text-[11px] text-slate-300 mt-0.5">
              Select your visit purpose for a curated 3-stop campus tour or launch the AI Job-Fit Scanner
            </p>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <button
            type="button"
            id="btn-reception-jobfit"
            class="btn btn-sm bg-amber-500 hover:bg-amber-400 text-slate-950 border border-amber-300 font-pixel text-[10px] px-3 py-1.5 flex items-center gap-1.5 font-bold cursor-pointer"
          >
            <span>🎯</span>
            <span>AI Job-Fit Scanner</span>
          </button>
          <button
            type="button"
            id="btn-reception-start-tour"
            class="btn btn-sm bg-sky-600 hover:bg-sky-500 text-white border border-sky-400 font-pixel text-[10px] px-3 py-1.5 flex items-center gap-1.5 cursor-pointer"
          >
            <span>🎬</span>
            <span>60s Auto-Tour</span>
          </button>
        </div>
      </div>

      <!-- Check-in Track Pills -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2" id="visitor-track-tabs">
        <button type="button" class="visitor-track-btn px-2.5 py-2 rounded-lg border-2 border-sky-400 bg-sky-950/80 text-left transition-all cursor-pointer" data-vtrack="recruiter">
          <div class="font-pixel text-[10px] text-white">💼 HR / Recruiter</div>
          <div class="font-mono text-[9px] text-sky-300 mt-0.5">Proof-of-Work &amp; CV</div>
        </button>
        <button type="button" class="visitor-track-btn px-2.5 py-2 rounded-lg border border-slate-700 bg-slate-950/70 hover:border-slate-500 text-left transition-all cursor-pointer" data-vtrack="peer">
          <div class="font-pixel text-[10px] text-slate-200">👨‍💻 Software Peer</div>
          <div class="font-mono text-[9px] text-slate-400 mt-0.5">Systems, Arch &amp; 2D</div>
        </button>
        <button type="button" class="visitor-track-btn px-2.5 py-2 rounded-lg border border-slate-700 bg-slate-950/70 hover:border-slate-500 text-left transition-all cursor-pointer" data-vtrack="ai">
          <div class="font-pixel text-[10px] text-slate-200">🔬 AI / Robotics</div>
          <div class="font-mono text-[9px] text-slate-400 mt-0.5">YOLOv8, SAHI &amp; ESP32</div>
        </button>
        <button type="button" class="visitor-track-btn px-2.5 py-2 rounded-lg border border-slate-700 bg-slate-950/70 hover:border-slate-500 text-left transition-all cursor-pointer" data-vtrack="explorer">
          <div class="font-pixel text-[10px] text-slate-200">🎮 Town Explorer</div>
          <div class="font-mono text-[9px] text-slate-400 mt-0.5">Badges, Minigames &amp; Pets</div>
        </button>
      </div>

      <!-- Tailored Route Output -->
      <div id="visitor-track-itinerary" class="p-3 rounded-xl bg-slate-950/80 border border-slate-700/80 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 text-xs">
        <div class="space-y-1">
          <div class="font-mono text-[10px] text-emerald-300 font-bold uppercase" id="vtrack-heading">
            Recommended 3-Stop Itinerary for Hiring Managers:
          </div>
          <div class="flex flex-wrap items-center gap-1.5 font-mono text-[11px]" id="vtrack-stops">
            <a href="/dev" class="px-2 py-0.5 rounded bg-slate-800 border border-sky-500/40 text-sky-200 hover:bg-sky-900 no-underline">1. 💻 Dev Center</a>
            <span class="text-slate-500">→</span>
            <a href="/lab" class="px-2 py-0.5 rounded bg-slate-800 border border-emerald-500/40 text-emerald-200 hover:bg-emerald-900 no-underline">2. 🔬 Research Lab</a>
            <span class="text-slate-500">→</span>
            <a href="/twin" class="px-2 py-0.5 rounded bg-slate-800 border border-violet-500/40 text-violet-200 hover:bg-violet-900 no-underline">3. 🧬 Digital Twin AI</a>
          </div>
        </div>
        <span class="font-mono text-[10px] text-amber-300 shrink-0" id="vtrack-tip">
          💡 Est. 3 mins total
        </span>
      </div>
    </section>

    <!-- Pokéball Refill & Healing Station 2.0 (+ Active Companion Status) -->
    <section class="window p-4 md:p-5 bg-paper border-2 space-y-4" id="healing-station-widget">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b-2 border-ink/15 pb-3">
        <div class="flex items-center gap-2.5">
          <span class="text-xl">✨</span>
          <div>
            <h2 class="font-pixel text-xs text-ink uppercase tracking-wide">
              Pokéball Healing Station 2.0 &amp; Partner Care
            </h2>
            <p class="font-sans text-[11px] text-ink-soft">
              Restore companion vitality, replenish 10 Poké Balls, or Overcharge to 15 Balls
            </p>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <span class="font-mono text-xs text-ink-soft">Inventory:</span>
          <span id="ball-count-badge" class="chip bg-ball text-paper border-ink font-mono font-bold text-xs px-2 py-0.5">
            10 / 10 Balls
          </span>
        </div>
      </div>

      <!-- Active Companion Live Status Strip -->
      <div class="p-3 rounded-xl bg-emerald-50/70 border border-emerald-300 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
        <div class="flex items-center gap-2.5">
          <span id="reception-partner-icon" class="text-2xl w-9 h-9 rounded-lg bg-white border border-emerald-300 flex items-center justify-center shadow-sm">🐾</span>
          <div>
            <div class="font-pixel text-[11px] text-ink flex items-center gap-1.5">
              <span>Active Companion:</span>
              <span id="reception-partner-name" class="text-emerald-800">None Selected</span>
            </div>
            <p id="reception-partner-title" class="font-mono text-[10px] text-ink-soft">
              Withdraw any Guardian Pokémon from Bill &amp; Lanette's Cloud PC Box!
            </p>
          </div>
        </div>
        <div class="flex items-center gap-1.5 shrink-0">
          <button
            type="button"
            id="btn-reception-switch-partner"
            class="btn btn-sm btn-paper text-[10px] font-pixel cursor-pointer"
          >
            📦 PC Box
          </button>
          <button
            type="button"
            class="btn btn-sm btn-paper text-[10px] font-pixel btn-inspect-2d"
            data-prop="partner-pod"
            title="Walk to Partner Care Pod in 2D"
          >
            📍 Care Pod
          </button>
        </div>
      </div>

      <!-- 6-Slot Visual Sequencer -->
      <div class="bg-cream/60 p-3.5 rounded-lg border border-ink/20 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-2.5">
          <span class="font-pixel text-[9px] text-ink-soft uppercase hidden sm:inline">Slots:</span>
          <div class="flex items-center gap-2" id="healing-slots-container">
            <div class="healing-slot w-7 h-7 rounded-full bg-paper border-2 border-ink flex items-center justify-center text-xs shadow-inner transition-transform" data-slot="0">🔴</div>
            <div class="healing-slot w-7 h-7 rounded-full bg-paper border-2 border-ink flex items-center justify-center text-xs shadow-inner transition-transform" data-slot="1">🔴</div>
            <div class="healing-slot w-7 h-7 rounded-full bg-paper border-2 border-ink flex items-center justify-center text-xs shadow-inner transition-transform" data-slot="2">🔴</div>
            <div class="healing-slot w-7 h-7 rounded-full bg-paper border-2 border-ink flex items-center justify-center text-xs shadow-inner transition-transform" data-slot="3">🔴</div>
            <div class="healing-slot w-7 h-7 rounded-full bg-paper border-2 border-ink flex items-center justify-center text-xs shadow-inner transition-transform" data-slot="4">🔴</div>
            <div class="healing-slot w-7 h-7 rounded-full bg-paper border-2 border-ink flex items-center justify-center text-xs shadow-inner transition-transform" data-slot="5">🔴</div>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <button
            type="button"
            id="btn-trigger-heal"
            class="btn btn-primary px-3.5 py-2 flex items-center justify-center gap-1.5 text-xs font-pixel shadow-sm hover:scale-[1.02] active:scale-95 transition-all cursor-pointer"
          >
            <span>💖</span>
            <span>Refill (10)</span>
          </button>
          <button
            type="button"
            id="btn-trigger-overcharge"
            class="btn btn-sm btn-gold px-3 py-2 flex items-center justify-center gap-1 text-[10px] font-pixel shadow-sm hover:scale-[1.02] active:scale-95 transition-all cursor-pointer"
            title="Chansey Overcharge: Boost bag capacity to 15 Poké Balls!"
          >
            <span>⚡</span>
            <span>Overcharge (15)</span>
          </button>
          <button
            type="button"
            class="btn btn-sm btn-paper text-[10px] font-pixel btn-inspect-2d"
            data-prop="healing-machine"
            title="Navigate character to Healing Machine on 2D canvas"
          >
            📍 2D
          </button>
        </div>
      </div>

      <!-- Feedback Toast -->
      <div id="heal-feedback" class="hidden p-2.5 rounded-lg bg-emerald-50 border border-emerald-300 text-emerald-800 text-xs font-sans flex items-center gap-2">
        <span>✨</span>
        <span id="heal-feedback-text">Your party is full of energy and your bag has been refilled to 10 Poké Balls!</span>
      </div>
    </section>

    <!-- Poké Center Network Storage Terminal (Bill & Lanette's Cloud PC V5.0) -->
    <section class="window p-4 md:p-5 bg-paper border-2 space-y-4" id="network-pc-section">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b-2 border-ink/15 pb-3">
        <div class="flex items-center gap-2.5">
          <span class="text-2xl p-1.5 rounded-lg bg-emerald-100 border border-emerald-300">💻</span>
          <div>
            <div class="flex items-center gap-2">
              <h2 class="font-pixel text-xs text-ink uppercase tracking-wide">
                Cloud PC Terminal · Bill &amp; Lanette V5.0
              </h2>
              <span class="chip bg-emerald-100 text-emerald-800 border-emerald-400 font-mono text-[9px] font-bold px-1.5 py-0.5">
                4-TAB CLOUD HUB
              </span>
            </div>
            <p class="font-sans text-[11px] text-ink-soft">
              Access Zulfan's verified Trainer Card, Partner Storage Box, live Safari Dex, and Cloud Guestbook
            </p>
