<script>
  import { sfx } from '../game/sfx';
  import { gameStore, type GymBadgeId } from '../game/store';
  import { COMPANIONS_MAP } from '../engine/pokemonCompanions';

  // Interactive Poké Center 2.0 Reception Logic
  function initReceptionHub() {
    const btnHeal = document.getElementById('btn-trigger-heal');
    const btnOvercharge = document.getElementById('btn-trigger-overcharge');
    const badge = document.getElementById('ball-count-badge');
    const feedback = document.getElementById('heal-feedback');
    const feedbackText = document.getElementById('heal-feedback-text');
    const slotElements = document.querySelectorAll<HTMLElement>('.healing-slot');

    function syncInventoryAndBadges() {
      const st = gameStore.getState();
      if (badge) {
        const count = st.balls;
        badge.textContent = count > 10 ? `${count} / 10⚡ Overcharged` : `${count} / 10 Balls`;
        if (count <= 2) {
          badge.className = 'chip bg-amber-500 text-paper border-ink font-mono font-bold text-xs px-2 py-0.5';
        } else if (count > 10) {
          badge.className = 'chip bg-emerald-600 text-paper border-ink font-mono font-bold text-xs px-2 py-0.5';
        } else {
          badge.className = 'chip bg-ball text-paper border-ink font-mono font-bold text-xs px-2 py-0.5';
        }
      }

      // Sync Directory Gym Badge Pills & Total Count
      const summaryEl = document.getElementById('directory-badge-summary');
      if (summaryEl) {
        summaryEl.textContent = `🏅 ${st.badges.length} / 8 Gym Badges Earned`;
      }
      document.querySelectorAll<HTMLElement>('.facility-badge-pill').forEach((pill) => {
        const bid = pill.getAttribute('data-badge-id') as GymBadgeId | null;
        if (!bid) return;
        const unlocked = st.badges.includes(bid);
        pill.className = unlocked
          ? 'facility-badge-pill chip bg-emerald-100 text-emerald-800 border-emerald-400 font-mono text-[9px] font-bold px-1.5 py-0.2'
          : 'facility-badge-pill chip bg-slate-100 text-slate-600 border-slate-300 font-mono text-[9px] px-1.5 py-0.2';
        if (unlocked && !pill.textContent?.includes('✓')) {
          pill.textContent = `${pill.textContent?.trim()} ✓`;
        }
      });
    }

    // Active Companion Strip Sync
    function syncActiveCompanion() {
      const iconEl = document.getElementById('reception-partner-icon');
      const nameEl = document.getElementById('reception-partner-name');
      const titleEl = document.getElementById('reception-partner-title');
      let activeId: string | null = null;
      try {
        activeId = localStorage.getItem('town:active_follower');
      } catch {}
      const info = activeId ? COMPANIONS_MAP[activeId] : undefined;
      if (info) {
        if (iconEl) iconEl.textContent = info.icon;
        if (nameEl) nameEl.textContent = `${info.name} (${info.title})`;
        if (titleEl) titleEl.textContent = `⚡ Signature Skill: ${info.skillName} — Ready to walk alongside you!`;
      } else {
        if (iconEl) iconEl.textContent = '🐾';
        if (nameEl) nameEl.textContent = 'None Selected';
        if (titleEl) titleEl.textContent = "Withdraw any Guardian Pokémon from Bill & Lanette's Cloud PC Box!";
      }
    }

    syncInventoryAndBadges();
    syncActiveCompanion();
    gameStore.subscribe(syncInventoryAndBadges);
    window.addEventListener('town:follower-changed', syncActiveCompanion);

    function executeHealingEffect(targetCount = 10, triggerSound = true) {
      if (triggerSound) sfx.heal();

      slotElements.forEach((el, index) => {
        setTimeout(() => {
          el.style.backgroundColor = targetCount > 10 ? '#bbf7d0' : '#fecdd3';
          el.style.borderColor = targetCount > 10 ? '#059669' : '#e11d48';
          el.style.transform = 'scale(1.25)';
          setTimeout(() => {
            el.style.backgroundColor = '';
            el.style.borderColor = '';
            el.style.transform = '';
          }, 350);
        }, index * 85);
      });

      gameStore.refillBalls(targetCount);
      try {
        const raw = localStorage.getItem('critters_inventory');
        const inv = raw ? JSON.parse(raw) : {};
        inv.balls = Math.max(typeof inv.balls === 'number' ? inv.balls : 0, targetCount);
        localStorage.setItem('critters_inventory', JSON.stringify(inv));
      } catch {}

      syncInventoryAndBadges();

      if (feedback && feedbackText) {
        feedback.classList.remove('hidden');
        feedbackText.textContent =
          targetCount > 10
            ? `⚡ Chansey Overcharge complete! Party healed & inventory boosted to ${targetCount} Poké Balls!`
            : '✨ All team members fully rested and 10 Poké Balls refilled!';
        setTimeout(() => {
          feedback.classList.add('hidden');
        }, 5000);
      }
    }

    window.addEventListener('town:refill-balls', () => executeHealingEffect(10, false));
    window.addEventListener('reception:overcharge-balls', () => {
      executeHealingEffect(15, true);
      window.dispatchEvent(new CustomEvent('town:reception-heal-anim'));
    });

    btnHeal?.addEventListener('click', () => {
      executeHealingEffect(10, true);
      window.dispatchEvent(new CustomEvent('town:reception-heal-anim'));
    });

    btnOvercharge?.addEventListener('click', () => {
      executeHealingEffect(15, true);
      window.dispatchEvent(new CustomEvent('town:reception-heal-anim'));
    });

    // VIP Visitor Check-In Tracks
    const VTRACK_DATA: Record<
      string,
      { heading: string; stops: { href: string; label: string; cls: string }[]; tip: string }
    > = {
      recruiter: {
        heading: 'Recommended 3-Stop Itinerary for Hiring Managers:',
        stops: [
          { href: '/dev', label: '1. 💻 Dev Center', cls: 'border-sky-500/40 text-sky-200 hover:bg-sky-900' },
          { href: '/lab', label: '2. 🔬 Research Lab', cls: 'border-emerald-500/40 text-emerald-200 hover:bg-emerald-900' },
          { href: '/twin', label: '3. 🧬 Digital Twin AI', cls: 'border-violet-500/40 text-violet-200 hover:bg-violet-900' },
        ],
        tip: '💡 Est. 3 mins total',
      },
      peer: {
        heading: 'Recommended Architecture Tour for Software Engineers:',
        stops: [
          { href: '/dev', label: '1. 💻 FoodLink & Kafka', cls: 'border-sky-500/40 text-sky-200 hover:bg-sky-900' },
          { href: '/tower', label: '2. 🏢 Huawei NOC Firewall', cls: 'border-cyan-500/40 text-cyan-200 hover:bg-cyan-900' },
          { href: '/', label: '3. 🛠️ Town Editor 5.0 (E)', cls: 'border-amber-500/40 text-amber-200 hover:bg-amber-900' },
        ],
        tip: '💡 Press E on Town Map',
      },
      ai: {
        heading: 'Recommended R&D Path for AI & Robotics Specialists:',
        stops: [
          { href: '/lab', label: '1. 🔬 YOLOv8 + SAHI UAV', cls: 'border-emerald-500/40 text-emerald-200 hover:bg-emerald-900' },
          { href: '/tower', label: '2. 🤖 ESP32 FreeRTOS Tank', cls: 'border-amber-500/40 text-amber-200 hover:bg-amber-900' },
          { href: '/arcade', label: '3. 🕹️ Deoxys Minimax AI', cls: 'border-rose-500/40 text-rose-200 hover:bg-rose-900' },
        ],
        tip: '💡 Live sandboxes inside',
      },
      explorer: {
        heading: 'Recommended Adventure Loop for World Explorers:',
        stops: [
          { href: '/arena', label: '1. ⚔️ Mewtwo Colosseum', cls: 'border-rose-500/40 text-rose-200 hover:bg-rose-900' },
          { href: '/garden', label: '2. 🌸 Berry Garden', cls: 'border-pink-500/40 text-pink-200 hover:bg-pink-900' },
          { href: '/digimon', label: '3. 👾 Digi-Sanctuary', cls: 'border-indigo-500/40 text-indigo-200 hover:bg-indigo-900' },
        ],
        tip: '💡 Collect all 8 Badges!',
      },
    };

    const vtrackBtns = document.querySelectorAll<HTMLButtonElement>('.visitor-track-btn');
    const vtrackHeading = document.getElementById('vtrack-heading');
    const vtrackStops = document.getElementById('vtrack-stops');
    const vtrackTip = document.getElementById('vtrack-tip');

    vtrackBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-vtrack') || 'recruiter';
        const cfg = VTRACK_DATA[key];
        if (!cfg) return;
        sfx.select();
        vtrackBtns.forEach((b) => {
          const isAct = b === btn;
          b.className = isAct
            ? 'visitor-track-btn px-2.5 py-2 rounded-lg border-2 border-sky-400 bg-sky-950/80 text-left transition-all cursor-pointer'
            : 'visitor-track-btn px-2.5 py-2 rounded-lg border border-slate-700 bg-slate-950/70 hover:border-slate-500 text-left transition-all cursor-pointer';
        });
        if (vtrackHeading) vtrackHeading.textContent = cfg.heading;
        if (vtrackTip) vtrackTip.textContent = cfg.tip;
        if (vtrackStops) {
          vtrackStops.innerHTML = cfg.stops
            .map(
              (s, i) =>
                `${i > 0 ? '<span class="text-slate-500">→</span>' : ''}<a href="${s.href}" class="px-2 py-0.5 rounded bg-slate-800 border ${s.cls} no-underline">${s.label}</a>`
            )
            .join('');
        }
      });
    });

    // AI Job-Fit & Guided Auto-Tour Triggers
    const openJobFit = () => {
      sfx.select();
      document.dispatchEvent(new CustomEvent('town:open-modal', { detail: { target: 'jobfit' } }));
    };
    document.getElementById('btn-reception-jobfit')?.addEventListener('click', openJobFit);
    document.getElementById('btn-concierge-jobfit')?.addEventListener('click', openJobFit);
    document.getElementById('btn-reception-start-tour')?.addEventListener('click', () => {
      sfx.confirm();
      sessionStorage.setItem('town:start_tour', '1');
      window.location.href = '/';
    });

    // Quick Action Bar click listeners
    const quickButtons = document.querySelectorAll<HTMLButtonElement>('.reception-quick-btn');
    quickButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const action = btn.getAttribute('data-quick');
        if (!action) return;

        if (action === 'healing-machine') {
          window.dispatchEvent(new CustomEvent('town:locate', { detail: { propId: 'healing-machine' } }));
          executeHealingEffect(10, true);
          window.dispatchEvent(new CustomEvent('town:reception-heal-anim'));
          return;
        }

        if (action === 'pc-terminal') {
          window.dispatchEvent(new CustomEvent('town:locate', { detail: { propId: 'pc-terminal' } }));
          window.dispatchEvent(new CustomEvent('reception:open-pc', { detail: { tab: 'card' } }));
          return;
        }

        if (action === 'waiting-couch') {
          window.dispatchEvent(new CustomEvent('town:locate', { detail: { propId: 'waiting-couch' } }));
          document.querySelector('#vip-lounge-section')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          return;
        }

        window.dispatchEvent(new CustomEvent('town:locate', { detail: { propId: action } }));
        const townCanvas = document.querySelector('.town');
        if (townCanvas && window.innerWidth < 768) {
          townCanvas.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });

    // Cloud PC V5.0 triggers
    document.getElementById('btn-trigger-open-pc')?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('reception:open-pc', { detail: { tab: 'card' } }));
    });
    const openPartnerBox = () => {
      window.dispatchEvent(new CustomEvent('reception:open-pc', { detail: { tab: 'partners' } }));
    };
    document.getElementById('btn-trigger-open-pc-box')?.addEventListener('click', openPartnerBox);
    document.getElementById('btn-reception-switch-partner')?.addEventListener('click', openPartnerBox);

    // Inspect in 2D buttons
    document.querySelectorAll<HTMLButtonElement>('.btn-inspect-2d').forEach((btn) => {
      btn.addEventListener('click', () => {
        const propId = btn.getAttribute('data-prop');
        if (!propId) return;
        window.dispatchEvent(new CustomEvent('town:locate', { detail: { propId } }));
        document.querySelector('.town')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    });

    // Recruiter Concierge Role-Fit Matcher Tabs
    const roleTabs = document.querySelectorAll<HTMLButtonElement>('.role-tab');
    const rolePanels = document.querySelectorAll<HTMLElement>('.role-panel');
    roleTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const role = tab.getAttribute('data-role');
        if (!role) return;
        sfx.select();
        roleTabs.forEach((t) => {
          t.className = 'role-tab card p-3 text-left transition-all cursor-pointer border-2 border-ink/20 hover:border-ink/50 bg-paper';
        });
        tab.className = 'role-tab card p-3 text-left transition-all cursor-pointer border-2 border-ball bg-ball/5 ring-1 ring-ball shadow-sm';
        rolePanels.forEach((panel) => panel.classList.add('hidden'));
        document.getElementById(`role-panel-${role}`)?.classList.remove('hidden');
      });
    });

    // Campus Directory Category Filter + Live Search
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.directory-filter-btn');
    const directoryCards = document.querySelectorAll<HTMLElement>('.directory-card');
    const dirSearchInput = document.getElementById('directory-search-input') as HTMLInputElement | null;
    const dirEmptyMsg = document.getElementById('directory-empty-msg');
    let activeDirCategory = 'all';

    function applyDirectoryFilter() {
      const q = (dirSearchInput?.value || '').trim().toLowerCase();
      let visibleCount = 0;
      directoryCards.forEach((card) => {
        const category = card.getAttribute('data-category');
        const haystack = card.getAttribute('data-search') || '';
        const catOk = activeDirCategory === 'all' || category === activeDirCategory;
        const queryOk = !q || haystack.includes(q);
        const show = catOk && queryOk;
        card.classList.toggle('hidden', !show);
        if (show) visibleCount++;
      });
      dirEmptyMsg?.classList.toggle('hidden', visibleCount > 0);
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeDirCategory = btn.getAttribute('data-filter') || 'all';
        sfx.select();
        filterButtons.forEach((b) => {
          b.className = 'directory-filter-btn chip bg-paper text-ink border-ink/20 hover:border-ink/50 font-mono text-[10px] px-2 py-0.5 cursor-pointer';
        });
        btn.className = 'directory-filter-btn chip bg-ball text-paper border-ink font-mono text-[10px] font-bold px-2 py-0.5 cursor-pointer';
        applyDirectoryFilter();
      });
    });

    dirSearchInput?.addEventListener('input', applyDirectoryFilter);

    // 1-Click Copy Recruiter Email
    const btnCopyEmail = document.getElementById('btn-copy-recruiter-email') as HTMLButtonElement | null;
    const copyEmailLabel = document.getElementById('btn-copy-email-label');
    if (btnCopyEmail && copyEmailLabel) {
      btnCopyEmail.addEventListener('click', async () => {
        const email = btnCopyEmail.getAttribute('data-email') || 'zulfan.work@example.com';
        try {
          await navigator.clipboard.writeText(email);
          sfx.confirm();
          const originalText = copyEmailLabel.textContent || 'Copy Email';
          copyEmailLabel.textContent = '✨ Copied!';
          btnCopyEmail.classList.add('bg-emerald-100', 'text-emerald-800', 'border-emerald-400');
          setTimeout(() => {
            copyEmailLabel.textContent = originalText;
            btnCopyEmail.classList.remove('bg-emerald-100', 'text-emerald-800', 'border-emerald-400');
          }, 2500);
        } catch {
          window.location.href = `mailto:${email}`;
        }
      });
    }

    // Portfolio Zine Issue Tabs
    const zineTabs = document.querySelectorAll<HTMLButtonElement>('.zine-tab');
    const zineArticles = document.querySelectorAll<HTMLElement>('.zine-article');
    zineTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const issue = tab.getAttribute('data-issue');
        if (!issue) return;
        sfx.select();
        zineTabs.forEach((t) => {
          t.className = 'zine-tab card p-3 text-left transition-all cursor-pointer border-2 border-ink/20 hover:border-ink/50 bg-paper';
        });
        tab.className = 'zine-tab card p-3 text-left transition-all cursor-pointer border-2 border-ball bg-ball/5 ring-1 ring-ball shadow-sm';
        zineArticles.forEach((article) => article.classList.add('hidden'));
        document.getElementById(`zine-article-${issue}`)?.classList.remove('hidden');
      });
    });

    // Lucky Egg Speed Buff Tracker
    const btnClaimLuckyEgg = document.getElementById('btn-claim-lucky-egg');
    const luckyEggBtnText = document.getElementById('lucky-egg-btn-text');
    const luckyEggBanner = document.getElementById('lucky-egg-active-banner');
    const luckyEggCountdown = document.getElementById('lucky-egg-countdown');

    let eggCountdownTimer: number | null = null;
    let secondsLeft = 0;

    function handleLuckyEggBuff(duration = 25) {
      secondsLeft = duration;
      luckyEggBanner?.classList.remove('hidden');
      if (luckyEggCountdown) luckyEggCountdown.textContent = `${secondsLeft}s remaining`;
      if (luckyEggBtnText) luckyEggBtnText.textContent = `✨ Active (${secondsLeft}s)`;
      if (eggCountdownTimer) clearInterval(eggCountdownTimer);

      eggCountdownTimer = window.setInterval(() => {
        secondsLeft--;
        if (secondsLeft <= 0) {
          if (eggCountdownTimer) clearInterval(eggCountdownTimer);
          eggCountdownTimer = null;
          luckyEggBanner?.classList.add('hidden');
          if (luckyEggBtnText) luckyEggBtnText.textContent = 'Claim Lucky Egg Buff';
        } else {
          if (luckyEggCountdown) luckyEggCountdown.textContent = `${secondsLeft}s remaining`;
          if (luckyEggBtnText) luckyEggBtnText.textContent = `✨ Active (${secondsLeft}s)`;
        }
      }, 1000);
    }

    btnClaimLuckyEgg?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('town:claim-lucky-egg'));
      sfx.confirm();
      handleLuckyEggBuff(25);
    });

    window.addEventListener('town:lucky-egg-boost', (e: Event) => {
      const customEvent = e as CustomEvent<{ duration: number }>;
      handleLuckyEggBuff(customEvent.detail?.duration || 25);
    });
  }

  document.addEventListener('astro:page-load', initReceptionHub);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initReceptionHub);
  } else {
    initReceptionHub();
  }
</script>
