---
import TownLayout from '../layouts/TownLayout.astro';
import WhereTo from '../components/WhereTo.astro';
import ChatBox from '../components/ChatBox.astro';
import NetworkPcModal from '../components/NetworkPcModal.astro';
import { profile } from '../lib/profile';

const githubUrl = profile.socials.find((s) => s.label === 'GitHub')?.url || 'https://github.com/Zulfan15';
const linkedinUrl = profile.socials.find((s) => s.label === 'LinkedIn')?.url || 'https://www.linkedin.com/in/muhammad-zulfan-anggadhiputra';
const emailUrl = `mailto:${profile.person.email}`;
---

<TownLayout place="reception" title="Poké Center · Front Desk & Visitor Services — Muhammad Zulfan">
  <div class="space-y-8">
    <!-- Header Hero Banner -->
    <header class="window p-4 md:p-5 bg-gradient-to-br from-cream via-paper to-cream border-2">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b-2 border-ink/15 pb-4 mb-4">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-xl bg-ball/10 border-2 border-ball flex items-center justify-center text-2xl shadow-sm">
            🏥
          </div>
          <div>
            <div class="eyebrow text-ball flex items-center gap-1.5 font-bold">
              <span>DEV CENTER CAMPUS</span>
              <span>•</span>
              <span>POKÉ CENTER FRONT DESK</span>
            </div>
            <h1 class="font-pixel text-base md:text-lg text-ink mt-0.5">
              Visitor Services & Reception Desk
            </h1>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-100 border border-emerald-400 text-emerald-800 font-mono text-[10px] font-bold">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            MIRA ONLINE
          </span>
        </div>
      </div>

      <div class="flex flex-col md:flex-row gap-4 items-start">
        <div class="p-3 rounded-lg bg-paper border border-ink/20 flex-1 text-xs leading-relaxed text-ink-soft">
          <p class="font-medium text-ink mb-1.5">
            👋 <strong>Welcome to Muhammad Zulfan's Portfolio Town!</strong>
          </p>
          <p>
            I'm <strong>Nurse Mira</strong> at the Front Desk, together with medical assistant <strong>Chansey 🥚</strong>. Whether you need directions to the <a href="/dev" class="font-semibold text-ball underline">Dev Center</a>, want to inspect Zulfan's <a href="/lab" class="font-semibold text-ball underline">Research Lab</a>, challenge the bot in the <a href="/arcade" class="font-semibold text-ball underline">Arcade</a>, explore <a href="/tower" class="font-semibold text-ball underline">Tech Tower</a>, or refill your Poké Balls before catching critters in the tall grass, we're here to assist you!
          </p>
        </div>
      </div>
    </header>

    <!-- Interactive Quick Action Bar -->
    <nav class="window p-2.5 md:p-3 bg-slate-900/90 border-2 border-emerald-500/50 flex flex-wrap items-center justify-between gap-2.5 shadow-md text-white" aria-label="Poké Center Quick Actions">
      <div class="flex items-center gap-2 text-xs font-mono text-emerald-300 font-bold">
        <span class="text-base">🏥</span>
        <span>QUICK ACTIONS:</span>
      </div>
      <div class="flex flex-wrap items-center gap-1.5" id="reception-quick-bar">
        <button type="button" class="reception-quick-btn btn btn-sm btn-paper font-pixel text-[10px]" data-quick="mira" title="Talk to Nurse Mira at the Front Desk">
          👩‍⚕️ 1. Nurse Mira
        </button>
        <button type="button" class="reception-quick-btn btn btn-sm btn-paper font-pixel text-[10px]" data-quick="chansey" title="Say hello to Chansey &amp; Lucky Egg">
          🥚 2. Chansey
        </button>
        <button type="button" class="reception-quick-btn btn btn-sm btn-paper font-pixel text-[10px]" data-quick="healing-machine" title="Refill Poké Balls &amp; Rest Party">
          💖 3. Healing Station
        </button>
        <button type="button" class="reception-quick-btn btn btn-sm btn-paper font-pixel text-[10px]" data-quick="pc-terminal" title="Access Network PC &amp; Critterdex">
          💻 4. Network PC
        </button>
        <button type="button" class="reception-quick-btn btn btn-sm btn-paper font-pixel text-[10px]" data-quick="directory-board" title="Read Campus Building Directory">
          📋 5. Directory
        </button>
        <button type="button" class="reception-quick-btn btn btn-sm btn-paper font-pixel text-[10px]" data-quick="waiting-couch" title="Relax in the Visitor Lounge">
          🛋️ 6. VIP Lounge
        </button>
      </div>
    </nav>

    <!-- Pokéball Refill & Healing Station Widget -->
    <section class="window p-4 md:p-5 bg-paper border-2 space-y-4" id="healing-station-widget">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b-2 border-ink/15 pb-3">
        <div class="flex items-center gap-2.5">
          <span class="text-xl">✨</span>
          <div>
            <h2 class="font-pixel text-xs text-ink uppercase tracking-wide">
              Pokéball Refill & Healing Machine
            </h2>
            <p class="font-sans text-[11px] text-ink-soft">
              Fully restore party status and replenish your inventory to 10 Poké Balls
            </p>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <span class="font-mono text-xs text-ink-soft">Inventory:</span>
          <span id="ball-count-badge" class="chip bg-ball text-paper border-ink font-mono font-bold text-xs px-2 py-0.5">
            10 / 10 Balls
          </span>
        </div>
      </div>

      <!-- 6-Slot Visual Sequencer -->
      <div class="bg-cream/60 p-3.5 rounded-lg border border-ink/20 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-2.5">
          <span class="font-pixel text-[9px] text-ink-soft uppercase hidden sm:inline">Slots:</span>
          <div class="flex items-center gap-2" id="healing-slots-container">
            <div class="healing-slot w-7 h-7 rounded-full bg-paper border-2 border-ink flex items-center justify-center text-xs shadow-inner transition-transform" data-slot="0">🔴</div>
            <div class="healing-slot w-7 h-7 rounded-full bg-paper border-2 border-ink flex items-center justify-center text-xs shadow-inner transition-transform" data-slot="1">🔴</div>
            <div class="healing-slot w-7 h-7 rounded-full bg-paper border-2 border-ink flex items-center justify-center text-xs shadow-inner transition-transform" data-slot="2">🔴</div>
            <div class="healing-slot w-7 h-7 rounded-full bg-paper border-2 border-ink flex items-center justify-center text-xs shadow-inner transition-transform" data-slot="3">🔴</div>
            <div class="healing-slot w-7 h-7 rounded-full bg-paper border-2 border-ink flex items-center justify-center text-xs shadow-inner transition-transform" data-slot="4">🔴</div>
            <div class="healing-slot w-7 h-7 rounded-full bg-paper border-2 border-ink flex items-center justify-center text-xs shadow-inner transition-transform" data-slot="5">🔴</div>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <button
            type="button"
            id="btn-trigger-heal"
            class="btn btn-primary w-full sm:w-auto px-4 py-2 flex items-center justify-center gap-2 text-xs font-pixel shadow-sm hover:scale-[1.02] active:scale-95 transition-all"
          >
            <span>💖</span>
            <span>Rest & Refill Balls</span>
          </button>
          <button
            type="button"
            class="btn btn-sm btn-paper text-[10px] font-pixel btn-inspect-2d"
            data-prop="healing-machine"
            title="Navigate character to Healing Machine on 2D canvas"
          >
            📍 Inspect 2D
          </button>
        </div>
      </div>

      <!-- Feedback Toast -->
      <div id="heal-feedback" class="hidden p-2.5 rounded-lg bg-emerald-50 border border-emerald-300 text-emerald-800 text-xs font-sans flex items-center gap-2">
        <span>✨</span>
        <span id="heal-feedback-text">Your party is full of energy and your bag has been refilled to 10 Poké Balls!</span>
      </div>
    </section>

    <!-- Poké Center Network Storage Terminal (Bill's PC V4.2) -->
    <section class="window p-4 md:p-5 bg-paper border-2 space-y-4" id="network-pc-section">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b-2 border-ink/15 pb-3">
        <div class="flex items-center gap-2.5">
          <span class="text-2xl p-1.5 rounded-lg bg-emerald-100 border border-emerald-300">💻</span>
          <div>
            <div class="flex items-center gap-2">
              <h2 class="font-pixel text-xs text-ink uppercase tracking-wide">
                Network PC Terminal · Bill's PC V4.2
              </h2>
              <span class="chip bg-emerald-100 text-emerald-800 border-emerald-400 font-mono text-[9px] font-bold px-1.5 py-0.5">
                ENCRYPTED
              </span>
            </div>
            <p class="font-sans text-[11px] text-ink-soft">
              Access Zulfan's verified Trainer Card, live Safari Dex telemetry, and visitor guestbook
            </p>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <button
            type="button"
            id="btn-trigger-open-pc"
            class="btn btn-primary text-xs font-pixel px-3.5 py-2 flex items-center gap-2 shadow-sm hover:scale-[1.02] active:scale-95 transition-all"
            title="Open Poké Center Network PC Terminal"
          >
            <span>💻</span>
            <span>Launch PC Terminal</span>
          </button>
          <button
            type="button"
            class="btn btn-sm btn-paper text-[10px] font-pixel btn-inspect-2d"
            data-prop="pc-terminal"
            title="Navigate character to Network PC on 2D canvas"
          >
            📍 Inspect 2D
          </button>
        </div>
      </div>

      <!-- Quick Snapshot Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div class="p-3 rounded-lg bg-cream/70 border border-ink/15 flex items-start gap-2.5">
          <span class="text-xl">🪪</span>
          <div class="min-w-0">
            <span class="font-pixel text-[11px] text-ink block">Trainer Card</span>
            <span class="font-mono text-[10px] text-ink-soft block">IDNo. 349400 · 8 Master Badges</span>
          </div>
        </div>

        <div class="p-3 rounded-lg bg-cream/70 border border-ink/15 flex items-start gap-2.5">
          <span class="text-xl">🐾</span>
          <div class="min-w-0">
            <span class="font-pixel text-[11px] text-ink block">Critter Safari Sync</span>
            <span class="font-mono text-[10px] text-ink-soft block">12 Wild Critters · Live Inventory</span>
          </div>
        </div>

        <div class="p-3 rounded-lg bg-cream/70 border border-ink/15 flex items-start gap-2.5">
          <span class="text-xl">📝</span>
          <div class="min-w-0">
            <span class="font-pixel text-[11px] text-ink block">Visitor Guestbook</span>
            <span class="font-mono text-[10px] text-ink-soft block">Reaction Stamps &amp; Recruiter Notes</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive AI Front Desk (Mira & Chansey) -->
    <section class="space-y-3">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <h2 class="section-title">
          <span>Front Desk AI · Ask Mira &amp; Chansey</span>
        </h2>
        <div class="flex items-center gap-1.5">
          <button
            type="button"
            class="btn btn-sm btn-paper text-[10px] font-pixel btn-inspect-2d"
            data-prop="mira"
            title="Navigate character to Nurse Mira on 2D canvas"
          >
            📍 Talk to Mira
          </button>
          <button
            type="button"
            class="btn btn-sm btn-paper text-[10px] font-pixel btn-inspect-2d text-pink-700 border-pink-400 font-bold"
            data-prop="chansey"
            title="Navigate character to Chansey on 2D canvas"
          >
            🥚 Chansey
          </button>
        </div>
      </div>

      <ChatBox persona="reception" />
    </section>

    <!-- Recruiter Concierge & Fast-Track Role-Fit Matcher -->
    <section class="window p-4 md:p-5 bg-paper border-2 space-y-4" id="recruiter-concierge">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b-2 border-ink/15 pb-3">
        <div class="flex items-center gap-2.5">
          <span class="text-2xl p-1.5 rounded-lg bg-amber-100 border border-amber-300">🎯</span>
          <div>
            <div class="flex items-center gap-2">
              <h2 class="font-pixel text-xs text-ink uppercase tracking-wide">
                Recruiter Concierge · Role-Fit Matcher
              </h2>
              <span class="chip bg-amber-400 text-slate-900 border-ink font-mono font-bold text-[9px] px-1.5 py-0.5">
                FAST-TRACK KIT
              </span>
            </div>
            <p class="font-sans text-[11px] text-ink-soft">
              Select your organization's hiring track to inspect Zulfan's verified alignment, stack depth, and proof-of-work
            </p>
          </div>
        </div>

        <!-- 1-Click Recruiter Tools -->
        <div class="flex items-center gap-2">
          <button
            type="button"
            id="btn-copy-recruiter-email"
            class="btn btn-sm btn-paper text-[10px] font-pixel flex items-center gap-1.5 hover:bg-slate-100 active:scale-95 transition-all"
            data-email={profile.person.email}
            title="Copy Zulfan's email address to clipboard"
          >
            <span>📬</span>
            <span id="btn-copy-email-label">Copy Email</span>
          </button>
          <a
            href={profile.person.cv || '/cv/CV_Zulfan.pdf'}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-sm btn-gold text-[10px] font-pixel flex items-center gap-1 hover:scale-[1.02] active:scale-95 transition-all"
            title="Download verified Curriculum Vitae (PDF)"
          >
            <span>📄</span>
            <span>CV (PDF)</span>
          </a>
        </div>
      </div>

      <!-- Role Selector Tabs -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5" id="role-selector-tabs">
        <!-- Tab 1: AI & Vision -->
        <button
          type="button"
          class="role-tab card p-3 text-left transition-all cursor-pointer border-2 border-ball bg-ball/5 ring-1 ring-ball shadow-sm"
          data-role="ai"
        >
          <div class="flex items-center justify-between mb-1.5">
            <span class="text-xl">🤖</span>
            <span class="chip bg-emerald-100 border-emerald-400 text-emerald-800 font-mono text-[9px] font-bold">
              99% Fit
            </span>
          </div>
          <div class="font-pixel text-xs text-ink">AI &amp; Computer Vision</div>
          <div class="font-mono text-[10px] text-ink-soft mt-0.5">YOLOv8 · SAHI · IndoSpam NLP</div>
        </button>

        <!-- Tab 2: Full-Stack & Cloud Security -->
        <button
          type="button"
          class="role-tab card p-3 text-left transition-all cursor-pointer border-2 border-ink/20 hover:border-ink/50 bg-paper"
          data-role="fullstack"
        >
          <div class="flex items-center justify-between mb-1.5">
            <span class="text-xl">🌐</span>
            <span class="chip bg-blue-100 border-blue-400 text-blue-800 font-mono text-[9px] font-bold">
              98% Fit
            </span>
          </div>
          <div class="font-pixel text-xs text-ink">Full-Stack &amp; Cloud Security</div>
          <div class="font-mono text-[10px] text-ink-soft mt-0.5">FastAPI · Kafka · Huawei HCIA</div>
        </button>

        <!-- Tab 3: Embedded IoT & Robotics -->
        <button
          type="button"
          class="role-tab card p-3 text-left transition-all cursor-pointer border-2 border-ink/20 hover:border-ink/50 bg-paper"
          data-role="robotics"
        >
          <div class="flex items-center justify-between mb-1.5">
            <span class="text-xl">📡</span>
            <span class="chip bg-amber-100 border-amber-400 text-amber-800 font-mono text-[9px] font-bold">
              97% Fit
            </span>
          </div>
          <div class="font-pixel text-xs text-ink">Embedded IoT &amp; Robotics</div>
          <div class="font-mono text-[10px] text-ink-soft mt-0.5">ESP32 · FreeRTOS · 6x TA Lead</div>
        </button>
      </div>

      <!-- Dynamic Role Detail Panels -->
      <div id="role-detail-container" class="p-4 rounded-xl bg-cream/70 border border-ink/20 space-y-4">
        <!-- Panel 1: AI & Computer Vision (Default Active) -->
        <div id="role-panel-ai" class="role-panel space-y-3.5">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-ink/10 pb-2.5">
            <div>
              <div class="font-pixel text-xs text-ink flex items-center gap-2">
                <span>🤖 AI &amp; Computer Vision Research Engineer</span>
                <span class="chip bg-emerald-100 text-emerald-800 border-emerald-300 font-mono text-[9px] font-bold">99% Fit</span>
              </div>
              <p class="font-sans text-[11px] text-ink-soft mt-0.5">
                Core Bachelor's Thesis Specialization · SINTA 2 Journal Publication · Aerial Slicing Inference
              </p>
            </div>
            <a href="/lab" class="btn btn-sm btn-primary text-[10px] font-pixel flex items-center gap-1.5 self-start sm:self-auto">
              <span>🔬</span>
              <span>Inspect Lab (/lab) →</span>
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-2.5 font-sans text-xs">
            <div class="p-3 rounded-lg bg-paper border border-ink/15 space-y-1">
              <div class="font-bold text-ink flex items-center gap-1.5 text-[11px]">
                <span>🎯</span>
                <span>AeroScan UAV Detection</span>
              </div>
              <p class="text-[11px] text-ink-soft leading-relaxed">
                Applied YOLOv8 + SAHI high-resolution sliced inference over drone orthomosaics, achieving a <strong>+18.4% mAP50 improvement</strong> on small aerial targets.
              </p>
            </div>

            <div class="p-3 rounded-lg bg-paper border border-ink/15 space-y-1">
              <div class="font-bold text-ink flex items-center gap-1.5 text-[11px]">
                <span>🧠</span>
                <span>IndoSpam RoBERTa / IndoBERT</span>
              </div>
              <p class="text-[11px] text-ink-soft leading-relaxed">
                Fine-tuned transformer models for Indonesian SMS spam classification, reaching <strong>99.56% F1-score</strong> with ONNX runtime quantization for edge deployment.
              </p>
            </div>

            <div class="p-3 rounded-lg bg-paper border border-ink/15 space-y-1">
              <div class="font-bold text-ink flex items-center gap-1.5 text-[11px]">
                <span>🎓</span>
                <span>Verified Credentials</span>
              </div>
              <p class="text-[11px] text-ink-soft leading-relaxed">
                B.S. in Computer Science from ITENAS Bandung (GPA <strong>3.49 / 4.00</strong>), author of SINTA 2 Pre-print on aerial drone CV, and Head of Lab Assistant team.
              </p>
            </div>
          </div>

          <div class="pt-1 flex flex-wrap items-center gap-1.5">
            <span class="font-mono text-[10px] text-ink-soft uppercase font-bold mr-1">Core Tech:</span>
            <span class="chip bg-paper border border-ink/20 font-mono text-[10px]">Python</span>
            <span class="chip bg-paper border border-ink/20 font-mono text-[10px]">PyTorch</span>
            <span class="chip bg-paper border border-ink/20 font-mono text-[10px]">YOLOv8</span>
            <span class="chip bg-paper border border-ink/20 font-mono text-[10px]">SAHI</span>
            <span class="chip bg-paper border border-ink/20 font-mono text-[10px]">OpenCV</span>
            <span class="chip bg-paper border border-ink/20 font-mono text-[10px]">IndoBERT</span>
            <span class="chip bg-paper border border-ink/20 font-mono text-[10px]">CUDA / TensorRT</span>
            <span class="chip bg-paper border border-ink/20 font-mono text-[10px]">Roboflow</span>
            <span class="chip bg-paper border border-ink/20 font-mono text-[10px]">FastAPI</span>
          </div>
        </div>

        <!-- Panel 2: Full-Stack & Cloud Security (Hidden Initially) -->
        <div id="role-panel-fullstack" class="role-panel hidden space-y-3.5">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-ink/10 pb-2.5">
            <div>
              <div class="font-pixel text-xs text-ink flex items-center gap-2">
                <span>🌐 Full-Stack &amp; Cloud Security Engineer</span>
                <span class="chip bg-blue-100 text-blue-800 border-blue-300 font-mono text-[9px] font-bold">98% Fit</span>
              </div>
              <p class="font-sans text-[11px] text-ink-soft mt-0.5">
                Distributed Microservices · Huawei HCIA-Security Certified · High-Performance Web
              </p>
            </div>
            <a href="/dev" class="btn btn-sm btn-primary text-[10px] font-pixel flex items-center gap-1.5 self-start sm:self-auto">
              <span>💻</span>
              <span>Inspect Dev Center (/dev) →</span>
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-2.5 font-sans text-xs">
            <div class="p-3 rounded-lg bg-paper border border-ink/15 space-y-1">
              <div class="font-bold text-ink flex items-center gap-1.5 text-[11px]">
                <span>⚡</span>
                <span>FoodLink Distributed Hub</span>
              </div>
              <p class="text-[11px] text-ink-soft leading-relaxed">
                Architected event-driven microservices using <strong>Apache Kafka</strong>, <strong>Redis</strong> pub/sub, <strong>FastAPI</strong>, and PostgreSQL with sub-50ms message delivery.
              </p>
            </div>

            <div class="p-3 rounded-lg bg-paper border border-ink/15 space-y-1">
              <div class="font-bold text-ink flex items-center gap-1.5 text-[11px]">
                <span>🛡️</span>
                <span>Huawei HCIA-Security V4.0</span>
              </div>
              <p class="text-[11px] text-ink-soft leading-relaxed">
                Certified in enterprise <strong>Next-Generation Firewalls (NGFW)</strong>, stateful inspection, ACL filtering, IPsec / SSL VPN tunnels, and perimeter defense.
              </p>
            </div>

            <div class="p-3 rounded-lg bg-paper border border-ink/15 space-y-1">
              <div class="font-bold text-ink flex items-center gap-1.5 text-[11px]">
                <span>🕹️</span>
                <span>Web Simulation & 60fps Canvas</span>
              </div>
              <p class="text-[11px] text-ink-soft leading-relaxed">
                Engineered custom 60fps retro canvas engine with Astro 4, TypeScript, Next.js 14, and WebSockets for real-time interactive multi-user spaces.
              </p>
            </div>
          </div>

          <div class="pt-1 flex flex-wrap items-center gap-1.5">
            <span class="font-mono text-[10px] text-ink-soft uppercase font-bold mr-1">Core Tech:</span>
            <span class="chip bg-paper border border-ink/20 font-mono text-[10px]">TypeScript</span>
            <span class="chip bg-paper border border-ink/20 font-mono text-[10px]">Next.js</span>
            <span class="chip bg-paper border border-ink/20 font-mono text-[10px]">Astro</span>
            <span class="chip bg-paper border border-ink/20 font-mono text-[10px]">FastAPI</span>
            <span class="chip bg-paper border border-ink/20 font-mono text-[10px]">PostgreSQL</span>
            <span class="chip bg-paper border border-ink/20 font-mono text-[10px]">Redis</span>
            <span class="chip bg-paper border border-ink/20 font-mono text-[10px]">Apache Kafka</span>
            <span class="chip bg-paper border border-ink/20 font-mono text-[10px]">Docker</span>
            <span class="chip bg-paper border border-ink/20 font-mono text-[10px]">Huawei NGFW</span>
