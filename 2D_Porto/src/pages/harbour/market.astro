---
import TownLayout from '../../layouts/TownLayout.astro';
import WhereTo from '../../components/WhereTo.astro';
import { profile } from '../../lib/profile';
import { MARITIME_SEALS_META } from '../../engine/harbourInteriorShared';

const allSeals = Object.values(MARITIME_SEALS_META);
const edu = profile.education[0];
const githubUrl = profile.socials.find((s) => s.label === 'GitHub')?.url || 'https://github.com/Zulfan15';
const linkedinUrl =
  profile.socials.find((s) => s.label === 'LinkedIn')?.url || 'https://www.linkedin.com/in/muhammad-zulfan-anggadhiputra';
const emailUrl = profile.socials.find((s) => s.label === 'Email')?.url || `mailto:${profile.person.email}`;

const appraisalContracts = [
  {
    id: 0,
    badge: 'COMMISSION I · REAL-TIME EDGE VISION',
    clientPrompt:
      'A harbor defense unit needs an aerial aircraft recognizer sustaining >60 FPS on an RTX 4060 laptop GPU.',
    options: [
      {
        label: 'YOLOv11s → ONNX → TensorRT 10 FP16 Engine (~1.8 ms/frame)',
        correct: true,
        feedback: '🌿 Celebi smiles: "Spot on! FP16 TensorRT 10 hits >500 FPS at just 22.1 MB weights!"',
      },
      {
        label: 'Send full uncompressed WAV radar sweeps via manual CSV upload hourly',
        correct: false,
        feedback: 'HerculesKabuterimon booms: "Too slow for real-time aircraft tracking! Choose TensorRT FP16."',
      },
    ],
  },
  {
    id: 1,
    badge: 'COMMISSION II · HIGH-CONCURRENCY RESCUE PLATFORM',
    clientPrompt:
      'A social food-rescue guild must prevent two volunteers from claiming the last meal box at the exact same millisecond.',
    options: [
      {
        label: 'Ignore transactions and overwrite JSON files directly over FTP',
        correct: false,
        feedback: 'Sakuyamon shakes her head: "Race conditions would double-book every claim!"',
      },
      {
        label: 'PostgreSQL 16 FOR UPDATE Locks + PostGIS Spatial Index + Redis 7 Lua Mutex',
        correct: true,
        feedback: '🌿 Celebi nods: "Atomic row locks + Redis Lua mutexes keep FoodLink zero-oversell (32/32 tests passing)!"',
      },
    ],
  },
  {
    id: 2,
    badge: 'COMMISSION III · OBFUSCATED SPAM FILTERING',
    clientPrompt:
      'Spam comments use look-alike glyphs, digit padding & emojis to evade ordinary keyword blacklists.',
    options: [
      {
        label: '1,000 TF-IDF Character Trigrams + 9 Statistical Signals + Random Forest (99.56% F1)',
        correct: true,
        feedback: '🌿 Celebi cheers: "All 3 Commissions verified! The Seal of the Guild is now officially yours!"',
      },
      {
        label: 'Block only comments longer than 5 words using a hardcoded regex list',
        correct: false,
        feedback: 'Sakuyamon warns: "Simple keyword lists miss obfuscated unicode tricks — hybrid TF-IDF trigrams catch 99.56%!"',
      },
    ],
  },
];
---

<TownLayout
  title="Dockside Market Pavilion — CV Charter & Appraisal | Harbour Town"
  description="Enter Dockside Market Pavilion (15×12) in Harbour Town: solve Celebi’s 3 Merchant Appraisal Scales contracts to claim the Seal of the Guild and download Zulfan’s CV."
  place="harbour-market"
>
  <article
    class="market-page space-y-6 pb-10 text-[#0f172a]"
    data-summary-text={`${profile.person.name} Credentials, CV Charter & Direct Commission — Dockside Market Pavilion guarded by Celebi, Sakuyamon & HerculesKabuterimon.`}
  >
    <!-- 1. COASTAL EXCHANGE & PAVILION HERO BANNER -->
    <header class="relative overflow-hidden rounded-2xl border-[3px] border-[#059669] bg-gradient-to-b from-[#f8f7ee] via-[#ebf2ea] to-[#d9e7dc] p-5 text-[#0f172a] shadow-[0_8px_0_#064e3b,0_18px_36px_rgba(5,150,105,0.28)]">
      <div
        class="pointer-events-none absolute inset-x-0 top-0 h-2 bg-[repeating-linear-gradient(90deg,#047857_0px,#047857_14px,#eab308_14px,#eab308_28px,#0284c7_28px,#0284c7_42px)]"
        aria-hidden="true"
      ></div>
      <div
        class="pointer-events-none absolute inset-x-0 bottom-0 h-2 bg-[repeating-linear-gradient(90deg,#0284c7_0px,#0284c7_14px,#eab308_14px,#eab308_28px,#047857_28px,#047857_42px)]"
        aria-hidden="true"
      ></div>

      <div class="relative z-10 mt-1 flex flex-wrap items-start justify-between gap-4">
        <div class="space-y-2">
          <div class="flex flex-wrap items-center gap-2">
            <span class="rounded-full border border-[#065f46] bg-[#064e3b] px-3 py-1 font-mono text-[10px] font-bold uppercase tracking-[0.14em] text-[#d1fae5]">
              ⛵ DOCKSIDE MARKET PAVILION · GUILD
            </span>
            <span
              id="mkt-seal-pill"
              class="rounded-full border border-[#d97706]/60 bg-[#fef3c7] px-2.5 py-1 font-mono text-[10px] font-bold uppercase text-[#78350f]"
            >
              ⏳ Seal Unclaimed
            </span>
          </div>
          <h1 class="font-display text-2xl font-black tracking-tight text-[#0f172a] sm:text-3xl">
            ⛵ Dockside Market Pavilion &amp; Envoy Exchange
          </h1>
          <p class="max-w-2xl text-sm leading-relaxed text-[#334155]">
            Paviliun batu pesisir berteras pasir emas &amp; kolam karang jernih, dijaga <strong class="text-[#059669]">Celebi</strong>,
            <strong class="text-[#b45309]">Sakuyamon</strong> &amp; <strong class="text-[#92400e]">HerculesKabuterimon</strong>.
            Selesaikan <strong>3 Kontrak Merchant Appraisal</strong> untuk mengklaim <strong class="text-[#059669]">Seal of the Guild</strong>, mengunduh CV, atau menghubungi Zulfan!
          </p>
        </div>

        <div class="flex flex-col items-end gap-2">
          <div class="grid grid-cols-3 gap-2 rounded-xl border-2 border-[#059669] bg-[#f8fafc] px-3 py-2 text-center font-mono shadow-inner">
            <div>
              <div class="text-[9px] font-bold uppercase text-[#047857]">APPRAISALS</div>
              <div id="hero-mkt-score" class="text-sm font-black text-[#0f172a]">0 / 3</div>
            </div>
            <div>
              <div class="text-[9px] font-bold uppercase text-[#047857]">GUILD</div>
              <div id="hero-mkt-state" class="text-sm font-black text-[#b45309]">TRADING</div>
            </div>
            <div>
              <div class="text-[9px] font-bold uppercase text-[#047857]">SEALS</div>
              <div id="hero-mkt-seals" class="text-sm font-black text-[#059669]">0 / 5</div>
            </div>
          </div>

          <div class="flex flex-wrap items-center justify-end gap-2">
            <button
              id="mkt-audio-toggle"
              type="button"
              class="cursor-pointer rounded-lg border-2 border-[#d97706] bg-[#fef3c7] px-2.5 py-1.5 font-mono text-[11px] font-bold text-[#78350f] transition hover:bg-[#fde68a]"
            >
              🔔 Scale Chime: ON
            </button>
            <a
              id="mkt-exit-btn"
              href="/harbour?from=market"
              class="inline-flex items-center gap-1.5 rounded-lg border-2 border-[#064e3b] bg-gradient-to-b from-[#059669] to-[#065f46] px-3 py-1.5 font-mono text-xs font-extrabold text-[#f8fafc] shadow-[0_3px_0_#022c22] transition hover:-translate-y-0.5 hover:brightness-110"
            >
              ⚓ Exit to Market
            </a>
          </div>
        </div>
      </div>

      <!-- Tri-Guardian Dialogue Switcher -->
      <div class="relative z-10 mt-4 flex flex-col gap-3 rounded-xl border-2 border-[#059669]/40 bg-[#f8fafc]/95 p-3.5 sm:flex-row sm:items-center">
        <div class="flex shrink-0 items-center gap-1.5">
          <button
            type="button"
            data-mkt-walk="celebi"
            data-speaker="🌿 Celebi · Guild Envoy across Time"
            data-quote="Good engineering stands the test of time! Match all 3 architectural briefs on the Guild Scales to earn the Seal of the Guild."
            data-fx-text="TIME TRADE BLESSING!"
            data-fx-color="#34d399"
            class="flex h-11 w-11 cursor-pointer items-center justify-center rounded-xl border-2 border-[#059669] bg-[#d1fae5] text-xl shadow-[0_2px_0_#064e3b] transition hover:-translate-y-0.5"
            title="Walk to Celebi"
          >
            🌿
          </button>
          <button
            type="button"
            data-mkt-walk="sakuyamon"
            data-speaker="🦊 Sakuyamon · Shrine Keeper of Credentials"
            data-quote="ITENAS Informatics (GPA 3.49/4.00), IDEA FEST 3 Bronze, and Huawei HCIA-Security V4.0 — inspect the CV Charter Stall anytime!"
            data-fx-text="AMETHYST SEAL VERIFIED!"
            data-fx-color="#fbbf24"
            class="flex h-11 w-11 cursor-pointer items-center justify-center rounded-xl border-2 border-[#d97706] bg-[#fef3c7] text-xl shadow-[0_2px_0_#92400e] transition hover:-translate-y-0.5"
            title="Walk to Sakuyamon"
          >
            🦊
          </button>
          <button
            type="button"
            data-mkt-walk="herculeskabuterimon"
            data-speaker="🪲 HerculesKabuterimon · Master of Craft"
            data-quote="Ready to hire or collaborate? Dispatch a courier via GitHub, LinkedIn, Email, or grab the Royal PDF Resume right below!"
            data-fx-text="GIGA SCISSOR CLAW!"
            data-fx-color="#f59e0b"
            class="flex h-11 w-11 cursor-pointer items-center justify-center rounded-xl border-2 border-[#b45309] bg-[#ffedd5] text-xl shadow-[0_2px_0_#7c2d12] transition hover:-translate-y-0.5"
            title="Walk to HerculesKabuterimon"
          >
            🪲
          </button>
        </div>

        <div class="min-w-0 flex-1">
          <div id="mkt-speaker" class="font-mono text-[10px] font-black uppercase tracking-wider text-[#047857]">
            🌿 Celebi · Guild Envoy across Time
          </div>
          <p id="mkt-dialogue" class="mt-0.5 text-xs italic leading-relaxed text-[#334155]">
            “Appraise all 3 Engineering Commissions below on the Guild Scales, then inspect Zulfan’s Royal CV &amp; Direct Contact Dispatch!”
          </p>
        </div>
      </div>

      <!-- 6 Quick-Walk Station Chips + Hotkeys -->
      <nav aria-label="Quick walk Market stations" class="relative z-10 mt-4 grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-6">
        <button
          type="button"
          data-mkt-walk="celebi"
          data-scroll-to="mkt-appraisal-trial"
          data-hotkey="c"
          class="mkt-station-btn flex cursor-pointer items-center justify-between gap-2 rounded-xl border-2 border-[#059669] bg-white px-2.5 py-2 text-left shadow-[0_2px_0_#064e3b] transition hover:-translate-y-0.5 hover:bg-[#ecfdf5]"
        >
          <span class="flex items-center gap-1.5 truncate text-xs font-bold text-[#0f172a]">
            <span>🌿</span>
            <span class="truncate">Celebi</span>
          </span>
          <kbd class="rounded border border-[#059669]/40 bg-[#d1fae5] px-1.5 py-0.5 font-mono text-[9px] font-bold text-[#065f46]">C</kbd>
        </button>

        <button
          type="button"
          data-mkt-walk="coral-tidepool"
          data-scroll-to="mkt-appraisal-trial"
          data-hotkey="t"
          class="mkt-station-btn flex cursor-pointer items-center justify-between gap-2 rounded-xl border-2 border-[#0284c7] bg-white px-2.5 py-2 text-left shadow-[0_2px_0_#0c4a6e] transition hover:-translate-y-0.5 hover:bg-[#f0f9ff]"
        >
          <span class="flex items-center gap-1.5 truncate text-xs font-bold text-[#0f172a]">
            <span>🐚</span>
            <span class="truncate">Coral Pool</span>
          </span>
          <kbd class="rounded border border-[#0284c7]/40 bg-[#e0f2fe] px-1.5 py-0.5 font-mono text-[9px] font-bold text-[#0c4a6e]">T</kbd>
        </button>

        <button
          type="button"
          data-mkt-walk="cv-charter-stall"
          data-scroll-to="mkt-credentials-section"
          data-hotkey="v"
          class="mkt-station-btn flex cursor-pointer items-center justify-between gap-2 rounded-xl border-2 border-[#d97706] bg-white px-2.5 py-2 text-left shadow-[0_2px_0_#92400e] transition hover:-translate-y-0.5 hover:bg-[#fffbeb]"
        >
          <span class="flex items-center gap-1.5 truncate text-xs font-bold text-[#0f172a]">
            <span>📜</span>
            <span class="truncate">CV Stall</span>
          </span>
          <kbd class="rounded border border-[#d97706]/40 bg-[#fef3c7] px-1.5 py-0.5 font-mono text-[9px] font-bold text-[#78350f]">V</kbd>
        </button>

        <button
          type="button"
          data-mkt-walk="pigeon-roost"
          data-scroll-to="mkt-credentials-section"
          data-hotkey="p"
          class="mkt-station-btn flex cursor-pointer items-center justify-between gap-2 rounded-xl border-2 border-[#0369a1] bg-white px-2.5 py-2 text-left shadow-[0_2px_0_#082f49] transition hover:-translate-y-0.5 hover:bg-[#f0f9ff]"
        >
          <span class="flex items-center gap-1.5 truncate text-xs font-bold text-[#0f172a]">
            <span>🕊️</span>
            <span class="truncate">Courier</span>
          </span>
          <kbd class="rounded border border-[#0369a1]/40 bg-[#e0f2fe] px-1.5 py-0.5 font-mono text-[9px] font-bold text-[#0c4a6e]">P</kbd>
        </button>

        <button
          type="button"
          data-mkt-walk="trade-ledger"
          data-scroll-to="mkt-appraisal-trial"
          data-hotkey="a"
          class="mkt-station-btn flex cursor-pointer items-center justify-between gap-2 rounded-xl border-2 border-[#92400e] bg-white px-2.5 py-2 text-left shadow-[0_2px_0_#451a03] transition hover:-translate-y-0.5 hover:bg-[#fffbeb]"
        >
          <span class="flex items-center gap-1.5 truncate text-xs font-bold text-[#0f172a]">
            <span>⚖️</span>
            <span class="truncate">Scales</span>
          </span>
          <kbd class="rounded border border-[#92400e]/40 bg-[#fef3c7] px-1.5 py-0.5 font-mono text-[9px] font-bold text-[#78350f]">A</kbd>
        </button>

        <button
          type="button"
          data-mkt-walk="pearl-counter"
          data-scroll-to="mkt-seals-ledger"
          data-hotkey="r"
          class="mkt-station-btn flex cursor-pointer items-center justify-between gap-2 rounded-xl border-2 border-[#0d9488] bg-white px-2.5 py-2 text-left shadow-[0_2px_0_#134e4a] transition hover:-translate-y-0.5 hover:bg-[#f0fdfa]"
        >
          <span class="flex items-center gap-1.5 truncate text-xs font-bold text-[#0f172a]">
            <span>🦪</span>
            <span class="truncate">Pearls</span>
          </span>
          <kbd class="rounded border border-[#0d9488]/40 bg-[#ccfbf1] px-1.5 py-0.5 font-mono text-[9px] font-bold text-[#115e59]">R</kbd>
        </button>
      </nav>
    </header>

    <!-- 2. MINI-GAME: MERCHANT'S APPRAISAL SCALES -->
    <section
      id="mkt-appraisal-trial"
      class="rounded-2xl border-[3px] border-[#059669] bg-gradient-to-b from-[#fffdf7] to-[#eef4ec] p-5 text-[#1e293b] shadow-[0_6px_0_#064e3b]"
    >
      <div class="flex flex-wrap items-center justify-between gap-3 border-b-2 border-[#059669]/20 pb-3">
        <div>
          <span class="font-mono text-[10px] font-bold uppercase tracking-[0.14em] text-[#047857]">
            TRIAL V · GUILD CONTRACT APPRAISAL
          </span>
          <h2 class="mt-0.5 font-display text-lg font-black text-[#0f172a]">
            ⚖️ Merchant’s Appraisal Scales — Match All 3 Engineering Briefs
          </h2>
        </div>

        <button
          id="btn-mkt-reset"
          type="button"
          class="cursor-pointer rounded-lg border-2 border-[#64748b] bg-white px-3 py-1 font-mono text-[11px] font-bold text-[#334155] transition hover:bg-[#f1f5f9]"
        >
          🔄 Reset Contracts
        </button>
      </div>

      <div class="mt-4 space-y-3">
        {appraisalContracts.map((c) => (
          <div data-contract-card={c.id} class="rounded-xl border-2 border-[#cbd5e1] bg-white p-4 shadow-sm">
            <div class="font-mono text-[9px] font-extrabold uppercase tracking-wider text-[#047857]">
              {c.badge}
            </div>
            <p class="mt-1 text-xs font-bold text-[#0f172a]">{c.clientPrompt}</p>

            <div class="mt-2.5 grid grid-cols-1 gap-2 sm:grid-cols-2">
              {c.options.map((opt) => (
                <button
                  type="button"
                  data-contract-choice={c.id}
                  data-is-correct={opt.correct ? '1' : '0'}
                  data-feedback={opt.feedback}
                  class="cursor-pointer rounded-lg border-2 border-[#cbd5e1] bg-[#f8fafc] px-3 py-2 text-left text-xs font-semibold text-[#1e293b] transition hover:border-[#059669] hover:bg-[#ecfdf5]"
                >
                  {opt.label}
                </button>
              ))}
            </div>

            <div data-contract-feedback={c.id} class="mt-2 hidden font-mono text-[11px]"></div>
          </div>
        ))}
      </div>

      <div
        id="mkt-trial-banner"
        class="mt-4 rounded-xl border-2 border-[#cbd5e1] bg-[#f8fafc] px-4 py-3 text-xs font-medium text-[#334155]"
      >
        ⚖️ Timbangan Saudagar: Cocokkan solusi terbaik untuk ketiga kontrak klien di atas.
      </div>
    </section>

    <!-- 3. CREDENTIALS, CV CHARTER & DIRECT COMMISSION -->
    <section
      id="mkt-credentials-section"
      class="rounded-2xl border-[3px] border-[#047857] bg-gradient-to-b from-[#faf8ef] to-[#e9efe4] p-5 text-[#1e293b] shadow-[0_6px_0_#064e3b]"
    >
      <div class="flex flex-wrap items-center justify-between gap-3 border-b-2 border-[#059669]/20 pb-3">
        <div>
          <span class="font-mono text-[10px] font-bold uppercase tracking-[0.14em] text-[#047857]">
            CREDENTIALS, ACADEMIC CHARTER &amp; ENVOYS
          </span>
          <h2 class="mt-0.5 font-display text-lg font-black text-[#0f172a]">
            📜 Royal CV Charter &amp; Direct Commission Desk
          </h2>
        </div>

        <a
          href={profile.person.cv}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-xl border-2 border-[#b45309] bg-gradient-to-b from-[#fbbf24] to-[#d97706] px-3.5 py-2 font-mono text-xs font-black text-[#1e1b18] shadow-[0_3px_0_#78350f] transition hover:-translate-y-0.5"
        >
          📄 Open Full CV (PDF) ↗
        </a>
      </div>

      <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
        <div class="rounded-xl border-2 border-[#0284c7]/50 bg-white p-4 shadow-sm">
          <div class="font-mono text-[9px] font-extrabold uppercase tracking-wider text-[#0369a1]">
            EDUCATION · DEGREE CHARTER
          </div>
          <h3 class="mt-1 text-sm font-black text-[#0f172a]">{edu?.degree || 'Bachelor of Informatics (S.Kom.)'}</h3>
          <div class="mt-0.5 font-mono text-xs font-bold text-[#0369a1]">
            {edu?.school || 'Institut Teknologi Nasional Bandung (ITENAS)'}
          </div>
          <div class="mt-1 font-mono text-xs font-black text-[#059669]">
            Cumulative GPA: {edu?.gpa || '3.49 / 4.00'} · Bandung, West Java
          </div>
          <ul class="mt-2 space-y-1 text-xs text-[#334155]">
            {(edu?.highlights || []).map((hl) => (
              <li class="flex items-start gap-1.5">
                <span class="mt-0.5 shrink-0 text-[10px] text-[#059669]">▸</span>
                <span>{hl}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="flex flex-col justify-between rounded-xl border-2 border-[#059669]/50 bg-white p-4 shadow-sm">
          <div>
            <div class="font-mono text-[9px] font-extrabold uppercase tracking-wider text-[#047857]">
              VERIFIED HONORS &amp; COURIER CHANNELS
            </div>
            <div class="mt-2 space-y-2">
              {profile.honors.map((hon) => (
                <div class="rounded-lg border border-[#d97706]/35 bg-[#fffbeb] p-2.5 text-xs">
                  <div class="font-black text-[#78350f]">🏅 {hon.title}</div>
                  <div class="font-mono text-[10px] text-[#92400e]">{hon.issuer} · {hon.date}</div>
                </div>
              ))}
            </div>
          </div>

          <div class="mt-3 flex flex-wrap gap-2 pt-2 border-t border-slate-200">
            <a
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-xs border border-[#334155] bg-[#0f172a] font-mono text-[10px] text-white hover:bg-[#1e293b]"
            >
              🐙 GitHub ↗
            </a>
            <a
              href={linkedinUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-xs border border-[#0284c7] bg-[#0c4a6e] font-mono text-[10px] text-white hover:bg-[#0369a1]"
            >
              💼 LinkedIn ↗
            </a>
            <a
              href={emailUrl}
              class="btn btn-xs border border-[#059669] bg-[#065f46] font-mono text-[10px] text-white hover:bg-[#047857]"
            >
              ✉️ Direct Email
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. 5 ROYAL MARITIME SEALS HARBOR LEDGER -->
    <section
      id="mkt-seals-ledger"
      class="rounded-2xl border-[3px] border-[#0c4a6e] bg-gradient-to-b from-[#f8f5ea] to-[#ecdfc0] p-5 text-[#1e293b] shadow-[0_6px_0_#082f49]"
    >
      <div class="flex flex-wrap items-center justify-between gap-2 pb-3">
        <div>
          <span class="font-mono text-[10px] font-bold uppercase tracking-[0.14em] text-[#0369a1]">
            AVALON ROYAL ADMIRALTY PROGRESS
          </span>
          <h2 class="mt-0.5 font-display text-lg font-black text-[#0f172a]">
            ⚓ 5 Royal Maritime Seals Ledger
          </h2>
        </div>
        <a
          href="/harbour#harbour-voyage-finale"
          class="rounded-lg border-2 border-[#0369a1] bg-[#e0f2fe] px-3 py-1 font-mono text-[11px] font-bold text-[#0c4a6e] hover:bg-[#bae6fd]"
        >
          Sail Sovereign Finale →
        </a>
      </div>

      <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-5">
        {allSeals.map((s) => (
          <a
            href={s.route}
            data-ledger-seal={s.key}
            class={`rounded-xl border-2 p-3 text-xs transition hover:-translate-y-0.5 ${
              s.key === 'guild'
                ? 'border-[#059669] bg-[#ecfdf5]'
                : 'border-[#cbd5e1] bg-white/85 hover:border-[#0369a1]'
            }`}
          >
            <div class="flex items-center justify-between">
              <span class="text-base">{s.icon}</span>
              <span data-ledger-badge={s.key} class="font-mono text-[10px] font-bold text-[#64748b]">
                🔒
              </span>
            </div>
            <div class="mt-1.5 font-bold text-[#0f172a]">{s.sanctum}</div>
            <div class="font-mono text-[9px] text-[#0369a1]">{s.name}</div>
          </a>
        ))}
      </div>
    </section>

    <WhereTo currentPath="/harbour/market" />
  </article>

  <script>
    import {
      MARITIME_SEALS_META,
      awardMaritimeSeal,
      countMaritimeSeals,
      getMaritimeSeals,
      type MaritimeSealKey,
    } from '../../engine/harbourInteriorShared';

    let audioEnabled = true;
    const solvedContracts = new Set<number>();

    function playMktTone(freq = 587.33, dur = 0.2) {
      if (!audioEnabled || typeof window === 'undefined') return;
      try {
        const Ctx = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
        if (!Ctx) return;
        const ctx = new Ctx();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(freq, ctx.currentTime);
        gain.gain.setValueAtTime(0.07, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + dur);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + dur);
      } catch {
        // ignore audio failure
      }
    }

    function triggerMktFx(text: string, color = '#34d399') {
      window.dispatchEvent(new CustomEvent('town:harbour-fx', { detail: { text, color } }));
    }

    function syncMktSealsUi() {
      const seals = getMaritimeSeals();
      const total = countMaritimeSeals();
      const countEl = document.getElementById('hero-mkt-seals');
      if (countEl) countEl.textContent = `${total} / 5`;

      const pill = document.getElementById('mkt-seal-pill');
      if (pill) {
        if (seals.guild) {
          pill.textContent = '✓ Seal of the Guild Claimed';
          pill.className = 'rounded-full border border-[#16a34a] bg-[#dcfce7] px-2.5 py-1 font-mono text-[10px] font-bold uppercase text-[#166534]';
        } else {
          pill.textContent = '⏳ Seal of the Guild Sealed';
          pill.className = 'rounded-full border border-[#d97706]/60 bg-[#fef3c7] px-2.5 py-1 font-mono text-[10px] font-bold uppercase text-[#78350f]';
        }
      }

      (Object.keys(MARITIME_SEALS_META) as MaritimeSealKey[]).forEach((k) => {
        const badge = document.querySelector<HTMLElement>(`[data-ledger-badge="${k}"]`);
        if (badge) badge.textContent = seals[k] ? '✓ CLAIMED' : '🔒 SEALED';
      });
    }

    function renderContractsUi() {
      const scoreEl = document.getElementById('hero-mkt-score');
      if (scoreEl) scoreEl.textContent = `${solvedContracts.size} / 3`;

      const stateEl = document.getElementById('hero-mkt-state');
      const bannerEl = document.getElementById('mkt-trial-banner');

      if (solvedContracts.size >= 3) {
        if (stateEl) {
          stateEl.textContent = 'CHARTERED';
          stateEl.className = 'text-sm font-black text-[#15803d]';
        }
        if (bannerEl) {
          bannerEl.className =
            'mt-4 rounded-xl border-2 border-[#16a34a] bg-[#dcfce7] px-4 py-3 text-xs font-bold text-[#14532d]';
          bannerEl.textContent =
            '⚖️ GUILD SCALES BALANCED! Ketiga komisi teknik terpenuhi — Seal of the Guild resmi tersemat!';
        }
        if (!getMaritimeSeals().guild) {
          awardMaritimeSeal('guild');
          triggerMktFx('GUILD SEAL EARNED!', '#fbbf24');
          playMktTone(783.99, 0.25);
          setTimeout(() => playMktTone(1046.5, 0.4), 140);
          syncMktSealsUi();
        }
      } else {
        if (stateEl) {
          stateEl.textContent = 'TRADING';
          stateEl.className = 'text-sm font-black text-[#b45309]';
        }
        if (bannerEl) {
          bannerEl.className =
            'mt-4 rounded-xl border-2 border-[#cbd5e1] bg-[#f8fafc] px-4 py-3 text-xs font-medium text-[#334155]';
          bannerEl.textContent = `⚖️ Timbangan Saudagar: ${solvedContracts.size}/3 kontrak teknik terverifikasi.`;
        }
      }
    }

    function wireMarketPage() {
      if (getMaritimeSeals().guild) {
        solvedContracts.add(0);
        solvedContracts.add(1);
        solvedContracts.add(2);
      }
      syncMktSealsUi();
      renderContractsUi();

      const exitBtn = document.getElementById('mkt-exit-btn');
      if (exitBtn && exitBtn.dataset.wired !== '1') {
        exitBtn.dataset.wired = '1';
        exitBtn.addEventListener('click', () => {
          try {
            sessionStorage.setItem('harbour:respawn', '7,34,down');
          } catch {}
        });
      }

      const audioBtn = document.getElementById('mkt-audio-toggle');
      if (audioBtn && audioBtn.dataset.wired !== '1') {
        audioBtn.dataset.wired = '1';
        audioBtn.addEventListener('click', () => {
          audioEnabled = !audioEnabled;
          audioBtn.textContent = audioEnabled ? '🔔 Scale Chime: ON' : '🔇 Scale Chime: OFF';
        });
      }

      document.querySelectorAll<HTMLButtonElement>('[data-contract-choice]').forEach((btn) => {
        if (btn.dataset.wired === '1') return;
        btn.dataset.wired = '1';
        btn.addEventListener('click', () => {
          const cid = Number(btn.getAttribute('data-contract-choice'));
          const ok = btn.getAttribute('data-is-correct') === '1';
          const feedback = btn.getAttribute('data-feedback') || '';
          const fbEl = document.querySelector<HTMLElement>(`[data-contract-feedback="${cid}"]`);
          const cardEl = document.querySelector<HTMLElement>(`[data-contract-card="${cid}"]`);

          if (fbEl) {
            fbEl.textContent = feedback;
            fbEl.className = ok
              ? 'mt-2 font-mono text-[11px] font-bold text-[#15803d]'
              : 'mt-2 font-mono text-[11px] font-bold text-[#b91c1c]';
          }
          if (ok) {
            solvedContracts.add(cid);
            cardEl?.classList.add('border-[#22c55e]', 'bg-[#f0fdf4]');
            playMktTone(587.33 + cid * 90, 0.2);
            triggerMktFx(`COMMISSION #${cid + 1} SEALED!`, '#34d399');
          } else {
            playMktTone(200, 0.25);
            triggerMktFx('RE-APPRAISE CONTRACT!', '#f87171');
          }
          renderContractsUi();
        });
      });

      const resetBtn = document.getElementById('btn-mkt-reset');
      if (resetBtn && resetBtn.dataset.wired !== '1') {
        resetBtn.dataset.wired = '1';
        resetBtn.addEventListener('click', () => {
          solvedContracts.clear();
          document.querySelectorAll<HTMLElement>('[data-contract-feedback]').forEach((f) => f.classList.add('hidden'));
          document.querySelectorAll<HTMLElement>('[data-contract-card]').forEach((c) => {
            c.classList.remove('border-[#22c55e]', 'bg-[#f0fdf4]');
          });
          playMktTone(349.23, 0.14);
          renderContractsUi();
        });
      }

      document.querySelectorAll<HTMLButtonElement>('[data-mkt-walk]').forEach((btn) => {
        if (btn.dataset.wired === '1') return;
        btn.dataset.wired = '1';
        btn.addEventListener('click', () => {
          const propId = btn.getAttribute('data-mkt-walk');
          const scrollTo = btn.getAttribute('data-scroll-to');
          const speaker = btn.getAttribute('data-speaker');
          const quote = btn.getAttribute('data-quote');
          const fxText = btn.getAttribute('data-fx-text');
          const fxColor = btn.getAttribute('data-fx-color');

          if (propId) {
            document.querySelector<HTMLButtonElement>(`.town-label[data-id="${propId}"]`)?.click();
          }
          if (speaker && quote) {
            const spEl = document.getElementById('mkt-speaker');
            const qtEl = document.getElementById('mkt-dialogue');
            if (spEl) spEl.textContent = speaker;
            if (qtEl) qtEl.textContent = `“${quote}”`;
          }
          if (fxText) triggerMktFx(fxText, fxColor || '#34d399');
          if (scrollTo) {
            document.getElementById(scrollTo)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      });
    }

    function handleMktHotkey(e: KeyboardEvent) {
      if (
        document.activeElement instanceof HTMLInputElement ||
        document.activeElement instanceof HTMLTextAreaElement ||
        e.metaKey ||
        e.ctrlKey ||
        e.altKey
      ) {
        return;
      }
      if (e.key === 'Escape') {
        (document.getElementById('mkt-exit-btn') as HTMLAnchorElement | null)?.click();
        return;
      }
      document.querySelector<HTMLButtonElement>(`.mkt-station-btn[data-hotkey="${e.key.toLowerCase()}"]`)?.click();
    }

    window.addEventListener('harbour:seal-updated', syncMktSealsUi);
    window.addEventListener('keydown', handleMktHotkey);

    wireMarketPage();
    document.addEventListener('astro:page-load', wireMarketPage);
  </script>
</TownLayout>
