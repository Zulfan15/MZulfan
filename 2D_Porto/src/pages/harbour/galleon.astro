---
import TownLayout from '../../layouts/TownLayout.astro';
import WhereTo from '../../components/WhereTo.astro';
import { profile } from '../../lib/profile';
import { MARITIME_SEALS_META } from '../../engine/harbourInteriorShared';

const allSeals = Object.values(MARITIME_SEALS_META);

const flagshipSystems = [
  {
    id: 'aeroscan',
    badge: 'FLAGSHIP EDGE AI · PERSONAL R&D',
    icon: '🛩️',
    title: 'AeroScan — Real-Time Tactical Aircraft Detector',
    accent: 'border-[#0284c7] bg-[#f0f9ff] text-[#0c4a6e]',
    metrics: ['~1.8 ms/frame', '>500 FPS RTX 4060', '87.9% max mAP@50'],
    highlights: [
      'ETL pipeline converting 12 GB PASCAL VOC CSV datasets into ~8,400 curated YOLO images.',
      'YOLOv11s trained in PyTorch 2.6 + AMP FP16, exported via ONNX into a 22.1 MB TensorRT 10 FP16 engine.',
      'Interactive Streamlit + OpenCV live telemetry command center with model hot-switching.',
    ],
  },
  {
    id: 'foodlink',
    badge: 'FLAGSHIP CLOUD-NATIVE · FULL-STACK',
    icon: '🍲',
    title: 'FoodLink — Concurrent Food-Surplus Rescue Platform',
    accent: 'border-[#059669] bg-[#ecfdf5] text-[#064e3b]',
    metrics: ['32/32 Tests Passing', 'PostGIS GIST', 'Kafka + Kubernetes'],
    highlights: [
      'Laravel 12 / PHP 8.3 API backed by PostgreSQL 16 FOR UPDATE row locks & PostGIS spatial indexing.',
      'Redis 7 Lua distributed mutexes + Apache Kafka transactional outbox with 3 async fan-out consumers.',
      'Dockerized Kubernetes HPA & /healthz RollingUpdates via GitLab CI/CD with OpenAPI 3.0 & QR handover.',
    ],
  },
  {
    id: 'avalon-engine',
    badge: 'CUSTOM GAME ENGINE · THIS PORTFOLIO',
    icon: '🎮',
    title: 'Avalon 2D RPG Town & Citadel Engine',
    accent: 'border-[#d97706] bg-[#fffbeb] text-[#78350f]',
    metrics: ['60 FPS Canvas 2D', '36 Static Routes', '60 Digimon + 39 PKM'],
    highlights: [
      'Multi-realm connected overworld engine linking Town Square, Digi-Sanctuary, Royal Kingdom, Dark Castle, Sky Castle & Harbour Town.',
      'Lazy offscreen room caching, PMD 4-dir spritesheets, HD 8-dir Chroma Slicer, and live Town Editor 5.0.',
      'Interactive NPC dialogue trees, WebAudio sound effects, and localStorage meta-progression crests & seals.',
    ],
  },
  {
    id: 'omr-suite',
    badge: 'COMMUNITY AUTOMATION · CV + WEB',
    icon: '📑',
    title: 'Automated OMR Grading Web System',
    accent: 'border-[#4f46e5] bg-[#eef2ff] text-[#1e1b4b]',
    metrics: ['FastAPI + OpenCV', 'Next.js + TS', 'Batch Excel Export'],
    highlights: [
      'End-to-end Optical Mark Recognition grading bulk scanned LJK sheets and multi-page PDFs in seconds.',
      'Perspective warp alignment, contour bubble intensity grading, and instant answer-key comparisons.',
      'Teacher analytics dashboard in Next.js + Tailwind CSS exporting clean class Excel spreadsheets.',
    ],
  },
];
---

<TownLayout
  title="The Sovereign Brigantine — Flagship Production Systems | Harbour Town"
  description="Board The Sovereign Brigantine (15×12) in Harbour Town: steer the brass helm & fire 3 Royal Salutes with Lord Admiral Neptunemon to claim the Seal of the Armada."
  place="harbour-galleon"
>
  <article
    class="galleon-page space-y-6 pb-10 text-[#0f172a]"
    data-summary-text={`${profile.person.name} Flagship Production Systems — The Sovereign Brigantine guarded by Neptunemon, Garchomp & MetalSeadramon.`}
  >
    <!-- 1. ADMIRAL FLAGSHIP HERO BANNER -->
    <header class="relative overflow-hidden rounded-2xl border-[3px] border-[#0284c7] bg-gradient-to-b from-[#f6f4ec] via-[#e9ecee] to-[#d6dee6] p-5 text-[#0f172a] shadow-[0_8px_0_#0c4a6e,0_18px_36px_rgba(12,74,110,0.34)]">
      <div
        class="pointer-events-none absolute inset-x-0 top-0 h-2 bg-[repeating-linear-gradient(90deg,#0c4a6e_0px,#0c4a6e_14px,#fbbf24_14px,#fbbf24_28px,#1e3a8a_28px,#1e3a8a_42px)]"
        aria-hidden="true"
      ></div>
      <div
        class="pointer-events-none absolute inset-x-0 bottom-0 h-2 bg-[repeating-linear-gradient(90deg,#1e3a8a_0px,#1e3a8a_14px,#fbbf24_14px,#fbbf24_28px,#0c4a6e_28px,#0c4a6e_42px)]"
        aria-hidden="true"
      ></div>

      <div class="relative z-10 mt-1 flex flex-wrap items-start justify-between gap-4">
        <div class="space-y-2">
          <div class="flex flex-wrap items-center gap-2">
            <span class="rounded-full border border-[#0c4a6e] bg-[#0c4a6e] px-3 py-1 font-mono text-[10px] font-bold uppercase tracking-[0.14em] text-[#e0f2fe]">
              🏴‍☠️ THE SOVEREIGN BRIGANTINE · FLAGSHIP
            </span>
            <span
              id="gal-seal-pill"
              class="rounded-full border border-[#d97706]/60 bg-[#fef3c7] px-2.5 py-1 font-mono text-[10px] font-bold uppercase text-[#78350f]"
            >
              ⏳ Seal Unclaimed
            </span>
          </div>
          <h1 class="font-display text-2xl font-black tracking-tight text-[#0f172a] sm:text-3xl">
            🏴‍☠️ Admiral’s Cabin &amp; Flagship Deck
          </h1>
          <p class="max-w-2xl text-sm leading-relaxed text-[#334155]">
            Selamat datang di atas kapal utama Armada Kerajaan Avalon, dijaga <strong class="text-[#0369a1]">Lord Admiral Neptunemon</strong> bersama
            <strong class="text-[#1d4ed8]">Garchomp</strong> &amp; <strong class="text-[#b45309]">MetalSeadramon</strong>.
            Kunci roda kemudi tepat di zona emas gelombang sebanyak <strong>3× Salvo Kehormatan</strong> untuk meraih <strong class="text-[#0284c7]">Seal of the Armada</strong>!
          </p>
        </div>

        <div class="flex flex-col items-end gap-2">
          <div class="grid grid-cols-3 gap-2 rounded-xl border-2 border-[#0284c7] bg-[#f8fafc] px-3 py-2 text-center font-mono shadow-inner">
            <div>
              <div class="text-[9px] font-bold uppercase text-[#0369a1]">SALVOS</div>
              <div id="hero-salvo-score" class="text-sm font-black text-[#0f172a]">0 / 3</div>
            </div>
            <div>
              <div class="text-[9px] font-bold uppercase text-[#0369a1]">HELM</div>
              <div id="hero-helm-state" class="text-sm font-black text-[#b45309]">AT ANCHOR</div>
            </div>
            <div>
              <div class="text-[9px] font-bold uppercase text-[#0369a1]">SEALS</div>
              <div id="hero-gal-seals" class="text-sm font-black text-[#059669]">0 / 5</div>
            </div>
          </div>

          <div class="flex flex-wrap items-center justify-end gap-2">
            <button
              id="gal-audio-toggle"
              type="button"
              class="cursor-pointer rounded-lg border-2 border-[#d97706] bg-[#fef3c7] px-2.5 py-1.5 font-mono text-[11px] font-bold text-[#78350f] transition hover:bg-[#fde68a]"
            >
              🔔 Cannon Audio: ON
            </button>
            <a
              id="gal-exit-btn"
              href="/harbour?from=galleon"
              class="inline-flex items-center gap-1.5 rounded-lg border-2 border-[#0c4a6e] bg-gradient-to-b from-[#0284c7] to-[#0369a1] px-3 py-1.5 font-mono text-xs font-extrabold text-[#f8fafc] shadow-[0_3px_0_#082f49] transition hover:-translate-y-0.5 hover:brightness-110"
            >
              ⚓ Exit to Pier
            </a>
          </div>
        </div>
      </div>

      <!-- Tri-Guardian Dialogue Switcher -->
      <div class="relative z-10 mt-4 flex flex-col gap-3 rounded-xl border-2 border-[#0284c7]/45 bg-[#f8fafc]/95 p-3.5 sm:flex-row sm:items-center">
        <div class="flex shrink-0 items-center gap-1.5">
          <button
            type="button"
            data-gal-walk="neptunemon"
            data-speaker="🔱 Neptunemon · Lord Admiral of Avalon"
            data-quote="Hold the brass wheel steady through the swell! Strike the Helm Timing Gauge inside the Sapphire Gold Zone 3 times to fire our broadside salute!"
            data-fx-text="VORTEX PENETRATION!"
            data-fx-color="#38bdf8"
            class="flex h-11 w-11 cursor-pointer items-center justify-center rounded-xl border-2 border-[#0284c7] bg-[#e0f2fe] text-xl shadow-[0_2px_0_#0c4a6e] transition hover:-translate-y-0.5"
            title="Walk to Neptunemon"
          >
            🔱
          </button>
          <button
            type="button"
            data-gal-walk="garchomp"
            data-speaker="🦈 Garchomp · High-Speed Striker"
            data-quote="From TensorRT jet aircraft detection at ~1.8 ms/frame to Kafka fan-out pipelines, inspect our 4 flagship systems on the War-Map!"
            data-fx-text="MACH JET CHARGE!"
            data-fx-color="#60a5fa"
            class="flex h-11 w-11 cursor-pointer items-center justify-center rounded-xl border-2 border-[#1d4ed8] bg-[#dbeafe] text-xl shadow-[0_2px_0_#1e3a8a] transition hover:-translate-y-0.5"
            title="Walk to Garchomp"
          >
            🦈
          </button>
          <button
            type="button"
            data-gal-walk="metalseadramon"
            data-speaker="🐉 MetalSeadramon · Iron Hull Guardian"
            data-quote="Full Digizoid armor meets zero-downtime engineering! Once all 5 Maritime Seals unite, visit /harbour to awaken Grand Admiral of Avalon!"
            data-fx-text="RIVER OF POWER!"
            data-fx-color="#fde047"
            class="flex h-11 w-11 cursor-pointer items-center justify-center rounded-xl border-2 border-[#d97706] bg-[#fef3c7] text-xl shadow-[0_2px_0_#92400e] transition hover:-translate-y-0.5"
            title="Walk to MetalSeadramon"
          >
            🐉
          </button>
        </div>

        <div class="min-w-0 flex-1">
          <div id="gal-speaker" class="font-mono text-[10px] font-black uppercase tracking-wider text-[#0369a1]">
            🔱 Neptunemon · Lord Admiral of Avalon
          </div>
          <p id="gal-dialogue" class="mt-0.5 text-xs italic leading-relaxed text-[#334155]">
            “Watch the Brass Helm Gauge below and lock heading in the Emerald-Gold target zone 3 times to unlock the Seal of the Armada!”
          </p>
        </div>
      </div>

      <!-- 6 Quick-Walk Station Chips + Hotkeys -->
      <nav aria-label="Quick walk Galleon stations" class="relative z-10 mt-4 grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-6">
        <button
          type="button"
          data-gal-walk="neptunemon"
          data-scroll-to="gal-helm-trial"
          data-hotkey="n"
          class="gal-station-btn flex cursor-pointer items-center justify-between gap-2 rounded-xl border-2 border-[#0284c7] bg-white px-2.5 py-2 text-left shadow-[0_2px_0_#0c4a6e] transition hover:-translate-y-0.5 hover:bg-[#e0f2fe]"
        >
          <span class="flex items-center gap-1.5 truncate text-xs font-bold text-[#0f172a]">
            <span>🔱</span>
            <span class="truncate">Neptunemon</span>
          </span>
          <kbd class="rounded border border-[#0284c7]/40 bg-[#e0f2fe] px-1.5 py-0.5 font-mono text-[9px] font-bold text-[#0c4a6e]">N</kbd>
        </button>

        <button
          type="button"
          data-gal-walk="brass-helm"
          data-scroll-to="gal-helm-trial"
          data-hotkey="h"
          class="gal-station-btn flex cursor-pointer items-center justify-between gap-2 rounded-xl border-2 border-[#d97706] bg-white px-2.5 py-2 text-left shadow-[0_2px_0_#92400e] transition hover:-translate-y-0.5 hover:bg-[#fffbeb]"
        >
          <span class="flex items-center gap-1.5 truncate text-xs font-bold text-[#0f172a]">
            <span>☸️</span>
            <span class="truncate">Ship Helm</span>
          </span>
          <kbd class="rounded border border-[#d97706]/40 bg-[#fef3c7] px-1.5 py-0.5 font-mono text-[9px] font-bold text-[#78350f]">H</kbd>
        </button>

        <button
          type="button"
          data-gal-walk="port-cannons"
          data-scroll-to="gal-helm-trial"
          data-hotkey="b"
          class="gal-station-btn flex cursor-pointer items-center justify-between gap-2 rounded-xl border-2 border-[#b91c1c] bg-white px-2.5 py-2 text-left shadow-[0_2px_0_#7f1d1d] transition hover:-translate-y-0.5 hover:bg-[#fef2f2]"
        >
          <span class="flex items-center gap-1.5 truncate text-xs font-bold text-[#0f172a]">
            <span>💣</span>
            <span class="truncate">Broadside</span>
          </span>
          <kbd class="rounded border border-[#b91c1c]/40 bg-[#fee2e2] px-1.5 py-0.5 font-mono text-[9px] font-bold text-[#991b1b]">B</kbd>
        </button>

        <button
          type="button"
          data-gal-walk="war-map"
          data-scroll-to="gal-flagship-section"
          data-hotkey="w"
          class="gal-station-btn flex cursor-pointer items-center justify-between gap-2 rounded-xl border-2 border-[#1e3a8a] bg-white px-2.5 py-2 text-left shadow-[0_2px_0_#1e3a8a] transition hover:-translate-y-0.5 hover:bg-[#eff6ff]"
        >
          <span class="flex items-center gap-1.5 truncate text-xs font-bold text-[#0f172a]">
            <span>🗺️</span>
            <span class="truncate">War Map</span>
          </span>
          <kbd class="rounded border border-[#1e3a8a]/40 bg-[#dbeafe] px-1.5 py-0.5 font-mono text-[9px] font-bold text-[#1e3a8a]">W</kbd>
        </button>

        <button
          type="button"
          data-gal-walk="treasure-chest"
          data-scroll-to="gal-flagship-section"
          data-hotkey="c"
          class="gal-station-btn flex cursor-pointer items-center justify-between gap-2 rounded-xl border-2 border-[#eab308] bg-white px-2.5 py-2 text-left shadow-[0_2px_0_#a16207] transition hover:-translate-y-0.5 hover:bg-[#fefce8]"
        >
          <span class="flex items-center gap-1.5 truncate text-xs font-bold text-[#0f172a]">
            <span>💎</span>
            <span class="truncate">Strongbox</span>
          </span>
          <kbd class="rounded border border-[#eab308]/40 bg-[#fef9c3] px-1.5 py-0.5 font-mono text-[9px] font-bold text-[#854d0e]">C</kbd>
        </button>

        <button
          type="button"
          data-gal-walk="ship-bell"
          data-scroll-to="gal-seals-ledger"
          data-hotkey="l"
          class="gal-station-btn flex cursor-pointer items-center justify-between gap-2 rounded-xl border-2 border-[#059669] bg-white px-2.5 py-2 text-left shadow-[0_2px_0_#064e3b] transition hover:-translate-y-0.5 hover:bg-[#ecfdf5]"
        >
          <span class="flex items-center gap-1.5 truncate text-xs font-bold text-[#0f172a]">
            <span>🔔</span>
            <span class="truncate">Deck Bell</span>
          </span>
          <kbd class="rounded border border-[#059669]/40 bg-[#d1fae5] px-1.5 py-0.5 font-mono text-[9px] font-bold text-[#065f46]">L</kbd>
        </button>
      </nav>
    </header>

    <!-- 2. MINI-GAME: HELM & BROADSIDE TIMING TRIAL -->
    <section
      id="gal-helm-trial"
      class="rounded-2xl border-[3px] border-[#0c4a6e] bg-gradient-to-b from-[#fffdf7] to-[#eef1f6] p-5 text-[#1e293b] shadow-[0_6px_0_#0c4a6e]"
    >
      <div class="flex flex-wrap items-center justify-between gap-3 border-b-2 border-[#0284c7]/20 pb-3">
        <div>
          <span class="font-mono text-[10px] font-bold uppercase tracking-[0.14em] text-[#0369a1]">
            TRIAL IV · ROYAL BROADSIDE STEERING
          </span>
          <h2 class="mt-0.5 font-display text-lg font-black text-[#0f172a]">
            ☸️ Helm &amp; Broadside Trial — Lock 3 Emerald-Zone Salvos
          </h2>
        </div>

        <button
          id="btn-gal-reset-helm"
          type="button"
          class="cursor-pointer rounded-lg border-2 border-[#64748b] bg-white px-3 py-1 font-mono text-[11px] font-bold text-[#334155] transition hover:bg-[#f1f5f9]"
        >
          🔄 Reset Salvos
        </button>
      </div>

      <p class="mt-3 text-xs leading-relaxed text-[#475569]">
        Tekan tombol <strong>"🔥 Fire Broadside Salvo!"</strong> tepat saat jarum kemudi melintasi <strong class="text-[#059669]">Zona Emas-Zamrud (36% – 64%)</strong> sebanyak <strong>3 kali</strong>!
      </p>

      <!-- Animated Helm Timing Track -->
      <div class="mt-4 rounded-xl border-2 border-[#0284c7] bg-[#0f172a] p-4 text-white">
        <div class="mb-2 flex items-center justify-between font-mono text-[10px] text-[#bae6fd]">
          <span>PORT SWELL (0°)</span>
          <span class="font-bold text-[#34d399]">🎯 TARGET SALVO ZONE (36%–64%)</span>
          <span>STARBOARD (100°)</span>
        </div>

        <div class="relative h-7 w-full overflow-hidden rounded-full border-2 border-[#334155] bg-[#1e293b]">
          <!-- Target Gold/Emerald Zone: left 36%, width 28% -->
          <div
            class="absolute inset-y-0 border-x-2 border-[#fde047] bg-gradient-to-r from-[#059669]/80 via-[#10b981]/90 to-[#059669]/80"
            style="left: 36%; width: 28%;"
          ></div>
          <!-- Moving Needle -->
          <div
            id="gal-helm-needle"
            class="absolute inset-y-0 w-2 -translate-x-1/2 rounded-full bg-[#fde047] shadow-[0_0_12px_#fde047]"
            style="left: 50%;"
          ></div>
        </div>

        <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-2 font-mono text-xs">
            <span class="text-[#94a3b8]">Salvos Landed:</span>
            <div class="flex gap-1.5">
              <span data-salvo-pip="1" class="inline-flex h-7 w-7 items-center justify-center rounded-lg border border-[#475569] bg-[#1e293b] text-xs">⚪</span>
              <span data-salvo-pip="2" class="inline-flex h-7 w-7 items-center justify-center rounded-lg border border-[#475569] bg-[#1e293b] text-xs">⚪</span>
              <span data-salvo-pip="3" class="inline-flex h-7 w-7 items-center justify-center rounded-lg border border-[#475569] bg-[#1e293b] text-xs">⚪</span>
            </div>
          </div>

          <button
            id="btn-gal-fire-salvo"
            type="button"
            class="cursor-pointer rounded-xl border-2 border-[#fbbf24] bg-gradient-to-r from-[#b45309] to-[#ea580c] px-4 py-2 font-['Press_Start_2P',monospace] text-[10px] text-[#fefce8] shadow-[0_3px_0_#78350f] transition active:translate-y-0.5 hover:brightness-110"
          >
            🔥 Fire Broadside Salvo!
          </button>
        </div>
      </div>

      <div
        id="gal-trial-banner"
        class="mt-4 rounded-xl border-2 border-[#cbd5e1] bg-[#f8fafc] px-4 py-3 text-xs font-medium text-[#334155]"
      >
        ☸️ Status Kemudi: Menunggu 3 tembakan tepat sasaran untuk mengklaim <strong>Seal of the Armada</strong>.
      </div>
    </section>

    <!-- 3. FLAGSHIP PRODUCTION SYSTEMS SHOWCASE -->
    <section
      id="gal-flagship-section"
      class="rounded-2xl border-[3px] border-[#0284c7] bg-gradient-to-b from-[#faf8f0] to-[#eae5d4] p-5 text-[#1e293b] shadow-[0_6px_0_#0c4a6e]"
    >
      <div class="flex flex-wrap items-center justify-between gap-2 border-b-2 border-[#0284c7]/20 pb-3">
        <div>
          <span class="font-mono text-[10px] font-bold uppercase tracking-[0.14em] text-[#0369a1]">
            ROYAL ADMIRAL WAR-MAP · PRODUCTION SYSTEMS
          </span>
          <h2 class="mt-0.5 font-display text-lg font-black text-[#0f172a]">
            🗺️ Flagship Engineering Fleet Showcase
          </h2>
        </div>
        <span class="rounded-full border border-[#0284c7]/40 bg-[#e0f2fe] px-3 py-1 font-mono text-[10px] font-bold text-[#0c4a6e]">
          End-to-End Architecture
        </span>
      </div>

      <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
        {flagshipSystems.map((sys) => (
          <article class={`rounded-xl border-2 p-4 shadow-sm ${sys.accent}`}>
            <div class="flex items-center justify-between gap-2">
              <span class="font-mono text-[9px] font-extrabold uppercase tracking-wider opacity-80">
                {sys.badge}
              </span>
              <span class="text-lg" aria-hidden="true">{sys.icon}</span>
            </div>
            <h3 class="mt-1 text-sm font-black">{sys.title}</h3>
            <div class="mt-2 flex flex-wrap gap-1.5">
              {sys.metrics.map((m) => (
                <span class="rounded-md border border-current/25 bg-white/80 px-2 py-0.5 font-mono text-[10px] font-bold">
                  {m}
                </span>
              ))}
            </div>
            <ul class="mt-2.5 space-y-1 text-xs leading-relaxed">
              {sys.highlights.map((hl) => (
                <li class="flex items-start gap-1.5">
                  <span class="mt-0.5 shrink-0 text-[10px]">▸</span>
                  <span>{hl}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <!-- 4. 5 ROYAL MARITIME SEALS HARBOR LEDGER -->
    <section
      id="gal-seals-ledger"
      class="rounded-2xl border-[3px] border-[#0c4a6e] bg-gradient-to-b from-[#f8f5ea] to-[#ecdfc0] p-5 text-[#1e293b] shadow-[0_6px_0_#082f49]"
    >
      <div class="flex flex-wrap items-center justify-between gap-2 pb-3">
        <div>
          <span class="font-mono text-[10px] font-bold uppercase tracking-[0.14em] text-[#0369a1]">
            AVALON ROYAL ADMIRALTY PROGRESS
          </span>
          <h2 class="mt-0.5 font-display text-lg font-black text-[#0f172a]">
            ⚓ 5 Royal Maritime Seals Ledger
          </h2>
        </div>
        <a
          href="/harbour#harbour-voyage-finale"
          class="rounded-lg border-2 border-[#0369a1] bg-[#e0f2fe] px-3 py-1 font-mono text-[11px] font-bold text-[#0c4a6e] hover:bg-[#bae6fd]"
        >
          Sail Sovereign Finale →
        </a>
      </div>

      <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-5">
        {allSeals.map((s) => (
          <a
            href={s.route}
            data-ledger-seal={s.key}
            class={`rounded-xl border-2 p-3 text-xs transition hover:-translate-y-0.5 ${
              s.key === 'armada'
                ? 'border-[#0284c7] bg-[#e0f2fe]'
                : 'border-[#cbd5e1] bg-white/85 hover:border-[#0369a1]'
            }`}
          >
            <div class="flex items-center justify-between">
              <span class="text-base">{s.icon}</span>
              <span data-ledger-badge={s.key} class="font-mono text-[10px] font-bold text-[#64748b]">
                🔒
              </span>
            </div>
            <div class="mt-1.5 font-bold text-[#0f172a]">{s.sanctum}</div>
            <div class="font-mono text-[9px] text-[#0369a1]">{s.name}</div>
          </a>
        ))}
      </div>
    </section>

    <WhereTo currentPath="/harbour/galleon" />
  </article>

  <script>
    import {
      MARITIME_SEALS_META,
      awardMaritimeSeal,
      countMaritimeSeals,
      getMaritimeSeals,
      type MaritimeSealKey,
    } from '../../engine/harbourInteriorShared';

    let audioEnabled = true;
    let salvosHit = 0;
    let helmPos = 50;
    let helmDir = 1;
    let helmRaf: number | null = null;
    let helmLastTs = 0;

    function playGalTone(freq = 320, dur = 0.22, type: OscillatorType = 'sawtooth') {
      if (!audioEnabled || typeof window === 'undefined') return;
      try {
        const Ctx = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
        if (!Ctx) return;
        const ctx = new Ctx();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, ctx.currentTime);
        gain.gain.setValueAtTime(0.06, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + dur);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + dur);
      } catch {
        // ignore audio fail
      }
    }

    function triggerGalFx(text: string, color = '#38bdf8') {
      window.dispatchEvent(new CustomEvent('town:harbour-fx', { detail: { text, color } }));
    }

    function syncGalSealsUi() {
      const seals = getMaritimeSeals();
      const total = countMaritimeSeals();
      const countEl = document.getElementById('hero-gal-seals');
      if (countEl) countEl.textContent = `${total} / 5`;

      const pill = document.getElementById('gal-seal-pill');
      if (pill) {
        if (seals.armada) {
          pill.textContent = '✓ Seal of the Armada Claimed';
          pill.className = 'rounded-full border border-[#16a34a] bg-[#dcfce7] px-2.5 py-1 font-mono text-[10px] font-bold uppercase text-[#166534]';
        } else {
          pill.textContent = '⏳ Seal of the Armada Sealed';
          pill.className = 'rounded-full border border-[#d97706]/60 bg-[#fef3c7] px-2.5 py-1 font-mono text-[10px] font-bold uppercase text-[#78350f]';
        }
      }

      (Object.keys(MARITIME_SEALS_META) as MaritimeSealKey[]).forEach((k) => {
        const badge = document.querySelector<HTMLElement>(`[data-ledger-badge="${k}"]`);
        if (badge) badge.textContent = seals[k] ? '✓ CLAIMED' : '🔒 SEALED';
      });
    }

    function renderSalvosUi() {
      const scoreEl = document.getElementById('hero-salvo-score');
      if (scoreEl) scoreEl.textContent = `${salvosHit} / 3`;

      for (let i = 1; i <= 3; i++) {
        const pip = document.querySelector<HTMLElement>(`[data-salvo-pip="${i}"]`);
        if (!pip) continue;
        const hit = i <= salvosHit;
        pip.textContent = hit ? '💥' : '⚪';
        pip.className = hit
          ? 'inline-flex h-7 w-7 items-center justify-center rounded-lg border border-[#fbbf24] bg-[#451a03] text-xs'
          : 'inline-flex h-7 w-7 items-center justify-center rounded-lg border border-[#475569] bg-[#1e293b] text-xs';
      }

      const stateEl = document.getElementById('hero-helm-state');
      const bannerEl = document.getElementById('gal-trial-banner');
      if (salvosHit >= 3) {
        if (stateEl) {
          stateEl.textContent = 'FULL SAIL';
          stateEl.className = 'text-sm font-black text-[#15803d]';
        }
        if (bannerEl) {
          bannerEl.className =
            'mt-4 rounded-xl border-2 border-[#16a34a] bg-[#dcfce7] px-4 py-3 text-xs font-bold text-[#14532d]';
          bannerEl.textContent =
            '🏴‍☠️ ROYAL BROADSIDE SALUTE COMPLETE! Ketiga meriam menggema — Seal of the Armada resmi tersemat!';
        }
        if (!getMaritimeSeals().armada) {
          awardMaritimeSeal('armada');
          triggerGalFx('ROYAL SALUTE! ARMADA SEAL', '#fde047');
          playGalTone(523.25, 0.25, 'triangle');
          setTimeout(() => playGalTone(783.99, 0.4, 'triangle'), 150);
          syncGalSealsUi();
        }
      } else {
        if (stateEl) {
          stateEl.textContent = 'STEERING';
          stateEl.className = 'text-sm font-black text-[#b45309]';
        }
        if (bannerEl) {
          bannerEl.className =
            'mt-4 rounded-xl border-2 border-[#cbd5e1] bg-[#f8fafc] px-4 py-3 text-xs font-medium text-[#334155]';
          bannerEl.innerHTML = `☸️ Status Kemudi: <strong>${salvosHit} / 3</strong> tembakan salvo masuk Zona Emas-Zamrud (36%–64%).`;
        }
      }
    }

    function stepHelmGauge(ts: number) {
      const needle = document.getElementById('gal-helm-needle');
      if (!needle) {
        helmRaf = null;
        return;
      }
      if (!helmLastTs) helmLastTs = ts;
      const dt = Math.min((ts - helmLastTs) / 1000, 0.05);
      helmLastTs = ts;

      const speed = 82 + salvosHit * 18;
      helmPos += helmDir * speed * dt;
      if (helmPos >= 97) {
        helmPos = 97;
        helmDir = -1;
      } else if (helmPos <= 3) {
        helmPos = 3;
        helmDir = 1;
      }
      needle.style.left = `${helmPos.toFixed(1)}%`;
      helmRaf = requestAnimationFrame(stepHelmGauge);
    }

    function wireGalleonPage() {
      if (getMaritimeSeals().armada) salvosHit = 3;
      syncGalSealsUi();
      renderSalvosUi();

      if (helmRaf === null) {
        helmLastTs = 0;
        helmRaf = requestAnimationFrame(stepHelmGauge);
      }

      const exitBtn = document.getElementById('gal-exit-btn');
      if (exitBtn && exitBtn.dataset.wired !== '1') {
        exitBtn.dataset.wired = '1';
        exitBtn.addEventListener('click', () => {
          try {
            sessionStorage.setItem('harbour:respawn', '30,40,down');
          } catch {}
        });
      }

      const audioBtn = document.getElementById('gal-audio-toggle');
      if (audioBtn && audioBtn.dataset.wired !== '1') {
        audioBtn.dataset.wired = '1';
        audioBtn.addEventListener('click', () => {
          audioEnabled = !audioEnabled;
          audioBtn.textContent = audioEnabled ? '🔔 Cannon Audio: ON' : '🔇 Cannon Audio: OFF';
        });
      }

      const fireBtn = document.getElementById('btn-gal-fire-salvo');
      if (fireBtn && fireBtn.dataset.wired !== '1') {
        fireBtn.dataset.wired = '1';
        fireBtn.addEventListener('click', () => {
          if (salvosHit >= 3) {
            triggerGalFx('BROADSIDE SALVO BOOM!', '#fbbf24');
            playGalTone(260, 0.25, 'triangle');
            return;
          }
          if (helmPos >= 36 && helmPos <= 64) {
            salvosHit++;
            playGalTone(440 + salvosHit * 110, 0.22, 'triangle');
            triggerGalFx(`SALVO ${salvosHit}/3 ON TARGET!`, '#34d399');
          } else {
            playGalTone(140, 0.28, 'sawtooth');
            triggerGalFx('WIDE SHOT! AIM 36%–64%', '#f87171');
          }
          renderSalvosUi();
        });
      }

      const resetBtn = document.getElementById('btn-gal-reset-helm');
      if (resetBtn && resetBtn.dataset.wired !== '1') {
        resetBtn.dataset.wired = '1';
        resetBtn.addEventListener('click', () => {
          salvosHit = 0;
          playGalTone(330, 0.14, 'sine');
          renderSalvosUi();
        });
      }

      document.querySelectorAll<HTMLButtonElement>('[data-gal-walk]').forEach((btn) => {
        if (btn.dataset.wired === '1') return;
        btn.dataset.wired = '1';
        btn.addEventListener('click', () => {
          const propId = btn.getAttribute('data-gal-walk');
          const scrollTo = btn.getAttribute('data-scroll-to');
          const speaker = btn.getAttribute('data-speaker');
          const quote = btn.getAttribute('data-quote');
          const fxText = btn.getAttribute('data-fx-text');
          const fxColor = btn.getAttribute('data-fx-color');

          if (propId) {
            document.querySelector<HTMLButtonElement>(`.town-label[data-id="${propId}"]`)?.click();
          }
          if (speaker && quote) {
            const spEl = document.getElementById('gal-speaker');
            const qtEl = document.getElementById('gal-dialogue');
            if (spEl) spEl.textContent = speaker;
            if (qtEl) qtEl.textContent = `“${quote}”`;
          }
          if (fxText) triggerGalFx(fxText, fxColor || '#38bdf8');
          if (scrollTo) {
            document.getElementById(scrollTo)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      });
    }

    function handleGalHotkey(e: KeyboardEvent) {
      if (
        document.activeElement instanceof HTMLInputElement ||
        document.activeElement instanceof HTMLTextAreaElement ||
        e.metaKey ||
        e.ctrlKey ||
        e.altKey
      ) {
        return;
      }
      if (e.key === 'Escape') {
        (document.getElementById('gal-exit-btn') as HTMLAnchorElement | null)?.click();
        return;
      }
      document.querySelector<HTMLButtonElement>(`.gal-station-btn[data-hotkey="${e.key.toLowerCase()}"]`)?.click();
    }

    window.addEventListener('harbour:seal-updated', syncGalSealsUi);
    window.addEventListener('keydown', handleGalHotkey);

    wireGalleonPage();
    document.addEventListener('astro:page-load', wireGalleonPage);
  </script>
</TownLayout>
