---
import TownLayout from '../../layouts/TownLayout.astro';
import WhereTo from '../../components/WhereTo.astro';
import { profile } from '../../lib/profile';
import { ROYAL_CRESTS_META } from '../../engine/kingdomInteriorShared';

const allCrests = Object.values(ROYAL_CRESTS_META);

const abbeyBells = [
  { idx: 0, note: 'Bell I · Azure Dawn (C4)', freq: 261.63, border: 'border-[#0284c7]', bg: 'from-[#e0f2fe] to-[#bae6fd]', text: 'text-[#0c4a6e]' },
  { idx: 1, note: 'Bell II · Rose Light (E4)', freq: 329.63, border: 'border-[#7c3aed]', bg: 'from-[#f3e8ff] to-[#e9d5ff]', text: 'text-[#4c1d95]' },
  { idx: 2, note: 'Bell III · Sovereign Gold (G4)', freq: 392.0, border: 'border-[#d97706]', bg: 'from-[#fef3c7] to-[#fde68a]', text: 'text-[#78350f]' },
  { idx: 3, note: 'Bell IV · Grace Octave (C5)', freq: 523.25, border: 'border-[#15803d]', bg: 'from-[#dcfce7] to-[#bbf7d0]', text: 'text-[#14532d]' },
];

const stainedGlassValues = [
  { title: 'Simplicity Over Bloat', pane: 'bg-[#eff6ff] border-[#0284c7]', desc: 'Clear state machines, offscreen canvas caches, and explicit contracts rather than fragile abstraction layers.' },
  { title: 'Evidence Over Hype', pane: 'bg-[#fffbeb] border-[#d97706]', desc: 'Measure latency (~1.8 ms/frame TensorRT), stratified CV scores (99.56% F1), and automated integration suites (32/32 tests).' },
  { title: 'Security & Ownership', pane: 'bg-[#f5f3ff] border-[#6366f1]', desc: 'HCIA-Security fundamentals, transactional row locking, and safe deployment probes from edge to Kubernetes.' },
  { title: 'Mentorship & Service', pane: 'bg-[#f0fdf4] border-[#15803d]', desc: '6 terms serving ITENAS Robotics, IoT, Networking, OOP, and Database labs — lifting entire student cohorts together.' },
];
---

<TownLayout
  title="Saint Avalon Abbey — Stained-Glass Values & Bell Hymn | Muhammad Zulfan"
  description="Enter Saint Avalon Abbey inside Royal Kingdom: play the 3-round Bronze Bell Hymn with Guardian Lugia, Seraphimon & GuardiAngemon for the Crest of Grace."
  place="kingdom-chapel"
>
  <article class="chapel-page space-y-6 pb-10 text-[#1e1b18]">
    <!-- 1. ABBEY HERALDIC MARQUEE BANNER (ROSE SKYSTONE, PARCHMENT & GOLD) -->
    <header class="relative overflow-hidden rounded-2xl border-[3px] border-[#0284c7] bg-gradient-to-b from-[#f0f9ff] via-[#e0f2fe] to-[#bae6fd] p-5 text-[#0c4a6e] shadow-[0_8px_0_#1e3a8a,0_18px_36px_rgba(30,58,138,0.28)]">
      <div class="pointer-events-none absolute inset-x-0 top-0 h-2 bg-[repeating-linear-gradient(90deg,#0284c7_0px,#0284c7_14px,#fbbf24_14px,#fbbf24_28px,#1e3a8a_28px,#1e3a8a_42px)]" aria-hidden="true"></div>
      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-2 bg-[repeating-linear-gradient(90deg,#1e3a8a_0px,#1e3a8a_14px,#fbbf24_14px,#fbbf24_28px,#0284c7_28px,#0284c7_42px)]" aria-hidden="true"></div>

      <div class="relative z-10 mt-1 flex flex-wrap items-start justify-between gap-4">
        <div class="space-y-2">
          <div class="flex flex-wrap items-center gap-2">
            <span class="rounded-full border border-[#1e3a8a] bg-[#1e3a8a] px-3 py-1 font-mono text-[10px] font-bold uppercase tracking-[0.14em] text-[#fef3c7]">
              ⛪ SAINT AVALON ABBEY · SOUTHEAST SANCTUARY
            </span>
            <span id="cha-crest-pill" class="rounded-full border border-[#0284c7]/50 bg-white px-2.5 py-1 font-mono text-[10px] font-bold uppercase text-[#0c4a6e]">
              ⏳ Crest Unclaimed
            </span>
          </div>
          <h1 class="font-display text-2xl font-black tracking-tight text-[#0f172a] sm:text-3xl">
            ⛪ Saint Avalon Abbey &amp; Bell Carillon
          </h1>
          <p class="max-w-2xl text-sm leading-relaxed text-[#1e293b]">
            Dengarkan harmoni empat lonceng perunggu bersama <strong class="text-[#0369a1]">Guardian Lugia</strong>, <strong class="text-[#b45309]">Seraphimon</strong>, &amp;
            <strong class="text-[#1d4ed8]">GuardiAngemon</strong> selama 3 ronde untuk meraih <strong class="text-[#0284c7]">Crest of Grace</strong>.
          </p>
        </div>

        <div class="flex flex-col items-end gap-2">
          <div class="grid grid-cols-3 gap-2 rounded-xl border-2 border-[#0284c7] bg-white px-3 py-2 text-center font-mono shadow-inner">
            <div>
              <div class="text-[9px] font-bold uppercase text-[#0369a1]">HYMN</div>
              <div id="hero-cha-round" class="text-sm font-black text-[#1e3a8a]">1 / 3</div>
            </div>
            <div>
              <div class="text-[9px] font-bold uppercase text-[#0369a1]">GRACE</div>
              <div id="hero-cha-state" class="text-sm font-black text-[#b45309]">SEALED</div>
            </div>
            <div>
              <div class="text-[9px] font-bold uppercase text-[#0369a1]">CRESTS</div>
              <div id="hero-cha-crests" class="text-sm font-black text-[#15803d]">0 / 7</div>
            </div>
          </div>

          <div class="flex flex-wrap items-center justify-end gap-2">
            <button id="cha-audio-toggle" type="button" class="cursor-pointer rounded-lg border-2 border-[#0284c7] bg-white px-2.5 py-1.5 font-mono text-[11px] font-bold text-[#0c4a6e]">
              🔔 Bell Audio: ON
            </button>
            <a id="cha-exit-btn" href="/kingdom?from=chapel" class="inline-flex items-center gap-1.5 rounded-lg border-2 border-[#7f1d1d] bg-gradient-to-b from-[#b91c1c] to-[#7f1d1d] px-3 py-1.5 font-mono text-xs font-extrabold text-[#fef3c7] shadow-[0_3px_0_#450a0a] transition hover:-translate-y-0.5">
              🚪 Exit to Kingdom
            </a>
          </div>
        </div>
      </div>

      <!-- Tri-Guardian Dialogue Strip -->
      <div class="relative z-10 mt-4 flex flex-col gap-3 rounded-xl border-2 border-[#0284c7]/40 bg-white/95 p-3.5 sm:flex-row sm:items-center">
        <div class="flex shrink-0 items-center gap-1.5">
          <button type="button" data-cha-walk="lugia" data-speaker="🕊️ Guardian Lugia · Choir Warden" data-quote="Calm acoustics carry far. Listen cleanly to the 4 bronze bells and repeat each 3-stage sanctuary hymn!" data-fx-text="AEROBLAST CHIME!" data-fx-color="#38bdf8" class="flex h-11 w-11 cursor-pointer items-center justify-center rounded-xl border-2 border-[#0284c7] bg-[#e0f2fe] text-xl shadow-[0_2px_0_#075985] transition hover:-translate-y-0.5">🕊️</button>
          <button type="button" data-cha-walk="seraphimon" data-speaker="👼 Seraphimon · Seraphic Cantor" data-quote="Seven Heavens shine through clean engineering values: Simplicity, Evidence, Security, and Mentorship." data-fx-text="SEVEN HEAVENS!" data-fx-color="#fbbf24" class="flex h-11 w-11 cursor-pointer items-center justify-center rounded-xl border-2 border-[#d97706] bg-[#fef3c7] text-xl shadow-[0_2px_0_#92400e] transition hover:-translate-y-0.5">👼</button>
          <button type="button" data-cha-walk="guardiangemon" data-speaker="⚔️ GuardiAngemon · Sanctuary Sentinel" data-quote="Need direct contact? Open the Envoy Scroll below for GitHub, LinkedIn, Email, and instant Sanctuary Grace (+50% Speed)!" data-fx-text="GRACE SANCTUARY!" data-fx-color="#60a5fa" class="flex h-11 w-11 cursor-pointer items-center justify-center rounded-xl border-2 border-[#1e3a8a] bg-[#dbeafe] text-xl shadow-[0_2px_0_#1e3a8a] transition hover:-translate-y-0.5">⚔️</button>
        </div>
        <div class="min-w-0 flex-1">
          <div id="cha-speaker" class="font-mono text-[10px] font-black uppercase tracking-wider text-[#0369a1]">
            🕊️ Guardian Lugia · Choir Warden
          </div>
          <p id="cha-dialogue" class="mt-0.5 text-xs italic leading-relaxed text-[#1e293b]">
            “Klik ‘Start Bell Hymn’ lalu ulangi urutan dentingan lonceng selama 3 ronde (panjang 3, 4, dan 5 nada) untuk mengklaim Crest of Grace!”
          </p>
        </div>
      </div>

      <!-- 6 Tactile Quick-Walk Station Cards -->
      <nav aria-label="Quick walk Abbey stations" class="relative z-10 mt-4 grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-6">
        <button type="button" data-cha-walk="lugia" data-scroll-to="cha-bell-game" data-hotkey="l" class="cha-station-btn flex cursor-pointer items-center justify-between gap-2 rounded-xl border-2 border-[#0284c7] bg-white px-2.5 py-2 text-left shadow-[0_2px_0_#075985] transition hover:-translate-y-0.5">
          <span class="flex items-center gap-1.5 truncate text-xs font-bold"><span>🕊️</span><span class="truncate">Lugia</span></span>
          <kbd class="rounded border border-[#0284c7]/40 bg-[#e0f2fe] px-1.5 py-0.5 font-mono text-[9px] font-bold text-[#0369a1]">L</kbd>
        </button>
        <button type="button" data-cha-walk="bell-carillon" data-scroll-to="cha-bell-game" data-hotkey="b" class="cha-station-btn flex cursor-pointer items-center justify-between gap-2 rounded-xl border-2 border-[#d97706] bg-white px-2.5 py-2 text-left shadow-[0_2px_0_#92400e] transition hover:-translate-y-0.5">
          <span class="flex items-center gap-1.5 truncate text-xs font-bold"><span>🔔</span><span class="truncate">Bells</span></span>
          <kbd class="rounded border border-[#d97706]/40 bg-[#fef3c7] px-1.5 py-0.5 font-mono text-[9px] font-bold text-[#78350f]">B</kbd>
        </button>
        <button type="button" data-cha-walk="rose-stained-glass" data-scroll-to="cha-values-section" data-hotkey="v" class="cha-station-btn flex cursor-pointer items-center justify-between gap-2 rounded-xl border-2 border-[#6366f1] bg-white px-2.5 py-2 text-left shadow-[0_2px_0_#312e81] transition hover:-translate-y-0.5">
          <span class="flex items-center gap-1.5 truncate text-xs font-bold"><span>🪟</span><span class="truncate">Values</span></span>
          <kbd class="rounded border border-[#6366f1]/40 bg-[#e0e7ff] px-1.5 py-0.5 font-mono text-[9px] font-bold text-[#3730a3]">V</kbd>
        </button>
        <button type="button" data-cha-walk="seraphimon" data-scroll-to="cha-values-section" data-hotkey="e" class="cha-station-btn flex cursor-pointer items-center justify-between gap-2 rounded-xl border-2 border-[#d97706] bg-white px-2.5 py-2 text-left shadow-[0_2px_0_#92400e] transition hover:-translate-y-0.5">
          <span class="flex items-center gap-1.5 truncate text-xs font-bold"><span>👼</span><span class="truncate">Seraph</span></span>
          <kbd class="rounded border border-[#d97706]/40 bg-[#fef3c7] px-1.5 py-0.5 font-mono text-[9px] font-bold text-[#78350f]">E</kbd>
        </button>
        <button type="button" data-cha-walk="guardiangemon" data-scroll-to="cha-relic-section" data-hotkey="g" class="cha-station-btn flex cursor-pointer items-center justify-between gap-2 rounded-xl border-2 border-[#1e3a8a] bg-white px-2.5 py-2 text-left shadow-[0_2px_0_#1e3a8a] transition hover:-translate-y-0.5">
          <span class="flex items-center gap-1.5 truncate text-xs font-bold"><span>⚔️</span><span class="truncate">Warden</span></span>
          <kbd class="rounded border border-[#1e3a8a]/40 bg-[#dbeafe] px-1.5 py-0.5 font-mono text-[9px] font-bold text-[#1e3a8a]">G</kbd>
        </button>
        <button type="button" data-cha-walk="grace-altar" data-scroll-to="cha-relic-section" data-hotkey="a" class="cha-station-btn flex cursor-pointer items-center justify-between gap-2 rounded-xl border-2 border-[#15803d] bg-white px-2.5 py-2 text-left shadow-[0_2px_0_#14532d] transition hover:-translate-y-0.5">
          <span class="flex items-center gap-1.5 truncate text-xs font-bold"><span>🕯️</span><span class="truncate">Altar</span></span>
          <kbd class="rounded border border-[#15803d]/40 bg-[#dcfce7] px-1.5 py-0.5 font-mono text-[9px] font-bold text-[#14532d]">A</kbd>
        </button>
      </nav>
    </header>

    <!-- 2. TRIAL I: BRONZE BELL HYMN PUZZLE (3 ROUNDS) -->
    <section
      id="cha-bell-game"
      class="scroll-mt-6 rounded-2xl border-[3px] border-[#0284c7] bg-gradient-to-b from-[#fffdf7] to-[#f0f9ff] p-5 shadow-[0_8px_0_#1e3a8a]"
    >
      <div class="flex flex-wrap items-start justify-between gap-3 border-b-2 border-[#0284c7]/25 pb-3.5">
        <div>
          <span class="font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-[#0369a1]">
            TRIAL I · BRONZE CARILLON HARMONY
          </span>
          <h2 class="mt-0.5 font-display text-xl font-black text-[#0f172a]">
            🔔 3-Round Sanctuary Bell Hymn (Keys 1 – 4)
          </h2>
          <p class="mt-1 text-xs text-[#334155]">
            Tekan <strong class="text-[#0284c7]">Play Hymn Sequence</strong> lalu tirukan dentingannya (Ronde 1: 3 nada, Ronde 2: 4 nada, Ronde 3: 5 nada) untuk meraih <strong class="text-[#0369a1]">⛪ Crest of Grace</strong>.
          </p>
        </div>

        <button id="cha-start-hymn" type="button" class="cursor-pointer rounded-xl border-2 border-[#0284c7] bg-[#0284c7] px-4 py-2 font-mono text-xs font-black text-white shadow-[0_3px_0_#075985] hover:brightness-110">
          ▶ Start Bell Hymn
        </button>
      </div>

      <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
        {abbeyBells.map((b) => (
          <button
            type="button"
            data-bell-idx={b.idx}
            data-freq={b.freq}
            class={`bell-pad-btn cursor-pointer rounded-xl border-2 ${b.border} bg-gradient-to-b ${b.bg} p-4 text-center ${b.text} shadow-[0_4px_0_rgba(15,23,42,0.2)] transition active:translate-y-0.5`}
          >
            <div class="text-2xl">🔔</div>
            <div class="mt-1 font-mono text-[11px] font-black">{b.note}</div>
            <div class="font-mono text-[9px] opacity-75">Key [{b.idx + 1}]</div>
          </button>
        ))}
      </div>

      <p id="cha-bell-status" class="mt-4 rounded-lg border border-[#0284c7]/30 bg-white px-3 py-2 font-mono text-xs font-bold text-[#0c4a6e]">
        🕊️ Lugia: Tekan "Start Bell Hymn" untuk mendengarkan melodi pertama, atau bunyikan lonceng 1–4 secara bebas!
      </p>
    </section>

    <!-- 3. STAINED-GLASS ENGINEERING VALUES & CONTACT ENVOYS -->
    <section
      id="cha-values-section"
      class="scroll-mt-6 rounded-2xl border-[3px] border-[#b45309] bg-gradient-to-b from-[#fffdf7] to-[#f4ead5] p-5 shadow-[0_8px_0_#78350f]"
    >
      <div class="flex flex-wrap items-center justify-between gap-2 border-b-2 border-[#b45309]/30 pb-3">
        <div>
          <span class="font-mono text-[10px] font-bold uppercase tracking-[0.16em] text-[#b45309]">
            STAINED-GLASS ARCHES · CRAFT PRINCIPLES &amp; SOCIALS
          </span>
          <h2 class="mt-0.5 font-display text-xl font-black text-[#1e293b]">
            🪟 Core Values &amp; Direct Envoy Scroll
          </h2>
        </div>
        <a href="/about" class="rounded-lg border border-[#1e3a8a] bg-[#1e3a8a] px-3 py-1 font-mono text-[10px] font-bold text-[#fef3c7]">
          Full Bio in /about →
        </a>
      </div>

      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        {stainedGlassValues.map((v) => (
          <div class={`rounded-xl border-2 p-4 ${v.pane}`}>
            <h3 class="font-display text-sm font-black text-[#0f172a]">{v.title}</h3>
            <p class="mt-1 text-xs leading-relaxed text-[#334155]">{v.desc}</p>
          </div>
        ))}
      </div>

      <div class="mt-4 flex flex-wrap gap-2 rounded-xl border border-[#b45309]/40 bg-white p-3">
        {profile.socials.map((s) => (
          <a
            href={s.url}
            target={s.url.startsWith('http') ? '_blank' : undefined}
            rel={s.url.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="rounded-lg border border-[#0284c7]/40 bg-[#f0f9ff] px-3 py-1.5 font-mono text-[11px] font-bold text-[#0c4a6e] hover:bg-[#e0f2fe]"
          >
            ✉️ {s.label} →
          </a>
        ))}
      </div>
    </section>

    <!-- 4. SANCTUARY GRACE COFFER & 7 CRESTS -->
    <section
      id="cha-relic-section"
      class="scroll-mt-6 rounded-2xl border-[3px] border-[#0284c7] bg-gradient-to-b from-[#fffdf7] to-[#f0f9ff] p-5 shadow-[0_8px_0_#1e3a8a]"
    >
      <div class="flex flex-wrap items-center justify-between gap-2 border-b-2 border-[#0284c7]/25 pb-3">
        <h2 class="font-display text-xl font-black text-[#0f172a]">⛲ Sanctuary Vault &amp; 7 Crests</h2>
        <span id="cha-crest-summary" class="rounded-full border border-[#1e3a8a] bg-[#1e3a8a] px-3 py-1 font-mono text-[11px] font-bold text-[#fef3c7]">
          0 / 7 Crests Claimed
        </span>
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-between gap-3 rounded-xl border-2 border-[#15803d]/40 bg-white p-4">
        <div>
          <div class="font-mono text-[10px] font-bold uppercase text-[#15803d]">RELIC I · SANCTUARY GRACE BLESSING</div>
          <h3 class="mt-0.5 font-display text-base font-black text-[#0f172a]">🕊️ Feather of Lugia (+50% Speed)</h3>
          <p class="mt-1 text-xs text-[#475569]">Pulihkan semangat dan berlari +50% lebih cepat selama 25 detik!</p>
        </div>
        <div class="flex items-center gap-2">
          <button id="cha-speed-btn" type="button" class="cursor-pointer rounded-xl border-2 border-[#15803d] bg-[#15803d] px-4 py-2 font-mono text-xs font-black text-white shadow-[0_3px_0_#14532d]">
            🕊️ Cast Sanctuary Grace
          </button>
          <span id="cha-speed-timer" class="font-mono text-xs font-bold text-[#15803d]">Ready</span>
        </div>
      </div>

      <div class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
        {allCrests.map((c) => (
          <a href={c.route} class="flex items-center justify-between gap-2 rounded-xl border border-[#0284c7]/40 bg-white px-3 py-2 text-xs hover:-translate-y-0.5 hover:border-[#1e3a8a]">
            <span class="truncate font-bold">{c.icon} {c.name}</span>
            <span data-cha-crest-badge={c.key} class="font-mono text-[10px] font-bold text-[#94a3b8]">🔒</span>
          </a>
        ))}
      </div>
    </section>

    <WhereTo currentPath="/kingdom/chapel" />
  </article>
</TownLayout>

<script>
  import { awardRoyalCrest, countRoyalCrests, getRoyalCrests } from '../../engine/kingdomInteriorShared';

  let chaAudioOn = true;
  let chaAudioCtx: AudioContext | null = null;

  function ringBellTone(freq: number, dur = 0.28, type: OscillatorType = 'sine') {
    if (!chaAudioOn || typeof window === 'undefined') return;
    try {
      const Ctx = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
      if (!Ctx) return;
      if (!chaAudioCtx) chaAudioCtx = new Ctx();
      if (chaAudioCtx.state === 'suspended') void chaAudioCtx.resume();
      const osc = chaAudioCtx.createOscillator();
      const gain = chaAudioCtx.createGain();
      osc.type = type;
      osc.frequency.setValueAtTime(freq, chaAudioCtx.currentTime);
      gain.gain.setValueAtTime(0.14, chaAudioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, chaAudioCtx.currentTime + dur);
      osc.connect(gain);
      gain.connect(chaAudioCtx.destination);
      osc.start();
      osc.stop(chaAudioCtx.currentTime + dur);
    } catch {
      // ignore
    }
  }

  function emitChaWave(text: string, color = '#60a5fa') {
    window.dispatchEvent(new CustomEvent('town:kingdom-fx', { detail: { text, color } }));
  }

  function initChapelPage() {
    const root = document.querySelector('.chapel-page');
    if (!root) return;

    const bellPads = Array.from(document.querySelectorAll<HTMLButtonElement>('.bell-pad-btn'));
    const statusEl = document.getElementById('cha-bell-status');
    const bellFreqs = [261.63, 329.63, 392.0, 523.25];
    const bellColors = ['#38bdf8', '#c084fc', '#fbbf24', '#4ade80'];

    let round = 1;
    let seq: number[] = [];
    let step = 0;
    let playing = false;
    let gameActive = false;
    let cancelled = false;
    let speedTimer: number | null = null;

    document.getElementById('cha-exit-btn')?.addEventListener('click', () => {
      try {
        sessionStorage.setItem('kingdom:respawn', '34,50,down');
      } catch {
        // ignore
      }
    });

    const audioBtn = document.getElementById('cha-audio-toggle');
    audioBtn?.addEventListener('click', () => {
      chaAudioOn = !chaAudioOn;
      audioBtn.textContent = chaAudioOn ? '🔔 Bell Audio: ON' : '🔇 Bell Audio: MUTED';
      if (chaAudioOn) ringBellTone(523.25, 0.2);
    });

    const speakerEl = document.getElementById('cha-speaker');
    const dialogueEl = document.getElementById('cha-dialogue');

    const walkProp = (el: HTMLElement) => {
      const id = el.dataset.chaWalk;
      if (id) window.dispatchEvent(new CustomEvent('town:walk-to', { detail: { id } }));
      if (el.dataset.speaker && speakerEl) speakerEl.textContent = el.dataset.speaker;
      if (el.dataset.quote && dialogueEl) dialogueEl.textContent = `“${el.dataset.quote}”`;
      if (el.dataset.fxText) emitChaWave(el.dataset.fxText, el.dataset.fxColor || '#60a5fa');
      if (el.dataset.scrollTo) {
        document.getElementById(el.dataset.scrollTo)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
      ringBellTone(392, 0.16);
    };

    document.querySelectorAll<HTMLElement>('[data-cha-walk]').forEach((btn) => {
      btn.addEventListener('click', () => walkProp(btn));
    });

    function refreshCrests() {
      const crests = getRoyalCrests();
      const total = countRoyalCrests();
      const hasGrace = Boolean(crests.grace);

      const hRound = document.getElementById('hero-cha-round');
      const hState = document.getElementById('hero-cha-state');
      const hCrests = document.getElementById('hero-cha-crests');
      const pill = document.getElementById('cha-crest-pill');
      const summary = document.getElementById('cha-crest-summary');

      if (hRound) hRound.textContent = hasGrace ? '3 / 3' : `${round} / 3`;
      if (hCrests) hCrests.textContent = `${total} / 7`;
      if (summary) summary.textContent = `${total} / 7 Crests Claimed`;
      if (hState) {
        hState.textContent = hasGrace ? 'CLAIMED' : 'SEALED';
        hState.className = hasGrace ? 'text-sm font-black text-[#15803d]' : 'text-sm font-black text-[#b45309]';
      }
      if (pill && hasGrace) {
        pill.textContent = '⛪ Crest of Grace Claimed';
        pill.className = 'rounded-full border border-[#15803d] bg-[#dcfce7] px-2.5 py-1 font-mono text-[10px] font-bold uppercase text-[#14532d]';
      }

      (['sovereignty', 'steel', 'fellowship', 'arcana', 'valor', 'grace', 'chivalry'] as const).forEach((k) => {
        const badge = document.querySelector<HTMLElement>(`[data-cha-crest-badge="${k}"]`);
        const ok = Boolean(crests[k]);
        if (badge) {
          badge.textContent = ok ? '✅' : '🔒';
          badge.className = ok ? 'font-mono text-[10px] font-bold text-[#15803d]' : 'font-mono text-[10px] font-bold text-[#94a3b8]';
        }
      });
    }

    function flashBell(idx: number) {
      const btn = bellPads[idx];
      ringBellTone(bellFreqs[idx] || 392);
      if (btn) {
        btn.classList.add('ring-4', 'ring-[#fbbf24]', 'scale-[1.03]');
        setTimeout(() => btn.classList.remove('ring-4', 'ring-[#fbbf24]', 'scale-[1.03]'), 240);
      }
    }

    async function playSeq() {
      playing = true;
      step = 0;
      if (statusEl) statusEl.textContent = `🔔 Mendengarkan melodi Ronde ${round} (${seq.length} nada)...`;
      for (const idx of seq) {
        if (cancelled) return;
        flashBell(idx);
        await new Promise((r) => setTimeout(r, 420));
      }
      playing = false;
      if (statusEl) statusEl.textContent = `🎵 Giliran Anda! Bunyikan ${seq.length} lonceng berurutan (tombol 1–4).`;
    }

    function beginRound(r: number) {
      round = r;
      const len = r + 2; // 3, 4, 5
      seq = Array.from({ length: len }, () => Math.floor(Math.random() * 4));
      refreshCrests();
      void playSeq();
    }

    document.getElementById('cha-start-hymn')?.addEventListener('click', () => {
      gameActive = true;
      beginRound(1);
    });

    function pressBell(idx: number) {
      if (playing) return;
      flashBell(idx);
      emitChaWave(`BELL ${idx + 1}`, bellColors[idx] || '#60a5fa');
      if (!gameActive) return;

      if (idx === seq[step]) {
        step += 1;
        if (step >= seq.length) {
          if (round < 3) {
            if (statusEl) statusEl.textContent = `✅ Ronde ${round} harmonis! Mempersiapkan Ronde ${round + 1}...`;
            setTimeout(() => { if (!cancelled) beginRound(round + 1); }, 650);
          } else {
            gameActive = false;
            awardRoyalCrest('grace');
            emitChaWave('CREST OF GRACE CLAIMED!', '#4ade80');
            if (statusEl) statusEl.textContent = '⛪ SEMPURNA! Ketiga himne lonceng berpadu — Crest of Grace diraih!';
            refreshCrests();
          }
        } else if (statusEl) {
          statusEl.textContent = `🎶 Tepat (${step}/${seq.length})...`;
        }
      } else {
        ringBellTone(146.83, 0.25, 'sawtooth');
        emitChaWave('DISCORDANT BELL!', '#ef4444');
        if (statusEl) statusEl.textContent = `⚠️ Nada meleset pada Ronde ${round}! Mengulang melodi...`;
        setTimeout(() => { if (!cancelled && gameActive) void playSeq(); }, 700);
      }
    }

    bellPads.forEach((btn) => {
      btn.addEventListener('click', () => pressBell(Number(btn.dataset.bellIdx || 0)));
    });

    document.getElementById('cha-speed-btn')?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('town:claim-lucky-egg'));
      emitChaWave('LUGIA GRACE +50% SPD!', '#38bdf8');
      ringBellTone(523.25, 0.22);
      let left = 25;
      const tEl = document.getElementById('cha-speed-timer');
      if (tEl) tEl.textContent = `🕊️ ${left}s`;
      if (speedTimer !== null) clearInterval(speedTimer);
      speedTimer = window.setInterval(() => {
        left -= 1;
        if (tEl) tEl.textContent = left > 0 ? `🕊️ ${left}s` : 'Ready';
        if (left <= 0 && speedTimer !== null) {
          clearInterval(speedTimer);
          speedTimer = null;
        }
      }, 1000);
    });

    const onKey = (e: KeyboardEvent) => {
      const tag = (e.target as HTMLElement | null)?.tagName;
      if (tag === 'INPUT' || tag === 'SELECT' || tag === 'TEXTAREA') return;
      if (e.key >= '1' && e.key <= '4') {
        e.preventDefault();
        pressBell(Number(e.key) - 1);
        return;
      }
      const matched = document.querySelector<HTMLElement>(`.cha-station-btn[data-hotkey="${e.key.toLowerCase()}"]`);
      if (matched) {
        e.preventDefault();
        walkProp(matched);
      }
    };
    window.addEventListener('keydown', onKey);

    refreshCrests();

    document.addEventListener(
      'astro:before-swap',
      () => {
        cancelled = true;
        if (speedTimer !== null) clearInterval(speedTimer);
        window.removeEventListener('keydown', onKey);
      },
      { once: true }
    );
  }

  initChapelPage();
  document.addEventListener('astro:page-load', initChapelPage);
</script>
