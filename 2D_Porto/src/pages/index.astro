---
import TownLayout from '../layouts/TownLayout.astro';
import PixelAvatar from '../components/PixelAvatar.astro';
import SkillChip from '../components/SkillChip.astro';
import WhereTo from '../components/WhereTo.astro';
import { profile } from '../lib/profile';
---

<TownLayout place="town" title={`${profile.person.name} — Town Square`}>
  <!-- Breadcrumb / Location Indicator -->
  <div class="flex items-center gap-1.5 font-pixel text-xs text-ink-soft mb-2.5">
    <span>🏠</span>
    <span class="font-bold text-ink">Town Square</span>
  </div>

  <!-- Wooden Notice Board Frame -->
  <div class="board-frame relative p-3 sm:p-5 pt-8 rounded-lg border-[3px] border-[#1c1726] shadow-[0_5px_0_0_#1c1726]">
    <!-- Top Inset Badge: TOWN HALL · NOTICE BOARD -->
    <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-[#5c381c] text-[#f7e6c4] border-2 border-[#1c1726] font-pixel text-[10px] sm:text-xs font-bold px-4 py-0.5 rounded shadow-sm tracking-wider uppercase z-10 whitespace-nowrap">
      TOWN HALL · NOTICE BOARD
    </div>

    <!-- TOP PROFILE CARD -->
    <div class="relative bg-white border-2 border-[#1c1726] rounded-lg p-4 sm:p-5 shadow-[0_2px_0_0_#1c1726]">
      <!-- Red Pushpin at Top Center -->
      <div class="absolute -top-2 left-1/2 -translate-x-1/2 w-3.5 h-3.5 rounded-full bg-[#f25744] border-2 border-[#1c1726] shadow-sm flex items-center justify-center">
        <div class="w-1 h-1 rounded-full bg-white/70"></div>
      </div>

      <!-- Avatar + Name + Subtitle -->
      <div class="flex items-center gap-4">
        <PixelAvatar size={74} />
        <div class="min-w-0">
          <h1 class="font-pixel text-xl sm:text-2xl font-bold text-[#1c1726] tracking-wide leading-tight">
            Muhammad Zulfan
          </h1>
          <p class="font-sans font-semibold text-xs sm:text-sm text-[#1b7f94] mt-0.5">
            Software & AI Engineer
          </p>
        </div>
      </div>

      <!-- Bio Paragraphs -->
      <div class="mt-4 space-y-2 text-xs sm:text-[13px] text-[#2c2638] leading-relaxed font-sans">
        <p class="font-medium text-[#1c1726]">
          I build intelligent, AI-driven applications that solve real-world problems.
        </p>
        <p class="text-ink-soft text-xs">
          This town is an interactive world showcasing my engineering journey — from robotics and edge AI (YOLOv11 & TensorRT on Jetson) to cloud-native platforms. Walk around with WASD or arrow keys, explore each building, or talk to my Digital Twin!
        </p>
      </div>

      <!-- Dotted Divider -->
      <div class="border-b border-dashed border-[#1c1726]/25 my-3.5"></div>

      <!-- Academic Metadata Line -->
      <div class="font-pixel text-[10px] sm:text-[11px] text-ink-soft uppercase tracking-wider">
        B.S. INFORMATICS · GPA 3.49 · UPN "VETERAN" JATIM · CLASS OF 2026
      </div>
    </div>

    <!-- TWO-COLUMN GRID BELOW PROFILE CARD -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
      <!-- LEFT COLUMN -->
      <div class="space-y-4">
        <!-- NOW CARD -->
        <div class="relative bg-white border-2 border-[#1c1726] rounded-lg p-3.5 shadow-[0_2px_0_0_#1c1726] space-y-2">
          <!-- Pushpin -->
          <div class="absolute -top-1.5 left-1/2 -translate-x-1/2 w-3 h-3 rounded-full bg-[#f25744] border-2 border-[#1c1726] shadow-sm flex items-center justify-center">
            <div class="w-0.5 h-0.5 rounded-full bg-white/70"></div>
          </div>

          <div class="font-pixel text-[10px] font-bold text-[#df4a32] uppercase tracking-wider">
            NOW
          </div>

          <div class="text-xs sm:text-[13px] font-bold text-[#1c1726]">
            AI Engineer @ AeroScan
          </div>

          <p class="text-[11px] sm:text-xs text-[#3a3150] leading-relaxed font-sans">
            Architected an end-to-end aerial computer vision pipeline with YOLOv11 & TensorRT on Jetson Orin Nano, while engineering FoodLink cloud-native logistics on Laravel & Kubernetes.
          </p>

          <div class="text-[11px] font-medium text-[#1b7f94] pt-0.5 flex items-start gap-1 font-sans">
            <span>📢</span>
            <span>New opportunities in AI, data science, and software engineering.</span>
          </div>
        </div>

        <!-- TOOLBELT CARD -->
        <div class="relative bg-white border-2 border-[#1c1726] rounded-lg p-3.5 shadow-[0_2px_0_0_#1c1726] space-y-2.5">
          <!-- Pushpin -->
          <div class="absolute -top-1.5 left-1/2 -translate-x-1/2 w-3 h-3 rounded-full bg-[#f25744] border-2 border-[#1c1726] shadow-sm flex items-center justify-center">
            <div class="w-0.5 h-0.5 rounded-full bg-white/70"></div>
          </div>

          <div class="font-pixel text-[10px] font-bold text-[#df4a32] uppercase tracking-wider">
            TOOLBELT
          </div>

          <div class="flex flex-wrap gap-1.5 pt-0.5">
            <SkillChip name="Python" />
            <SkillChip name="TypeScript" />
            <SkillChip name="Go" />
            <SkillChip name="PHP / Laravel" />
            <SkillChip name="PyTorch" />
            <SkillChip name="TensorRT" />
            <SkillChip name="OpenCV" />
            <SkillChip name="Docker" />
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN -->
      <div class="space-y-4">
        <!-- FEATURED BUILDS CARD -->
        <div class="relative bg-white border-2 border-[#1c1726] rounded-lg p-3.5 shadow-[0_2px_0_0_#1c1726] space-y-3">
          <!-- Pushpin -->
          <div class="absolute -top-1.5 left-1/2 -translate-x-1/2 w-3 h-3 rounded-full bg-[#f25744] border-2 border-[#1c1726] shadow-sm flex items-center justify-center">
            <div class="w-0.5 h-0.5 rounded-full bg-white/70"></div>
          </div>

          <div class="font-pixel text-[10px] font-bold text-[#df4a32] uppercase tracking-wider">
            FEATURED BUILDS
          </div>

          <!-- Project 1 -->
          <div>
            <a href="/dev" class="font-pixel text-xs font-bold text-[#df4a32] underline decoration-1 underline-offset-2 hover:text-[#b8331f] block">
              AeroScan Aerial AI
            </a>
            <p class="text-[11px] text-[#3a3150] leading-snug font-sans mt-0.5">
              Tactical edge-AI platform that detects, classifies, and tracks 15 military aircraft with TensorRT (~1.8 ms/frame).
            </p>
          </div>

          <!-- Project 2 -->
          <div>
            <a href="/dev" class="font-pixel text-xs font-bold text-[#df4a32] underline decoration-1 underline-offset-2 hover:text-[#b8331f] block">
              FoodLink Platform
            </a>
            <p class="text-[11px] text-[#3a3150] leading-snug font-sans mt-0.5">
              Cloud-native food rescue & redistribution platform with geospatial routing, Redis, Kafka, and PostGIS.
            </p>
          </div>

          <!-- Project 3 -->
          <div>
            <a href="/dev" class="font-pixel text-xs font-bold text-[#df4a32] underline decoration-1 underline-offset-2 hover:text-[#b8331f] block">
              Neural Spam Sentinel
            </a>
            <p class="text-[11px] text-[#3a3150] leading-snug font-sans mt-0.5">
              Undergraduate thesis: high-precision automated spam classification on YouTube comments (99.56% F1 score).
            </p>
          </div>

          <!-- Dev Center Link -->
          <div class="pt-1">
            <a href="/dev" class="font-pixel text-[11px] font-semibold text-[#df4a32] underline decoration-1 underline-offset-2 hover:text-[#b8331f] block">
              All projects at the Dev Center →
            </a>
          </div>
        </div>

        <!-- ON REPEAT CARD -->
        <div class="relative bg-white border-2 border-[#1c1726] rounded-lg p-3.5 shadow-[0_2px_0_0_#1c1726] space-y-1">
          <!-- Pushpin -->
          <div class="absolute -top-1.5 left-1/2 -translate-x-1/2 w-3 h-3 rounded-full bg-[#f25744] border-2 border-[#1c1726] shadow-sm flex items-center justify-center">
            <div class="w-0.5 h-0.5 rounded-full bg-white/70"></div>
          </div>

          <div class="font-pixel text-[10px] font-bold text-[#df4a32] uppercase tracking-wider">
            ON REPEAT
          </div>

          <div class="text-[9px] font-pixel text-ink-soft uppercase tracking-wider">
            TOP SONG
          </div>

          <div>
            <a href="https://open.spotify.com" target="_blank" rel="noopener noreferrer" class="font-sans text-xs font-bold text-[#1c1726] underline decoration-1 hover:text-[#df4a32] block">
              Solar Eclipse (feat. Don Toliver)
            </a>
            <div class="text-[11px] text-[#3a3150] font-sans">
              by Don Toliver
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Navigation Links (Where to?) -->
  <WhereTo currentPath="/" />

  <!-- Monospace / Pixel Footer matching si-dan.com -->
  <footer class="flex flex-col sm:flex-row items-center justify-between text-[11px] font-pixel text-ink-soft mt-3 px-1 gap-2">
    <span>Built by Muhammad Zulfan with Astro, Rust/WASM, and Cloudflare.</span>
    <div class="flex items-center gap-3">
      <a href="/about" class="text-[#df4a32] underline hover:text-[#b8331f]">How this site works</a>
      <a href="/reception" class="text-[#df4a32] underline hover:text-[#b8331f]">Privacy</a>
    </div>
  </footer>
</TownLayout>
