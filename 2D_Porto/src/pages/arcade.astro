---
import TownLayout from '../layouts/TownLayout.astro';
import '../styles/dev.css';
import '../styles/arcade.css';
---

<TownLayout
  place="arcade"
  title="The Arcade · Beat my Mancala robot — Muhammad Zulfan"
  description="Play Mancala against an Alpha-Beta search robot running in WebAssembly."
>
  <div class="mcp mcp--arcade space-y-6">
    <header class="page-header">
      <p class="kicker pixel">🕹️ Arcade</p>
      <h1 id="panel-title" tabindex="-1">Beat my Mancala robot</h1>
      <p>
        The robot in the back of the arcade plays my FairKalah agent: alpha-beta search with a regression-tuned heuristic, ported to Rust and running directly in your browser via WebAssembly. Its face displays real-time emotional moods based on win probability evaluation.
      </p>
      <p class="pt-2">
        <button class="btn btn--primary" type="button" data-play>Play Mancala</button>
      </p>
    </header>

    <!-- How the bot works card -->
    <section class="mcp-card space-y-3" aria-labelledby="bot-title">
      <h2 id="bot-title" class="mcp-h flex items-center gap-2">
        <span>🤖</span> How the bot works
      </h2>
      <p class="mcp-dim leading-relaxed">
        The opponent evaluates future board permutations using an <strong>Alpha-Beta minimax search algorithm</strong>. Calculations execute in a dedicated background <code>Web Worker</code> thread, ensuring that 60 FPS canvas rendering and UI animations never experience micro-stuttering.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-3 border-t border-ink/10 font-mono text-xs">
        <div class="p-2.5 bg-paper rounded border border-ink/10">
          <span class="text-ink font-bold block">EASY (Lv 5)</span>
          <span class="text-ink-soft text-[11px]">5s thinking pool, early search cutoff.</span>
        </div>
        <div class="p-2.5 bg-paper rounded border border-ink/10">
          <span class="text-ink font-bold block">MEDIUM (Lv 30)</span>
          <span class="text-ink-soft text-[11px]">30s time pool, ~10-14 plies deep.</span>
        </div>
        <div class="p-2.5 bg-paper rounded border border-ink/10">
          <span class="text-ink font-bold block">HARD (Lv 99)</span>
          <span class="text-ink-soft text-[11px]">300s time pool, tournament depth.</span>
        </div>
      </div>
    </section>

    <!-- Arcade Room Guide Card -->
    <section class="mcp-card space-y-2">
      <h2 class="mcp-h">Arcade Room Attractions</h2>
      <ul class="clean space-y-2 text-xs text-ink-soft">
        <li class="flex items-center gap-2">
          <span>🕹️</span>
          <span><strong>Retro Cabinets:</strong> Walk up to Stone Muncher, Kalah Kart, Mega Mancala III, Pit Fighter, Alpha-Beta Blasters, and Space Seeders.</span>
        </li>
        <li class="flex items-center gap-2">
          <span>🏆</span>
          <span><strong>Scoreboard:</strong> Inspect global statistics for Robot vs. Everyone.</span>
        </li>
        <li class="flex items-center gap-2">
          <span>🤖</span>
          <span><strong>Mancala Robot:</strong> Walk to the back table or click "Play Mancala" to enter the Game Boy battle arena.</span>
        </li>
      </ul>
    </section>
  </div>
</TownLayout>

<!-- Game Boy Mancala Battle Dialog matching si-dan.com/arcade -->
<div class="gb" data-battle hidden role="dialog" aria-modal="true" aria-labelledby="gb-title" tabindex="-1">
  <h2 id="gb-title" class="visually-hidden">Mancala against the robot</h2>
  <div class="gb__top">
    <button class="gb__btn" type="button" data-sound aria-label="Sound" aria-pressed="false">♪ OFF</button>
    <button class="gb__btn" type="button" data-run>RUN</button>
  </div>
  <div class="gb__stage">
    <section class="gb__info gb__info--foe" aria-label="Robot">
      <p class="gb__name">ROBOT <span class="gb__lv" data-level>Lv??</span></p>
      <div class="gb__bar">
        <span class="gb__tag">WIN</span>
        <span class="gb__track"><span class="gb__fill" data-foe-bar></span></span>
      </div>
      <p class="gb__num">
        <span data-foe-pct>50%</span>
        <span class="gb__stats" data-stats></span>
      </p>
    </section>

    <div class="gb__foe" data-foe>
      <canvas class="gb__sprite gb__sprite--robot" data-robot role="img" aria-label="The robot"></canvas>
    </div>

    <div class="gb__board" role="group" aria-label="Mancala board">
      <div class="gb__store gb__store--foe" data-store="top" aria-label="Robot's store">0</div>
      <div class="gb__row" data-row="top"></div>
      <div class="gb__row" data-row="bottom"></div>
      <div class="gb__store gb__store--me" data-store="bottom" aria-label="Your store">0</div>
    </div>

    <div class="gb__me" data-me>
      <canvas class="gb__sprite gb__sprite--player" data-player aria-hidden="true"></canvas>
    </div>

    <section class="gb__info gb__info--me" aria-label="You">
      <p class="gb__name">YOU</p>
      <div class="gb__bar">
        <span class="gb__tag">WIN</span>
        <span class="gb__track"><span class="gb__fill" data-me-bar></span></span>
      </div>
      <p class="gb__num">
        <span data-me-pct>50%</span>
      </p>
    </section>
  </div>

  <div class="gb__dialog" data-dialog>
    <p class="gb__text" data-text aria-hidden="true"></p>
    <p class="visually-hidden" data-live aria-live="polite"></p>
    <span class="gb__more" data-more aria-hidden="true" hidden>▼</span>
    <ul class="gb__menu" data-menu role="listbox" aria-label="Choices" hidden></ul>
  </div>

  <div class="gb__popup" data-popup hidden>
    <div class="gb__window" role="document" aria-labelledby="gb-popup-title">
      <p class="gb__window-title" id="gb-popup-title" data-popup-title></p>
      <div class="gb__window-body" data-popup-body></div>
      <p class="gb__window-ok"><span aria-hidden="true">▶</span> OK</p>
    </div>
  </div>
</div>

<script>
  // Chiptune Audio Synthesizer via Web Audio API oscillators
  const SFX_PITCHES: Record<string, [number, number][]> = {
    blip: [[880, 18]],
    move: [[660, 40]],
    select: [[990, 50], [1320, 70]],
    back: [[440, 60]],
    drop: [[520, 45]],
    store: [[784, 60], [1046, 90]],
    capture: [[523, 70], [659, 70], [784, 70], [1046, 140]],
    extra: [[784, 80], [988, 80], [1175, 160]],
    win: [[523, 120], [659, 120], [784, 120], [1046, 120], [784, 100], [1046, 320]],
    lose: [[392, 180], [370, 180], [349, 180], [330, 420]],
    start: [[392, 90], [523, 90], [659, 90], [784, 200]],
  };

  class ArcadeSFX {
    ctx: AudioContext | null = null;
    on = false;

    constructor() {
      try {
        this.on = localStorage.getItem('arcade-sound') === 'on';
      } catch {}
    }

    toggle() {
      this.on = !this.on;
      try {
        localStorage.setItem('arcade-sound', this.on ? 'on' : 'off');
      } catch {}
      if (this.on) this.play('select');
      return this.on;
    }

    play(name: string, pitchMod = 1) {
      if (!this.on) return;
      this.ctx ??= new (window.AudioContext || (window as any).webkitAudioContext)();
      const ctx = this.ctx;
      if (ctx.state === 'suspended') ctx.resume();
      let t = ctx.currentTime;
      const notes = SFX_PITCHES[name] || [[440, 50]];
      for (const [freq, durationMs] of notes) {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'square';
        osc.frequency.value = freq * pitchMod;
        gain.gain.setValueAtTime(0.06, t);
        gain.gain.exponentialRampToValueAtTime(0.0008, t + durationMs / 1000);
        osc.connect(gain).connect(ctx.destination);
        osc.start(t);
        osc.stop(t + durationMs / 1000);
        t += durationMs / 1000;
      }
    }
  }

  // Player pixel matrix facing up (12x18)
  const PLAYER_UP = [
