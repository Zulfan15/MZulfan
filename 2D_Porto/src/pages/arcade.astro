---
import TownLayout from '../layouts/TownLayout.astro';
import '../styles/dev.css';
import '../styles/arcade.css';
---

<TownLayout
  place="arcade"
  title="The Arcade · Challenge Deoxys to Mancala — Muhammad Zulfan"
  description="Play Mancala against Mythical Pokémon Deoxys powered by an Alpha-Beta search agent in WebAssembly."
>
  <div class="mcp mcp--arcade space-y-6">
    <header class="mcp-card p-5 space-y-3">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-cyan-950/80 border border-cyan-400 text-cyan-300 font-mono text-[10px] font-bold tracking-wider">
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
          DEOXYS MANCALA ARENA
        </span>
      </div>
      <h1 id="panel-title" class="font-pixel text-base md:text-lg text-white" tabindex="-1">
        Challenge Deoxys to Mancala
      </h1>
      <p class="text-slate-300 text-xs md:text-sm leading-relaxed">
        The Mythical Pokémon Deoxys hovering in the back of the arcade plays my FairKalah agent: alpha-beta search with a regression-tuned heuristic, ported to Rust and running directly in your browser via WebAssembly. Its core pulses with real-time cosmic moods based on win probability evaluation.
      </p>
      <div class="pt-2">
        <button class="btn btn-primary font-pixel text-xs bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white border-2 border-cyan-300 px-4 py-2.5 shadow-md" type="button" data-play>
          ⚔️ Play Mancala
        </button>
      </div>
    </header>

    <!-- How the bot works card -->
    <section class="mcp-card p-5 space-y-3" aria-labelledby="bot-title">
      <h2 id="bot-title" class="flex items-center gap-2 font-pixel text-xs text-cyan-400 uppercase tracking-wide">
        <span>🌌</span> How the Deoxys AI Works
      </h2>
      <p class="text-slate-300 text-xs leading-relaxed">
        The opponent evaluates future board permutations using an <strong class="text-white font-semibold">Alpha-Beta minimax search algorithm</strong>. Calculations execute in a dedicated background <code class="px-1.5 py-0.5 rounded bg-black/60 border border-cyan-500/30 text-cyan-300 font-mono text-[11px]">Web Worker</code> thread, ensuring that 60 FPS canvas rendering and UI animations never experience micro-stuttering.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-3 border-t border-purple-900/40 font-mono text-xs">
        <div class="p-3 bg-slate-900/90 rounded-lg border border-purple-500/30 shadow-sm">
          <span class="text-cyan-300 font-bold block mb-1">EASY (Lv 5)</span>
          <span class="text-slate-400 text-[11px] leading-relaxed">5s thinking pool, early search cutoff.</span>
        </div>
        <div class="p-3 bg-slate-900/90 rounded-lg border border-purple-500/30 shadow-sm">
          <span class="text-amber-300 font-bold block mb-1">MEDIUM (Lv 30)</span>
          <span class="text-slate-400 text-[11px] leading-relaxed">30s time pool, ~10-14 plies deep.</span>
        </div>
        <div class="p-3 bg-slate-900/90 rounded-lg border border-purple-500/30 shadow-sm">
          <span class="text-rose-400 font-bold block mb-1">HARD (Lv 99)</span>
          <span class="text-slate-400 text-[11px] leading-relaxed">300s time pool, tournament depth.</span>
        </div>
      </div>
    </section>

    <!-- Arcade Room Guide Card -->
    <section class="mcp-card p-5 space-y-3">
      <h2 class="font-pixel text-xs text-cyan-400 uppercase tracking-wide">
        Arcade Room Attractions
      </h2>
      <ul class="clean space-y-2.5 text-xs text-slate-300">
        <li class="flex items-start gap-2.5">
          <span class="text-base leading-none">🕹️</span>
          <span><strong class="text-white font-semibold">Retro Cabinets:</strong> Walk up to Stone Muncher, Kalah Kart, Mega Mancala III, Pit Fighter, Alpha-Beta Blasters, and Space Seeders.</span>
        </li>
        <li class="flex items-start gap-2.5">
          <span class="text-base leading-none">🏆</span>
          <span><strong class="text-white font-semibold">Scoreboard:</strong> Inspect global statistics for Deoxys vs. Everyone.</span>
        </li>
        <li class="flex items-start gap-2.5">
          <span class="text-base leading-none">🤖</span>
          <span><strong class="text-white font-semibold">Mancala Deoxys:</strong> Walk to the back table or click "Play Mancala" to enter the Game Boy battle arena.</span>
        </li>
      </ul>
    </section>
  </div>
</TownLayout>

<!-- Game Boy Mancala Battle Dialog matching si-dan.com/arcade -->
<div class="gb" data-battle hidden role="dialog" aria-modal="true" aria-labelledby="gb-title" tabindex="-1">
  <h2 id="gb-title" class="visually-hidden">Mancala battle against Deoxys</h2>
  <div class="gb__top">
    <button class="gb__btn" type="button" data-sound aria-label="Sound" aria-pressed="false">♪ OFF</button>
    <button class="gb__btn" type="button" data-run>RUN</button>
  </div>
  <div class="gb__stage">
    <section class="gb__info gb__info--foe" aria-label="Deoxys">
      <p class="gb__name">DEOXYS <span class="gb__lv" data-level>Lv70</span></p>
      <div class="gb__bar">
        <span class="gb__tag">WIN</span>
        <span class="gb__track"><span class="gb__fill" data-foe-bar></span></span>
      </div>
      <p class="gb__num">
        <span data-foe-pct>50%</span>
        <span class="gb__stats" data-stats></span>
      </p>
    </section>

    <div class="gb__foe" data-foe>
      <canvas class="gb__sprite gb__sprite--robot" data-robot role="img" aria-label="Deoxys"></canvas>
    </div>

    <div class="gb__board" role="group" aria-label="Mancala board">
      <div class="gb__store gb__store--foe" data-store="top" aria-label="Deoxys's store">0</div>
      <div class="gb__row" data-row="top"></div>
      <div class="gb__row" data-row="bottom"></div>
      <div class="gb__store gb__store--me" data-store="bottom" aria-label="Ash's store">0</div>
    </div>

    <div class="gb__me" data-me>
      <canvas class="gb__sprite gb__sprite--player" data-player aria-label="Ash Ketchum"></canvas>
    </div>

    <section class="gb__info gb__info--me" aria-label="Ash">
      <p class="gb__name">ASH</p>
      <div class="gb__bar">
        <span class="gb__tag">WIN</span>
        <span class="gb__track"><span class="gb__fill" data-me-bar></span></span>
      </div>
      <p class="gb__num">
        <span data-me-pct>50%</span>
      </p>
    </section>
  </div>

  <div class="gb__dialog" data-dialog>
    <p class="gb__text" data-text aria-hidden="true"></p>
    <p class="visually-hidden" data-live aria-live="polite"></p>
    <span class="gb__more" data-more aria-hidden="true" hidden>▼</span>
    <ul class="gb__menu" data-menu role="listbox" aria-label="Choices" hidden></ul>
  </div>

  <div class="gb__popup" data-popup hidden>
    <div class="gb__window" role="document" aria-labelledby="gb-popup-title">
      <p class="gb__window-title" id="gb-popup-title" data-popup-title></p>
      <div class="gb__window-body" data-popup-body></div>
      <p class="gb__window-ok"><span aria-hidden="true">▶</span> OK</p>
    </div>
  </div>
</div>

<script>
  // Chiptune Audio Synthesizer via Web Audio API oscillators
  const SFX_PITCHES: Record<string, [number, number][]> = {
    blip: [[880, 18]],
    move: [[660, 40]],
    select: [[990, 50], [1320, 70]],
    back: [[440, 60]],
    drop: [[520, 45]],
    store: [[784, 60], [1046, 90]],
    capture: [[523, 70], [659, 70], [784, 70], [1046, 140]],
    extra: [[784, 80], [988, 80], [1175, 160]],
    win: [[523, 120], [659, 120], [784, 120], [1046, 120], [784, 100], [1046, 320]],
    lose: [[392, 180], [370, 180], [349, 180], [330, 420]],
    start: [[392, 90], [523, 90], [659, 90], [784, 200]],
  };

  class ArcadeSFX {
    ctx: AudioContext | null = null;
    on = false;

    constructor() {
      try {
        this.on = localStorage.getItem('arcade-sound') === 'on';
      } catch {}
    }

    toggle() {
      this.on = !this.on;
      try {
        localStorage.setItem('arcade-sound', this.on ? 'on' : 'off');
      } catch {}
      if (this.on) this.play('select');
      return this.on;
    }

    play(name: string, pitchMod = 1) {
      if (!this.on) return;
      this.ctx ??= new (window.AudioContext || (window as any).webkitAudioContext)();
      const ctx = this.ctx;
      if (ctx.state === 'suspended') ctx.resume();
      let t = ctx.currentTime;
      const notes = SFX_PITCHES[name] || [[440, 50]];
      for (const [freq, durationMs] of notes) {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'square';
        osc.frequency.value = freq * pitchMod;
        gain.gain.setValueAtTime(0.06, t);
        gain.gain.exponentialRampToValueAtTime(0.0008, t + durationMs / 1000);
        osc.connect(gain).connect(ctx.destination);
        osc.start(t);
        osc.stop(t + durationMs / 1000);
        t += durationMs / 1000;
      }
    }
  }

  // Ash Ketchum pixel matrix facing up (18x20, with Pikachu on right shoulder)
  const ASH_PALETTE: Record<string, string> = {
    b: '#000000', // Black outline, hair, eyes, black undershirt, shoes
    w: '#ffffff', // White cap front & collar & socks
    r: '#de1e1b', // Red cap visor & Pikachu cheeks
    g: '#00b23a', // Green cap emblem & fingerless gloves
    s: '#fecda5', // Skin tone
    u: '#0665d9', // Blue vest & pants
    y: '#fed700', // Yellow Pikachu body & tail
    o: '#feb800', // Golden yellow belt & buckle
    d: '#8b4513', // Brown Pikachu back stripes
  };

  const ASH_UP = [
    "....bbbbbb........",
    "...brrrrrrbb..bb..",
    "..brrrrrrrrb.byb..",
    "..brrrrrrrrbbyybbb",
    "..brrrrrrrbyyyyyb.",
    ".bbbbbbbbbbyyyyb..",
    "bbbbbbbbbbbyydyb.b",
    ".bbbbbbbbbbbyyybbb",
    "..bbbbbbbbbyydyybb",
    "...bssssbbbyybryb.",
    "..buwbbbwubbyybb..",
    ".bwbubbuuuw.bb....",
    ".bsbubbuub.sb.....",
    ".bgbubbuuubgb.....",
    ".bgbubbuuubgb.....",
    "..bbouuooobb......",
    "...buubbuub.......",
    "...bwwbbwwb.......",
    "..bbbb.bbbb.......",
    "..bbbb.bbbb.......",
  ];

  // Deoxys base64 sprite data URL (96x96 official Black/White sprite)
  const DEOXYS_SRC =
    'data:image/png;base64,';

  let deoxysSprite: HTMLImageElement | null = null;
  if (typeof Image !== 'undefined') {
    deoxysSprite = new Image();
    deoxysSprite.onload = () => {
      if (battleInstance) {
        battleInstance.renderFoeSprite();
      }
    };
    deoxysSprite.onerror = () => {
      if (deoxysSprite && deoxysSprite.src !== DEOXYS_SRC) {
        deoxysSprite.src = DEOXYS_SRC;
      }
    };
    // Preload from static asset first, fallback to verified base64
    deoxysSprite.src = '/assets/deoxys.png';
  }

  function drawDeoxys(ctx: CanvasRenderingContext2D, moodKey: string, bulbLit = true) {
    ctx.clearRect(0, 0, 96, 96);

    const moodAuras: Record<string, { ring: string; core: string }> = {
      idle: { ring: 'rgba(168, 85, 247, 0.28)', core: '#7df9ff' },
      thinking: { ring: 'rgba(250, 204, 21, 0.38)', core: '#ffd166' },
      gloat: { ring: 'rgba(236, 72, 153, 0.38)', core: '#ff77aa' },
      happy: { ring: 'rgba(56, 189, 248, 0.38)', core: '#59f0d0' },
      neutral: { ring: 'rgba(168, 85, 247, 0.28)', core: '#7df9ff' },
      worried: { ring: 'rgba(249, 115, 22, 0.38)', core: '#ffb347' },
      panic: { ring: 'rgba(239, 68, 68, 0.48)', core: '#ff5c5c' },
      won: { ring: 'rgba(34, 197, 94, 0.48)', core: '#7dffb0' },
      lost: { ring: 'rgba(148, 163, 184, 0.28)', core: '#94a3b8' },
      draw: { ring: 'rgba(168, 85, 247, 0.28)', core: '#ffd166' },
    };

    const aura = moodAuras[moodKey] || moodAuras.idle;

    ctx.save();
    // Pulsating psychic cosmic aura
    ctx.fillStyle = aura.ring;
    ctx.beginPath();
    ctx.arc(48, 48, 40, 0, Math.PI * 2);
    ctx.fill();

    // Deoxys sprite
    if (deoxysSprite && deoxysSprite.complete && deoxysSprite.naturalWidth > 0) {
      ctx.imageSmoothingEnabled = false;
      ctx.drawImage(deoxysSprite, 0, 0, 96, 96);
    }

    // Glowing crystalline chest core (centered at 48, 49)
    if (bulbLit) {
      ctx.fillStyle = aura.core;
      ctx.beginPath();
      ctx.arc(48, 49, 3.5, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(47, 48, 1, 1);
    }
    ctx.restore();
  }

  // Deoxys telepathic dialogue quotes per emotion
  const DEOXYS_QUOTES: Record<string, string[]> = {
    gloat: [
      'The cosmic alignment is complete.',
      'Your tactical frequency is falling apart.',
      'My psychic calculations foresee no path to victory for you.',
      'DNA sequence recalibrated for dominance.',
    ],
    happy: [
      'The cosmic flow bends in my direction.',
      'Interesting move, but space is under my command.',
      'A harmonious configuration of cosmic energy.',
      'The gravitational tides favor me.',
    ],
    neutral: [
      'Observing terrestrial maneuvers...',
      'Spatial coordinates holding steady.',
      'A balanced exchange across space-time.',
      'The vortex remains neutral.',
    ],
    worried: [
      'Unforeseen spatial distortion detected...',
      'Recalculating multidimensional trajectories...',
      'My crystal core resonates with erratic vibrations...',
      'A disturbance in the cosmic field...',
    ],
    panic: [
      'CRITICAL: Quantum variance exceeds safety thresholds!',
      'How did you pierce my psychic defense?!',
      'Atmospheric pressure destabilizing...',
      'Core instability detected!',
    ],
    won: [
      'The cosmos has spoken.',
      'Your energy disperses back into the void.',
      'A noble battle, human trainer.',
    ],
    lost: [
      'Incredible... you pierced through my defense.',
      'The DNA helix unravels... well played, Ash.',
      'I shall retreat to deep space to adapt.',
    ],
    draw: [
      'A perfect cosmic equilibrium.',
      'Neither light nor void prevails today.',
    ],
  };

  function randomQuote(mood: string): string {
    const list = DEOXYS_QUOTES[mood] || DEOXYS_QUOTES.neutral;
    return list[Math.floor(Math.random() * list.length)];
  }

  // Alpha-Beta Search Engine Web Worker Client
  class MancalaEngineClient {
    worker: Worker | null = null;
    nextId = 1;
    pending = new Map<number, (res: any) => void>();

    get w(): Worker {
      if (!this.worker) {
        this.worker = new Worker('/workers/mancala.worker.js');
        this.worker.onmessage = (e) => {
          const handler = this.pending.get(e.data.id);
          if (handler) {
            handler(e.data);
            this.pending.delete(e.data.id);
          }
        };
      }
      return this.worker;
    }

    call(req: any): Promise<any> {
      const id = this.nextId++;
      return new Promise((resolve, reject) => {
        this.pending.set(id, (res) => (res.op === 'error' ? reject(new Error(res.message)) : resolve(res)));
        this.w.postMessage({ ...req, id });
      });
    }

    board(index: number) {
      return this.call({ op: 'board', index });
    }

    apply(state: number[], player: number, move: number) {
      return this.call({ op: 'apply', state, player, move });
    }

    choose(state: number[], player: number, timeMs: number) {
      return this.call({ op: 'choose', state, player, timeMs });
    }

    reset() {
      this.worker?.terminate();
      this.worker = null;
      for (const handler of this.pending.values()) {
        handler({ id: -1, op: 'error', message: 'cancelled' });
      }
      this.pending.clear();
    }
  }

  const STORES = [6, 13];
  const CLASSIC_START = [4, 4, 4, 4, 4, 4, 0, 4, 4, 4, 4, 4, 4, 0];
  const LEVELS = [
    { key: 'easy', label: 'EASY', ms: 5000, lv: 50 },
    { key: 'medium', label: 'MEDIUM', ms: 30000, lv: 70 },
    { key: 'hard', label: 'HARD', ms: 300000, lv: 100 },
  ];

  const FAIRKALAH_INFO = [
    'In classic Kalah, the player who moves first can always win with perfect play. Not very fair!',
    'A FAIRKALAH board fixes that. The 48 stones start spread unevenly across the pits, in a layout picked so that if both players make the best possible moves, the game ends in a DRAW.',
    'No head start for anyone. Whoever slips up first loses.',
  ];

  const KEY_STEPS: Record<string, number> = {
    ArrowUp: -1,
    ArrowLeft: -1,
    w: -1,
    a: -1,
    W: -1,
    A: -1,
    ArrowDown: 1,
    ArrowRight: 1,
    s: 1,
    d: 1,
    S: 1,
    D: 1,
  };

  const CANCEL_SYM = Symbol('cancel');
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

  function winProb(evalVal: number, player: number): number {
    return 1 / (1 + Math.exp(-(player === 0 ? evalVal : -evalVal) / 5));
  }

  function getMoodFromProb(prob: number): string {
    return prob >= 0.88 ? 'gloat' : prob >= 0.65 ? 'happy' : prob >= 0.35 ? 'neutral' : prob >= 0.12 ? 'worried' : 'panic';
  }

  // Global game controller instance
  class MancalaBattle {
    root: HTMLElement;
    engine = new MancalaEngineClient();
    sfx = new ArcadeSFX();
    robotCtx: CanvasRenderingContext2D;
    playerCtx: CanvasRenderingContext2D;

    session = 0;
    typing = false;
    skip = false;
    waiter: { resolve: (val?: any) => void; reject: (err: any) => void } | null = null;
    menu: { options: { label: string; value: any }[]; index: number; resolve: (val: any) => void } | null = null;
    pitChoice: { legal: number[]; index: number; resolve: (val: number) => void } | null = null;

    state = [...CLASSIC_START];
    human = 0;
    level = LEVELS[1];
    clock = 0;
    mood = 'idle';
    lastMove = -1;
    hot = -1;
    flash = new Set<number>();
    blinkTimer = 0;

    answers = { board: 0, side: 0, level: 1 };

    // Elements
    elText!: HTMLElement;
    elLive!: HTMLElement;
    elMore!: HTMLElement;
    elMenu!: HTMLElement;
    elRobotCanvas!: HTMLCanvasElement;
    elPlayerCanvas!: HTMLCanvasElement;
    elFoe!: HTMLElement;
    elRowTop!: HTMLElement;
    elRowBottom!: HTMLElement;
    elStoreTop!: HTMLElement;
    elStoreBottom!: HTMLElement;
    elBarFoe!: HTMLElement;
    elBarMe!: HTMLElement;
    elPctFoe!: HTMLElement;
    elPctMe!: HTMLElement;
    elLevel!: HTMLElement;
    elStats!: HTMLElement;
    elSoundBtn!: HTMLButtonElement;
    elRunBtn!: HTMLButtonElement;
    elDialog!: HTMLElement;
    elPopup!: HTMLElement;
    elPopupTitle!: HTMLElement;
    elPopupBody!: HTMLElement;

    constructor(root: HTMLElement) {
      this.root = root;
      this.initDom();
      this.robotCtx = this.elRobotCanvas.getContext('2d')!;
      this.playerCtx = this.elPlayerCanvas.getContext('2d')!;
      this.renderPlayerSprite();
      this.renderFoeSprite();
      this.bind();
      this.updateSoundBtn();
    }

    initDom() {
      const q = (s: string) => this.root.querySelector(s) as HTMLElement;
      this.elText = q('[data-text]');
      this.elLive = q('[data-live]');
      this.elMore = q('[data-more]');
      this.elMenu = q('[data-menu]');
      this.elRobotCanvas = q('[data-robot]') as HTMLCanvasElement;
      this.elPlayerCanvas = q('[data-player]') as HTMLCanvasElement;
      this.elFoe = q('[data-foe]');
      this.elRowTop = q('[data-row="top"]');
      this.elRowBottom = q('[data-row="bottom"]');
      this.elStoreTop = q('[data-store="top"]');
      this.elStoreBottom = q('[data-store="bottom"]');
      this.elBarFoe = q('[data-foe-bar]');
      this.elBarMe = q('[data-me-bar]');
      this.elPctFoe = q('[data-foe-pct]');
      this.elPctMe = q('[data-me-pct]');
      this.elLevel = q('[data-level]');
      this.elStats = q('[data-stats]');
      this.elSoundBtn = q('[data-sound]') as HTMLButtonElement;
      this.elRunBtn = q('[data-run]') as HTMLButtonElement;
      this.elDialog = q('[data-dialog]');
      this.elPopup = q('[data-popup]');
      this.elPopupTitle = q('[data-popup-title]');
      this.elPopupBody = q('[data-popup-body]');

      this.elRobotCanvas.width = 96;
      this.elRobotCanvas.height = 96;
      this.elPlayerCanvas.width = 18;
      this.elPlayerCanvas.height = 20;
    }

    renderFoeSprite() {
      drawDeoxys(this.robotCtx, this.mood, true);
    }

    renderPlayerSprite() {
      const ctx = this.playerCtx;
      ctx.clearRect(0, 0, 18, 20);
      ASH_UP.forEach((row, r) => {
        [...row].forEach((char, c) => {
          if (char === '.' || char === ' ') return;
          const col = ASH_PALETTE[char];
          if (col) {
            ctx.fillStyle = col;
            ctx.fillRect(c, r, 1, 1);
          }
        });
      });
    }

    updateSoundBtn() {
      this.elSoundBtn.textContent = this.sfx.on ? '♪ ON' : '♪ OFF';
      this.elSoundBtn.setAttribute('aria-pressed', String(this.sfx.on));
    }

    async open() {
      if (!this.root.hidden) return;
      const curSession = ++this.session;
      this.root.hidden = false;
      this.root.classList.remove('is-entering');
      void this.root.offsetWidth;
      this.root.classList.add('is-entering');
      document.dispatchEvent(new CustomEvent('town:pause'));
      this.root.focus({ preventScroll: true });
      this.resetBoard();

      try {
        this.sfx.play('start');
        await sleep(700);
        await this.say('A wild DEOXYS appeared!', true);
        await this.say('DEOXYS wants to play MANCALA!', true);

        do {
          await this.setup();
        } while (await this.play());

        await this.say("DEOXYS: Return to the cosmos when you wish to challenge me again.", true);
        this.close();
      } catch (err) {
        if (curSession !== this.session || err === CANCEL_SYM) return;
        await this.say(`ERROR! ${err instanceof Error ? err.message : String(err)}`, true).catch(() => {});
        this.close();
      }
    }

    close() {
      this.cancel();
      this.root.hidden = true;
      document.dispatchEvent(new CustomEvent('town:resume'));
      document.dispatchEvent(new CustomEvent('town:focus'));
    }

    async runAway() {
      if (this.root.hidden) return;
      this.cancel();
      const s = this.session;
      this.sfx.play('back');
      await this.say('Got away safely!').catch(() => {});
      if (s === this.session) this.close();
    }

    cancel() {
      this.session++;
      this.engine.reset();
      this.waiter?.reject(CANCEL_SYM);
      this.waiter = null;
      this.menu = null;
      this.pitChoice = null;
      this.elMenu.hidden = true;
      this.elMore.hidden = true;
      this.elPopup.hidden = true;
      this.setThinking(false);
    }

    check(s: number) {
      if (s !== this.session) throw CANCEL_SYM;
    }

    bind() {
      window.addEventListener(
        'keydown',
        (e) => {
          if (this.root.hidden || e.altKey || e.ctrlKey || e.metaKey) return;
          if (e.key === 'Escape') {
            e.preventDefault();
            this.runAway();
            return;
          }
          if (e.target instanceof HTMLButtonElement && e.target.closest('.gb__top')) return;

          const step = KEY_STEPS[e.key];
          const isConfirm = ['Enter', ' ', 'z', 'Z'].includes(e.key);

          if (this.menu && step) {
            this.moveMenu(step);
          } else if (this.menu && isConfirm) {
            this.pickMenu(this.menu.index);
          } else if (this.pitChoice && step) {
            this.movePit(step);
          } else if (this.pitChoice && isConfirm) {
            this.pickPit(this.pitChoice.legal[this.pitChoice.index]);
          } else if (this.pitChoice && /^[1-6]$/.test(e.key)) {
            const pit = this.layout().bottom[Number(e.key) - 1];
            if (this.pitChoice.legal.includes(pit)) this.pickPit(pit);
          } else if (isConfirm) {
            this.advance();
          } else {
            return;
          }
          e.preventDefault();
          e.stopPropagation();
        },
        { capture: true }
      );

      this.elDialog.addEventListener('click', (e) => {
        if (!(e.target as HTMLElement).closest('[data-menu]')) this.advance();
      });

      this.elPopup.addEventListener('click', () => this.advance());
      this.elRunBtn.addEventListener('click', () => void this.runAway());
      this.elSoundBtn.addEventListener('click', () => {
        this.sfx.toggle();
        this.updateSoundBtn();
      });
    }

    advance() {
      if (this.pitChoice || this.menu) return;
      if (this.typing || this.hot >= 0) {
        this.skip = true;
      } else if (this.waiter) {
        this.sfx.play('move');
        this.waiter.resolve();
        this.waiter = null;
      }
    }

    async say(text: string, waitConfirm = false) {
      const s = this.session;
      this.elLive.textContent = text;
      this.elMore.hidden = true;
      this.typing = true;
      this.skip = false;

      for (let i = 1; i <= text.length; i++) {
        if (this.skip) i = text.length;
        this.elText.textContent = text.slice(0, i);
        if (i % 3 === 0) this.sfx.play('blip');
        if (i < text.length) await sleep(24);
        this.check(s);
      }

      this.typing = false;
      this.skip = false;

      if (waitConfirm) {
        this.elMore.hidden = false;
        await new Promise((res, rej) => (this.waiter = { resolve: res, reject: rej }));
        this.elMore.hidden = true;
      } else {
        await sleep(450);
      }
      this.check(s);
    }

    async info(title: string, bodyLines: string[]) {
      const s = this.session;
      this.elPopupTitle.textContent = title;
      this.elPopupBody.replaceChildren(
        ...bodyLines.map((line) => Object.assign(document.createElement('p'), { textContent: line }))
      );
      this.elLive.textContent = `${title}. ${this.elPopupBody.textContent}`;
      this.elPopup.hidden = false;
      this.sfx.play('select');
      await new Promise((res, rej) => (this.waiter = { resolve: res, reject: rej }));
      this.elPopup.hidden = true;
      this.check(s);
    }

    async choose(prompt: string, options: { label: string; value: any }[], defaultIdx = 0): Promise<any> {
      await this.say(prompt);
      const s = this.session;
      const res = await new Promise((resolve) => {
        this.menu = { options, index: defaultIdx, resolve };
        this.renderMenu();
      });
      this.check(s);
      return res;
    }

    renderMenu() {
      const m = this.menu;
      this.elMenu.hidden = !m;
      if (!m) return;
      this.elMenu.replaceChildren(
        ...m.options.map((opt, idx) => {
          const li = document.createElement('li');
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'gb__option' + (idx === m.index ? ' is-current' : '');
          btn.textContent = opt.label;
          btn.setAttribute('role', 'option');
          btn.setAttribute('aria-selected', String(idx === m.index));
          btn.addEventListener('click', () => this.pickMenu(idx));
          li.append(btn);
          return li;
        })
      );
    }

    moveMenu(delta: number) {
      if (!this.menu) return;
      this.menu.index = (this.menu.index + delta + this.menu.options.length) % this.menu.options.length;
      this.sfx.play('move');
      this.renderMenu();
    }

    pickMenu(idx: number) {
      if (!this.menu) return;
      const resolver = this.menu.resolve;
      const val = this.menu.options[idx].value;
      this.menu = null;
      this.elMenu.hidden = true;
      this.sfx.play('select');
      resolver(val);
    }

    async setup() {
      const a = this.answers;
      let validBoard = false;
      while (!validBoard) {
        a.board = await this.choose(
          'DEOXYS: Which board shall we use?',
          [
            { label: 'CLASSIC', value: 0 },
            { label: 'FAIRKALAH', value: 1 },
            { label: "WHAT'S THAT?", value: 2 },
          ],
          a.board
        );
        if (a.board === 2) {
          await this.info('FAIRKALAH', FAIRKALAH_INFO);
          a.board = 1;
        } else {
          validBoard = true;
        }
      }

      a.side = await this.choose(
        'DEOXYS: Who shall make the first move?',
        [
          { label: 'ASH', value: 0 },
          { label: 'DEOXYS', value: 1 },
        ],
        a.side
      );

      a.level = await this.choose(
        'DEOXYS: How hard should I try?',
        LEVELS.map((lvl, idx) => ({
          label: `${lvl.label.padEnd(7)} Lv${String(lvl.lv).padEnd(3)}`,
          value: idx,
        })),
        a.level
      );
    }

    async play(): Promise<boolean> {
      const s = this.session;
      const a = this.answers;
      this.human = a.side;
      this.level = LEVELS[a.level];
      this.clock = this.level.ms;
      this.elLevel.textContent = `Lv${this.level.lv}`;
      this.elStats.textContent = '';
      this.lastMove = -1;

      if (a.board === 0) {
        this.state = [...CLASSIC_START];
      } else {
        const { count } = await this.engine.board(0);
        const randIdx = Math.floor(Math.random() * (count || 1));
        const res = await this.engine.board(randIdx);
        this.check(s);
        this.state = res.state;
        this.elStats.textContent = `BOARD #${randIdx}`;
      }

      this.setMood('neutral');
      this.setBars(0.5);
      this.render();
      this.sfx.play('start');
      await this.say(a.board === 0 ? 'CLASSIC KALAH! 4 stones in every pit.' : "FAIRKALAH! A board that's fair for both sides.");

      let currentTurn = 0;
      let firstTurn = true;
      let isGameOver = false;

      while (!isGameOver) {
        if (currentTurn === this.human) {
          await this.say(firstTurn ? 'What will YOU do? Pick a pit on your side.' : 'What will YOU do?');
          firstTurn = false;
          const chosenPit = await this.waitForPit(s);
          const prevState = [...this.state];
          const outcome = await this.engine.apply(this.state, this.human, chosenPit);
          this.check(s);
          await this.sow(prevState, this.human, chosenPit, outcome.state);
          isGameOver = outcome.over;
          const goesAgain = !isGameOver && outcome.next === this.human;
          currentTurn = outcome.next;
          await this.afterMove(prevState, this.human, chosenPit, outcome.state, goesAgain, isGameOver);
          if (!isGameOver) {
            const evalRes = await this.engine.choose(this.state, currentTurn, 2000);
            this.check(s);
            await this.react(evalRes.value);
          }
        } else {
          this.setThinking(true);
          const chooseTask = this.engine.choose(this.state, currentTurn, this.clock);
          await this.say('DEOXYS is computing spatial moves...');
          const searchResult = await chooseTask;
          this.check(s);
          this.setThinking(false);
          this.clock -= searchResult.ms;
          const fmtNodes = new Intl.NumberFormat('en-US', { notation: 'compact', maximumFractionDigits: 1 })
            .format(searchResult.nodes)
            .toUpperCase();
          this.elStats.textContent = `DEPTH ${searchResult.depth} · ${fmtNodes} POS`;

          const prevState = [...this.state];
          const outcome = await this.engine.apply(this.state, currentTurn, searchResult.move);
          this.check(s);
          const stonesCount = prevState[searchResult.move];
          await this.say(`DEOXYS sowed ${stonesCount} stone${stonesCount === 1 ? '' : 's'}!`);
          await this.sow(prevState, currentTurn, searchResult.move, outcome.state);
          isGameOver = outcome.over;
          const goesAgain = !isGameOver && outcome.next === currentTurn;
          await this.afterMove(prevState, currentTurn, searchResult.move, outcome.state, goesAgain, isGameOver);
          currentTurn = outcome.next;
          if (!isGameOver) await this.react(searchResult.value);
        }
      }

      await this.finish();
      return await this.choose('Play again?', [
        { label: 'YES', value: true },
        { label: 'NO', value: false },
      ]);
    }

    waitForPit(s: number): Promise<number> {
      const legalPits = this.layout().bottom.filter((idx) => this.state[idx] > 0);
      return new Promise((resolve, reject) => {
        const lastIdx = legalPits.indexOf(this.lastMove);
        this.pitChoice = { legal: legalPits, index: Math.max(0, lastIdx), resolve };
        this.waiter = { resolve: () => {}, reject };
        this.render();
      }).then((pit) => {
        this.check(s);
        return pit as number;
      });
    }

    movePit(delta: number) {
      if (!this.pitChoice) return;
      this.pitChoice.index = (this.pitChoice.index + delta + this.pitChoice.legal.length) % this.pitChoice.legal.length;
      this.sfx.play('move');
      this.render();
    }

    pickPit(pit: number) {
      if (!this.pitChoice || !this.pitChoice.legal.includes(pit)) return;
      const resolver = this.pitChoice.resolve;
      this.pitChoice = null;
      this.waiter = null;
      this.sfx.play('select');
      resolver(pit);
    }

    async sow(startState: number[], player: number, pit: number, finalState: number[]) {
      const s = this.session;
      const current = [...startState];
      let stones = current[pit];
      current[pit] = 0;
      let pos = pit;
      const oppStore = STORES[1 - player];
      this.lastMove = pit;
      this.skip = false;

      let dropStep = 1;
      while (stones > 0) {
        pos = (pos + 1) % 14;
        if (pos !== oppStore) {
          current[pos]++;
          stones--;
          this.hot = pos;
          this.state = current;
          this.render();
          this.sfx.play(pos === STORES[player] ? 'store' : 'drop', 1 + dropStep++ * 0.05);
          if (!this.skip) await sleep(170);
          this.check(s);
        }
      }

      this.hot = -1;
      this.skip = false;
      this.flash = new Set(finalState.flatMap((val, idx) => (val === current[idx] ? [] : [idx])));
      this.state = [...finalState];
      this.render();
      if (this.flash.size) await sleep(500);
      this.flash.clear();
      this.render();
    }

    async afterMove(
      startState: number[],
      player: number,
      pit: number,
      finalState: number[],
      goesAgain: boolean,
      isGameOver: boolean
    ) {
      const name = player === this.human ? 'Ash' : 'DEOXYS';
      if (isGameOver) return;

      // Count stones added directly to store during sow
      let normalStoreAdd = 0;
      let count = startState[pit];
      let p = pit;
      const ownStore = STORES[player];
      const oppStore = STORES[1 - player];
      while (count > 0) {
        p = (p + 1) % 14;
        if (p !== oppStore) {
          if (p === ownStore) normalStoreAdd++;
          count--;
        }
      }

      const totalStoreDiff = finalState[ownStore] - startState[ownStore] - normalStoreAdd;
      if (totalStoreDiff > 1) {
        this.sfx.play('capture');
        await this.say(`${name} captured ${totalStoreDiff} stones!`);
      }

      if (goesAgain) {
        this.sfx.play('extra');
        await this.say(
          player === this.human
            ? 'Last stone in your store! Go again!'
            : 'DEOXYS landed in its store! It goes again!'
        );
      }
    }

    async react(evalVal: number) {
      const prob = winProb(evalVal, 1 - this.human);
      this.setBars(prob);
      const mood = getMoodFromProb(prob);
      const changed = mood !== this.mood;
      this.setMood(mood);
      if (changed || Math.random() < 0.25) {
        await this.say(`${randomQuote(mood)}`);
      }
    }

    async finish() {
      const l = this.layout();
      const meScore = this.state[l.bottomStore];
      const foeScore = this.state[l.topStore];
      const result = foeScore > meScore ? 'won' : foeScore < meScore ? 'lost' : 'draw';

      this.setMood(result);
      this.setBars(result === 'won' ? 1 : result === 'lost' ? 0 : 0.5);
      this.sfx.play(result === 'lost' ? 'win' : result === 'won' ? 'lose' : 'extra');

      await this.say('The board is cleared! Remaining stones go to their owners.');
      await this.say(`${randomQuote(result)}`, true);

      if (result === 'lost') {
        await this.say(`Ash won ${meScore} to ${foeScore}!`, true);
      } else if (result === 'won') {
        await this.say(`Ash lost ${meScore} to ${foeScore}...`, true);
      } else {
        await this.say(`It's a draw, ${meScore} to ${foeScore}!`, true);
      }
    }

    layout() {
      return this.human === 0
        ? {
            bottom: [0, 1, 2, 3, 4, 5],
            bottomStore: 6,
            top: [12, 11, 10, 9, 8, 7],
            topStore: 13,
          }
        : {
            bottom: [7, 8, 9, 10, 11, 12],
            bottomStore: 13,
            top: [5, 4, 3, 2, 1, 0],
            topStore: 6,
          };
    }

    resetBoard() {
      this.human = 0;
      this.state = [...CLASSIC_START];
      this.lastMove = -1;
      this.elLevel.textContent = `Lv${this.level.lv}`;
      this.elStats.textContent = '';
      this.elText.textContent = '';
      this.setMood('idle');
      this.setBars(0.5);
      this.render();
    }

    render() {
      const l = this.layout();
      const pc = this.pitChoice;
      const cursorPit = pc ? pc.legal[pc.index] : -1;

      const buildPit = (pitIdx: number, isBottom: boolean, labelNum: number) => {
        const el = document.createElement(isBottom ? 'button' : 'div');
        el.className = 'gb__pit';
        el.classList.toggle('is-last', pitIdx === this.lastMove);
        el.classList.toggle('is-hot', pitIdx === this.hot);
        el.classList.toggle('is-flash', this.flash.has(pitIdx));

        // Stone dots visual
        const stonesSpan = document.createElement('span');
        stonesSpan.className = 'gb__stones';
        stonesSpan.setAttribute('aria-hidden', 'true');
        for (let i = 0; i < Math.min(this.state[pitIdx], 12); i++) {
          stonesSpan.append(document.createElement('i'));
        }

        const countSpan = document.createElement('span');
        countSpan.className = 'gb__count';
        countSpan.textContent = String(this.state[pitIdx]);

        el.append(stonesSpan, countSpan);

        if (el instanceof HTMLButtonElement) {
          el.type = 'button';
          el.disabled = !pc?.legal.includes(pitIdx);
          el.classList.toggle('is-cursor', pitIdx === cursorPit);
          el.setAttribute('aria-label', `Ash pit ${labelNum}: ${this.state[pitIdx]} stones`);
          el.addEventListener('click', () => this.pickPit(pitIdx));
        } else {
          el.setAttribute('role', 'img');
          el.setAttribute('aria-label', `Deoxys pit ${labelNum}: ${this.state[pitIdx]} stones`);
        }
        return el;
      };

      this.elRowBottom.replaceChildren(...l.bottom.map((pit, idx) => buildPit(pit, true, idx + 1)));
      this.elRowTop.replaceChildren(...l.top.map((pit, idx) => buildPit(pit, false, 6 - idx)));

      this.elStoreTop.textContent = String(this.state[l.topStore]);
      this.elStoreTop.classList.toggle('is-hot', l.topStore === this.hot);
      this.elStoreTop.classList.toggle('is-flash', this.flash.has(l.topStore));

      this.elStoreBottom.textContent = String(this.state[l.bottomStore]);
      this.elStoreBottom.classList.toggle('is-hot', l.bottomStore === this.hot);
      this.elStoreBottom.classList.toggle('is-flash', this.flash.has(l.bottomStore));
    }

    setBars(robotProb: number) {
      const applyBar = (bar: HTMLElement, pct: HTMLElement, prob: number) => {
        const rounded = Math.round(prob * 100);
        bar.style.width = `${rounded}%`;
        bar.dataset.level = prob >= 0.5 ? 'high' : prob > 0.2 ? 'mid' : 'low';
        pct.textContent = `${rounded}%`;
      };
      applyBar(this.elBarFoe, this.elPctFoe, robotProb);
      applyBar(this.elBarMe, this.elPctMe, 1 - robotProb);
    }

    setMood(mood: string) {
      this.mood = mood;
      this.elFoe.dataset.mood = mood;
      drawDeoxys(this.robotCtx, mood, true);
    }

    setThinking(thinking: boolean) {
      if (this.blinkTimer) {
        clearInterval(this.blinkTimer);
        this.blinkTimer = 0;
      }
      if (!thinking) {
        drawDeoxys(this.robotCtx, this.mood, true);
        this.elFoe.dataset.mood = this.mood;
        return;
      }
      this.elFoe.dataset.mood = 'thinking';
      let lit = true;
      drawDeoxys(this.robotCtx, 'thinking', true);
      this.blinkTimer = window.setInterval(() => {
        lit = !lit;
        drawDeoxys(this.robotCtx, 'thinking', lit);
      }, 300);
    }
  }

  // Initialize Game Boy Mancala when page loads
  let battleInstance: MancalaBattle | null = null;

  function initArcadeGame() {
    const battleRoot = document.querySelector('[data-battle]') as HTMLElement | null;
    if (battleRoot && !battleInstance) {
      battleInstance = new MancalaBattle(battleRoot);
      const playBtn = document.querySelector('[data-play]');
      playBtn?.addEventListener('click', () => {
        battleInstance?.open();
      });
    }
  }

  document.addEventListener('astro:page-load', initArcadeGame);
  document.addEventListener('DOMContentLoaded', initArcadeGame);

  // Allow canvas room interaction to trigger battle directly
  document.addEventListener('town:mancala', () => {
    battleInstance?.open();
  });

  document.addEventListener('astro:before-swap', () => {
    battleInstance?.close();
    battleInstance = null;
  });
</script>
