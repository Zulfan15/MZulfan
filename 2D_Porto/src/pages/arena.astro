---
import TownLayout from '../layouts/TownLayout.astro';
import { profile } from '../lib/profile';

const linkedinUrl =
  profile.socials.find((s) => s.label === 'LinkedIn')?.url ||
  'https://www.linkedin.com/in/muhammad-zulfan-anggadhiputra';

interface TrophyItem {
  id: string;
  title: string;
  subtitle: string;
  badge: string;
  icon: string;
  year: string;
  description: string;
  skills: string[];
}

const trophies: TrophyItem[] = [
  {
    id: 'ideafest-bronze',
    title: 'Bronze Medalist — National Essay Competition IDEA FEST 3',
    subtitle: 'National Scientific & Technological Innovation Award',
    badge: '🥉 NATIONAL MEDALIST',
    icon: '🏆',
    year: '2024',
    description:
      'Awarded the Bronze Medal in a competitive national scientific essay championship, proposing applied AI and scalable digital transformation solutions evaluated by academic and industry judges.',
    skills: ['Scientific Research', 'Applied AI', 'System Design', 'Problem Solving'],
  },
  {
    id: 'huawei-hcia',
    title: 'Huawei Certified ICT Associate — HCIA-Security V4.0',
    subtitle: 'International Network & Cyber Security Certification',
    badge: '🛡️ GLOBAL CERTIFIED',
    icon: '🔒',
    year: '2025',
    description:
      'Internationally certified by Huawei in enterprise network security architecture, next-generation firewall policy enforcement, IPSec/SSL VPN cryptography, NAT traversal, and intrusion defense.',
    skills: ['Firewall Policies', 'IPSec VPN', 'Cryptography', 'Network Security'],
  },
  {
    id: 'itenas-gpa',
    title: 'B.Comp.Sc. (Informatics) — ITENAS Bandung',
    subtitle: 'Cumulative GPA: 3.49 / 4.00 · AI & Distributed Systems Focus',
    badge: '🎓 HONORS GRADUATE',
    icon: '🎓',
    year: '2021 – 2025',
    description:
      'Graduated with a strong 3.49 / 4.00 GPA in Informatics (Computer Science) from Institut Teknologi Nasional (ITENAS) Bandung, specializing in real-time computer vision thesis research and full-stack software engineering.',
    skills: ['Computer Science', 'Deep Learning Thesis', 'Software Engineering', 'GPA 3.49/4.00'],
  },
  {
    id: 'lab-assistant-6x',
    title: '6x Laboratory Teaching Assistant — ITENAS Informatics',
    subtitle: 'Mentored 200+ Undergraduate Students Across 6 Core Labs',
    badge: '👨‍🏫 6× LAB MENTOR',
    icon: '⚡',
    year: '2023 – 2025',
    description:
      'Entrusted across 6 consecutive laboratory courses: Robotics, Internet of Things (IoT), Computer Networks, Object-Oriented Programming (Java), Database Systems (SQL), and Basic Programming.',
    skills: ['Robotics & IoT', 'Computer Networks', 'Java OOP', 'SQL Databases'],
  },
];

interface StatAxis {
  label: string;
  code: string;
  base: number;
  ev: string;
  iv: string;
  color: string;
  proof: string;
}

const statAxes: StatAxis[] = [
  {
    label: 'AI & Computer Vision',
    code: 'SP.ATK',
    base: 98,
    ev: '252 EV',
    iv: '31 IV',
    color: 'from-purple-500 to-fuchsia-400',
    proof: 'YOLOv11 + TensorRT 10 (~1.8 ms/frame, 75+ FPS drone detection & OMR grading)',
  },
  {
    label: 'Frontend & 2D Engines',
    code: 'SPEED',
    base: 96,
    ev: '252 EV',
    iv: '31 IV',
    color: 'from-cyan-500 to-sky-400',
    proof: '60 FPS custom HTML5 Canvas 2D RPG engine, Astro static islands, TypeScript & Tailwind',
  },
  {
    label: 'Backend & Distributed APIs',
    code: 'ATK',
    base: 95,
    ev: '220 EV',
    iv: '31 IV',
    color: 'from-amber-500 to-yellow-400',
    proof: 'Laravel 12, Go, Python FastAPI, PostGIS spatial queries, Redis Lua atomic mutexes',
  },
  {
    label: 'System Architecture',
    code: 'HP',
    base: 94,
    ev: '200 EV',
    iv: '31 IV',
    color: 'from-emerald-500 to-teal-400',
    proof: 'End-to-end microservices, Docker orchestration, Apache Kafka event streams & CI/CD',
  },
  {
    label: 'Network & Cyber Security',
    code: 'SP.DEF',
    base: 92,
    ev: '180 EV',
    iv: '31 IV',
    color: 'from-blue-500 to-indigo-400',
    proof: 'Huawei HCIA-Security V4.0, Firewall ACLs, IPSec VPN tunnels & zero-trust auth',
  },
  {
    label: 'IoT & Robotics Hardware',
    code: 'DEF',
    base: 90,
    ev: '160 EV',
    iv: '31 IV',
    color: 'from-rose-500 to-orange-400',
    proof: 'ESP32/Arduino firmware, MQTT telemetry, ultrasonic & PID autonomous robotics control',
  },
];
---

<TownLayout
  title={`Battle Frontier & Algorithm Colosseum — ${profile.person.name}`}
  description="Step onto the Grand Battle Frontier Colosseum court: challenge Frontier Brain Mewtwo in a turn-based engineering battle simulator, conquer the 6-stage AI & System Design Gauntlet, and inspect Zulfan's Trophy Vault."
  place="arena"
>
  <article class="arena-page space-y-6 pb-10">
    <!-- 1. GRAND COLOSSEUM HERO BANNER & MEWTWO / LUCARIO COMMAND BRIEFING -->
    <header class="relative overflow-hidden rounded-2xl border-2 border-purple-500/45 bg-gradient-to-br from-[#140d26] via-[#0f172a] to-[#1a0b2e] p-5 shadow-2xl">
      <div class="pointer-events-none absolute -right-12 -top-12 h-48 w-48 rounded-full bg-purple-500/15 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-12 -left-12 h-48 w-48 rounded-full bg-cyan-500/15 blur-3xl"></div>

      <!-- Top Status Ribbon -->
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-purple-500/25 pb-3">
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-purple-400/40 bg-purple-500/15 px-2.5 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-wider text-purple-200">
            <span class="h-2 w-2 rounded-full bg-purple-400 animate-ping"></span>
            LIVE COLOSSEUM · SANCTIONED FRONTIER MATCH
          </span>
          <span class="rounded-full border border-cyan-400/30 bg-cyan-500/10 px-2.5 py-0.5 font-mono text-[10px] text-cyan-300">
            🌀 Lucario Aura Corner
          </span>
        </div>

        <div class="flex items-center gap-2">
          <div class="flex items-center gap-1.5 rounded-lg border border-amber-500/40 bg-amber-950/50 px-2.5 py-1 font-mono text-[11px] text-amber-200" title="Your Competitive Engineering Rating">
            <span>⚡ Rating:</span>
            <strong id="arena-elo-display" class="text-amber-400">1850 ELO</strong>
          </div>
          <div
            id="arena-frontier-badge-pill"
            class="flex items-center gap-1.5 rounded-lg border border-purple-400/40 bg-purple-950/60 px-2.5 py-1 font-mono text-[11px] text-purple-200"
          >
            <span>🏅 Status:</span>
            <strong id="arena-badge-status" class="text-purple-300">Challenger</strong>
          </div>
        </div>
      </div>

      <!-- Main Title & Subtitle -->
      <div class="mt-4 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div class="space-y-1.5">
          <p class="font-mono text-[11px] uppercase tracking-widest text-purple-300/90">
            TOWN SQUARE EAST STADIUM · COMPETITIVE AI, ALGORITHMS & SYSTEM DESIGN
          </p>
          <h1 id="panel-title" class="font-pixel text-xl sm:text-2xl tracking-tight text-white flex items-center gap-2.5">
            <span>⚔️</span>
            <span>BATTLE FRONTIER & ALGORITHM COLOSSEUM</span>
          </h1>
          <p class="text-xs sm:text-sm text-slate-200/85 leading-relaxed max-w-2xl">
            Welcome to the main stadium court! Command your partner Pokémon in a <strong class="text-amber-300">Turn-Based Engineering Duel</strong> against <strong class="text-purple-300">Frontier Brain Mewtwo</strong>, test your architectural instincts in the <strong class="text-cyan-300">6-Stage Technical Gauntlet</strong>, or inspect <strong class="text-white">{profile.person.name}’s</strong> championship medals and <strong class="text-emerald-300">565 BST EV/IV Stack Radar</strong>.
          </p>
        </div>

        <!-- Quick Scoreboard Card -->
        <div class="shrink-0 rounded-xl border border-purple-400/35 bg-black/45 p-3.5 backdrop-blur-sm min-w-[210px]">
          <div class="flex items-center justify-between text-[10px] font-pixel uppercase tracking-wider text-purple-300 mb-2">
            <span>🏟️ Jumbotron Telemetry</span>
            <span class="text-emerald-400">60 FPS</span>
          </div>
          <div class="grid grid-cols-2 gap-2 text-center font-mono">
            <div class="rounded-lg border border-slate-700/70 bg-slate-900/80 p-2">
              <div class="text-[10px] text-slate-400">Victories</div>
              <div id="arena-wins-count" class="text-sm font-bold text-amber-300">0</div>
            </div>
            <div class="rounded-lg border border-slate-700/70 bg-slate-900/80 p-2">
              <div class="text-[10px] text-slate-400">Gauntlet</div>
              <div id="arena-gauntlet-score-top" class="text-sm font-bold text-cyan-300">0 / 6</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Interactive Mewtwo & Lucario Briefing Box -->
      <div class="mt-4 rounded-xl border border-purple-500/30 bg-black/40 p-3.5">
        <div class="flex flex-col sm:flex-row sm:items-start gap-3">
          <div class="flex items-center gap-2 shrink-0">
            <button
              type="button"
              id="btn-walk-mewtwo"
              class="flex h-11 w-11 items-center justify-center rounded-xl border border-purple-400/40 bg-purple-500/20 text-xl shadow-inner hover:scale-105 transition-transform"
              title="Walk to Frontier Brain Mewtwo in 2D Stadium"
            >
              🔮
            </button>
            <button
              type="button"
              id="btn-walk-lucario"
              class="flex h-11 w-11 items-center justify-center rounded-xl border border-cyan-400/40 bg-cyan-500/20 text-xl shadow-inner hover:scale-105 transition-transform"
              title="Walk to Tactical Coach Lucario in 2D Stadium"
            >
              🌀
            </button>
          </div>

          <div class="flex-1 min-w-0">
            <div class="flex flex-wrap items-center gap-2">
              <span id="arena-dialogue-speaker" class="font-pixel text-[10px] uppercase tracking-wider text-purple-300">
                Frontier Brain Mewtwo 🔮
              </span>
              <span class="font-mono text-[10px] text-slate-400">· North Champion Podium</span>
            </div>
            <p id="arena-dialogue-text" class="mt-1 text-xs sm:text-sm text-slate-100 italic leading-relaxed">
              "Telepathy link established. In this arena, brute force is meaningless—only low-latency algorithms, resilient system architecture, and sharp engineering decisions prevail. Show me your strategy!"
            </p>

            <div class="mt-2.5 flex flex-wrap items-center gap-1.5">
              <button
                type="button"
                class="arena-topic-btn is-active rounded-lg border border-purple-400/40 bg-purple-500/20 px-2.5 py-1 font-mono text-[10px] text-purple-200 hover:bg-purple-500/30 transition"
                data-speaker="Frontier Brain Mewtwo · AI Overlord 🔮"
                data-quote="Telepathy link established. In this arena, brute force is meaningless—only low-latency algorithms, resilient system architecture, and sharp engineering decisions prevail. Show me your strategy!"
                data-prop="mewtwo-boss"
              >
                🔮 Mewtwo's Challenge
              </button>
              <button
                type="button"
                class="arena-topic-btn rounded-lg border border-cyan-400/30 bg-cyan-500/10 px-2.5 py-1 font-mono text-[10px] text-cyan-200 hover:bg-cyan-500/25 transition"
                data-speaker="Tactical Coach Lucario · Aura Master 🌀"
                data-quote="I sense high Aura resonance in Zulfan's stack! Tip for the Battle Simulator: Mewtwo's Psystrike hits hard, so use Shield/Optimization moves before unleashing your TensorRT or PostGIS finishers!"
                data-prop="lucario-coach"
              >
                🌀 Lucario's Battle Tip
              </button>
              <button
                type="button"
                class="arena-topic-btn rounded-lg border border-emerald-400/30 bg-emerald-500/10 px-2.5 py-1 font-mono text-[10px] text-emerald-200 hover:bg-emerald-500/25 transition"
                data-speaker="Chief Referee Victor · Match Official 🏁"
                data-quote="Every attack in the Battle Simulator triggers live shockwaves on the 2D Colosseum canvas! Defeat Mewtwo or score 4+/6 on the AI Gauntlet to claim the official Frontier Master Badge!"
                data-prop="referee-dan"
              >
                🏁 Colosseum Rules
              </button>
              <button
                type="button"
                class="arena-topic-btn rounded-lg border border-amber-400/30 bg-amber-500/10 px-2.5 py-1 font-mono text-[10px] text-amber-200 hover:bg-amber-500/25 transition"
                data-speaker="Hall of Fame Curator · Trophy Vault 🏆"
                data-quote="Zulfan brings proven competitive credentials to the arena: IDEA FEST 3 National Bronze Medalist, Huawei HCIA-Security V4.0 Certified, ITENAS 3.49/4.00 GPA, and 6x Lab Teaching Assistant!"
                data-prop="trophy-vault"
              >
                🏆 Verified Honors
              </button>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- 2. 2D COLOSSEUM STATION NAVIGATOR & HOTKEYS -->
    <section aria-label="2D Stadium Interactive Stations" class="rounded-xl border border-purple-500/25 bg-[#0f1424]/90 p-3.5 shadow-lg">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-2.5">
        <div class="flex items-center gap-2">
          <span class="font-pixel text-[10px] uppercase tracking-wider text-purple-300">
            🗺️ Walk to Stadium Station (2D Sync)
          </span>
          <span class="text-[11px] text-slate-400 hidden sm:inline">
            — Click any station to walk your trainer across the 2D Colosseum court
          </span>
        </div>
        <div class="hidden md:flex items-center gap-1.5 font-mono text-[10px] text-slate-300">
          <span>Hotkeys:</span>
          <kbd class="rounded border border-purple-500/40 bg-black/50 px-1.5 py-0.5 text-purple-300">D</kbd><span>Duel</span>
          <kbd class="rounded border border-purple-500/40 bg-black/50 px-1.5 py-0.5 text-purple-300">G</kbd><span>Gauntlet</span>
          <kbd class="rounded border border-purple-500/40 bg-black/50 px-1.5 py-0.5 text-purple-300">T</kbd><span>Trophies</span>
          <kbd class="rounded border border-purple-500/40 bg-black/50 px-1.5 py-0.5 text-purple-300">S</kbd><span>Stats</span>
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-2">
        <button
          type="button"
          class="arena-station-btn flex items-center gap-2 rounded-lg border border-purple-500/30 bg-purple-500/10 px-2.5 py-2 text-left hover:border-purple-400 hover:bg-purple-500/20 transition"
          data-locate="mewtwo-boss"
        >
          <span class="text-base">🔮</span>
          <div class="min-w-0">
            <div class="font-pixel text-[9px] text-purple-200 truncate">Mewtwo AI</div>
            <div class="font-mono text-[9px] text-purple-300/70 truncate">Frontier Boss</div>
          </div>
        </button>

        <button
          type="button"
          class="arena-station-btn flex items-center gap-2 rounded-lg border border-cyan-500/30 bg-cyan-500/10 px-2.5 py-2 text-left hover:border-cyan-400 hover:bg-cyan-500/20 transition"
          data-locate="lucario-coach"
        >
          <span class="text-base">🌀</span>
          <div class="min-w-0">
            <div class="font-pixel text-[9px] text-cyan-200 truncate">Lucario</div>
            <div class="font-mono text-[9px] text-cyan-300/70 truncate">Aura Coach</div>
          </div>
        </button>

        <button
          type="button"
          class="arena-station-btn flex items-center gap-2 rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-2 text-left hover:border-emerald-400 hover:bg-emerald-500/20 transition"
          data-locate="referee-dan"
        >
          <span class="text-base">🏁</span>
          <div class="min-w-0">
            <div class="font-pixel text-[9px] text-emerald-200 truncate">Referee</div>
            <div class="font-mono text-[9px] text-emerald-300/70 truncate">Match Judge</div>
          </div>
        </button>

        <button
          type="button"
          class="arena-station-btn flex items-center gap-2 rounded-lg border border-rose-500/30 bg-rose-500/10 px-2.5 py-2 text-left hover:border-rose-400 hover:bg-rose-500/20 transition"
          data-locate="battle-terminal"
        >
          <span class="text-base">⚔️</span>
          <div class="min-w-0">
            <div class="font-pixel text-[9px] text-rose-200 truncate">Battle Deck</div>
            <div class="font-mono text-[9px] text-rose-300/70 truncate">1v1 Simulator</div>
          </div>
        </button>

        <button
          type="button"
          class="arena-station-btn flex items-center gap-2 rounded-lg border border-fuchsia-500/30 bg-fuchsia-500/10 px-2.5 py-2 text-left hover:border-fuchsia-400 hover:bg-fuchsia-500/20 transition"
          data-locate="algorithm-dojo"
        >
          <span class="text-base">🧠</span>
          <div class="min-w-0">
            <div class="font-pixel text-[9px] text-fuchsia-200 truncate">AI Gauntlet</div>
            <div class="font-mono text-[9px] text-fuchsia-300/70 truncate">Tech Quiz</div>
          </div>
        </button>

        <button
          type="button"
          class="arena-station-btn flex items-center gap-2 rounded-lg border border-amber-500/30 bg-amber-500/10 px-2.5 py-2 text-left hover:border-amber-400 hover:bg-amber-500/20 transition"
          data-locate="trophy-vault"
        >
          <span class="text-base">🏆</span>
          <div class="min-w-0">
            <div class="font-pixel text-[9px] text-amber-200 truncate">Trophy Vault</div>
            <div class="font-mono text-[9px] text-amber-300/70 truncate">Medals & Certs</div>
          </div>
        </button>

        <button
          type="button"
          class="arena-station-btn flex items-center gap-2 rounded-lg border border-teal-500/30 bg-teal-500/10 px-2.5 py-2 text-left hover:border-teal-400 hover:bg-teal-500/20 transition"
          data-locate="stat-radar"
        >
          <span class="text-base">📊</span>
          <div class="min-w-0">
            <div class="font-pixel text-[9px] text-teal-200 truncate">IV Scanner</div>
            <div class="font-mono text-[9px] text-teal-300/70 truncate">565 BST Radar</div>
          </div>
        </button>
      </div>
    </section>

    <!-- 3. INTERACTIVE TURN-BASED POKÉMON ENGINEERING BATTLE SIMULATOR -->
    <section
      id="arena-battle-sim"
      aria-labelledby="battle-sim-heading"
      class="rounded-2xl border-2 border-rose-500/40 bg-gradient-to-b from-[#191024] via-[#111827] to-[#0b1120] p-5 shadow-2xl"
    >
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-rose-500/25 pb-3">
        <div>
          <span class="font-mono text-[10px] uppercase tracking-widest text-rose-400">
            LIVE TURN-BASED COMBAT ENGINE · SYNCED WITH 2D COLOSSEUM COURT
          </span>
          <h2 id="battle-sim-heading" class="font-pixel text-base sm:text-lg text-white flex items-center gap-2 mt-0.5">
            <span>⚔️</span>
            <span>FRONTIER BRAIN BATTLE SIMULATOR (1V1 DUEL)</span>
          </h2>
        </div>

        <div class="flex items-center gap-2">
          <span id="battle-turn-indicator" class="rounded-lg border border-amber-400/40 bg-amber-500/15 px-2.5 py-1 font-mono text-xs font-bold text-amber-300">
            TURN 1 · YOUR MOVE
          </span>
          <button
            type="button"
            id="btn-reset-battle"
            class="rounded-lg border border-slate-600 bg-slate-800/80 px-2.5 py-1 font-mono text-xs text-slate-200 hover:border-rose-400 transition"
          >
            ↺ Rematch
          </button>
        </div>
      </div>

      <!-- Partner Selector Row -->
      <div class="mt-3.5">
        <span class="block font-pixel text-[10px] uppercase tracking-wider text-slate-300 mb-2">
          1. Select Your Challenger Tech Guardian:
        </span>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2" id="battle-partner-selector">
          <button
            type="button"
            class="battle-partner-btn is-selected flex items-center gap-2 rounded-xl border border-amber-400 bg-amber-500/20 p-2.5 text-left transition"
            data-partner="charizard"
          >
            <span class="text-xl">🔥</span>
            <div class="min-w-0">
              <div class="font-pixel text-[10px] text-amber-100 truncate">Charizard</div>
              <div class="font-mono text-[9px] text-amber-200/80 truncate">Full-Stack Web</div>
            </div>
          </button>

          <button
            type="button"
            class="battle-partner-btn flex items-center gap-2 rounded-xl border border-slate-700 bg-black/30 p-2.5 text-left hover:border-cyan-400/60 transition"
            data-partner="lucario"
          >
            <span class="text-xl">🌀</span>
            <div class="min-w-0">
              <div class="font-pixel text-[10px] text-cyan-100 truncate">Lucario</div>
              <div class="font-mono text-[9px] text-cyan-200/80 truncate">Edge AI & Aura</div>
            </div>
          </button>

          <button
            type="button"
            class="battle-partner-btn flex items-center gap-2 rounded-xl border border-slate-700 bg-black/30 p-2.5 text-left hover:border-indigo-400/60 transition"
            data-partner="garchomp"
          >
            <span class="text-xl">🦈</span>
            <div class="min-w-0">
              <div class="font-pixel text-[10px] text-indigo-100 truncate">Garchomp</div>
              <div class="font-mono text-[9px] text-indigo-200/80 truncate">Supersonic Algo</div>
            </div>
          </button>

          <button
            type="button"
            class="battle-partner-btn flex items-center gap-2 rounded-xl border border-slate-700 bg-black/30 p-2.5 text-left hover:border-emerald-400/60 transition"
            data-partner="dialga"
          >
            <span class="text-xl">⏳</span>
            <div class="min-w-0">
              <div class="font-pixel text-[10px] text-emerald-100 truncate">Dialga</div>
              <div class="font-mono text-[9px] text-emerald-200/80 truncate">Cloud & Security</div>
            </div>
          </button>
        </div>
      </div>

      <!-- Battle HUD Stage: Challenger vs Mewtwo -->
      <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-4 rounded-xl border border-slate-700/80 bg-[#090d16] p-4 shadow-inner">
        <!-- Challenger Status Box -->
        <div class="rounded-xl border border-cyan-500/35 bg-gradient-to-br from-cyan-950/40 to-slate-950 p-3.5">
          <div class="flex items-center justify-between gap-2">
            <div class="flex items-center gap-2.5">
              <span id="sim-player-icon" class="flex h-11 w-11 items-center justify-center rounded-xl border border-amber-400/40 bg-amber-500/20 text-2xl">
                🔥
              </span>
              <div>
                <div class="flex items-center gap-1.5">
                  <h3 id="sim-player-name" class="font-pixel text-xs sm:text-sm text-white">Charizard</h3>
