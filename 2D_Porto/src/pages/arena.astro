  function initGladiatorArena() {
    // Persistent Fame / Wins / Trials
    let fame = Number(localStorage.getItem('arena:elo') || '1850');
    let wins = Number(localStorage.getItem('arena:wins') || '0');
    let solvedTrials: number[] = [];
    try {
      solvedTrials = JSON.parse(localStorage.getItem('arena:solved') || '[]');
    } catch {
      solvedTrials = [];
    }

    // Combat state
    let selectedFighterIdx = 0;
    let playerHp = GLADIATOR_ROSTER[0].maxHp;
    let playerMaxHp = GLADIATOR_ROSTER[0].maxHp;
    let bossHp = 500;
    const bossMaxHp = 500;
    let boutTurn = 1;
    let crowdFavor = 55;
    let atkBuff = 1.0;
    let shieldActive = false;
    let usedPotion = false;
    let usedWhetstone = false;
    let usedShield = false;
    let battleOver = false;

    const eloValEl = document.getElementById('arena-elo-value');
    const eloTierEl = document.getElementById('arena-elo-tier');
    const recordLabelEl = document.getElementById('arena-record-label');
    const badgeEl = document.getElementById('arena-frontier-badge');

    function updateFameUI() {
      if (eloValEl) eloValEl.textContent = String(fame);
      if (eloTierEl) {
        eloTierEl.textContent =
          fame >= 2000
            ? 'CAESAR IMPERATOR'
            : fame >= 1900
              ? 'RUDIARIUS MASTER'
              : 'PRIMUS PALUS';
      }
      if (recordLabelEl) {
        recordLabelEl.textContent = `Victories: ${wins}W · Trials: ${solvedTrials.length}/6`;
      }
      if (badgeEl) {
        if (wins >= 1 || solvedTrials.length >= 3) {
          badgeEl.classList.remove('hidden');
          badgeEl.classList.add('inline-flex');
        }
      }
      localStorage.setItem('arena:elo', String(fame));
      localStorage.setItem('arena:wins', String(wins));
      localStorage.setItem('arena:solved', JSON.stringify(solvedTrials));
    }

    function emitCanvasShockwave(text: string, color: string) {
      window.dispatchEvent(
        new CustomEvent('town:arena-fx', {
          detail: { text, color },
        })
      );
    }

    function appendCombatLog(html: string) {
      const logEl = document.getElementById('battle-combat-log');
      if (!logEl) return;
      const item = document.createElement('div');
      item.innerHTML = html;
      logEl.prepend(item);
    }

    function updateBattleBars() {
      const f = GLADIATOR_ROSTER[selectedFighterIdx];
      const pName = document.getElementById('player-fighter-name');
      const pBadge = document.getElementById('player-class-badge');
      const pAvatar = document.getElementById('player-sprite-avatar');
      const pHpText = document.getElementById('player-hp-text');
      const pHpBar = document.getElementById('player-hp-bar');
      const bHpText = document.getElementById('boss-hp-text');
      const bHpBar = document.getElementById('boss-hp-bar');
      const turnPill = document.getElementById('battle-turn-pill');
      const favorBar = document.getElementById('crowd-favor-bar');
      const favorText = document.getElementById('crowd-favor-text');
      const pBuffTag = document.getElementById('player-buff-tag');

      if (pName) pName.textContent = f.name;
      if (pBadge) pBadge.textContent = f.classBadge;
      if (pAvatar) pAvatar.textContent = f.avatar;
      if (pHpText) pHpText.textContent = `${Math.max(0, playerHp)} / ${playerMaxHp}`;
      if (pHpBar) {
        const pct = Math.max(0, Math.min(100, (playerHp / playerMaxHp) * 100));
        pHpBar.style.width = `${pct}%`;
      }
      if (bHpText) bHpText.textContent = `${Math.max(0, bossHp)} / ${bossMaxHp}`;
      if (bHpBar) {
        const pct = Math.max(0, Math.min(100, (bossHp / bossMaxHp) * 100));
        bHpBar.style.width = `${pct}%`;
      }
      if (turnPill) turnPill.textContent = `BOUT TURN ${boutTurn}`;
      if (favorBar) favorBar.style.width = `${crowdFavor}%`;
      if (favorText) {
        favorText.textContent =
          crowdFavor >= 80
            ? `${crowdFavor}% · 👍 MITTE! AVE!`
            : crowdFavor >= 50
              ? `${crowdFavor}% · ROARING! 🔥`
              : `${crowdFavor}% · TENSE PIT`;
      }
      if (pBuffTag) {
        const buffs: string[] = [];
        if (atkBuff > 1) buffs.push('🔥 +35% Vulcan Blade');
        if (shieldActive) buffs.push('🛡️ Testudo Shield (50% DR)');
        pBuffTag.textContent =
          buffs.length > 0 ? buffs.join(' · ') : '⚔️ Ready on the Colosseum Sand';
      }

      const potBtn = document.getElementById('item-potion-btn') as HTMLButtonElement | null;
      const atkBtn = document.getElementById('item-xspatk-btn') as HTMLButtonElement | null;
      const grdBtn = document.getElementById('item-guard-btn') as HTMLButtonElement | null;
      const potCnt = document.getElementById('item-potion-count');
      const atkCnt = document.getElementById('item-xspatk-count');
      const grdCnt = document.getElementById('item-guard-count');

      if (potBtn) potBtn.disabled = usedPotion || battleOver;
      if (atkBtn) atkBtn.disabled = usedWhetstone || battleOver;
      if (grdBtn) grdBtn.disabled = usedShield || battleOver;
      if (potCnt) potCnt.textContent = usedPotion ? '0×' : '1×';
      if (atkCnt) atkCnt.textContent = usedWhetstone ? '0×' : '1×';
      if (grdCnt) grdCnt.textContent = usedShield ? '0×' : '1×';
    }

    function renderFighterMoves() {
      const grid = document.getElementById('battle-moves-grid');
      if (!grid) return;
      const f = GLADIATOR_ROSTER[selectedFighterIdx];
      grid.innerHTML = '';

      f.moves.forEach((mv, idx) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.disabled = battleOver;
        btn.className =
          'group flex flex-col justify-between rounded-xl border-2 border-[#8c5a2b] bg-gradient-to-b from-[#fffbeb] to-[#f2e2c4] p-3 text-left text-[#3b1d0a] shadow-[0_3px_0_#5c3a1b] transition hover:-translate-y-0.5 hover:border-[#991b1b] hover:from-[#fffbeb] hover:to-[#fde68a] active:translate-y-0 disabled:opacity-50';
        btn.innerHTML = `
          <div class="flex items-start justify-between gap-2 w-full">
            <span class="font-mono text-xs font-black text-[#450a0a] group-hover:text-[#991b1b]">${mv.name}</span>
            <span class="shrink-0 rounded border border-[#b45309] bg-[#fef3c7] px-1.5 py-0.5 font-mono text-[9px] font-extrabold text-[#78350f]">${mv.weapon}</span>
          </div>
          <p class="mt-1 text-[11px] leading-snug text-[#5c3a1b]">${mv.desc}</p>
          <div class="mt-2 flex items-center justify-between border-t border-[#d6be9c] pt-1.5 w-full font-mono text-[10px] font-bold text-[#78350f]">
            <span>Discipline: ${mv.type}</span>
            <span class="text-[#991b1b]">Power: ${mv.power}</span>
          </div>
        `;
        btn.addEventListener('click', () => executeGladiatorTurn(idx));
        grid.appendChild(btn);
      });
    }

    function executeGladiatorTurn(moveIdx: number) {
      if (battleOver) return;
      const f = GLADIATOR_ROSTER[selectedFighterIdx];
      const mv = f.moves[moveIdx];

      const pAvatar = document.getElementById('player-sprite-avatar');
      const bAvatar = document.getElementById('boss-sprite-avatar');
      if (pAvatar) {
        pAvatar.classList.add('scale-110');
        setTimeout(() => pAvatar.classList.remove('scale-110'), 220);
      }

      const variance = 0.92 + Math.random() * 0.16;
      const dmg = Math.round(mv.power * atkBuff * variance);
      bossHp = Math.max(0, bossHp - dmg);

      if (mv.heal) {
        playerHp = Math.min(playerMaxHp, playerHp + mv.heal);
        appendCombatLog(
          `🏺 <strong>${f.name}</strong> invoked <strong>${mv.name}</strong> — restored <strong class="text-green-800">+${mv.heal} HP</strong> and dealt <strong>${dmg} DMG</strong>!`
        );
      } else {
        appendCombatLog(
          `⚔️ <strong>${f.name}</strong> unleashed <strong>${mv.name}</strong> for <strong class="text-[#991b1b]">${dmg} DMG</strong>!`
        );
      }

      crowdFavor = Math.min(100, crowdFavor + 8);
      emitCanvasShockwave(`${f.title.toUpperCase()} -${dmg} HP! ⚔️`, mv.fxColor);

      if (bossHp <= 0) {
        battleOver = true;
        wins += 1;
        fame += 45;
        crowdFavor = 100;
        updateBattleBars();
        updateFameUI();
        renderFighterMoves();
        emitCanvasShockwave('AVE VICTOR! MEWTWO DEFEATED! 👑', '#fbbf24');
        appendCombatLog(
          `👑 <strong>VICTORIA GLADIATORIA!</strong> Emperor's Champion Mewtwo kneels on the sand! The Colosseum crowd roars <em>"AVE VICTOR!"</em> (<strong>+45 Fame</strong> & <strong>Corona Aurea</strong> unlocked!)`
        );
        return;
      }

      // Boss counterattack
      const bossMoves = [
        { name: '🔮 Imperial Psystrike Barrage', dmg: 95 },
        { name: '⚡ Colosseum Aura Tempest', dmg: 85 },
        { name: '🛡️ Telekinetic Gladius Slash', dmg: 90 },
      ];
      const bm = bossMoves[boutTurn % bossMoves.length];
      let incoming = Math.round(bm.dmg * (0.9 + Math.random() * 0.2));
      if (shieldActive) {
        incoming = Math.round(incoming * 0.5);
        shieldActive = false;
      }
      playerHp = Math.max(0, playerHp - incoming);

      if (bAvatar) {
        bAvatar.classList.add('scale-110');
        setTimeout(() => bAvatar.classList.remove('scale-110'), 220);
      }

      appendCombatLog(
        `🔮 <strong>Champion Mewtwo</strong> countered with <strong>${bm.name}</strong> (-${incoming} HP)!`
      );

      if (playerHp <= 0) {
        battleOver = true;
        appendCombatLog(
          `🛡️ Your Gladiator fought bravely to the last breath! Click <strong>"↺ New Bout"</strong> to re-enter the sand pit!`
        );
      }

      boutTurn += 1;
      updateBattleBars();
      renderFighterMoves();
    }

    function resetBout(newFighterIdx?: number) {
      if (typeof newFighterIdx === 'number') {
        selectedFighterIdx = newFighterIdx;
      }
      const f = GLADIATOR_ROSTER[selectedFighterIdx];
      playerMaxHp = f.maxHp;
      playerHp = f.maxHp;
      bossHp = bossMaxHp;
      boutTurn = 1;
      crowdFavor = 55;
      atkBuff = 1.0;
      shieldActive = false;
      usedPotion = false;
      usedWhetstone = false;
      usedShield = false;
      battleOver = false;

      // Update Roster Tab styles
      document.querySelectorAll('.fighter-tab').forEach((btn, idx) => {
        if (idx === selectedFighterIdx) {
          btn.className =
            'fighter-tab active flex items-center gap-2 rounded-xl border-2 border-[#991b1b] bg-gradient-to-b from-[#7f1d1d] to-[#450a0a] p-2 text-left text-[#fef3c7] shadow-[0_3px_0_#2e0909] transition';
        } else {
          btn.className =
            'fighter-tab flex items-center gap-2 rounded-xl border-2 border-[#b59264] bg-[#fdf8ed] p-2 text-left text-[#451a03] shadow-[0_2px_0_#8c5a2b] transition hover:border-[#78350f] hover:bg-[#fef3c7]';
        }
      });

      updateBattleBars();
      renderFighterMoves();
      appendCombatLog(
        `📯 <strong>${f.name}</strong> (${f.title}) steps onto the Colosseum sand! Crowd favor rises!`
      );
      emitCanvasShockwave(`${f.title.toUpperCase()} ENTERS! ⚔️`, '#d97706');
    }

    // Bind Roster Tabs
    document.querySelectorAll('.fighter-tab').forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = Number((btn as HTMLElement).dataset.fighterIdx || '0');
        resetBout(idx);
      });
    });

    // Bind Reset Button
    document.getElementById('btn-battle-reset')?.addEventListener('click', () => {
      resetBout(selectedFighterIdx);
    });

    // Bind 3 Imperial Blessings
    document.getElementById('item-potion-btn')?.addEventListener('click', () => {
      if (usedPotion || battleOver) return;
      usedPotion = true;
      const healAmt = Math.round(playerMaxHp * 0.65);
      playerHp = Math.min(playerMaxHp, playerHp + healAmt);
      appendCombatLog(
        `🏺 <strong>Imperial Blessing:</strong> Drank <strong>Ambrosia Nectar</strong> (+${healAmt} HP restored)!`
      );
      emitCanvasShockwave('AMBROSIA NECTAR +65% HP! 🏺', '#22c55e');
      updateBattleBars();
    });

    document.getElementById('item-xspatk-btn')?.addEventListener('click', () => {
      if (usedWhetstone || battleOver) return;
      usedWhetstone = true;
      atkBuff = 1.35;
      appendCombatLog(
        `🔥 <strong>Imperial Blessing:</strong> Honed blade on <strong>Vulcan's Whetstone</strong> (+35% Strike Power)!`
      );
      emitCanvasShockwave('VULCAN WHETSTONE +35% ATK! 🔥', '#f59e0b');
      updateBattleBars();
    });

    document.getElementById('item-guard-btn')?.addEventListener('click', () => {
      if (usedShield || battleOver) return;
      usedShield = true;
      shieldActive = true;
      appendCombatLog(
        `🛡️ <strong>Imperial Blessing:</strong> Raised <strong>Roman Testudo Wall</strong> (Next incoming strike halved)!`
      );
      emitCanvasShockwave('ROMAN TESTUDO SHIELD UP! 🛡️', '#38bdf8');
      updateBattleBars();
    });

    // ===================================================================
    // SIX TRIALS OF ROME (PORTA BESTIARIORUM GAUNTLET)
    // ===================================================================
    let currentTrialIdx = 0;

    function renderGauntletStage() {
      const trial = COLOSSEUM_TRIALS[currentTrialIdx];
      const pillsWrap = document.getElementById('gauntlet-stage-pills');
      const progressPill = document.getElementById('gauntlet-progress-pill');
      const domainTag = document.getElementById('gauntlet-domain-tag');
      const qTitle = document.getElementById('gauntlet-question-title');
      const optList = document.getElementById('gauntlet-options-list');
      const fbBox = document.getElementById('gauntlet-feedback-box');

      if (progressPill) {
        progressPill.textContent = `TRIAL ${trial.numeral} / VI · ${solvedTrials.length} SOLVED`;
      }
      if (domainTag) domainTag.textContent = trial.domain;
      if (qTitle) qTitle.textContent = trial.question;
      if (fbBox) {
        fbBox.classList.add('hidden');
        fbBox.innerHTML = '';
      }

      if (pillsWrap) {
        pillsWrap.innerHTML = '';
        COLOSSEUM_TRIALS.forEach((t, idx) => {
          const isSolved = solvedTrials.includes(idx);
          const isCurrent = idx === currentTrialIdx;
          const b = document.createElement('button');
          b.type = 'button';
          b.className = isCurrent
            ? 'rounded-lg border-2 border-[#991b1b] bg-[#7f1d1d] px-3 py-1 font-mono text-xs font-black text-[#fef08a] shadow-sm'
            : isSolved
              ? 'rounded-lg border-2 border-[#15803d] bg-[#dcfce7] px-3 py-1 font-mono text-xs font-black text-[#14532d]'
              : 'rounded-lg border-2 border-[#b59264] bg-[#fdf8ed] px-3 py-1 font-mono text-xs font-bold text-[#5c3a1b] hover:bg-[#f2e2c4]';
          b.textContent = `${isSolved ? '✓ ' : ''}Tabula ${t.numeral}`;
          b.addEventListener('click', () => {
            currentTrialIdx = idx;
            renderGauntletStage();
          });
          pillsWrap.appendChild(b);
        });
      }

      if (optList) {
        optList.innerHTML = '';
        trial.options.forEach((optText, oIdx) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className =
            'flex items-center gap-3 rounded-xl border-2 border-[#b59264] bg-[#fffbeb] px-3.5 py-2.5 text-left text-xs font-bold text-[#3b1d0a] shadow-sm transition hover:border-[#7f1d1d] hover:bg-[#fef3c7]';
          const romanLetter = ['A', 'B', 'C', 'D'][oIdx];
          btn.innerHTML = `
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md border border-[#8c5a2b] bg-[#f2e2c4] font-mono text-[11px] font-black text-[#451a03]">${romanLetter}</span>
            <span>${optText}</span>
          `;
          btn.addEventListener('click', () => {
            if (!fbBox) return;
            fbBox.classList.remove('hidden');
            if (oIdx === trial.correct) {
              btn.className =
                'flex items-center gap-3 rounded-xl border-2 border-[#15803d] bg-[#dcfce7] px-3.5 py-2.5 text-left text-xs font-black text-[#14532d]';
              if (!solvedTrials.includes(currentTrialIdx)) {
                solvedTrials.push(currentTrialIdx);
                fame += 25;
                updateFameUI();
                emitCanvasShockwave(`TRIAL ${trial.numeral} CONQUERED! +25 FAME 🦁`, '#fbbf24');
              }
              fbBox.innerHTML = `<strong class="text-green-800">🏛️ SENATE VERDICT — TRIUMPH!</strong> ${trial.explanation}`;
              renderGauntletStage();
              fbBox.classList.remove('hidden');
              fbBox.innerHTML = `<strong class="text-green-800">🏛️ SENATE VERDICT — TRIUMPH!</strong> ${trial.explanation}`;
            } else {
              btn.className =
                'flex items-center gap-3 rounded-xl border-2 border-[#b91c1c] bg-[#fee2e2] px-3.5 py-2.5 text-left text-xs font-bold text-[#7f1d1d]';
              fbBox.innerHTML = `<strong class="text-[#991b1b]">⚔️ PARRIED BY THE GUARDIAN!</strong> Re-examine the architecture constraints and strike another option.`;
            }
          });
          optList.appendChild(btn);
        });
      }
    }

    document.getElementById('btn-gauntlet-prev')?.addEventListener('click', () => {
      currentTrialIdx = (currentTrialIdx - 1 + COLOSSEUM_TRIALS.length) % COLOSSEUM_TRIALS.length;
      renderGauntletStage();
    });
    document.getElementById('btn-gauntlet-next')?.addEventListener('click', () => {
      currentTrialIdx = (currentTrialIdx + 1) % COLOSSEUM_TRIALS.length;
      renderGauntletStage();
    });

    // ===================================================================
    // HALL OF VICTORS DECREE INSPECTOR
    // ===================================================================
    const decreeModal = document.getElementById('trophy-decree-modal');
    const decreeTitle = document.getElementById('trophy-decree-title');
    const decreeBody = document.getElementById('trophy-decree-body');

    document.querySelectorAll('[data-trophy-inspect]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = (btn as HTMLElement).dataset.trophyInspect || 'ideafest';
        const d = TROPHY_DECREES[key];
        if (!d || !decreeModal || !decreeTitle || !decreeBody) return;
        decreeTitle.textContent = d.title;
        decreeBody.textContent = d.body;
        decreeModal.classList.remove('hidden');
        emitCanvasShockwave('AVE VICTOR! DECREE UNSEALED 🏆', '#fbbf24');
      });
    });

    document.getElementById('btn-close-decree')?.addEventListener('click', () => {
      decreeModal?.classList.add('hidden');
    });

    // ===================================================================
    // OBELISK OF MARS: 6-AXIS GLADIATOR RUNES
    // ===================================================================
    function renderGladiatorRunes(mode = 'balanced') {
      const container = document.getElementById('gladiator-runes-bars');
      if (!container) return;
      const items = RUNE_PRESETS[mode] || RUNE_PRESETS.balanced;
      container.innerHTML = '';

      items.forEach((item) => {
        const row = document.createElement('div');
        row.className =
          'rounded-xl border-2 border-[#c8a97e] bg-gradient-to-b from-[#fffbeb] to-[#f5e6c8] p-3 shadow-sm';
        row.innerHTML = `
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="font-mono text-xs font-black text-[#3b1d0a]">${item.label}</span>
            <div class="flex items-center gap-1.5">
              <span class="rounded border border-[#8c5a2b] bg-[#f2e2c4] px-1.5 py-0.5 font-mono text-[10px] font-bold text-[#5c3a1b]">RUNE ${item.rune}</span>
              <span class="rounded border border-[#991b1b] bg-[#7f1d1d] px-2 py-0.5 font-mono text-xs font-black text-[#fef08a]">${item.score} / 100</span>
            </div>
          </div>
          <div class="mt-2 h-3 w-full overflow-hidden rounded-full border border-[#78350f] bg-[#2e1605] p-0.5">
            <div class="h-full rounded-full bg-gradient-to-r from-[#991b1b] via-[#d97706] to-[#fbbf24] transition-all duration-500" style="width: ${item.score}%"></div>
          </div>
          <p class="mt-1.5 text-[11px] text-[#5c3a1b]">${item.desc}</p>
        `;
        container.appendChild(row);
      });

      document.querySelectorAll('.stat-mode-btn').forEach((b) => {
        const bMode = (b as HTMLElement).dataset.statMode;
        if (bMode === mode) {
          b.className =
            'stat-mode-btn rounded-lg border-2 border-[#fbbf24] bg-[#7f1d1d] px-2.5 py-1 font-mono text-[10px] font-extrabold text-[#fef08a]';
        } else {
          b.className =
            'stat-mode-btn rounded-lg border-2 border-[#b59264] bg-[#fdf8ed] px-2.5 py-1 font-mono text-[10px] font-extrabold text-[#451a03]';
        }
      });
    }

    document.querySelectorAll('.stat-mode-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const mode = (btn as HTMLElement).dataset.statMode || 'balanced';
        renderGladiatorRunes(mode);
        emitCanvasShockwave(`STANCE: ${mode.toUpperCase()} 🛡️`, '#d97706');
      });
    });

    // ===================================================================
    // 2D COLOSSEUM NAVIGATION BUTTONS & KEYBOARD HOTKEYS (D, G, T, S)
    // ===================================================================
    document.querySelectorAll('[data-arena-nav]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = (btn as HTMLElement).dataset.arenaNav;
        const scrollId = (btn as HTMLElement).dataset.scrollTo;
        if (targetId && (window as any).__townEngine) {
          (window as any).__townEngine.walkToObject(targetId);
        }
        if (scrollId) {
          document.getElementById(scrollId)?.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });

    window.addEventListener('keydown', (e) => {
      const tag = (e.target as HTMLElement)?.tagName;
      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
      const key = e.key.toLowerCase();
      const eng = (window as any).__townEngine;
      if (key === 'd') {
        eng?.walkToObject('battle-terminal');
        document.getElementById('battle-sim-section')?.scrollIntoView({ behavior: 'smooth' });
      } else if (key === 'g') {
        eng?.walkToObject('algorithm-dojo');
        document.getElementById('algo-dojo-section')?.scrollIntoView({ behavior: 'smooth' });
      } else if (key === 't') {
        eng?.walkToObject('trophy-vault');
        document.getElementById('trophy-vault-section')?.scrollIntoView({ behavior: 'smooth' });
      } else if (key === 's') {
        eng?.walkToObject('stat-radar');
        document.getElementById('stat-radar-section')?.scrollIntoView({ behavior: 'smooth' });
      }
    });

    // Initial render
    updateFameUI();
    resetBout(0);
    renderGauntletStage();
    renderGladiatorRunes('balanced');
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGladiatorArena);
  } else {
    initGladiatorArena();
  }
</script>
