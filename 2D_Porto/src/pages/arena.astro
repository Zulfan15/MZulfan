            class="rounded-xl border border-emerald-400/40 bg-emerald-500/15 px-3.5 py-2 font-mono text-xs text-emerald-200 hover:bg-emerald-500/25 transition"
          >
            💼 Connect on LinkedIn
          </a>
          <a
            href="/arcade"
            class="rounded-xl border border-purple-400/40 bg-purple-500/15 px-3.5 py-2 font-mono text-xs text-purple-200 hover:bg-purple-500/25 transition"
          >
            🕹️ Challenge Deoxys Arcade
          </a>
          <a
            href="/"
            onclick="sessionStorage.setItem('town:respawn', '38,44')"
            class="rounded-xl border border-slate-600 bg-slate-800/70 px-3.5 py-2 font-mono text-xs text-slate-200 hover:border-purple-400 transition"
          >
            🚪 Exit Stadium
          </a>
        </div>
      </div>
    </section>
  </article>
</TownLayout>

<script>
  import { sfx } from '../game/sfx';
  import { gameStore } from '../game/store';

  interface PartnerSpec {
    name: string;
    role: string;
    icon: string;
    maxHp: number;
    moves: {
      name: string;
      pwrLabel: string;
      desc: string;
      dmgMin: number;
      dmgMax: number;
      heal?: number;
      shield?: boolean;
      color: string;
    }[];
  }

  const PARTNERS: Record<string, PartnerSpec> = {
    charizard: {
      name: 'Charizard',
      role: 'Full-Stack Web & Cloud Flame',
      icon: '🔥',
      maxHp: 280,
      moves: [
        {
          name: '🔥 Laravel 12 Blitz',
          pwrLabel: '95 PWR',
          desc: 'High-damage MVC + PostGIS spatial strike',
          dmgMin: 78,
          dmgMax: 98,
          color: '#f97316',
        },
        {
          name: '⚡ Astro 60FPS Slash',
          pwrLabel: '85 PWR · CRIT',
          desc: 'Zero-bloat static island critical strike',
          dmgMin: 72,
          dmgMax: 112,
          color: '#38bdf8',
        },
        {
          name: '🛡️ JWT Dragon Scale',
          pwrLabel: '+DEF & ATK',
          desc: 'Halves incoming Boss damage & boosts attack +35%',
          dmgMin: 25,
          dmgMax: 35,
          shield: true,
          color: '#6366f1',
        },
        {
          name: '💖 Espresso Restore',
          pwrLabel: '+110 HP',
          desc: 'Dark Roasted TypeScript hotfix restores 110 HP',
          dmgMin: 0,
          dmgMax: 0,
          heal: 110,
          color: '#10b981',
        },
      ],
    },
    lucario: {
      name: 'Lucario',
      role: 'Edge AI & Aura Tactician',
      icon: '🌀',
      maxHp: 270,
      moves: [
        {
          name: '🌀 TensorRT Aura Sphere',
          pwrLabel: '100 PWR',
          desc: '1.8ms FP16 quantized sphere that never misses',
          dmgMin: 84,
          dmgMax: 104,
          color: '#38bdf8',
        },
        {
          name: '⚡ YOLOv11 Bullet Punch',
          pwrLabel: '88 PWR · FAST',
          desc: '75+ FPS priority bounding-box strike',
          dmgMin: 75,
          dmgMax: 108,
          color: '#a855f7',
        },
        {
          name: '🛡️ Calm Mind Aegis',
          pwrLabel: '+DEF & ATK',
          desc: 'Focuses neural weights: +35% Atk & 50% shield',
          dmgMin: 28,
          dmgMax: 38,
          shield: true,
          color: '#6366f1',
        },
        {
          name: '💖 Oran Berry Pulse',
          pwrLabel: '+115 HP',
          desc: 'Restores 115 HP with organic Town Square berries',
          dmgMin: 0,
          dmgMax: 0,
          heal: 115,
          color: '#10b981',
        },
      ],
    },
    garchomp: {
      name: 'Garchomp',
      role: 'Supersonic Systems & Algorithms',
      icon: '🦈',
      maxHp: 295,
      moves: [
        {
          name: '🦈 PostGIS Earthquake',
          pwrLabel: '105 PWR',
          desc: 'Massive spatial-index seismic shockwave',
          dmgMin: 86,
          dmgMax: 108,
          color: '#eab308',
        },
        {
          name: '⚡ Redis Lua Claw',
          pwrLabel: '90 PWR · CRIT',
          desc: 'Sub-millisecond atomic mutex critical slash',
          dmgMin: 76,
          dmgMax: 115,
          color: '#ef4444',
        },
        {
          name: '🛡️ Docker Sand Veil',
          pwrLabel: '+DEF & ATK',
          desc: 'Containerized isolation halves incoming damage',
          dmgMin: 25,
          dmgMax: 35,
          shield: true,
          color: '#6366f1',
        },
        {
          name: '💖 Clean-Code Refactor',
          pwrLabel: '+105 HP',
          desc: 'Eliminates tech debt & restores 105 HP',
          dmgMin: 0,
          dmgMax: 0,
          heal: 105,
          color: '#10b981',
        },
      ],
    },
    dialga: {
      name: 'Dialga',
      role: 'Temporal Cloud & HCIA Security',
      icon: '⏳',
      maxHp: 310,
      moves: [
        {
          name: '⏳ Roar of Real-Time Kafka',
          pwrLabel: '110 PWR',
          desc: 'High-throughput event-stream temporal blast',
          dmgMin: 90,
          dmgMax: 112,
          color: '#38bdf8',
        },
        {
          name: '⚡ HCIA Flash Cannon',
          pwrLabel: '90 PWR',
          desc: 'Huawei HCIA-Security encrypted beam strike',
          dmgMin: 78,
          dmgMax: 102,
          color: '#818cf8',
        },
        {
          name: '🛡️ IPSec VPN Barrier',
          pwrLabel: '+DEF & ATK',
          desc: 'Zero-trust tunnel halves Boss damage & boosts Atk',
          dmgMin: 30,
          dmgMax: 40,
          shield: true,
          color: '#6366f1',
        },
        {
          name: '💖 Temporal Rollback',
          pwrLabel: '+120 HP',
          desc: 'Rewinds system state to restore 120 HP',
          dmgMin: 0,
          dmgMax: 0,
          heal: 120,
          color: '#10b981',
        },
      ],
    },
  };

  const MEWTWO_MOVES = [
    { name: '🔮 Psystrike Overload', dmg: 68, intent: 'Charging Psystrike Overload...' },
    { name: '🌌 Neural Shadow Ball', dmg: 58, intent: ' Preparing Neural Shadow Ball...' },
    { name: '⚡ DDOS Aura Storm', dmg: 74, intent: 'Warning: High-Load DDOS Storm incoming!' },
  ];

  function initArenaPage() {
    const STORAGE_KEY = 'town:arena-elo-v1';
    let elo = 1850;
    let wins = 0;
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (raw) {
        const parsed = JSON.parse(raw);
        if (typeof parsed.elo === 'number') elo = parsed.elo;
        if (typeof parsed.wins === 'number') wins = parsed.wins;
      }
    } catch {
      // ignore storage errors
    }

    const eloEl = document.getElementById('arena-elo-display');
    const winsEl = document.getElementById('arena-wins-count');
    const badgeStatusEl = document.getElementById('arena-badge-status');

    function updateHeaderTelemetry() {
      if (eloEl) eloEl.textContent = `${elo} ELO`;
      if (winsEl) winsEl.textContent = String(wins);
      if (badgeStatusEl) {
        if (wins > 0) {
          badgeStatusEl.textContent = '👑 Frontier Master';
          badgeStatusEl.className = 'text-amber-300 font-bold';
        } else {
          badgeStatusEl.textContent = 'Challenger';
        }
      }
    }
    updateHeaderTelemetry();

    // 1. Briefing Topic Switcher
    const speakerEl = document.getElementById('arena-dialogue-speaker');
    const quoteEl = document.getElementById('arena-dialogue-text');
    const topicBtns = document.querySelectorAll<HTMLButtonElement>('.arena-topic-btn');

    topicBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        sfx.select();
        topicBtns.forEach((b) => {
          b.classList.remove('is-active', 'border-purple-400/40', 'bg-purple-500/20');
        });
        btn.classList.add('is-active', 'border-purple-400/40', 'bg-purple-500/20');
        if (speakerEl && btn.dataset.speaker) speakerEl.textContent = btn.dataset.speaker;
        if (quoteEl && btn.dataset.quote) quoteEl.textContent = `"${btn.dataset.quote}"`;
        if (btn.dataset.prop) {
          window.dispatchEvent(new CustomEvent('town:locate', { detail: { id: btn.dataset.prop } }));
        }
      });
    });

    document.getElementById('btn-walk-mewtwo')?.addEventListener('click', () => {
      sfx.encounter();
      window.dispatchEvent(new CustomEvent('town:locate', { detail: { id: 'mewtwo-boss' } }));
    });
    document.getElementById('btn-walk-lucario')?.addEventListener('click', () => {
      sfx.confirm();
      window.dispatchEvent(new CustomEvent('town:locate', { detail: { id: 'lucario-coach' } }));
    });
    document.getElementById('btn-locate-trophies')?.addEventListener('click', () => {
      sfx.heal();
      window.dispatchEvent(new CustomEvent('town:locate', { detail: { id: 'trophy-vault' } }));
    });

    // 2. 2D Station Walk Buttons
    document.querySelectorAll<HTMLButtonElement>('.arena-station-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.locate;
        if (!id) return;
        sfx.select();
        window.dispatchEvent(new CustomEvent('town:locate', { detail: { id } }));
      });
    });

    // 3. Turn-Based Battle Simulator Logic
    let activePartnerKey = 'charizard';
    let playerHp = PARTNERS.charizard.maxHp;
    let playerMaxHp = PARTNERS.charizard.maxHp;
    let bossHp = 320;
    const bossMaxHp = 320;
    let turn = 1;
    let shieldActive = false;
    let atkMultiplier = 1;
    let battleOver = false;

    const pIconEl = document.getElementById('sim-player-icon');
    const pNameEl = document.getElementById('sim-player-name');
    const pRoleEl = document.getElementById('sim-player-role');
    const pHpText = document.getElementById('sim-player-hp-text');
    const pMaxHpText = document.getElementById('sim-player-maxhp-text');
    const pHpBar = document.getElementById('sim-player-hp-bar');
    const pBuffEl = document.getElementById('sim-player-buff');

    const bHpText = document.getElementById('sim-boss-hp-text');
    const bHpBar = document.getElementById('sim-boss-hp-bar');
    const bIntentEl = document.getElementById('sim-boss-intent');
    const turnEl = document.getElementById('battle-turn-indicator');
    const statusTagEl = document.getElementById('battle-status-tag');
    const logEl = document.getElementById('sim-battle-log');

    function appendLog(html: string) {
      if (!logEl) return;
      const p = document.createElement('p');
      p.innerHTML = html;
      logEl.prepend(p);
    }

    function renderBattleHud() {
      const spec = PARTNERS[activePartnerKey];
      if (pIconEl) pIconEl.textContent = spec.icon;
      if (pNameEl) pNameEl.textContent = spec.name;
      if (pRoleEl) pRoleEl.textContent = spec.role;
      if (pHpText) pHpText.textContent = String(Math.max(0, playerHp));
      if (pMaxHpText) pMaxHpText.textContent = String(playerMaxHp);
      if (pHpBar) {
        const pct = Math.max(0, Math.min(100, Math.round((playerHp / playerMaxHp) * 100)));
        pHpBar.style.width = `${pct}%`;
      }
      if (pBuffEl) {
        pBuffEl.textContent = shieldActive
          ? `🛡️ Shield ON · Atk ×${atkMultiplier.toFixed(2)}`
          : `Atk ×${atkMultiplier.toFixed(2)}`;
      }

      if (bHpText) bHpText.textContent = String(Math.max(0, bossHp));
      if (bHpBar) {
        const bPct = Math.max(0, Math.min(100, Math.round((bossHp / bossMaxHp) * 100)));
        bHpBar.style.width = `${bPct}%`;
      }

      spec.moves.forEach((m, idx) => {
        const nEl = document.getElementById(`move-${idx}-name`);
        const pwEl = document.getElementById(`move-${idx}-pwr`);
        const dEl = document.getElementById(`move-${idx}-desc`);
        if (nEl) nEl.textContent = m.name;
        if (pwEl) pwEl.textContent = m.pwrLabel;
        if (dEl) dEl.textContent = m.desc;
      });
    }

    function resetBattle(partnerKey = activePartnerKey) {
      activePartnerKey = partnerKey;
      const spec = PARTNERS[activePartnerKey];
      playerMaxHp = spec.maxHp;
      playerHp = playerMaxHp;
      bossHp = bossMaxHp;
      turn = 1;
      shieldActive = false;
      atkMultiplier = 1;
      battleOver = false;
      if (turnEl) turnEl.textContent = 'TURN 1 · YOUR MOVE';
      if (statusTagEl) {
        statusTagEl.textContent = '● Battle Active';
        statusTagEl.className = 'text-emerald-400';
      }
      if (logEl) {
        logEl.innerHTML = `<p>🏁 Referee Victor signals the start! <strong>${spec.icon} ${spec.name}</strong> steps onto the Colosseum court against <strong>🔮 Frontier Brain Mewtwo</strong>!</p>`;
      }
      renderBattleHud();
    }

    document.querySelectorAll<HTMLButtonElement>('.battle-partner-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.partner;
        if (!key || !PARTNERS[key]) return;
        sfx.select();
        document.querySelectorAll<HTMLButtonElement>('.battle-partner-btn').forEach((b) => {
          b.classList.remove('is-selected', 'border-amber-400', 'bg-amber-500/20');
          b.classList.add('border-slate-700', 'bg-black/30');
        });
        btn.classList.remove('border-slate-700', 'bg-black/30');
        btn.classList.add('is-selected', 'border-amber-400', 'bg-amber-500/20');
        resetBattle(key);
        window.dispatchEvent(
          new CustomEvent('town:arena-fx', {
            detail: { text: `GO! ${PARTNERS[key].name.toUpperCase()}!`, color: '#38bdf8' },
          })
        );
      });
    });

    document.getElementById('btn-reset-battle')?.addEventListener('click', () => {
      sfx.confirm();
      resetBattle(activePartnerKey);
    });

    document.querySelectorAll<HTMLButtonElement>('.sim-move-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (battleOver) {
          resetBattle(activePartnerKey);
          return;
        }
        const idx = Number(btn.dataset.moveIdx || 0);
        const spec = PARTNERS[activePartnerKey];
        const move = spec.moves[idx];
        if (!move) return;

        // Player Move Execution
        if (move.heal) {
          sfx.heal();
          const healed = Math.min(playerMaxHp - playerHp, move.heal);
          playerHp = Math.min(playerMaxHp, playerHp + move.heal);
          appendLog(
            `<span class="text-emerald-300">Turn ${turn}:</span> <strong>${spec.name}</strong> used <strong>${move.name}</strong>! Restored <strong>+${healed} HP</strong> & cleared fatigue!`
          );
          window.dispatchEvent(
            new CustomEvent('town:arena-fx', {
              detail: { text: `${move.name.toUpperCase()} +${healed} HP`, color: move.color },
            })
          );
        } else if (move.shield) {
          sfx.confirm();
          shieldActive = true;
          atkMultiplier = Math.min(1.75, atkMultiplier + 0.35);
          const chipDmg = Math.round((move.dmgMin + Math.random() * (move.dmgMax - move.dmgMin)) * atkMultiplier);
          bossHp = Math.max(0, bossHp - chipDmg);
          appendLog(
            `<span class="text-indigo-300">Turn ${turn}:</span> <strong>${spec.name}</strong> deployed <strong>${move.name}</strong>! Dealt <strong>${chipDmg} DMG</strong>, raised Attack ×${atkMultiplier.toFixed(2)} & activated 50% Firewall Shield!`
          );
          window.dispatchEvent(
            new CustomEvent('town:arena-fx', {
              detail: { text: `SHIELD UP! ${move.name.toUpperCase()}`, color: move.color },
            })
          );
        } else {
          sfx.encounter();
          const isCrit = Math.random() < 0.28;
          const baseDmg = move.dmgMin + Math.random() * (move.dmgMax - move.dmgMin);
          const finalDmg = Math.round(baseDmg * atkMultiplier * (isCrit ? 1.35 : 1));
          bossHp = Math.max(0, bossHp - finalDmg);
          appendLog(
            `<span class="text-amber-300">Turn ${turn}:</span> <strong>${spec.name}</strong> unleashed <strong>${move.name}</strong>! ${isCrit ? '<strong class="text-yellow-300">CRITICAL HIT!</strong> ' : ''}Dealt <strong>${finalDmg} DMG</strong> to Mewtwo!`
          );
          window.dispatchEvent(
            new CustomEvent('town:arena-fx', {
              detail: {
                text: `${isCrit ? 'CRIT! ' : ''}${move.name.toUpperCase()} -${finalDmg} HP`,
                color: move.color,
              },
            })
          );
        }

        renderBattleHud();

        // Check Victory
        if (bossHp <= 0) {
          battleOver = true;
          wins += 1;
          elo += 150;
          try {
            localStorage.setItem(STORAGE_KEY, JSON.stringify({ elo, wins }));
          } catch {
            // ignore
          }
          gameStore.addStamp('battle');
          sfx.heal();
          updateHeaderTelemetry();
          if (turnEl) turnEl.textContent = '🏆 VICTORY! FRONTIER MASTER!';
          if (statusTagEl) {
            statusTagEl.textContent = '★ MEWTWO DEFEATED (+150 ELO)';
            statusTagEl.className = 'text-amber-300 font-bold';
          }
          appendLog(
            `<strong class="text-amber-300">🏆 VICTORY!</strong> Frontier Brain Mewtwo’s psychic barrier collapsed! You earned <strong>+150 ELO</strong> and the <strong>Arena Frontier Master Badge</strong>!`
          );
          window.dispatchEvent(
            new CustomEvent('town:arena-fx', {
              detail: { text: '🏆 VICTORY! FRONTIER BADGE UNLOCKED!', color: '#fbbf24' },
            })
          );
          return;
        }

        // Boss Counter-Attack
        const bossMove = MEWTWO_MOVES[turn % MEWTWO_MOVES.length];
        const rawBossDmg = bossMove.dmg + Math.floor(Math.random() * 14);
        const actualBossDmg = shieldActive ? Math.round(rawBossDmg * 0.5) : rawBossDmg;
        shieldActive = false;
        playerHp = Math.max(0, playerHp - actualBossDmg);

        appendLog(
          `<span class="text-purple-300">Mewtwo Counter:</span> <strong>🔮 Frontier Mewtwo</strong> cast <strong>${bossMove.name}</strong> for <strong>${actualBossDmg} DMG</strong>!`
        );

        if (bIntentEl) {
          const nextMove = MEWTWO_MOVES[(turn + 1) % MEWTWO_MOVES.length];
          bIntentEl.textContent = nextMove.intent;
        }

        if (playerHp <= 0) {
          battleOver = true;
          if (turnEl) turnEl.textContent = '⚠️ FAINTED · CLICK REMATCH';
          if (statusTagEl) {
            statusTagEl.textContent = '● Rematch Ready';
            statusTagEl.className = 'text-rose-400';
          }
          appendLog(
            `<span class="text-rose-300">⚠️ ${spec.name} fainted!</span> Tip from Lucario: Use <strong>🛡️ Shield</strong> on Turn 2 and <strong>💖 Restore</strong> when HP drops below 120! Click any move or <strong>↺ Rematch</strong> to try again.`
          );
        } else {
          turn += 1;
          if (turnEl) turnEl.textContent = `TURN ${turn} · YOUR MOVE`;
        }

        renderBattleHud();
      });
    });

    // 4. 6-Stage AI & Architecture Gauntlet Logic
    let gauntletScore = 0;
    const solvedStages = new Set<number>();
    const scoreValEl = document.getElementById('gauntlet-score-val');
    const scoreTopEl = document.getElementById('arena-gauntlet-score-top');

    function updateGauntletScore() {
      if (scoreValEl) scoreValEl.textContent = String(gauntletScore);
      if (scoreTopEl) scoreTopEl.textContent = `${gauntletScore} / 6`;
      if (gauntletScore >= 4) {
        gameStore.addStamp('battle');
      }
    }

    document.querySelectorAll<HTMLElement>('.gauntlet-card').forEach((card) => {
      const qIdx = Number(card.dataset.qIdx || 0);
      const correctOpt = Number(card.dataset.correct || 0);
      const statusEl = card.querySelector('.gauntlet-status');
      const expEl = card.querySelector('.gauntlet-exp');
      const opts = card.querySelectorAll<HTMLButtonElement>('.gauntlet-opt');

      opts.forEach((btn) => {
        btn.addEventListener('click', () => {
          if (solvedStages.has(qIdx)) return;
          const picked = Number(btn.dataset.opt || 0);
          if (picked === correctOpt) {
            solvedStages.add(qIdx);
            gauntletScore += 1;
            sfx.confirm();
            btn.classList.remove('border-slate-700', 'bg-slate-900/80');
            btn.classList.add('border-emerald-400', 'bg-emerald-500/25', 'text-emerald-100', 'font-bold');
            if (statusEl) {
              statusEl.textContent = '★ Cleared';
              statusEl.className = 'gauntlet-status text-emerald-400 font-bold';
            }
            expEl?.classList.remove('hidden');
            updateGauntletScore();
            window.dispatchEvent(
              new CustomEvent('town:arena-fx', {
                detail: { text: `STAGE 0${qIdx + 1} CLEARED! (${gauntletScore}/6)`, color: '#10b981' },
              })
            );
          } else {
            sfx.select();
            btn.classList.remove('border-slate-700');
            btn.classList.add('border-rose-500/60', 'bg-rose-950/40', 'text-rose-200');
            if (statusEl) {
              statusEl.textContent = 'Try Again';
              statusEl.className = 'gauntlet-status text-rose-400';
            }
          }
        });
      });
    });

    document.getElementById('btn-reset-gauntlet')?.addEventListener('click', () => {
      sfx.select();
      gauntletScore = 0;
      solvedStages.clear();
      updateGauntletScore();
      document.querySelectorAll<HTMLElement>('.gauntlet-card').forEach((card) => {
        const statusEl = card.querySelector('.gauntlet-status');
        if (statusEl) {
          statusEl.textContent = 'Unsolved';
          statusEl.className = 'gauntlet-status text-slate-400';
        }
        card.querySelector('.gauntlet-exp')?.classList.add('hidden');
        card.querySelectorAll<HTMLButtonElement>('.gauntlet-opt').forEach((btn) => {
          btn.className =
            'gauntlet-opt w-full rounded-lg border border-slate-700 bg-slate-900/80 px-3 py-2 text-left font-mono text-xs text-slate-200 hover:border-purple-400 transition';
        });
      });
    });

    // 5. Global Hotkeys on /arena
    window.addEventListener('keydown', (e) => {
      const tag = (e.target as HTMLElement | null)?.tagName;
      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || e.metaKey || e.ctrlKey || e.altKey) return;
      const key = e.key.toLowerCase();
      if (key === 'd') {
        document.getElementById('arena-battle-sim')?.scrollIntoView({ behavior: 'smooth' });
      } else if (key === 'g') {
        document.getElementById('arena-quiz-gauntlet')?.scrollIntoView({ behavior: 'smooth' });
      } else if (key === 't') {
        document.getElementById('arena-trophy-vault')?.scrollIntoView({ behavior: 'smooth' });
      } else if (key === 's') {
        document.getElementById('arena-stat-scanner')?.scrollIntoView({ behavior: 'smooth' });
      }
    });
  }

  initArenaPage();
</script>
