---
import TownLayout from '../layouts/TownLayout.astro';
import { profile } from '../lib/profile';
---

<TownLayout
  title="Gladiator Colosseum — Muhammad Zulfan"
  description="Step into Muhammad Zulfan's Gladiator Colosseum: command your Champion in a 1v1 Arena Duel against Grand Champion Mewtwo, conquer the Six Trials of Rome, inspect the Hall of Victors, and read the Obelisk of Mars."
  place="arena"
>
  <div class="gladiator-colosseum space-y-8 pb-10">
    <!-- ===================================================================== -->
    <!-- 1. IMPERIAL COLOSSEUM MARQUEE BANNER (ROMAN TRAVERTINE & CRIMSON)     -->
    <!-- ===================================================================== -->
    <section
      class="relative overflow-hidden rounded-2xl border-[3px] border-[#8c5a2b] bg-gradient-to-b from-[#5c1111] via-[#7f1d1d] to-[#450a0a] p-5 text-[#fef3c7] shadow-[0_10px_0_#3b1d0a,0_16px_32px_rgba(45,18,6,0.35)]"
    >
      <!-- Top & Bottom Roman Gold Fretwork Trim -->
      <div
        class="pointer-events-none absolute inset-x-0 top-0 h-2 bg-[repeating-linear-gradient(90deg,#fbbf24_0px,#fbbf24_12px,#92400e_12px,#92400e_24px)] opacity-90"
      >
      </div>
      <div
        class="pointer-events-none absolute inset-x-0 bottom-0 h-1.5 bg-gradient-to-r from-[#92400e] via-[#fbbf24] to-[#92400e]"
      >
      </div>

      <!-- Warm Torchlight Radial Glows -->
      <div
        class="pointer-events-none absolute -left-10 -top-10 h-44 w-44 rounded-full bg-amber-500/20 blur-2xl"
      >
      </div>
      <div
        class="pointer-events-none absolute -right-10 -bottom-10 h-44 w-44 rounded-full bg-orange-500/20 blur-2xl"
      >
      </div>

      <div class="relative z-10 flex flex-wrap items-start justify-between gap-4 pt-1">
        <div class="space-y-2">
          <div class="inline-flex flex-wrap items-center gap-2">
            <span
              class="inline-flex items-center gap-1.5 rounded-full border-2 border-[#fbbf24] bg-[#450a0a]/90 px-3 py-0.5 font-mono text-[10px] font-extrabold uppercase tracking-[0.18em] text-[#fde68a] shadow-sm"
            >
              <span>🏛️</span> COLOSSEUM GLADIATORIA · AMPHITHEATRUM
            </span>
            <span
              id="arena-frontier-badge"
              class="hidden items-center gap-1 rounded-full border-2 border-[#fde047] bg-gradient-to-r from-[#d97706] to-[#b45309] px-2.5 py-0.5 font-mono text-[10px] font-black uppercase tracking-wider text-[#fffbeb] shadow"
            >
              👑 CORONA AUREA · GRAND VICTOR
            </span>
          </div>

          <h1
            class="font-['Press_Start_2P',monospace] text-base leading-snug text-[#fef3c7] drop-shadow-[0_2px_0_#450a0a] sm:text-lg"
          >
            ⚔️ THE GLADIATOR ARENA
          </h1>

          <p class="max-w-xl text-xs leading-relaxed text-[#fde68a]/90 sm:text-sm">
            <em>"Ave, Challenger!"</em> Step onto the sunlit sand of the <strong class="text-white"
              >Grand Colosseum</strong
            >. Draw your blade in a <strong class="text-[#fde047]">1v1 Gladiator Duel</strong> against
            Emperor's Champion <strong class="text-[#fde047]">Mewtwo</strong>, conquer the <strong
              class="text-[#fde047]">Six Trials of Rome</strong
            >, and claim your place in the <strong class="text-[#fde047]">Hall of Victors</strong>.
          </p>
        </div>

        <!-- Imperial Fame & Crowd Favor Tablet -->
        <div
          class="flex shrink-0 flex-col items-end rounded-xl border-2 border-[#fbbf24]/80 bg-[#2e0909]/90 px-4 py-2.5 shadow-inner"
        >
          <span class="font-mono text-[10px] font-bold uppercase tracking-widest text-[#fcd34d]">
            👑 GLADIATOR FAME (GLORIA)
          </span>
          <div class="mt-0.5 flex items-baseline gap-1.5">
            <span
              id="arena-elo-value"
              class="font-['Press_Start_2P',monospace] text-lg text-[#fef08a] drop-shadow-[0_2px_0_#78350f]"
              >1850</span
            >
            <span
              id="arena-elo-tier"
              class="rounded border border-[#f59e0b]/60 bg-[#78350f]/80 px-1.5 py-0.5 font-mono text-[9px] font-extrabold text-[#fde68a]"
              >PRIMUS PALUS</span
            >
          </div>
          <span id="arena-record-label" class="mt-1 font-mono text-[10px] text-[#fde68a]/80">
            Victories: 0W · Trials: 0/6
          </span>
        </div>
      </div>

      <!-- 4 Colosseum Gate Quick-Walk Buttons -->
      <div class="relative z-10 mt-4 grid grid-cols-2 gap-2 pt-2 sm:grid-cols-4">
        <button
          type="button"
          data-arena-nav="battle-terminal"
          data-scroll-to="battle-sim-section"
          class="group flex items-center gap-2 rounded-xl border-2 border-[#d97706] bg-gradient-to-b from-[#fef3c7] to-[#fde68a] px-3 py-2 text-left text-[#451a03] shadow-[0_3px_0_#78350f] transition hover:-translate-y-0.5 hover:from-[#fffbeb] hover:to-[#fef08a] active:translate-y-0"
        >
          <span class="text-base">⚔️</span>
          <div class="min-w-0">
            <div class="truncate font-mono text-[11px] font-black uppercase">1v1 Arena Pit</div>
            <div class="truncate text-[10px] font-semibold text-[#78350f]"> Walk to Armory [D]</div>
          </div>
        </button>

        <button
          type="button"
          data-arena-nav="algorithm-dojo"
          data-scroll-to="algo-dojo-section"
          class="group flex items-center gap-2 rounded-xl border-2 border-[#d97706] bg-gradient-to-b from-[#fef3c7] to-[#fde68a] px-3 py-2 text-left text-[#451a03] shadow-[0_3px_0_#78350f] transition hover:-translate-y-0.5 hover:from-[#fffbeb] hover:to-[#fef08a] active:translate-y-0"
        >
          <span class="text-base">🦁</span>
          <div class="min-w-0">
            <div class="truncate font-mono text-[11px] font-black uppercase">Six Trials Gate</div>
            <div class="truncate text-[10px] font-semibold text-[#78350f]">Portcullis [G]</div>
          </div>
        </button>

        <button
          type="button"
          data-arena-nav="trophy-vault"
          data-scroll-to="trophy-vault-section"
          class="group flex items-center gap-2 rounded-xl border-2 border-[#d97706] bg-gradient-to-b from-[#fef3c7] to-[#fde68a] px-3 py-2 text-left text-[#451a03] shadow-[0_3px_0_#78350f] transition hover:-translate-y-0.5 hover:from-[#fffbeb] hover:to-[#fef08a] active:translate-y-0"
        >
          <span class="text-base">🏆</span>
          <div class="min-w-0">
            <div class="truncate font-mono text-[11px] font-black uppercase">Hall of Victors</div>
            <div class="truncate text-[10px] font-semibold text-[#78350f]">Spoils & CV [T]</div>
          </div>
        </button>

        <button
          type="button"
          data-arena-nav="stat-radar"
          data-scroll-to="stat-radar-section"
          class="group flex items-center gap-2 rounded-xl border-2 border-[#d97706] bg-gradient-to-b from-[#fef3c7] to-[#fde68a] px-3 py-2 text-left text-[#451a03] shadow-[0_3px_0_#78350f] transition hover:-translate-y-0.5 hover:from-[#fffbeb] hover:to-[#fef08a] active:translate-y-0"
        >
          <span class="text-base">🛡️</span>
          <div class="min-w-0">
            <div class="truncate font-mono text-[11px] font-black uppercase">Combat Runes</div>
            <div class="truncate text-[10px] font-semibold text-[#78350f]">565 Obelisk [S]</div>
          </div>
        </button>
      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- 2. THE GLADIATOR PIT: 1V1 COLOSSEUM COMBAT SIMULATOR                  -->
    <!-- ===================================================================== -->
    <section
      id="battle-sim-section"
      class="scroll-mt-6 overflow-hidden rounded-2xl border-[3px] border-[#8c5a2b] bg-[#fbf3e4] shadow-[0_8px_0_#5c3a1b,0_12px_28px_rgba(59,36,18,0.18)]"
    >
      <!-- Carved Roman Stone Arch Header -->
      <div
        class="flex flex-wrap items-center justify-between gap-2 border-b-[3px] border-[#8c5a2b] bg-gradient-to-r from-[#4a2c11] via-[#6b3e18] to-[#4a2c11] px-5 py-3.5 text-[#fef3c7]"
      >
        <div class="flex items-center gap-2.5">
          <span
            class="flex h-8 w-8 items-center justify-center rounded-lg border-2 border-[#fbbf24] bg-[#7f1d1d] text-base shadow"
            >⚔️</span
          >
          <div>
            <div class="flex items-center gap-2">
              <h2 class="font-mono text-xs font-black uppercase tracking-wider text-[#fef08a] sm:text-sm">
                MUNERA GLADIATORUM · 1V1 SAND PIT DUEL
              </h2>
              <span
                id="battle-turn-pill"
                class="rounded-full border border-[#fbbf24]/60 bg-[#7f1d1d] px-2 py-0.5 font-mono text-[10px] font-extrabold text-[#fde68a]"
                >BOUT I</span
              >
            </div>
            <p class="text-[11px] text-[#fde68a]/80">
              Select your Gladiator from the Armory and strike down Emperor's Champion Mewtwo!
            </p>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <button
            type="button"
            id="btn-battle-reset"
            class="rounded-lg border-2 border-[#fbbf24] bg-[#7f1d1d] px-3 py-1 font-mono text-[11px] font-extrabold text-[#fef3c7] shadow-[0_2px_0_#450a0a] transition hover:bg-[#991b1b] active:translate-y-0.5"
          >
            ↺ New Bout
          </button>
        </div>
      </div>

      <!-- Gladiator Roster Armory Selector Bar -->
      <div class="border-b-2 border-[#c8a97e] bg-[#f2e2c4] px-4 py-3">
        <div class="mb-2 flex items-center justify-between">
          <span class="font-mono text-[10px] font-black uppercase tracking-wider text-[#5c3a1b]">
            🗡️ ARMORY ROSTER — CHOOSE YOUR GLADIATOR CHAMPION:
          </span>
          <span class="font-mono text-[10px] font-bold text-[#78350f]">
            Synced with 2D Colosseum Sand Pit
          </span>
        </div>

        <div class="grid grid-cols-2 gap-2 sm:grid-cols-4" id="challenger-roster-tabs">
          <button
            type="button"
            data-fighter-idx="0"
            class="fighter-tab active flex items-center gap-2 rounded-xl border-2 border-[#991b1b] bg-gradient-to-b from-[#7f1d1d] to-[#450a0a] p-2 text-left text-[#fef3c7] shadow-[0_3px_0_#2e0909] transition"
          >
            <span class="text-xl">🔥</span>
            <div class="min-w-0">
              <div class="truncate font-mono text-[11px] font-black">Charizard</div>
              <div class="truncate text-[9px] font-bold text-[#fca5a5]">Ignis Myrmillo</div>
            </div>
          </button>

          <button
            type="button"
            data-fighter-idx="1"
            class="fighter-tab flex items-center gap-2 rounded-xl border-2 border-[#b59264] bg-[#fdf8ed] p-2 text-left text-[#451a03] shadow-[0_2px_0_#8c5a2b] transition hover:border-[#78350f] hover:bg-[#fef3c7]"
          >
            <span class="text-xl">🥊</span>
            <div class="min-w-0">
              <div class="truncate font-mono text-[11px] font-black">Lucario</div>
              <div class="truncate text-[9px] font-semibold text-[#78350f]">Aura Dimachaerus</div>
            </div>
          </button>

          <button
            type="button"
            data-fighter-idx="2"
            class="fighter-tab flex items-center gap-2 rounded-xl border-2 border-[#b59264] bg-[#fdf8ed] p-2 text-left text-[#451a03] shadow-[0_2px_0_#8c5a2b] transition hover:border-[#78350f] hover:bg-[#fef3c7]"
          >
            <span class="text-xl">🐉</span>
            <div class="min-w-0">
              <div class="truncate font-mono text-[11px] font-black">Garchomp</div>
              <div class="truncate text-[9px] font-semibold text-[#78350f]">Draco Secutor</div>
            </div>
          </button>

          <button
            type="button"
            data-fighter-idx="3"
            class="fighter-tab flex items-center gap-2 rounded-xl border-2 border-[#b59264] bg-[#fdf8ed] p-2 text-left text-[#451a03] shadow-[0_2px_0_#8c5a2b] transition hover:border-[#78350f] hover:bg-[#fef3c7]"
          >
            <span class="text-xl">⏳</span>
            <div class="min-w-0">
              <div class="truncate font-mono text-[11px] font-black">Dialga</div>
              <div class="truncate text-[9px] font-semibold text-[#78350f]">Chronos Titan</div>
            </div>
          </button>
        </div>
      </div>

      <!-- =============================================================== -->
      <!-- THE SANDY GLADIATOR BATTLEFIELD (ARENA FLOOR)                   -->
      <!-- =============================================================== -->
      <div
        id="battle-stage-viewport"
        class="relative overflow-hidden border-b-[3px] border-[#8c5a2b] bg-[radial-gradient(circle_at_center,#f3d9a4_0%,#e0b875_58%,#c4934b_100%)] p-4 sm:p-5"
      >
        <!-- Concentric Gladiator Combat Rings etched in the Sand -->
        <div
          class="pointer-events-none absolute left-1/2 top-1/2 h-56 w-56 -translate-x-1/2 -translate-y-1/2 rounded-full border-[3px] border-dashed border-[#991b1b]/25"
        >
        </div>
        <div
          class="pointer-events-none absolute left-1/2 top-1/2 h-32 w-32 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-[#78350f]/25"
        >
        </div>

        <!-- Imperial Crowd Favor Bar (Pollice Verso: 👍 MITTE vs 👎 IUGULA) -->
        <div
          class="relative z-10 mb-4 flex items-center justify-between gap-3 rounded-xl border-2 border-[#78350f] bg-[#3b1d0a]/90 px-3 py-1.5 text-[#fef3c7] shadow"
        >
          <span class="font-mono text-[10px] font-extrabold uppercase tracking-wider text-[#fde68a]">
            👍 CROWD FAVOR (POLLICE VERSO)
          </span>
          <div class="h-2.5 flex-1 overflow-hidden rounded-full border border-[#fbbf24]/50 bg-[#1c0d06]">
            <div
              id="crowd-favor-bar"
              class="h-full bg-gradient-to-r from-[#dc2626] via-[#f59e0b] to-[#16a34a] transition-all duration-500"
              style="width: 55%"
            >
            </div>
          </div>
          <span id="crowd-favor-text" class="font-mono text-[10px] font-black text-[#fef08a]">
            55% · ROARING! 🔥
          </span>
        </div>

        <!-- Combatants Grid: Champion Mewtwo (Top Right) & Challenger Gladiator (Bottom Left) -->
        <div class="relative z-10 grid grid-cols-1 gap-4 sm:grid-cols-2">
          <!-- OPPONENT: GRAND CHAMPION MEWTWO -->
          <div
            class="order-1 rounded-2xl border-2 border-[#7f1d1d] bg-gradient-to-b from-[#fffbeb] to-[#f5e6c8] p-3.5 shadow-[0_5px_0_#5c1111] sm:order-2"
          >
            <div class="flex items-start justify-between gap-2">
              <div>
                <div class="flex items-center gap-1.5">
                  <span
                    class="rounded border border-[#fbbf24] bg-[#7f1d1d] px-1.5 py-0.5 font-mono text-[9px] font-black uppercase text-[#fef08a]"
                    >IMPERIAL CHAMPION</span
                  >
                  <span class="font-mono text-[10px] font-extrabold text-[#78350f]">LV.100</span>
                </div>
                <h3 class="mt-1 font-mono text-sm font-black text-[#3b1d0a]">
                  👑 Mewtwo · Colosseum Rex
                </h3>
                <p id="boss-status-tag" class="font-mono text-[10px] font-bold text-[#991b1b]">
                  🛡️ Imperial Aegis Active · Psychic/Gladiator
                </p>
              </div>
              <div
                id="boss-sprite-avatar"
                class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border-2 border-[#fbbf24] bg-gradient-to-br from-[#7f1d1d] to-[#450a0a] text-2xl shadow-inner transition-transform duration-300"
              >
                🔮
              </div>
            </div>

            <!-- Boss HP Bar -->
            <div class="mt-3">
              <div class="mb-1 flex justify-between font-mono text-[10px] font-black text-[#451a03]">
                <span>VITALITAS (HP)</span>
                <span id="boss-hp-text">500 / 500</span>
              </div>
              <div class="h-3.5 w-full overflow-hidden rounded-full border-2 border-[#5c3a1b] bg-[#291709] p-0.5">
                <div
                  id="boss-hp-bar"
                  class="h-full rounded-full bg-gradient-to-r from-[#dc2626] via-[#ef4444] to-[#f59e0b] transition-all duration-300"
                  style="width: 100%"
                >
                </div>
              </div>
            </div>
          </div>

          <!-- PLAYER: CHALLENGER GLADIATOR -->
          <div
            class="order-2 rounded-2xl border-2 border-[#8c5a2b] bg-gradient-to-b from-[#fffbeb] to-[#f5e6c8] p-3.5 shadow-[0_5px_0_#5c3a1b] sm:order-1"
          >
            <div class="flex items-start justify-between gap-2">
              <div class=" flex items-center gap-2.5">
                <div
                  id="player-sprite-avatar"
                  class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border-2 border-[#d97706] bg-gradient-to-br from-[#fef3c7] to-[#fde68a] text-2xl shadow-inner transition-transform duration-300"
                >
                  🔥
                </div>
                <div>
                  <div class="flex items-center gap-1.5">
                    <span
                      id="player-class-badge"
                      class="rounded border border-[#d97706] bg-[#78350f] px-1.5 py-0.5 font-mono text-[9px] font-black uppercase text-[#fef08a]"
                      >IGNIS MYRMILLO</span
                    >
                    <span class="font-mono text-[10px] font-extrabold text-[#78350f]">LV.95</span>
                  </div>
                  <h3 id="player-fighter-name" class="mt-1 font-mono text-sm font-black text-[#3b1d0a]">
                    Charizard · Full-Stack Striker
                  </h3>
                  <p id="player-buff-tag" class="font-mono text-[10px] font-bold text-[#92400e]">
                    ⚔️ Ready on the Colosseum Sand
                  </p>
                </div>
              </div>
            </div>

            <!-- Player HP Bar -->
            <div class="mt-3">
              <div class="mb-1 flex justify-between font-mono text-[10px] font-black text-[#451a03]">
                <span>VITALITAS (HP)</span>
                <span id="player-hp-text">420 / 420</span>
              </div>
              <div class="h-3.5 w-full overflow-hidden rounded-full border-2 border-[#5c3a1b] bg-[#291709] p-0.5">
                <div
                  id="player-hp-bar"
                  class="h-full rounded-full bg-gradient-to-r from-[#15803d] via-[#22c55e] to-[#86efac] transition-all duration-300"
                  style="width: 100%"
                >
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- =============================================================== -->
      <!-- GLADIATOR WEAPON STRIKES & IMPERIAL BLESSINGS                   -->
      <!-- =============================================================== -->
      <div class="space-y-4 bg-[#f7ead2] p-4 sm:p-5">
        <div>
          <div class="mb-2 flex items-center justify-between">
            <span class="font-mono text-[11px] font-black uppercase tracking-wider text-[#5c1111]">
              ⚔️ COMMAND YOUR GLADIATOR STRIKE (4 TECHNIQUES):
            </span>
            <span class="font-mono text-[10px] font-bold text-[#78350f]">
              Click a weapon strike to clash in the pit
            </span>
          </div>

          <div id="battle-moves-grid" class="grid grid-cols-1 gap-2.5 sm:grid-cols-2">
            <!-- Dynamically populated by arena script -->
          </div>
        </div>

        <!-- 3 Imperial Arena Blessings (Items) -->
        <div class="rounded-xl border-2 border-[#b59264] bg-[#fdf8ed] p-3">
          <div class="mb-2 flex items-center justify-between">
            <span class="font-mono text-[10px] font-black uppercase tracking-wider text-[#78350f]">
              🏺 IMPERIAL TRIBUNE BLESSINGS (1 USE EACH PER BOUT):
            </span>
          </div>
          <div class="grid grid-cols-1 gap-2 sm:grid-cols-3">
            <button
              type="button"
              id="item-potion-btn"
              class="flex items-center justify-between rounded-lg border-2 border-[#15803d] bg-[#f0fdf4] px-3 py-2 text-left text-xs font-bold text-[#14532d] shadow-sm transition hover:bg-[#dcfce7] disabled:opacity-45"
            >
              <span>🏺 Ambrosia Nectar (+65% HP)</span>
              <span id="item-potion-count" class="font-mono text-[10px] font-black">1×</span>
            </button>

            <button
              type="button"
              id="item-xspatk-btn"
              class="flex items-center justify-between rounded-lg border-2 border-[#b45309] bg-[#fffbeb] px-3 py-2 text-left text-xs font-bold text-[#78350f] shadow-sm transition hover:bg-[#fef3c7] disabled:opacity-45"
            >
              <span>🔥 Vulcan Whetstone (+35% ATK)</span>
              <span id="item-xspatk-count" class="font-mono text-[10px] font-black">1×</span>
            </button>

            <button
              type="button"
              id="item-guard-btn"
              class="flex items-center justify-between rounded-lg border-2 border-[#1d4ed8] bg-[#eff6ff] px-3 py-2 text-left text-xs font-bold text-[#1e3a8a] shadow-sm transition hover:bg-[#dbeafe] disabled:opacity-45"
            >
              <span>🛡️ Roman Testudo (50% Shield)</span>
              <span id="item-guard-count" class="font-mono text-[10px] font-black">1×</span>
            </button>
          </div>
        </div>

        <!-- Parchment Scroll Combat Chronicle (Battle Log) -->
        <div
          class="rounded-xl border-2 border-[#8c5a2b] bg-[#efe0c2] p-3.5 shadow-inner"
        >
          <div class="mb-1.5 flex items-center justify-between border-b border-[#b59264] pb-1">
            <span class="font-mono text-[10px] font-black uppercase tracking-wider text-[#5c3a1b]">
              📜 ACTA DIURNA · COLOSSEUM COMBAT CHRONICLE
            </span>
            <span class="font-mono text-[10px] font-bold text-[#991b1b]">LIVE SAND TELEMETRY</span>
          </div>
          <div
            id="battle-combat-log"
            class="max-h-32 space-y-1.5 overflow-y-auto font-mono text-xs leading-relaxed text-[#3b1d0a]"
          >
            <div>
              📯 <strong>Legatus Arbiter:</strong> "Gladiators! Salute the Emperor and draw your weapons!"
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================================================================== -->
