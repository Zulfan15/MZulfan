---
import '../styles/global.css';
import '../styles/critters.css';
import Hud from '../components/Hud.astro';
import TownCanvas from '../components/TownCanvas.astro';
import MapModal from '../components/MapModal.astro';
import WelcomeModal from '../components/WelcomeModal.astro';
import CritterdexModal from '../components/CritterdexModal.astro';
import EncounterModal from '../components/EncounterModal.astro';
import FridgeModal from '../components/FridgeModal.astro';
import DeskModal from '../components/DeskModal.astro';
import CommandPalette from '../components/CommandPalette.astro';
import PartnerModal from '../components/PartnerModal.astro';
import { profile } from '../lib/profile';

interface Props {
  title?: string;
  description?: string;
  place?: string;
}

const {
  title = `${profile.person.name} — ${profile.person.title}`,
  description = profile.person.tagline,
  place = 'town',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-place={place === 'about' ? 'home' : place} data-room={place === 'about' ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#8bd16a" />

    <!-- Google Fonts for retro/pixel aesthetic and clean typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&family=Monoton&family=Pixelify+Sans:wght@500;600;700&family=Press+Start+2P&family=VT323&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-ink font-sans text-ink">
    <div class="shell">
      <Hud />

      <div class="stage">
        <!-- Interactive 2D Pixel Town -->
        <TownCanvas currentPlace={place} />

        <!-- Reading Panel matching si-dan.com -->
        <main id="content" class="panel" tabindex="-1" aria-labelledby="panel-title">
          <button
            class="panel__tab"
            type="button"
            data-panel-tab=""
            data-name={place === 'town' ? 'Town Square' : place === 'about' ? 'Home' : place === 'dev' ? 'Dev Center' : place === 'lab' ? 'Research Lab' : place === 'arcade' ? 'Arcade' : place === 'reception' ? 'Poké Center' : place === 'mart' ? 'Poké Mart' : place === 'tower' ? 'Tech Tower' : place}
            aria-expanded="true"
            title="Tutup / Sembunyikan Panel Bacaan (Layar Penuh Kanvas)"
            aria-label={`Toggle the ${place === 'town' ? 'Town Square' : place === 'about' ? 'Home' : place === 'reception' ? 'Poké Center' : place === 'mart' ? 'Poké Mart' : place === 'tower' ? 'Tech Tower' : place} reading panel`}
          >
            <span class="panel__tab-arrow" aria-hidden="true">◀</span>
            <span aria-hidden="true">{place === 'dev' ? '💻' : place === 'lab' ? '🔬' : place === 'arcade' ? '🕹️' : place === 'about' ? '🏠' : place === 'reception' ? '🏥' : place === 'mart' ? '🏪' : place === 'tower' ? '🏢' : '🏡'}</span>
          </button>

          <div class="panel__bar">
            {place !== 'town' && (
              <a class="btn btn--small panel__back" href="/" onclick="sessionStorage.setItem('town:respawn', '22,28')" aria-label="Back to the town map">← Town</a>
            )}
            <span class="panel__where pixel" aria-hidden="true">
              {place === 'dev' ? '💻 Dev Center' : place === 'lab' ? '🔬 Research Lab' : place === 'arcade' ? '🕹️ Arcade' : place === 'about' ? '🏠 Home' : place === 'reception' ? '🏥 Poké Center' : place === 'mart' ? '🏪 Poké Mart' : place === 'tower' ? '🏢 Tech Tower' : '🏡 Town Square'}
            </span>
            {place === 'about' ? (
              <span class="panel__floor pixel cursor-pointer hover:opacity-80 transition-opacity" data-floor-chip="" role="button" tabindex="0" title="Click to switch floor (1F/2F)" aria-label="Switch Floor">2F</span>
            ) : (
              <span class="panel__floor pixel" data-floor-chip="" aria-hidden="true" hidden=""></span>
            )}

            <!-- Panel Layout Presets Switcher (70:30 Kanvas, 50:50 Seimbang, 85:15 Reader Mode) -->
            <div class="panel__layout-presets flex items-center gap-1 ml-auto" role="group" aria-label="Pilihan Ukuran Panel Bacaan">
              <span class="text-[9px] font-mono text-ink-soft hidden xl:inline select-none">Tampilan:</span>
              <button
                type="button"
                class="panel__preset-btn btn btn-xs btn-ghost p-1 text-[11px]"
                data-panel-mode="canvas"
                title="Fokus Kanvas (Peta 70% : Panel 30%)"
                aria-label="Fokus Kanvas (Peta 70% : Panel 30%)"
              >
                🎮 <span class="hidden sm:inline text-[9px] font-pixel">Peta</span>
              </button>
              <button
                type="button"
                class="panel__preset-btn btn btn-xs btn-ghost p-1 text-[11px] is-active"
                data-panel-mode="split"
                title="Tampilan Seimbang (Peta 50% : Panel 50%)"
                aria-label="Tampilan Seimbang (Peta 50% : Panel 50%)"
              >
                ⚖️ <span class="hidden sm:inline text-[9px] font-pixel">50:50</span>
              </button>
              <button
                type="button"
                class="panel__preset-btn btn btn-xs btn-ghost p-1 text-[11px]"
                data-panel-mode="reader"
                title="Fokus Baca (Mode Reader / Lebar Penuh)"
                aria-label="Fokus Baca (Mode Reader / Lebar Penuh)"
              >
                📖 <span class="hidden sm:inline text-[9px] font-pixel">Baca</span>
              </button>
            </div>
          </div>

          <div class="panel__body">
            <slot />
          </div>

          <footer class="panel__footer muted">
            <span>Built by Muhammad Zulfan with Astro, Rust/WASM, and Cloudflare.</span>
            <span class="panel__links">
              <a href="/dev#how-its-built">How this site works</a>
              <a href="/privacy">Privacy</a>
            </span>
          </footer>
        </main>
      </div>
    </div>

    <!-- Modals -->
    <WelcomeModal />
    <MapModal />
    <CritterdexModal />
    <EncounterModal />
    <FridgeModal />
    <DeskModal />
    <CommandPalette />
    <PartnerModal />

    <script>
      function initPanelTab() {
        const tab = document.querySelector<HTMLButtonElement>('[data-panel-tab]');
        const panel = document.querySelector<HTMLElement>('.panel');
        const stage = document.querySelector<HTMLElement>('.stage');
        if (!tab || !panel || !stage) return;

        // Clone node to safely prevent duplicate listeners on Astro page transitions
        const newTab = tab.cloneNode(true) as HTMLButtonElement;
        tab.parentNode?.replaceChild(newTab, tab);

        newTab.addEventListener('click', () => {
          const isClosed = panel.hasAttribute('data-closed');
          if (isClosed) {
            // Buka kembali panel bacaan
            panel.removeAttribute('data-closed');
            stage.classList.remove('is-panel-closed');
            newTab.setAttribute('aria-expanded', 'true');
            newTab.setAttribute('title', 'Tutup / Sembunyikan Panel Bacaan (Layar Penuh Kanvas)');
          } else {
            // Tutup / sembunyikan panel agar kanvas kota full screen
            panel.setAttribute('data-closed', '');
            stage.classList.add('is-panel-closed');
            newTab.setAttribute('aria-expanded', 'false');
            newTab.setAttribute('title', 'Buka Panel Bacaan Konten');
          }

          // Trigger resize event agar TownEngine menyesuaikan canvas pixel size dengan lebar baru
          window.dispatchEvent(new Event('resize'));
          window.setTimeout(() => window.dispatchEvent(new Event('resize')), 150);
          window.setTimeout(() => window.dispatchEvent(new Event('resize')), 320);
        });
      }

      function initPanelLayout() {
        const stage = document.querySelector<HTMLElement>('.stage');
        const presetButtons = document.querySelectorAll<HTMLButtonElement>('[data-panel-mode]');
        if (!stage) return;

        const applyLayoutMode = (mode: string) => {
          let panelWidth = '50vw';
          if (mode === 'canvas') {
            panelWidth = '32vw';
          } else if (mode === 'reader') {
            panelWidth = '85vw';
          } else {
            panelWidth = '50vw';
            mode = 'split';
          }

          document.documentElement.style.setProperty('--panel-w', panelWidth);
          stage.setAttribute('data-panel-layout', mode);
          try {
            localStorage.setItem('town:panel_layout', mode);
          } catch {}

          presetButtons.forEach((btn) => {
            const btnMode = btn.getAttribute('data-panel-mode');
            btn.classList.toggle('is-active', btnMode === mode);
          });

          // Trigger resize for TownEngine smoothly
          window.dispatchEvent(new Event('resize'));
          setTimeout(() => window.dispatchEvent(new Event('resize')), 150);
          setTimeout(() => window.dispatchEvent(new Event('resize')), 300);
        };

        const savedMode = (typeof localStorage !== 'undefined' ? localStorage.getItem('town:panel_layout') : null) || 'split';
        applyLayoutMode(savedMode);

        presetButtons.forEach((btn) => {
          btn.addEventListener('click', () => {
            const mode = btn.getAttribute('data-panel-mode') || 'split';
            applyLayoutMode(mode);
          });
        });
      }

      function initLayoutAll() {
        initPanelTab();
        initPanelLayout();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initLayoutAll);
      } else {
        initLayoutAll();
      }
      document.addEventListener('astro:page-load', initLayoutAll);
    </script>
  </body>
</html>
