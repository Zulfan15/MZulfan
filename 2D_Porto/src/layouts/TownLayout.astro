---
import '../styles/global.css';
import Hud from '../components/Hud.astro';
import TownCanvas from '../components/TownCanvas.astro';
import MapModal from '../components/MapModal.astro';
import WelcomeModal from '../components/WelcomeModal.astro';
import CritterdexModal from '../components/CritterdexModal.astro';
import EncounterModal from '../components/EncounterModal.astro';
import { profile } from '../lib/profile';

interface Props {
  title?: string;
  description?: string;
  place?: string;
}

const {
  title = `${profile.person.name} — ${profile.person.title}`,
  description = profile.person.tagline,
  place = 'town',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-place={place === 'about' ? 'home' : place} data-room={place === 'about' ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#8bd16a" />

    <!-- Google Fonts for retro/pixel aesthetic and clean typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&family=Monoton&family=Pixelify+Sans:wght@500;600;700&family=Press+Start+2P&family=VT323&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-ink font-sans text-ink">
    <div class="shell">
      <Hud />

      <div class="stage">
        <!-- Interactive 2D Pixel Town -->
        <TownCanvas currentPlace={place} />

        <!-- Reading Panel matching si-dan.com -->
        <main id="content" class="panel" tabindex="-1" aria-labelledby="panel-title">
          <button
            class="panel__tab"
            type="button"
            data-panel-tab=""
            data-name={place === 'town' ? 'Town Square' : place === 'about' ? 'Home' : place === 'dev' ? 'Dev Center' : place === 'lab' ? 'Research Lab' : place === 'arcade' ? 'Arcade' : place}
            aria-expanded="false"
            aria-label={`Open the ${place === 'town' ? 'Town Square' : place === 'about' ? 'Home' : place} panel`}
          >
            <span class="panel__tab-arrow" aria-hidden="true">◀</span>
            <span aria-hidden="true">{place === 'dev' ? '💻' : place === 'lab' ? '🔬' : place === 'arcade' ? '🕹️' : place === 'about' ? '🏠' : '🏡'}</span>
          </button>

          <div class="panel__bar">
            {place !== 'town' && (
              <a class="btn btn--small panel__back" href="/" aria-label="Back to the town map">← Town</a>
            )}
            <span class="panel__where pixel" aria-hidden="true">
              {place === 'dev' ? '💻 Dev Center' : place === 'lab' ? '🔬 Research Lab' : place === 'arcade' ? '🕹️ Arcade' : place === 'about' ? '🏠 Home' : '🏡 Town Square'}
            </span>
            {place === 'about' ? (
              <span class="panel__floor pixel cursor-pointer hover:opacity-80 transition-opacity" data-floor-chip="" role="button" tabindex="0" title="Click to switch floor (1F/2F)" aria-label="Switch Floor">2F</span>
            ) : (
              <span class="panel__floor pixel" data-floor-chip="" aria-hidden="true" hidden=""></span>
            )}
          </div>

          <div class="panel__body">
            <slot />
          </div>

          <footer class="panel__footer muted">
            <span>Built by Muhammad Zulfan with Astro, Rust/WASM, and Cloudflare.</span>
            <span class="panel__links">
              <a href="/dev#how-its-built">How this site works</a>
              <a href="/privacy">Privacy</a>
            </span>
          </footer>
        </main>
      </div>
    </div>

    <!-- Modals -->
    <WelcomeModal />
    <MapModal />
    <CritterdexModal />
    <EncounterModal />

    <script>
      function initPanelTab() {
        const tab = document.querySelector('[data-panel-tab]');
        const panel = document.querySelector('.panel');
        if (tab && panel) {
          tab.addEventListener('click', () => {
            const isOpen = panel.hasAttribute('data-open');
            if (isOpen) {
              panel.removeAttribute('data-open');
              tab.setAttribute('aria-expanded', 'false');
            } else {
              panel.setAttribute('data-open', '');
              tab.setAttribute('aria-expanded', 'true');
            }
          });
        }
      }
      document.addEventListener('DOMContentLoaded', initPanelTab);
    </script>
  </body>
</html>
