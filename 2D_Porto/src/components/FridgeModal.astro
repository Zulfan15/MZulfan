---
// FridgeModal.astro - Retro Refrigerator Visitor Notes Modal
---

<dialog class="fridge" data-fridge="" aria-labelledby="fridge-title">
  <div class="fridge__door">
    <span class="fridge__handle" aria-hidden="true"></span>
    <div class="fridge__top">
      <h2 id="fridge-title" class="fridge__title">The fridge</h2>
      <button class="fridge__btn" type="button" data-fridge-close="" aria-label="Close the fridge">✕</button>
    </div>

    <!-- Pinned Visitor Notes -->
    <ul class="fridge__notes" data-fridge-notes="" aria-label="Notes pinned by visitors">
      <li class="note note--hi" style="--tilt: -2deg;">
        <span class="magnet" aria-hidden="true"></span>
        <p>Hope you have a good day!</p>
        <p class="note__meta">— a visitor · 👋 hi</p>
      </li>
      <li class="note note--hi" style="--tilt: 0deg;">
        <span class="magnet" aria-hidden="true"></span>
        <p>Hello I'm Prathana</p>
        <p class="note__meta">— Prathana · 👋 hi</p>
      </li>
      <li class="note note--collab" style="--tilt: 1.5deg;">
        <span class="magnet" aria-hidden="true"></span>
        <p>Awesome UAV computer vision demo! Would love to connect regarding AI research.</p>
        <p class="note__meta">— Dev Guest · 🤝 collab</p>
      </li>
    </ul>

    <!-- Leave a Note Form -->
    <form class="fridge__form note note--new" data-fridge-form="">
      <span class="magnet" aria-hidden="true"></span>
      <label class="visually-hidden" for="fridge-message">Your note</label>
      <textarea
        id="fridge-message"
        name="message"
        rows="4"
        maxlength="600"
        required=""
        placeholder="Leave Zulfan a note: say hi, pitch a collab, or tell him about a role…"
      ></textarea>

      <div class="fridge__row">
        <label>
          Name
          <input name="name" maxlength="40" autocomplete="name" placeholder="optional" />
        </label>
        <label>
          Reply to
          <input name="contact" maxlength="120" autocomplete="email" placeholder="email or link, optional" />
        </label>
      </div>

      <!-- Honeypot: hidden from people, irresistible to bots. -->
      <label class="hp" aria-hidden="true">
        Website <input name="website" tabindex="-1" autocomplete="off" />
      </label>

      <div data-fridge-turnstile=""></div>

      <div class="fridge__row fridge__row--end">
        <p class="fridge__status" data-fridge-status="" role="status" aria-live="polite"></p>
        <button class="fridge__btn fridge__btn--pin" type="submit" data-fridge-send="">📌 Pin it</button>
      </div>
    </form>

    <p class="fridge__fine">
      Notes are reviewed and pinned to the fridge door. Your reply-to details are only shown to Zulfan.
    </p>
  </div>
</dialog>

<style>
  .fridge {
    --ink: #2b1d14;
    inset: var(--header-h, 56px) var(--panel-w, 50vw) 0 0;
    width: min(calc((100vw - var(--panel-w, 50vw)) * .92), 640px);
    max-height: calc(100dvh - var(--header-h, 56px) - 24px);
    font: 11px / 1.6 var(--font-retro, "Press Start 2P", monospace);
    color: var(--ink);
    background: transparent;
    border: 0;
    margin: auto;
    padding: 0;
    position: fixed;
    overflow: auto;
    z-index: 100;
  }
  .fridge::backdrop {
    background: #140c068c;
    backdrop-filter: blur(2px);
  }
  .fridge__door {
    border: 4px solid var(--ink);
    box-shadow: inset 6px 0 0 #d4f0e8, inset -6px -6px 0 #7fb8ab, 0 10px 0 var(--ink);
    background: #9fd3c7;
    border-radius: 16px;
    padding: 16px 44px 16px 16px;
    position: relative;
  }
  .fridge__handle {
    border: 3px solid var(--ink);
    background: #c0c6cc;
    border-radius: 6px;
    width: 10px;
    height: 120px;
    position: absolute;
    top: 24px;
    right: 14px;
    box-shadow: inset 2px 0 0 #ffffffaa, inset -2px 0 0 #88889988;
  }
  .fridge__top {
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    display: flex;
  }
  .fridge__title {
    font: inherit;
    margin: 0;
    font-size: 14px;
    color: var(--ink);
    letter-spacing: 0.05em;
  }
  .fridge__notes {
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 14px;
    max-height: 40vh;
    margin: 0 0 16px;
    padding: 10px 4px;
    list-style: none;
    display: grid;
    overflow-y: auto;
  }
  .fridge__notes::-webkit-scrollbar {
    width: 6px;
  }
  .fridge__notes::-webkit-scrollbar-thumb {
    background: var(--ink);
    border-radius: 3px;
  }
  .note {
    --paper: #fff6b8;
    background: var(--paper);
    border: 2px solid var(--ink);
    box-shadow: 3px 3px 0 var(--ink);
    transform: rotate(var(--tilt, 0deg));
    overflow-wrap: anywhere;
    white-space: pre-wrap;
    padding: 14px 10px 8px;
    position: relative;
    font-family: var(--font-retro, "Press Start 2P", monospace);
    font-size: 10px;
    line-height: 1.45;
  }
  .note p {
    margin: 0;
  }
  .note--collab { --paper: #cfe8ff; }
  .note--hi { --paper: #ffd1dc; }
  .note--unsorted { --paper: #f8f8f0; }
  .note p.note__meta {
    opacity: .75;
    margin-top: 6px;
    font-size: 9px;
  }
  .magnet {
    border: 2px solid var(--ink);
    background: #c8322b;
    border-radius: 50%;
    width: 14px;
    height: 14px;
    margin-left: -7px;
    position: absolute;
    top: -7px;
    left: 50%;
    box-shadow: 1px 1px 0 rgba(0, 0, 0, 0.25);
  }
  .note:nth-child(3n+2) .magnet { background: #e0b040; }
  .note:nth-child(3n) .magnet { background: #2f6db5; }

  .note--new {
    --paper: #fffbe0;
    white-space: normal;
    gap: 8px;
    display: grid;
    transform: none;
    padding: 14px 12px 10px;
  }
  .fridge__form textarea,
  .fridge__form input {
    width: 100%;
    min-height: 36px;
    font: inherit;
    font-size: 10px;
    color: var(--ink);
    resize: vertical;
    background: rgba(255, 255, 255, 0.7);
    border: 2px dashed #b8a989;
    border-radius: 4px;
    padding: 6px 8px;
    box-sizing: border-box;
  }
  .fridge__form textarea:focus-visible,
  .fridge__form input:focus-visible {
    outline: 3px solid var(--sun, #ffd166);
    border-style: solid;
    background: #ffffff;
  }
  .fridge__row {
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    display: grid;
  }
  .fridge__row label {
    gap: 4px;
    display: grid;
    font-size: 9px;
    text-transform: uppercase;
  }
  .fridge__row--end {
    grid-template-columns: 1fr auto;
    align-items: center;
    margin-top: 4px;
  }
  .fridge__status {
    margin: 0;
    font-size: 9px;
  }
  .fridge__status--error {
    color: #a8231c;
  }
  .fridge__status--success {
    color: #1a6f43;
  }
  .fridge__btn {
    min-width: 36px;
    min-height: 36px;
    font: inherit;
    font-size: 10px;
    color: var(--ink);
    border: 3px solid var(--ink);
    cursor: pointer;
    background: #f8f8f0;
    border-radius: 6px;
    padding: 8px 12px;
    box-shadow: 2px 2px 0 var(--ink);
    transition: transform 0.05s, background-color 0.1s;
  }
  .fridge__btn:hover {
    background: var(--sun, #ffd166);
  }
  .fridge__btn:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0 var(--ink);
  }
  .fridge__btn:disabled {
    opacity: .6;
    cursor: wait;
  }
  .fridge__fine {
    opacity: .8;
    margin: 12px 0 0;
    font-size: 9px;
    line-height: 1.5;
  }
  .hp {
    display: none !important;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  @media (max-width: 899px) {
    .fridge {
      inset: var(--header-h, 56px) 0 0 0;
      width: min(100vw - 24px, 640px);
    }
  }
  @media (max-width: 480px) {
    .fridge__door {
      padding-right: 16px;
    }
    .fridge__handle {
      display: none;
    }
    .fridge__row {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .note {
      transform: none !important;
    }
  }
</style>

<script>
  function initFridge() {
    const dialog = document.querySelector<HTMLDialogElement>('[data-fridge]');
    if (!dialog || dialog.dataset.ready === '1') return;
    dialog.dataset.ready = '1';

    const form = dialog.querySelector<HTMLFormElement>('[data-fridge-form]');
    const notesList = dialog.querySelector<HTMLUListElement>('[data-fridge-notes]');
    const statusEl = dialog.querySelector<HTMLElement>('[data-fridge-status]');
    const sendBtn = dialog.querySelector<HTMLButtonElement>('[data-fridge-send]');
    const closeBtn = dialog.querySelector<HTMLButtonElement>('[data-fridge-close]');

    // Storage key for local visitors
    const STORAGE_KEY = 'zulfan_town_fridge_notes';

    // Load initial notes from local storage if available
    function loadSavedNotes() {
      try {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (saved && notesList) {
          const notes = JSON.parse(saved);
          if (Array.isArray(notes)) {
            notes.forEach((n, idx) => {
              addNoteToDOM(n.message, n.name, n.topic || 'hi', (idx * 7) % 5 - 2);
            });
          }
        }
      } catch {}
    }

    function addNoteToDOM(message: string, name: string, topic: string, tilt: number) {
      if (!notesList) return;
      const li = document.createElement('li');
      li.className = `note note--${topic}`;
      li.style.setProperty('--tilt', `${tilt}deg`);

      const magnet = document.createElement('span');
      magnet.className = 'magnet';
      magnet.setAttribute('aria-hidden', 'true');

      const pMsg = document.createElement('p');
      pMsg.textContent = message;

      const pMeta = document.createElement('p');
      pMeta.className = 'note__meta';
      const author = name.trim() ? name.trim() : 'a visitor';
      const icon = topic === 'collab' ? '🤝 collab' : '👋 hi';
      pMeta.textContent = `— ${author} · ${icon}`;

      li.append(magnet, pMsg, pMeta);
      notesList.appendChild(li);
    }

    loadSavedNotes();

    const d = dialog;

    // Open fridge
    function openFridge() {
      if (d && !d.open) {
        d.showModal();
        if (statusEl) statusEl.textContent = '';
      }
    }

    // Close handlers
    closeBtn?.addEventListener('click', () => d?.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    // Global listener for town:fridge event
    document.addEventListener('town:fridge', () => {
      openFridge();
    });

    // Also support any element with [data-fridge-trigger]
    document.querySelectorAll('[data-fridge-trigger]').forEach((trigger) => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        openFridge();
      });
    });

    // Form submission
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const honeypot = String(fd.get('website') ?? '').trim();
      if (honeypot) return; // bot detected

      const message = String(fd.get('message') ?? '').trim();
      const name = String(fd.get('name') ?? '').trim();
      const contact = String(fd.get('contact') ?? '').trim();

      if (!message) return;

      if (sendBtn) sendBtn.disabled = true;
      if (statusEl) {
        statusEl.className = 'fridge__status';
        statusEl.textContent = 'Pinning…';
      }

      setTimeout(() => {
        // Detect topic
        const lower = (message + ' ' + contact).toLowerCase();
        const topic = lower.includes('collab') || lower.includes('job') || lower.includes('hire') || lower.includes('role') ? 'collab' : 'hi';
        const tilt = Math.floor(Math.random() * 5) - 2;

        addNoteToDOM(message, name, topic, tilt);

        // Save to localStorage
        try {
          const prev = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
          prev.push({ message, name, contact, topic, timestamp: Date.now() });
          localStorage.setItem(STORAGE_KEY, JSON.stringify(prev));
        } catch {}

        form.reset();
        if (sendBtn) sendBtn.disabled = false;
        if (statusEl) {
          statusEl.className = 'fridge__status fridge__status--success';
          statusEl.textContent = '📌 Pinned! Thanks for stopping by!';
        }
      }, 400);
    });
  }

  // Init on DOM ready and Astro page load
  document.addEventListener('DOMContentLoaded', initFridge);
  document.addEventListener('astro:page-load', initFridge);
</script>
