---

<dialog class="mc mc--lab" data-lab-dialog="bench" aria-labelledby="lab-bench-title">
  <div class="mc__bar">
    <h2 id="lab-bench-title" class="mc__title">Lab bench</h2>
    <button type="button" class="mc__close" data-mc-close aria-label="Close the lab bench">✕</button>
  </div>
  <div class="mc__body">
    <ul class="clean bench-list">
      <li>
        <ul class="stack-chips">
          <li class="stack-chip" style="--brand: #76B900">
            <span class="stack-chip__name">TensorRT FP16 Quantization</span>
          </li>
        </ul>
        <p class="bench-list__uses">
          Used in <a href="#p-aeroscan" data-poster-link="p-aeroscan">AeroScan: Tactical Edge AI & Aerial Surveillance</a>
        </p>
      </li>

      <li>
        <ul class="stack-chips">
          <li class="stack-chip" style="--brand: #00FFFF">
            <span class="stack-chip__name">YOLOv11x Object Detection</span>
          </li>
        </ul>
        <p class="bench-list__uses">
          Used in <a href="#p-aeroscan" data-poster-link="p-aeroscan">AeroScan: Tactical Edge AI & Aerial Surveillance</a>
        </p>
      </li>

      <li>
        <ul class="stack-chips">
          <li class="stack-chip" style="--brand: #3776AB">
            <span class="stack-chip__name">Indonesian Slang Lexical Expansion</span>
          </li>
        </ul>
        <p class="bench-list__uses">
          Used in <a href="#p-spam-classifier" data-poster-link="p-spam-classifier">SMS & WhatsApp Spam Detection with Indonesian Slang Normalization</a>
        </p>
      </li>

      <li>
        <ul class="stack-chips">
          <li class="stack-chip" style="--brand: #F7931E">
            <span class="stack-chip__name">Multinomial Naive Bayes</span>
          </li>
        </ul>
        <p class="bench-list__uses">
          Used in <a href="#p-spam-classifier" data-poster-link="p-spam-classifier">SMS & WhatsApp Spam Detection with Indonesian Slang Normalization</a>
        </p>
      </li>

      <li>
        <ul class="stack-chips">
          <li class="stack-chip" style="--brand: #5C3EE8">
            <span class="stack-chip__name">4-Point Adaptive Perspective Transform</span>
          </li>
        </ul>
        <p class="bench-list__uses">
          Used in <a href="#p-omr-grader" data-poster-link="p-omr-grader">Automated OMR Answer Sheet Grader</a>
        </p>
      </li>

      <li>
        <ul class="stack-chips">
          <li class="stack-chip" style="--brand: #5C3EE8">
            <span class="stack-chip__name">Bubble Contour Morphological Masking</span>
          </li>
        </ul>
        <p class="bench-list__uses">
          Used in <a href="#p-omr-grader" data-poster-link="p-omr-grader">Automated OMR Answer Sheet Grader</a>
        </p>
      </li>

      <li>
        <ul class="stack-chips">
          <li class="stack-chip" style="--brand: #FF6F00">
            <span class="stack-chip__name">Transfer Learning & Bottleneck Fine-Tuning</span>
          </li>
        </ul>
        <p class="bench-list__uses">
          Used in <a href="#p-trash-classification" data-poster-link="p-trash-classification">Trash Classification with InceptionV3</a>
        </p>
      </li>

      <li>
        <ul class="stack-chips">
          <li class="stack-chip" style="--brand: #009688">
            <span class="stack-chip__name">FastAPI Real-Time Streaming</span>
          </li>
        </ul>
        <p class="bench-list__uses">
          Used in <a href="#p-aeroscan" data-poster-link="p-aeroscan">AeroScan: Tactical Edge AI & Aerial Surveillance</a> and <a href="#p-spam-classifier" data-poster-link="p-spam-classifier">SMS & WhatsApp Spam Detection</a>
        </p>
      </li>

      <li>
        <ul class="stack-chips">
          <li class="stack-chip" style="--brand: #FF4B4B">
            <span class="stack-chip__name">Streamlit Diagnostic Tooling</span>
          </li>
        </ul>
        <p class="bench-list__uses">
          Used in <a href="#p-spam-classifier" data-poster-link="p-spam-classifier">SMS & WhatsApp Spam Detection with Indonesian Slang Normalization</a>
        </p>
      </li>

      <li>
        <ul class="stack-chips">
          <li class="stack-chip" style="--brand: #2496ED">
            <span class="stack-chip__name">Docker Multi-Arch Containerization</span>
          </li>
        </ul>
        <p class="bench-list__uses">
          Used in <a href="#p-aeroscan" data-poster-link="p-aeroscan">AeroScan: Tactical Edge AI & Aerial Surveillance</a>
        </p>
      </li>
    </ul>
  </div>
</dialog>
