---
// Telemetry Modal matching si-dan.com/dev — Muhammad Zulfan
---

<dialog class="mc" data-mc-dialog="telemetry" aria-labelledby="mc-telemetry-title">
  <div class="mc__bar">
    <h2 id="mc-telemetry-title" class="mc__title">Telemetry</h2>
    <button type="button" class="mc__close" data-mc-close aria-label="Close the telemetry">✕</button>
  </div>
  <div class="mc__body">
    <div class="readouts">
      <div class="readout">
        <p class="readout__label">GitHub streak</p>
        <p class="readout__value" data-streak>18</p>
        <p class="readout__unit">days in a row</p>
      </div>
      <div class="readout">
        <p class="readout__label">Contributions</p>
        <p class="readout__value" data-contribs>1,420</p>
        <p class="readout__unit">in the last year</p>
      </div>
    </div>
    <h3 class="brief__label" style="margin-top: 1.2rem;">Algorithm & Problem Solving</h3>
    <div class="dials" data-dials>
      <figure class="dial dial--easy" data-dial="easy" style="--v: 84">
        <svg viewBox="0 0 100 60" aria-hidden="true">
          <path class="dial__track" d="M10 55 A40 40 0 0 1 90 55" pathLength="100"></path>
          <path class="dial__fill" d="M10 55 A40 40 0 0 1 90 55" pathLength="100"></path>
        </svg>
        <figcaption>
          <span class="dial__value" data-dial-value>92</span>
          <span class="dial__name">easy</span>
        </figcaption>
      </figure>
      <figure class="dial dial--medium" data-dial="medium" style="--v: 53">
        <svg viewBox="0 0 100 60" aria-hidden="true">
          <path class="dial__track" d="M10 55 A40 40 0 0 1 90 55" pathLength="100"></path>
          <path class="dial__fill" d="M10 55 A40 40 0 0 1 90 55" pathLength="100"></path>
        </svg>
        <figcaption>
          <span class="dial__value" data-dial-value>64</span>
          <span class="dial__name">medium</span>
        </figcaption>
      </figure>
      <figure class="dial dial--hard" data-dial="hard" style="--v: 27">
        <svg viewBox="0 0 100 60" aria-hidden="true">
          <path class="dial__track" d="M10 55 A40 40 0 0 1 90 55" pathLength="100"></path>
          <path class="dial__fill" d="M10 55 A40 40 0 0 1 90 55" pathLength="100"></path>
        </svg>
        <figcaption>
          <span class="dial__value" data-dial-value>16</span>
          <span class="dial__name">hard</span>
        </figcaption>
      </figure>
    </div>
    <p class="readout__unit" data-lc-total style="margin-top: 0.5rem; color: var(--mc-dim);">172 solved across algorithms, data structures, and computer science competitions.</p>

    <section class="gh-term" data-github aria-labelledby="gh-title" style="margin-top: 1.4rem;">
      <div class="gh-term__head">
        <h3 id="gh-title" class="brief__label">GitHub Activity · @Zulfan15</h3>
        <span class="gh-term__updated" data-updated>Live Telemetry</span>
      </div>
      <div class="gh-graph-wrap" style="margin-top: 0.6rem;">
        <div class="gh-graph" style="grid-template-columns: repeat(16, 1fr); gap: 4px;">
          <!-- 16 columns of contribution cells -->
          <span class="gh-cell l3"></span><span class="gh-cell "></span><span class="gh-cell l2"></span><span class="gh-cell l4"></span><span class="gh-cell l1"></span><span class="gh-cell l3"></span><span class="gh-cell "></span><span class="gh-cell l2"></span><span class="gh-cell l4"></span><span class="gh-cell l1"></span><span class="gh-cell l3"></span><span class="gh-cell "></span><span class="gh-cell l2"></span><span class="gh-cell l4"></span><span class="gh-cell l1"></span><span class="gh-cell l3"></span><span class="gh-cell "></span><span class="gh-cell l2"></span><span class="gh-cell l4"></span><span class="gh-cell l1"></span><span class="gh-cell l3"></span><span class="gh-cell "></span><span class="gh-cell l2"></span><span class="gh-cell l4"></span><span class="gh-cell l1"></span><span class="gh-cell l3"></span><span class="gh-cell "></span><span class="gh-cell l2"></span><span class="gh-cell l4"></span><span class="gh-cell l1"></span><span class="gh-cell l3"></span><span class="gh-cell "></span><span class="gh-cell l2"></span><span class="gh-cell l4"></span><span class="gh-cell l1"></span><span class="gh-cell l3"></span><span class="gh-cell "></span><span class="gh-cell l2"></span><span class="gh-cell l4"></span><span class="gh-cell l1"></span><span class="gh-cell l3"></span><span class="gh-cell "></span><span class="gh-cell l2"></span><span class="gh-cell l4"></span><span class="gh-cell l1"></span><span class="gh-cell l3"></span><span class="gh-cell "></span><span class="gh-cell l2"></span><span class="gh-cell l4"></span><span class="gh-cell l1"></span><span class="gh-cell l3"></span><span class="gh-cell "></span><span class="gh-cell l2"></span><span class="gh-cell l4"></span><span class="gh-cell l1"></span><span class="gh-cell l3"></span><span class="gh-cell "></span><span class="gh-cell l2"></span><span class="gh-cell l4"></span><span class="gh-cell l1"></span><span class="gh-cell l3"></span><span class="gh-cell "></span><span class="gh-cell l2"></span>