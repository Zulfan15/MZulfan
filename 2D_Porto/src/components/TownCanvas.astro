      let isMinimized = false;

      let lastPickerSignature = '';
      const refreshObjectPicker = () => {
        if (!townObjectPicker) return;
        const buildings = townConfig.getBuildings();
        const signature = buildings.map((b) => `${b.id}:${b.x},${b.y}`).join('|');
        const selected = editor.getSelectedBuilding();

        if (signature !== lastPickerSignature) {
          lastPickerSignature = signature;
          townObjectPicker.innerHTML = '';

          const defaultOption = document.createElement('option');
          defaultOption.value = '';
          defaultOption.textContent = '🎯 Pilih Gedung / Objek...';
          townObjectPicker.appendChild(defaultOption);

          const groups: { label: string; items: typeof buildings }[] = [
            { label: '── 🏢 Gedung-Gedung ──', items: buildings.filter((b) => b.kind === 'building') },
            { label: '── 🌳 Pepohonan & Bunga ──', items: buildings.filter((b) => b.kind === 'tree' || b.kind === 'flowerbed') },
            { label: '── 🌿 Semak & Pagar Hias ──', items: buildings.filter((b) => b.kind === 'bush') },
            { label: '── 💡 Lampu-Lampu Jalan ──', items: buildings.filter((b) => b.kind === 'lamp') },
            { label: '── 🪑 Bangku-Bangku Taman ──', items: buildings.filter((b) => b.kind === 'bench') },
            { label: '── ⛲ Objek & Fasilitas Luar ──', items: buildings.filter((b) => b.kind === 'object') },
          ];

          for (const grp of groups) {
            if (grp.items.length === 0) continue;
            const optgroup = document.createElement('optgroup');
            optgroup.label = grp.label;
            for (const b of grp.items) {
              const opt = document.createElement('option');
              opt.value = b.id;
              let icon = '📦';
              if (b.kind === 'building') icon = '🏢';
              else if (b.kind === 'tree') icon = b.subType === 'tree_sakura' ? '🌸' : '🌳';
              else if (b.kind === 'bush') icon = '🌿';
              else if (b.kind === 'flowerbed') icon = '🌺';
              else if (b.kind === 'lamp') icon = '💡';
              else if (b.kind === 'bench') icon = '🪑';
              else if (b.id === 'fountain') icon = '⛲';
              else if (b.id === 'campfire' || b.subType === 'campfire') icon = '🔥';
              else if (b.id === 'vending' || b.subType === 'vending') icon = '🥤';
              else if (b.id === 'statue' || b.subType === 'statue') icon = '🗿';
              else if (b.id === 'camp' || b.subType === 'tent') icon = '⛺';
              else if (b.id === 'telescope' || b.subType === 'telescope') icon = '🔭';

              opt.textContent = `${icon} ${b.name} (${b.x}, ${b.y})`;
              optgroup.appendChild(opt);
            }
            townObjectPicker.appendChild(optgroup);
          }
        }

        townObjectPicker.value = selected ? selected.id : '';
      };

      // ==========================================
      // UPGRADED SPAWNER MODAL CATALOG & STAMP MODE
      // ==========================================
      const spawnSearch = document.getElementById('town-spawn-search') as HTMLInputElement | null;
      const spawnSearchClear = document.getElementById('town-spawn-search-clear');
      const spawnTabButtons = document.querySelectorAll<HTMLButtonElement>('.town-spawn-tab');

      let activeSpawnCategory = 'all';
      let spawnSearchQuery = '';
      let spawnThumbObserver: IntersectionObserver | null = null;

      const hydrateSpawnThumb = (iconEl: HTMLElement | null, digiSub: string, label: string) => {
        if (!iconEl || iconEl.dataset.digiHydrated === 'true') return;
        iconEl.dataset.digiHydrated = 'true';
        const applyDigiThumb = (dataUrl: string | null) => {
          if (!dataUrl) return;
          iconEl.innerHTML = `<img src="${dataUrl}" alt="${label}" style="width:24px;height:24px;image-rendering:pixelated;object-fit:contain;" />`;
        };
        const cachedDigi = requestDigimonSprites(digiSub, () => {
          const loaded = requestDigimonSprites(digiSub);
          if (loaded?.iconDataUrl) applyDigiThumb(loaded.iconDataUrl);
        });
        if (cachedDigi?.iconDataUrl) {
          applyDigiThumb(cachedDigi.iconDataUrl);
        }
      };

      const renderSpawnCatalog = () => {
        if (!spawnCatalog) return;
        if (spawnThumbObserver) {
          spawnThumbObserver.disconnect();
          spawnThumbObserver = null;
        }
        spawnCatalog.innerHTML = '';
        const spawnRoot = spawnCatalog.closest('.town-spawn-modal__body') || spawnCatalog;
        if (typeof IntersectionObserver !== 'undefined') {
          spawnThumbObserver = new IntersectionObserver(
            (entries) => {
              for (const ent of entries) {
                if (!ent.isIntersecting) continue;
                const el = ent.target as HTMLElement;
                const digiSub = el.getAttribute('data-digi-thumb');
                const digiName = el.getAttribute('data-digi-name') || 'Digimon';
                if (digiSub) hydrateSpawnThumb(el, digiSub, digiName);
                spawnThumbObserver?.unobserve(el);
              }
            },
            { root: spawnRoot, rootMargin: '80px' }
          );
        }

        const q = spawnSearchQuery.trim().toLowerCase();
        const matchesQuery = (t: (typeof SPAWNABLE_TEMPLATES)[0]) => {
          if (!q) return true;
          return (
            t.name.toLowerCase().includes(q) ||
            t.desc.toLowerCase().includes(q) ||
            (t.subType && t.subType.toLowerCase().includes(q)) ||
            t.category.toLowerCase().includes(q) ||
            (t.defaultDialogue && t.defaultDialogue.toLowerCase().includes(q))
          );
        };

        // Update counts
        const allMatching = SPAWNABLE_TEMPLATES.filter(matchesQuery);
        const countAll = document.getElementById('cat-count-all');
        const countAlam = document.getElementById('cat-count-alam');
        const countPerabot = document.getElementById('cat-count-perabot');
        const countPokemon = document.getElementById('cat-count-pokemon');
        const countDigimon = document.getElementById('cat-count-digimon');
        const countTech = document.getElementById('cat-count-tech');
        const countFasilitas = document.getElementById('cat-count-fasilitas');

        if (countAll) countAll.textContent = String(allMatching.length);
        if (countAlam) countAlam.textContent = String(allMatching.filter((t) => t.category === 'Foliage & Alam').length);
        if (countPerabot) countPerabot.textContent = String(allMatching.filter((t) => t.category === 'Perabot & Lampu').length);
        if (countPokemon) countPokemon.textContent = String(allMatching.filter((t) => t.category === 'Dunia Pokémon').length);
        if (countDigimon) countDigimon.textContent = String(allMatching.filter((t) => t.category === 'Dunia Digimon').length);
        if (countTech) countTech.textContent = String(allMatching.filter((t) => t.category === 'Tech & AI').length);
        if (countFasilitas) countFasilitas.textContent = String(allMatching.filter((t) => t.category === 'Fasilitas & Kota').length);

        const displayedCategories = activeSpawnCategory === 'all'
          ? (['Foliage & Alam', 'Perabot & Lampu', 'Dunia Pokémon', 'Dunia Digimon', 'Tech & AI', 'Fasilitas & Kota'] as const)
          : ([activeSpawnCategory] as const);

        let totalDisplayed = 0;

        for (const cat of displayedCategories) {
          const items = SPAWNABLE_TEMPLATES.filter((t) => t.category === cat && matchesQuery(t));
          if (items.length === 0) continue;

          totalDisplayed += items.length;

          const catSection = document.createElement('div');
          catSection.className = 'town-spawn-cat-section';

          const catTitle = document.createElement('h4');
          catTitle.className = 'town-spawn-cat-title';
          let catIcon = '📦';
          if (cat === 'Foliage & Alam') catIcon = '🌳';
          else if (cat === 'Perabot & Lampu') catIcon = '🪑';
          else if (cat === 'Dunia Pokémon') catIcon = '⚡';
          else if (cat === 'Dunia Digimon') catIcon = '👾';
          else if (cat === 'Tech & AI') catIcon = '💻';
          else if (cat === 'Fasilitas & Kota') catIcon = '⛲';
          catTitle.textContent = `${catIcon} ${cat} (${items.length})`;
          catSection.appendChild(catTitle);

          const grid = document.createElement('div');
          grid.className = 'town-spawn-grid';

          for (const item of items) {
            const card = document.createElement('div');
            card.className = 'town-spawn-card';
            card.innerHTML = `
              <div class="town-spawn-card__header">
                <span class="town-spawn-card__icon">${item.icon}</span>
                <span class="town-spawn-card__tag">${item.category}</span>
                <span class="town-spawn-card__size">${item.w}×${item.h}</span>
              </div>
              <strong class="town-spawn-card__title">${item.name}</strong>
              <p class="town-spawn-card__desc">${item.desc}</p>
              ${item.defaultDialogue ? `<div class="town-spawn-card__dialogue-preview">💬 "<em>${item.defaultDialogue}</em>"</div>` : ''}
              <div class="town-spawn-card__actions">
                <button type="button" class="town-editor-btn town-spawn-card__btn town-spawn-card__btn--place" data-tpl-id="${item.id}" title="Letakkan di tengah layar peta (Tekan Shift+Klik untuk mode cap)">
                  ➕ Pasang
                </button>
                <button type="button" class="town-editor-btn town-spawn-card__btn town-spawn-card__btn--stamp" data-tpl-id="${item.id}" title="Aktifkan mode cap untuk menaruh berkali-kali di peta!">
                  🎯 Cap
                </button>
              </div>
            `;

            if (item.kind === 'digimon' && item.subType && (spawnPlace === 'digimon' || activeSpawnCategory === 'Dunia Digimon')) {
              const iconEl = card.querySelector('.town-spawn-card__icon') as HTMLElement | null;
              if (iconEl) {
                iconEl.setAttribute('data-digi-thumb', item.subType);
                iconEl.setAttribute('data-digi-name', item.name);
                if (spawnThumbObserver) {
                  spawnThumbObserver.observe(iconEl);
                } else {
                  hydrateSpawnThumb(iconEl, item.subType, item.name);
                }
              }
            }

            const btnPlace = card.querySelector('.town-spawn-card__btn--place') as HTMLButtonElement | null;
            const btnStamp = card.querySelector('.town-spawn-card__btn--stamp') as HTMLButtonElement | null;

            btnPlace?.addEventListener('click', (e) => {
              if (!engine) return;
              if (e.shiftKey) {
                editor.setStampTemplate(item.id);
                spawnModal?.close();
                showToast(`🎯 Mode Cap aktif: ${item.name}! Klik bebas di peta untuk menaruh berturut-turut. Tekan ESC untuk selesai.`);
                sfx.select();
                return;
              }
              const camX = engine.getCameraX();
              const camY = engine.getCameraY();
              const centerX = Math.floor(camX / 16);
              const centerY = Math.floor(camY / 16);
              const newObj = townConfig.spawnObject(item.id, centerX, centerY);
              if (newObj) {
                editor.setTool('move');
                editor.selectBuilding(newObj.id);
                refreshObjectPicker();
                engine.invalidateBackgroundCanvas();
                engine.wake();
                showToast(`✨ ${newObj.name} berhasil dipasang! Tarik kursor untuk memindahkan posisinya.`);
                sfx.select();
              }
              spawnModal?.close();
            });

            btnStamp?.addEventListener('click', () => {
              editor.setStampTemplate(item.id);
              spawnModal?.close();
              showToast(`🎯 Mode Cap aktif: ${item.name}! Klik bebas di peta untuk menaruh berturut-turut. Tekan ESC untuk selesai.`);
              sfx.select();
            });

            grid.appendChild(card);
          }
          catSection.appendChild(grid);
          spawnCatalog.appendChild(catSection);
        }

        if (totalDisplayed === 0) {
          const emptyMsg = document.createElement('div');
          emptyMsg.className = 'town-spawn-empty';
          emptyMsg.innerHTML = `<p>🔍 Tidak ditemukan objek yang cocok dengan "<strong>${q}</strong>".</p>`;
          spawnCatalog.appendChild(emptyMsg);
        }
      };

      spawnSearch?.addEventListener('input', () => {
        spawnSearchQuery = spawnSearch.value;
        renderSpawnCatalog();
      });

      spawnSearchClear?.addEventListener('click', () => {
        if (spawnSearch) {
          spawnSearch.value = '';
          spawnSearchQuery = '';
          renderSpawnCatalog();
          spawnSearch.focus();
        }
      });

      spawnTabButtons.forEach((tab) => {
        tab.addEventListener('click', () => {
          const cat = tab.getAttribute('data-cat') || 'all';
          activeSpawnCategory = cat;
          spawnTabButtons.forEach((t) => t.classList.toggle('is-active', t === tab));
          renderSpawnCatalog();
          sfx.select();
        });
      });

      // Initial catalog render
      renderSpawnCatalog();

      let hasOpenedDigiSpawner = false;
      toolBtnSpawn?.addEventListener('click', () => {
        if (!hasOpenedDigiSpawner && engine?.getScene() === 'digimon' && activeSpawnCategory === 'all') {
          hasOpenedDigiSpawner = true;
          activeSpawnCategory = 'Dunia Digimon';
          spawnTabButtons.forEach((t) =>
            t.classList.toggle('is-active', t.getAttribute('data-cat') === 'Dunia Digimon')
          );
        }
        renderSpawnCatalog();
        spawnModal?.showModal();
        sfx.select();
      });

      btnCloseSpawnModal?.addEventListener('click', () => {
        spawnModal?.close();
      });

      const updateEditorUI = () => {
        const isEnabled = editor.isEnabled();
        btnToggleEditor?.classList.toggle('is-active', isEnabled);
        btnToggleDevMenu?.classList.toggle('is-active', isEnabled || (engine?.isXray() ?? false));
        burgerItemEditor?.classList.toggle('is-active', isEnabled);
        if (editorToolbar) {
          if (isEnabled) {
            editorToolbar.classList.remove('hidden');
            editorToolbar.removeAttribute('hidden');
            editorToolbar.style.display = 'flex';
          } else {
            editorToolbar.classList.add('hidden');
            editorToolbar.setAttribute('hidden', '');
            editorToolbar.style.display = 'none';
          }
        }
        if (!isEnabled) {
          return;
        }

        if (editorBody) {
          editorBody.style.display = isMinimized ? 'none' : 'block';
        }

        if (editorPalette) {
          editorPalette.classList.remove('hidden');
          editorPalette.style.display = 'flex';
        }

        const tool = editor.getTool();
        toolBtnMove?.classList.toggle('is-active', tool === 'move');
        toolBtnBrush?.classList.toggle('is-active', tool === 'brush');
        toolBtnErase?.classList.toggle('is-active', tool === 'erase');
        toolBtnDeleteObject?.classList.toggle('is-active', tool === 'delete_object');
        toolBtnLine?.classList.toggle('is-active', tool === 'line');
        toolBtnRect?.classList.toggle('is-active', tool === 'rect');
        toolBtnBucket?.classList.toggle('is-active', tool === 'bucket');
        toolBtnEyedropper?.classList.toggle('is-active', tool === 'eyedropper');
        toolBtnCollision?.classList.toggle('is-active', tool === 'collision' || editor.isCollisionOverlayVisible());
        toolBtnPlaytest?.classList.toggle('is-active', editor.isPlaytesting());
        toolBtnGrid?.classList.toggle('is-active', editor.isGridVisible());

        const brushSize = editor.getBrushSize();
        btnBrush1?.classList.toggle('is-active', brushSize === 1);
        btnBrush2?.classList.toggle('is-active', brushSize === 2);
        btnBrush3?.classList.toggle('is-active', brushSize === 3);

        // Update Undo / Redo buttons
        btnEditorUndo?.toggleAttribute('disabled', !townConfig.canUndo());
        btnEditorRedo?.toggleAttribute('disabled', !townConfig.canRedo());

        const brushTile = editor.getBrushTile();
        tileBtns.forEach((btn) => {
          const isCurrent = btn.getAttribute('data-tile') === brushTile;
          btn.classList.toggle('is-active', isCurrent && (tool === 'brush' || tool === 'line' || tool === 'rect' || tool === 'bucket'));
        });

        const selected = editor.getSelectedBuilding();
        const selectedBuildings = editor.getSelectedBuildings();
        refreshObjectPicker();

        const hasSelection = selectedBuildings.length > 0;
        const isLocked = editor.isSelectedLocked();
        if (btnEditorLock) {
          btnEditorLock.style.display = hasSelection ? 'inline-flex' : 'none';
          btnEditorLock.innerHTML = isLocked
            ? `🔓 <span class="hidden sm:inline">Buka (K)</span>`
            : `🔒 <span class="hidden sm:inline">Kunci (K)</span>`;
          btnEditorLock.title = isLocked
            ? 'Buka Kunci Objek agar dapat digeser / diedit (K)'
            : 'Kunci Objek agar tidak sengaja bergeser atau terhapus (K)';
        }
        if (btnEditorLayerDown) {
          btnEditorLayerDown.style.display = hasSelection ? 'inline-flex' : 'none';
        }
        if (btnEditorLayerUp) {
          btnEditorLayerUp.style.display = hasSelection ? 'inline-flex' : 'none';
        }
        if (btnEditorRotate) {
          btnEditorRotate.style.display = hasSelection ? 'inline-flex' : 'none';
        }
        if (btnEditorRotLeft) {
          btnEditorRotLeft.style.display = hasSelection ? 'inline-flex' : 'none';
        }
        if (btnEditorRotRight) {
          btnEditorRotRight.style.display = hasSelection ? 'inline-flex' : 'none';
        }
        if (btnEditorApply) {
          btnEditorApply.style.display = hasSelection ? 'inline-flex' : 'none';
        }
        if (btnEditorCancel) {
          btnEditorCancel.style.display = hasSelection ? 'inline-flex' : 'none';
        }
        if (btnEditorDuplicate) {
          btnEditorDuplicate.style.display = hasSelection ? 'inline-flex' : 'none';
        }
        if (btnEditorDialogue) {
          btnEditorDialogue.style.display = hasSelection ? 'inline-flex' : 'none';
        }
        if (btnEditorDeselect) {
          btnEditorDeselect.style.display = hasSelection ? 'inline-flex' : 'none';
        }
        if (btnEditorDelete) {
          btnEditorDelete.style.display = hasSelection ? 'inline-flex' : 'none';
        }

        // Update Floating Transform Action Bubble
        const transformBubble = document.getElementById('town-transform-bubble');
        if (transformBubble) {
          if (isEnabled && !editor.isPlaytesting() && selected) {
            transformBubble.classList.remove('hidden');
            transformBubble.style.display = 'block';
            const titleEl = document.getElementById('transform-bubble-title');
            const badgeEl = document.getElementById('transform-bubble-orient-badge');
            const iconEl = document.getElementById('transform-bubble-icon');
            if (titleEl) titleEl.textContent = selected.name;
            if (iconEl) {
              const kindIcons: Record<string, string> = {
                building: '🏢',
                tree: '🌲',
                bush: '🌿',
                bench: '🪑',
                lamp: '🏮',
                flowerbed: '🌸',
                npc: '👤',
                sign: '🪧',
                object: '📦',
              };
              const pokeIcons: Record<string, string> = {
                dialga: '⏳',
                palkia: '🌌',
                giratina: '👻',
                zekrom: '⚡',
                reshiram: '🔥',
                arceus: '✨',
                mewtwo: '🔮',
                rayquaza: '🐉',
                groudon: '🌋',
                kyogre: '🌊',
                latios: '🔷',
                latias: '🌸',
                darkrai: '🌑',
                necrozma: '🦁',
                necrozma_dusk_mane: '🦁',
                lunala: '🌙',
                solgaleo: '☀️',
                samurott: '⚔️',
              };
              const pokeKey = Object.keys(pokeIcons).find(
                (k) => selected.subType === k || selected.id.includes(k)
              );
              if (pokeKey) {
                iconEl.textContent = pokeIcons[pokeKey];
              } else {
                iconEl.textContent = kindIcons[selected.kind || 'object'] || '📦';
              }
            }
            if (badgeEl) {
              const orient = selected.orientation || 'N';
              const orientLabels: Record<'N' | 'E' | 'S' | 'W', string> = {
                W: '⬅️ Hadap Kiri',
                E: '➡️ Hadap Kanan',
                S: '⬇️ Hadap Depan',
                N: '⬆️ Hadap Belakang',
              };
              badgeEl.textContent = orientLabels[orient] || orient;
            }
            if (engine) {
              const pt = engine.worldToScreen((selected.x + selected.w / 2) * 16, selected.y * 16);
              const isTopClipped = pt.y < 85;
              const topPos = isTopClipped ? pt.y + 36 : pt.y - 14;
              transformBubble.style.left = `${Math.round(pt.x)}px`;
              transformBubble.style.top = `${Math.round(topPos)}px`;
            }
          } else {
            transformBubble.classList.add('hidden');
            transformBubble.style.display = 'none';
          }
        }

        // Update Mini-Map Radar widget
        if (minimapWidget) {
          if ((isEnabled && !editor.isPlaytesting()) || isVisitorRadarOpen) {
            minimapWidget.classList.remove('hidden');
            minimapWidget.style.display = 'flex';
            if (minimapCanvas) {
              editor.renderMinimap(minimapCanvas);
            }
          } else {
            minimapWidget.classList.add('hidden');
            minimapWidget.style.display = 'none';
          }
        }

        if (editorStatus) {
          if (tool === 'move') {
            if (selectedBuildings.length > 1) {
              editorStatus.textContent = `Multi-seleksi: ${selectedBuildings.length} objek terpilih. Tarik kursor / panah keyboard / Tekan R putar / Ctrl+D duplikat / Delete hapus`;
            } else if (selected) {
              const orient = selected.orientation ? ` [${selected.orientation}]` : '';
              editorStatus.textContent = `Objek Terpilih: ${selected.name}${orient} (${selected.x}, ${selected.y}) - Tarik kursor / panah / Tekan R putar / Ctrl+D duplikat / ESC lepas`;
            } else {
              editorStatus.textContent = 'Mode Geser: Klik & Tarik objek, pilih dari dropdown, atau tarik kotak seleksi (Marquee) di petak kosong';
            }
          } else if (tool === 'brush') {
            editorStatus.textContent = `Mode Kuas [${brushTile.toUpperCase()} ${brushSize}×${brushSize}]: Klik atau seret untuk mengecat lantai`;
          } else if (tool === 'erase') {
            editorStatus.textContent = `Mode Hapus Lantai [${brushSize}×${brushSize}]: Klik atau seret untuk menghapus lantai / jalan kembali menjadi rumput hijau`;
          } else if (tool === 'line') {
            editorStatus.textContent = `Mode Garis Lurus (L): Klik dan tarik dari titik A ke titik B untuk membuat jalan / semak lurus`;
          } else if (tool === 'rect') {
            editorStatus.textContent = `Mode Kotak Fill (R): Klik dan tarik area persegi untuk mengecat plaza / taman sekaligus`;
          } else if (tool === 'bucket') {
            editorStatus.textContent = `Mode Ember (B): Klik lantai untuk flood-fill area yang terhubung (Max 500 petak)`;
          } else if (tool === 'eyedropper') {
            editorStatus.textContent = `Mode Pipet (I / Alt+Klik): Klik objek untuk memilihnya, atau klik lantai untuk menyalin jenisnya`;
          } else if (tool === 'collision') {
            editorStatus.textContent = `Inspektur Tabrakan (C): Hijau=Bebas, Merah=Solid, Kuning=Pintu, Biru=NPC. Klik petak untuk toggle batas solid`;
          }
        }
      };

      editor.subscribe(updateEditorUI);
      updateEditorUI();

      townObjectPicker?.addEventListener('change', () => {
        const id = townObjectPicker.value;
        if (!id) {
          editor.selectBuilding(null);
          sfx.select();
          return;
        }
        editor.setTool('move');
        editor.selectBuilding(id);
        const b = townConfig.getBuilding(id);
        if (b && engine) {
          const targetX = (b.x + b.w / 2) * 16;
          const targetY = (b.y + b.h / 2) * 16;
          engine.panCamera(targetX - engine.getCameraX(), targetY - engine.getCameraY());
        }
        sfx.select();
      });

      btnEditorRotate?.addEventListener('click', () => {
        editor.rotateSelected();
        sfx.select();
      });

      btnEditorRotLeft?.addEventListener('click', () => {
        editor.rotateSelectedDirection('left');
        sfx.select();
      });
      btnTransformRotLeft?.addEventListener('click', () => {
        editor.rotateSelectedDirection('left');
        sfx.select();
      });

      btnEditorRotRight?.addEventListener('click', () => {
        editor.rotateSelectedDirection('right');
        sfx.select();
      });
      btnTransformRotRight?.addEventListener('click', () => {
        editor.rotateSelectedDirection('right');
        sfx.select();
      });

      btnEditorApply?.addEventListener('click', () => {
        editor.applySelectedTransform();
        sfx.heal();
      });
      btnTransformApply?.addEventListener('click', () => {
        editor.applySelectedTransform();
        sfx.heal();
      });

      btnEditorCancel?.addEventListener('click', () => {
        editor.cancelSelectedTransform();
        sfx.select();
      });
      btnTransformCancel?.addEventListener('click', () => {
        editor.cancelSelectedTransform();
        sfx.select();
      });

      btnEditorDuplicate?.addEventListener('click', () => {
        editor.duplicateSelected();
        sfx.select();
      });

      btnEditorDialogue?.addEventListener('click', () => {
        const selected = editor.getSelectedBuilding();
        if (!selected) return;
        const dialogueModal = document.getElementById('town-editor-dialogue-modal') as HTMLDialogElement | null;
        const titleEl = document.getElementById('town-dialogue-modal-title');
        const inputEl = document.getElementById('town-dialogue-input') as HTMLTextAreaElement | null;
        if (titleEl) titleEl.textContent = `💬 Ubah Dialog: ${selected.name}`;
        if (inputEl) {
          const tpl = SPAWNABLE_TEMPLATES.find((t) => t.id === selected.id || t.subType === selected.subType);
          inputEl.value = selected.dialogue !== undefined ? selected.dialogue : (tpl?.defaultDialogue || '');
        }
        dialogueModal?.showModal();
        sfx.select();
      });

      document.getElementById('btn-dialogue-save')?.addEventListener('click', () => {
        const selected = editor.getSelectedBuilding();
        const inputEl = document.getElementById('town-dialogue-input') as HTMLTextAreaElement | null;
        if (selected && inputEl) {
          townConfig.setBuildingDialogue(selected.id, inputEl.value.trim());
          showToast(`💬 Dialog "${selected.name}" berhasil disimpan!`);
          sfx.heal();
        }
        (document.getElementById('town-editor-dialogue-modal') as HTMLDialogElement | null)?.close();
      });

      document.getElementById('btn-dialogue-cancel')?.addEventListener('click', () => {
        (document.getElementById('town-editor-dialogue-modal') as HTMLDialogElement | null)?.close();
      });

      document.getElementById('btn-close-dialogue-modal')?.addEventListener('click', () => {
        (document.getElementById('town-editor-dialogue-modal') as HTMLDialogElement | null)?.close();
      });

      btnEditorDeselect?.addEventListener('click', () => {
        editor.selectBuilding(null);
        sfx.select();
        showToast('Seleksi objek dilepas.');
      });

      btnEditorDelete?.addEventListener('click', () => {
        editor.deleteSelected();
        if (townObjectPicker) {
          townObjectPicker.value = '';
        }
        sfx.select();
      });

      btnEditorLock?.addEventListener('click', () => {
        editor.toggleSelectedLock();
        sfx.select();
      });

      btnEditorLayerDown?.addEventListener('click', () => {
        editor.adjustSelectedZIndex(-1);
        sfx.select();
      });

      btnEditorLayerUp?.addEventListener('click', () => {
        editor.adjustSelectedZIndex(1);
        sfx.select();
      });

      btnEditorValidate?.addEventListener('click', () => {
        editor.validateReachability();
        sfx.select();
      });

      btnMinimapToggle?.addEventListener('click', () => {
        isMinimapCollapsed = !isMinimapCollapsed;
        if (minimapBody) {
          minimapBody.style.display = isMinimapCollapsed ? 'none' : 'block';
        }
        if (btnMinimapToggle) {
          btnMinimapToggle.textContent = isMinimapCollapsed ? '🔼' : '🔽';
        }
        sfx.select();
      });

      let isMinimapDragging = false;
      const handleMinimapPan = (e: MouseEvent) => {
        if (!minimapCanvas) return;
        const rect = minimapCanvas.getBoundingClientRect();
        const mx = e.clientX - rect.left;
        const my = e.clientY - rect.top;
        editor.panFromMinimap(mx, my, rect.width);
        editor.renderMinimap(minimapCanvas);
      };

      minimapCanvas?.addEventListener('mousedown', (e) => {
        if (!editor.isEnabled()) return;
        isMinimapDragging = true;
        handleMinimapPan(e);
      });
      window.addEventListener('mousemove', (e) => {
        if (isMinimapDragging) {
          handleMinimapPan(e);
        }
      });
      window.addEventListener('mouseup', () => {
        isMinimapDragging = false;
      });

      btnEditorUndo?.addEventListener('click', () => {
        if (townConfig.undo()) {
          sfx.select();
          showToast('↩ Perubahan dibatalkan (Undo)');
          engine?.invalidateBackgroundCanvas();
          engine?.wake();
        }
      });

      btnEditorRedo?.addEventListener('click', () => {
        if (townConfig.redo()) {
          sfx.select();
          showToast('↪ Perubahan diterapkan kembali (Redo)');
          engine?.invalidateBackgroundCanvas();
          engine?.wake();
        }
      });

      btnEditorMinimize?.addEventListener('click', () => {
        isMinimized = !isMinimized;
        if (editorBody) {
          editorBody.style.display = isMinimized ? 'none' : 'block';
        }
        if (iconEditorMinimize) {
          iconEditorMinimize.textContent = isMinimized ? '🔼' : '🔽';
        }
        sfx.select();
      });

      const closeEditor = () => {
        if (editor.isEnabled()) {
          editor.toggleEnabled();
          sfx.select();
        }
      };

      btnEditorQuickClose?.addEventListener('click', closeEditor);
      btnEditorClose?.addEventListener('click', closeEditor);

      toolBtnMove?.addEventListener('click', () => {
        editor.setTool('move');
        sfx.select();
      });

      toolBtnBrush?.addEventListener('click', () => {
        editor.setTool('brush');
        sfx.select();
      });

      toolBtnErase?.addEventListener('click', () => {
        editor.setTool('erase');
        sfx.select();
      });

      toolBtnDeleteObject?.addEventListener('click', () => {
        editor.setTool('delete_object');
        sfx.select();
      });

      toolBtnLine?.addEventListener('click', () => {
        editor.setTool('line');
        sfx.select();
      });

      toolBtnRect?.addEventListener('click', () => {
        editor.setTool('rect');
        sfx.select();
      });

      toolBtnBucket?.addEventListener('click', () => {
        editor.setTool('bucket');
        sfx.select();
      });

      toolBtnEyedropper?.addEventListener('click', () => {
        editor.setTool('eyedropper');
        sfx.select();
      });

      toolBtnCollision?.addEventListener('click', () => {
        editor.setTool('collision');
        sfx.select();
      });

      toolBtnPlaytest?.addEventListener('click', () => {
        editor.togglePlaytest();
        sfx.select();
      });

      toolBtnGrid?.addEventListener('click', () => {
        editor.toggleGrid();
        sfx.select();
      });

      btnBrush1?.addEventListener('click', () => {
        editor.setBrushSize(1);
        sfx.select();
      });

      btnBrush2?.addEventListener('click', () => {
        editor.setBrushSize(2);
        sfx.select();
      });

      btnBrush3?.addEventListener('click', () => {
        editor.setBrushSize(3);
        sfx.select();
      });

      btnExitPlaytest?.addEventListener('click', () => {
        editor.togglePlaytest();
        sfx.select();
      });

      window.addEventListener('town:playtest-toggle', ((e: CustomEvent<boolean>) => {
        const isPlay = e.detail;
        if (isPlay) {
          if (editorToolbar) editorToolbar.style.display = 'none';
          if (playtestBar) {
            playtestBar.classList.remove('hidden');
            playtestBar.style.display = 'flex';
          }
        } else {
          if (playtestBar) {
            playtestBar.classList.add('hidden');
            playtestBar.style.display = 'none';
          }
          if (editor.isEnabled()) {
            if (editorToolbar) {
              editorToolbar.classList.remove('hidden');
              editorToolbar.style.display = 'flex';
            }
          }
        }
      }) as EventListener);

      tileBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const tile = btn.getAttribute('data-tile') as TileTypeKey;
          if (tile) {
            editor.setBrushTile(tile);
            sfx.select();
          }
        });
      });

      btnEditorSave?.addEventListener('click', async () => {
        await editor.save();
        sfx.heal();
      });

      btnEditorExport?.addEventListener('click', () => {
        if (codeOutput && exportModal) {
          codeOutput.textContent = townConfig.exportCode();
          exportModal.showModal();
          sfx.select();
        }
      });

      btnCloseExportModal?.addEventListener('click', () => {
        exportModal?.close();
      });

      btnCopyCode?.addEventListener('click', async () => {
        if (codeOutput?.textContent) {
          try {
            await navigator.clipboard.writeText(codeOutput.textContent);
            showToast('✓ Kode berhasil disalin ke clipboard!');
            sfx.heal();
          } catch {
            showToast('Pilih dan salin teks secara manual (Ctrl+C).');
          }
        }
      });

      btnEditorReset?.addEventListener('click', () => {
        if (window.confirm('Kembalikan semua posisi bangunan & petak kustom ke tata letak awal?')) {
          townConfig.resetToDefaults();
          sfx.select();
          showToast('✓ Tata letak kota telah direset ke default.');
        }
      });
    }

    // Global Town Hotkeys
    window.addEventListener('keydown', (e) => {
      if (['INPUT', 'TEXTAREA', 'SELECT'].includes((e.target as HTMLElement)?.tagName)) return;

      const editor = engine?.getEditor();
      const editorActive = editor?.isEnabled() || editor?.isPlaytesting();

      if (!editorActive) {
        if (e.key === 'x' || e.key === 'X') {
          if (e.shiftKey) {
            btnToggleXray?.click();
          } else {
            castPartnerSkill();
          }
        } else if (e.key === 'p' || e.key === 'P') {
          openPartnerHub();
        } else if (e.key === 'u' || e.key === 'U') {
          openPassport();
        } else if (e.key === 'l' || e.key === 'L') {
          toggleLabels();
        } else if (e.key === 'c' || e.key === 'C') {
          recenterCamera();
        } else if (e.key === 'i' || e.key === 'I') {
          guideToggle?.click();
        } else if (e.key === '+' || e.key === '=') {
          engine?.zoomBy(1.15);
        } else if (e.key === '-' || e.key === '_') {
          engine?.zoomBy(0.87);
        } else if (e.key === '0') {
          recenterBtn?.click();
        }
      }

      if (e.key === 'f' || e.key === 'F') {
        toggleFullscreen();
      } else if ((e.key === 'e' || e.key === 'E') && canAccessEditor) {
        toggleTownEditor();
      } else if (e.key === 'h' || e.key === 'H') {
        toggleMinimizeHud();
      }
    });

    // Back to room / POV Exit button
    const povExit = document.querySelector('[data-pov-exit]');
    povExit?.addEventListener('click', () => {
      sessionStorage.setItem('town:respawn', '22,28');
      window.location.href = '/';
    });

    // Scoreboard event listener
    document.addEventListener('town:scoreboard', () => {
      showBubble(
        'Scoreboard',
        'DEOXYS vs. EVERYONE (W-L-D): EASY: 48-12-4 | MEDIUM: 89-3-2 | HARD: 142-0-0. Deoxys plays FairKalah minimax search.'
      );
    });

    // Tech Gym Challenge Quiz (Mewtwo)
    document.addEventListener('town:arena-quiz', () => {
      const q1 = () => {
        showBubble(
          'Mewtwo · Battle Arena 🔮',
          "MEWTWO (Telepati): 'Uji coba ketajaman logika dimulai... Pertanyaan 1/3: Framework & kuantisasi apa yang digunakan Zulfan untuk pipeline edge AI real-time?'",
          {
            label: '(A) YOLOv8 + TensorRT FP16/INT8',
            onClick: () => q2(),
          }
        );
      };
      const q2 = () => {
        sfx.select();
        showBubble(
          'Mewtwo · Battle Arena 🔮',
          "MEWTWO: 'Resonansi pikiranmu tajam. Pertanyaan 2/3: Arsitektur modern apa yang mentenagai web portofolio Pokémon 2D ini?'",
          {
            label: '(A) Astro + TypeScript Canvas 2D',
            onClick: () => q3(),
          }
        );
      };
      const q3 = () => {
        sfx.select();
        showBubble(
          'Mewtwo · Battle Arena 🔮',
          "MEWTWO: 'Hampir selesai. Pertanyaan Penentu 3/3: Berapa target latensi inferensi yang dipatok Zulfan untuk sistem robot otonom?'",
          {
            label: '(A) Under 15ms real-time throughput',
            onClick: () => win(),
          }
        );
      };
      const win = () => {
        try {
          localStorage.setItem('town:badge:frontier', 'true');
        } catch {}
        gameStore.addStamp('battle');
        sfx.heal();
        showBubble(
          'VICTORY! 🏆 Arena Frontier Badge',
          'MEWTWO: "Pikiranmu terbukti tangguh. Aku mengakui kemampuan teknologi dan logikamu." Kamu berhasil merebut ARENA FRONTIER BADGE & Stempel Battle Arena!'
        );
      };
      q1();
    });

    // Achievement Unlocked Celebration Toast
    window.addEventListener('town:stamp-unlocked', (e: Event) => {
      const detail = (e as CustomEvent).detail;
      if (!detail) return;
      sfx.catchSuccess();
      const m = detail.mission;
      const count = detail.totalStamps;
      if (count === 3) {
        showToast('⭐ VIP RECRUITER UNLOCKED! Bingkai Emas terbuka di Trainer Card (Buka Passport / Dex)');
      } else if (count === 5) {
        showToast('👑 GRAND CHAMPION! Semua 5 Stempel Wisata Zulfan Town berhasil diraih!');
      } else {
        showToast(`🏆 Achievement Unlocked: ${m ? m.icon + ' ' + m.name : 'Stempel Baru'}! (${count}/5 Stempel)`);
      }
    });

    // Poké-Café Barista Stand Event
    document.addEventListener('town:cafe-coffee', () => {
      sfx.heal();
      showBubble(
        'Poké-Café Barista Stand ☕',
        'You enjoyed a hot cup of fresh Dev Roast! The rich aroma of roasted Arabica fills the plaza (+100 Energy for coding & dex exploration).'
      );
    });

    // Virtual Gamepad bindings with smooth continuous walking on hold
    const bindDpad = (id: string, dir: 'up' | 'down' | 'left' | 'right') => {
      const btn = document.getElementById(id);
      if (!btn) return;
      const start = (e: Event) => {
        e.preventDefault();
        engine?.setDirPressed(dir, true);
      };
      const stop = (e: Event) => {
        e.preventDefault();
        engine?.setDirPressed(dir, false);
      };
      btn.addEventListener('pointerdown', start);
      btn.addEventListener('pointerup', stop);
      btn.addEventListener('pointerleave', stop);
      btn.addEventListener('pointercancel', stop);
    };

    bindDpad('dpad-up', 'up');
    bindDpad('dpad-down', 'down');
    bindDpad('dpad-left', 'left');
    bindDpad('dpad-right', 'right');

    const btnInteract = document.getElementById('btn-interact');
    btnInteract?.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      engine?.interactFacing();
    });
  }

  document.addEventListener('DOMContentLoaded', initTown);
  document.addEventListener('astro:page-load', initTown);
</script>
