    // Radar click-to-walk / Shift+click-to-fly
    minimapCanvas?.addEventListener('click', (e) => {
      if (engine?.getEditor()?.isEnabled()) return;
      if (!minimapCanvas || !engine) return;
      const rect = minimapCanvas.getBoundingClientRect();
      const map = engine.getMap();
      const tileX = Math.max(0, Math.min(map.w - 1, Math.floor(((e.clientX - rect.left) / rect.width) * map.w)));
      const tileY = Math.max(0, Math.min(map.h - 1, Math.floor(((e.clientY - rect.top) / rect.height) * map.h)));

      if (e.shiftKey) {
        engine.flyTo(tileX, tileY, 'Radar Mini-Map');
        showToast(`🦅 Terbang ke (${tileX}, ${tileY}) lewat radar!`);
      } else {
        engine.walkTo(tileX, tileY);
        showToast(`📍 Berjalan menuju (${tileX}, ${tileY})...`);
      }
    });

