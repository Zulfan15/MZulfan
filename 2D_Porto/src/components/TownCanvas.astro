---
import { profile, featured, topSkills, places } from '../lib/profile';
import type { TownData } from '../engine/types';

interface Props {
  currentPlace?: string;
}

const { currentPlace = 'town' } = Astro.props;

const townData: TownData = {
  name: profile.person.name,
  shortName: profile.person.short_name,
  tagline: profile.person.tagline,
  now: profile.person.now.role,
  openTo: profile.person.open_to,
  email: profile.person.email,
  featured: featured.map((f) => f.title),
  toolbelt: topSkills.map((s) => s.name),
  places: places,
};

const dataPlaces = {
  town: { name: 'Town Square', href: '/' },
  home: { name: 'Home', href: '/about' },
  dev: { name: 'Dev Center', href: '/dev' },
  lab: { name: 'Research Lab', href: '/lab' },
  arcade: { name: 'Arcade', href: '/arcade' },
  twin: { name: 'Digital Twin', href: '/twin' },
  reception: { name: 'Poké Center', href: '/reception' },
  mart: { name: 'Poké Mart', href: '/mart' },
  tower: { name: 'Tech Tower', href: '/tower' },
  cafe: { name: 'Poké-Café & Bar', href: '/cafe' },
  arena: { name: 'Battle Arena', href: '/arena' },
  garden: { name: 'Berry Garden', href: '/garden' },
  neighbour: { name: "Neighbour's House", href: '/neighbour' },
  digimon: { name: 'Digi-Sanctuary', href: '/digimon' },
};

const githubUrl = profile.socials.find((s) => s.label === 'GitHub')?.url || 'https://github.com/Zulfan15';
const linkedinUrl = profile.socials.find((s) => s.label === 'LinkedIn')?.url || 'https://www.linkedin.com/in/muhammad-zulfan-anggadhiputra';
const emailUrl = `mailto:${profile.person.email}`;
const classicPortfolioUrl = profile.person.website || 'https://zulfan15.github.io/MZulfan';

const dataLinks = {
  github: { label: 'GitHub', url: githubUrl },
  linkedin: { label: 'LinkedIn', url: linkedinUrl },
  email: { label: 'Email', url: emailUrl },
  depop: { label: 'Depop', url: classicPortfolioUrl },
};

const dataPlaceRooms = {
  reception: 'dev',
};
---

<section
  data-astro-transition-persist="town"
  class="town"
  aria-labelledby="town-title"
  data-town=""
  data-places={JSON.stringify(dataPlaces)}
  data-links={JSON.stringify(dataLinks)}
  data-place-rooms={JSON.stringify(dataPlaceRooms)}
  data-scene={currentPlace === 'about' ? 'home' : currentPlace === 'dev' ? 'dev' : currentPlace === 'lab' ? 'lab' : currentPlace === 'arcade' ? 'arcade' : currentPlace === 'reception' ? 'reception' : currentPlace === 'mart' ? 'mart' : currentPlace === 'tower' ? 'tower' : currentPlace === 'cafe' ? 'cafe' : currentPlace === 'arena' ? 'arena' : currentPlace === 'garden' ? 'garden' : currentPlace === 'neighbour' ? 'neighbour' : currentPlace === 'digimon' ? 'digimon' : 'town'}
  data-retro={currentPlace === 'about' || currentPlace === 'dev' || currentPlace === 'lab' || currentPlace === 'arcade' || currentPlace === 'reception' || currentPlace === 'mart' || currentPlace === 'tower' || currentPlace === 'cafe' || currentPlace === 'arena' || currentPlace === 'garden' || currentPlace === 'neighbour' ? '' : undefined}
>
  <h2 id="town-title" class="visually-hidden">Interactive Town Map</h2>
  <p id="town-help" class="visually-hidden">
    An interactive pixel-art town portfolio. Use the arrow keys or W A S D to walk, Enter to interact, or click or tap where you want to go. Every landmark and building is interactive.
  </p>

  <!-- Top Studio HUD Bar -->
  <header class="town-hud-bar" aria-label="Town controls and status">
    <div
      class="town-hud-pill town-hud-pill--scene"
      id="btn-scene-pill"
      role="button"
      tabindex="0"
      aria-label="Menu Opsi Kota"
      title="Buka Menu Kota (Atau tekan H untuk minimize)"
    >
      <span class="town-hud-pulse" aria-hidden="true"></span>
      <span class="town-hud-title">
        {currentPlace === 'about'
          ? '🏠 Home & Studio'
          : currentPlace === 'dev'
          ? '💻 Dev Center'
          : currentPlace === 'lab'
          ? '🔬 Research Lab'
          : currentPlace === 'arcade'
          ? '🕹️ Retro Arcade'
          : currentPlace === 'reception'
          ? '🏥 Poké Center'
          : currentPlace === 'mart'
          ? '🏪 Poké Mart'
          : currentPlace === 'tower'
          ? '🏢 Tech Tower'
          : currentPlace === 'cafe'
          ? '☕ Poké-Café & Bar'
          : currentPlace === 'arena'
          ? '⚔️ Gladiator Arena'
          : currentPlace === 'garden'
          ? '🌸 Berry Garden'
          : currentPlace === 'neighbour'
          ? "🏡 Neighbour's House"
          : currentPlace === 'digimon'
          ? '👾 Digi-Sanctuary'
          : '📍 Town Square'}
      </span>
      <span class="town-hud-badge">LIVE 2D</span>
    </div>

    <div class="town-hud-right-actions flex items-center gap-1.5 sm:gap-2">
      <!-- Quick Town Editor Toggle Button -->
      <button
        type="button"
        class="town-hud-btn town-hud-btn--editor"
        id="btn-toggle-editor"
        aria-label="Toggle Town Editor"
        title="Town Editor 3.0 (Kustomisasi Kota / Tekan E)"
      >
        <span class="town-hud-btn__icon" aria-hidden="true">🛠️</span>
        <span class="town-hud-btn__label">Editor</span>
      </button>

      <!-- Burger Menu Button & Dropdown -->
      <div class="town-hud-burger-wrap">
      <button
        type="button"
        class="town-hud-btn town-hud-burger-btn"
        id="btn-town-burger"
        aria-label="Buka Menu Navigasi"
        aria-expanded="false"
        aria-controls="town-burger-dropdown"
        title="Menu Navigasi Kota"
      >
        <span class="town-hud-burger-bars" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
        <span class="town-hud-btn__label">Menu</span>
      </button>

      <div
        id="town-burger-dropdown"
        class="town-burger-dropdown hidden"
        style="display: none;"
        role="menu"
        aria-label="Menu Opsi Kota"
      >
        <div class="town-burger-dropdown__header">
          <div class="town-burger-dropdown__title-wrap">
            <span class="town-hud-pulse" aria-hidden="true"></span>
            <span class="town-burger-dropdown__title">
              {currentPlace === 'about'
                ? '🏠 Home & Studio'
                : currentPlace === 'dev'
                ? '💻 Dev Center'
                : currentPlace === 'lab'
                ? '🔬 Research Lab'
                : currentPlace === 'arcade'
                ? '🕹️ Retro Arcade'
                : currentPlace === 'reception'
                ? '🏥 Poké Center'
                : currentPlace === 'mart'
                ? '🏪 Poké Mart'
                : currentPlace === 'tower'
                ? '🏢 Tech Tower'
                : currentPlace === 'cafe'
                ? '☕ Poké-Café & Bar'
                : currentPlace === 'arena'
                ? '⚔️ Gladiator Arena'
                : currentPlace === 'garden'
                ? '🌸 Berry Garden'
                : currentPlace === 'neighbour'
                ? "🏡 Neighbour's House"
                : currentPlace === 'digimon'
                ? '👾 Digi-Sanctuary'
                : '📍 Town Square'}
            </span>
          </div>
          <span class="town-hud-badge">LIVE 2D</span>
          <button type="button" id="btn-burger-close" class="town-burger-dropdown__close" title="Tutup Menu">✕</button>
        </div>

        <div class="town-burger-dropdown__list">
          <button type="button" class="town-burger-dropdown__item" id="burger-item-search" role="menuitem">
            <span class="town-burger-dropdown__item-icon">🔍</span>
            <div class="town-burger-dropdown__item-info">
              <span class="town-burger-dropdown__item-title">Pokénav Search</span>
              <span class="town-burger-dropdown__item-sub">Cari skill, proyek & aksi cepat</span>
            </div>
            <kbd class="town-burger-dropdown__kbd">Ctrl+K</kbd>
          </button>

          <button type="button" class="town-burger-dropdown__item" id="burger-item-bike" role="menuitem">
            <span class="town-burger-dropdown__item-icon">🚲</span>
            <div class="town-burger-dropdown__item-info">
              <span class="town-burger-dropdown__item-title">Mach Bike</span>
              <span class="town-burger-dropdown__item-sub">Kecepatan 2.2× & bel sepeda</span>
            </div>
            <kbd class="town-burger-dropdown__kbd">B</kbd>
          </button>

          <button type="button" class="town-burger-dropdown__item" id="burger-item-minimap" role="menuitem">
            <span class="town-burger-dropdown__item-icon">🧭</span>
            <div class="town-burger-dropdown__item-info">
              <span class="town-burger-dropdown__item-title">Radar Kota</span>
              <span class="town-burger-dropdown__item-sub">Peta navigasi & klik teleport</span>
            </div>
            <kbd class="town-burger-dropdown__kbd">M</kbd>
          </button>

          <button type="button" class="town-burger-dropdown__item" id="burger-item-partner" role="menuitem">
            <span class="town-burger-dropdown__item-icon" id="burger-partner-icon">🐾</span>
            <div class="town-burger-dropdown__item-info">
              <span class="town-burger-dropdown__item-title">Poké-Partner Hub</span>
              <span class="town-burger-dropdown__item-sub" id="burger-partner-sub">Pilih pendamping & skill (22 Pokémon)</span>
            </div>
            <kbd class="town-burger-dropdown__kbd">P</kbd>
          </button>

          <button type="button" class="town-burger-dropdown__item" id="burger-item-passport" role="menuitem">
            <span class="town-burger-dropdown__item-icon">🎫</span>
            <div class="town-burger-dropdown__item-info">
              <span class="town-burger-dropdown__item-title">Trainer Passport</span>
              <span class="town-burger-dropdown__item-sub">Misi stempel tur kota & Trainer Card VIP</span>
            </div>
            <kbd class="town-burger-dropdown__kbd">U</kbd>
          </button>

          <button type="button" class="town-burger-dropdown__item" id="burger-item-skill" role="menuitem">
            <span class="town-burger-dropdown__item-icon" id="burger-skill-icon">⚡</span>
            <div class="town-burger-dropdown__item-info">
              <span class="town-burger-dropdown__item-title">Skill Pendamping</span>
              <span class="town-burger-dropdown__item-sub" id="burger-skill-sub">Visual Burst Pokémon aktif</span>
            </div>
            <kbd class="town-burger-dropdown__kbd">X</kbd>
          </button>

          <button type="button" class="town-burger-dropdown__item" id="burger-item-pokeride" role="menuitem">
            <span class="town-burger-dropdown__item-icon" id="burger-pokeride-icon">🏇</span>
            <div class="town-burger-dropdown__item-info">
              <span class="town-burger-dropdown__item-title">Poké Ride</span>
              <span class="town-burger-dropdown__item-sub" id="burger-pokeride-sub">Tunggangi Pokémon partner</span>
            </div>
            <kbd class="town-burger-dropdown__kbd">R</kbd>
          </button>

          <button type="button" class="town-burger-dropdown__item" id="burger-item-time" role="menuitem">
            <span class="town-burger-dropdown__item-icon" id="burger-time-icon">☀️</span>
            <div class="town-burger-dropdown__item-info">
              <span class="town-burger-dropdown__item-title" id="burger-time-title">Waktu Kota</span>
              <span class="town-burger-dropdown__item-sub" id="burger-time-sub">Siang (☀️)</span>
            </div>
          </button>

          <button type="button" class="town-burger-dropdown__item" id="burger-item-weather" role="menuitem">
            <span class="town-burger-dropdown__item-icon" id="burger-weather-icon">🌸</span>
            <div class="town-burger-dropdown__item-info">
              <span class="town-burger-dropdown__item-title" id="burger-weather-title">Cuaca Dinamis</span>
              <span class="town-burger-dropdown__item-sub" id="burger-weather-sub">Sakura (🌸)</span>
            </div>
          </button>

          <button type="button" class="town-burger-dropdown__item" id="burger-item-bgm" role="menuitem">
            <span class="town-burger-dropdown__item-icon" id="burger-bgm-icon">🎵</span>
            <div class="town-burger-dropdown__item-info">
              <span class="town-burger-dropdown__item-title">Musik Latar 8-Bit</span>
              <span class="town-burger-dropdown__item-sub" id="burger-bgm-sub">Lo-Fi Nostalgik</span>
            </div>
          </button>

          <button type="button" class="town-burger-dropdown__item" id="burger-item-labels" role="menuitem">
            <span class="town-burger-dropdown__item-icon" id="burger-labels-icon">🏷️</span>
            <div class="town-burger-dropdown__item-info">
              <span class="town-burger-dropdown__item-title">Label & Badges</span>
              <span class="town-burger-dropdown__item-sub">Tampilkan nama lokasi</span>
            </div>
            <kbd class="town-burger-dropdown__kbd">L</kbd>
          </button>

          <button type="button" class="town-burger-dropdown__item" id="burger-item-recenter" role="menuitem">
            <span class="town-burger-dropdown__item-icon">🎯</span>
            <div class="town-burger-dropdown__item-info">
              <span class="town-burger-dropdown__item-title">Recenter Kamera</span>
              <span class="town-burger-dropdown__item-sub">Fokus ke posisi karakter</span>
            </div>
            <kbd class="town-burger-dropdown__kbd">C</kbd>
          </button>

          <button type="button" class="town-burger-dropdown__item" id="burger-item-guide" role="menuitem">
            <span class="town-burger-dropdown__item-icon">ℹ️</span>
            <div class="town-burger-dropdown__item-info">
              <span class="town-burger-dropdown__item-title">Panduan Ruangan</span>
              <span class="town-burger-dropdown__item-sub">Informasi panduan lokasi</span>
            </div>
            <kbd class="town-burger-dropdown__kbd">I</kbd>
          </button>

          <button type="button" class="town-burger-dropdown__item" id="burger-item-fullscreen" role="menuitem">
            <span class="town-burger-dropdown__item-icon">⛶</span>
            <div class="town-burger-dropdown__item-info">
              <span class="town-burger-dropdown__item-title">Layar Penuh</span>
              <span class="town-burger-dropdown__item-sub">Mode kanvas fullscreen</span>
            </div>
            <kbd class="town-burger-dropdown__kbd">F</kbd>
          </button>

          <button type="button" class="town-burger-dropdown__item" id="burger-item-toggle-hud" role="menuitem">
            <span class="town-burger-dropdown__item-icon" id="burger-hud-icon">▲</span>
            <div class="town-burger-dropdown__item-info">
              <span class="town-burger-dropdown__item-title" id="burger-hud-title">Minimalkan Bar Atas</span>
              <span class="town-burger-dropdown__item-sub" id="burger-hud-sub">Sembunyikan bar tombol atas</span>
            </div>
            <kbd class="town-burger-dropdown__kbd">H</kbd>
          </button>

          <!-- Separator for Developer Tools in Burger Menu -->
          <div class="px-3 py-1.5 text-[9px] font-mono text-emerald-400/80 uppercase tracking-wider border-t border-slate-700/60 mt-1">
            Alat Pengembang & Editor
          </div>

          <button type="button" class="town-burger-dropdown__item" id="burger-item-xray" role="menuitem">
            <span class="town-burger-dropdown__item-icon" id="burger-xray-icon">🔬</span>
            <div class="town-burger-dropdown__item-info">
              <span class="town-burger-dropdown__item-title">Mode X-Ray</span>
              <span class="town-burger-dropdown__item-sub">Lihat tabrakan & hapus rintangan</span>
            </div>
            <kbd class="town-burger-dropdown__kbd">X</kbd>
          </button>

          <button type="button" class="town-burger-dropdown__item town-burger-dropdown__item--editor" id="burger-item-editor" role="menuitem">
            <span class="town-burger-dropdown__item-icon">🛠️</span>
            <div class="town-burger-dropdown__item-info">
              <span class="town-burger-dropdown__item-title">Town Editor 3.0</span>
              <span class="town-burger-dropdown__item-sub">Kustomisasi tata letak kota</span>
            </div>
            <kbd class="town-burger-dropdown__kbd">E</kbd>
          </button>
        </div>
      </div>
    </div>
  </div>
  </header>

  <!-- Floating Minimized HUD Pill (Muncul saat bar atas diminimalkan) -->
  <button
    type="button"
    id="town-hud-restore-btn"
    class="town-hud-restore-pill hidden"
    aria-label="Tampilkan Bar Atas (Tekan H)"
    title="Klik untuk mengembalikan bar atas atau buka menu (Tekan H)"
  >
    <span class="town-hud-pulse" aria-hidden="true"></span>
    <span class="town-hud-restore-title">
      {currentPlace === 'about'
        ? '🏠 Home'
        : currentPlace === 'dev'
        ? '💻 Dev'
        : currentPlace === 'lab'
        ? '🔬 Lab'
        : currentPlace === 'arcade'
        ? '🕹️ Arcade'
        : currentPlace === 'reception'
        ? '🏥 Center'
        : currentPlace === 'mart'
        ? '🏪 Poké Mart'
        : currentPlace === 'tower'
        ? '🏢 Tech Tower'
        : currentPlace === 'cafe'
        ? '☕ Café & Bar'
        : currentPlace === 'arena'
        ? '⚔️ Arena'
        : currentPlace === 'garden'
        ? '🌸 Garden'
        : currentPlace === 'digimon'
        ? '👾 Digi-World'
        : '📍 Town Square'}
    </span>
    <span class="town-hud-badge">LIVE 2D</span>
    <span class="town-hud-restore-icon" aria-hidden="true">☰</span>
    <span class="town-hud-restore-arrow" aria-hidden="true">▼</span>
  </button>

  <canvas
    id="town-canvas"
    tabindex="0"
    role="img"
    aria-label="Pixel-art town. Walk into buildings to explore."
    aria-describedby="town-help"
    width="864"
    height="1314"
    class="w-full h-full block cursor-pointer"
  ></canvas>

  <div class="town-labels" data-town-labels="">
    {currentPlace === 'about' ? (
      <>
        <button type="button" class="town-label" data-id="shop-posters" aria-label="Look at the gig posters">
          <span class="town-label__icon" aria-hidden="true">🎨</span>
          <span class="town-label__text">Gig Posters</span>
        </button>
        <button type="button" class="town-label" data-id="shop-polaroids" aria-label="Look at the polaroids">
          <span class="town-label__icon" aria-hidden="true">📸</span>
          <span class="town-label__text">Polaroids</span>
        </button>
        <button type="button" class="town-label" data-id="stairs-up" aria-label="Go upstairs">
          <span class="town-label__icon" aria-hidden="true">🪜</span>
          <span class="town-label__text">Upstairs (2F)</span>
        </button>
        <button type="button" class="town-label" data-id="shop-jukebox" aria-label="Pick a song on the jukebox">
          <span class="town-label__icon" aria-hidden="true">🎵</span>
          <span class="town-label__text">Jukebox</span>
        </button>
        <button type="button" class="town-label" data-id="shop-closet" aria-label="Browse the closet">
          <span class="town-label__icon" aria-hidden="true">🚪</span>
          <span class="town-label__text">The Closet</span>
        </button>
        <button type="button" class="town-label" data-id="home2f-fridge" aria-label="Leave a note on the fridge" style="display:none;">
          <span class="town-label__icon" aria-hidden="true">🧊</span>
          <span class="town-label__text">Smart Fridge</span>
        </button>
        <button type="button" class="town-label" data-id="home2f-tv" aria-label="Turn on the TV" style="display:none;">
          <span class="town-label__icon" aria-hidden="true">📺</span>
          <span class="town-label__text">Retro TV</span>
        </button>
        <button type="button" class="town-label" data-id="home2f-twin" aria-label="Talk to the Digital Twin" style="display:none;">
          <span class="town-label__icon" aria-hidden="true">🤖</span>
          <span class="town-label__text">Digital Twin</span>
        </button>
        <button type="button" class="town-label" data-id="home2f-computer" aria-label="Sit at the computer" style="display:none;">
          <span class="town-label__icon" aria-hidden="true">💻</span>
          <span class="town-label__text">Workstation</span>
        </button>
        <button type="button" class="town-label" data-id="home2f-stairs-down" aria-label="Go downstairs" style="display:none;">
          <span class="town-label__icon" aria-hidden="true">🪜</span>
          <span class="town-label__text">Downstairs</span>
        </button>
      </>
    ) : currentPlace === 'dev' ? (
      <>
        <button type="button" class="town-label" data-id="timeline" aria-label="Open the mission timeline">
          <span class="town-label__icon" aria-hidden="true">🖥️</span>
          <span class="town-label__text">Viewscreen</span>
        </button>
        <button type="button" class="town-label" data-id="radar" aria-label="Scan the stack">
          <span class="town-label__icon" aria-hidden="true">📡</span>
          <span class="town-label__text">Stack Radar</span>
        </button>
        <button type="button" class="town-label" data-id="telemetry" aria-label="Read the telemetry">
          <span class="town-label__icon" aria-hidden="true">📊</span>
          <span class="town-label__text">Telemetry</span>
        </button>
        <button type="button" class="town-label town-label--snorlax-nameplate" data-id="snorlax" aria-label="Snorlax Desk Nameplate">
          SNORLAX
        </button>
        <button type="button" class="town-label town-label--coffee" data-id="coffee" aria-label="Drink Robusta Coffee">
          <span class="town-label__icon" aria-hidden="true">☕</span>
          <span class="town-label__text">Coffee</span>
        </button>
        <button type="button" class="town-label town-label--rack" data-id="rack" aria-label="Check Server Rack">
          <span class="town-label__icon" aria-hidden="true">🗄️</span>
          <span class="town-label__text">Server Rack</span>
        </button>
      </>
    ) : currentPlace === 'lab' ? (
      <>
        <button type="button" class="town-label" data-id="lab-posters" aria-label="Read the poster wall">
          <span class="town-label__icon" aria-hidden="true">📋</span>
          <span class="town-label__text">Poster Wall</span>
        </button>
        <button type="button" class="town-label" data-id="lab-whiteboard" aria-label="Read the whiteboard">
          <span class="town-label__icon" aria-hidden="true">🧠</span>
          <span class="town-label__text">Whiteboard</span>
        </button>
        <button type="button" class="town-label" data-id="lab-bench" aria-label="Look over the lab bench">
          <span class="town-label__icon" aria-hidden="true">🔬</span>
          <span class="town-label__text">Lab Bench</span>
        </button>
      </>
    ) : currentPlace === 'arcade' ? (
      <>
        <button type="button" class="town-label town-label--deoxys" data-id="robot" aria-label="Talk to Deoxys">
          <span class="town-label__icon" aria-hidden="true">🌌</span>
          <span class="town-label__text">Deoxys</span>
        </button>
      </>
    ) : currentPlace === 'reception' ? (
      <>
        <button type="button" class="town-label town-label--npc" data-id="mira" aria-label="Talk to Nurse Mira">
