      if (!minimapCanvas || !engine) return;
      const rect = minimapCanvas.getBoundingClientRect();
      const clickX = (e.clientX - rect.left) * (minimapCanvas.width / rect.width);
      const clickY = (e.clientY - rect.top) * (minimapCanvas.height / rect.height);
      const map = engine.getMap();
      const scale = 2; // 2 px per tile
      const tileX = Math.max(0, Math.min(map.w - 1, Math.floor(clickX / scale)));
      const tileY = Math.max(0, Math.min(map.h - 1, Math.floor(clickY / scale)));

      if (e.shiftKey) {
        engine.flyTo(tileX, tileY, 'Radar Mini-Map');
        showToast(`🦅 Terbang ke (${tileX}, ${tileY}) lewat radar!`);
      } else {
