  data-place-rooms={JSON.stringify(dataPlaceRooms)}
  data-scene={currentPlace === 'about' ? 'home' : currentPlace === 'dev' ? 'dev' : currentPlace === 'lab' ? 'lab' : currentPlace === 'arcade' ? 'arcade' : currentPlace === 'reception' ? 'reception' : currentPlace === 'mart' ? 'mart' : currentPlace === 'tower' ? 'tower' : currentPlace === 'cafe' ? 'cafe' : currentPlace === 'arena' ? 'arena' : currentPlace === 'garden' ? 'garden' : currentPlace === 'neighbour' ? 'neighbour' : currentPlace === 'digimon' ? 'digimon' : currentPlace === 'kingdom' ? 'kingdom' : currentPlace === 'harbour' ? 'harbour' : currentPlace === 'sky-castle' ? 'sky-castle' : currentPlace === 'dark-castle' ? 'dark-castle' : currentPlace === 'dark-cathedral' ? 'dark-cathedral' : currentPlace === 'dark-forge' ? 'dark-forge' : currentPlace === 'dark-manor' ? 'dark-manor' : currentPlace === 'dark-vault' ? 'dark-vault' : currentPlace.startsWith('kingdom-') || currentPlace.startsWith('harbour-') || (currentPlace.startsWith('sky-') && currentPlace !== 'sky-castle') ? currentPlace : 'town'}
  data-retro={currentPlace === 'about' || currentPlace === 'dev' || currentPlace === 'lab' || currentPlace === 'arcade' || currentPlace === 'reception' || currentPlace === 'mart' || currentPlace === 'tower' || currentPlace === 'cafe' || currentPlace === 'arena' || currentPlace === 'garden' || currentPlace === 'neighbour' ? '' : undefined}
>
