    <span id="pokeride-hud-icon" class="text-sm">🏇</span>
    <div class="flex flex-col leading-tight pr-1">
      <div class="flex items-center gap-1.5">
        <span id="pokeride-hud-name" class="font-bold text-amber-300 text-[11px]">Poké Ride</span>
        <span
          id="pokeride-hud-badge"
          class="px-1.5 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider bg-amber-500/20 text-amber-200 border border-amber-400/40"
        >
          ⚡ Terra Charge
        </span>
      </div>
      <span id="pokeride-hud-sub" class="text-[9px] text-slate-300 hidden sm:inline">
        Kecepatan Tinggi Aktif
      </span>
    </div>
    <button
      type="button"
      id="btn-pokeride-skill"
      class="px-2 py-1 rounded-full bg-cyan-500/20 hover:bg-cyan-500/35 text-cyan-200 border border-cyan-400/40 text-[10px] font-bold transition cursor-pointer"
      title="Gunakan Skill Visual Burst (Tekan X)"
    >
      ⚡ Skill (X)
    </button>
    <button
      type="button"
      id="btn-pokeride-dismount"
      class="px-2.5 py-1 rounded-full bg-rose-500/25 hover:bg-rose-500/40 text-rose-200 border border-rose-400/40 text-[10px] font-bold transition cursor-pointer"
      title="Turun dari Pokémon (Tekan R)"
    >
      👟 Turun (R)
    </button>
  </div>

  <!-- Floating Mini-Map Radar Widget -->
  <div id="town-editor-minimap" class="town-editor-minimap hidden" style="display: none;" role="region" aria-label="Radar Kota 2D">
    <div class="town-editor-minimap__header">
      <span class="town-editor-minimap__title" id="town-minimap-title">🧭 RADAR KOTA</span>
      <div class="flex items-center gap-1">
        <button type="button" id="btn-minimap-toggle" class="town-editor-minimap__toggle" title="Minimalkan / Munculkan Radar">🔽</button>
        <button type="button" id="btn-minimap-close" class="town-editor-minimap__toggle hover:text-rose-400" title="Tutup Radar">✕</button>
      </div>
    </div>
    <div id="town-minimap-body" class="town-editor-minimap__body">
      <canvas id="town-minimap-canvas" width="90" height="128" class="town-minimap-canvas cursor-pointer" title="Klik untuk jalan • Shift+Klik untuk terbang"></canvas>
    </div>
    <div id="town-minimap-hint" class="px-2 pb-1.5 text-[9px] font-mono text-cyan-200/70 text-center tracking-tight">
      Klik: Jalan • Shift: Terbang
    </div>
  </div>

  <noscript>
    <p class="town-noscript">The town needs JavaScript, but every page works without it. Use the menu above.</p>
  </noscript>
</section>

<script define:vars={{ townData, currentPlace }}>
  window.__TOWN_DATA__ = townData;
  window.__CURRENT_PLACE__ = currentPlace;
</script>

<script>
  import { TownEngine } from '../engine/TownEngine';
  import { sfx } from '../game/sfx';
  import { townConfig, type TileTypeKey, SPAWNABLE_TEMPLATES } from '../engine/townConfig';
  import { requestDigimonSprites } from '../engine/digiSpriteLoader';
  import { COMPANIONS_MAP } from '../engine/pokemonCompanions';
  import { gameStore } from '../game/store';

  let engine: TownEngine | null = null;

  function initTown() {
    const canvas = document.getElementById('town-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    const spawnPlace = (window as unknown as { __CURRENT_PLACE__: string }).__CURRENT_PLACE__ || 'town';
    townConfig.setActiveWorld(spawnPlace === 'digimon' ? 'digimon' : 'town');
    townConfig.loadFromStorage();

    const bubble = document.querySelector('[data-town-bubble]') as HTMLDivElement | null;
    let bubbleActionLink: HTMLAnchorElement | HTMLButtonElement | null = null;

    const editorToast = document.getElementById('town-editor-toast');
    const showToast = (msg: string) => {
      if (!editorToast) return;
      editorToast.textContent = msg;
      editorToast.classList.remove('hidden');
      editorToast.classList.add('is-visible');
      window.setTimeout(() => {
        editorToast.classList.remove('is-visible');
        editorToast.classList.add('hidden');
      }, 3000);
    };

    window.addEventListener('town:editor-toast', ((e: CustomEvent<string>) => {
      if (e?.detail) showToast(e.detail);
    }) as EventListener);

    const showBubble = (
      title: string,
      text: string,
      action?:
        | { label: string; href?: string; onClick?: () => void }
        | { label: string; href?: string; onClick?: () => void }[]
    ) => {
      if (!bubble) return;
      bubble.innerHTML = '';
      bubbleActionLink = null;

      const strong = document.createElement('strong');
      strong.textContent = title;
      bubble.appendChild(strong);

      const span = document.createElement('span');
      span.textContent = text;
      bubble.appendChild(span);

      const actionsList = Array.isArray(action) ? action : action ? [action] : [];
      if (actionsList.length > 0) {
        const actionWrap = document.createElement('div');
        actionWrap.className = 'town-bubble__actions flex flex-wrap items-center gap-1.5 mt-2';
        for (let idx = 0; idx < actionsList.length; idx++) {
          const act = actionsList[idx];
          if (act.href) {
            const a = document.createElement('a');
            a.className = 'town-bubble__action';
            a.href = act.href;
            a.target = act.href.startsWith('http') ? '_blank' : '_self';
            if (a.target === '_blank') a.rel = 'noopener noreferrer';
            a.textContent = `${act.label} ➜`;
            actionWrap.appendChild(a);
            if (idx === 0) bubbleActionLink = a;
          } else if (act.onClick) {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'town-bubble__action';
            btn.textContent = `${act.label} ➜`;
            btn.onclick = () => {
              hideBubble();
              act.onClick?.();
            };
            actionWrap.appendChild(btn);
            if (idx === 0) bubbleActionLink = btn;
          }
        }
        bubble.appendChild(actionWrap);
      }

      const hint = document.createElement('span');
      hint.className = 'town-bubble__hint';
      hint.innerHTML = 'Press <kbd>Enter</kbd> to open';
      bubble.appendChild(hint);

      const closeBtn = document.createElement('button');
      closeBtn.type = 'button';
      closeBtn.className = 'town-bubble__close';
      closeBtn.setAttribute('aria-label', 'Close message');
      closeBtn.textContent = '×';
      closeBtn.onclick = hideBubble;
      bubble.appendChild(closeBtn);

      bubble.removeAttribute('hidden');
      sfx.select();
    };

    const hideBubble = () => {
      if (bubble) bubble.setAttribute('hidden', '');
      bubbleActionLink = null;
    };

    // Keyboard handlers for bubble
    window.addEventListener(
      'keydown',
      (e) => {
        if (!bubble || bubble.hasAttribute('hidden')) return;

        if (e.key === 'Escape') {
          e.preventDefault();
          hideBubble();
          canvas.focus();
        } else if (e.key === 'Enter' && bubbleActionLink) {
          e.preventDefault();
          bubbleActionLink.click();
          hideBubble();
        }
      },
      { capture: true }
    );

    // Initialize TownEngine
    const townData = (window as unknown as { __TOWN_DATA__: any }).__TOWN_DATA__;

    engine = new TownEngine(canvas, townData, spawnPlace, {
      onDialogue: (name, lines) => {
        showBubble(name, lines.join(' '));
      },
      onBubble: showBubble,
      onNavigate: (route) => {
        if (route === '/town' || route === 'town') route = '/';
        if (route === '/dev') gameStore.addStamp('dev');
        if (route === '/twin') gameStore.addStamp('twin');
        if (route === '/arcade') gameStore.addStamp('arcade');
        window.location.href = route;
      },
      onEncounter: () => {
        document.dispatchEvent(new CustomEvent('town:wild-encounter'));
      },
      onRefill: () => {
        document.dispatchEvent(new CustomEvent('town:refill-balls'));
      },
      onOpenModal: (target) => {
        document.dispatchEvent(new CustomEvent('town:open-modal', { detail: { target } }));
      },
    });

    const townSection = document.querySelector('.town') as HTMLElement | null;
    if (townSection && window.ResizeObserver) {
      new ResizeObserver(() => {
        engine?.handleResize();
      }).observe(townSection);
    }
    const labelButtons = document.querySelectorAll<HTMLButtonElement>('.town-label');
    labelButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id');
        if (id && engine) {
          hideBubble();
          engine.walkToObject(id);
          if (id === 'kiosk') {
            engine.interactFacing('kiosk');
          } else if (id === 'arena') {
            engine.interactFacing('arena');
          } else if (id === 'berry' || id === 'garden') {
            engine.interactFacing('berry');
          } else if (id === 'villa' || id === 'neighbour') {
            engine.interactFacing('neighbour');
          }
          canvas.focus();
        }
      });
    });

    // Floor Chip Click Listener (toggle 1F <-> 2F)
    const floorChip = document.querySelector('[data-floor-chip]') as HTMLElement | null;
    if (floorChip) {
      floorChip.style.cursor = 'pointer';
      floorChip.title = 'Click to switch floor (1F / 2F)';
      floorChip.addEventListener('click', () => {
        if (engine) {
          hideBubble();
          const next = engine.getHomeFloor() === '1F' ? '2F' : '1F';
          engine.switchHomeFloor(next);
        }
      });
    }

    // Town Room Guide
    const guide = document.querySelector('[data-town-guide]') as HTMLElement | null;
    const guideToggle = document.querySelector('[data-town-guide-toggle]') as HTMLButtonElement | null;
    const guideCard = document.getElementById('town-guide-card');
    const guideClose = document.querySelector('[data-town-guide-close]');

    if (guide && guideToggle && guideCard) {
      guide.removeAttribute('hidden');

      guideToggle.addEventListener('click', () => {
        const expanded = guideToggle.getAttribute('aria-expanded') === 'true';
        if (expanded) {
          guideToggle.setAttribute('aria-expanded', 'false');
          guideCard.setAttribute('hidden', '');
        } else {
          guideToggle.setAttribute('aria-expanded', 'true');
          guideCard.removeAttribute('hidden');
          sfx.select();
        }
      });

      guideClose?.addEventListener('click', () => {
        guideToggle.setAttribute('aria-expanded', 'false');
        guideCard.setAttribute('hidden', '');
      });
    }

    // Town HUD Action Buttons
    const btnOpenPalette = document.getElementById('btn-open-palette');
    const burgerItemSearch = document.getElementById('burger-item-search');

    btnOpenPalette?.addEventListener('click', () => {
      sfx.select();
      window.dispatchEvent(new CustomEvent('town:open-command-palette'));
    });

    burgerItemSearch?.addEventListener('click', () => {
      sfx.select();
      toggleBurger(false);
      window.dispatchEvent(new CustomEvent('town:open-command-palette'));
    });

    // Dev Tools Popover
    const btnToggleDevMenu = document.getElementById('btn-toggle-dev-menu');
    const townDevPopover = document.getElementById('town-dev-popover');

    btnToggleDevMenu?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isHidden = townDevPopover?.classList.toggle('hidden');
      if (townDevPopover) {
        townDevPopover.style.display = isHidden ? 'none' : 'flex';
      }
      btnToggleDevMenu.classList.toggle('is-active', !isHidden);
    });

    document.addEventListener('click', (e) => {
      if (townDevPopover && !townDevPopover.classList.contains('hidden')) {
        const target = e.target as HTMLElement;
        if (!target.closest('.town-dev-wrap')) {
          townDevPopover.classList.add('hidden');
          townDevPopover.style.display = 'none';
          btnToggleDevMenu?.classList.remove('is-active');
        }
      }
    });

    const btnToggleXray = document.getElementById('btn-toggle-xray');
    const burgerItemXray = document.getElementById('burger-item-xray');
    const townXrayBar = document.getElementById('town-xray-bar');
    const btnXrayClose = document.getElementById('btn-xray-close');
    const btnXraySave = document.getElementById('btn-xray-save');
    const btnXrayPurgeHidden = document.getElementById('btn-xray-purge-hidden');

    btnToggleXray?.addEventListener('click', () => {
      townDevPopover?.classList.add('hidden');
      if (townDevPopover) townDevPopover.style.display = 'none';
      btnToggleDevMenu?.classList.remove('is-active');
      engine?.toggleXray();
    });

    btnXrayPurgeHidden?.addEventListener('click', () => {
      const count = townConfig.purgeAllHiddenBuildings();
      sfx.confirm();
      window.dispatchEvent(
        new CustomEvent('town:editor-toast', {
          detail: count > 0
            ? `🗑️ Berhasil menghapus permanen ${count} objek tersembunyi!`
            : 'ℹ️ Tidak ada objek tersembunyi yang tersisa di peta.',
        })
      );
      engine?.wake();
    });

    btnXrayClose?.addEventListener('click', () => {
      if (engine?.isXray()) {
        engine.toggleXray();
      }
    });

    btnXraySave?.addEventListener('click', async () => {
      townConfig.saveToStorage();
      try {
        const res = await townConfig.saveToDisk();
        sfx.confirm();
        window.dispatchEvent(
          new CustomEvent('town:editor-toast', {
            detail: res?.success ? '💾 Perubahan peta berhasil disimpan ke disk!' : '💾 Disimpan ke memori browser (localStorage)!',
          })
        );
      } catch {
        sfx.confirm();
        window.dispatchEvent(
          new CustomEvent('town:editor-toast', {
            detail: '💾 Perubahan peta berhasil disimpan ke browser!',
          })
        );
      }
    });

    const toggleLabelsBtn = document.getElementById('btn-toggle-labels');
    const labelsContainer = document.querySelector('[data-town-labels]');
    const burgerItemLabels = document.getElementById('burger-item-labels');

    const toggleLabels = () => {
      if (!labelsContainer) return;
      const isHidden = labelsContainer.classList.toggle('town-labels--hidden');
      if (toggleLabelsBtn) {
        toggleLabelsBtn.classList.toggle('is-active', !isHidden);
        const iconSpan = toggleLabelsBtn.querySelector('.town-hud-btn__icon');
        if (iconSpan) iconSpan.textContent = isHidden ? '🙈' : '🏷️';
      }
      if (burgerItemLabels) {
        burgerItemLabels.classList.toggle('is-active', !isHidden);
      }
      sfx.select();
      showToast(isHidden ? '🏷️ Label landmark disembunyikan (Tekan L)' : '🏷️ Label landmark ditampilkan (Tekan L)');
    };

    toggleLabelsBtn?.addEventListener('click', toggleLabels);

    const recenterCamera = () => {
      engine?.recenterCamera();
      sfx.select();
      showToast('🎯 Kamera difokuskan ke karakter.');
    };

    const recenterBtn = document.getElementById('btn-recenter');
    recenterBtn?.addEventListener('click', recenterCamera);

    const zoomResetBtn = document.getElementById('town-zoom-reset');
    zoomResetBtn?.addEventListener('click', recenterCamera);

    const hudGuideBtn = document.getElementById('btn-hud-guide');
    if (hudGuideBtn && guideToggle) {
      hudGuideBtn.addEventListener('click', () => {
        guideToggle.click();
      });
    }

    // Fullscreen Controls (HUD & Town Editor)
    const btnToggleFullscreen = document.getElementById('btn-toggle-fullscreen');
    const btnEditorFullscreen = document.getElementById('btn-editor-fullscreen');

    const toggleFullscreen = () => {
      const townSection = document.querySelector('.town') as HTMLElement | null;
      const target = townSection || document.documentElement;

      if (!document.fullscreenElement) {
        if (target.requestFullscreen) {
          target.requestFullscreen().catch(() => {});
        } else if ((target as any).webkitRequestFullscreen) {
          (target as any).webkitRequestFullscreen();
        } else if ((target as any).msRequestFullscreen) {
          (target as any).msRequestFullscreen();
        }
      } else {
        if (document.exitFullscreen) {
          document.exitFullscreen().catch(() => {});
        } else if ((document as any).webkitExitFullscreen) {
          (document as any).webkitExitFullscreen();
        } else if ((document as any).msExitFullscreen) {
          (document as any).msExitFullscreen();
        }
      }
      sfx.select();
    };

    const updateFullscreenUI = () => {
      const isFs = !!document.fullscreenElement;
      if (btnToggleFullscreen) {
        btnToggleFullscreen.classList.toggle('is-active', isFs);
        const icon = btnToggleFullscreen.querySelector('.town-hud-btn__icon');
        const label = btnToggleFullscreen.querySelector('.town-hud-btn__label');
        if (icon) icon.textContent = isFs ? '🗗' : '⛶';
        if (label) label.textContent = isFs ? 'Exit FS' : 'Fullscreen';
        btnToggleFullscreen.setAttribute('title', isFs ? 'Exit Fullscreen (Press F)' : 'Toggle Fullscreen (Press F)');
      }
      if (btnEditorFullscreen) {
        btnEditorFullscreen.classList.toggle('is-active', isFs);
        btnEditorFullscreen.innerHTML = isFs
          ? '🗗 <span class="hidden sm:inline">Normal</span>'
          : '⛶ <span class="hidden sm:inline">Fullscreen</span>';
        btnEditorFullscreen.setAttribute('title', isFs ? 'Exit Fullscreen (Press F)' : 'Mode Layar Penuh / Fullscreen (F)');
      }
      window.setTimeout(() => {
        engine?.handleResize();
      }, 60);
    };

    btnToggleFullscreen?.addEventListener('click', toggleFullscreen);
    btnEditorFullscreen?.addEventListener('click', toggleFullscreen);

    document.addEventListener('fullscreenchange', updateFullscreenUI);
    document.addEventListener('webkitfullscreenchange', updateFullscreenUI);

    // Town Editor Controls
    const btnToggleEditor = document.getElementById('btn-toggle-editor');
    const burgerItemEditor = document.getElementById('burger-item-editor');
    const canAccessEditor = true;

    const toggleTownEditor = () => {
      if (!engine) return;
      if (engine.getScene() !== 'town' && engine.getScene() !== 'digimon') {
        showToast('🛠️ Town Editor aktif di Peta Kota & Digi-Sanctuary. Mengalihkan ke Kota...');
        sfx.select();
        setTimeout(() => {
          sessionStorage.setItem('town:respawn', '22,28');
          sessionStorage.setItem('town:open-editor', 'true');
          window.location.href = '/';
        }, 350);
        return;
      }
      const editor = engine.getEditor();
      if (!editor) return;
      if (editor.isPlaytesting()) {
        editor.togglePlaytest();
        sfx.select();
        return;
      }
      editor.toggleEnabled();
      sfx.select();
    };

    btnToggleEditor?.addEventListener('click', toggleTownEditor);
    window.addEventListener('town:toggle-editor', toggleTownEditor);

    // ─── Retro Hamburger Navigation Menu (Menu Burger) ───
    const btnTownBurger = document.getElementById('btn-town-burger');
    const burgerDropdown = document.getElementById('town-burger-dropdown');
    const btnBurgerClose = document.getElementById('btn-burger-close');

    const burgerItemRecenter = document.getElementById('burger-item-recenter');
    const burgerItemGuide = document.getElementById('burger-item-guide');
    const burgerItemFullscreen = document.getElementById('burger-item-fullscreen');

    const closeBurgerMenu = () => {
      if (!burgerDropdown) return;
      burgerDropdown.classList.add('hidden');
      burgerDropdown.style.display = 'none';
      btnTownBurger?.setAttribute('aria-expanded', 'false');
      btnTownBurger?.classList.remove('is-active');
    };

    const openBurgerMenu = () => {
      if (!burgerDropdown) return;
      burgerDropdown.classList.remove('hidden');
      burgerDropdown.style.display = 'flex';
      btnTownBurger?.setAttribute('aria-expanded', 'true');
      btnTownBurger?.classList.add('is-active');

      const isLabelsActive = !labelsContainer?.classList.contains('town-labels--hidden');
      burgerItemLabels?.classList.toggle('is-active', !!isLabelsActive);
      const isXrayActive = engine?.isXray();
      burgerItemXray?.classList.toggle('is-active', !!isXrayActive);
      const isEditorActive = engine?.getEditor()?.isEnabled();
      burgerItemEditor?.classList.toggle('is-active', !!isEditorActive);

      sfx.select();
    };

    btnTownBurger?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = burgerDropdown && !burgerDropdown.classList.contains('hidden') && burgerDropdown.style.display !== 'none';
      if (isOpen) {
        closeBurgerMenu();
      } else {
        openBurgerMenu();
      }
    });

    btnBurgerClose?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeBurgerMenu();
    });

    burgerItemXray?.addEventListener('click', () => {
      engine?.toggleXray();
      closeBurgerMenu();
    });

    burgerItemLabels?.addEventListener('click', () => {
      toggleLabels();
      closeBurgerMenu();
    });

    burgerItemRecenter?.addEventListener('click', () => {
      recenterCamera();
      closeBurgerMenu();
    });

    burgerItemGuide?.addEventListener('click', () => {
      guideToggle?.click();
      closeBurgerMenu();
    });

    burgerItemEditor?.addEventListener('click', () => {
      toggleTownEditor();
      closeBurgerMenu();
    });

    burgerItemFullscreen?.addEventListener('click', () => {
      toggleFullscreen();
      closeBurgerMenu();
    });

    // ─── HUD Minimize & Desktop Burger Mode Handlers ───
    const HUD_MINIMIZED_KEY = 'town:hud-minimized';
    const HUD_BURGER_MODE_KEY = 'town:hud-burger-mode';

    const townHudBar = document.querySelector('.town-hud-bar');
    const btnScenePill = document.getElementById('btn-scene-pill');
    const btnMinimizeHud = document.getElementById('btn-minimize-hud');
    const townHudRestoreBtn = document.getElementById('town-hud-restore-btn');
    const burgerItemToggleHud = document.getElementById('burger-item-toggle-hud');
    const burgerItemToggleMode = document.getElementById('burger-item-toggle-mode');
    const burgerHudTitle = document.getElementById('burger-hud-title');
    const burgerHudIcon = document.getElementById('burger-hud-icon');
    const burgerModeTitle = document.getElementById('burger-mode-title');
    const burgerModeSub = document.getElementById('burger-mode-sub');

    let isHudMinimized = localStorage.getItem(HUD_MINIMIZED_KEY) === 'true';
    let isHudBurgerMode = localStorage.getItem(HUD_BURGER_MODE_KEY) === 'true';

    const applyHudState = () => {
      if (!townHudBar) return;
      townHudBar.classList.toggle('is-minimized', isHudMinimized);
      townHudRestoreBtn?.classList.toggle('hidden', !isHudMinimized);
      townHudBar.classList.toggle('is-burger-mode', isHudBurgerMode);

      if (burgerHudTitle && burgerHudIcon) {
        if (isHudMinimized) {
          burgerHudTitle.textContent = 'Tampilkan Bar Atas';
          burgerHudIcon.textContent = '▼';
        } else {
          burgerHudTitle.textContent = 'Minimalkan Bar Atas';
          burgerHudIcon.textContent = '▲';
        }
      }

      if (burgerModeTitle && burgerModeSub) {
        if (isHudBurgerMode) {
          burgerModeTitle.textContent = 'Mode Bar Lengkap';
          burgerModeSub.textContent = 'Tampilkan semua tombol di bar atas';
        } else {
          burgerModeTitle.textContent = 'Mode Menu Burger';
          burgerModeSub.textContent = 'Sembunyikan tombol ke menu ringkas';
        }
      }
    };

    const toggleMinimizeHud = () => {
      isHudMinimized = !isHudMinimized;
      localStorage.setItem(HUD_MINIMIZED_KEY, String(isHudMinimized));
      applyHudState();
      sfx.select();
      window.dispatchEvent(
        new CustomEvent('town:editor-toast', {
          detail: isHudMinimized
            ? '👁️ Bar atas diminimalkan. Klik pill atau tekan H untuk mengembalikan.'
            : '👁️ Bar atas ditampilkan kembali.',
        })
      );
    };

    const toggleBurgerMode = () => {
      isHudBurgerMode = !isHudBurgerMode;
      localStorage.setItem(HUD_BURGER_MODE_KEY, String(isHudBurgerMode));
      applyHudState();
      sfx.select();
      window.dispatchEvent(
        new CustomEvent('town:editor-toast', {
          detail: isHudBurgerMode
            ? '☰ Mode Menu Burger aktif (Tombol diringkas).'
            : '🖥️ Mode Bar Lengkap aktif (Semua tombol ditampilkan).',
        })
      );
    };

    btnMinimizeHud?.addEventListener('click', toggleMinimizeHud);
    townHudRestoreBtn?.addEventListener('click', toggleMinimizeHud);
    btnScenePill?.addEventListener('click', () => {
      if (isHudMinimized) {
        toggleMinimizeHud();
      } else {
        btnTownBurger?.click();
      }
    });

    burgerItemToggleHud?.addEventListener('click', () => {
      closeBurgerMenu();
      toggleMinimizeHud();
    });

    burgerItemToggleMode?.addEventListener('click', () => {
      closeBurgerMenu();
      toggleBurgerMode();
    });

    // Initialize HUD state
    applyHudState();

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
