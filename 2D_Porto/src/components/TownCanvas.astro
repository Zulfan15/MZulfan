        burgerPokeRideIcon.textContent = active ? '🏇' : '🐾';
      }

      if (pokeRideHud) {
        if (active && follower) {
          pokeRideHud.classList.remove('hidden');
          pokeRideHud.style.display = 'inline-flex';
          applyPokeRideMinimizeState();
          if (pokeRideHudIcon) pokeRideHudIcon.textContent = follower.icon || '🏇';
          if (pokeRideHudName) pokeRideHudName.textContent = follower.name;
          if (pokeRideHudBadge) {
            if (rideClass === 'sky') {
              pokeRideHudBadge.textContent = '✈️ Sky Soar';
              pokeRideHudBadge.className =
                'px-1.5 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider bg-indigo-500/25 text-indigo-200 border border-indigo-400/50';
            } else if (rideClass === 'surf') {
              pokeRideHudBadge.textContent = '🌊 Aqua Surf';
              pokeRideHudBadge.className =
                'px-1.5 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider bg-cyan-500/25 text-cyan-200 border border-cyan-400/50';
            } else {
              pokeRideHudBadge.textContent = '⚡ Terra Charge';
              pokeRideHudBadge.className =
                'px-1.5 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider bg-amber-500/25 text-amber-200 border border-amber-400/50';
            }
          }
          if (pokeRideHudSub) {
            pokeRideHudSub.textContent =
              rideClass === 'sky'
                ? 'Terbang Lintas Air & Pagar'
                : rideClass === 'surf'
                ? 'Selancar Lintas Perairan'
                : 'Kecepatan Sprint Darat';
          }
        } else {
          pokeRideHud.classList.add('hidden');
          pokeRideHud.style.display = 'none';
        }
      }
    });

    // ─── 🌤️ Atmosphere (Day / Sunset / Night), 🌸 Cuaca & 🎵 BGM Controls ───
    const btnToggleTime = document.getElementById('btn-toggle-time');
    const hudTimeIcon = document.getElementById('hud-time-icon');
    const hudTimeLabel = document.getElementById('hud-time-label');
    const burgerItemTime = document.getElementById('burger-item-time');
    const burgerTimeIcon = document.getElementById('burger-time-icon');
    const burgerTimeSub = document.getElementById('burger-time-sub');

    const btnToggleWeather = document.getElementById('btn-toggle-weather');
    const hudWeatherIcon = document.getElementById('hud-weather-icon');
    const hudWeatherLabel = document.getElementById('hud-weather-label');
    const burgerItemWeather = document.getElementById('burger-item-weather');
    const burgerWeatherIcon = document.getElementById('burger-weather-icon');
    const burgerWeatherSub = document.getElementById('burger-weather-sub');

    const burgerItemBgm = document.getElementById('burger-item-bgm');
    const burgerBgmIcon = document.getElementById('burger-bgm-icon');
    const burgerBgmSub = document.getElementById('burger-bgm-sub');

    const updateTimeUI = (atmo: 'day' | 'sunset' | 'night') => {
      const icon = atmo === 'day' ? '☀️' : atmo === 'sunset' ? '🌅' : '🌙';
      const label = atmo === 'day' ? 'Siang' : atmo === 'sunset' ? 'Senja' : 'Malam';
      if (hudTimeIcon) hudTimeIcon.textContent = icon;
      if (hudTimeLabel) hudTimeLabel.textContent = label;
      if (burgerTimeIcon) burgerTimeIcon.textContent = icon;
      if (burgerTimeSub) burgerTimeSub.textContent = `${label} (${icon})`;
      if (btnToggleTime) {
        btnToggleTime.title = `Waktu Kota: ${label} (Klik untuk berganti)`;
      }
    };

    const updateWeatherUI = (weather: 'petals' | 'rain' | 'stars') => {
      const icon = weather === 'petals' ? '🌸' : weather === 'rain' ? '🌧️' : '✨';
      const label = weather === 'petals' ? 'Sakura' : weather === 'rain' ? 'Hujan' : 'Bintang';
      if (hudWeatherIcon) hudWeatherIcon.textContent = icon;
      if (hudWeatherLabel) hudWeatherLabel.textContent = label;
      if (burgerWeatherIcon) burgerWeatherIcon.textContent = icon;
      if (burgerWeatherSub) burgerWeatherSub.textContent = `${label} (${icon})`;
      if (btnToggleWeather) {
        btnToggleWeather.title = `Cuaca: ${label} (Klik untuk berganti)`;
      }
    };

    const updateBgmBurgerUI = (active: boolean) => {
      if (burgerBgmIcon) burgerBgmIcon.textContent = active ? '🎵' : '🔇';
      if (burgerBgmSub) burgerBgmSub.textContent = active ? 'Aktif (Lo-Fi 8-Bit)' : 'Mute / Hening';
      if (burgerItemBgm) {
        burgerItemBgm.classList.toggle('is-active', active);
      }
    };

    // Initial sync
    if (engine) {
      updateTimeUI(engine.townAtmosphere);
      updateWeatherUI(engine.weather);
    }
    updateBgmBurgerUI(sfx.isBgmEnabled());

    btnToggleTime?.addEventListener('click', () => {
      if (engine) {
        const atmo = engine.cycleAtmosphere();
        updateTimeUI(atmo);
        const name = atmo === 'day' ? 'Siang Cerah ☀️' : atmo === 'sunset' ? 'Senja Keemasan 🌅' : 'Malam Bintang 🌙';
        showToast(`🌤️ Waktu berganti ke mode ${name}!`);
      }
    });

    burgerItemTime?.addEventListener('click', () => {
      if (engine) {
        const atmo = engine.cycleAtmosphere();
        updateTimeUI(atmo);
        const name = atmo === 'day' ? 'Siang Cerah ☀️' : atmo === 'sunset' ? 'Senja Keemasan 🌅' : 'Malam Bintang 🌙';
        showToast(`🌤️ Waktu berganti ke mode ${name}!`);
        toggleBurger(false);
      }
    });

    btnToggleWeather?.addEventListener('click', () => {
      if (engine) {
        const w = engine.cycleWeather();
        updateWeatherUI(w);
        const name = w === 'petals' ? 'Kelopak Sakura & Daun 🌸' : w === 'rain' ? 'Hujan Rintik Lo-Fi 🌧️' : 'Hujan Meteor & Bintang ✨';
        showToast(`🌦️ Cuaca berganti: ${name}!`);
      }
    });

    burgerItemWeather?.addEventListener('click', () => {
      if (engine) {
        const w = engine.cycleWeather();
        updateWeatherUI(w);
        const name = w === 'petals' ? 'Kelopak Sakura & Daun 🌸' : w === 'rain' ? 'Hujan Rintik Lo-Fi 🌧️' : 'Hujan Meteor & Bintang ✨';
        showToast(`🌦️ Cuaca berganti: ${name}!`);
        toggleBurger(false);
      }
    });

    burgerItemBgm?.addEventListener('click', () => {
      const on = sfx.toggleBgm();
      updateBgmBurgerUI(on);
      if (on) sfx.select();
      window.dispatchEvent(new CustomEvent('town:bgm-toggled', { detail: { enabled: on } }));
      showToast(on ? '🎵 Musik latar 8-Bit Lo-Fi diaktifkan!' : '🔇 Musik latar diheningkan.');
      toggleBurger(false);
    });

    window.addEventListener('town:atmosphere-changed', (e: Event) => {
      const detail = (e as CustomEvent).detail;
      if (detail?.atmosphere) updateTimeUI(detail.atmosphere);
    });

    window.addEventListener('town:weather-changed', (e: Event) => {
      const detail = (e as CustomEvent).detail;
      if (detail?.weather) updateWeatherUI(detail.weather);
    });

    window.addEventListener('town:bgm-toggled', () => {
      updateBgmBurgerUI(sfx.isBgmEnabled());
    });

    if (engine && engine.isWorldScene()) {
      const activeEngine = engine;
      import('../engine/ui/townEditorUi').then(({ initTownEditorUi }) => {
        initTownEditorUi({
          engine: activeEngine,
          showToast,
          isVisitorRadarOpen: () => isVisitorRadarOpen,
        });
      });
    }

    // Global Town Hotkeys
    window.addEventListener('keydown', (e) => {
      if (['INPUT', 'TEXTAREA', 'SELECT'].includes((e.target as HTMLElement)?.tagName)) return;

      const editor = engine?.getEditor();
      const editorActive = editor?.isEnabled() || editor?.isPlaytesting();

      if (editor?.isEnabled() && !editor.isPlaytesting() && e.key === '?') {
        e.preventDefault();
        (document.getElementById('town-editor-shortcuts-modal') as HTMLDialogElement | null)?.showModal();
        return;
      }

      if (!editorActive) {
        if (e.key === 'x' || e.key === 'X') {
          if (e.shiftKey) {
            btnToggleXray?.click();
          } else {
            castPartnerSkill();
          }
        } else if (e.key === 'p' || e.key === 'P') {
          openPartnerHub();
        } else if (e.key === 'u' || e.key === 'U') {
          openPassport();
        } else if (e.key === 'l' || e.key === 'L') {
          toggleLabels();
        } else if (e.key === 'c' || e.key === 'C') {
          recenterCamera();
        } else if (e.key === 'i' || e.key === 'I') {
          guideToggle?.click();
        } else if (e.key === '+' || e.key === '=') {
          engine?.zoomBy(1.15);
        } else if (e.key === '-' || e.key === '_') {
          engine?.zoomBy(0.87);
        } else if (e.key === '0') {
          recenterBtn?.click();
        }
      }

      if (e.key === 'f' || e.key === 'F') {
        toggleFullscreen();
      } else if ((e.key === 'e' || e.key === 'E') && canAccessEditor) {
        toggleTownEditor();
      } else if (e.key === 'h' || e.key === 'H') {
        toggleMinimizeHud();
      }
    });

    // Back to room / POV Exit button
    const povExit = document.querySelector('[data-pov-exit]');
    povExit?.addEventListener('click', () => {
      if (spawnPlace !== 'town') {
        sessionStorage.setItem('town:respawn', townConfig.getExitRespawnForPlace(spawnPlace));
      }
      navigateWithMapTransition('/');
    });

    // Scoreboard event listener
    document.addEventListener('town:scoreboard', () => {
      showBubble(
        'Scoreboard',
        'DEOXYS vs. EVERYONE (W-L-D): EASY: 48-12-4 | MEDIUM: 89-3-2 | HARD: 142-0-0. Deoxys plays FairKalah minimax search.'
      );
    });

    // Tech Gym Challenge Quiz (Mewtwo)
    document.addEventListener('town:arena-quiz', () => {
      const q1 = () => {
        showBubble(
          'Mewtwo · Battle Arena 🔮',
          "MEWTWO (Telepati): 'Uji coba ketajaman logika dimulai... Pertanyaan 1/3: Framework & kuantisasi apa yang digunakan Zulfan untuk pipeline edge AI real-time?'",
          {
            label: '(A) YOLOv8 + TensorRT FP16/INT8',
            onClick: () => q2(),
          }
        );
      };
      const q2 = () => {
        sfx.select();
        showBubble(
          'Mewtwo · Battle Arena 🔮',
          "MEWTWO: 'Resonansi pikiranmu tajam. Pertanyaan 2/3: Arsitektur modern apa yang mentenagai web portofolio Pokémon 2D ini?'",
          {
            label: '(A) Astro + TypeScript Canvas 2D',
            onClick: () => q3(),
          }
        );
      };
      const q3 = () => {
        sfx.select();
        showBubble(
          'Mewtwo · Battle Arena 🔮',
          "MEWTWO: 'Hampir selesai. Pertanyaan Penentu 3/3: Berapa target latensi inferensi yang dipatok Zulfan untuk sistem robot otonom?'",
          {
            label: '(A) Under 15ms real-time throughput',
            onClick: () => win(),
          }
        );
      };
      const win = () => {
        try {
          localStorage.setItem('town:badge:frontier', 'true');
        } catch {}
        gameStore.addStamp('battle');
        sfx.heal();
        showBubble(
          'VICTORY! 🏆 Arena Frontier Badge',
          'MEWTWO: "Pikiranmu terbukti tangguh. Aku mengakui kemampuan teknologi dan logikamu." Kamu berhasil merebut ARENA FRONTIER BADGE & Stempel Battle Arena!'
        );
      };
      q1();
    });

    // Achievement Unlocked Celebration Toast
    window.addEventListener('town:stamp-unlocked', (e: Event) => {
      const detail = (e as CustomEvent).detail;
      if (!detail) return;
      sfx.catchSuccess();
      const m = detail.mission;
      const count = detail.totalStamps;
      if (count === 3) {
        showToast('⭐ VIP RECRUITER UNLOCKED! Bingkai Emas terbuka di Trainer Card (Buka Passport / Dex)');
      } else if (count === 5) {
        showToast('👑 GRAND CHAMPION! Semua 5 Stempel Wisata Zulfan Town berhasil diraih!');
      } else {
        showToast(`🏆 Achievement Unlocked: ${m ? m.icon + ' ' + m.name : 'Stempel Baru'}! (${count}/5 Stempel)`);
      }
    });

    // Poké-Café Barista Stand Event
    document.addEventListener('town:cafe-coffee', () => {
      sfx.heal();
      showBubble(
        'Poké-Café Barista Stand ☕',
        'You enjoyed a hot cup of fresh Dev Roast! The rich aroma of roasted Arabica fills the plaza (+100 Energy for coding & dex exploration).'
      );
    });

    // Virtual Gamepad bindings with smooth continuous walking on hold
    const bindDpad = (id: string, dir: 'up' | 'down' | 'left' | 'right') => {
      const btn = document.getElementById(id);
      if (!btn) return;
      const start = (e: Event) => {
        e.preventDefault();
        engine?.setDirPressed(dir, true);
      };
      const stop = (e: Event) => {
        e.preventDefault();
        engine?.setDirPressed(dir, false);
      };
      btn.addEventListener('pointerdown', start);
      btn.addEventListener('pointerup', stop);
      btn.addEventListener('pointerleave', stop);
      btn.addEventListener('pointercancel', stop);
    };

    bindDpad('dpad-up', 'up');
    bindDpad('dpad-down', 'down');
    bindDpad('dpad-left', 'left');
    bindDpad('dpad-right', 'right');

    const btnInteract = document.getElementById('btn-interact');
    btnInteract?.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      engine?.interactFacing();
    });

    const btnTouchBike = document.getElementById('btn-touch-bike');
    btnTouchBike?.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      if (!engine) return;
      if (engine.isWorldScene() && engine.getActiveFollower() && !engine.isRiding()) {
        engine.togglePokeRide();
      } else {
        engine.toggleBike();
      }
      sfx.select();
    });

    const btnTouchMove = document.getElementById('btn-touch-move');
    btnTouchMove?.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      castPartnerSkill();
    });

    const touchControls = document.getElementById('town-mobile-controls');
    const btnTouchMin = document.getElementById('btn-touchpad-minimize');
    const btnTouchRestore = document.getElementById('btn-touchpad-restore');
    const TOUCHPAD_KEY = 'town_touchpad_collapsed';

    const applyTouchpadCollapsed = (collapsed: boolean) => {
      touchControls?.classList.toggle('is-collapsed', collapsed);
      btnTouchMin?.setAttribute('aria-expanded', String(!collapsed));
    };

    try {
      applyTouchpadCollapsed(localStorage.getItem(TOUCHPAD_KEY) === 'true');
    } catch {}

    btnTouchMin?.addEventListener('click', () => {
      applyTouchpadCollapsed(true);
      try {
        localStorage.setItem(TOUCHPAD_KEY, 'true');
      } catch {}
      sfx.select();
      showToast('👆 Mode Tap-to-Move aktif. Sentuh kanvas untuk berjalan!');
    });

    btnTouchRestore?.addEventListener('click', () => {
      applyTouchpadCollapsed(false);
      try {
        localStorage.setItem(TOUCHPAD_KEY, 'false');
      } catch {}
      sfx.select();
    });

    // Pilar 5: Hydrate Ghost Trainers in Town Square & wire Guestbook / Ghost Toggle
    const burgerItemGuestbook = document.getElementById('burger-item-guestbook');
    const burgerItemGhosts = document.getElementById('burger-item-ghosts');
    const burgerGhostsTitle = document.getElementById('burger-ghosts-title');

    let ghostsEnabled = true;
    try {
      const savedGhostPref = localStorage.getItem(GHOST_ENABLED_STORAGE_KEY);
      if (savedGhostPref === 'false') ghostsEnabled = false;
    } catch {}

    const syncGhostUI = () => {
      engine?.setGhostTrainersEnabled(ghostsEnabled);
      burgerItemGhosts?.classList.toggle('is-active', ghostsEnabled);
      if (burgerGhostsTitle) {
        burgerGhostsTitle.textContent = ghostsEnabled ? 'Ghost Trainers: ON' : 'Ghost Trainers: OFF';
      }
    };

    const toggleGhosts = () => {
      ghostsEnabled = !ghostsEnabled;
      try {
        localStorage.setItem(GHOST_ENABLED_STORAGE_KEY, String(ghostsEnabled));
      } catch {}
      syncGhostUI();
      sfx.select();
      showToast(
        ghostsEnabled
          ? '👻 Ghost Trainers aktif di Fountain Plaza (Klik mereka untuk baca pesan)!'
          : '👻 Ghost Trainers disembunyikan.'
      );
    };

    burgerItemGuestbook?.addEventListener('click', () => {
      toggleBurger(false);
      sfx.select();
      window.dispatchEvent(new CustomEvent('town:open-guestbook'));
    });

    const burgerItemJukebox = document.getElementById('burger-item-jukebox');
    burgerItemJukebox?.addEventListener('click', () => {
      toggleBurger(false);
      sfx.select();
      window.dispatchEvent(new CustomEvent('town:open-jukebox'));
    });

    // Pilar 6: Unlock 8 Tech Gym Badges based on visited room & notify
    const placeToBadge: Record<string, 'cascade' | 'vision' | 'stratos' | 'tactical' | 'heuristic' | 'sanctuary' | 'botanical' | 'empathy'> = {
      dev: 'cascade',
      lab: 'vision',
      tower: 'stratos',
      arena: 'tactical',
      arcade: 'heuristic',
      digimon: 'sanctuary',
      garden: 'botanical',
      reception: 'empathy',
      twin: 'empathy',
    };
    const routeBadge = placeToBadge[spawnPlace];
    if (routeBadge) {
      gameStore.unlockBadge(routeBadge);
    }

    window.addEventListener('town:badge-unlocked', (e: Event) => {
      const detail = (e as CustomEvent<{ badge?: { name?: string; icon?: string }; totalBadges?: number }>).detail;
      if (!detail) return;
      sfx.catchSuccess();
      const count = detail.totalBadges ?? 0;
      if (count >= 8) {
        showToast('🏆 ZULFAN LEAGUE MASTER! Seluruh 8 Tech Gym Badges telah dikumpulkan!');
      } else {
        showToast(`🏅 Gym Badge Earned: ${detail.badge?.icon || ''} ${detail.badge?.name || 'Badge Baru'} (${count}/8)!`);
      }
    });

    burgerItemGhosts?.addEventListener('click', () => {
      toggleBurger(false);
      toggleGhosts();
    });

    window.addEventListener('town:toggle-ghosts', toggleGhosts);
    window.addEventListener('town:guestbook-updated', (e: Event) => {
      const detail = (e as CustomEvent<{ entries?: GuestbookEntry[] }>).detail;
      if (detail?.entries && engine) {
        engine.setGhostTrainers(detail.entries);
      }
    });

    if (engine) {
      syncGhostUI();
      engine.setGhostTrainers(getLocalGuestbookEntries());
      fetchGuestbookEntries().then(({ entries }) => {
        engine?.setGhostTrainers(entries);
      });
    }
  }

  document.addEventListener('DOMContentLoaded', initTown);
  document.addEventListener('astro:page-load', initTown);
</script>
