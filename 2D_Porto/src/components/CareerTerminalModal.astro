    {
      title: 'Database Programming Laboratory Assistant',
      badge: 'LAB TEACHING ASSISTANT',
      period: 'Mar – Jul 2024 · ITENAS Database Lab',
      icon: '🗄️',
      desc: 'Instructed students in relational database modeling, Boyce-Codd normalization, complex SQL joins and stored procedures, and database connectivity with Delphi desktop client applications.',
      curriculum: 'Relational Schema, SQL Optimization, Delphi',
      tools: 'MySQL, Embarcadero Delphi, HeidiSQL',
      students: '55+ Undergraduate Engineers',
      tags: ['Database', 'MySQL', 'Relational Schema', 'Delphi', 'SQL'],
    },
  ];

  function initCareerTerminal() {
    const dialog = document.getElementById('career-terminal-modal') as HTMLDialogElement | null;
    const closeBtn = document.getElementById('btn-close-career-modal');
    const footerCloseBtn = document.getElementById('btn-footer-close-career');
    if (!dialog) return;

    // Tabs
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('.career-tab-btn');
    const panels = {
      labs: document.getElementById('career-panel-labs'),
      internship: document.getElementById('career-panel-internship'),
      passport: document.getElementById('career-panel-passport'),
    };

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tab = btn.getAttribute('data-career-tab') as 'labs' | 'internship' | 'passport';
        if (!tab) return;

        tabButtons.forEach((b) => {
          const isAct = b === btn;
          b.className = isAct
            ? 'career-tab-btn btn btn-sm bg-emerald-600 text-white border border-emerald-400 px-3 py-1 font-bold'
            : 'career-tab-btn btn btn-sm bg-slate-800 text-slate-300 border border-slate-700 hover:border-emerald-500 px-3 py-1';
        });

        Object.entries(panels).forEach(([key, panel]) => {
          if (panel) {
            panel.classList.toggle('hidden', key !== tab);
          }
        });

        sfx.select();
      });
    });

    // Lab item selection
    const labItemButtons = document.querySelectorAll<HTMLButtonElement>('.lab-item-btn');
    const badgeEl = document.getElementById('lab-detail-badge');
    const titleEl = document.getElementById('lab-detail-title');
    const periodEl = document.getElementById('lab-detail-period');
    const iconEl = document.getElementById('lab-detail-icon');
    const descEl = document.getElementById('lab-detail-desc');
    const currEl = document.getElementById('lab-detail-curriculum');
    const toolsEl = document.getElementById('lab-detail-tools');
    const studentsEl = document.getElementById('lab-detail-students');
    const tagsEl = document.getElementById('lab-detail-tags');

    labItemButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.getAttribute('data-lab-idx') || '0', 10);
        const data = LABS_DATA[idx];
        if (!data) return;

        labItemButtons.forEach((b) => {
          const isSelected = b === btn;
          b.className = isSelected
            ? 'lab-item-btn w-full text-left p-2.5 rounded-lg bg-emerald-950/60 border-2 border-emerald-500 text-white font-mono transition-all flex items-start gap-2.5'
            : 'lab-item-btn w-full text-left p-2.5 rounded-lg bg-slate-950 border border-slate-800 hover:border-slate-600 text-slate-300 font-mono transition-all flex items-start gap-2.5';
        });

        if (badgeEl) badgeEl.textContent = data.badge;
        if (titleEl) titleEl.textContent = data.title;
        if (periodEl) periodEl.textContent = data.period;
        if (iconEl) iconEl.textContent = data.icon;
        if (descEl) descEl.textContent = data.desc;
        if (currEl) currEl.textContent = data.curriculum;
        if (toolsEl) toolsEl.textContent = data.tools;
        if (studentsEl) studentsEl.textContent = data.students;

        if (tagsEl) {
          tagsEl.innerHTML = data.tags
            .map((t) => `<span class="chip bg-slate-900 border border-slate-700 text-[10px]">${t}</span>`)
            .join('');
        }

        sfx.blip();
      });
    });

    function openModal() {
      dialog?.showModal();
      sfx.door();
    }

    function closeModal() {
      dialog?.close();
    }

    closeBtn?.addEventListener('click', closeModal);
    footerCloseBtn?.addEventListener('click', closeModal);

    window.addEventListener('tower:open-career-kiosk', openModal);
  }

  document.addEventListener('astro:page-load', initCareerTerminal);
  document.addEventListener('DOMContentLoaded', initCareerTerminal);
</script>

