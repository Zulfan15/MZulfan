---
// CommandPalette.astro — Pokénav Search (lazy-hydrated from /data/palette.json on first open)
---

<dialog id="command-palette-modal" class="sheet pokenav-palette-dialog max-w-xl">
  <!-- Pokénav Header -->
  <div class="sheet-head bg-[#064e3b] text-emerald-100 flex items-center justify-between border-b-2 border-emerald-500/40 px-4 py-2.5">
    <div class="flex items-center gap-2">
      <span class="relative flex h-2.5 w-2.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
      </span>
      <span class="font-pixel text-xs tracking-wider text-emerald-300 uppercase">
        Pokénav Navi-Search
      </span>
      <span class="font-mono text-[9px] px-1.5 py-0.2 rounded bg-emerald-950/80 border border-emerald-500/30 text-emerald-400">
        v3.0
      </span>
    </div>
    <div class="flex items-center gap-2">
      <kbd class="kbd text-[9px] bg-emerald-900/60 border-emerald-700/60 text-emerald-200">ESC</kbd>
      <button id="pokenav-close-btn" type="button" class="text-emerald-300 hover:text-white text-sm p-1 leading-none" aria-label="Close search">
        ✕
      </button>
    </div>
  </div>

  <div class="p-3 bg-[#0a1120] text-slate-100">
    <!-- Search Input Bar -->
    <div class="relative flex items-center mb-2.5">
      <span class="absolute left-3 text-sm text-emerald-400 pointer-events-none select-none">
        🔍
      </span>
      <input
        id="pokenav-search-input"
        type="search"
        placeholder="Ketik keahlian (Rust, Vision), proyek, aksi cepat (CV, Email), atau lokasi..."
        class="w-full pl-9 pr-16 py-2.5 bg-slate-900/90 border border-emerald-500/50 rounded-lg font-mono text-xs text-emerald-200 placeholder-slate-500 focus:outline-none focus:border-emerald-400 focus:ring-1 focus:ring-emerald-400/50 transition-all"
        autocomplete="off"
        spellcheck="false"
      />
      <span class="absolute right-3 text-[10px] font-mono text-slate-400 bg-slate-800 px-1.5 py-0.5 rounded border border-slate-700 pointer-events-none">
        Ctrl+K
      </span>
    </div>

    <!-- Category Filter Chips -->
    <div class="flex items-center gap-1.5 overflow-x-auto pb-2 text-[10px] font-mono scrollbar-none">
      <button type="button" class="pokenav-chip active" data-filter="all">Semua</button>
      <button type="button" class="pokenav-chip" data-filter="action">⚡ Aksi</button>
      <button type="button" class="pokenav-chip" data-filter="skill">💻 Skill</button>
      <button type="button" class="pokenav-chip" data-filter="project">🚀 Proyek</button>
      <button type="button" class="pokenav-chip" data-filter="place">📍 Navigasi</button>
      <button type="button" class="pokenav-chip" data-filter="pokemon">🐾 Pokémon</button>
    </div>

    <!-- Results List View (populated lazily from /data/palette.json) -->
    <div id="pokenav-results-container" class="max-h-[50vh] overflow-y-auto space-y-1.5 pr-1 mt-1 font-sans"></div>

    <!-- Empty State -->
    <div id="pokenav-empty-state" class="hidden py-8 text-center text-slate-400 font-mono text-xs">
      <span class="text-2xl block mb-2">📡</span>
      Tidak ada hasil yang cocok dengan kata kunci Anda.
    </div>

    <!-- Palette Keyboard Footer Hints -->
    <div class="mt-2.5 pt-2 border-t border-slate-800/80 flex items-center justify-between text-[10px] font-mono text-slate-500">
      <div class="flex items-center gap-2">
        <span><kbd class="pokenav-kbd">↑</kbd><kbd class="pokenav-kbd">↓</kbd> Pilih</span>
        <span><kbd class="pokenav-kbd">↵</kbd> Buka</span>
        <span><kbd class="pokenav-kbd">ESC</kbd> Tutup</span>
      </div>
      <span class="text-emerald-500/80">⚡ Instan Recruiter Access</span>
    </div>
  </div>
</dialog>

<style>
  .pokenav-palette-dialog {
    background: #0a1120;
    border: 2px solid #059669;
    box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.8), 0 0 25px rgba(16, 185, 129, 0.25);
    overflow: hidden;
  }
  .pokenav-chip {
    padding: 3px 8px;
    border-radius: 9999px;
    background: rgba(30, 41, 59, 0.8);
    border: 1px solid rgba(51, 65, 85, 0.8);
    color: #94a3b8;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s ease;
  }
  .pokenav-chip:hover {
    color: #e2e8f0;
    border-color: #059669;
  }
  .pokenav-chip.active {
    background: #059669;
    border-color: #10b981;
    color: #ffffff;
    font-weight: 600;
  }
  .pokenav-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 7px 10px;
    border-radius: 8px;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid transparent;
    cursor: pointer;
    transition: all 0.12s ease;
    outline: none;
  }
  .pokenav-item:hover,
  .pokenav-item.is-selected {
    background: rgba(16, 185, 129, 0.14);
    border-color: rgba(16, 185, 129, 0.6);
    box-shadow: 0 0 12px rgba(16, 185, 129, 0.2);
  }
  .pokenav-kbd {
    display: inline-block;
    padding: 1px 4px;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 4px;
    color: #cbd5e1;
    font-size: 9px;
  }
</style>

<script>
  import { navigateWithMapTransition } from '../lib/mapTransition';
  import type { PaletteItem } from '../pages/data/palette.json';

  function escHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function actionLabelFor(actionType: PaletteItem['actionType']): string {
    if (actionType === 'download') return 'Unduh ↗';
    if (actionType === 'copy') return 'Salin 📋';
    if (actionType === 'fly') return 'Terbang 🦅';
    if (actionType === 'toggle-bike') return 'Toggle 🚲';
    if (actionType === 'toggle-minimap') return 'Radar 🧭';
    if (actionType === 'toggle-editor') return 'Editor 🛠️';
    return 'Buka ↵';
  }

  function initCommandPalette() {
    const modal = document.getElementById('command-palette-modal') as HTMLDialogElement | null;
    const input = document.getElementById('pokenav-search-input') as HTMLInputElement | null;
    const closeBtn = document.getElementById('pokenav-close-btn');
    const container = document.getElementById('pokenav-results-container');
    const emptyState = document.getElementById('pokenav-empty-state');
    const chips = document.querySelectorAll<HTMLButtonElement>('.pokenav-chip');

    if (!modal || !input || !container) return;

    let activeFilter = 'all';
    let selectedIndex = 0;
    let loadPromise: Promise<void> | null = null;

    const ensurePaletteLoaded = (): Promise<void> => {
      if (container.childElementCount > 0) return Promise.resolve();
      loadPromise ??= fetch('/data/palette.json')
        .then((res) => (res.ok ? res.json() : []))
        .then((items: PaletteItem[]) => {
          container.innerHTML = items
            .map(
              (item, idx) => `
              <div
                class="pokenav-item group"
                data-palette-item
                data-id="${escHtml(item.id)}"
                data-category="${escHtml(item.category)}"
                data-keywords="${escHtml(item.keywords.toLowerCase())}"
                data-action-type="${escHtml(item.actionType)}"
                data-target="${escHtml(item.target || '')}"
                data-fly-x="${item.flyCoords?.x ?? ''}"
                data-fly-y="${item.flyCoords?.y ?? ''}"
                data-index="${idx}"
                tabindex="0"
                role="option"
              >
                <div class="flex items-center gap-2.5 min-w-0">
                  <span class="pokenav-item-icon text-lg flex-shrink-0 w-8 h-8 rounded flex items-center justify-center bg-slate-800/80 border border-slate-700/60 group-hover:scale-110 transition-transform">${escHtml(item.icon)}</span>
                  <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                      <span class="pokenav-item-title font-pixel text-[11px] text-slate-100 group-hover:text-emerald-300 truncate font-semibold">${escHtml(item.title)}</span>
                      <span class="pokenav-item-badge text-[9px] font-mono px-1 py-0.2 rounded bg-slate-800 text-emerald-400/90 border border-emerald-900/50 flex-shrink-0">${escHtml(item.categoryLabel)}</span>
                    </div>
                    <p class="font-sans text-[10.5px] text-slate-400 group-hover:text-slate-300 truncate mt-0.5 leading-tight">${escHtml(item.desc)}</p>
                  </div>
                </div>
                <span class="pokenav-item-action text-[10px] font-mono px-2 py-0.5 rounded bg-slate-800/60 border border-slate-700/50 text-slate-400 group-hover:bg-emerald-600 group-hover:text-white group-hover:border-emerald-500 transition-all flex-shrink-0 ml-2">${actionLabelFor(item.actionType)}</span>
              </div>`
            )
            .join('');
        })
        .catch(() => {
          loadPromise = null;
        });
      return loadPromise;
    };

    const getVisibleItems = (): HTMLElement[] => {
      return Array.from(container.querySelectorAll<HTMLElement>('[data-palette-item]')).filter(
        (el) => el.style.display !== 'none'
      );
    };

    const updateSelection = (index: number) => {
      const visible = getVisibleItems();
      visible.forEach((el, i) => {
        if (i === index) {
          el.classList.add('is-selected');
          el.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        } else {
          el.classList.remove('is-selected');
        }
      });
      selectedIndex = Math.max(0, Math.min(index, Math.max(0, visible.length - 1)));
    };

    const applyFilterAndSearch = () => {
      const query = input.value.trim().toLowerCase();
      const allItems = container.querySelectorAll<HTMLElement>('[data-palette-item]');
      let matchCount = 0;

      allItems.forEach((item) => {
        const cat = item.getAttribute('data-category') || '';
        const keywords = item.getAttribute('data-keywords') || '';
        const title = (item.querySelector('.pokenav-item-title')?.textContent || '').toLowerCase();
        const desc = (item.querySelector('p')?.textContent || '').toLowerCase();

        const matchCategory = activeFilter === 'all' || cat === activeFilter;
        const matchQuery =
          query === '' ||
          title.includes(query) ||
          desc.includes(query) ||
          keywords.includes(query);

        if (matchCategory && matchQuery) {
          item.style.display = 'flex';
          matchCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (emptyState) {
        emptyState.classList.toggle('hidden', matchCount > 0);
      }

      updateSelection(0);
    };

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        chips.forEach((c) => c.classList.remove('active'));
        chip.classList.add('active');
        activeFilter = chip.getAttribute('data-filter') || 'all';
        applyFilterAndSearch();
      });
    });

    input.addEventListener('input', applyFilterAndSearch);

    modal.addEventListener('keydown', (e) => {
      const visible = getVisibleItems();
      if (visible.length === 0) return;

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        selectedIndex = (selectedIndex + 1) % visible.length;
        updateSelection(selectedIndex);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIndex = (selectedIndex - 1 + visible.length) % visible.length;
        updateSelection(selectedIndex);
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (visible[selectedIndex]) {
          executePaletteItem(visible[selectedIndex]);
        }
      }
    });

    const executePaletteItem = (item: HTMLElement) => {
      const actionType = item.getAttribute('data-action-type');
      const target = item.getAttribute('data-target') || '';
      const flyX = item.getAttribute('data-fly-x');
      const flyY = item.getAttribute('data-fly-y');

      modal.close();

      if (actionType === 'download') {
        if (target) window.open(target, '_blank');
      } else if (actionType === 'copy') {
        if (target) {
          navigator.clipboard?.writeText(target).then(() => {
            window.dispatchEvent(
              new CustomEvent('town:editor-toast', {
                detail: `📋 Berhasil menyalin ke clipboard: ${target}`,
              })
            );
          });
        }
      } else if (actionType === 'fly') {
        if (flyX !== '' && flyY !== '') {
          const x = Number(flyX);
          const y = Number(flyY);
          const isTown = window.location.pathname === '/' || window.location.pathname === '';
          if (isTown) {
            window.dispatchEvent(
              new CustomEvent('town:fly-to', {
                detail: { x, y, name: item.querySelector('.pokenav-item-title')?.textContent?.trim() },
              })
            );
          } else {
            sessionStorage.setItem('town:respawn', `${x},${y}`);
            sessionStorage.setItem('town:fly_anim', '1');
            navigateWithMapTransition('/');
          }
        } else if (target) {
          navigateWithMapTransition(target);
        }
      } else if (actionType === 'navigate') {
        if (target) navigateWithMapTransition(target);
      } else if (actionType === 'modal') {
        if (target) document.dispatchEvent(new CustomEvent('town:open-modal', { detail: { target } }));
      } else if (actionType === 'toggle-bike') {
        window.dispatchEvent(new CustomEvent('town:toggle-bike-request'));
      } else if (actionType === 'toggle-minimap') {
        window.dispatchEvent(new CustomEvent('town:toggle-minimap'));
      } else if (actionType === 'set-atmosphere') {
        if (target) window.dispatchEvent(new CustomEvent('town:set-atmosphere', { detail: { atmosphere: target } }));
      } else if (actionType === 'set-weather') {
        if (target) window.dispatchEvent(new CustomEvent('town:set-weather', { detail: { weather: target } }));
      } else if (actionType === 'toggle-bgm') {
        window.dispatchEvent(new CustomEvent('town:toggle-bgm-request'));
      } else if (actionType === 'set-follower') {
        if (target) window.dispatchEvent(new CustomEvent('town:set-follower', { detail: { followerId: target } }));
      } else if (actionType === 'toggle-editor') {
        window.dispatchEvent(new CustomEvent('town:toggle-editor'));
      } else if (actionType === 'start-tour') {
        const isTown = window.location.pathname === '/' || window.location.pathname === '' || window.location.pathname === '/town/';
        if (isTown) {
          window.dispatchEvent(new CustomEvent('town:start-tour'));
        } else {
          sessionStorage.setItem('town:start_tour', '1');
          navigateWithMapTransition('/');
        }
      } else if (actionType === 'toggle-pokesnap') {
        window.dispatchEvent(new CustomEvent('town:toggle-pokesnap'));
      } else if (actionType === 'trigger-resonance') {
        window.dispatchEvent(new CustomEvent('town:trigger-resonance'));
      } else if (actionType === 'open-guestbook') {
        window.dispatchEvent(new CustomEvent('town:open-guestbook'));
      } else if (actionType === 'toggle-ghosts') {
        window.dispatchEvent(new CustomEvent('town:toggle-ghosts'));
      } else if (actionType === 'open-jukebox') {
        window.dispatchEvent(new CustomEvent('town:open-jukebox'));
      }
    };

    container.addEventListener('click', (e) => {
      const item = (e.target as HTMLElement).closest<HTMLElement>('[data-palette-item]');
      if (item) executePaletteItem(item);
    });

    const openModal = () => {
      modal.showModal();
      input.value = '';
      activeFilter = 'all';
      chips.forEach((c) => c.classList.toggle('active', c.getAttribute('data-filter') === 'all'));
      ensurePaletteLoaded().then(() => {
        applyFilterAndSearch();
      });
      setTimeout(() => input.focus(), 50);
    };

    closeBtn?.addEventListener('click', () => modal.close());
    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });

    window.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (modal.open) {
          modal.close();
        } else {
          openModal();
        }
      }
    });

    window.addEventListener('town:open-command-palette', openModal);
  }

  document.addEventListener('DOMContentLoaded', initCommandPalette);
</script>
