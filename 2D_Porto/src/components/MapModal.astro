---

<dialog id="map-modal" class="sheet max-w-2xl">
  <div class="sheet-head">
    <div class="flex items-center gap-2">
      <span class="text-xl">🗺️</span>
      <div>
        <h2 class="font-pixel text-xs text-ink uppercase tracking-wide">Town Map & Fast Travel</h2>
        <span class="font-mono text-[10px] text-ink-soft">HM02 Fly • Teleportasi Instan ke Titik Kota</span>
      </div>
    </div>
    <button id="map-modal-close" type="button" class="btn btn-sm btn-ghost p-1 text-ink/70 hover:text-ink" aria-label="Close Map">
      ✕
    </button>
  </div>

  <div class="sheet-body space-y-3">
    <!-- Category Filter Tabs -->
    <div class="flex items-center gap-2 border-b border-ink/10 pb-2">
      <button type="button" class="map-tab-btn btn btn-xs btn-primary" data-tab="all">
        Semua ({destinations.length})
      </button>
      <button type="button" class="map-tab-btn btn btn-xs btn-ghost" data-tab="building">
        🏢 Gedung & Ruangan (10)
      </button>
      <button type="button" class="map-tab-btn btn btn-xs btn-ghost" data-tab="landmark">
        🌿 Landmark Terbuka (7)
      </button>
    </div>

    <!-- Destination Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-h-[62vh] overflow-y-auto pr-1">
      {destinations.map((dest) => (
        <div
          class="card p-3 flex flex-col justify-between gap-2.5 border border-ink/15 hover:border-ball/40 transition-colors bg-paper/60 rounded-lg group"
          data-dest-card
          data-dest-category={dest.category}
        >
          <div class="flex items-start gap-2.5">
            <span class="text-2xl p-2 rounded bg-cream/90 border border-ink/20 group-hover:scale-105 transition-transform flex-shrink-0">
              {dest.icon}
            </span>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-1">
                <span class="font-pixel text-[11px] text-ball truncate font-semibold">
                  {dest.name}
                </span>
                <span class="font-mono text-[9px] px-1.5 py-0.5 rounded bg-ink/5 border border-ink/10 text-ink-soft">
                  [{dest.tileX}, {dest.tileY}]
                </span>
              </div>
              <div class="flex items-center gap-1.5 mt-0.5">
                <span class="text-[9px] font-mono px-1 py-0.2 rounded bg-berry/10 text-berry font-medium">
                  {dest.badge}
                </span>
              </div>
              <p class="font-sans text-[11px] text-ink-soft mt-1 leading-snug line-clamp-2">
                {dest.blurb}
              </p>
            </div>
          </div>

          <!-- Dual Action Buttons: Fly & Open Page -->
          <div class="flex items-center gap-1.5 pt-1 border-t border-ink/10 mt-auto">
            <button
              type="button"
              class="map-fly-btn btn btn-xs btn-primary flex-1 flex items-center justify-center gap-1 bg-ball text-white hover:bg-ball/90 shadow-sm"
              data-fly-btn
              data-fly-x={dest.tileX}
              data-fly-y={dest.tileY}
              data-fly-name={dest.name}
              title={`Teleportasi instan ke depan ${dest.name}`}
            >
              <span class="text-xs">🦅</span>
              <span class="font-pixel text-[10px] tracking-wide">Fly Here</span>
            </button>

            {dest.route && (
              <a
                href={dest.route}
                class="btn btn-xs btn-ghost text-[10px] font-mono text-ink-soft hover:text-ink border border-ink/15 hover:bg-ink/5 px-2 no-underline flex items-center gap-0.5"
                title={`Buka halaman bacaan ${dest.name}`}
              >
                <span>🚪</span>
                <span>Buka</span>
              </a>
            )}
          </div>
        </div>
      ))}
    </div>

    <!-- Footer Controls & Hints -->
    <div class="pt-2.5 border-t border-ink/15 flex flex-wrap justify-between items-center text-[10px] font-mono text-ink-soft gap-2">
      <div class="flex items-center gap-1 text-ink/70">
        <span>💡 Klik <b>🦅 Fly Here</b> untuk berpindah instan ke koordinat kanvas</span>
      </div>
      <span>Tekan <kbd class="kbd text-[9px] px-1">ESC</kbd> untuk tutup</span>
    </div>
  </div>
</dialog>

<script>
  function initMapModal() {
    const modal = document.getElementById('map-modal') as HTMLDialogElement;
    const closeBtn = document.getElementById('map-modal-close');

    if (!modal) return;

    // Open listener from HUD button or menu
    document.addEventListener('town:open-modal', (e: Event) => {
      const detail = (e as CustomEvent).detail;
      if (detail?.target === 'map') {
        modal.showModal();
      }
    });

    closeBtn?.addEventListener('click', () => modal.close());

    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });

    // Category Tabs filter
    const tabButtons = modal.querySelectorAll<HTMLButtonElement>('.map-tab-btn');
    const cards = modal.querySelectorAll<HTMLElement>('[data-dest-card]');

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const selectedTab = btn.getAttribute('data-tab');
        tabButtons.forEach((b) => {
          b.classList.remove('btn-primary');
          b.classList.add('btn-ghost');
        });
        btn.classList.add('btn-primary');
        btn.classList.remove('btn-ghost');

        cards.forEach((card) => {
          const category = card.getAttribute('data-dest-category');
          if (selectedTab === 'all' || category === selectedTab) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // Fast travel "Fly Here" button click handler
    const flyButtons = modal.querySelectorAll<HTMLButtonElement>('[data-fly-btn]');
    flyButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const x = Number(btn.getAttribute('data-fly-x'));
        const y = Number(btn.getAttribute('data-fly-y'));
        const name = btn.getAttribute('data-fly-name') || 'Lokasi';

        modal.close();

        const isTown = window.location.pathname === '/' || window.location.pathname === '';
        if (isTown) {
          window.dispatchEvent(
            new CustomEvent('town:fly-to', {
              detail: { x, y, name },
            })
          );
        } else {
          sessionStorage.setItem('town:respawn', `${x},${y}`);
          sessionStorage.setItem('town:fly_anim', '1');
          window.location.href = '/';
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initMapModal);
</script>
