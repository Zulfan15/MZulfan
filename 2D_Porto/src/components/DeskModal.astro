  // Helper formatting functions matching si-dan
  const formatMs = (ms: number | null | undefined): string => {
    if (ms == null) return '–';
    return ms < 1000 ? `${Math.round(ms)}ms` : `${(ms / 1000).toFixed(1)}s`;
  };

  const formatTokens = (t: number | null | undefined): string => {
    if (t == null) return '–';
    return t < 1000 ? String(t) : `${(t / 1000).toFixed(1)}k`;
  };

  const formatPct = (p: number | null | undefined): string => {
    if (p == null) return '–';
    return `${Math.round(p * 100)}%`;
  };

  const formatCost = (c: number | null | undefined): string => {
    if (c == null) return '–';
    return c < 0.01 ? `${(c * 100).toFixed(2)}¢` : `$${c.toFixed(3)}`;
  };

  const formatTime = (ts: number): string => {
    return new Date(ts).toLocaleTimeString([], {
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false
    });
  };

  const formatRound = (r: RoundInfo, idx: number): string => {
    const cachedStr = r.in && r.cached != null ? ` ⚡${formatPct(r.cached / r.in)}` : '';
    return `r${idx + 1} ${formatMs(r.ms)} ${formatTokens(r.in)}→${formatTokens(r.out)}${cachedStr}`;
  };

  const createElement = <K extends keyof HTMLElementTagNameMap>(
    tag: K,
    className?: string,
    text?: string
  ): HTMLElementTagNameMap[K] => {
    const el = document.createElement(tag);
    if (className) el.className = className;
    if (text !== undefined) el.textContent = text;
    return el;
  };

  const buildSpanGroup = (parts: [string, string][]): HTMLElement => {
    const span = createElement('span', 'term__l');
    for (const [cls, txt] of parts) {
      if (cls) {
        span.append(createElement('span', cls, txt));
      } else {
        span.append(document.createTextNode(txt));
      }
    }
    return span;
  };

  const VERDICT_NAMES: Record<string, string> = {
    pass: 'pass',
    off_topic: 'off-topic',
    flagged: 'flagged',
    error: 'skipped'
  };

  const VERDICT_CLASSES: Record<string, string> = {
    pass: 'term__ok',
    off_topic: 'term__accent',
    flagged: 'term__accent',
    error: 'term__bad'
  };

  // Waterfall latency inspector
  function createWaterfall(run: TraceRun): HTMLElement {
    const maxMs = Math.max(1, run.totalMs, ...run.rounds.map((r) => r.t0 + r.ms));
    const wf = createElement('div', 'wf');
    const pct = (ms: number) => `${Math.min(100, (ms / maxMs) * 100).toFixed(2)}%`;

    const addBarRow = (
      label: string,
      startMs: number,
      durMs: number,
      type: string,
      waitMs: number = 0,
      tooltip: string = ''
    ) => {
      const row = createElement('div', 'wf__row');
      row.append(createElement('span', 'wf__label', label));
      const track = createElement('span', 'wf__track');
      const bar = createElement('span', `wf__bar wf__bar--${type}`);
      bar.style.left = pct(startMs);
      bar.style.width = pct(Math.max(durMs, maxMs / 200));

      if (waitMs > 0) {
        const wait = createElement('span', 'wf__wait');
        wait.style.width = `${Math.min(100, (waitMs / Math.max(durMs, 1)) * 100).toFixed(1)}%`;
        bar.append(wait);
      }
      track.append(bar);
      row.append(track, createElement('span', 'wf__ms', formatMs(durMs)));
      if (tooltip) row.title = tooltip;
      wf.append(row);
    };

    if (run.gate) {
      addBarRow(
        'jev gate',
        0,
        run.gate.ms,
        run.gate.verdict === 'error' ? 'bad' : 'tool',
        0,
        `Jev: ${VERDICT_NAMES[run.gate.verdict] || run.gate.verdict}`
      );
    }

    run.rounds.forEach((r, idx) => {
      const info = `first token ${formatMs(r.ttftMs)} · in ${formatTokens(r.in)} (${formatTokens(r.cached)} cached) · out ${formatTokens(r.out)}`;
      addBarRow(`model r${idx + 1}`, r.t0, r.ms, 'model', r.ttftMs ?? 0, info);
      for (const t of r.tools || []) {
        addBarRow(`  ${t.name}`, t.t0, t.ms, t.ok ? 'tool' : 'bad');
      }
    });

    const legend = createElement('p', 'wf__legend');
    legend.textContent = `${run.rounds.length} round${run.rounds.length === 1 ? '' : 's'} · ${formatCost(run.cost)} · dim = waiting for first token · hover bar for tokens`;
    wf.append(legend);
    return wf;
  }

  // Terminal Controller Class
  class TerminalController {
    container: HTMLElement;
    headEl: HTMLElement;
    rowsEl: HTMLElement;
    statusEl: HTMLElement;
    promptEl: HTMLElement;
    seen = new Set<string>();
    open = new Set<string>();
    first = true;
    running = false;
    timer = 0;

    constructor(container: HTMLElement) {
      this.container = container;
      this.headEl = container.querySelector('.term__head') as HTMLElement;
      this.rowsEl = container.querySelector('.term__rows') as HTMLElement;
      this.statusEl = container.querySelector('.term__status') as HTMLElement;
      this.promptEl = container.querySelector('.term__prompt') as HTMLElement;
    }

    start() {
      this.stop();
      this.running = true;
      this.poll();
    }

    stop() {
      this.running = false;
      clearTimeout(this.timer);
    }

    async poll() {
      try {
        const res = await fetch('/api/traces', { headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        const data: TracesResponse = await res.json();
        if (!this.running) return;
        this.render(data);
        if (this.statusEl) this.statusEl.textContent = '';
      } catch {
        // Fallback to built-in traces on network/static mismatch
        if (!this.running) return;
        this.render({ summary: DEFAULT_SUMMARY, traces: DEFAULT_RUNS });
        if (this.statusEl) this.statusEl.textContent = '';
      }

      if (this.running) {
        this.timer = window.setTimeout(() => this.poll(), 5000);
      }
    }

    render(data: TracesResponse) {
      this.renderHead(data);

      if (!data.traces.length) {
        const empty = createElement('li', 'term__empty');
        empty.append('no runs yet. ');
        const a = createElement('a', '', 'Ask the twin something');
        a.setAttribute('href', '/twin');
        empty.append(a, ' and watch it show up here.');
        this.rowsEl.replaceChildren(empty);
        return;
      }

      const frag = document.createDocumentFragment();
      data.traces.forEach((run) => {
        const isNew = !this.first && !this.seen.has(run.id);
        const rowEl = this.createRow(run, isNew);
        frag.append(rowEl);
        this.seen.add(run.id);
      });

      this.rowsEl.replaceChildren(frag);
      this.first = false;
    }

    renderHead(data: TracesResponse) {
      const s = data.summary;
      const model = data.traces[0]?.model ?? s?.model ?? 'openai/gpt-6-luna';
      const toolsEntries = s?.tools ? Object.entries(s.tools).sort((a, b) => b[1] - a[1]) : [];
      const toolsStr = toolsEntries.length
        ? toolsEntries.map(([name, count]) => `${name}×${count}`).join('  ')
        : 'check_availability×4  check_time×2';

      this.headEl.replaceChildren(
        buildSpanGroup([
          ['term__accent', 'twin-agent'],
          ['term__dim', ' · '],
          ['', model],
          ['term__dim', ' · ZDR · gate: jev · tools: read-only calendar']
        ]),
        buildSpanGroup([
          ['term__dim', 'p50 '],
          ['', formatMs(s?.p50Ms ?? 3400)],
          ['term__dim', '  p95 '],
          ['', formatMs(s?.p95Ms ?? 9000)],
          ['term__dim', '  cache '],
          ['term__ok', formatPct(s?.cacheHit ?? 0.26)],
          ['term__dim', '  cost '],
          ['', `${formatCost(s?.avgCost ?? 0.0008)}/reply`],
          ['term__dim', '  24h '],
          ['', String(s?.runs24h ?? 28)]
        ]),
        buildSpanGroup([
          ['term__dim', 'tools '],
          ['', toolsStr]
        ])
      );
    }

    createRow(run: TraceRun, isNew: boolean): HTMLElement {
      const li = createElement('li', `term__row${isNew ? ' is-new' : ''}`);
      const btn = createElement('button', 'term__line');
      btn.type = 'button';
      btn.setAttribute('aria-expanded', String(this.open.has(run.id)));

      const parts: [string, string][] = [
        ['term__dim', `${formatTime(run.at)} `],
        ['term__id', run.id.slice(0, 4)],
        [run.ok ? 'term__ok' : 'term__bad', run.ok ? ' ✓ ' : ' ✗ '],
        ['', formatMs(run.totalMs)]
      ];

      if (run.gate) {
        parts.push(
          ['term__dim', ' │ '],
          ['term__tool', `jev ${formatMs(run.gate.ms)} `],
          [VERDICT_CLASSES[run.gate.verdict] || 'term__accent', VERDICT_NAMES[run.gate.verdict] || run.gate.verdict]
        );
      }

      run.rounds.forEach((round, rIdx) => {
        parts.push(['term__dim', ' │ '], ['', formatRound(round, rIdx)]);
        for (const t of round.tools || []) {
          parts.push(
            ['term__dim', ' → '],
            ['term__tool', `${t.name} ${formatMs(t.ms)} `],
            [t.ok ? 'term__ok' : 'term__bad', t.ok ? '✓' : '✗']
          );
        }
      });

      btn.append(buildSpanGroup(parts));

      btn.addEventListener('click', () => {
        if (this.open.has(run.id)) {
          this.open.delete(run.id);
        } else {
          this.open.add(run.id);
        }
        btn.setAttribute('aria-expanded', String(this.open.has(run.id)));
        li.querySelector('.wf')?.remove();
        if (this.open.has(run.id)) {
          li.append(createWaterfall(run));
        }
      });

      li.append(btn);
      if (this.open.has(run.id)) {
        li.append(createWaterfall(run));
      }

      return li;
    }
  }

  // Canvas Desk POV Drawing
  const DESK_VIRTUAL = { w: 320, h: 180 };
  const MONITOR_SCREEN = { x: 48, y: 22, w: 160, h: 90 };

  // Hornet mascot sprite matrix (19 cols x 15 rows)
  const MASCOT_SPRITE = [
    '......k.....k......',
    '.......k...k.......',
    'www.....kkk.....www',
    '.wwww..ktttk..wwww.',
    '..wwwwkektkekwwww..',
    '...wwwkptttpkwww...',
    '....wwkkpppkkww....',
    '.....koooooook.....',
    '....koooolooook....',
    '....klllllllllk....',
    '....koooolooook....',
    '.....koooloook.....',
    '......kkkkkkk......',
    '........ktk........',
    '.........k.........'
  ];

  const SPRITE_PALETTE: Record<string, string> = {
    w: '#ffffff',
    k: '#0d0a1f',
    t: '#00a3ad',
    p: '#6a5acd',
    e: '#ffffff',
    o: '#f28c28',
    l: '#8a3c10'
  };

  function prng(e: number, t: number, n: number = 0): number {
    let r = (e * 374761393 + t * 668265263 + n * 2147483647) | 0;
    r = Math.imul(r ^ (r >>> 13), 1274126177);
    return ((r ^ (r >>> 16)) >>> 0) / 4294967296;
  }

  function fillRect(ctx: CanvasRenderingContext2D, color: string, x: number, y: number, w: number, h: number) {
    ctx.fillStyle = color;
    ctx.fillRect(x, y, w, h);
  }

  function drawWall(ctx: CanvasRenderingContext2D, bounds: { l: number; r: number; t: number; b: number }, wallH = 148) {
    const o = bounds.r - bounds.l;
    // Ceiling beam if bounds.t < 0
    if (bounds.t < 0) {
      fillRect(ctx, '#4a2c19', bounds.l, bounds.t, o, -bounds.t);
      for (let n = -6; n > bounds.t; n -= 6) {
        fillRect(ctx, '#432817', bounds.l, n, o, 1);
      }
    }

    // Warm wall surface
    fillRect(ctx, '#e9b949', bounds.l, 0, o, wallH);

    // Wall texture specks
    for (let r = 0; r < o / 2; r++) {
      const s = bounds.l + Math.floor(prng(r, wallH, 1) * o);
      const c = 10 + Math.floor(prng(r, wallH, 2) * (wallH - 20));
      fillRect(ctx, '#d6a63c', s, c, 1 + Math.floor(prng(r, wallH, 3) * 3), 1);
    }

    // Top beam molding
    fillRect(ctx, '#5e3a22', bounds.l, 0, o, 7);
    fillRect(ctx, '#432817', bounds.l, 7, o, 1);

    // Baseboard
    fillRect(ctx, '#5e3a22', bounds.l, wallH - 5, o, 5);
    fillRect(ctx, '#7a4d2e', bounds.l, wallH - 5, o, 1);
  }

  function drawSprite(
    ctx: CanvasRenderingContext2D,
    rows: string[],
    x: number,
    y: number,
    palette: Record<string, string>,
    scale = 1
  ) {
    rows.forEach((row, rIdx) => {
      [...row].forEach((char, cIdx) => {
        if (palette[char]) {
          fillRect(ctx, palette[char], x + cIdx * scale, y + rIdx * scale, scale, scale);
        }
      });
    });
  }

  function drawBanner(
    ctx: CanvasRenderingContext2D,
    x: number,
    y: number,
    w: number,
    h: number,
    bg: string,
    onDraw: (bx: number, by: number, bw: number, bh: number) => void
  ) {
    // Banner hanging rod with brass finials
    fillRect(ctx, '#2b1d14', x - 3, y - 3, w + 6, 2);
    fillRect(ctx, '#e0b040', x - 4, y - 3, 1, 2);
    fillRect(ctx, '#e0b040', x + w + 3, y - 3, 1, 2);

    // Drop shadow & background
    fillRect(ctx, 'rgba(0,0,0,0.18)', x + 2, y + 2, w, h);
    fillRect(ctx, bg, x, y, w, h);
    onDraw(x, y, w, h);
  }

  function drawDeskLamp(ctx: CanvasRenderingContext2D, x: number, y: number) {
    fillRect(ctx, 'rgba(255, 230, 150, 0.16)', x - 6, y - 40, 50, 40); // Lamp warm glow
    fillRect(ctx, '#2b1d14', x, y - 4, 20, 4); // Base outline
    fillRect(ctx, '#2f6db5', x + 1, y - 3, 18, 2); // Blue base

    // Angled neck
    for (let r = 0; r < 30; r++) {
      fillRect(ctx, '#2b1d14', x + 9 + Math.round(r * 0.3), y - 4 - r, 2, 1);
    }
    for (let r = 0; r < 14; r++) {
      fillRect(ctx, '#2b1d14', x + 18 - r, y - 34 - Math.round(r * 0.4), 2, 1);
    }

    // Lamp head & bulb
    fillRect(ctx, '#2b1d14', x - 2, y - 42, 14, 8);
    fillRect(ctx, '#2f6db5', x - 1, y - 41, 12, 6);
    fillRect(ctx, '#fff3a0', x, y - 35, 10, 2);
  }

  function drawMonitorFrame(ctx: CanvasRenderingContext2D) {
    const t = MONITOR_SCREEN;
    fillRect(ctx, 'rgba(0,0,0,0.25)', t.x - 4, 132, t.w + 16, 6); // Shadow on desk

    const cx = t.x + t.w / 2; // 128
    // Stand Neck
    fillRect(ctx, '#2b1d14', cx - 10, 120, 20, 14);
    fillRect(ctx, '#3a3a44', cx - 9, 120, 18, 13);
    // Stand Base
    fillRect(ctx, '#2b1d14', cx - 28, 132, 56, 7);
    fillRect(ctx, '#3a3a44', cx - 27, 133, 54, 5);

    // Bezel
    fillRect(ctx, '#2b1d14', t.x - 9, t.y - 9, t.w + 18, t.h + 22);
    fillRect(ctx, '#2a2a33', t.x - 8, t.y - 8, t.w + 16, t.h + 20);
    fillRect(ctx, '#3a3a44', t.x - 8, t.y - 8, t.w + 16, 1);

    // Dark screen background
    fillRect(ctx, '#0d1b14', t.x, t.y, t.w, t.h);

    // Power LED & Logo
    fillRect(ctx, '#7dffb0', t.x + t.w - 4, t.y + t.h + 6, 2, 1);
    fillRect(ctx, '#d5dde8', t.x + 4, t.y + t.h + 3, 6, 6);
    fillRect(ctx, '#7df9ff', t.x + 5, t.y + t.h + 4, 1, 1);
    fillRect(ctx, '#7df9ff', t.x + 8, t.y + t.h + 4, 1, 1);
    fillRect(ctx, '#2b1d14', t.x + 5, t.y + t.h + 7, 4, 1);
  }

  function drawKeyboard(ctx: CanvasRenderingContext2D, x: number, y: number) {
    fillRect(ctx, '#2b1d14', x, y, 128, 18);
    fillRect(ctx, '#d5dde8', x + 1, y + 1, 126, 16);

    for (let r = 0; r < 3; r++) {
      for (let a = 0; a < 15; a++) {
        fillRect(ctx, '#b8c2d0', x + 4 + a * 8 + (r % 2) * 2, y + 3 + r * 4, 6, 2);
      }
    }
    fillRect(ctx, '#b8c2d0', x + 36, y + 15, 48, 2); // Spacebar
  }

  function drawDeskScene(ctx: CanvasRenderingContext2D, bounds: { l: number; r: number; t: number; b: number }) {
    // 1. Wall background
    drawWall(ctx, bounds, 148);

    // 2. Banner on right wall
    drawBanner(ctx, 210, 10, 104, 80, '#1d1160', (bx, by, bw, bh) => {
      fillRect(ctx, '#00788c', bx, by, bw, 7);
      fillRect(ctx, '#00788c', bx, by + bh - 7, bw, 7);
      fillRect(ctx, '#f28c28', bx, by + 7, bw, 1);
      fillRect(ctx, '#f28c28', bx, by + bh - 8, bw, 1);
      drawSprite(
        ctx,
        MASCOT_SPRITE,
        bx + Math.floor((bw - 57) / 2),
        by + Math.floor((bh - 45) / 2),
        SPRITE_PALETTE,
        3
      );
    });

    // 3. Sticky notes on left wall
    const notes: [number, number, string][] = [
      [14, 24, '#fff6b8'],
      [22, 40, '#ffd1dc'],
      [12, 56, '#cfe8ff']
    ];
    for (const [nx, ny, col] of notes) {
      fillRect(ctx, col, nx, ny, 12, 12);
      fillRect(ctx, 'rgba(0,0,0,0.15)', nx + 2, ny + 4, 8, 1);
      fillRect(ctx, 'rgba(0,0,0,0.15)', nx + 2, ny + 7, 6, 1);
    }

    // 4. Desk table surface (y: 139 to bottom)
    const deskW = bounds.r - bounds.l;
    fillRect(ctx, '#2b1d14', bounds.l, 139, deskW, 1);
    fillRect(ctx, '#b0703f', bounds.l, 140, deskW, bounds.b - 140);
    fillRect(ctx, '#c4844f', bounds.l, 140, deskW, 2);
    for (let n = 148, r = 6; n < bounds.b; n += r, r += 2) {
      fillRect(ctx, '#965a30', bounds.l, n, deskW, 1);
    }

    // 5. Desk Lamp on the left
    drawDeskLamp(ctx, 8, 140);

    // 6. CRT Monitor
    drawMonitorFrame(ctx);

    // 7. Keyboard
    drawKeyboard(ctx, 64, 150);

    // 8. Coffee Mug on the right
    fillRect(ctx, '#2b1d14', 268, 120, 18, 22);
    fillRect(ctx, '#fffaf0', 269, 121, 16, 20);
    fillRect(ctx, '#c4605a', 269, 127, 16, 3);
    fillRect(ctx, '#2b1d14', 286, 125, 4, 10);
    fillRect(ctx, '#fffaf0', 286, 126, 2, 8);
    fillRect(ctx, '#5a3420', 270, 121, 14, 2);
  }

  function initDeskModal() {
    const dialog = document.querySelector<HTMLDialogElement>('[data-desk]');
    if (!dialog) return;

    const canvas = dialog.querySelector<HTMLCanvasElement>('[data-pov-canvas]');
    const screenOverlay = dialog.querySelector<HTMLElement>('[data-term]');
    const offBtn = dialog.querySelector<HTMLButtonElement>('[data-desk-off]');

    if (!canvas || !screenOverlay) return;

    const termCtrl = new TerminalController(screenOverlay);

    const resizeAndRender = () => {
      const cw = canvas.clientWidth;
      const ch = canvas.clientHeight;
      if (!cw || !ch) return;

      const dpr = window.devicePixelRatio || 1;
      canvas.width = Math.round(cw * dpr);
      canvas.height = Math.round(ch * dpr);

      // Compute integer scale s and virtual coordinate offset
      const pixelW = Math.round(cw * dpr);
      const pixelH = Math.round(ch * dpr);
      const s = Math.max(1, Math.floor(Math.min(pixelW / DESK_VIRTUAL.w, pixelH / DESK_VIRTUAL.h)));
      const virtualW = Math.ceil(pixelW / s);
      const virtualH = Math.ceil(pixelH / s);
      const ox = Math.floor((virtualW - DESK_VIRTUAL.w) / 2);
      const oy = Math.floor((virtualH - DESK_VIRTUAL.h) / 2);

      // Position the DOM screen overlay directly on the CRT monitor
      const cssScale = s / dpr;
      const left = (ox + MONITOR_SCREEN.x) * cssScale;
      const top = (oy + MONITOR_SCREEN.y) * cssScale;
      const width = MONITOR_SCREEN.w * cssScale;
      const height = MONITOR_SCREEN.h * cssScale;

      Object.assign(screenOverlay.style, {
        left: `${left}px`,
        top: `${top}px`,
        width: `${width}px`,
        height: `${height}px`
      });
      screenOverlay.style.setProperty('--px', `${cssScale}px`);

      // Render 2D canvas scene
      const ctx = canvas.getContext('2d', { alpha: false });
      if (!ctx) return;
      ctx.imageSmoothingEnabled = false;
      ctx.setTransform(s, 0, 0, s, ox * s, oy * s);

      const bounds = {
        l: -ox,
        r: virtualW - ox,
        t: -oy,
        b: virtualH - oy
      };

      drawDeskScene(ctx, bounds);
    };

    const ro = new ResizeObserver(() => {
      if (dialog.open) resizeAndRender();
    });

    const openDesk = () => {
      if (dialog.open) return;
      dialog.showModal();
      ro.observe(canvas);
      requestAnimationFrame(() => {
        resizeAndRender();
        termCtrl.start();
      });
    };

    const closeDesk = () => {
      if (!dialog.open) return;
      dialog.close();
      termCtrl.stop();
      ro.disconnect();
    };

    // Close on Stand up button
    offBtn?.addEventListener('click', closeDesk);

    // Close on backdrop click
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) closeDesk();
    });

    // Close on Escape key
    dialog.addEventListener('cancel', () => {
      termCtrl.stop();
      ro.disconnect();
    });

    // Listen to custom event from town engine
    document.addEventListener('town:desk', () => {
      openDesk();
    });

    // Listen to triggers with [data-desk-trigger]
    document.querySelectorAll('[data-desk-trigger]').forEach((trigger) => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        openDesk();
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initDeskModal);
  document.addEventListener('astro:page-load', initDeskModal);
</script>
