---
// DeskModal.astro - Retro Computer POV Workstation Modal with Live Agent Traces
---

<dialog class="pov-dialog" data-desk="" aria-labelledby="desk-title">
  <div class="pov">
    <canvas class="pov__canvas" aria-hidden="true" data-pov-canvas=""></canvas>

    <section class="pov__screen term" data-term="" aria-label="Agent traces">
      <div class="term__head">
        <span class="term__l">
          <span class="term__accent">twin-agent</span><span class="term__dim"> · </span>openai/gpt-6-luna<span class="term__dim"> · ZDR · gate: jev · tools: read-only calendar</span>
        </span>
        <span class="term__l">
          <span class="term__dim">p50 </span>3.4s<span class="term__dim">  p95 </span>9.0s<span class="term__dim">  cache </span><span class="term__ok">26%</span><span class="term__dim">  cost </span>0.08¢/reply<span class="term__dim">  24h </span>28
        </span>
        <span class="term__l">
          <span class="term__dim">tools </span>check_availability×4  check_time×2
        </span>
      </div>

      <ol class="term__rows" aria-label="Recent twin replies, newest first"></ol>

      <p class="term__prompt" aria-hidden="true">$ tail -f /api/traces</p>
      <p class="term__status" role="status"></p>
    </section>

    <div class="pov__bar">
      <h2 id="desk-title" class="pov__title">Computer · how the twin answered, live</h2>
      <a class="pov__btn" href="/twin" data-desk-ask="">Ask the twin</a>
      <button class="pov__btn" type="button" data-desk-off="">Stand up</button>
    </div>

    <p class="pov__fine">
      Only timings, token counts and tool names are kept. Never what anyone asked or what the twin said.
    </p>
  </div>
</dialog>

<style>
  .pov-dialog {
    inset: var(--header-h, 0px) var(--panel-w, 0px) 0 0;
    width: auto;
    max-width: none;
    height: auto;
    max-height: none;
    font: 10px / 1.6 var(--font-retro, monospace);
    background: #2b1d14;
    border: 0;
    margin: 0;
    padding: 0;
    position: fixed;
    overflow: hidden;
    z-index: 90;
  }

  .pov-dialog::backdrop {
    background: #140c068c;
  }

  .pov {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
  }

  .pov__canvas {
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    display: block;
    position: absolute;
    inset: 0;
  }

  .pov__screen {
    position: absolute;
    overflow: hidden;
    box-sizing: border-box;
  }

  .pov__bar {
    color: #181820;
    background: #f8f8f0f2;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    padding: 10px 12px;
    display: flex;
    position: absolute;
    bottom: 14px;
    left: 14px;
    right: 14px;
    box-shadow: 0 -3px #181820, 0 3px #181820, -3px 0 #181820, 3px 0 #181820;
    z-index: 10;
  }

  .pov__title {
    min-width: 12em;
    font: inherit;
    font-size: 11px;
    flex: 1;
    margin: 0;
  }

  .pov__btn {
    min-height: 36px;
    font: inherit;
    color: #181820;
    cursor: pointer;
    background: #fff;
    border: 3px solid #181820;
    padding: 8px 12px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
  }

  .pov__btn:hover,
  .pov__btn:focus-visible {
    background: var(--sun, #e0a526);
  }

  .pov__fine {
    font: 8px / 1.6 var(--font-retro, monospace);
    color: #fff8ec;
    text-shadow: 1px 1px #000;
    pointer-events: none;
    margin: 0;
    position: absolute;
    top: 12px;
    left: 14px;
    right: 14px;
    z-index: 10;
  }

  @media (width <= 899px) {
    .pov-dialog {
      inset: var(--header-h, 0px) 0 0 0;
    }
  }

  /* Screen Overlay / Terminal styling */
  .term {
    --px: 2px;
    font: clamp(11px, calc(var(--px) * 6.5), 19px) / 1.15 var(--font-terminal, monospace);
    color: #7dffb0;
    text-shadow: 0 0 4px #7dffb059;
    scrollbar-width: thin;
    scrollbar-color: #3f8f63 transparent;
    background: repeating-linear-gradient(#0000002e 0 1px, #0000 1px 3px), radial-gradient(#12261b, #0b1711 80%);
    flex-direction: column;
    gap: 0.35em;
    padding: 0.5em 0.7em;
    display: flex;
    overflow: hidden auto;
  }

  @media (width <= 599px) {
    .term {
      outline: 6px solid #2a2a33;
      width: auto !important;
      height: auto !important;
      inset: 40px 10px 84px !important;
    }
  }

  .term :global(.term__head) {
    border-bottom: 1px dashed #3f8f63;
    padding-bottom: 0.3em;
  }

  .term :global(.term__l) {
    display: block;
  }

  .term :global(.term__rows) {
    gap: 0.15em;
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
  }

  .term :global(.term__line) {
    width: 100%;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
    background: 0 0;
    border: 0;
    padding: 0.1em 0.2em;
    display: block;
  }

  .term :global(.term__line:hover),
  .term :global(.term__line[aria-expanded="true"]) {
    background: #7dffb014;
  }

  .term :global(.term__line:focus-visible) {
    outline: 1px dashed #ffd166;
  }

  .term :global(.is-mine) {
    background: #ffd16612;
  }

  .term :global(.is-new) {
    animation: 0.7s steps(28, end) both term-type;
  }

  @keyframes term-type {
    0% {
      clip-path: inset(0 100% 0 0);
    }
  }

  .term :global(.term__dim) {
    color: #3f8f63;
  }

  .term :global(.term__accent),
  .term :global(.term__id),
  .term :global(.term__you) {
    color: #ffd166;
  }

  .term :global(.term__ok) {
    color: #7dffb0;
  }

  .term :global(.term__bad) {
    color: #ff6b6b;
  }

  .term :global(.term__tool) {
    color: #59f0d0;
  }

  .term :global(.term__empty a) {
    color: #ffd166;
  }

  .term :global(.term__prompt),
  .term :global(.term__status) {
    margin: 0;
  }

  .term :global(.term__prompt:after) {
    content: "▮";
    margin-left: 0.2em;
    animation: 1s step-end infinite term-blink;
  }

  @keyframes term-blink {
    50% {
      opacity: 0;
    }
  }

  .term :global(.term__status) {
    color: #ffd166;
  }

  .term :global(.term__status:empty) {
    display: none;
  }

  .term :global(.wf) {
    border-left: 1px dashed #3f8f63;
    margin: 0.2em 0 0.5em 0.6em;
    padding-left: 0.5em;
  }

  .term :global(.wf__row) {
    white-space: pre;
    grid-template-columns: minmax(6em, 10em) 1fr 3.5em;
    align-items: center;
    gap: 0.5em;
    display: grid;
  }

  .term :global(.wf__label) {
    text-overflow: ellipsis;
    overflow: hidden;
  }

  .term :global(.wf__track) {
    background: #7dffb00f;
    height: 0.7em;
    position: relative;
  }

  .term :global(.wf__bar) {
    position: absolute;
    top: 0;
    bottom: 0;
    overflow: hidden;
  }

  .term :global(.wf__bar--model) {
    background: #7dffb0;
  }

  .term :global(.wf__bar--tool) {
    background: #ffd166;
  }

  .term :global(.wf__bar--bad) {
    background: #ff6b6b;
  }

  .term :global(.wf__wait) {
    background: #0b17118c;
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
  }

  .term :global(.wf__ms) {
    text-align: right;
  }

  .term :global(.wf__legend) {
    color: #3f8f63;
    margin: 0.2em 0 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .term :global(.is-new),
    .term :global(.term__prompt:after) {
      animation: none;
    }
  }
</style>

<script>
  // Trace Data & Canvas Renderer
  interface GateInfo {
    ms: number;
    verdict: 'pass' | 'off_topic' | 'flagged' | 'error';
  }

  interface ToolCall {
    name: string;
    t0: number;
    ms: number;
    ok: boolean;
  }

  interface RoundInfo {
    t0: number;
    ms: number;
    ttftMs: number;
    in: number;
    out: number;
    cached: number;
    tools: ToolCall[];
  }

  interface TraceRun {
    id: string;
    model: string;
    at: number;
    totalMs: number;
    ok: boolean;
    cost: number;
    gate?: GateInfo;
    rounds: RoundInfo[];
  }

  interface TraceSummary {
    model: string;
    p50Ms: number;
    p95Ms: number;
    cacheHit: number;
    avgCost: number;
    runs24h: number;
    tools: Record<string, number>;
  }

  interface TracesResponse {
    summary: TraceSummary;
    traces: TraceRun[];
  }

