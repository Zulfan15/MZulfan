          <div class="flex justify-between"><span>Geser Kamera (Hand Pan)</span><kbd class="town-dev-kbd">Space + Drag</kbd></div>
          <div class="flex justify-between"><span>Mode Zen Bersih</span><kbd class="town-dev-kbd">Tab</kbd></div>
          <div class="flex justify-between"><span>Mode Playtest di Kursor</span><kbd class="town-dev-kbd">P</kbd></div>
          <div class="flex justify-between"><span>Toggle Grid 16px</span><kbd class="town-dev-kbd">G</kbd></div>
          <div class="flex justify-between"><span>Simpan ke File JSON</span><kbd class="town-dev-kbd">Ctrl+S</kbd></div>
        </div>
        <div class="p-2 rounded bg-slate-900/80 border border-slate-700 space-y-1">
          <div class="text-amber-300 font-bold mb-1">🖐️ Objek &amp; Lantai</div>
          <div class="flex justify-between"><span>Multi-Pilih Kotak</span><kbd class="town-dev-kbd">Shift + Drag</kbd></div>
          <div class="flex justify-between"><span>Klon Cepat Saat Tarik</span><kbd class="town-dev-kbd">Alt + Drag</kbd></div>
          <div class="flex justify-between"><span>Pipet Cepat (Ubin/Objek)</span><kbd class="town-dev-kbd">Alt + Klik</kbd></div>
          <div class="flex justify-between"><span>Garis / Kotak / Ember</span><kbd class="town-dev-kbd">L / R / B</kbd></div>
          <div class="flex justify-between"><span>Kunci / Layer Up-Down</span><kbd class="town-dev-kbd">K / [ ]</kbd></div>
        </div>
      </div>
