  <!-- Object Spawner Modal -->
  <dialog id="town-editor-spawn-modal" class="town-editor-modal town-editor-spawn-modal">
    <div class="town-editor-modal__content town-editor-spawn-modal__content">
      <div class="town-editor-modal__header">
        <h3 class="town-editor-modal__title">➕ Tambah Objek ke Kota</h3>
        <button type="button" class="town-editor-modal__close" id="btn-close-spawn-modal">×</button>
      </div>

      <!-- Search Bar -->
      <div class="town-spawn-search-wrap">
        <input
          type="text"
          id="town-spawn-search"
