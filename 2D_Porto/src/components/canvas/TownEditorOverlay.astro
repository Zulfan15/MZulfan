        <button type="button" class="town-editor-mini-btn" id="btn-editor-minimize" title="Lipat / Rentangkan Sub-Toolbar">
          <span id="icon-editor-minimize">🔽</span>
        </button>
        <button type="button" class="town-editor-btn town-editor-btn--close" id="btn-editor-close" title="Tutup Town Editor (E)">✖️</button>
      </div>
    </div>

    <!-- Searchable Scene Outliner Popover -->
    <div id="town-outliner-popover" class="town-outliner-popover hidden" style="display: none;" role="dialog" aria-label="Scene Outliner">
