            </button>
            <button type="button" class="town-editor-popover__item" id="btn-more-zen">
              <span>👁️ Mode Zen Kanvas</span>
              <kbd class="town-dev-kbd">Tab</kbd>
            </button>
            <div class="my-1 border-t border-slate-700/80"></div>
            <button type="button" class="town-editor-popover__item" id="btn-editor-prefabs">
              <span>🧩 Prefab Blueprints</span>
            </button>
            <button type="button" class="town-editor-popover__item" id="btn-editor-snapshots">
              <span>🕒 Snapshot &amp; Diff (A–E)</span>
            </button>
            <button type="button" class="town-editor-popover__item" id="btn-editor-export">
              <span>📋 Salin Kode JSON</span>
            </button>
            <button type="button" class="town-editor-popover__item" id="btn-editor-fullscreen">
              <span>⛶ Layar Penuh</span>
              <kbd class="town-dev-kbd">F</kbd>
            </button>
            <button type="button" class="town-editor-popover__item" id="btn-more-shortcuts">
              <span>⌨️ Daftar Pintasan</span>
              <kbd class="town-dev-kbd">?</kbd>
            </button>
            <div class="my-1 border-t border-slate-700/80"></div>
            <button type="button" class="town-editor-popover__item text-rose-300 hover:bg-rose-950/60" id="btn-editor-reset">
              <span>🔄 Reset Tata Letak Awal</span>
            </button>
          </div>
