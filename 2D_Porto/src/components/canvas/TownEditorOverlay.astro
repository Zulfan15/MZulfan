          placeholder="🔍 Cari objek (misal: pikachu, snorlax, pohon, lampu, server, sakura)..."
          autocomplete="off"
        />
        <button type="button" id="town-spawn-search-clear" class="town-spawn-search-clear" title="Bersihkan pencarian">×</button>
      </div>

      <!-- Category Filter Tabs -->
      <div class="town-spawn-tabs" id="town-spawn-tabs">
        <button type="button" class="town-spawn-tab is-active" data-cat="all">🌟 Semua (<span id="cat-count-all">0</span>)</button>
        <button type="button" class="town-spawn-tab" data-cat="favorites">⭐ Favorit (<span id="cat-count-fav">0</span>)</button>
        <button type="button" class="town-spawn-tab" data-cat="bundles">🎁 Paket Tema (<span id="cat-count-bundles">0</span>)</button>
        <button type="button" class="town-spawn-tab" data-cat="Foliage & Alam">🌳 Alam (<span id="cat-count-alam">0</span>)</button>
        <button type="button" class="town-spawn-tab" data-cat="Perabot & Lampu">🪑 Perabot &amp; Lampu (<span id="cat-count-perabot">0</span>)</button>
        <button type="button" class="town-spawn-tab" data-cat="Dunia Pokémon">⚡ Pokémon (<span id="cat-count-pokemon">0</span>)</button>
        <button type="button" class="town-spawn-tab" data-cat="Dunia Digimon">👾 Digimon (<span id="cat-count-digimon">0</span>)</button>
        <button type="button" class="town-spawn-tab" data-cat="Tech & AI">💻 Tech &amp; AI (<span id="cat-count-tech">0</span>)</button>
        <button type="button" class="town-spawn-tab" data-cat="Fasilitas & Kota">⛲ Fasilitas &amp; Kota (<span id="cat-count-fasilitas">0</span>)</button>
      </div>

      <!-- Biome, Size & Collision Filters -->
      <div class="town-spawn-filters" id="town-spawn-filters">
        <button
          type="button"
          class="town-spawn-chip town-spawn-chip--biome"
          id="btn-spawn-biome-filter"
          title="Tampilkan hanya objek yang direkomendasikan untuk dunia ini"
        >
          🌍 Cocok di <span id="spawn-biome-world-name">Kota</span> (<span id="spawn-biome-count">0</span>)
        </button>

        <div class="town-spawn-filter-group" role="group" aria-label="Filter ukuran">
          <span class="town-spawn-filter-label">Ukuran:</span>
          <button type="button" class="town-spawn-chip is-active" data-size-filter="all">Semua</button>
          <button type="button" class="town-spawn-chip" data-size-filter="1x1">1×1</button>
          <button type="button" class="town-spawn-chip" data-size-filter="2x1">2×1</button>
          <button type="button" class="town-spawn-chip" data-size-filter="2x2">2×2</button>
          <button type="button" class="town-spawn-chip" data-size-filter="large">4×4+</button>
        </div>

        <div class="town-spawn-filter-group" role="group" aria-label="Filter kolisi">
          <span class="town-spawn-filter-label">Kolisi:</span>
          <button type="button" class="town-spawn-chip is-active" data-col-filter="all">Semua</button>
          <button type="button" class="town-spawn-chip" data-col-filter="canopy">🌳 Batang Saja</button>
          <button type="button" class="town-spawn-chip" data-col-filter="solid">🧱 Padat</button>
        </div>

        <button
          type="button"
          class="town-spawn-chip town-spawn-chip--flip"
          id="btn-spawn-flip-toggle"
          title="Balik arah horizontal (mirror) saat memasang atau mencap objek (tekan R saat mode Cap)"
        >
          ⇄ Arah: <span id="spawn-flip-label">Normal</span>
        </button>

        <button
          type="button"
          class="town-spawn-chip town-spawn-chip--sandbox"
          id="btn-spawn-sandbox-toggle"
          title="Beralih antara Mode Progres (buka item eksklusif lewat eksplorasi) dan Mode Kreatif (buka semua item)"
        >
          🏆 Progres <span id="spawn-unlock-progress">0/10</span> · <span id="spawn-sandbox-label">Progres Aktif</span>
        </button>

        <select id="town-spawn-sort" class="town-spawn-sort" aria-label="Urutkan katalog">
          <option value="biome">Urut: Rekomendasi Bioma</option>
          <option value="name">Urut: Nama A–Z</option>
          <option value="size">Urut: Ukuran</option>
          <option value="placed">Urut: Terbanyak di Peta</option>
        </select>
      </div>

      <div id="town-spawn-scatter-tray" class="town-spawn-scatter-tray hidden">
        <span>🎲 <strong>Kuas Acak:</strong></span>
        <div id="scatter-tray-items" class="town-spawn-scatter-items"></div>
        <select id="scatter-radius-select" class="town-spawn-sort" title="Radius sebaran">
          <option value="2">Radius 2</option>
          <option value="3" selected>Radius 3</option>
          <option value="4">Radius 4</option>
        </select>
        <select id="scatter-density-select" class="town-spawn-sort" title="Jumlah objek per klik">
          <option value="2">2 / klik</option>
          <option value="3" selected>3 / klik</option>
          <option value="5">5 / klik</option>
        </select>
        <button type="button" id="btn-start-scatter-brush" class="town-editor-btn town-spawn-card__btn town-spawn-card__btn--place" style="flex:0 0 auto;padding:4px 8px;">
          🎲 Mulai Kuas Acak
        </button>
        <button type="button" id="btn-clear-scatter-pool" class="town-spawn-chip" title="Kosongkan pilihan kuas acak">✕</button>
      </div>

      <div class="town-spawn-stamp-tip">
        <span>💡 <strong>Tip:</strong> Klik <strong>➕ Pasang</strong> / <strong>🎯 Cap</strong> / <strong>🎲 Acak</strong>, klik <strong>📍×N</strong> untuk melompat ke objek. ⌨️ <kbd>Ctrl+K</kbd>: Buka · <kbd>↑↓</kbd>: Pilih · <kbd>Enter</kbd>: Pasang · <kbd>Shift+Enter</kbd>: Cap · <kbd>R</kbd>: Balik Arah (saat Cap)</span>
      </div>

      <div id="town-spawn-inspector" class="town-spawn-inspector" aria-live="polite">
        <div class="town-spawn-inspector__thumb" id="spawn-insp-thumb">✨</div>
        <div class="town-spawn-inspector__body">
          <div class="town-spawn-inspector__top">
            <strong id="spawn-insp-name">Arahkan kursor atau tekan ↑↓ pada kartu objek</strong>
            <span class="town-spawn-inspector__pill" id="spawn-insp-size">—</span>
            <span class="town-spawn-inspector__pill town-spawn-inspector__pill--col" id="spawn-insp-col">—</span>
          </div>
          <div class="town-spawn-inspector__biomes" id="spawn-insp-biomes"></div>
          <p class="town-spawn-inspector__dialogue" id="spawn-insp-dialogue">Pratinjau ukuran petak, aturan kolisi, kecocokan bioma, dan dialog interaktif akan muncul di sini.</p>
          <div class="town-spawn-inspector__unlock hidden" id="spawn-insp-unlock"></div>
        </div>
      </div>

      <div class="town-spawn-catalog" id="town-spawn-catalog"></div>
    </div>
  </dialog>

