---
// Guided Auto-Tour Banner, Legendary Resonance Pill & PokéSnap Studio Dock
---

  <!-- Guided Auto-Tour Cinematic Lower-Third Banner -->
  <div
    id="town-tour-banner"
    class="hidden fixed sm:absolute bottom-3 left-1/2 -translate-x-1/2 z-30 w-[min(94vw,34rem)] rounded-2xl border-[2.5px] border-[#1c1726] bg-[#141d33]/95 text-white p-3 shadow-[0_6px_0_0_#090d16] backdrop-blur-xs"
    role="region"
    aria-label="Guided Auto-Tour Progress"
  >
    <div class="flex items-start justify-between gap-2.5">
      <div class="flex items-start gap-2.5 min-w-0">
        <span id="tour-stop-icon" class="text-2xl leading-none shrink-0 mt-0.5">🎬</span>
        <div class="min-w-0 space-y-0.5">
          <div class="flex items-center gap-2 flex-wrap">
            <span id="tour-step-badge" class="px-1.5 py-0.5 rounded bg-sky-500/25 border border-sky-400/50 font-mono text-[9px] font-bold text-sky-200">
              STOP 1/5
            </span>
            <h3 id="tour-stop-title" class="font-pixel text-xs font-bold text-amber-300 m-0 truncate">
              Dev Center · Mission Control
            </h3>
          </div>
          <p id="tour-stop-desc" class="font-sans text-[11px] text-slate-200 m-0 leading-snug"></p>
        </div>
      </div>
      <button
        id="tour-stop-btn"
        type="button"
        class="shrink-0 px-2 py-1 rounded-lg border border-slate-500 bg-slate-800 hover:bg-rose-600 text-[10px] font-pixel font-bold text-white cursor-pointer"
        title="Hentikan Tur Otomatis"
      >
        ⏹️ Stop
      </button>
    </div>

    <div class="mt-2 flex items-center justify-between gap-2">
      <div class="flex-1 h-1.5 rounded-full bg-slate-700 overflow-hidden">
        <div id="tour-progress-bar" class="h-full bg-amber-400 transition-all duration-300" style="width: 20%"></div>
      </div>
      <div class="flex items-center gap-1.5 shrink-0">
        <a
          id="tour-visit-link"
          href="/dev"
          class="px-2 py-1 rounded-lg border border-emerald-400/60 bg-emerald-600/80 hover:bg-emerald-500 font-pixel text-[9px] font-bold text-white no-underline"
        >
          🚪 Buka
        </a>
        <button
          id="tour-next-btn"
          type="button"
          class="px-2 py-1 rounded-lg border border-sky-400/60 bg-sky-600/80 hover:bg-sky-500 font-pixel text-[9px] font-bold text-white cursor-pointer"
        >
          ⏭️ Lanjut
        </button>
      </div>
    </div>
  </div>

  <!-- Floating Legendary Resonance Pill (Auto-appears near compatible pair) -->
  <button
    type="button"
    id="town-resonance-pill"
    class="hidden fixed sm:absolute top-14 left-1/2 -translate-x-1/2 z-30 flex items-center gap-2 px-3.5 py-1.5 rounded-full border-2 border-amber-300 bg-gradient-to-r from-indigo-950/95 via-purple-900/95 to-sky-900/95 text-white shadow-[0_4px_14px_rgba(99,102,241,0.5)] hover:scale-105 cursor-pointer transition-all"
    title="Tekan G untuk mengaktifkan Legendary Resonance Burst!"
  >
    <span class="text-sm animate-pulse" aria-hidden="true">🌟</span>
    <span id="town-resonance-text" class="font-pixel text-[10px] font-bold text-amber-200">
      Resonance Ready
    </span>
    <kbd class="px-1.5 py-0.5 rounded bg-amber-400 text-[#1c1726] font-mono text-[9px] font-bold">G</kbd>
  </button>

  <!-- Floating PokéSnap Studio Dock (In-Game Photo Mode & PNG Postcard Exporter) -->
  <div
    id="town-pokesnap-dock"
    class="hidden fixed sm:absolute bottom-3 left-1/2 -translate-x-1/2 z-40 w-[min(94vw,35rem)] rounded-2xl border-[2.5px] border-[#1c1726] bg-[#111827]/95 text-white p-3 shadow-[0_6px_0_0_#030712] backdrop-blur-xs space-y-2.5"
    role="region"
    aria-label="PokéSnap Studio Photo Mode"
  >
    <div class="flex items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <span class="text-base" aria-hidden="true">📸</span>
        <span class="font-pixel text-xs font-bold text-amber-300">PokéSnap Studio</span>
        <span class="font-mono text-[9px] text-slate-400 hidden sm:inline">Filter Retro &amp; Kartu Pos PNG</span>
      </div>
      <button
        id="pokesnap-close-btn"
        type="button"
        class="px-2 py-1 rounded-lg border border-slate-600 bg-slate-800 hover:bg-rose-600 font-pixel text-[10px] font-bold text-white cursor-pointer"
      >
        ✕ Tutup (O)
      </button>
    </div>

    <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label="Pilih Filter Foto">
      <button type="button" class="pokesnap-filter-btn px-2 py-1 rounded-lg border border-amber-400 bg-amber-400/20 text-amber-200 font-mono text-[10px] font-bold cursor-pointer" data-snap-filter="normal">
        Natural
      </button>
      <button type="button" class="pokesnap-filter-btn px-2 py-1 rounded-lg border border-slate-600 bg-slate-800 text-slate-200 font-mono text-[10px] cursor-pointer" data-snap-filter="gameboy">
        GameBoy Green
      </button>
      <button type="button" class="pokesnap-filter-btn px-2 py-1 rounded-lg border border-slate-600 bg-slate-800 text-slate-200 font-mono text-[10px] cursor-pointer" data-snap-filter="crt">
        CRT Scanlines
      </button>
      <button type="button" class="pokesnap-filter-btn px-2 py-1 rounded-lg border border-slate-600 bg-slate-800 text-slate-200 font-mono text-[10px] cursor-pointer" data-snap-filter="sunset">
        Golden Sunset
      </button>
      <button type="button" class="pokesnap-filter-btn px-2 py-1 rounded-lg border border-slate-600 bg-slate-800 text-slate-200 font-mono text-[10px] cursor-pointer" data-snap-filter="cyber">
        Cyberpunk Neon
      </button>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-2 pt-1 border-t border-slate-700/70">
      <div class="flex items-center gap-1.5">
        <button
          id="pokesnap-pose-btn"
          type="button"
          class="px-2.5 py-1.5 rounded-xl border border-sky-400/60 bg-sky-600/80 hover:bg-sky-500 font-pixel text-[10px] font-bold text-white cursor-pointer"
        >
          ⚡ Pose Skill Partner
        </button>
        <button
          id="pokesnap-zoom-btn"
          type="button"
          class="px-2.5 py-1.5 rounded-xl border border-slate-600 bg-slate-800 hover:bg-slate-700 font-mono text-[10px] font-bold text-slate-200 cursor-pointer"
        >
          🔍 Zoom In/Out
        </button>
      </div>
      <button
        id="pokesnap-capture-btn"
        type="button"
        class="px-3.5 py-1.5 rounded-xl border-2 border-[#1c1726] bg-emerald-500 hover:bg-emerald-400 text-[#052e16] font-pixel text-[11px] font-bold shadow-[0_2px_0_0_#064e3b] cursor-pointer"
      >
        📸 Jepret &amp; Unduh PNG
      </button>
    </div>
  </div>
