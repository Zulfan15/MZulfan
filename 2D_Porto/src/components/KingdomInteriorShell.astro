---
import TownLayout from '../layouts/TownLayout.astro';
import WhereTo from './WhereTo.astro';
import { ROYAL_CRESTS_META, type RoyalCrestKey } from '../engine/kingdomInteriorShared';

interface QuickWalkStation {
  id: string;
  icon: string;
  label: string;
  hotkey: string;
}

interface Props {
  title: string;
  description: string;
  placeId: string;
  routePath: string;
  crestKey: RoyalCrestKey;
  exitHref: string;
  exitRespawn: string;
  bannerSubtitle: string;
  headline: string;
  intro: string;
  primaryGuardianName: string;
  primaryGuardianQuote: string;
  guardiansSummary: string;
  upcomingPhaseLabel: string;
  stations: QuickWalkStation[];
}

const {
  title,
  description,
  placeId,
  routePath,
  crestKey,
  exitHref,
  exitRespawn,
  bannerSubtitle,
  headline,
  intro,
  primaryGuardianName,
  primaryGuardianQuote,
  guardiansSummary,
  upcomingPhaseLabel,
  stations,
} = Astro.props;

const crestMeta = ROYAL_CRESTS_META[crestKey];
const allCrests = Object.values(ROYAL_CRESTS_META);
---

<TownLayout title={title} description={description} place={placeId}>
  <article class="kingdom-interior-page space-y-6 pb-10 text-[#1e1b18]" data-exit-respawn={exitRespawn}>
    <!-- Heraldic Parchment & Gold-trimmed Kingdom Banner -->
    <header class="relative overflow-hidden rounded-2xl border-[3px] border-[#b45309] bg-gradient-to-b from-[#fef7e6] via-[#f7ead1] to-[#ecd9b4] p-5 text-[#2c1e12] shadow-[0_8px_0_#78350f,0_18px_36px_rgba(44,30,18,0.35)]">
      <div
        class="pointer-events-none absolute inset-x-0 top-0 h-2 bg-[repeating-linear-gradient(90deg,#1e3a8a_0px,#1e3a8a_14px,#fbbf24_14px,#fbbf24_28px,#b91c1c_28px,#b91c1c_42px)]"
        aria-hidden="true"
      ></div>
      <div
        class="pointer-events-none absolute inset-x-0 bottom-0 h-2 bg-[repeating-linear-gradient(90deg,#b91c1c_0px,#b91c1c_14px,#fbbf24_14px,#fbbf24_28px,#1e3a8a_28px,#1e3a8a_42px)]"
        aria-hidden="true"
      ></div>

      <div class="relative z-10 mt-1 flex flex-wrap items-start justify-between gap-4">
        <div class="space-y-2">
          <div class="flex flex-wrap items-center gap-2">
            <span class="rounded-full border border-[#1e3a8a]/40 bg-[#1e3a8a] px-3 py-1 font-mono text-[10px] font-bold uppercase tracking-[0.14em] text-[#fef3c7]">
              {bannerSubtitle}
            </span>
            <span
              id="kingdom-crest-pill"
              data-crest-key={crestKey}
              class="rounded-full border border-[#b45309]/50 bg-[#fef3c7] px-2.5 py-1 font-mono text-[10px] font-bold uppercase text-[#78350f]"
            >
              ⏳ {crestMeta.name} Unclaimed
            </span>
          </div>

          <h1 class="font-display text-2xl font-black tracking-tight text-[#1e293b] sm:text-3xl">
            {headline}
          </h1>
          <p class="max-w-2xl text-sm leading-relaxed text-[#44403c]">
            {intro}
          </p>
        </div>

        <div class="flex flex-col items-end gap-2">
          <div class="rounded-xl border-2 border-[#b45309] bg-[#fffbeb] px-3.5 py-2 text-center font-mono shadow-inner">
            <div class="text-[9px] font-bold uppercase tracking-wider text-[#92400e]">AVALON ROYAL CRESTS</div>
            <div id="kingdom-crests-counter" class="text-sm font-black text-[#1e3a8a]">0 / 7</div>
          </div>

          <a
            id="kingdom-exit-btn"
            href={exitHref}
            data-exit-respawn={exitRespawn}
            class="inline-flex items-center gap-1.5 rounded-xl border-2 border-[#78350f] bg-gradient-to-b from-[#b91c1c] to-[#7f1d1d] px-3.5 py-2 font-mono text-xs font-extrabold text-[#fef3c7] shadow-[0_3px_0_#450a0a] transition hover:-translate-y-0.5 hover:brightness-110"
          >
            🚪 Exit to Royal Kingdom
          </a>
        </div>
      </div>

      <!-- Guardian Dialogue Strip -->
      <div class="relative z-10 mt-4 flex items-center gap-3 rounded-xl border-2 border-[#b45309]/50 bg-[#fffbeb]/90 px-4 py-3 text-xs">
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-[#b45309] bg-[#fef3c7] text-lg">
          {crestMeta.icon}
        </span>
        <div class="min-w-0 flex-1">
          <div class="font-mono text-[10px] font-bold uppercase tracking-wider text-[#1e3a8a]">
            {primaryGuardianName} · {guardiansSummary}
          </div>
          <p class="mt-0.5 italic text-[#44403c]">“{primaryGuardianQuote}”</p>
        </div>
      </div>

      <!-- Quick-Walk Stations inside 2D Sanctum -->
      <nav aria-label="Quick walk stations" class="relative z-10 mt-4 grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-4">
        {stations.map((s) => (
          <button
            type="button"
            data-kingdom-walk-prop={s.id}
            data-hotkey={s.hotkey.toLowerCase()}
            class="kingdom-walk-chip flex cursor-pointer items-center justify-between gap-2 rounded-xl border-2 border-[#b45309]/70 bg-[#fffbeb] px-3 py-2 text-left text-[#2c1e12] shadow-[0_2px_0_#92400e] transition hover:-translate-y-0.5 hover:border-[#1e3a8a] hover:bg-white"
          >
            <span class="flex items-center gap-1.5 truncate text-xs font-bold">
              <span>{s.icon}</span>
              <span class="truncate">{s.label}</span>
            </span>
            <kbd class="shrink-0 rounded border border-[#b45309]/40 bg-[#fef3c7] px-1.5 py-0.5 font-mono text-[9px] font-bold text-[#78350f]">
              {s.hotkey}
            </kbd>
          </button>
        ))}
      </nav>
    </header>

    <!-- Fase 0 Interactive Preview Notice + 7 Royal Crests Ledger -->
    <section class="rounded-2xl border-[3px] border-[#1e3a8a] bg-gradient-to-b from-[#fefcf5] to-[#f4ead5] p-5 text-[#1e293b] shadow-[0_6px_0_#1e3a8a]">
      <div class="flex flex-wrap items-center justify-between gap-2 border-b-2 border-[#b45309]/30 pb-3">
        <div>
          <span class="font-mono text-[10px] font-bold uppercase tracking-[0.14em] text-[#b45309]">
            {upcomingPhaseLabel}
          </span>
          <h2 class="mt-0.5 font-display text-lg font-black text-[#1e3a8a]">
            {crestMeta.icon} Royal Trial &amp; Portfolio Sanctum
          </h2>
        </div>
        <span class="rounded-full border border-[#b45309]/40 bg-[#fef3c7] px-3 py-1 font-mono text-[10px] font-bold text-[#78350f]">
          Fondasi Pintu &amp; Kanvas 2D Aktif
        </span>
      </div>

      <p class="mt-3 text-xs leading-relaxed text-[#44403c]">
        Gerbang masuk dari peta luar Royal Kingdom dan pintu keluar <code class="rounded bg-[#e7dcc4] px-1.5 py-0.5 font-mono font-bold text-[#78350f]">EXIT (7, 11)</code> sudah terhubung penuh ke kanvas 2D ini beserta para penjaga resminya. Konten interaktif penuh serta mini-game <strong>{crestMeta.trial}</strong> akan dibangun pada fase berikutnya sesuai plan!
      </p>

      <slot />

      <!-- 7 Royal Crests Meta-Progress Registry -->
      <div class="mt-5 rounded-xl border-2 border-[#b45309]/40 bg-[#fffbeb]/80 p-4">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <span class="font-mono text-[10px] font-bold uppercase tracking-[0.14em] text-[#78350f]">
            ⚔️ 7 ROYAL CRESTS OF AVALON (EXCALIBUR UNLOCK TRACKER)
          </span>
          <span class="font-mono text-[10px] font-bold text-[#1e3a8a]">Excalibur Finale locked until 7/7 Crests</span>
        </div>
        <div class="mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
          {allCrests.map((c) => (
            <a
              href={c.route}
              data-royal-crest-card={c.key}
              class="flex items-center justify-between gap-2 rounded-lg border border-[#b45309]/40 bg-white px-2.5 py-2 text-xs transition hover:-translate-y-0.5 hover:border-[#1e3a8a]"
            >
              <div class="min-w-0">
                <div class="truncate font-bold text-[#1e293b]">{c.icon} {c.name}</div>
                <div class="truncate font-mono text-[9px] text-[#78350f]">{c.sanctum}</div>
              </div>
              <span data-royal-crest-badge={c.key} class="shrink-0 font-mono text-[10px] font-bold text-[#94a3b8]">
                🔒
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <WhereTo currentPath={routePath} />
  </article>
</TownLayout>

<script>
  import { countRoyalCrests, getRoyalCrests, type RoyalCrestKey } from '../engine/kingdomInteriorShared';

  function initKingdomInteriorShell() {
    const root = document.querySelector<HTMLElement>('.kingdom-interior-page');
    if (!root) return;

    const exitBtn = document.getElementById('kingdom-exit-btn');
    exitBtn?.addEventListener('click', () => {
      const respawn = root.dataset.exitRespawn;
      if (respawn) {
        try {
          sessionStorage.setItem('kingdom:respawn', respawn);
        } catch {
          // ignore
        }
      }
    });

    const walkProp = (id: string) => {
      window.dispatchEvent(new CustomEvent('town:walk-to', { detail: { id } }));
      window.dispatchEvent(new CustomEvent('town:kingdom-fx', { detail: { text: id.toUpperCase(), color: '#fbbf24' } }));
    };

    document.querySelectorAll<HTMLElement>('[data-kingdom-walk-prop]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.kingdomWalkProp;
        if (id) walkProp(id);
      });
    });

    const onHotkey = (e: KeyboardEvent) => {
      const tag = (e.target as HTMLElement | null)?.tagName;
      if (tag === 'INPUT' || tag === 'SELECT' || tag === 'TEXTAREA') return;
      if (e.ctrlKey || e.metaKey || e.altKey) return;
      const matched = document.querySelector<HTMLElement>(`[data-hotkey="${e.key.toLowerCase()}"]`);
      const id = matched?.dataset.kingdomWalkProp;
      if (id) {
        e.preventDefault();
        walkProp(id);
      }
    };
    window.addEventListener('keydown', onHotkey);

    // Hydrate 7 Royal Crests tracker
    const crests = getRoyalCrests();
    const count = countRoyalCrests();
    const counter = document.getElementById('kingdom-crests-counter');
    if (counter) counter.textContent = `${count} / 7`;

    const pill = document.getElementById('kingdom-crest-pill');
    const pageCrest = pill?.dataset.crestKey as RoyalCrestKey | undefined;
    if (pill && pageCrest && crests[pageCrest]) {
      pill.textContent = '✅ Crest Claimed';
      pill.className = 'rounded-full border border-[#15803d] bg-[#dcfce7] px-2.5 py-1 font-mono text-[10px] font-bold uppercase text-[#14532d]';
    }

    (['sovereignty', 'steel', 'fellowship', 'arcana', 'valor', 'grace', 'chivalry'] as const).forEach((k) => {
      const badge = document.querySelector<HTMLElement>(`[data-royal-crest-badge="${k}"]`);
      if (badge && crests[k]) {
        badge.textContent = '✅';
      }
    });

    document.addEventListener(
      'astro:before-swap',
      () => {
        window.removeEventListener('keydown', onHotkey);
      },
      { once: true }
    );
  }

  initKingdomInteriorShell();
  document.addEventListener('astro:page-load', initKingdomInteriorShell);
</script>
