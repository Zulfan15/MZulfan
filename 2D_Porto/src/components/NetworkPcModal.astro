---
// NetworkPcModal.astro — Interactive Poké Center PC System (Bill's PC V4.2 Zulfan Edition)
// Features: Official Trainer Card, Critter Safari Sync, and Visitor Guestbook & Reaction Stamp
import { profile } from '../lib/profile';

const githubUrl = profile.socials.find((s) => s.label === 'GitHub')?.url || 'https://github.com/Zulfan15';
const linkedinUrl = profile.socials.find((s) => s.label === 'LinkedIn')?.url || 'https://www.linkedin.com/in/muhammad-zulfan-anggadhiputra';
const emailUrl = `mailto:${profile.person.email}`;
const cvUrl = profile.person.cv || '/cv/CV_Zulfan.pdf';
const critters = profile.critters || [];
---

<dialog
  id="network-pc-modal"
  class="network-pc-dialog backdrop:bg-slate-950/80 backdrop:backdrop-blur-sm"
  aria-labelledby="network-pc-title"
>
  <div class="network-pc-card window p-0 overflow-hidden bg-slate-900 border-2 border-emerald-500/70 shadow-2xl text-slate-100 flex flex-col max-h-[92vh] w-[95vw] max-w-4xl">
    <!-- Top System Header Bar -->
    <header class="bg-slate-950 px-4 py-3 border-b-2 border-emerald-500/40 flex items-center justify-between gap-3 flex-wrap">
      <div class="flex items-center gap-2.5">
        <span class="text-2xl p-1.5 rounded-lg bg-emerald-950 border border-emerald-500/50">💻</span>
        <div>
          <div class="flex items-center gap-2">
            <span class="chip bg-emerald-950 text-emerald-400 border border-emerald-700/60 font-mono text-[9px] px-1.5 py-0.5 font-bold uppercase tracking-wider">
              ONLINE · SECURE HTTPS
            </span>
            <span class="chip bg-blue-950 text-blue-400 border border-blue-700/60 font-mono text-[9px] px-1.5 py-0.5 font-bold uppercase tracking-wider hidden sm:inline-block">
              NODE: BANDUNG_ITENAS_01
            </span>
          </div>
          <h2 id="network-pc-title" class="font-pixel text-xs text-white tracking-wide mt-0.5">
            Poké Center Network Storage System · Bill's PC V4.2
          </h2>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <button
          type="button"
          id="btn-close-network-pc"
          class="btn btn-sm bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-600 font-pixel text-xs px-2.5 py-1 transition-colors"
          aria-label="Close Network PC"
        >
          ✕ CLOSE
        </button>
      </div>
    </header>

    <!-- Sub-Nav Tab Navigation -->
    <nav class="bg-slate-950/90 px-4 py-2 border-b border-slate-800 flex items-center justify-between gap-2 overflow-x-auto text-xs font-mono">
      <div class="flex items-center gap-1.5" id="pc-tab-buttons">
        <button
          type="button"
          class="pc-tab-btn btn btn-sm bg-emerald-600 text-white border border-emerald-400 px-3 py-1 font-bold flex items-center gap-1.5 transition-all"
          data-tab="card"
        >
          <span>🪪</span>
          <span>1. Trainer Card</span>
        </button>
        <button
          type="button"
          class="pc-tab-btn btn btn-sm bg-slate-800 text-slate-300 border border-slate-700 hover:border-emerald-500 px-3 py-1 flex items-center gap-1.5 transition-all"
          data-tab="safari"
        >
          <span>🐾</span>
          <span>2. Critter Safari Dex</span>
        </button>
        <button
          type="button"
          class="pc-tab-btn btn btn-sm bg-slate-800 text-slate-300 border border-slate-700 hover:border-emerald-500 px-3 py-1 flex items-center gap-1.5 transition-all"
          data-tab="guestbook"
        >
          <span>📝</span>
          <span>3. Visitor Guestbook</span>
        </button>
      </div>

      <div class="hidden sm:flex items-center gap-2 font-mono text-[10px] text-slate-400">
        <span>STORAGE: 100% OPERATIONAL</span>
      </div>
    </nav>

    <!-- Main Content Body (Scrollable) -->
    <div class="overflow-y-auto p-4 md:p-6 space-y-6 flex-1 bg-gradient-to-b from-slate-900 via-slate-900 to-slate-950">
      
      <!-- ================= TAB 1: TRAINER CARD ================= -->
      <section id="pc-panel-card" class="pc-panel space-y-5">
        <!-- Retro Trainer Card Frame -->
        <div class="p-5 md:p-6 rounded-2xl bg-gradient-to-br from-slate-800 via-slate-850 to-slate-950 border-2 border-emerald-400/50 shadow-xl relative overflow-hidden">
          <!-- Ambient Background Grid -->
          <div class="absolute inset-0 bg-[radial-gradient(#10b981_1px,transparent_1px)] [background-size:16px_16px] opacity-10 pointer-events-none"></div>

          <!-- Card Top Bar -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b-2 border-emerald-500/30 pb-4 mb-4 relative z-10">
            <div>
              <span class="chip bg-emerald-500/20 text-emerald-300 border border-emerald-400/40 font-mono text-[9px] px-2 py-0.5 font-bold uppercase tracking-widest">
                OFFICIAL POKÉMON LEAGUE &amp; TECH PASSPORT
              </span>
              <h3 class="font-pixel text-base md:text-lg text-white mt-1">
                {profile.person.name.toUpperCase()}
              </h3>
              <p class="font-sans text-xs text-slate-400">
                Informatics Bachelor of Computer Science · ITENAS Bandung
              </p>
            </div>

            <div class="flex flex-col sm:items-end">
              <span class="font-mono text-xs text-emerald-400 font-bold tracking-wider">
                IDNo. 349400
              </span>
              <span class="font-mono text-[10px] text-slate-400">
                CLASS S · MASTER ENGINEER
              </span>
            </div>
          </div>

          <!-- Profile Snapshot & Core Metrics -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 relative z-10">
            <div class="p-3.5 rounded-xl bg-slate-950/70 border border-slate-800 space-y-2">
              <span class="font-mono text-[10px] text-slate-400 block uppercase font-bold">Academic Base</span>
              <div class="text-xs text-white font-semibold">Institut Teknologi Nasional (ITENAS)</div>
              <div class="text-[11px] text-emerald-300 font-mono">GPA 3.49 / 4.00 · Graduated 2024</div>
            </div>

            <div class="p-3.5 rounded-xl bg-slate-950/70 border border-slate-800 space-y-2">
              <span class="font-mono text-[10px] text-slate-400 block uppercase font-bold">Industry Certification</span>
              <div class="text-xs text-white font-semibold">Huawei HCIA-Security V4.0</div>
              <div class="text-[11px] text-blue-300 font-mono">Enterprise NGFW · VPN · ACLs</div>
            </div>

            <div class="p-3.5 rounded-xl bg-slate-950/70 border border-slate-800 space-y-2">
              <span class="font-mono text-[10px] text-slate-400 block uppercase font-bold">Leadership &amp; Awards</span>
              <div class="text-xs text-white font-semibold">6x ITENAS Lab Assistant Lead</div>
              <div class="text-[11px] text-amber-300 font-mono">National IDEA FEST 3rd Place Bronze</div>
            </div>
          </div>

          <!-- 8 Master Gym Badges Showcase -->
          <div class="mt-5 pt-4 border-t border-slate-800 relative z-10">
            <div class="flex items-center justify-between mb-3">
              <span class="font-pixel text-[11px] text-emerald-300 uppercase tracking-wide">
                🏆 Engineering Badges Rack (8 / 8 Earned)
              </span>
              <span class="font-mono text-[10px] text-slate-400">
                100% League Verification
              </span>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
              <!-- Badge 1 -->
              <div class="p-2.5 rounded-lg bg-slate-950/80 border border-emerald-500/40 flex items-center gap-2 hover:border-emerald-400 transition-colors">
                <span class="text-2xl">🛸</span>
                <div>
                  <div class="font-pixel text-[10px] text-white">AeroScan UAV</div>
                  <div class="font-mono text-[9px] text-emerald-400">YOLOv8 + SAHI Thesis</div>
                </div>
              </div>

              <!-- Badge 2 -->
              <div class="p-2.5 rounded-lg bg-slate-950/80 border border-blue-500/40 flex items-center gap-2 hover:border-blue-400 transition-colors">
                <span class="text-2xl">🛡️</span>
                <div>
                  <div class="font-pixel text-[10px] text-white">Huawei Security</div>
                  <div class="font-mono text-[9px] text-blue-400">HCIA-Security V4.0</div>
                </div>
              </div>

              <!-- Badge 3 -->
              <div class="p-2.5 rounded-lg bg-slate-950/80 border border-amber-500/40 flex items-center gap-2 hover:border-amber-400 transition-colors">
                <span class="text-2xl">🤖</span>
                <div>
                  <div class="font-pixel text-[10px] text-white">Robotics Head</div>
                  <div class="font-mono text-[9px] text-amber-400">ITENAS Lab Coordinator</div>
                </div>
              </div>

              <!-- Badge 4 -->
              <div class="p-2.5 rounded-lg bg-slate-950/80 border border-rose-500/40 flex items-center gap-2 hover:border-rose-400 transition-colors">
                <span class="text-2xl">🥉</span>
                <div>
                  <div class="font-pixel text-[10px] text-white">IDEA FEST Bronze</div>
                  <div class="font-mono text-[9px] text-rose-400">National 3rd Place</div>
                </div>
              </div>

              <!-- Badge 5 -->
              <div class="p-2.5 rounded-lg bg-slate-950/80 border border-purple-500/40 flex items-center gap-2 hover:border-purple-400 transition-colors">
                <span class="text-2xl">⚡</span>
                <div>
                  <div class="font-pixel text-[10px] text-white">FoodLink Micro</div>
                  <div class="font-mono text-[9px] text-purple-400">Kafka &amp; Redis Streams</div>
                </div>
              </div>

              <!-- Badge 6 -->
              <div class="p-2.5 rounded-lg bg-slate-950/80 border border-cyan-500/40 flex items-center gap-2 hover:border-cyan-400 transition-colors">
                <span class="text-2xl">👨‍🏫</span>
                <div>
                  <div class="font-pixel text-[10px] text-white">6x Lab Assistant</div>
                  <div class="font-mono text-[9px] text-cyan-400">240+ Engineers Mentored</div>
                </div>
              </div>

              <!-- Badge 7 -->
              <div class="p-2.5 rounded-lg bg-slate-950/80 border border-orange-500/40 flex items-center gap-2 hover:border-orange-400 transition-colors">
                <span class="text-2xl">📱</span>
                <div>
                  <div class="font-pixel text-[10px] text-white">ESP32 Telemetry</div>
                  <div class="font-mono text-[9px] text-orange-400">Flutter WebSockets C++</div>
                </div>
              </div>

              <!-- Badge 8 -->
              <div class="p-2.5 rounded-lg bg-slate-950/80 border border-teal-500/40 flex items-center gap-2 hover:border-teal-400 transition-colors">
                <span class="text-2xl">🎮</span>
                <div>
                  <div class="font-pixel text-[10px] text-white">Canvas Engine</div>
                  <div class="font-mono text-[9px] text-teal-400">Astro &amp; TypeScript 60fps</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Bottom Card Footer & Action Buttons -->
          <div class="mt-5 pt-4 border-t border-slate-800 flex flex-wrap items-center justify-between gap-3 relative z-10">
            <p class="font-sans text-xs italic text-slate-400 max-w-md">
              "Dedicated to architecting resilient distributed backends, edge computer vision models, and engaging web experiences."
            </p>

            <div class="flex items-center gap-2">
              <a
                href={cvUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-sm bg-amber-500 hover:bg-amber-400 text-slate-950 border border-amber-300 font-pixel text-xs px-3 py-1 flex items-center gap-1.5 font-bold"
              >
                <span>📄</span>
                <span>Download CV</span>
              </a>
              <a
                href={linkedinUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-sm bg-blue-600 hover:bg-blue-500 text-white border border-blue-400 font-pixel text-xs px-3 py-1 flex items-center gap-1.5"
              >
                <span>💼</span>
                <span>LinkedIn</span>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- ================= TAB 2: CRITTER SAFARI DEX ================= -->
      <section id="pc-panel-safari" class="pc-panel hidden space-y-4">
        <!-- Live Status Bar -->
        <div class="p-4 rounded-xl bg-slate-950 border border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <div class="flex items-center gap-2">
              <h3 class="font-pixel text-xs text-white uppercase tracking-wide">
                Wild Critter Safari · Live Town Status
              </h3>
              <span id="pc-safari-badge" class="chip bg-emerald-950 text-emerald-400 border border-emerald-600 font-mono text-[10px] px-2 py-0.5 font-bold">
                SYNCED WITH LOCAL STORAGE
              </span>
            </div>
            <p class="font-sans text-xs text-slate-400 mt-0.5">
              Explore the tall grass meadow in southern Town Square to discover and catch wild critters with Poké Balls.
            </p>
          </div>

          <div class="flex items-center gap-3">
            <div class="text-right">
              <span class="font-mono text-[10px] text-slate-400 block">POKÉ BALLS</span>
              <span id="pc-safari-balls" class="font-mono text-sm text-emerald-400 font-bold">10 / 10 Balls</span>
            </div>
            <div class="text-right">
              <span class="font-mono text-[10px] text-slate-400 block">CAUGHT CRITTERS</span>
              <span id="pc-safari-caught" class="font-mono text-sm text-amber-400 font-bold">0 / 12 Caught</span>
            </div>
          </div>
        </div>

        <!-- 12-Slot Critter Matrix -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2.5" id="pc-critters-grid">
          {critters.map((c, i) => (
            <div
              class="pc-critter-slot p-3 rounded-xl bg-slate-950/70 border border-slate-800 hover:border-slate-700 transition-all flex items-start gap-3"
              data-critter-id={c.id}
            >
              <div
                class="w-10 h-10 rounded-lg flex items-center justify-center text-lg font-bold shadow-inner border border-white/10 shrink-0"
                style={`background: linear-gradient(135deg, ${c.colors[0]}, ${c.colors[1]});`}
              >
                #{i + 1}
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between gap-1">
                  <h4 class="font-pixel text-[11px] text-white truncate">{c.name}</h4>
                  <span class="pc-critter-status-chip chip font-mono text-[9px] px-1.5 py-0.2 bg-slate-900 border border-slate-700 text-slate-400">
                    Undiscovered
                  </span>
                </div>
                <div class="flex items-center gap-1.5 mt-0.5">
                  <span class="font-mono text-[10px] text-slate-400 capitalize">{c.type}</span>
                  <span class="text-slate-600">•</span>
                  <span class="font-mono text-[10px] text-amber-400/90 capitalize">{c.rarity}</span>
                </div>
                <p class="font-sans text-[10px] text-slate-400 mt-1 line-clamp-1">
                  {c.blurb}
                </p>
              </div>
            </div>
          ))}
        </div>

        <div class="p-3 rounded-lg bg-emerald-950/40 border border-emerald-500/30 flex items-center justify-between gap-2 text-xs font-mono">
          <span class="text-emerald-300">💡 Low on Poké Balls? Nurse Mira and Chansey offer free refills at the front desk!</span>
          <a href="/" class="btn btn-sm bg-slate-800 hover:bg-slate-700 text-white font-pixel text-[10px] px-2 py-1 shrink-0">
            Hunt in Town Square →
          </a>
        </div>
      </section>

      <!-- ================= TAB 3: VISITOR GUESTBOOK ================= -->
      <section id="pc-panel-guestbook" class="pc-panel hidden space-y-4">
        <!-- New Guestbook Entry Form -->
        <div class="p-4 md:p-5 rounded-xl bg-slate-950 border border-emerald-500/40 space-y-3.5">
          <div class="flex items-center justify-between border-b border-slate-800 pb-2.5">
            <div>
              <h3 class="font-pixel text-xs text-white uppercase tracking-wide flex items-center gap-2">
                <span>📝 Sign the Poké Center Guestbook</span>
              </h3>
              <p class="font-sans text-[11px] text-slate-400 mt-0.5">
                Leave a reaction stamp and greeting for Muhammad Zulfan. Entries are saved locally to your session!
              </p>
            </div>
            <span class="chip bg-amber-950 text-amber-300 border border-amber-600 font-mono text-[9px] font-bold px-2 py-0.5">
              REACTION STAMPS
            </span>
          </div>

          <!-- Stamp Picker -->
          <div>
            <label class="block font-mono text-[10px] text-slate-400 uppercase font-bold mb-1.5">
              Choose Your Reaction Stamp:
            </label>
            <div class="flex flex-wrap gap-2" id="guestbook-stamp-picker">
              <button
                type="button"
                class="stamp-btn chip bg-emerald-600 text-white border-2 border-emerald-300 font-mono text-xs px-2.5 py-1 font-bold cursor-pointer transition-all"
                data-stamp="🌟 Awesome Portfolio!"
              >
                🌟 Awesome Portfolio!
              </button>
              <button
                type="button"
                class="stamp-btn chip bg-slate-900 text-slate-300 border border-slate-700 hover:border-emerald-500 font-mono text-xs px-2.5 py-1 cursor-pointer transition-all"
                data-stamp="💼 Recruiter Visited"
              >
                💼 Recruiter Visited
              </button>
              <button
                type="button"
                class="stamp-btn chip bg-slate-900 text-slate-300 border border-slate-700 hover:border-emerald-500 font-mono text-xs px-2.5 py-1 cursor-pointer transition-all"
                data-stamp="🚀 10/10 Engineering"
              >
                🚀 10/10 Engineering
              </button>
              <button
                type="button"
                class="stamp-btn chip bg-slate-900 text-slate-300 border border-slate-700 hover:border-emerald-500 font-mono text-xs px-2.5 py-1 cursor-pointer transition-all"
                data-stamp="☕ Let's Connect"
              >
                ☕ Let's Connect
              </button>
              <button
                type="button"
                class="stamp-btn chip bg-slate-900 text-slate-300 border border-slate-700 hover:border-emerald-500 font-mono text-xs px-2.5 py-1 cursor-pointer transition-all"
                data-stamp="💡 Brilliant Architecture"
              >
                💡 Brilliant Architecture
              </button>
            </div>
          </div>

          <!-- Input Fields -->
          <form id="guestbook-form" class="space-y-3 pt-1">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
              <div>
                <label for="guest-name" class="block font-mono text-[10px] text-slate-400 mb-1">
                  Your Name / Organization:
                </label>
                <input
                  type="text"
                  id="guest-name"
                  placeholder="e.g. Maya (Senior Tech Recruiter)"
                  maxlength="50"
                  required
                  class="w-full px-3 py-2 rounded-lg bg-slate-900 border border-slate-700 text-white font-sans text-xs focus:border-emerald-400 focus:outline-none"
                />
              </div>
              <div>
                <label for="guest-role" class="block font-mono text-[10px] text-slate-400 mb-1">
                  Company / Affiliation (Optional):
                </label>
                <input
                  type="text"
                  id="guest-role"
                  placeholder="e.g. AI Startup / Jakarta"
                  maxlength="50"
                  class="w-full px-3 py-2 rounded-lg bg-slate-900 border border-slate-700 text-white font-sans text-xs focus:border-emerald-400 focus:outline-none"
                />
              </div>
            </div>

            <div>
              <label for="guest-message" class="block font-mono text-[10px] text-slate-400 mb-1">
                Your Note / Feedback:
              </label>
              <textarea
                id="guest-message"
                rows="2"
                placeholder="Share your thoughts on Zulfan's projects, technical depth, or portfolio town..."
                maxlength="200"
                required
                class="w-full px-3 py-2 rounded-lg bg-slate-900 border border-slate-700 text-white font-sans text-xs focus:border-emerald-400 focus:outline-none resize-none"
              ></textarea>
            </div>

            <div class="flex items-center justify-between pt-1">
              <span id="guestbook-feedback" class="font-mono text-xs text-emerald-400 hidden">
                ✨ Your stamp was successfully recorded in the guestbook!
              </span>
              <button
                type="submit"
                class="btn btn-sm bg-emerald-600 hover:bg-emerald-500 text-white border border-emerald-400 font-pixel text-xs px-4 py-2 flex items-center gap-2 ml-auto shadow-md active:scale-95 transition-all"
              >
                <span>🖋️</span>
                <span>Sign Guestbook</span>
              </button>
            </div>
          </form>
        </div>

        <!-- Guestbook Stream Log -->
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <h4 class="font-pixel text-[11px] text-slate-300 uppercase tracking-wide">
              Recent Visitor Inscriptions
            </h4>
            <span id="guestbook-count-badge" class="font-mono text-[10px] text-slate-400">
              3 Inscriptions
            </span>
          </div>

          <div class="space-y-2.5" id="guestbook-list">
            <!-- Dynamically populated via script -->
          </div>
        </div>
      </section>

    </div>

    <!-- Modal Footer -->
    <footer class="bg-slate-950 px-4 py-3 border-t border-slate-800 flex flex-wrap items-center justify-between gap-3 text-xs font-mono">
      <div class="flex items-center gap-2 text-slate-400 text-[11px]">
        <span>⚡ System: Bill's PC Storage Terminal</span>
        <span>•</span>
        <span>Location: Poké Center Bandung</span>
      </div>

      <div class="flex items-center gap-2">
        <button
          type="button"
          id="btn-footer-close-pc"
          class="btn btn-sm bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-600 font-pixel text-xs px-3 py-1"
        >
          Exit Terminal
        </button>
      </div>
    </footer>
  </div>
</dialog>

<script>
  import { sfx } from '../game/sfx';
  import { gameStore } from '../game/store';

  interface GuestbookEntry {
    name: string;
    role: string;
    stamp: string;
    message: string;
    time: string;
  }

  const INITIAL_ENTRIES: GuestbookEntry[] = [
    {
      name: 'Sarah Kurnia',
      role: 'Senior Tech Recruiter · Singapore',
      stamp: '💼 Recruiter Visited',
      message: 'Incredibly creative interactive portfolio! The combination of verified engineering credentials (GPA 3.49, Huawei HCIA) and the 2D canvas simulation is unforgettable.',
      time: 'Earlier today',
    },
    {
      name: 'Lab Team Lead',
      role: 'ITENAS Informatics Department',
      stamp: '🌟 Awesome Portfolio!',
      message: 'Zulfan has consistently shown stellar leadership as Robotics Lab Coordinator and 6-time teaching assistant. Highly endorsed for AI and software roles!',
      time: 'Yesterday',
    },
    {
      name: 'DevOps Architect',
      role: 'Cloud Systems Engineer',
      stamp: '💡 Brilliant Architecture',
      message: 'Inspected the FoodLink microservices setup with Kafka, Redis, and FastAPI—solid structural decoupling and clean code practices.',
      time: '2 days ago',
    },
  ];

  function initNetworkPcModal() {
    const dialog = document.getElementById('network-pc-modal') as HTMLDialogElement | null;
    const closeBtn = document.getElementById('btn-close-network-pc');
    const footerCloseBtn = document.getElementById('btn-footer-close-pc');
    if (!dialog) return;

    // Tabs
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('.pc-tab-btn');
    const panels = {
      card: document.getElementById('pc-panel-card'),
      safari: document.getElementById('pc-panel-safari'),
      guestbook: document.getElementById('pc-panel-guestbook'),
    };

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tab = btn.getAttribute('data-tab') as 'card' | 'safari' | 'guestbook';
        if (!tab) return;

        tabButtons.forEach((b) => {
          const isAct = b === btn;
          b.className = isAct
            ? 'pc-tab-btn btn btn-sm bg-emerald-600 text-white border border-emerald-400 px-3 py-1 font-bold flex items-center gap-1.5 transition-all'
            : 'pc-tab-btn btn btn-sm bg-slate-800 text-slate-300 border border-slate-700 hover:border-emerald-500 px-3 py-1 flex items-center gap-1.5 transition-all';
        });

        Object.entries(panels).forEach(([key, panel]) => {
          if (panel) {
            panel.classList.toggle('hidden', key !== tab);
          }
        });

        if (tab === 'safari') {
          syncSafariDex();
        }

        sfx.select();
      });
    });

    // Sync Safari Dex Status from GameStore / LocalStorage
    function syncSafariDex() {
      const state = gameStore.getState();
      const ballsEl = document.getElementById('pc-safari-balls');
      const caughtEl = document.getElementById('pc-safari-caught');

      if (ballsEl) {
        ballsEl.textContent = `${state.balls} / 10 Balls`;
      }
      if (caughtEl) {
        caughtEl.textContent = `${state.caught.length} / 12 Caught`;
      }

      // Update critter slots
      const critterSlots = document.querySelectorAll<HTMLElement>('.pc-critter-slot');
      critterSlots.forEach((slot) => {
        const id = slot.getAttribute('data-critter-id');
        const chip = slot.querySelector('.pc-critter-status-chip');
        if (!id || !chip) return;

        const isCaught = state.caught.includes(id);
        if (isCaught) {
          chip.textContent = 'CAUGHT ✨';
          chip.className = 'pc-critter-status-chip chip font-mono text-[9px] px-1.5 py-0.2 bg-emerald-900 border border-emerald-500 text-emerald-200 font-bold';
          slot.classList.add('border-emerald-500/60', 'bg-emerald-950/20');
        } else {
          chip.textContent = 'Undiscovered';
          chip.className = 'pc-critter-status-chip chip font-mono text-[9px] px-1.5 py-0.2 bg-slate-900 border border-slate-700 text-slate-400';
          slot.classList.remove('border-emerald-500/60', 'bg-emerald-950/20');
        }
      });
    }

    // Guestbook Logic
    let selectedStamp = '🌟 Awesome Portfolio!';
    const stampPicker = document.getElementById('guestbook-stamp-picker');
    if (stampPicker) {
      const stampButtons = stampPicker.querySelectorAll<HTMLButtonElement>('.stamp-btn');
      stampButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          selectedStamp = btn.getAttribute('data-stamp') || '🌟 Awesome Portfolio!';
          stampButtons.forEach((b) => {
            const isSel = b === btn;
            b.className = isSel
              ? 'stamp-btn chip bg-emerald-600 text-white border-2 border-emerald-300 font-mono text-xs px-2.5 py-1 font-bold cursor-pointer transition-all'
              : 'stamp-btn chip bg-slate-900 text-slate-300 border border-slate-700 hover:border-emerald-500 font-mono text-xs px-2.5 py-1 cursor-pointer transition-all';
          });
          sfx.blip();
        });
      });
    }

    function getGuestbookEntries(): GuestbookEntry[] {
      try {
        const raw = localStorage.getItem('reception_guestbook_entries');
        if (raw) {
          const parsed = JSON.parse(raw);
          if (Array.isArray(parsed) && parsed.length > 0) return parsed;
        }
      } catch {}
      return INITIAL_ENTRIES;
    }

    function renderGuestbook() {
      const listEl = document.getElementById('guestbook-list');
      const badgeEl = document.getElementById('guestbook-count-badge');
      if (!listEl) return;

      const entries = getGuestbookEntries();
      if (badgeEl) {
        badgeEl.textContent = `${entries.length} Inscriptions`;
      }

      listEl.innerHTML = entries
        .map(
          (entry) => `
        <div class="p-3.5 rounded-xl bg-slate-950/80 border border-slate-800 space-y-1.5 hover:border-slate-700 transition-colors">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
            <div class="flex items-center gap-2">
              <span class="font-bold text-white text-xs">${escapeHtml(entry.name)}</span>
              ${
                entry.role
                  ? `<span class="text-slate-400 font-mono text-[10px]">(${escapeHtml(entry.role)})</span>`
                  : ''
              }
            </div>
            <div class="flex items-center gap-2">
              <span class="chip bg-emerald-950 text-emerald-300 border border-emerald-600 font-mono text-[9px] px-1.5 py-0.2 font-bold">${escapeHtml(
                entry.stamp
              )}</span>
              <span class="font-mono text-[9px] text-slate-500">${escapeHtml(entry.time)}</span>
            </div>
          </div>
          <p class="font-sans text-xs text-slate-300 leading-relaxed">${escapeHtml(entry.message)}</p>
        </div>
      `
        )
        .join('');
    }

    function escapeHtml(str: string): string {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    renderGuestbook();

    const guestbookForm = document.getElementById('guestbook-form') as HTMLFormElement | null;
    const feedbackEl = document.getElementById('guestbook-feedback');
    if (guestbookForm) {
      guestbookForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const nameInput = document.getElementById('guest-name') as HTMLInputElement | null;
        const roleInput = document.getElementById('guest-role') as HTMLInputElement | null;
        const msgInput = document.getElementById('guest-message') as HTMLTextAreaElement | null;

        const name = nameInput?.value.trim() || 'Anonymous Visitor';
        const role = roleInput?.value.trim() || '';
        const message = msgInput?.value.trim() || '';

        if (!message) return;

        const newEntry: GuestbookEntry = {
          name,
          role,
          stamp: selectedStamp,
          message,
          time: 'Just now',
        };

        const current = getGuestbookEntries();
        current.unshift(newEntry);
        try {
          localStorage.setItem('reception_guestbook_entries', JSON.stringify(current));
        } catch {}

        renderGuestbook();
        sfx.confirm();

        // Reset form
        if (msgInput) msgInput.value = '';

        if (feedbackEl) {
          feedbackEl.classList.remove('hidden');
          setTimeout(() => {
            feedbackEl.classList.add('hidden');
          }, 4000);
        }
      });
    }

    function openModal() {
      dialog?.showModal();
      syncSafariDex();
      renderGuestbook();
      sfx.door();
    }

    function closeModal() {
      dialog?.close();
    }

    closeBtn?.addEventListener('click', closeModal);
    footerCloseBtn?.addEventListener('click', closeModal);

    // Global event listener to trigger PC modal
    window.addEventListener('reception:open-pc', openModal);
  }

  document.addEventListener('astro:page-load', initNetworkPcModal);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNetworkPcModal);
  } else {
    initNetworkPcModal();
  }
</script>
