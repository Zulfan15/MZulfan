---
import { COMPANIONS } from '../engine/pokemonCompanions';
---

<dialog
  id="partner-hub-modal"
  class="town-modal partner-modal p-0 rounded-2xl border-4 border-ink bg-[#fcf8ef] shadow-2xl backdrop:bg-ink/75 max-w-4xl w-[94vw] max-h-[90vh] overflow-hidden select-none"
  aria-labelledby="partner-hub-title"
>
  <!-- Modal Header -->
  <div class="px-5 py-4 border-b-2 border-ink/20 bg-gradient-to-r from-amber-500/15 via-sky-500/10 to-indigo-500/15 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-amber-400 border-2 border-ink flex items-center justify-center text-xl shadow-sm">
        🐾
      </div>
      <div>
        <h2 id="partner-hub-title" class="font-pixel text-base sm:text-lg font-bold text-ink flex items-center gap-2">
          Poké-Partner & Skill Hub
          <span class="text-[10px] uppercase font-mono px-2 py-0.5 rounded-full bg-emerald-600 text-white">Live 2D</span>
        </h2>
        <p class="font-pixel text-[11px] text-ink/70">
          Pilih Pokémon pendamping jalanmu dan gunakan jurus ikonik (Signature Moves) mereka kapan pun!
        </p>
      </div>
    </div>
    <button
      type="button"
      id="partner-hub-close"
      class="w-9 h-9 rounded-xl border-2 border-ink bg-white font-pixel text-sm font-bold text-ink hover:bg-red-50 hover:text-red-600 cursor-pointer transition-colors flex items-center justify-center shadow-sm"
      aria-label="Tutup Menu Partner"
    >
      ✕
    </button>
  </div>

  <!-- Active Partner Summary Banner -->
  <div class="px-5 py-3 border-b-2 border-ink/15 bg-white/70 flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-2.5">
      <span class="text-xs font-mono font-bold text-ink/60 uppercase tracking-wide">Partner Aktif:</span>
      <div id="partner-hub-active-pill" class="flex items-center gap-2 px-3 py-1 rounded-full border-2 border-ink bg-amber-100 text-ink font-pixel text-xs font-bold shadow-xs">
        <span id="active-partner-icon">👟</span>
        <span id="active-partner-name">Solo (Tanpa Partner)</span>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <button
        type="button"
        id="btn-partner-use-active-skill"
        class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl border-2 border-amber-700 bg-amber-400 hover:bg-amber-300 font-pixel text-xs font-bold text-amber-950 shadow-sm cursor-pointer transition-all active:translate-y-0.5"
        title="Gunakan jurus partner aktif (Tekan X)"
      >
        <span>⚡</span>
        <span id="btn-active-skill-label">Gunakan Skill (X)</span>
      </button>
      <button
        type="button"
        id="btn-partner-dismiss"
        class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl border-2 border-slate-400 bg-white hover:bg-slate-100 font-pixel text-xs text-slate-700 shadow-sm cursor-pointer transition-all"
        title="Kembali berjalan solo"
      >
        <span>👟</span>
        <span>Jalan Solo</span>
      </button>
    </div>
  </div>

  <!-- Companion Grid List -->
  <div class="p-4 sm:p-6 overflow-y-auto max-h-[calc(90vh-160px)] grid grid-cols-1 md:grid-cols-2 gap-4">
    {COMPANIONS.map((c) => (
      <div
        class="partner-card group relative p-4 rounded-xl border-2 border-ink/30 bg-white hover:border-ink hover:shadow-md transition-all flex flex-col justify-between"
        data-companion-id={c.id}
      >
        <!-- Card Header -->
        <div>
          <div class="flex items-start justify-between gap-3 mb-2">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-xl bg-slate-100 border-2 border-ink/40 flex items-center justify-center overflow-hidden shrink-0 group-hover:scale-105 transition-transform">
                {c.imageSrc ? (
                  <img
                    src={c.imageSrc}
                    alt={c.name}
                    class="w-10 h-10 object-contain image-rendering-pixelated"
                    loading="lazy"
                  />
                ) : (
                  <span class="text-2xl">{c.icon}</span>
                )}
              </div>
              <div>
                <div class="flex items-center gap-1.5">
                  <h3 class="font-pixel text-sm font-bold text-ink">{c.name}</h3>
                  <span class="text-xs text-ink/50 font-mono">({c.title})</span>
                </div>
                <span class={`inline-block font-mono text-[10px] px-2 py-0.5 rounded-md border font-semibold mt-0.5 ${c.badgeClass}`}>
                  {c.element}
                </span>
              </div>
            </div>
            <span class="partner-card__active-badge hidden font-pixel text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-600 text-white shadow-xs">
              ✓ Partner Aktif
            </span>
          </div>

          <p class="font-pixel text-[11px] text-ink/80 mb-2 leading-relaxed">
            {c.lore}
          </p>

          <!-- Skill details box -->
          <div class="p-2.5 rounded-lg bg-amber-500/10 border border-amber-500/30 mb-3">
            <div class="flex items-center gap-1.5 text-xs font-pixel font-bold text-amber-950 mb-0.5">
              <span>⚡</span>
              <span>{c.skillName}</span>
            </div>
            <p class="font-pixel text-[10px] text-ink/75 leading-tight">
              {c.skillDesc}
            </p>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex items-center gap-2 pt-2 border-t border-ink/10">
          <button
            type="button"
            class="btn-trigger-move flex-1 flex items-center justify-center gap-1.5 py-1.5 px-2.5 rounded-lg border-2 border-amber-600 bg-amber-300 hover:bg-amber-200 font-pixel text-xs font-bold text-amber-950 shadow-xs cursor-pointer transition-all active:translate-y-0.5"
            data-target={c.id}
          >
            <span>⚡</span>
            <span>Skill Burst</span>
          </button>
          <button
            type="button"
            class="btn-choose-partner flex-1 flex items-center justify-center gap-1.5 py-1.5 px-2.5 rounded-lg border-2 border-ink bg-sky-100 hover:bg-sky-200 font-pixel text-xs font-bold text-ink shadow-xs cursor-pointer transition-all active:translate-y-0.5"
            data-target={c.id}
          >
            <span>🤝</span>
            <span>Ajak Jalan</span>
          </button>
        </div>
      </div>
    ))}
  </div>

  <!-- Modal Footer -->
  <div class="px-5 py-3 border-t-2 border-ink/20 bg-slate-50 flex items-center justify-between text-[11px] font-pixel text-ink/60">
    <div class="flex items-center gap-2">
      <kbd class="font-mono bg-white border border-ink/40 px-1.5 py-0.5 rounded shadow-2xs font-bold">P</kbd>
      <span>Buka / Tutup Hub Partner</span>
      <span class="mx-1.5">•</span>
      <kbd class="font-mono bg-white border border-ink/40 px-1.5 py-0.5 rounded shadow-2xs font-bold">X</kbd>
      <span>Gunakan Skill Partner Aktif di Kanvas</span>
    </div>
    <span class="hidden sm:inline font-mono">11 Pokémon Tersedia</span>
  </div>
</dialog>

<script>
  import { COMPANIONS_MAP } from '../engine/pokemonCompanions';

  function initPartnerHub() {
    const modal = document.getElementById('partner-hub-modal') as HTMLDialogElement | null;
    const closeBtn = document.getElementById('partner-hub-close');
    const dismissBtn = document.getElementById('btn-partner-dismiss');
    const useActiveSkillBtn = document.getElementById('btn-partner-use-active-skill');
    const activeIcon = document.getElementById('active-partner-icon');
    const activeName = document.getElementById('active-partner-name');
    const activeSkillLabel = document.getElementById('btn-active-skill-label');

    if (!modal) return;

    const getStoredFollower = (): string | null => {
      if (typeof window === 'undefined') return null;
      return localStorage.getItem('town:active_follower') || null;
    };

    const updateModalActiveState = (followerId: string | null) => {
      const cards = modal.querySelectorAll<HTMLElement>('.partner-card');
      cards.forEach((card) => {
        const cid = card.getAttribute('data-companion-id');
        const isActive = Boolean(followerId && cid === followerId);
        card.classList.toggle('border-emerald-600', isActive);
        card.classList.toggle('bg-emerald-50/40', isActive);
        const badge = card.querySelector('.partner-card__active-badge');
        if (badge) badge.classList.toggle('hidden', !isActive);
      });

      if (followerId && COMPANIONS_MAP[followerId]) {
        const comp = COMPANIONS_MAP[followerId];
        if (activeIcon) activeIcon.textContent = comp.icon;
        if (activeName) activeName.textContent = `${comp.name} (${comp.title})`;
        if (activeSkillLabel) activeSkillLabel.textContent = `Skill: ${comp.skillName} (X)`;
        if (useActiveSkillBtn) useActiveSkillBtn.classList.remove('hidden');
      } else {
        if (activeIcon) activeIcon.textContent = '👟';
        if (activeName) activeName.textContent = 'Solo (Tanpa Partner)';
        if (activeSkillLabel) activeSkillLabel.textContent = 'Gunakan Skill (X)';
        if (useActiveSkillBtn) useActiveSkillBtn.classList.add('hidden');
      }
    };

    const openModal = () => {
      const current = getStoredFollower();
      updateModalActiveState(current);
      modal.showModal();
    };

    const closeModal = () => {
      modal.close();
    };

    closeBtn?.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    // Dismiss follower (Walk Solo)
    dismissBtn?.addEventListener('click', () => {
      window.dispatchEvent(
        new CustomEvent('town:set-follower', { detail: { followerId: 'dismiss' } })
      );
      updateModalActiveState(null);
    });

    // Use active skill
    useActiveSkillBtn?.addEventListener('click', () => {
      const current = getStoredFollower();
      if (current) {
        window.dispatchEvent(
          new CustomEvent('town:trigger-move', { detail: { pokemonId: current } })
        );
        closeModal();
      }
    });

    // Delegate buttons inside cards
    modal.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;

      // Choose partner
      const chooseBtn = target.closest<HTMLButtonElement>('.btn-choose-partner');
      if (chooseBtn) {
        const pokemonId = chooseBtn.getAttribute('data-target');
        if (pokemonId) {
          window.dispatchEvent(
            new CustomEvent('town:set-follower', { detail: { followerId: pokemonId } })
          );
          updateModalActiveState(pokemonId);
        }
        return;
      }

      // Trigger move burst
      const moveBtn = target.closest<HTMLButtonElement>('.btn-trigger-move');
      if (moveBtn) {
        const pokemonId = moveBtn.getAttribute('data-target');
        if (pokemonId) {
          window.dispatchEvent(
            new CustomEvent('town:trigger-move', { detail: { pokemonId } })
          );
          closeModal();
        }
        return;
      }
    });

    // Follower changed event
    window.addEventListener('town:follower-changed', (e: Event) => {
      const custom = e as CustomEvent<{ follower: { id: string } | null }>;
      const fid = custom.detail?.follower?.id || null;
      updateModalActiveState(fid);
    });

    // Open event
    window.addEventListener('town:open-partner-hub', openModal);

    // Global Keybindings: P to open hub, X to cast skill
    window.addEventListener('keydown', (e) => {
      // Don't trigger when typing in input or textarea
      const tag = (e.target as HTMLElement)?.tagName?.toLowerCase();
      if (tag === 'input' || tag === 'textarea') return;

      if (e.key.toLowerCase() === 'p' && !e.ctrlKey && !e.metaKey && !e.altKey) {
        e.preventDefault();
        if (modal.open) closeModal();
        else openModal();
      } else if (e.key.toLowerCase() === 'x' && !e.ctrlKey && !e.metaKey && !e.altKey) {
        const current = getStoredFollower();
        if (current) {
          e.preventDefault();
          window.dispatchEvent(
            new CustomEvent('town:trigger-move', { detail: { pokemonId: current } })
          );
        }
      }
    });

    // Initial state
    updateModalActiveState(getStoredFollower());
  }

  document.addEventListener('DOMContentLoaded', initPartnerHub);
</script>
